{
  "name": "PlusOneLootForAnime",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "GameShared": {
        "$path": "src/ReplicatedStorage/GameShared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/ServerScriptService/Server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    },
    "MaterialService": {
      "$properties": {
        "Use2022Materials": true
      }
    }
  }
}