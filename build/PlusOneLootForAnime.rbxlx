---------------------------------------------------------------------
-- Sound groups (so the Settings panel can mute music / sfx separately)
---------------------------------------------------------------------
local function getGroup(name: string, volume: number): SoundGroup
	local g = SoundService:FindFirstChild(name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Volume = volume
		g.Parent = SoundService
	end
	return g
end
local sfxGroup = getGroup("GameSFX", 0.55)
local musicGroup = getGroup("GameMusic", 0.3)

-- master bus: glue compressor + soft high cut (less harsh, more even)
if not sfxGroup:FindFirstChild("BusCompressor") then
	local comp = Instance.new("CompressorSoundEffect")
	comp.Name = "BusCompressor"
	comp.Threshold = -20
	comp.Ratio = 3
	comp.Attack = 0.01
	comp.Release = 0.18
	comp.GainMakeup = 0
	comp.Parent = sfxGroup
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "BusEQ"
	eq.LowGain = 1
	eq.MidGain = 0
	eq.HighGain = -4
	eq.Parent = sfxGroup
end

-- minimum seconds between two plays of the same cue (default 0.03)
local RATE = {
	Hit = 0.05, HitBlade = 0.05, HitBlunt = 0.05, HitEnergy = 0.05, Crit = 0.09, Kill = 0.07,
	Swing = 0.05, HeavySwing = 0.08, ScytheSwing = 0.06, Punch = 0.05, GunShot = 0.05, SpiritShot = 0.06, CeroShot = 0.05,
	OrePickup = 0.06, RarePickup = 0.15, Coins = 0.1, PowerGain = 0.1, Sell = 0.2,
	UIHover = 0.05, UIClick = 0.04, Telegraph = 0.2, EnemyWindup = 0.15, Hurt = 0.12, Stage = 0.2, Discover = 0.3,
	StepStone = 0.05, StepGrass = 0.05, StepWood = 0.05, StepMetal = 0.05, StepSoft = 0.05,
}
-- per-cue trim on top of the layer volumes (loud, frequent cues pulled down)
local TRIM = {
	Hit = 0.8, HitBlade = 0.8, HitBlunt = 0.75, HitEnergy = 0.8, Swing = 0.85, Kill = 0.8,
	BossSpawn = 0.7, BossKill = 0.75, Rebirth = 0.75, Overdrive = 0.7, Ultimate = 0.75, Telegraph = 0.6,
	PowerGain = 0.7, OrePickup = 0.8, UIClick = 0.8, UIHover = 0.7,
}
local lastPlayed: { [string]: number } = {}

function SFX.SetSFXVolume(v: number)
	sfxGroup.Volume = v
end
function SFX.SetMusicVolume(v: number)
	musicGroup.Volume = v
end

---------------------------------------------------------------------
local function resolve(key: string): (string, number)
	local override = Config.SoundOverrides and Config.SoundOverrides[key]
	if typeof(override) == "string" and override ~= "" then
		return override, 1
	end
	if unavailable[key] and FALLBACK[key] then
		local fb = FALLBACK[key]
		return SOURCES[fb[1]], fb[2]
	end
	return SOURCES[key] or SOURCES.Blip, 1
end

local function addFx(sound: Sound, fx)
	if not fx then
		return
	end
	if fx.Reverb then
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = 1.6
		r.WetLevel = -4
		r.DryLevel = 0
		r.Parent = sound
	end
	if fx.Echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = 0.12
		e.Feedback = 0.25
		e.WetLevel = -8
		e.Parent = sound
	end
	if fx.Distort then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = fx.Distort
		d.Parent = sound
	end
	if fx.Bass then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = fx.Bass
		eq.MidGain = 0
		eq.HighGain = -2
		eq.Parent = sound
	end
	if fx.Treble then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = -4
		eq.MidGain = 0
		eq.HighGain = fx.Treble
		eq.Parent = sound
	end
	if fx.Muffle then
		-- soft ground: cut the highs
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 2
		eq.MidGain = -4
		eq.HighGain = -18
		eq.Parent = sound
	end
	if fx.Hollow then
		-- wood: boosted mids for a hollow knock
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = -2
		eq.MidGain = 6
		eq.HighGain = -6
		eq.Parent = sound
	end
end

local function pick(p): number
	if typeof(p) == "table" then
		return p[1] + math.random() * (p[2] - p[1])
	end
	return p or 1
end

local function makeParent(at): (Instance, Instance?)
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at
		a.Parent = workspace.Terrain
		return a, a
	elseif typeof(at) == "Instance" then
		return at, nil
	end
	return SoundService, nil
end

local function playOne(key: string, volume: number, pitch: number, parent: Instance, fx, positional: boolean)
	local id, pitchMul = resolve(key)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.PlaybackSpeed = pitch * pitchMul
	s.SoundGroup = sfxGroup
	if positional then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 12
		s.RollOffMaxDistance = 140
	end
	addFx(s, fx)
	s.Parent = parent
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	Debris:AddItem(s, 6)
end

-- SFX.Play("Hit", {At = position | part, Pitch = 1, Volume = 1})
function SFX.Play(name: string, opts)
	local cue = CUES[name]
	if not cue then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or -1) < (RATE[name] or 0.03) then
		return
	end
	lastPlayed[name] = now
	opts = opts or {}
	local volMul = (opts.Volume or 1) * (TRIM[name] or 1)
	local pitchMul = opts.Pitch or 1
	local parent, temp = makeParent(opts.At)
	local positional = parent ~= SoundService
	local longest = 0

	for _, layer in ipairs(cue) do
		local delay = layer.D or 0
		local vol = (layer.V or 0.5) * volMul
		if layer.Arp then
			local gap = layer.Gap or 0.06
			for i, p in ipairs(layer.Arp) do
				local t = delay + (i - 1) * gap
				longest = math.max(longest, t)
				task.delay(t, playOne, layer.S, vol, p * pitchMul, parent, layer.Fx, positional)
			end
		elseif layer.Chord then
			for _, p in ipairs(layer.Chord) do
				task.delay(delay, playOne, layer.S, vol, p * pitchMul, parent, layer.Fx, positional)
			end
		else
			longest = math.max(longest, delay)
			if delay > 0 then
				task.delay(delay, playOne, layer.S, vol, pick(layer.P) * pitchMul, parent, layer.Fx, positional)
			else
				playOne(layer.S, vol, pick(layer.P) * pitchMul, parent, layer.Fx, positional)
			end
		end
	end

	if temp then
		Debris:AddItem(temp, longest + 6)
	end
end

-- Looping ambient sound on a part (forge bubbling, portal hum...).
function SFX.Loop(sourceKey: string, parent: Instance, volume: number, pitch: number): Sound
	local id, pitchMul = resolve(sourceKey)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = volume
	s.PlaybackSpeed = pitch * pitchMul
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 90
	s.SoundGroup = sfxGroup
	s.Parent = parent
	s:Play()
	return s
end

---------------------------------------------------------------------
-- Music (optional; ids in Config.Music)
---------------------------------------------------------------------
local currentMusic: Sound? = nil
local currentMusicId = nil
function SFX.PlayMusic(assetId: number?)
	if assetId == currentMusicId then
		return
	end
	currentMusicId = assetId
	local old = currentMusic
	if old then
		local t = TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 })
		t:Play()
		t.Completed:Once(function()
			old:Destroy()
		end)
		currentMusic = nil
	end
	if not assetId or assetId == 0 then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(assetId)
	s.Looped = true
	s.Volume = 0
	s.SoundGroup = musicGroup
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(2), { Volume = 0.45 }):Play()
	currentMusic = s
end

---------------------------------------------------------------------
-- Preload + detect unavailable web assets (falls back automatically)
---------------------------------------------------------------------
function SFX.Init()
	task.spawn(function()
		local list = {}
		for key, id in pairs(SOURCES) do
			local s = Instance.new("Sound")
			s.Name = key
			s.SoundId = id
			table.insert(list, s)
		end
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(list, function(contentId, status)
				if status ~= Enum.AssetFetchStatus.Success then
					for key, id in pairs(SOURCES) do
						if id == contentId then
							unavailable[key] = true
						end
					end
				end
			end)
		end)
		if not ok then
			warn("[SFX] preload failed:", err)
		end
		for _, s in ipairs(list) do
			s:Destroy()
		end
	end)
end

SFX.Sources = SOURCES
return SFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">UITheme</string>
          <string name="Source"><![CDATA[--!nonstrict
-- UITheme (ModuleScript) -> ReplicatedStorage/GameShared/UITheme
--
-- Skins every panel / button / icon with the images from UIPackPlus.
--   1. Insert UIPackPlus.rbxm into Studio (drag the file into the viewport).
--   2. Move the inserted object into ReplicatedStorage and name it "UIPackPlus".
--   3. Press Play. The Output window prints every image name found in the
--      pack. If a role below doesn't pick the image you want, put that
--      image's exact name at the FRONT of the role's list.
-- Without the pack, a clean built-in anime style is used instead.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local SFX = require(script.Parent:WaitForChild("SFX"))
local Config = require(script.Parent:WaitForChild("Config"))

local UITheme = {}

UITheme.PackNames = { "UIPackPlus", "UI Pack Plus", "UIPack", "UI Pack" }

-- Role -> candidate image names inside the pack (case-insensitive).
-- Exact matches win; otherwise the first image whose name CONTAINS a
-- candidate is used.
UITheme.Templates = {
	Panel = { "Panel", "Frame", "Window", "Background", "Menu", "Container", "Box" },
	Header = { "Header", "TitleBar", "Title", "Banner", "Ribbon" },
	Button = { "GreenButton", "Button_Green", "ButtonGreen", "Button", "Btn" },
	ButtonBlue = { "BlueButton", "Button_Blue", "ButtonBlue" },
	ButtonRed = { "RedButton", "Button_Red", "ButtonRed" },
	ButtonGold = { "YellowButton", "OrangeButton", "GoldButton", "Button_Yellow", "Button_Orange" },
	ButtonPurple = { "PurpleButton", "Button_Purple", "PinkButton" },
	Close = { "CloseButton", "Close", "Exit", "XButton", "X" },
	Slot = { "Slot", "Card", "Item", "Tile", "Cell" },
	Bar = { "Bar", "Pill", "Counter", "StatFrame", "Stat" },
	ProgressBack = { "ProgressBar", "BarBackground", "BarBg", "Progress" },
	Icon_Coins = { "Coin", "Coins", "Gold", "Money", "Cash" },
	Icon_Power = { "Power", "Strength", "Fist", "Muscle", "Lightning", "Energy" },
	Icon_Blade = { "Sword", "Weapon", "Blade", "Katana", "Attack" },
	Icon_Rebirth = { "Rebirth", "Star", "Prestige", "Crown" },
	Icon_Backpack = { "Backpack", "Bag", "Inventory", "Chest" },
	Icon_Shop = { "Shop", "Cart", "Store", "Robux" },
	Icon_Index = { "Index", "Book", "Collection", "Quest" },
	Icon_Race = { "Race", "DNA", "Dice", "Character", "Profile" },
	Icon_Teleport = { "Teleport", "Map", "World", "Portal" },
	Icon_Upgrades = { "Upgrade", "Arrow", "Up", "Level" },
	Icon_Overdrive = { "Potion", "Boost", "Flask", "Fire" },
	Icon_Settings = { "Settings", "Gear", "Cog", "Options" },
	Icon_Gem = { "Gem", "Diamond", "Crystal", "Ore" },
	Icon_Rune = { "Rune", "Magic", "Scroll" },
	Icon_Home = { "Home", "House", "Hub" },
	Icon_Tower = { "Tower", "Castle", "Trophy" },
}

-- "Ink & neon": dark ink surfaces, one bright accent per element, manga
-- display font for anything loud, a sharp heading font for small caps and a
-- condensed body font for reading. Every UI in the game pulls from here.
UITheme.Colors = {
	Bg = Color3.fromRGB(16, 14, 26),
	Bg2 = Color3.fromRGB(24, 21, 38),
	Row = Color3.fromRGB(30, 26, 46),
	Line = Color3.fromRGB(78, 68, 120),
	Stroke = Color3.fromRGB(6, 5, 12),
	Text = Color3.new(1, 1, 1),
	Sub = Color3.fromRGB(176, 170, 205),
	Green = Color3.fromRGB(70, 225, 120),
	Blue = Color3.fromRGB(70, 165, 255),
	Red = Color3.fromRGB(255, 70, 95),
	Gold = Color3.fromRGB(255, 196, 50),
	Purple = Color3.fromRGB(165, 95, 255),
	Pink = Color3.fromRGB(255, 100, 185),
	Cyan = Color3.fromRGB(60, 230, 255),
}
UITheme.TitleFont = Config.Fonts.Display
UITheme.HeadingFont = Config.Fonts.Heading
UITheme.BodyFont = Config.Fonts.Body

-- Emoji fallbacks when the pack has no icon for a role.
local ICON_TEXT = {
	Icon_Coins = "💰",
	Icon_Power = "💪",
	Icon_Blade = "⚔️",
	Icon_Rebirth = "🌟",
	Icon_Backpack = "🎒",
	Icon_Shop = "🛒",
	Icon_Index = "📖",
	Icon_Race = "🧬",
	Icon_Teleport = "🌀",
	Icon_Upgrades = "⬆️",
	Icon_Overdrive = "🔥",
	Icon_Settings = "⚙️",
	Icon_Gem = "💎",
	Icon_Rune = "🔮",
	Icon_Home = "🏠",
	Icon_Tower = "🗼",
}

local pack: Instance? = nil
local images: { [string]: ImageLabel | ImageButton } = {}
local imageNames: { string } = {}
local cache: { [string]: any } = {}

local function findPack(): Instance?
	for _, parent in ipairs({ ReplicatedStorage, StarterGui }) do
		for _, name in ipairs(UITheme.PackNames) do
			local p = parent:FindFirstChild(name)
			if p then
				return p
			end
		end
	end
	for _, c in ipairs(ReplicatedStorage:GetChildren()) do
		if c.Name:lower():find("uipack") then
			return c
		end
	end
	return nil
end

function UITheme.Init()
	pack = findPack()
	if not pack then
		print("[UITheme] UIPackPlus not found in ReplicatedStorage - using built-in style.")
		return
	end
	for _, d in ipairs(pack:GetDescendants()) do
		if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
			local key = d.Name:lower()
			if not images[key] then
				images[key] = d
				table.insert(imageNames, d.Name)
			end
		end
	end
	table.sort(imageNames)
	print(("[UITheme] UIPackPlus found with %d images: %s"):format(#imageNames, table.concat(imageNames, ", ")))
end

function UITheme.HasPack(): boolean
	return pack ~= nil and #imageNames > 0
end

-- Returns the source image instance for a role (or nil).
function UITheme.Find(role: string)
	if cache[role] ~= nil then
		return cache[role] or nil
	end
	local candidates = UITheme.Templates[role]
	local found = nil
	if candidates and pack then
		for _, name in ipairs(candidates) do
			local img = images[name:lower()]
			if img then
				found = img
				break
			end
		end
		if not found then
			for _, name in ipairs(candidates) do
				local lower = name:lower()
				if #lower >= 3 then
					for _, n in ipairs(imageNames) do
						if n:lower():find(lower, 1, true) then
							found = images[n:lower()]
							break
						end
					end
				end
				if found then
					break
				end
			end
		end
	end
	cache[role] = found or false
	return found
end

-- Copy the image look (9-slice etc.) from a pack image onto ours.
local function applySkin(target: any, src)
	target.Image = src.Image
	target.ImageColor3 = src.ImageColor3
	target.ImageTransparency = src.ImageTransparency
	target.ScaleType = src.ScaleType
	target.SliceCenter = src.SliceCenter
	target.SliceScale = src.SliceScale
	target.ImageRectOffset = src.ImageRectOffset
	target.ImageRectSize = src.ImageRectSize
	target.ResampleMode = src.ResampleMode
	target.BackgroundTransparency = 1
end

---------------------------------------------------------------------
-- small builders
---------------------------------------------------------------------
function UITheme.Corner(inst: GuiObject, px: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 14)
	c.Parent = inst
	return c
end

function UITheme.Stroke(inst: GuiObject, thickness: number?, color: Color3?, border: boolean?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2.5
	s.Color = color or UITheme.Colors.Stroke
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = inst
	return s
end

function UITheme.Gradient(inst: GuiObject, a: Color3, b: Color3, rot: number?)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rot or 90
	g.Parent = inst
	return g
end

function UITheme.Label(parent: Instance, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = props.Title and UITheme.TitleFont or UITheme.BodyFont
	t.TextScaled = props.TextScaled ~= false
	t.TextColor3 = props.Color or UITheme.Colors.Text
	t.Text = props.Text or ""
	t.Size = props.Size or UDim2.fromScale(1, 1)
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	t.RichText = props.Rich == true
	t.ZIndex = props.ZIndex or 1
	t.LayoutOrder = props.Order or 0
	if props.TextSize then
		t.TextSize = props.TextSize
	end
	t.Name = props.Name or "Label"
	t.Parent = parent
	if props.Stroke ~= false then
		local st = UITheme.Stroke(t, props.StrokeThickness or (props.Title and 2 or 1.2))
		st.Transparency = props.Title and 0 or 0.25
	end
	local cons = Instance.new("UITextSizeConstraint")
	cons.MaxTextSize = props.MaxText or 40
	cons.Parent = t
	return t
end

-- Icon: pack image if available, emoji otherwise.
function UITheme.Icon(parent: Instance, role: string, size: UDim2, pos: UDim2?, anchor: Vector2?)
	local src = UITheme.Find(role)
	local icon
	if src then
		icon = Instance.new("ImageLabel")
		applySkin(icon, src)
		icon.ScaleType = Enum.ScaleType.Fit
	else
		icon = Instance.new("TextLabel")
		icon.BackgroundTransparency = 1
		icon.Text = ICON_TEXT[role] or "✦"
		icon.TextScaled = true
		icon.Font = Enum.Font.GothamBold
	end
	icon.Name = "Icon"
	icon.Size = size
	icon.Position = pos or UDim2.new()
	icon.AnchorPoint = anchor or Vector2.zero
	icon.Parent = parent
	return icon
end

-- Panel container. Returns (frame, content).
function UITheme.Panel(parent: Instance, props)
	local src = UITheme.Find(props.Role or "Panel")
	local frame
	if src then
		frame = Instance.new("ImageLabel")
		applySkin(frame, src)
	else
		frame = Instance.new("Frame")
		frame.BackgroundColor3 = UITheme.Colors.Bg
		frame.BackgroundTransparency = 0.04
		UITheme.Corner(frame, 14)
		local st = UITheme.Stroke(frame, 1.5, props.Accent or UITheme.Colors.Line, true)
		st.Transparency = 0.2
		UITheme.Gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 145, 175), 90)
	end
	frame.Name = props.Name or "Panel"
	frame.Size = props.Size
	frame.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.ZIndex or 1
	frame.Parent = parent

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = frame
	local pad = Instance.new("UIPadding")
	local p = props.Padding or 14
	pad.PaddingTop = UDim.new(0, p)
	pad.PaddingBottom = UDim.new(0, p)
	pad.PaddingLeft = UDim.new(0, p)
	pad.PaddingRight = UDim.new(0, p)
	pad.Parent = content
	return frame, content
end

local COLOR_ROLE = {
	Green = "Button",
	Blue = "ButtonBlue",
	Red = "ButtonRed",
	Gold = "ButtonGold",
	Purple = "ButtonPurple",
}

-- Animated button with hover / press feedback and UI sounds.
function UITheme.Button(parent: Instance, props)
	local colorName = props.Color or "Green"
	local src = UITheme.Find(COLOR_ROLE[colorName] or "Button") or UITheme.Find("Button")
	local btn
	if src then
		btn = Instance.new("ImageButton")
		applySkin(btn, src)
		btn.AutoButtonColor = false
	else
		-- chunky "simulator" button: solid accent, darker lip along the bottom,
		-- a thin top highlight and a hard ink outline
		btn = Instance.new("TextButton")
		btn.Text = ""
		btn.AutoButtonColor = false
		local base = UITheme.Colors[colorName] or UITheme.Colors.Green
		btn.BackgroundColor3 = base
		UITheme.Corner(btn, props.Corner or 10)
		UITheme.Stroke(btn, 2, UITheme.Colors.Stroke, true)
		UITheme.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205), 90)
		local lip = Instance.new("Frame")
		lip.Name = "Lip"
		lip.AnchorPoint = Vector2.new(0, 1)
		lip.Position = UDim2.fromScale(0, 1)
		lip.Size = UDim2.new(1, 0, 0, 5)
		lip.BackgroundColor3 = base:Lerp(Color3.new(0, 0, 0), 0.4)
		lip.BorderSizePixel = 0
		lip.Parent = btn
		UITheme.Corner(lip, props.Corner or 10)
		local shine = Instance.new("Frame")
		shine.Name = "Shine"
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BackgroundTransparency = 0.7
		shine.Size = UDim2.new(1, -12, 0, 2)
		shine.Position = UDim2.fromOffset(6, 3)
		shine.BorderSizePixel = 0
		shine.Parent = btn
	end
	btn.Name = props.Name or "Button"
	btn.Size = props.Size or UDim2.fromOffset(160, 50)
	btn.Position = props.Position or UDim2.new()
	btn.AnchorPoint = props.AnchorPoint or Vector2.zero
	btn.LayoutOrder = props.Order or 0
	btn.ZIndex = props.ZIndex or 1
	btn.Parent = parent

	local scale = Instance.new("UIScale")
	scale.Parent = btn

	if props.Icon then
		UITheme.Icon(btn, props.Icon, UDim2.fromScale(props.Text and 0.62 or 0.8, props.Text and 0.62 or 0.8), UDim2.fromScale(0.5, props.Text and 0.4 or 0.5), Vector2.new(0.5, 0.5))
	end
	if props.Text then
		local label = UITheme.Label(btn, {
			Text = props.Text,
			Title = props.TitleFont ~= false,
			Size = props.Icon and UDim2.fromScale(1, 0.34) or UDim2.new(1, -12, 1, -8),
			Position = props.Icon and UDim2.fromScale(0, 0.68) or UDim2.fromOffset(6, 4),
			MaxText = props.MaxText or 28,
			ZIndex = btn.ZIndex + 1,
		})
		label.Name = "Text"
	end

	local hoverTween = TweenInfo.new(0.12, Enum.EasingStyle.Back)
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1.06 }):Play()
		SFX.Play("UIHover")
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1.06 }):Play()
	end)
	if props.OnClick then
		btn.Activated:Connect(function()
			SFX.Play(props.Sound or "UIClick")
			props.OnClick()
		end)
	end
	return btn
end

-- Small text with a light drop shadow (HUD, world text, callouts).
function UITheme.Text(parent: Instance, props)
	local t = Instance.new("TextLabel")
	t.Name = props.Name or "Text"
	t.BackgroundTransparency = 1
	t.Font = props.Font or UITheme.HeadingFont
	t.TextScaled = props.TextSize == nil
	if props.TextSize then
		t.TextSize = props.TextSize
	end
	t.Text = props.Text or ""
	t.TextColor3 = props.Color or UITheme.Colors.Text
	t.TextTransparency = props.Transparency or 0
	t.Size = props.Size or UDim2.fromScale(1, 1)
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	t.RichText = props.Rich == true
	t.ZIndex = props.ZIndex or 1
	t.LayoutOrder = props.Order or 0
	t.Parent = parent
	local st = Instance.new("UIStroke")
	st.Thickness = props.StrokeThickness or 1
	st.Color = UITheme.Colors.Stroke
	st.Transparency = 0.45
	st.Parent = t
	if props.MaxText then
		local cons = Instance.new("UITextSizeConstraint")
		cons.MaxTextSize = props.MaxText
		cons.Parent = t
	end
	return t
end

function UITheme.SetButtonText(btn: GuiObject, text: string)
	local t = btn:FindFirstChild("Text")
	if t then
		(t :: TextLabel).Text = text
	end
end

return UITheme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">VFX</string>
          <string name="Source"><![CDATA[--!nonstrict
-- VFX (ModuleScript) -> ReplicatedStorage/GameShared/VFX
-- Anime-style effects: curved slash arcs, hit sparks, shockwaves, light
-- pillars, impact frames, speed lines, title cards, camera shake, FOV punch.
-- MakeEmitter() is also used by the server for auras / map decoration.
-- Only uses built-in Roblox particle textures, so nothing needs uploading.
--
-- VFX HIERARCHY: the server builds ReplicatedStorage.VFX, a folder tree of
-- every particle effect in the game (Combat / Elements / Auras / Ambient).
-- MakeEmitter() clones from that tree, so you can restyle any effect in
-- Studio's Explorer. To keep your edits: press Play, copy
-- ReplicatedStorage.VFX, stop, and paste it into ReplicatedStorage. Existing
-- templates are never overwritten; missing ones are recreated.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Format = require(script.Parent:WaitForChild("Format"))
local Config = require(script.Parent:WaitForChild("Config"))

local VFX = {}

local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	FireSparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	Shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Core = "rbxasset://textures/particles/explosion01_core_main.dds",
	Implode = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	Square = "rbxasset://textures/particles/SquareParticle.png",
}
VFX.Textures = TEX

local WHITE = Color3.new(1, 1, 1)

local function NS(...): NumberSequence
	local args = { ... }
	if #args == 1 then
		return NumberSequence.new(args[1])
	end
	local kps = {}
	for i = 1, #args, 2 do
		table.insert(kps, NumberSequenceKeypoint.new(args[i], args[i + 1]))
	end
	return NumberSequence.new(kps)
end
VFX.NS = NS

local function CS(a: Color3, b: Color3?): ColorSequence
	return ColorSequence.new(a, b or a)
end

---------------------------------------------------------------------
-- PARTICLE PRESETS
---------------------------------------------------------------------
local PRESETS = {
	Sparks = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Square
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 0.35, 1, 0)
		e.Squash = NS(-2.5)
		e.Orientation = Enum.ParticleOrientation.VelocityParallel
		e.Lifetime = NumberRange.new(0.2, 0.45)
		e.Speed = NumberRange.new(30, 60)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Drag = 7
		e.Acceleration = Vector3.new(0, -35, 0)
		e.LightEmission = 1
		e.Brightness = 4
	end,
	Stars = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Sparkle
		e.Color = CS(WHITE, c)
