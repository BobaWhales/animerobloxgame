      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ForgeRules</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ForgeRules (ModuleScript) -> ReplicatedStorage/GameShared/ForgeRules
-- Shared forge maths so the Forge panel can preview exactly what the server
-- will do. Combine 1-3 ores:
--   * every ore adds its effect points (duplicates stack) -> weapon effects
--   * each effect votes for the weapon types it likes -> weapon class odds
--   * rarer ores raise the minimum rarity and add luck
--   * an exact 3-ore combination from Config.Recipes forges a unique weapon

local Config = require(script.Parent:WaitForChild("Config"))

local ForgeRules = {}

function ForgeRules.Analyze(ores: { string })
	local effects = {}
	local classWeights = {}
	local blade, points, raritySum = 0, 0, 0
	local n = 0
	for _, id in ipairs(ores) do
		local ore = Config.OreById[id]
		if ore then
			n += 1
			effects[ore.Effect] = (effects[ore.Effect] or 0) + ore.Points
			local e = Config.Effects[ore.Effect]
			for _, cls in ipairs(e.Classes) do
				classWeights[cls] = (classWeights[cls] or 0) + ore.Points
			end
			blade += ore.Forge
			points += ore.Points
			raritySum += ore.RarityIndex
		end
	end
	if n == 0 then
		return nil
	end
	local avg = raritySum / n
	local recipe = nil
	if n == Config.Forge.Slots then
		recipe = Config.RecipeByKey[Config.RecipeKey(ores)]
	end
	return {
		Count = n,
		Effects = effects,
		ClassWeights = classWeights,
		Blade = blade,
		Points = points,
		AvgRarity = avg,
		-- three Epic ores guarantee at least Rare, three Mythic ores Legendary...
		MinRarityIndex = math.clamp(math.floor(avg) - 1, 1, #Config.WeaponRarities),
		Luck = avg ^ 1.4 * (0.6 + 0.2 * n),
		Recipe = recipe,
	}
end

-- Coin fee for a forge (scaled by the player's coin multiplier so it stays
-- meaningful as the economy grows).
function ForgeRules.Cost(analysis, coinScale: number): number
	return math.floor(analysis.Points * Config.Forge.CoinCostPerOrePoint * math.max(1, coinScale))
end

-- Class odds as a sorted list { {Class, Chance} }.
function ForgeRules.ClassOdds(analysis)
	local total = 0
	for _, w in pairs(analysis.ClassWeights) do
		total += w
	end
	local list = {}
	for cls, w in pairs(analysis.ClassWeights) do
		table.insert(list, { Class = cls, Chance = w / total })
	end
	table.sort(list, function(a, b)
		return a.Chance > b.Chance
	end)
	return list
end

-- Best generic weapon of a class at or below a rarity index.
function ForgeRules.PickWeapon(class: string, rarityIndex: number, rng: Random?)
	local pool = Config.WeaponsByClass[class]
	if not pool or #pool == 0 then
		return Config.WeaponById[Config.StarterWeapon]
	end
	local bestIndex = 0
	for _, w in ipairs(pool) do
		local ri = Config.WeaponRarityById[w.Rarity].Index
		if ri <= rarityIndex and ri > bestIndex then
			bestIndex = ri
		end
	end
	local candidates = {}
	for _, w in ipairs(pool) do
		local ri = Config.WeaponRarityById[w.Rarity].Index
		if ri == bestIndex or (bestIndex == 0 and ri == Config.WeaponRarityById[pool[1].Rarity].Index) then
			table.insert(candidates, w)
		end
	end
	if #candidates == 0 then
		return pool[1]
	end
	local r = rng or Random.new()
	return candidates[r:NextInteger(1, #candidates)]
end

return ForgeRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Format (ModuleScript) -> ReplicatedStorage/GameShared/Format
-- Number / time formatting shared by server and client.

local Format = {}

-- Short scale up to 10^93, then scientific notation (the game is exponential).
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg", "Uvg", "Dvg", "Tvg", "Qavg", "Qivg", "Sxvg", "Spvg", "Ocvg", "Novg", "Tg" }

function Format.Abbrev(n: number): string
	n = tonumber(n) or 0
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = if n == math.floor(n) then tostring(math.floor(n)) else string.format("%.1f", n)
		return (negative and "-" or "") .. s
	end
	if n == math.huge or n ~= n then
		return "INF"
	end
	if n >= 1e96 then
		local e = math.floor(math.log10(n))
		return (negative and "-" or "") .. string.format("%.2fe%d", n / 10 ^ e, e)
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local s
	if scaled >= 100 then
		s = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		s = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		s = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return (negative and "-" or "") .. s .. SUFFIXES[tier + 1]
end

function Format.Commas(n: number): string
	local s = tostring(math.floor(tonumber(n) or 0))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	return string.format("%d:%02d", m, s)
end

function Format.Percent(p: number): string
	if p >= 1 then
		return string.format("%g%%", math.floor(p * 10 + 0.5) / 10)
	end
	return string.format("%.2g%%", p)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">SFX</string>
          <string name="Source"><![CDATA[--!nonstrict
-- SFX (ModuleScript) -> ReplicatedStorage/GameShared/SFX
-- Client-side sound design. Every effect is a "cue" made of layered sounds
-- (pitch-shifted, delayed, with reverb/distortion) so hits feel punchy
-- without needing to upload any audio.
--
-- Sources are Roblox built-in engine sounds (always available) plus the
-- classic Roblox sword sounds. If an asset fails to load it automatically
-- falls back to a built-in sound. Swap any source in Config.SoundOverrides.
--
-- Mixing: everything plays through one SoundGroup with a gentle compressor
-- and a soft high cut (keeps the mix quiet and smooth), and every cue is
-- rate-limited so a burst of hits / pickups never stacks into noise.

local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(script.Parent:WaitForChild("Config"))

local SFX = {}

local SOURCES = {
	Boom = "rbxasset://sounds/impact_explosion_03.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Whoosh = "rbxasset://sounds/action_jump.mp3",
	Thud = "rbxasset://sounds/action_jump_land.mp3",
	Blip = "rbxasset://sounds/volume_slider.ogg",
	Bubble = "rbxasset://sounds/action_swim.mp3",
	Rise = "rbxasset://sounds/action_get_up.mp3",
	Slash = "rbxassetid://12222216",
	Lunge = "rbxassetid://12222208",
	Unsheath = "rbxassetid://12222225",
}
-- If a web asset can't load, use {builtInSource, pitchMultiplier}.
local FALLBACK = {
	Slash = { "Whoosh", 1.75 },
	Lunge = { "Whoosh", 1.25 },
	Unsheath = { "Blip", 0.6 },
}
local unavailable = {}

-- Musical ratios for arpeggios / chords (major scale from the root).
local NOTE = { C = 1, D = 1.1225, E = 1.2599, F = 1.3348, G = 1.4983, A = 1.6818, B = 1.8877, C2 = 2, E2 = 2.5198, G2 = 2.9966, C3 = 4 }

--[[ Layer fields
	S  = source key       V = volume        P = pitch or {min,max}
	D  = delay (s)        Fx = {Reverb=true, Distort=0.3, Bass=6, Echo=true}
	Arp = {pitches...} with Gap (plays S once per pitch)
	Chord = {pitches...} (plays S at every pitch at once)
]]
local CUES = {
	Swing = {
		{ S = "Slash", V = 0.5, P = { 0.95, 1.15 } },
		{ S = "Whoosh", V = 0.12, P = { 1.9, 2.2 } },
	},
	SwingHeavy = {
		{ S = "Lunge", V = 0.65, P = { 0.8, 0.9 } },
		{ S = "Boom", V = 0.15, P = { 1.9, 2.1 } },
		{ S = "Whoosh", V = 0.2, P = { 1.2, 1.3 } },
	},
	-- Impacts are built from four layers: a bright transient "tick", a body
	-- thump, a short crunch and a tiny tail, each slightly randomised.
	Hit = {
		{ S = "Blip", V = 0.12, P = { 3.6, 4 } },
		{ S = "Thud", V = 0.55, P = { 1.3, 1.6 }, Fx = { Bass = 3 } },
		{ S = "Boom", V = 0.22, P = { 2.6, 3.1 }, Fx = { Distort = 0.15 } },
		{ S = "Splash", V = 0.06, P = { 2.4, 2.8 }, D = 0.02 },
	},
	HitBlade = {
		{ S = "Slash", V = 0.28, P = { 1.35, 1.55 } },
		{ S = "Blip", V = 0.1, P = { 3.8, 4.2 } },
		{ S = "Thud", V = 0.45, P = { 1.5, 1.8 } },
		{ S = "Unsheath", V = 0.12, P = { 1.8, 2.1 }, D = 0.01 },
	},
	HitBlunt = {
