	Speed = 1.3,
	Power = 1.5,
	StartingPotions = 1,
}

---------------------------------------------------------------------
-- TOWER (timed personal trial: beat the Guardian before the clock runs out)
---------------------------------------------------------------------
Config.Tower = {
