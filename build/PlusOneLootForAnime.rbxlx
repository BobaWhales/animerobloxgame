end

FX.MasteryUp = function(p)
	SFX.Play(p.Milestone and "Milestone" or "PowerGain")
	if p.Milestone then
		VFX.TitleCard(p.Class:upper() .. " " .. p.Milestone:upper() .. "!", p.Desc, Color3.fromRGB(255, 200, 60), 2)
	else
		UI.Notify(p.Class .. " mastery Lv " .. p.Level, Color3.fromRGB(255, 200, 60))
	end
end

FX.OpenPanel = function(p)
	UI.Open(p.Name, p.Mode)
	SFX.Play("UIOpen")
end

FX.Teleported = function(p)
	SFX.Play("Teleport")
	VFX.ScreenFlash(Color3.fromRGB(230, 220, 255), 0.1, 0.5)
	VFX.FOVPunch(12)
	if p.Where then
		UI.Banner(p.Where, nil, Color3.fromRGB(220, 200, 255))
	end
end

FX.Purchase = function(p)
	SFX.Play("Purchase")
	VFX.ScreenFlash(Color3.fromRGB(120, 255, 150), 0.6, 0.4)
	UI.Notify("Got " .. (p.Text and p.Text ~= "" and p.Text or p.Name) .. "!", Color3.fromRGB(120, 255, 150))
end

FX.Upgraded = function(p)
	local char = player.Character
	UI.Notify(Config.Upgrades[p.Key].Name .. " upgraded to level " .. p.Level .. "!", Color3.fromRGB(120, 200, 255))
	if char then
		VFX.LevelBurst(char, Color3.fromRGB(120, 200, 255))
	end
end

---------------------------------------------------------------------
-- ABILITIES / PROJECTILES
---------------------------------------------------------------------
local SKILL_SOUND = {
	GetsugaTensho = "Getsuga",
	CeroMetralleta = "BigBlast",
	SpiritGun = "BigBlast",
	ChargedShot = "BigBlast",
	DimensionalRift = "Vortex",
	Reap = "Vortex",
	VoidHarvest = "Vortex",
	HellDragon = "Getsuga",
	BlackBladeRush = "HeavySwing",
	IaidoDash = "HeavySwing",
	ChakraPalm = "Punch",
	GroundCleave = "BossSlam",
	StormCleave = "BossSlam",
	BurstFire = "GunShot",
}

FX.Dash = function(p)
	if p.Player == player then
		return
	end
	local char = charOf(p.Player)
	if char then
		ProcAnim.Play(char, "Dash", 0.35)
		VFX.Afterimage(char, weaponColor(p.Player))
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then
			SFX.Play("Dash", { At = root.Position, Volume = 0.6 })
		end
	end
end

FX.Charge = function(p)
	if p.Player == player then
		return
	end
	local char = charOf(p.Player)
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if hand then
		local def = Config.WeaponById[p.Player:GetAttribute("WeaponId") or ""]
		local skill = def and Config.Skills[p.Slot == "E" and def.Skill or ""]
		local orb = VFX.ChargeOrb(hand, Vector3.new(0, -0.9, 0), skill and skill.Color or weaponColor(p.Player), 2.2, skill and skill.Charge or 1.5)
		task.delay(skill and skill.Charge or 1.5, orb.Destroy)
	end
end

FX.Skill = function(p)
	local skill = Config.Skills[p.Skill]
	if not skill then
		return
	end
	local char = charOf(p.Player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local isLocal = p.Player == player
	local pos = root and root.Position or p.Pos
	-- Grandmaster mastery turns skill VFX gold
	local color = (p.Mastery or 0) >= Config.Mastery.Milestones[4].Level and Color3.fromRGB(255, 205, 60) or skill.Color
	if not isLocal and char then
		ProcAnim.Skill(char, p.Player:GetAttribute("WeaponClass"), p.Slot)
		ProcAnim.TrailBurst(char, 0.45)
	end
	local dir = p.Dir or Vector3.new(0, 0, -1)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	flatDir = flatDir.Magnitude > 0.01 and flatDir.Unit or Vector3.new(0, 0, -1)

	if skill.Type == "Cone" then
		local hits = skill.Hits or 1
		task.spawn(function()
			for i = 1, hits do
				local r = char and char:FindFirstChild("HumanoidRootPart")
				local o = r and r.Position or pos
				VFX.ConeSwipe(CFrame.lookAt(o, o + flatDir) * CFrame.new(0, 0.6, 0), skill.Range, color)
				if i < hits then
					task.wait(skill.Interval or 0.1)
				end
			end
		end)
	elseif skill.Type == "Nova" then
		local hits = skill.Hits or 1
		task.spawn(function()
			for i = 1, hits do
				local r = char and char:FindFirstChild("HumanoidRootPart")
				VFX.Nova(r and r.Position or pos, skill.Radius, color)
				if skill.Pull then
					VFX.Zone((r and r.Position or pos) - Vector3.new(0, 2.8, 0), skill.Radius * 0.6, 0.5, color)
				end
				if i < hits then
					task.wait(skill.Interval or 0.12)
				end
			end
		end)
	elseif skill.Type == "DashStrike" or skill.Type == "ChargeLunge" then
		if p.Finish then
			task.delay(0.05, function()
				VFX.Streak(p.Pos, p.Finish, color, skill.Width * 0.3)
				VFX.Slash(CFrame.lookAt(p.Finish, p.Finish + flatDir), color, 1.6, math.random() < 0.5)
			end)
		end
		if char and not isLocal then
			VFX.Afterimage(char, color)
		end
	elseif skill.Type == "Zone" and p.Target then
		VFX.Zone(p.Target, skill.Radius, p.Duration or 2.5, color)
	elseif skill.Type == "Rain" and p.Target then
		VFX.Ring(p.Target, color, skill.Radius, 0.6)
	end

	SFX.Play(p.Slot == "R" and "Ultimate" or (SKILL_SOUND[p.Skill] or "HeavySwing"), { At = not isLocal and pos or nil })
	if isLocal then
		local def = Config.WeaponById[player:GetAttribute("WeaponId") or ""]
		local rarity = Config.WeaponRarityById[player:GetAttribute("WeaponRarity") or "Common"]
		-- anime call-out for ultimates and signature skills
		if p.Slot == "R" or (rarity and rarity.Index >= 5) then
			VFX.ImpactFrame(color, p.Slot == "R" and 1.2 or 0.8)
			VFX.TitleCard(skill.Name:upper() .. "!", def and def.Name or nil, color, 1.1)
		else
			VFX.Shake(0.2)
			if root then
				VFX.TextPop(root.Position + Vector3.new(0, 3, 0), skill.Name, color, 1.1)
			end
		end
	end
end

local lastProjSound = 0
FX.Proj = function(p)
	VFX.StartProjectile(p.Id, p.Kind, p.Pos, p.Dir, p.Speed, p.Range, p.Color or Color3.new(1, 1, 1), p.Size)
	local t = os.clock()
	if t - lastProjSound > 0.06 then
		lastProjSound = t
		local cue = p.Kind == "Cero" and "CeroShot" or (p.Kind == "Orb" and "SpiritShot" or (p.Kind == "Ray" and "GunShot" or nil))
		if cue then
			SFX.Play(cue, { At = p.Pos, Volume = 0.7 })
		end
	end
end

FX.ProjEnd = function(p)
	VFX.EndProjectile(p.Id, p.Pos, p.Hit, p.Explode)
	if p.Explode then
		SFX.Play("BigBlast", { At = p.Pos })
	end
end

FX.Impact = function(p)
	local color = p.Color or Color3.new(1, 1, 1)
	if p.Kind == "Rasengan" then
		VFX.Explosion(p.Pos, color, 1.3)
		VFX.Zone(p.Pos - Vector3.new(0, 2.5, 0), p.Radius or 10, 0.4, color)
		VFX.ShardRing(p.Pos, color, 22, 20, 0.5)
		SFX.Play("RasenganHit", { At = p.Pos })
		local root = myRoot()
		if root and (root.Position - p.Pos).Magnitude < 60 then
			VFX.Shake(0.25)
			VFX.Rumble(0.45)
		end
	elseif p.Kind == "Rain" then
		VFX.Pillar(p.Pos - Vector3.new(0, 1, 0), color, 40, 2.5, 0.5)
		VFX.Emit(p.Pos, "Sparks", 14, color)
		VFX.Ring(p.Pos, color, p.Radius or 7, 0.35)
		SFX.Play("Hit", { At = p.Pos, Volume = 0.6 })
	elseif p.Kind == "Burn" then
		VFX.Emit(p.Pos, "Fire", 6, color)
	else
		VFX.Explosion(p.Pos, color, 0.8)
	end
end

FX.Cooldown = function(p)
	Abilities.SetCooldown(p.Slot, p.Duration)
end

FX.AbilityFail = function()
	SFX.Play("Error", { Volume = 0.4 })
end

FX.NoStamina = function()
	SFX.Play("NoStamina")
	Hud.FlashStamina()
end

FX.Potion = function()
	SFX.Play("Potion")
	Hud.Ping("Vitals", 3)
	local char = player.Character
	if char then
		VFX.LevelBurst(char, Color3.fromRGB(120, 255, 140))
	end
end

---------------------------------------------------------------------
-- ENEMY TELEGRAPHS
---------------------------------------------------------------------
FX.EnemyWindup = function(p)
	ProcAnim.Play(p.Model, "Windup", p.Time)
	if p.Kind == "Slam" then
		VFX.Telegraph(p.Pos, p.Radius, p.Time)
	else
		VFX.TelegraphLine(p.Pos, p.Dir, p.Length, 9, p.Time)
	end
	local model = p.Model
	local head = model and model:FindFirstChild("Head")
	if head then
		VFX.Emit(head.Position, "Glow", 1, Color3.fromRGB(255, 60, 60))
		VFX.Emit(head.Position, "Rise", 12, p.Color or Color3.fromRGB(255, 80, 80))
	end
	SFX.Play("EnemyWindup", { At = p.Pos })
end

FX.EnemyLunge = function(p)
	VFX.Streak(p.From, p.To, Color3.fromRGB(255, 70, 70), 2)
	SFX.Play("HeavySwing", { At = p.From, Pitch = 0.8 })
end

---------------------------------------------------------------------
-- LOOT / RETENTION / MONETIZATION
---------------------------------------------------------------------
FX.Equipped = function(p)
	SFX.Play("Equip")
	local def = Config.WeaponById[p.Weapon]
	local r = Config.WeaponRarityById[p.Rarity]
	if def and r then
		UI.Notify("Equipped " .. def.Name .. " (" .. (r.Label or r.Id) .. ")", r.Color)
	end
	local char = player.Character
	if char then
		VFX.LevelBurst(char, r and r.Color or Color3.new(1, 1, 1))
	end
end

FX.ArmorDrop = function(p)
	local def = Config.ArmorById[p.Armor]
	local r = Config.WeaponRarityById[p.Rarity]
	if not def or not r then
		return
	end
	SFX.Play("RarePickup")
	if r.Index >= 4 then
		VFX.ImpactFrame(r.Color, 0.9)
		VFX.TitleCard("ARMOR DROP!", (r.Label or r.Id) .. " " .. def.Name, r.Color, 2)
	end
	UI.Notify("Armor drop: " .. (r.Label or r.Id) .. " " .. def.Name .. " - equip it from Armor", r.Color)
end

FX.ArmorEquipped = function(p)
	SFX.Play("Equip")
	local def = Config.ArmorById[p.Armor]
	local r = Config.WeaponRarityById[p.Rarity]
	if def and r then
		UI.Notify("Wearing " .. def.Name .. " (" .. (r.Label or r.Id) .. ")", r.Color)
	end
	local char = player.Character
	if char then
		VFX.LevelBurst(char, r and r.Color or Color3.new(1, 1, 1))
	end
end

-- Ore effect procs + shock chains
FX.Proc = function(p)
	local e = Config.Effects[p.Effect]
	if e and p.Pos then
		VFX.Emit(p.Pos, e.VFX or "Sparks", 8, e.Color)
	end
end

FX.Chain = function(p)
	VFX.Streak(p.From, p.To, p.Color or Color3.fromRGB(255, 235, 110), 0.5)
	VFX.Emit(p.To, "Sparks", 6, p.Color or Color3.fromRGB(255, 235, 110))
end

-- Admin abuse
FX.Event = function(p)
	SFX.Play("Milestone")
	VFX.ScreenFlash(p.Color, 0.5, 0.5)
	VFX.TitleCard(p.Name .. "!", "Server event - " .. Format.Time(math.max(0, p.EndsAt - workspace:GetServerTimeNow())), p.Color, 2.4)
end

FX.Announce = function(p)
	SFX.Play("Milestone")
	VFX.TitleCard(p.Text, "- " .. (p.From or "Admin"), Color3.fromRGB(255, 90, 110), 4)
	UI.Notify("[ADMIN] " .. p.Text, Color3.fromRGB(255, 90, 110))
end

FX.AdminAbuse = function(p)
	local titles = { OreRain = { "ORE RAIN!", "Grab everything!", Color3.fromRGB(120, 200, 255) }, CoinRain = { "COIN RAIN!", "Free Coins for everyone!", Color3.fromRGB(255, 215, 70) } }
	local t = titles[p.Kind]
	if t then
		SFX.Play("Milestone")
		VFX.ImpactFrame(t[3], 1)
		VFX.TitleCard(t[1], t[2], t[3], 2.2)
		if p.Kind == "CoinRain" then
			UI.FlyToHud("Coins", nil, t[3], 10)
		end
	end
end

FX.PlaytimeReward = function(p)
	SFX.Play("PlaytimeReward")
	Hud.Ping("Playtime", 6)
	VFX.TitleCard("PLAY-TIME REWARD!", p.Minutes .. " min: " .. p.Name, Color3.fromRGB(255, 215, 80), 2)
	UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 6)
end

FX.Daily = function(p)
	SFX.Play("PlaytimeReward")
	VFX.TitleCard("DAY " .. p.Streak .. " STREAK!", p.Text .. "  |  +" .. math.floor((p.Bonus or 0) * 100 + 0.5) .. "% Coins", Color3.fromRGB(120, 220, 255), 2.4)
end

FX.PowerTier = function(p)
	SFX.Play("PowerUp")
	VFX.ImpactFrame(Color3.fromRGB(255, 80, 80), 1.4)
	VFX.TitleCard("POWER x" .. Format.Abbrev(p.Mult) .. "!", "Tier " .. p.Tier .. " unlocked", Color3.fromRGB(255, 90, 90), 2.2)
	local char = player.Character
	if char then
		VFX.Transform(char, Color3.fromRGB(255, 80, 80), false)
	end
end

FXRemote.OnClientEvent:Connect(function(kind, payload)
	local fn = FX[kind]
	if fn then
		local ok, err = pcall(fn, payload or {})
		if not ok then
			warn("[FX] " .. tostring(kind) .. ": " .. tostring(err))
		end
	end
end)

Drops.OnPickup = function(oreId, pos)
	UI.Bump("Backpack")
	local ore = Config.OreById[oreId]
	if ore and ore.Order >= 3 then
		VFX.TextPop(pos + Vector3.new(0, 3, 0), "+1 " .. ore.Name, ore.Color, 0.8)
	end
end

---------------------------------------------------------------------
-- WORLD: spinning props, pads, rooms / zone lighting & music
---------------------------------------------------------------------
local spinners = {}
local function addSpinner(inst: Instance)
	local pivot = if inst:IsA("Model") then inst:GetPivot() elseif inst:IsA("BasePart") then inst.CFrame else nil
	if pivot then
		spinners[inst] = { Base = pivot, Angle = 0, Phase = math.random() * 6 }
	end
end
for _, inst in ipairs(CollectionService:GetTagged("Spin")) do
	addSpinner(inst)
end
CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpinner)
CollectionService:GetInstanceRemovedSignal("Spin"):Connect(function(inst)
	spinners[inst] = nil
end)

local gameColor = Lighting:FindFirstChild("GameColor") :: ColorCorrectionEffect?
local function setZoneLook(zoneId: number)
	local zone = Config.Zones[zoneId]
	local tint = zone and zone.Tint or Color3.fromRGB(255, 250, 255)
	gameColor = gameColor or Lighting:FindFirstChild("GameColor") :: ColorCorrectionEffect?
	if gameColor then
		TweenService:Create(gameColor, TweenInfo.new(1.5), { TintColor = tint }):Play()
	end
	local music = zoneId == 0 and Config.Music.Hub or Config.Music.Dungeon
	SFX.PlayMusic(music)
end

setZoneLookRef = setZoneLook

-- gently flickering flames / lanterns (lights tagged "Flicker")
local flickers = {}
local function addFlicker(l: Instance)
	if l:IsA("Light") then
		flickers[l] = { Base = l.Brightness, Seed = math.random() * 100 }
	end
end
for _, l in ipairs(CollectionService:GetTagged("Flicker")) do
	addFlicker(l)
end
CollectionService:GetInstanceAddedSignal("Flicker"):Connect(addFlicker)

local accum = 0
RunService.RenderStepped:Connect(function(dt)
	UI.Tick(dt)
	Hud.Tick(dt)
	WorldText.Step(dt)
	WorldMap.Step(dt)
	EnemyFX.Step(dt)
	Movement.Step(dt)
	local root = myRoot()
	Drops.Step(dt, root)

	local now = os.clock()
	for l, f in pairs(flickers) do
		if l.Parent then
			local lp = l.Parent :: any
			if root and lp:IsA("BasePart") and (lp.Position - root.Position).Magnitude < 120 then
				l.Brightness = f.Base * (0.86 + 0.14 * math.noise(now * 3.1, f.Seed) + 0.08 * math.sin(now * 11 + f.Seed))
			end
		else
			flickers[l] = nil
		end
	end

	local t = os.clock()
	for inst, s in pairs(spinners) do
		if inst.Parent then
			s.Angle += math.rad(inst:GetAttribute("SpinSpeed") or 30) * dt
			local bob = inst:GetAttribute("Bob") or 0
			local rot = inst:GetAttribute("SpinAxis") == "Z" and CFrame.Angles(0, 0, s.Angle) or CFrame.Angles(0, s.Angle, 0)
			local cf = s.Base * CFrame.new(0, math.sin(t * 1.6 + s.Phase) * bob, 0) * rot
			if inst:IsA("Model") then
				inst:PivotTo(cf)
			else
				(inst :: BasePart).CFrame = cf
			end
		else
			spinners[inst] = nil
		end
	end

	accum += dt
	if accum < 0.25 or not root or not data then
		return
	end
	accum = 0
	WeaponUI.Tick()

	-- training pad indicator
	local padMult, padLocked = nil, false
	for _, pad in ipairs(CollectionService:GetTagged("TrainPad")) do
		local p = pad :: BasePart
		local flat = Vector3.new(root.Position.X - p.Position.X, 0, root.Position.Z - p.Position.Z)
		if flat.Magnitude <= Config.TrainPadRadius and math.abs(root.Position.Y - p.Position.Y) < 7 then
			padMult = p:GetAttribute("Mult")
			local needA = p:GetAttribute("AscensionReq") or 0
			local asc = data.Ascensions or 0
			padLocked = if asc ~= needA then asc < needA else data.Rebirths < (p:GetAttribute("RebirthReq") or 0)
			break
		end
	end
	UI.SetPad(padMult, padLocked)

end)

task.spawn(function()
	for _ = 1, 10 do
		request("Ready")
		task.wait(2)
		if data then
			break
		end
	end
end)
print("[" .. Config.GameName .. "] client ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Abilities (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Abilities
-- Combat input through ContextActionService:
--   LMB / RT / touch button   basic attack (hold to keep attacking)
--   Q   / B                   dash (short i-frames)
--   E   / X                   weapon skill (hold for charge skills)
--   R   / Y                   ultimate
--   C   / LB                  Overdrive transformation
--   H                         health potion
-- The client plays animations + instant feedback; the server validates
-- stamina, cooldowns and hits.

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))
local ProcAnim = require(script.Parent:WaitForChild("ProcAnim"))

local Abilities = {}
-- classes aimed with an outstretched arm, and classes without the two-hand
-- sword-hold idle pose
local POINT = { FingerGun = true, Bow = true, Cannon = true, Staff = true, Kunai = true }
local NO_HOLD = { Glove = true, FingerGun = true, Claws = true, Cannon = true, Kunai = true }
Abilities.CooldownEnds = { LMB = 0, Q = 0, E = 0, R = 0, C = 0 }
Abilities.CooldownLength = { LMB = 1, Q = 1, E = 1, R = 1, C = 1 }
Abilities.OnFeedback = nil :: ((string) -> ())? -- "NoStamina", ...

local player = Players.LocalPlayer
local remote: RemoteEvent
local request: (string, any?) -> ()
local tracks: { [string]: AnimationTrack } = {}
local attackHeld = false
local lastAttack = 0
local combo = 0
local charging = nil -- { Slot, Orb, Start }
local B = Config.Balance

local SWING_SOUND = {
	Katana = "Swing", Greatsword = "HeavySwing", Scythe = "ScytheSwing", Glove = "Punch", Pistols = "GunShot", FingerGun = "SpiritShot",
	Spear = "Swing", Daggers = "Swing", Hammer = "HeavySwing", Bow = "Swing", Staff = "SpiritShot", Chain = "ScytheSwing",
	Claws = "Swing", Fan = "Swing", Kunai = "Swing", Cannon = "GunShot",
}

---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function character()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil, nil, nil
	end
	return c, hum, root :: BasePart
end

local function weapon()
	local id = player:GetAttribute("WeaponId") or Config.StarterWeapon
	local def = Config.WeaponById[id] or Config.WeaponById[Config.StarterWeapon]
	local rarity = Config.WeaponRarityById[player:GetAttribute("WeaponRarity") or "Common"] or Config.WeaponRarities[1]
	return def, Config.WeaponClasses[def.Class], rarity
end

function Abilities.SkillFor(slot: string)
	local def, class = weapon()
	local id = slot == "E" and def.Skill or class.Ultimate
	return id, Config.Skills[id]
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Aim direction + target point (mouse on PC, camera direction otherwise).
local function aim(): (Vector3, Vector3)
	local c, _, root = character()
	local cam = workspace.CurrentCamera
	if not root or not cam then
		return Vector3.new(0, 0, -1), Vector3.zero
	end
	local origin = root.Position + Vector3.new(0, 1.2, 0)
	local target
	local last = UserInputService:GetLastInputType()
	if UserInputService.MouseEnabled and (last == Enum.UserInputType.MouseButton1 or last == Enum.UserInputType.MouseMovement or last == Enum.UserInputType.Keyboard or last == Enum.UserInputType.MouseButton2 or last == Enum.UserInputType.MouseWheel) then
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local ignore = { c }
		local fx = workspace:FindFirstChild("ClientFX")
		if fx then
			table.insert(ignore, fx)
		end
		rayParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
		target = hit and hit.Position or (ray.Origin + ray.Direction * 400)
	else
		target = origin + flat(cam.CFrame.LookVector) * 40
	end
	local dir = target - origin
	if dir.Magnitude < 0.1 then
		dir = root.CFrame.LookVector
	end
	return dir.Unit, target
end

local function faceTowards(dir: Vector3)
	local _, _, root = character()
	if root then
		local f = flat(dir)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + f)
	end
end

local function stamina(): number
	return player:GetAttribute("Stamina") or B.MaxStamina
end

local function staminaCost(base: number): number
	local def, _, rarity = weapon()
	local cost = base * B.StaminaCostMult
	if rarity.Passive and def.Passive and def.Passive.Id == "ChakraFlow" then
		cost *= 0.8
	end
	return cost
end

local function play(name: string, speed: number?)
	local t = tracks[name]
	if t then
		t:Play(0.05)
		if speed then
			t:AdjustSpeed(speed)
		end
	end
	return t
end

-- R15: procedural combat animation (Client/ProcAnim); R6 falls back to tracks.
local function isR15(): boolean
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.RigType == Enum.HumanoidRigType.R15
end

local function rightHand(): BasePart?
	local c = player.Character
	return c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")) :: any
end

local function muzzlePosition(dir: Vector3): Vector3
	local c = player.Character
	local w = c and c:FindFirstChild("EquippedWeapon_Right")
	local m = w and w:FindFirstChild("Muzzle", true)
	if m and m:IsA("Attachment") then
		return m.WorldPosition
	end
	local _, _, root = character()
	return root and (root.Position + Vector3.new(0, 1.2, 0) + dir * 2) or Vector3.zero
end

local function feedback(kind: string)
	if Abilities.OnFeedback then
		Abilities.OnFeedback(kind)
	end
end

---------------------------------------------------------------------
-- ANIMATIONS
---------------------------------------------------------------------
local function loadTracks(char: Model)
	tracks = {}
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	local animator = hum:WaitForChild("Animator", 10) :: Animator?
	if not animator then
		return
	end
	local set = hum.RigType == Enum.HumanoidRigType.R15 and Config.PlayerAnims.R15 or Config.PlayerAnims.R6
	for name, id in pairs(set) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, t = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok and t then
			t.Priority = name == "Hold" and Enum.AnimationPriority.Action or Enum.AnimationPriority.Action4
			if name == "Hold" or name == "Charge" then
				t.Looped = true
			end
			tracks[name] = t
		end
	end
	Abilities.RefreshHold()
end

function Abilities.RefreshHold()
	local def = weapon()
	local wantsHold = not NO_HOLD[def.Class]
	local t = tracks.Hold
	if not t then
		return
	end
	if wantsHold and not t.IsPlaying then
		t:Play(0.2)
	elseif not wantsHold and t.IsPlaying then
		t:Stop(0.2)
	end
end

---------------------------------------------------------------------
-- BASIC ATTACK
---------------------------------------------------------------------
local function tryAttack()
	local c, _, root = character()
	if not c or charging then
		return
	end
	local def, class, rarity = weapon()
	local as = rarity.AttackSpeed or 0
	local interval = class.Interval / (1 + as)
	local t = os.clock()
	if t - lastAttack < interval then
		return
	end
	if t - lastAttack > interval * 2.5 then
		combo = 0
	end
	lastAttack = t
	combo = combo % #class.Combo + 1
	Abilities.CooldownEnds.LMB = t + interval
	Abilities.CooldownLength.LMB = interval

	local dir, _ = aim()
	faceTowards(dir)
	remote:FireServer("Attack", { Aim = dir })
	feedback("Action")

	local color = def.Glow or rarity.Color
	if isR15() then
		ProcAnim.Attack(player.Character, def.Class, combo)
		ProcAnim.TrailBurst(player.Character, 0.3)
	end
	if class.Kind == "Ranged" then
		if not isR15() then
			play(POINT[def.Class] and "Point" or "Slash", 1.6)
		end
		VFX.Muzzle(muzzlePosition(dir), dir, color)
	else
		local big = combo == #class.Combo
		if not isR15() then
			play(big and "Lunge" or "Slash", 1 + (1 - class.Interval) * 0.6)
		end
		local scale = class.Range / 9 * (big and 1.25 or 1)
		VFX.Slash(root.CFrame * CFrame.new(0, 0.6, 0), color, scale, combo % 2 == 0)
		if big then
			VFX.Shake(0.08)
		end
	end
	SFX.Play(SWING_SOUND[def.Class] or "Swing", { Pitch = 0.95 + math.random() * 0.1 })
	VFX.Shake(0.02)
end

---------------------------------------------------------------------
-- DASH
---------------------------------------------------------------------
local function doDash(dir: Vector3, speed: number, duration: number)
	local c, _, root = character()
	if not c then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VectorVelocity = flat(dir) * speed
	lv.Parent = root
	Debris:AddItem(lv, duration)
	Debris:AddItem(att, duration)
	local def, _, rarity = weapon()
	local color = def.Glow or rarity.Color
	VFX.Afterimage(c, color)
	task.delay(duration * 0.5, function()
		if c.Parent then
			VFX.Afterimage(c, color)
		end
	end)
end

local function tryDash()
	local c, hum, root = character()
	if not c then
		return
	end
	local t = os.clock()
	if t < Abilities.CooldownEnds.Q then
		return
	end
	if stamina() < staminaCost(B.DashStamina) then
		SFX.Play("NoStamina")
		feedback("NoStamina")
		return
	end
	local dir = hum.MoveDirection.Magnitude > 0.1 and hum.MoveDirection or root.CFrame.LookVector
	Abilities.CooldownEnds.Q = t + B.DashCooldown * B.CooldownMult
	Abilities.CooldownLength.Q = B.DashCooldown * B.CooldownMult
	remote:FireServer("Dash", { Aim = flat(dir) })
	feedback("Action")
	doDash(dir, B.DashDistanceSpeed, B.DashDuration)
	ProcAnim.Play(player.Character, "Dash", 0.35)
	SFX.Play("Dash")
	VFX.FOVPunch(6)
end

---------------------------------------------------------------------
-- SKILLS
---------------------------------------------------------------------
local function canCast(slot: string, skill): boolean
	if os.clock() < Abilities.CooldownEnds[slot] then
		SFX.Play("Error", { Volume = 0.5 })
		return false
	end
	if stamina() < staminaCost(skill.Stamina) then
		SFX.Play("NoStamina")
		feedback("NoStamina")
		return false
	end
	return true
end

-- local movement for dash-type skills (server does the damage)
local function skillMovement(skill, dir: Vector3, charge: number?)
	if isR15() then
		local def = weapon()
		local ult = Config.Skills[Config.WeaponClasses[def.Class].Ultimate] == skill
		ProcAnim.Skill(player.Character, def.Class, ult and "R" or "E")
		ProcAnim.TrailBurst(player.Character, 0.45)
		if skill.Type == "DashStrike" or skill.Type == "ChargeLunge" then
			local dur = 0.22
			doDash(dir, skill.Distance / dur, dur)
		end
		return
	end
	if skill.Type == "DashStrike" or skill.Type == "ChargeLunge" then
		local dur = 0.22
		doDash(dir, skill.Distance / dur, dur)
		play("Lunge", 1.4)
	elseif skill.Type == "Projectile" or skill.Type == "Barrage" then
		play(POINT[weapon().Class] and "Point" or "Lunge", 1.2)
	else
		play("Lunge", 1)
	end
end

local function castInstant(slot: string)
	local skillId, skill = Abilities.SkillFor(slot)
	if not skill or not canCast(slot, skill) then
		return
	end
	local dir, target = aim()
	faceTowards(dir)
	remote:FireServer(slot == "E" and "Skill" or "Ultimate", { Aim = dir, Target = target })
	feedback("Action")
	skillMovement(skill, dir)
	-- optimistic cooldown (server sends the exact value back)
	local cd = skill.Cooldown * B.CooldownMult
	Abilities.CooldownEnds[slot] = os.clock() + cd
	Abilities.CooldownLength[slot] = cd
	local _ = skillId
end

local function beginCharge(slot: string)
	local _, skill = Abilities.SkillFor(slot)
	if not skill or not canCast(slot, skill) then
		return
	end
	local hand = rightHand()
	local orb = hand and VFX.ChargeOrb(hand, Vector3.new(0, -0.9, 0), skill.Color, skill.Type == "ChargeLunge" and 2.6 or 1.8, skill.Charge)
	charging = { Slot = slot, Orb = orb, Start = os.clock() }
	remote:FireServer("ChargeBegin", { Slot = slot })
	feedback("Action")
	play("Charge")
	SFX.Play("ChargeUp")
end

local function releaseCharge(slot: string)
	if not charging or charging.Slot ~= slot then
		return
	end
	local _, skill = Abilities.SkillFor(slot)
	local held = math.min(os.clock() - charging.Start, skill and skill.Charge or 1)
	if charging.Orb then
		charging.Orb.Destroy()
	end
	if tracks.Charge then
		tracks.Charge:Stop(0.1)
	end
	charging = nil
	if not skill then
		return
	end
	local dir, target = aim()
	faceTowards(dir)
	remote:FireServer("ChargeRelease", { Slot = slot, Aim = dir, Target = target })
	skillMovement(skill, dir, held)
	local cd = skill.Cooldown * B.CooldownMult
	Abilities.CooldownEnds[slot] = os.clock() + cd
	Abilities.CooldownLength[slot] = cd
end

---------------------------------------------------------------------
-- CAS handlers
---------------------------------------------------------------------
local function onAttack(_, state)
	if state == Enum.UserInputState.Begin then
		attackHeld = true
		task.spawn(function()
			while attackHeld do
				tryAttack()
				task.wait(0.05)
			end
		end)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		attackHeld = false
	end
	return Enum.ContextActionResult.Pass
end

local function onDash(_, state)
	if state == Enum.UserInputState.Begin then
		tryDash()
	end
	return Enum.ContextActionResult.Sink
end

local function skillHandler(slot: string)
	return function(_, state)
		local _, skill = Abilities.SkillFor(slot)
		if not skill then
			return Enum.ContextActionResult.Sink
		end
		if skill.Charge then
			if state == Enum.UserInputState.Begin then
				beginCharge(slot)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				releaseCharge(slot)
			end
		elseif state == Enum.UserInputState.Begin then
			castInstant(slot)
		end
		return Enum.ContextActionResult.Sink
	end
end

local function onOverdrive(_, state)
	if state == Enum.UserInputState.Begin then
		request("Overdrive")
	end
	return Enum.ContextActionResult.Sink
end

local function onPotion(_, state)
	if state == Enum.UserInputState.Begin then
		remote:FireServer("Potion")
		feedback("Action")
	end
	return Enum.ContextActionResult.Sink
end

function Abilities.SetCooldown(slot: string, duration: number)
	Abilities.CooldownEnds[slot] = os.clock() + duration
	Abilities.CooldownLength[slot] = duration
end

function Abilities.Press(slot: string)
	if slot == "Q" then
		tryDash()
	elseif slot == "E" or slot == "R" then
		local _, skill = Abilities.SkillFor(slot)
		if skill and skill.Charge then
			beginCharge(slot)
			task.delay(skill.Charge, releaseCharge, slot)
		else
			castInstant(slot)
		end
	elseif slot == "C" then
		request("Overdrive")
	elseif slot == "LMB" then
		tryAttack()
	end
end

function Abilities.Init(abilityRemote: RemoteEvent, requestFn)
	remote = abilityRemote
	request = requestFn
	ContextActionService:BindAction("AnimeAttack", onAttack, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:BindAction("AnimeDash", onDash, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("AnimeSkill", skillHandler("E"), true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	ContextActionService:BindAction("AnimeUltimate", skillHandler("R"), true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
	ContextActionService:BindAction("AnimeOverdrive", onOverdrive, true, Enum.KeyCode.C, Enum.KeyCode.ButtonL1)
	ContextActionService:BindAction("AnimePotion", onPotion, false, Enum.KeyCode.H)
	ContextActionService:SetTitle("AnimeAttack", "Attack")
	ContextActionService:SetTitle("AnimeDash", "Dash")
	ContextActionService:SetTitle("AnimeSkill", "Skill")
	ContextActionService:SetTitle("AnimeUltimate", "Ult")
	ContextActionService:SetTitle("AnimeOverdrive", "OD")
	for i, name in ipairs({ "AnimeAttack", "AnimeDash", "AnimeSkill", "AnimeUltimate", "AnimeOverdrive" }) do
		local positions = { UDim2.new(1, -95, 1, -170), UDim2.new(1, -170, 1, -95), UDim2.new(1, -175, 1, -175), UDim2.new(1, -250, 1, -110), UDim2.new(1, -100, 1, -250) }
		ContextActionService:SetPosition(name, positions[i])
	end

	player.CharacterAdded:Connect(function(c)
		attackHeld = false
		charging = nil
		task.spawn(loadTracks, c)
	end)
	if player.Character then
		task.spawn(loadTracks, player.Character)
	end
	player:GetAttributeChangedSignal("WeaponId"):Connect(Abilities.RefreshHold)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">AdminUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- AdminUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/AdminUI
-- "Admin abuse" panel (P key or the Admin tile in the menu). Only shown to
-- admins, and every button is re-checked on the server (Server/Admin), so
-- this is just a remote control.
--   PLAYER : currencies, prestige, stage unlocks, heal / god / speed, goto / bring
--   ITEMS  : any ore, any weapon (rarity + a maxed ore effect), any armor
--   SERVER : 2x Luck / 3x Coins / 5x Power / 2x Drops events, ore + coin rain,
--            boss invasion at spawn, everyone Overdrive, kill all, announcements

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local SFX = require(Shared:WaitForChild("SFX"))

local AdminUI = {}
local UI, H
local C = UITheme.Colors
local RED = Color3.fromRGB(255, 70, 95)
local remote: RemoteEvent? = nil

local target: any = nil -- nil = me, "All", or a UserId
local amountBox: TextBox
local pick = { Ore = Config.Ores[1].Id, Weapon = Config.Weapons[1].Id, Rarity = 1, Effect = 0, Armor = Config.Armors[1].Id }

local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qd = 1e15, qn = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }

-- "250", "1.5m", "3qd", "1e40" -> number
local function parseAmount(): number?
	local text = (amountBox and amountBox.Text or ""):lower():gsub("%s", ""):gsub(",", "")
	if text == "" then
		return nil
	end
	local n = tonumber(text)
	if n then
		return n
	end
	local num, suf = text:match("^([%d%.]+)(%a+)$")
	if num and SUFFIX[suf] and tonumber(num) then
		return tonumber(num) * SUFFIX[suf]
	end
	return nil
end

local function fire(action: string, args)
	if not remote then
		return
	end
	args = args or {}
	args.Target = target
	if args.Amount == nil then
		args.Amount = parseAmount()
	end
	remote:FireServer(action, args)
end

local function grid(parent, cell: Vector2)
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(cell.X, cell.Y)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = parent
	return g
end

-- A "< value >" picker. getText(i) -> text, color.
local function cycler(parent, pos: UDim2, width: number, count: number, get: () -> number, set: (number) -> (), getText: (number) -> (string, Color3?))
	local f = H.Frame(parent, { Color = Color3.fromRGB(14, 12, 22), Size = UDim2.fromOffset(width, 34), Position = pos, Corner = 8, Stroke = 1 })
	local label = UITheme.Label(f, { Text = "", Size = UDim2.new(1, -72, 1, -6), Position = UDim2.fromOffset(36, 3), MaxText = 15 })
	local function refresh()
		local t, col = getText(get())
		label.Text = t
		label.TextColor3 = col or C.Text
	end
	for side = -1, 1, 2 do
		UITheme.Button(f, { Text = side < 0 and "<" or ">", Color = "Blue", Size = UDim2.fromOffset(30, 30), Position = side < 0 and UDim2.fromOffset(2, 2) or UDim2.new(1, -32, 0, 2), MaxText = 18, Corner = 6, OnClick = function()
			local i = get() + side
			if i < 0 then
				i = count
			elseif i > count then
				i = 0
			end
			set(i)
			refresh()
		end })
	end
	refresh()
	return refresh
end

local function build()
	local p = H.MakePanel("Admin", "ADMIN ABUSE", Vector2.new(900, 560), RED)

	-- target + amount bar
	local bar = H.Frame(p.Body, { Color = C.Row, Size = UDim2.new(1, 0, 0, 48), Corner = 8, Stroke = 1 })
	UITheme.Label(bar, { Text = "TARGET", Size = UDim2.fromOffset(70, 20), Position = UDim2.fromOffset(10, 14), Color = C.Sub, MaxText = 14, XAlign = Enum.TextXAlignment.Left })
	local chips = H.Frame(bar, { Transparency = 1, Size = UDim2.new(1, -360, 1, -12), Position = UDim2.fromOffset(78, 6) })
	local chipList = H.List(chips, 6, true, Enum.HorizontalAlignment.Left)
	chipList.VerticalAlignment = Enum.VerticalAlignment.Center
	UITheme.Label(bar, { Text = "AMOUNT", Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -270, 0, 14), Color = C.Sub, MaxText = 14 })
	amountBox = Instance.new("TextBox")
	amountBox.Size = UDim2.fromOffset(190, 34)
	amountBox.Position = UDim2.new(1, -198, 0, 7)
	amountBox.BackgroundColor3 = Color3.fromRGB(14, 12, 22)
	amountBox.TextColor3 = Color3.new(1, 1, 1)
	amountBox.PlaceholderText = "e.g. 1000, 5m, 2qd"
	amountBox.PlaceholderColor3 = C.Sub
	amountBox.Font = UITheme.BodyFont
	amountBox.TextScaled = true
	amountBox.ClearTextOnFocus = false
	amountBox.Text = ""
	amountBox.Parent = bar
	UITheme.Corner(amountBox, 8)
	UITheme.Stroke(amountBox, 1.5, RED, true)

	local chipButtons = {}
	local function refreshChips()
		H.Clear(chips)
		table.clear(chipButtons)
		local options = { { Label = "ME", Value = nil }, { Label = "EVERYONE", Value = "All" } }
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Players.LocalPlayer then
				table.insert(options, { Label = plr.DisplayName, Value = plr.UserId })
			end
		end
		for i, o in ipairs(options) do
			local on = target == o.Value
			local b = UITheme.Button(chips, { Text = o.Label, Color = on and "Red" or "Blue", Size = UDim2.fromOffset(math.clamp(#o.Label * 11 + 24, 60, 150), 32), Order = i, MaxText = 15, Corner = 6, OnClick = function()
				target = o.Value
				refreshChips()
			end })
			chipButtons[i] = b
		end
	end
	refreshChips()
	Players.PlayerAdded:Connect(refreshChips)
	Players.PlayerRemoving:Connect(function(plr)
		if target == plr.UserId then
			target = nil
		end
		task.defer(refreshChips)
	end)

	-- tabs
	local tabs = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, 56) })
	H.List(tabs, 8, true, Enum.HorizontalAlignment.Left)
	local pages = {}
	local function page(name: string)
		local pg = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 1, -102), Position = UDim2.fromOffset(0, 102) })
		pg.Name = name
		pg.Visible = false
		pages[name] = pg
		return pg
	end
	local function show(name)
		for n, pg in pairs(pages) do
			pg.Visible = n == name
		end
	end
	for i, name in ipairs({ "PLAYER", "ITEMS", "SERVER" }) do
		UITheme.Button(tabs, { Text = name, Color = i == 1 and "Blue" or (i == 2 and "Purple" or "Red"), Size = UDim2.fromOffset(150, 36), Order = i, MaxText = 18, Corner = 8, OnClick = function()
			show(name)
		end })
	end

	-- PLAYER
	local pl = page("PLAYER")
	grid(pl, Vector2.new(170, 50))
	local playerCmds = {
		{ "+ Coins", "GiveCoins", "Gold" },
		{ "+ Power", "GivePower", "Green" },
		{ "+ Rebirths", "GiveRebirths", "Gold" },
		{ "+ Ascensions", "GiveAscensions", "Purple" },
		{ "+ Race Rerolls", "GiveRerolls", "Purple" },
		{ "+ Overdrive", "GiveOverdrive", "Red" },
		{ "+ Catalysts", "GiveCatalysts", "Blue" },
		{ "+ Every Ore", "GiveAllOres", "Blue" },
		{ "Set Deepest Floor", "SetFloor", "Green" },
		{ "Heal", "Heal", "Green" },
		{ "God Mode", "God", "Gold" },
		{ "Speed x3", "Speed", "Blue" },
		{ "Go To", "GoTo", "Blue" },
		{ "Bring", "Bring", "Purple" },
	}
	for i, c in ipairs(playerCmds) do
		UITheme.Button(pl, { Text = c[1], Color = c[3], Order = i, MaxText = 18, Corner = 8, OnClick = function()
			fire(c[2])
		end })
	end
	local armed = 0
	local reset = UITheme.Button(pl, { Text = "Reset Data", Color = "Red", Order = 99, MaxText = 18, Corner = 8, OnClick = nil })
	reset.Activated:Connect(function()
		if os.clock() - armed < 3 then
			armed = 0
			UITheme.SetButtonText(reset, "Reset Data")
			fire("ResetData")
		else
			armed = os.clock()
			UITheme.SetButtonText(reset, "CLICK AGAIN")
			SFX.Play("Error")
			task.delay(3, function()
				UITheme.SetButtonText(reset, "Reset Data")
			end)
		end
	end)

	-- ITEMS
	local it = page("ITEMS")
	local function column(x: number, w: number, title: string)
		local col = H.Frame(it, { Color = C.Row, Size = UDim2.new(0, w, 1, 0), Position = UDim2.fromOffset(x, 0), Corner = 8, Stroke = 1 })
		UITheme.Label(col, { Text = title, Title = true, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 6), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
		return col
	end
	local function pickList(col, items, key: string, textOf, colorOf, height: number)
		local sc = H.Scroller(col, { Size = UDim2.new(1, -8, 0, height), Position = UDim2.fromOffset(4, 34) })
		H.List(sc, 3)
		local rows = {}
		local function paint()
			for id, r in pairs(rows) do
				local st = r:FindFirstChildOfClass("UIStroke")
				if st then
					st.Transparency = pick[key] == id and 0 or 0.8
				end
			end
		end
		for i, item in ipairs(items) do
			local r = H.Frame(sc, { Color = Color3.fromRGB(14, 12, 22), Size = UDim2.new(1, 0, 0, 24), Order = i, Corner = 5, Stroke = 1 })
			local st = r:FindFirstChildOfClass("UIStroke")
			if st then
				st.Color = colorOf(item)
			end
			UITheme.Label(r, { Text = textOf(item), Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(6, 2), XAlign = Enum.TextXAlignment.Left, Color = colorOf(item), MaxText = 14, StrokeThickness = 1 })
			local b = Instance.new("TextButton")
			b.BackgroundTransparency = 1
			b.Text = ""
			b.Size = UDim2.fromScale(1, 1)
			b.Parent = r
			b.Activated:Connect(function()
				pick[key] = item.Id
				SFX.Play("UIClick")
				paint()
			end)
			rows[item.Id] = r
		end
		paint()
	end

	-- ores
	local oc = column(0, 250, "ORES")
	pickList(oc, Config.Ores, "Ore", function(o)
		return o.Name .. "  (" .. o.Rarity .. ")"
	end, function(o)
		return o.Color
	end, 300)
	UITheme.Button(oc, { Text = "GIVE ORE", Color = "Blue", Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), MaxText = 18, Corner = 8, OnClick = function()
		fire("GiveOre", { Ore = pick.Ore })
	end })

	-- weapons
	local wc = column(258, 360, "WEAPONS")
	pickList(wc, Config.Weapons, "Weapon", function(w)
		return w.Name .. "  -  " .. w.Class .. (w.Recipe and "  *" or "")
	end, function(w)
		local r = Config.WeaponRarityById[w.Rarity]
		return r and r.Color or C.Text
	end, 220)
	cycler(wc, UDim2.fromOffset(8, 262), 344, #Config.WeaponRarities - 1, function()
		return pick.Rarity - 1
	end, function(i)
		pick.Rarity = i + 1
	end, function(i)
		local r = Config.WeaponRarities[i + 1]
		return "Rarity: " .. (r.Label or r.Id), r.Color
	end)
	cycler(wc, UDim2.fromOffset(8, 302), 344, #Config.EffectOrder, function()
		return pick.Effect
	end, function(i)
		pick.Effect = i
	end, function(i)
		if i == 0 then
			return "Effect: none", C.Sub
		end
		local e = Config.Effects[Config.EffectOrder[i]]
		return "Effect: " .. e.Name .. " (maxed)", e.Color
	end)
	UITheme.Button(wc, { Text = "GIVE WEAPON", Color = "Purple", Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), MaxText = 18, Corner = 8, OnClick = function()
		fire("GiveWeapon", { Weapon = pick.Weapon, Rarity = Config.WeaponRarities[pick.Rarity].Id, Effect = pick.Effect > 0 and Config.EffectOrder[pick.Effect] or nil })
	end })

	-- armor
	local ac = column(626, 246, "ARMOR")
	pickList(ac, Config.Armors, "Armor", function(a)
		return a.Name
	end, function(a)
		return a.Trim
	end, 220)
	UITheme.Label(ac, { Text = "(uses the weapon rarity picker)", Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 262), Color = C.Sub, MaxText = 13 })
	UITheme.Button(ac, { Text = "GIVE ARMOR", Color = "Blue", Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), MaxText = 18, Corner = 8, OnClick = function()
		fire("GiveArmor", { Armor = pick.Armor, Rarity = Config.WeaponRarities[math.min(pick.Rarity, #Config.ArmorDefense)].Id })
	end })

	-- SERVER
	local sv = page("SERVER")
	UITheme.Label(sv, { Text = "EVENTS (amount = minutes, default 10)", Size = UDim2.new(1, 0, 0, 20), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	local evRow = H.Frame(sv, { Transparency = 1, Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 24) })
	grid(evRow, Vector2.new(168, 50))
	local order = 0
	for key, e in pairs(Config.Events) do
		order += 1
		local b = UITheme.Button(evRow, { Text = e.Name, Color = "Gold", Order = order, MaxText = 18, Corner = 8, OnClick = function()
			fire("StartEvent", { Event = key })
		end })
		b.BackgroundColor3 = e.Color
	end
	UITheme.Button(evRow, { Text = "Stop Events", Color = "Red", Order = 99, MaxText = 18, Corner = 8, OnClick = function()
		fire("StopEvents")
	end })

	UITheme.Label(sv, { Text = "ADMIN ABUSE", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 90), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	local abRow = H.Frame(sv, { Transparency = 1, Size = UDim2.new(1, 0, 0, 112), Position = UDim2.fromOffset(0, 114) })
	grid(abRow, Vector2.new(168, 50))
	local abuse = {
		{ "Ore Rain", "OreRain", "Blue" },
		{ "Coin Rain", "CoinRain", "Gold" },
		{ "Boss Invasion", "BossInvasion", "Red" },
		{ "Everyone Overdrive", "EveryoneOverdrive", "Purple" },
		{ "Kill All Enemies", "KillAll", "Red" },
	}
	for i, a in ipairs(abuse) do
		UITheme.Button(abRow, { Text = a[1], Color = a[3], Order = i, MaxText = 17, Corner = 8, OnClick = function()
			fire(a[2])
		end })
	end

	UITheme.Label(sv, { Text = "ANNOUNCE", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 236), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	local msg = Instance.new("TextBox")
	msg.Size = UDim2.new(1, -190, 0, 48)
	msg.Position = UDim2.fromOffset(0, 260)
	msg.BackgroundColor3 = Color3.fromRGB(14, 12, 22)
	msg.TextColor3 = Color3.new(1, 1, 1)
	msg.PlaceholderText = "Message for the whole server (filtered)..."
	msg.PlaceholderColor3 = C.Sub
	msg.Font = UITheme.BodyFont
	msg.TextScaled = true
	msg.ClearTextOnFocus = false
	msg.Text = ""
	msg.Parent = sv
	UITheme.Corner(msg, 8)
	UITheme.Stroke(msg, 1.5, RED, true)
	UITheme.Button(sv, { Text = "ANNOUNCE", Color = "Red", Size = UDim2.fromOffset(176, 48), Position = UDim2.new(1, 0, 0, 260), AnchorPoint = Vector2.new(1, 0), MaxText = 20, Corner = 8, OnClick = function()
		if msg.Text ~= "" then
			fire("Announce", { Text = msg.Text })
			msg.Text = ""
		end
	end })

	show("PLAYER")
	p.Refresh = function(d)
		if not d.IsAdmin then
			UI.Close()
		end
	end
end

function AdminUI.Init(ui)
	UI = ui
	H = UI.Helpers
	task.spawn(function()
		remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Admin") :: RemoteEvent
	end)
	build()
end

return AdminUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">CameraDirector</string>
            <string name="Source"><![CDATA[--!nonstrict
-- CameraDirector (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/CameraDirector
-- Dynamic camera framing. When you walk near a point of interest (parts
-- tagged "POI" with a FrameRadius > 0: the Forge, altar, statue, portals,
-- tower...) or fight a boss (tagged "CameraFocus"), the camera eases a
-- little toward the landmark so both you and it sit in frame, pulls back a
-- couple of studs and tightens the FOV slightly. It is applied as an offset
-- on top of the normal camera (see VFX.CameraModifier), so it never fights
-- your own camera control, and it switches off in first person, in menus
-- and while the world map is open.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local CameraDirector = {}
CameraDirector.Enabled = true
CameraDirector.Blocked = nil :: (() -> boolean)?

local player = Players.LocalPlayer
local CAM = Config.Camera
local weight = 0
local focusPos: Vector3? = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function candidates()
	local list = CollectionService:GetTagged("POI")
	for _, p in ipairs(CollectionService:GetTagged("CameraFocus")) do
		table.insert(list, p)
	end
	return list
end

-- Best landmark near the player: closest one inside its own radius.
local function pick(rootPos: Vector3): (Vector3?, number)
	local best, bestScore = nil, 0
	for _, part in ipairs(candidates()) do
		if part:IsA("BasePart") and part.Parent then
			local radius = part:GetAttribute("FrameRadius") or 0
			if radius > 0 then
				local d = (Vector3.new(part.Position.X, rootPos.Y, part.Position.Z) - rootPos).Magnitude
				if d < radius and d > 4 then
					-- full strength in the middle of the zone, easing to 0 at the edge
					local score = math.clamp((radius - d) / (radius * 0.45), 0, 1)
					if score > bestScore then
						best, bestScore = part.Position, score
					end
				end
			end
		end
	end
	return best, bestScore
end

local function modifier(cf: CFrame, dt: number): CFrame
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = char and char:FindFirstChild("Head") :: BasePart?
	local cam = workspace.CurrentCamera
	local target = 0
	local poi = nil
	if CameraDirector.Enabled and root and head and cam and cam.CameraType == Enum.CameraType.Custom then
		local firstPerson = (cf.Position - head.Position).Magnitude < 2
		local blocked = CameraDirector.Blocked and CameraDirector.Blocked()
		if not firstPerson and not blocked then
			local p, score = pick(root.Position)
			if p then
				poi = p
				target = score
			end
		end
	end
	weight += (target - weight) * math.min(1, dt * 1.6)
	if poi then
		focusPos = poi
	end
	if weight < 0.002 or not focusPos or not root then
		VFX.SetFovOffset("Framing", 0)
		return cf
	end
	VFX.SetFovOffset("Framing", CAM.FramingFov * weight)

	-- lean the view toward the midpoint of you and the landmark
	local subject = root.Position + Vector3.new(0, 2, 0)
	local mid = subject:Lerp(focusPos, 0.5)
	local look = cf.LookVector
	local toMid = mid - cf.Position
	if toMid.Magnitude < 1 then
		return cf
	end
	toMid = toMid.Unit
	local facing = look:Dot(toMid)
	if facing < 0.2 then
		return cf -- landmark is behind the camera: leave the shot alone
	end
	local w = CAM.FramingWeight * weight * math.clamp((facing - 0.2) / 0.5, 0, 1)
	local newLook = look:Lerp(toMid, w).Unit

	-- pull back a little, but never through walls
	local pull = CAM.FramingPullBack * weight
	local pos = cf.Position
	if pull > 0.05 then
		rayParams.FilterDescendantsInstances = { char :: Instance }
		local back = -newLook * pull
		local hit = workspace:Raycast(pos, back, rayParams)
		pos += hit and back * math.max(0, (hit.Distance - 0.5) / pull) or back
	end
	return CFrame.lookAt(pos, pos + newLook, cf.UpVector)
end

function CameraDirector.Init()
	VFX.CameraModifier = modifier
end

return CameraDirector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Drops</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Drops (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Drops
-- Client-rendered ore drops: pop out of the enemy, bob and glow (loot beams
-- for Epic+). Walk up and press F (the interact prompt) to pick them up -
-- one press grabs every ore within reach. Server-validated; the Auto-Collect
-- gamepass skips the prompt.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local Drops = {}
Drops.OnPickup = nil :: ((string, Vector3) -> ())?

local items = {}
local request: (string, any?) -> () = function() end

-- Pick up every idle drop within reach of the player.
local function collectNearby(root: BasePart?)
	if not root then
		return
	end
	local t = os.clock()
	for _, it in ipairs(items) do
		if it.State == "Idle" and it.Id and (root.Position - it.Gem.Position).Magnitude <= Config.PickupRadius + 2 then
			it.State = "Pending"
			it.NextTry = t + 1.5
			request("Collect", it.Id)
		end
	end
end

local function addPrompt(it)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "PickupPrompt"
	pp.ActionText = "Pick up"
	pp.ObjectText = it.Ore.Name
	pp.HoldDuration = 0
	pp.MaxActivationDistance = Config.PickupRadius
	pp.RequiresLineOfSight = false
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	pp.Style = Enum.ProximityPromptStyle.Custom -- drawn by Client/PromptUI
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp.GamepadKeyCode = Enum.KeyCode.DPadUp
	pp.Parent = it.Gem
	pp.Triggered:Connect(function()
		local char = Players.LocalPlayer.Character
		collectNearby(char and char:FindFirstChild("HumanoidRootPart") :: BasePart?)
	end)
	it.Prompt = pp
end

local function makeGem(ore)
	local order = ore.Order
	local size = 0.8 + order * 0.12
	local gem = VFX.FxPart({ Size = Vector3.one * size, Color = ore.Color, Transparency = 0 })
	gem.Name = "OreDrop"
	gem.Material = Enum.Material.Neon
	local l = Instance.new("PointLight")
	l.Color = ore.Color
	l.Range = 6 + order * 1.5
	l.Brightness = 1.2
	l.Parent = gem
	if order >= 3 then
		VFX.MakeEmitter("Stars", ore.Color, gem, 2 + order)
	end
	local beamHolder = nil
	if order >= 4 then
		beamHolder = VFX.FxPart({ Size = Vector3.one * 0.1, Transparency = 1 })
		local a0 = Instance.new("Attachment")
		a0.Parent = beamHolder
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, 10 + order * 3, 0)
		a1.Parent = beamHolder
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.Width0 = 1.4 + order * 0.2
		b.Width1 = 0.2
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = 3
		b.Color = ColorSequence.new(Color3.new(1, 1, 1), ore.Color)
		b.Transparency = VFX.NS(0, 0.2, 1, 1)
		b.Parent = beamHolder
		if order >= 5 then
			-- small, crisp label for rare drops (soft shadow, no heavy outline)
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(110, 17)
			bb.StudsOffset = Vector3.new(0, 2.2, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 60
			bb.LightInfluence = 0
			bb.Adornee = gem
			bb.Parent = gem
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Config.Fonts.Heading
			t.TextScaled = true
			t.Text = ore.Name
			t.TextColor3 = ore.Color:Lerp(Color3.new(1, 1, 1), 0.2)
			t.Parent = bb
			local st = Instance.new("UIStroke")
			st.Thickness = 1
			st.Transparency = 0.45
			st.Parent = t
		end
	end
	return gem, beamHolder
end

function Drops.Init(requestFn)
	request = requestFn
end

-- payload = {Id?, Ore, Pos, Auto?}
function Drops.Spawn(payload)
	local ore = Config.OreById[payload.Ore]
	if not ore then
		return
	end
	local gem, beamHolder = makeGem(ore)
	local from = payload.Pos + Vector3.new(0, 2.5, 0)
	local ang = math.random() * math.pi * 2
	local land = Vector3.new(payload.Pos.X + math.cos(ang) * 2.5, payload.Pos.Y, payload.Pos.Z + math.sin(ang) * 2.5)
	gem.CFrame = CFrame.new(from)
	if beamHolder then
		beamHolder.CFrame = CFrame.new(land)
	end
	local item = {
		Gem = gem,
		Beam = beamHolder,
		Ore = ore,
		Id = payload.Id,
		State = "Pop",
		T = 0,
		From = from,
		Land = land,
		NextTry = 0,
		Expire = os.clock() + Config.DropLifetime,
		Auto = payload.Auto,
		Spin = math.random() * 6,
	}
	if ore.Order >= 4 then
		VFX.Flash(from, ore.Color, 5, 0.3)
		SFX.Play("RarePickup", { At = from, Volume = 0.5, Pitch = 0.8 })
	end
	table.insert(items, item)
end

local function find(id)
	for _, it in ipairs(items) do
		if it.Id == id then
			return it
		end
	end
	return nil
end

function Drops.Collected(id)
	local it = find(id)
	if it then
		it.State = "Fly"
		it.T = 0
		it.FlyFrom = it.Gem.Position
	end
end

function Drops.Fail(id, full: boolean?)
	local it = find(id)
	if it then
		it.State = "Idle"
		it.NextTry = os.clock() + (full and 3 or 1.5)
	end
end

local function destroy(it)
	it.Gem:Destroy()
	if it.Beam then
		it.Beam:Destroy()
	end
end

function Drops.Step(dt: number, root: BasePart?)
	local t = os.clock()
	for i = #items, 1, -1 do
		local it = items[i]
		it.T += dt
		it.Spin += dt * 2.5
		local remove = false
		if it.State == "Pop" then
			local a = math.min(1, it.T / 0.45)
			local pos = it.From:Lerp(it.Land, a) + Vector3.new(0, math.sin(a * math.pi) * 4, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(it.Spin, it.Spin * 0.7, 0)
			if a >= 1 then
				it.State = it.Auto and "Fly" or "Idle"
				it.T = 0
				it.FlyFrom = it.Gem.Position
				VFX.Emit(it.Land, "Sparks", 6, it.Ore.Color)
				if not it.Auto and it.Id then
					addPrompt(it)
				end
			end
		elseif it.State == "Idle" or it.State == "Pending" then
			local pos = it.Land + Vector3.new(0, 0.9 + math.sin(t * 3 + it.Spin) * 0.35, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(0.6, it.Spin, 0.6)
			if it.Beam then
				it.Beam.CFrame = CFrame.new(it.Land)
			end
			if it.Prompt then
				it.Prompt.Enabled = it.State == "Idle" and t >= it.NextTry
			end
			if it.State == "Pending" and t >= it.NextTry then
				it.State = "Idle"
			end
			if t > it.Expire then
				remove = true
			end
		elseif it.State == "Fly" then
			if it.Prompt then
				it.Prompt:Destroy()
				it.Prompt = nil
			end
			if it.Beam then
				it.Beam:Destroy()
				it.Beam = nil
			end
			local target = root and root.Position or it.FlyFrom
			local a = math.min(1, it.T / 0.28)
			local ease = a * a
			local pos = it.FlyFrom:Lerp(target, ease) + Vector3.new(0, math.sin(a * math.pi) * 2.5, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(it.Spin * 3, it.Spin * 3, 0)
			it.Gem.Size = Vector3.one * math.max(0.2, (0.8 + it.Ore.Order * 0.12) * (1 - a * 0.6))
			if a >= 1 then
				remove = true
				VFX.Emit(target, "Stars", 4 + it.Ore.Order, it.Ore.Color)
				if it.Ore.Order >= 4 then
					SFX.Play("RarePickup", { Pitch = 0.9 + it.Ore.Order * 0.05 })
				else
					SFX.Play("OrePickup", { Pitch = 0.85 + it.Ore.Order * 0.12 })
				end
				if Drops.OnPickup then
					Drops.OnPickup(it.Ore.Id, target)
				end
			end
		end
		if remove then
			destroy(it)
			table.remove(items, i)
		end
	end
end

function Drops.ClearAll()
	for _, it in ipairs(items) do
		destroy(it)
	end
	table.clear(items)
end

return Drops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">EnemyFX</string>
            <string name="Source"><![CDATA[--!nonstrict
-- EnemyFX (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/EnemyFX
-- Client-side life for enemies (all visual, nothing gameplay-relevant):
--   * Poses from the server's "Pose" attribute, blended on the waist joint:
--       Anticipate / Windup  lean back, eyes flare white, core burns hot
--       Strike               snap forward
--       Recover              slump forward, eyes and core go dim (the
--                            punish window: hits here deal extra damage)
--       Stagger / Flinch     quick recoil
--   * Health read without a head bar: the chest core dims toward embers and
--     starts to flicker as HP drops.
--   * A hair-thin health line appears for 2 s only on enemies YOU hit.
--   * Bosses get a slim top-of-screen bar only while you are near them.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local EnemyFX = {}

local player = Players.LocalPlayer
local UI
local tracked = {} -- [Model] = state
local bossBar, bossName, bossFill, bossChip
local bossShown = 0
local lastBoss = nil

-- lean targets in degrees (+ = lean back)
local POSES = {
	Idle = { Lean = 0, Speed = 6 },
	Anticipate = { Lean = 14, Speed = 5, Flare = true },
	Windup = { Lean = 20, Speed = 3.5, Flare = true },
	Strike = { Lean = -24, Speed = 28 },
	Recover = { Lean = -12, Speed = 7, Dim = true },
	Stagger = { Lean = 18, Speed = 24 },
	Flinch = { Lean = 7, Speed = 30 },
}

local EMBER = Color3.fromRGB(45, 12, 10)

local function setup(model: Instance)
	if not model:IsA("Model") or tracked[model] then
		return
	end
	local waist = model:FindFirstChild("Waist", true)
	local r6 = false
	if not (waist and waist:IsA("Motor6D")) then
		waist = model:FindFirstChild("RootJoint", true)
		r6 = true
	end
	local eyes = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Eye" then
			table.insert(eyes, d)
		end
	end
	local core = model:FindFirstChild("Core", true)
	if not core and not model:GetAttribute("FXRetry") then
		-- parts may still be replicating; try once more shortly
		model:SetAttribute("FXRetry", true)
		task.delay(1, setup, model)
		return
	end
	local state = {
		Model = model,
		Waist = (waist and waist:IsA("Motor6D")) and waist or nil,
		BaseC0 = (waist and waist:IsA("Motor6D")) and waist.C0 or nil,
		R6 = r6,
		Eyes = eyes,
		Core = core,
		Light = core and core:FindFirstChild("CoreLight"),
		CoreColor = model:GetAttribute("CoreColor") or (core and core.Color) or Color3.new(1, 0.3, 0.3),
		Lean = 0,
		Pose = "Idle",
		PoseEnds = 0,
		Flicker = 0,
		Sliver = nil,
		SliverUntil = 0,
	}
	tracked[model] = state
	model:GetAttributeChangedSignal("PoseId"):Connect(function()
		local pose = model:GetAttribute("Pose") or "Idle"
		local dur = model:GetAttribute("PoseDur") or 0
		state.Pose = POSES[pose] and pose or "Idle"
		state.PoseEnds = os.clock() + math.max(dur, 0.12)
		if POSES[state.Pose].Flare then
			local head = model:FindFirstChild("Head")
			if head then
				-- anime "glint" on the eyes: the tell that an attack is coming
				VFX.Emit((head :: BasePart).Position + (head :: BasePart).CFrame.LookVector * 0.7, "Stars", 2, Color3.new(1, 1, 1))
			end
		elseif state.Pose == "Recover" and core then
			VFX.Emit((core :: BasePart).Position, "Smoke", 2, Color3.fromRGB(200, 200, 210))
		end
	end)
end

local function sliverFor(state)
	if state.Sliver then
		return state.Sliver
	end
	local head = state.Model:FindFirstChild("Head")
	if not head then
		return nil
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "HPSliver"
	bb.Size = UDim2.fromOffset(64, 3)
	bb.StudsOffset = Vector3.new(0, (head :: BasePart).Size.Y + 1.1, 0)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Enabled = false
	bb.Parent = player:WaitForChild("PlayerGui")
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.new(0, 0, 0)
	bg.BackgroundTransparency = 0.6
	bg.BorderSizePixel = 0
	bg.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = state.CoreColor
	fill.BorderSizePixel = 0
	fill.Parent = bg
	state.Sliver = bb
	return bb
end

-- Called from the client's FX "Hit" handler.
function EnemyFX.OnHit(model: Model?, byLocal: boolean)
	local state = model and tracked[model]
	if not state then
		return
	end
	if state.Pose == "Idle" or os.clock() > state.PoseEnds then
		state.Pose = "Flinch"
		state.PoseEnds = os.clock() + 0.1
	end
	if byLocal and not state.Model:GetAttribute("Boss") then
		local bb = sliverFor(state)
		if bb then
			state.SliverUntil = os.clock() + 2
			bb.Enabled = true
		end
	end
end

local function applyLean(state, deg: number)
	if not state.Waist or not state.BaseC0 or not state.Waist.Parent then
		return
	end
	local a = math.rad(deg) * (state.R6 and -1 or 1)
	state.Waist.C0 = state.BaseC0 * CFrame.Angles(a, 0, 0)
end

local function stepEnemy(state, dt: number, t: number)
	local model = state.Model
	local hp = model:GetAttribute("HP") or 1
	-- pose blending
	local pose = state.Pose
	if t > state.PoseEnds and pose ~= "Idle" then
		pose = "Idle"
		state.Pose = "Idle"
	end
	local P = POSES[pose]
	state.Lean += (P.Lean - state.Lean) * math.min(1, dt * P.Speed)
	applyLean(state, state.Lean)

	-- core + eyes: the health read and the attack tell
	local base = state.CoreColor
	local coreColor = base:Lerp(EMBER, (1 - hp) * 0.75)
	local lightB = 0.35 + 1.3 * hp
	local eyeT = 0
	local eyeColor = base
	if P.Flare then
		local k = 0.6 + 0.4 * math.sin(t * 30)
		coreColor = coreColor:Lerp(Color3.new(1, 1, 1), 0.55 * k)
		eyeColor = base:Lerp(Color3.new(1, 1, 1), 0.7)
		lightB = 3.2
	elseif P.Dim then
		coreColor = coreColor:Lerp(EMBER, 0.6)
		eyeT = 0.55
		lightB = 0.15
	end
	if hp < 0.3 and hp > 0 then
		-- failing core flickers
		state.Flicker -= dt
		if state.Flicker <= 0 then
			state.Flicker = 0.05 + math.random() * 0.25
			state.FlickerOn = math.random() < 0.35
		end
		if state.FlickerOn then
			coreColor = coreColor:Lerp(EMBER, 0.7)
			lightB *= 0.2
		end
	end
	if state.Core and state.Core.Parent then
		state.Core.Color = coreColor
	end
	if state.Light then
		state.Light.Brightness = lightB
	end
	for _, eye in ipairs(state.Eyes) do
		eye.Color = eyeColor
		eye.Transparency = eyeT
	end

	-- thin hp line (only after you hit it)
	if state.Sliver then
		if t < state.SliverUntil and hp > 0 then
			local fill = state.Sliver:FindFirstChild("Fill", true)
			if fill then
				(fill :: Frame).Size = UDim2.fromScale(hp, 1)
			end
		elseif state.Sliver.Enabled then
			state.Sliver.Enabled = false
		end
	end
end

local function buildBossBar()
	local root = UI.Root()
	local H = UI.Helpers
	bossBar = Instance.new("CanvasGroup")
	bossBar.Name = "BossBar"
	bossBar.BackgroundTransparency = 1
	bossBar.GroupTransparency = 1
	bossBar.Visible = false
	bossBar.Size = UDim2.fromOffset(420, 34)
	bossBar.AnchorPoint = Vector2.new(0.5, 0)
	bossBar.Position = UDim2.new(0.5, 0, 0, 150)
	bossBar.Parent = root
	bossName = H.Text(bossBar, { Text = "", Font = Config.Fonts.Display, Size = UDim2.new(1, 0, 0, 16), Color = Color3.fromRGB(255, 200, 210) })
	local bg = H.Frame(bossBar, { Color = Color3.fromRGB(10, 6, 14), Transparency = 0.4, Size = UDim2.new(1, 0, 0, 5), Position = UDim2.fromOffset(0, 22), Corner = 3 })
	bossChip = H.Frame(bg, { Color = Color3.new(1, 1, 1), Transparency = 0.3, Size = UDim2.fromScale(1, 1), Corner = 3 })
	bossFill = H.Frame(bg, { Color = Color3.fromRGB(255, 70, 100), Size = UDim2.fromScale(1, 1), Corner = 3, ZIndex = 2 })
end

function EnemyFX.Step(dt: number)
	local t = os.clock()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local nearestBoss, bossDist = nil, 110
	for model, state in pairs(tracked) do
		if not model.Parent then
			if state.Sliver then
				state.Sliver:Destroy()
			end
			tracked[model] = nil
			continue
		end
		local r = model:FindFirstChild("HumanoidRootPart")
		local near = root and r and ((r :: BasePart).Position - root.Position).Magnitude or math.huge
		-- only animate enemies you can actually see nearby
		if near < 160 then
			stepEnemy(state, dt, t)
		end
		if model:GetAttribute("Boss") and near < bossDist and (model:GetAttribute("HP") or 0) > 0 then
			nearestBoss, bossDist = model, near
		end
	end

	-- boss bar (contextual)
	if bossBar then
		if nearestBoss then
			local hp = nearestBoss:GetAttribute("HP") or 1
			if nearestBoss ~= lastBoss then
				lastBoss = nearestBoss
				bossName.Text = nearestBoss.Name:upper()
				bossChip.Size = UDim2.fromScale(hp, 1)
			end
			bossFill.Size = UDim2.fromScale(hp, 1)
			local chip = bossChip.Size.X.Scale
			bossChip.Size = UDim2.fromScale(chip + (hp - chip) * math.min(1, dt * 2.5), 1)
			bossShown = math.min(1, bossShown + dt * 4)
		else
			bossShown = math.max(0, bossShown - dt * 2)
		end
		bossBar.GroupTransparency = 1 - bossShown
		bossBar.Visible = bossShown > 0.01
	end
end

function EnemyFX.Init(ui)
	UI = ui
	for _, m in ipairs(CollectionService:GetTagged("Enemy")) do
		setup(m)
	end
	CollectionService:GetInstanceAddedSignal("Enemy"):Connect(setup)
	buildBossBar()
end

return EnemyFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ForgeUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- ForgeUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/ForgeUI
-- The Soul Forge panel (weapon crafting). Pick 1-3 ores from your bag and an
-- optional catalyst; the preview (GameShared/ForgeRules, same maths as the
-- server) shows the effects the weapon will carry, the weapon-type odds, the
-- minimum rarity, the coin fee and whether you hit a unique recipe.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local ForgeRules = require(Shared:WaitForChild("ForgeRules"))
local SFX = require(Shared:WaitForChild("SFX"))

local ForgeUI = {}
local UI, H
local request: (string, any?) -> () = function() end
local C = UITheme.Colors
local FORGE = Color3.fromRGB(255, 140, 60)

local slots: { string } = {}
local lastForged: { string } = {}
local catalyst: string? = nil
local showBook = false
local panel = nil

local function used(oreId: string): number
	local n = 0
	for _, id in ipairs(slots) do
		if id == oreId then
			n += 1
		end
	end
	return n
end

local function coinScale(d): number
	return Config.Rebirth.CoinMult ^ (d.Rebirths or 0) * Config.Ascension.CoinMult ^ (d.Ascensions or 0)
end

function ForgeUI.Clear()
	table.clear(slots)
	catalyst = nil
	if panel then
		panel.Sig = nil
		if UI.Data and panel.Frame.Visible then
			panel.Refresh(UI.Data)
		end
	end
end

local function build()
	local p = H.MakePanel("Forge", "SOUL FORGE", Vector2.new(860, 540), FORGE)
	panel = p

	-- left: ore bag picker
	local left = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(0, 300, 1, 0) })
	UITheme.Label(left, { Text = "YOUR ORE  (click to add)", Size = UDim2.new(1, 0, 0, 20), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	local oreGrid = H.Scroller(left, { Size = UDim2.new(1, 0, 1, -26), Position = UDim2.fromOffset(0, 26) })
	local og = Instance.new("UIGridLayout")
	og.CellSize = UDim2.fromOffset(88, 88)
	og.CellPadding = UDim2.fromOffset(6, 6)
	og.SortOrder = Enum.SortOrder.LayoutOrder
	og.Parent = oreGrid

	-- centre: slots + catalysts + forge button
	local mid = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(0, 250, 1, 0), Position = UDim2.fromOffset(312, 0) })
	UITheme.Label(mid, { Text = "CRUCIBLE", Size = UDim2.new(1, 0, 0, 20), Color = C.Sub, MaxText = 15 })
	local slotRow = H.Frame(mid, { Transparency = 1, Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 26) })
	H.List(slotRow, 8, true)
	local slotFrames = {}
	for i = 1, Config.Forge.Slots do
		local sf = H.Frame(slotRow, { Color = Color3.fromRGB(14, 12, 22), Size = UDim2.fromOffset(76, 76), Order = i, Corner = 10 })
		local st = UITheme.Stroke(sf, 2, FORGE, true)
		st.Transparency = 0.5
		local gem = H.Frame(sf, { Name = "Gem", Color = C.Line, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0.5, 0, 0, 30), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 2 })
		gem.Rotation = 45
		local lbl = UITheme.Label(sf, { Text = "empty", Size = UDim2.new(1, -6, 0, 16), Position = UDim2.new(0, 3, 1, -20), Color = C.Sub, MaxText = 12, StrokeThickness = 1 })
		lbl.Name = "Label"
		local btn = Instance.new("TextButton")
		btn.BackgroundTransparency = 1
		btn.Text = ""
		btn.Size = UDim2.fromScale(1, 1)
		btn.Parent = sf
		btn.Activated:Connect(function()
			if slots[i] then
				table.remove(slots, i)
				SFX.Play("UIClose")
				p.Sig = nil
				p.Refresh(UI.Data)
			end
		end)
		slotFrames[i] = { Frame = sf, Gem = gem, Label = lbl, Stroke = st }
	end

	UITheme.Label(mid, { Text = "CATALYST  (optional)", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 118), Color = C.Sub, MaxText = 14 })
	local catRow = H.Frame(mid, { Transparency = 1, Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 140) })
	H.List(catRow, 6)
	local catButtons = {}
	for i, key in ipairs(Config.CatalystOrder) do
		local cat = Config.Catalysts[key]
		local b = H.Frame(catRow, { Color = C.Row, Size = UDim2.new(1, 0, 0, 34), Order = i, Corner = 8 })
		local st = UITheme.Stroke(b, 1.5, cat.Color, true)
		st.Transparency = 0.6
		H.Accent(b, cat.Color)
		local lbl = UITheme.Label(b, { Text = cat.Name, Size = UDim2.new(1, -24, 1, -8), Position = UDim2.fromOffset(16, 4), XAlign = Enum.TextXAlignment.Left, Color = cat.Color, MaxText = 15 })
		lbl.Name = "Label"
		local click = Instance.new("TextButton")
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.Parent = b
		click.Activated:Connect(function()
			local d = UI.Data
			if not d then
				return
			end
			if catalyst == key then
				catalyst = nil
			elseif (d.Keys[key] or 0) > 0 then
				catalyst = key
			else
				UI.Notify("You have no " .. cat.Name .. ". Earn them from play-time rewards, bosses and the Boss Rush.", C.Red)
				return
			end
			SFX.Play("UIClick")
			p.Sig = nil
			p.Refresh(d)
		end)
		catButtons[key] = { Frame = b, Stroke = st, Label = lbl }
	end

	UITheme.Button(mid, { Text = "FORGE", Color = "Red", Size = UDim2.new(1, 0, 0, 70), Position = UDim2.new(0, 0, 1, -44), AnchorPoint = Vector2.new(0, 1), MaxText = 32, Sound = "Forge", OnClick = function()
		if #slots == 0 then
			UI.Notify("Add at least one ore to the crucible.", C.Red)
			return
		end
		lastForged = table.clone(slots)
		request("Forge", { Ores = table.clone(slots), Catalyst = catalyst })
	end })
	-- QoL: refill the crucible with the last mix, or with your rarest ore
	local qol = H.Frame(mid, { Transparency = 1, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 262) })
	H.List(qol, 6, true)
	UITheme.Button(qol, { Text = "REPEAT LAST", Color = "Blue", Size = UDim2.new(0.5, -3, 1, 0), Order = 1, MaxText = 14, Corner = 8, OnClick = function()
		local d = UI.Data
		if not d or #lastForged == 0 then
			UI.Notify("Forge something first.", C.Red)
			return
		end
		local need = {}
		for _, id in ipairs(lastForged) do
			need[id] = (need[id] or 0) + 1
		end
		for id, n in pairs(need) do
			if (d.Backpack[id] or 0) < n then
				UI.Notify("Not enough ore for the last mix.", C.Red)
				return
			end
		end
		slots = table.clone(lastForged)
		p.Sig = nil
		p.Refresh(d)
	end })
	UITheme.Button(qol, { Text = "AUTO-FILL", Color = "Purple", Size = UDim2.new(0.5, -3, 1, 0), Order = 2, MaxText = 14, Corner = 8, OnClick = function()
		local d = UI.Data
		if not d then
			return
		end
		for i = #Config.Ores, 1, -1 do
			local ore = Config.Ores[i]
			while #slots < Config.Forge.Slots and used(ore.Id) < (d.Backpack[ore.Id] or 0) do
				table.insert(slots, ore.Id)
			end
		end
		p.Sig = nil
		p.Refresh(d)
	end })
	local costLabel = UITheme.Label(mid, { Text = "", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -18), Color = C.Gold, MaxText = 16 })

	-- right: preview / recipe book
	local right = H.Frame(p.Body, { Color = C.Row, Size = UDim2.new(1, -574, 1, 0), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Corner = 10, Stroke = 1 })
	local tabs = H.Frame(right, { Transparency = 1, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 8) })
	H.List(tabs, 6, true)
	local previewPage = H.Frame(right, { Transparency = 1, Size = UDim2.new(1, -16, 1, -54), Position = UDim2.fromOffset(8, 48) })
	local bookPage = H.Scroller(right, { Size = UDim2.new(1, -8, 1, -54), Position = UDim2.fromOffset(4, 48) })
	H.List(bookPage, 6)
	UITheme.Button(tabs, { Text = "PREVIEW", Color = "Blue", Size = UDim2.new(0.5, -3, 1, 0), Order = 1, MaxText = 16, OnClick = function()
		showBook = false
		p.Sig = nil
		p.Refresh(UI.Data)
	end })
	UITheme.Button(tabs, { Text = "RECIPES", Color = "Purple", Size = UDim2.new(0.5, -3, 1, 0), Order = 2, MaxText = 16, OnClick = function()
		showBook = true
		p.Sig = nil
		p.Refresh(UI.Data)
	end })
	local previewText = UITheme.Label(previewPage, { Text = "", Rich = true, Size = UDim2.fromScale(1, 1), XAlign = Enum.TextXAlignment.Left, MaxText = 16, StrokeThickness = 1 })
	previewText.TextWrapped = true
	previewText.TextYAlignment = Enum.TextYAlignment.Top

	local function oreCell(parent, ore, count: number, order: number)
		local cell = H.Frame(parent, { Color = C.Row, Order = order, Corner = 10 })
		local rarity = Config.Rarity[ore.Rarity]
		local st = UITheme.Stroke(cell, 1.5, rarity.Color, true)
		st.Transparency = 0.35
		local gem = H.Frame(cell, { Color = ore.Color, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(0.5, 0, 0, 24), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 2 })
		gem.Rotation = 45
		UITheme.Label(cell, { Text = ore.Name, Size = UDim2.new(1, -6, 0, 16), Position = UDim2.fromOffset(3, 44), Color = ore.Color, MaxText = 12, StrokeThickness = 1 })
		local eff = Config.Effects[ore.Effect]
		UITheme.Label(cell, { Text = (eff and eff.Name or "") .. "  x" .. count, Size = UDim2.new(1, -6, 0, 14), Position = UDim2.fromOffset(3, 62), Color = C.Sub, MaxText = 11, StrokeThickness = 1 })
		local click = Instance.new("TextButton")
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.Parent = cell
		click.Activated:Connect(function()
			if #slots >= Config.Forge.Slots then
				UI.Notify("The crucible holds " .. Config.Forge.Slots .. " ores. Click a slot to remove one.", C.Red)
				return
			end
			local d = UI.Data
			if d and used(ore.Id) < (d.Backpack[ore.Id] or 0) then
				table.insert(slots, ore.Id)
				SFX.Play("UIClick")
				p.Sig = nil
				p.Refresh(d)
			end
		end)
	end

	local function previewRich(d): string
		if #slots == 0 then
			return '<font color="#b0aacd">Drop ores in the crucible.\n\n- Each ore stamps its effect on the weapon (duplicates stack).\n- Effects decide the weapon type.\n- Rarer ores raise the rarity.\n- Exact 3-ore recipes forge unique weapons.</font>'
		end
		local a = ForgeRules.Analyze(slots)
		if not a then
			return ""
		end
		local lines = {}
		if a.Recipe then
			local w = Config.WeaponById[a.Recipe.Weapon]
			table.insert(lines, string.format('<font color="#ff64b9"><b>UNIQUE RECIPE: %s</b></font>', w and w.Name or a.Recipe.Weapon))
		else
			local odds = ForgeRules.ClassOdds(a)
			local parts = {}
			for k, o in ipairs(odds) do
				if k > 4 then
					break
				end
				table.insert(parts, string.format("%s %d%%", o.Class, math.floor(o.Chance * 100 + 0.5)))
			end
			table.insert(lines, '<font color="#8fd3ff">Type:</font> ' .. table.concat(parts, ", "))
		end
		local minIndex = a.MinRarityIndex
		if catalyst then
			minIndex = math.max(minIndex, Config.WeaponRarityById[Config.Catalysts[catalyst].MinRarity].Index)
		end
		local minR = Config.WeaponRarities[minIndex]
		table.insert(lines, string.format('<font color="#%s">Rarity: %s or better</font>  (luck x%s)', minR.Color:ToHex(), minR.Label or minR.Id, string.format("%.1f", a.Luck)))
		table.insert(lines, "")
		table.insert(lines, '<font color="#ffc35a">EFFECTS</font>')
		for _, id in ipairs(Config.EffectOrder) do
			local pts = a.Effects[id]
			if pts then
				table.insert(lines, string.format('<font color="#%s">%s</font>', Config.Effects[id].Color:ToHex(), Config.EffectText(id, pts)))
			end
		end
		table.insert(lines, "")
		table.insert(lines, string.format('<font color="#ffaa5a">+%s Forge levels</font>', Format.Abbrev(math.max(1, math.floor(a.Blade * (d.Derived.ForgeMult or 1))))))
		return table.concat(lines, "\n")
	end

	p.Refresh = function(d)
		if not d then
			return
		end
		-- drop slots the bag no longer covers
		for i = #slots, 1, -1 do
			local id = slots[i]
			if used(id) > (d.Backpack[id] or 0) then
				table.remove(slots, i)
			end
		end
		if catalyst and (d.Keys[catalyst] or 0) <= 0 then
			catalyst = nil
		end
		local sigParts = { table.concat(slots, "+"), catalyst or "", showBook and "B" or "P", d.Coins >= 0 and math.floor(math.log10(d.Coins + 1) * 10) or 0 }
		for _, ore in ipairs(Config.Ores) do
			table.insert(sigParts, d.Backpack[ore.Id] or 0)
		end
		for _, key in ipairs(Config.CatalystOrder) do
			table.insert(sigParts, d.Keys[key] or 0)
		end
		for key in pairs(d.Recipes or {}) do
			table.insert(sigParts, key)
		end
		local sig = table.concat(sigParts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig

		-- ore grid
		H.Clear(oreGrid)
		local any = false
		for i, ore in ipairs(Config.Ores) do
			local left = (d.Backpack[ore.Id] or 0) - used(ore.Id)
			if left > 0 then
				any = true
				oreCell(oreGrid, ore, left, i)
			end
		end
		if not any then
			local t = UITheme.Label(oreGrid, { Text = "No ore left. Clear dungeon floors to find more!", Size = UDim2.fromOffset(280, 60), Color = C.Sub, MaxText = 15 })
			t.TextWrapped = true
		end

		-- slots
		for i, sf in ipairs(slotFrames) do
			local ore = slots[i] and Config.OreById[slots[i]]
			sf.Gem.BackgroundColor3 = ore and ore.Color or C.Line
			sf.Label.Text = ore and ore.Name or "empty"
			sf.Label.TextColor3 = ore and ore.Color or C.Sub
			sf.Stroke.Transparency = ore and 0.05 or 0.5
		end

		-- catalysts
		for key, cb in pairs(catButtons) do
			local have = d.Keys[key] or 0
			cb.Label.Text = Config.Catalysts[key].Name .. "  x" .. have .. (catalyst == key and "  (ON)" or "")
			cb.Stroke.Transparency = catalyst == key and 0 or 0.6
			cb.Frame.BackgroundTransparency = have > 0 and 0 or 0.5
		end

		-- cost
		local a = #slots > 0 and ForgeRules.Analyze(slots) or nil
		if a then
			local cost = ForgeRules.Cost(a, coinScale(d))
			costLabel.Text = "Fee: " .. Format.Abbrev(cost) .. " Coins"
			costLabel.TextColor3 = d.Coins >= cost and C.Gold or C.Red
		else
			costLabel.Text = ""
		end

		-- right side
		previewPage.Visible = not showBook
		bookPage.Visible = showBook
		if showBook then
			H.Clear(bookPage)
			for i, r in ipairs(Config.Recipes) do
				local known = d.Recipes and d.Recipes[r.Key]
				local w = Config.WeaponById[r.Weapon]
				local rarity = w and Config.WeaponRarityById[w.Rarity]
				local row = H.Row(bookPage, 52, i)
				H.Accent(row, rarity and rarity.Color or C.Line)
				UITheme.Label(row, { Text = known and (w and w.Name or r.Weapon) or "???", Title = true, Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(16, 4), XAlign = Enum.TextXAlignment.Left, Color = known and (rarity and rarity.Color or C.Text) or C.Sub, MaxText = 17 })
				local sub
				if known then
					local names = {}
					for _, id in ipairs(r.Ores) do
						table.insert(names, Config.OreById[id] and Config.OreById[id].Name or id)
					end
					sub = table.concat(names, " + ")
				else
					sub = "Hint: " .. r.Hint
				end
				UITheme.Label(row, { Text = sub, Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(16, 28), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 13 })
			end
		else
			previewText.Text = previewRich(d)
		end
	end
end

function ForgeUI.Init(ui, requestFn)
	UI = ui
	H = UI.Helpers
	request = requestFn
	build()
end

return ForgeUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hud (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Hud
-- Clean-screen HUD. Nothing here is permanently on screen; every group is a
-- CanvasGroup that fades in only when it matters and fades out after
-- Config.Hud.*Linger seconds:
--   Vitals   slim HP + stamina bars (with a trailing damage chip), boost /
--            Overdrive tags. Shows on damage, healing, stamina use, combat,
--            potions, and stays while HP is low (plus a soft red vignette).
--   Hotbar   compact LMB / Q / E / R / C slots with cooldown sweeps. Shows
--            in combat, while a cooldown runs, or right after equipping.
--   Playtime next play-time reward timer. Shows shortly before a reward,
--            when one is granted, and while the menu drawer is open.
-- Opening the menu drawer (G) "peeks" every group.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))

local Hud = {}

local player = Players.LocalPlayer
local HC = Config.Hud
local UI, Abilities
local H
local slots = {}
local groups = {} -- [name] = { Frame, Until, Alpha }
local hpFill, hpChip, hpText, stFill, stBar, tagText
local ptTitle, ptTimer, ptFill
local vignette = {}
local lastHealth = nil
local lastStamina = nil
local lastRewardIndex = 0
local enemyCheck = 0

local FONT = Config.Fonts.Heading
local FONT_LIGHT = Config.Fonts.Body

local SLOTS = {
	{ Slot = "LMB", Name = "Attack", Keys = { Keyboard = "LMB", Gamepad = "RT", Touch = "" }, Color = Color3.fromRGB(230, 230, 240) },
	{ Slot = "Q", Name = "Dash", Keys = { Keyboard = "Q", Gamepad = "B", Touch = "" }, Color = Color3.fromRGB(120, 200, 255) },
	{ Slot = "E", Name = "Skill", Keys = { Keyboard = "E", Gamepad = "X", Touch = "" }, Color = Color3.fromRGB(255, 190, 90) },
	{ Slot = "R", Name = "Ultimate", Keys = { Keyboard = "R", Gamepad = "Y", Touch = "" }, Color = Color3.fromRGB(255, 90, 120) },
	{ Slot = "C", Name = "Overdrive", Keys = { Keyboard = "C", Gamepad = "LB", Touch = "" }, Color = Color3.fromRGB(255, 140, 60) },
}

local function device(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	end
	return "Keyboard"
end

-- Small text with a light drop shadow instead of a heavy outline.
local function text(parent: Instance, props)
	local t = Instance.new("TextLabel")
	t.Name = props.Name or "Text"
	t.BackgroundTransparency = 1
	t.Font = props.Font or FONT
	t.TextScaled = true
	t.Text = props.Text or ""
	t.TextColor3 = props.Color or Color3.new(1, 1, 1)
	t.TextTransparency = props.Transparency or 0
	t.Size = props.Size
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	t.ZIndex = props.ZIndex or 2
	t.Parent = parent
	local st = Instance.new("UIStroke")
	st.Thickness = 1
	st.Color = Color3.fromRGB(6, 4, 14)
	st.Transparency = 0.55
	st.Parent = t
	return t
end

local function group(name: string, props): CanvasGroup
	local g = Instance.new("CanvasGroup")
	g.Name = name
	g.BackgroundTransparency = 1
	g.GroupTransparency = 1
	g.Visible = false
	g.Size = props.Size
	g.Position = props.Position
	g.AnchorPoint = props.AnchorPoint or Vector2.zero
	g.Parent = props.Parent
	groups[name] = { Frame = g, Until = 0, Alpha = 0 }
	return g
end

-- Keep a group on screen for at least `seconds` from now.
function Hud.Ping(name: string, seconds: number)
	local g = groups[name]
	if g then
		g.Until = math.max(g.Until, os.clock() + seconds)
	end
end

-- Entering / staying in combat: vitals + hotbar.
function Hud.Combat()
	Hud.Ping("Vitals", HC.CombatLinger)
	Hud.Ping("Hotbar", HC.CombatLinger)
end

local function refreshKeys()
	local d = device()
	for _, s in ipairs(slots) do
		s.Key.Text = s.Def.Keys[d] or ""
		s.Key.Visible = s.Key.Text ~= ""
	end
end

function Hud.RefreshSkillNames()
	for _, s in ipairs(slots) do
		if s.Def.Slot == "E" or s.Def.Slot == "R" then
			local _, skill = Abilities.SkillFor(s.Def.Slot)
			s.Name.Text = skill and skill.Name or s.Def.Name
		elseif s.Def.Slot == "LMB" then
			local def = Config.WeaponById[player:GetAttribute("WeaponId") or Config.StarterWeapon]
			s.Name.Text = def and def.Name or "Attack"
		end
	end
	Hud.Ping("Hotbar", 3)
end

function Hud.FlashStamina()
	Hud.Ping("Vitals", HC.StaminaLinger + 1)
	if stBar then
		stBar.BackgroundColor3 = Color3.fromRGB(220, 50, 60)
		stBar.BackgroundTransparency = 0.2
		H.Tween(stBar, 0.5, { BackgroundColor3 = Color3.fromRGB(10, 8, 20), BackgroundTransparency = 0.55 })
	end
end

-- Called when the player takes damage (server FX "Hurt").
function Hud.Hurt()
	Hud.Ping("Vitals", HC.DamageLinger)
	Hud.Combat()
end

local function nextReward(session: number)
	local prevMinutes = 0
	for i, r in ipairs(Config.PlaytimeRewards) do
		if session < r.Minutes * 60 then
			return r, prevMinutes, i
		end
		prevMinutes = r.Minutes
	end
	return nil, prevMinutes, #Config.PlaytimeRewards + 1
end

local function anyCooldown(t: number): boolean
	for _, slot in ipairs({ "Q", "E", "R" }) do
		if (Abilities.CooldownEnds[slot] or 0) > t then
			return true
		end
	end
	return false
end

local function enemyNear(): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local folder = workspace:FindFirstChild("Enemies")
	if not root or not folder then
		return false
	end
	local range = Config.EnemyAggroRange
	for _, m in ipairs(folder:GetChildren()) do
		local r = m:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - root.Position).Magnitude < range * (m:GetAttribute("Boss") and 2 or 1) then
			return true
		end
	end
	return false
end

function Hud.Tick(dt: number)
	local t = os.clock()
	local d = UI.Data
	local peek = UI.IsPeeking()

	-- context triggers ----------------------------------------------------
	enemyCheck -= dt
	if enemyCheck <= 0 then
		enemyCheck = 0.25
		if enemyNear() then
			Hud.Combat()
		end
	end
	if anyCooldown(t) then
		Hud.Ping("Hotbar", 0.6)
	end

	-- hotbar cooldowns ----------------------------------------------------
	for _, s in ipairs(slots) do
		local slot = s.Def.Slot
		local ends = Abilities.CooldownEnds[slot] or 0
		local len = math.max(0.01, Abilities.CooldownLength[slot] or 1)
		local left = ends - t
		if slot == "C" and d then
			left = (d.OverdriveEnd or 0) - workspace:GetServerTimeNow()
			len = 180
			s.Badge.Text = "x" .. tostring(d.Overdrive or 0)
		end
		if left > 0 then
			s.Shade.Size = UDim2.fromScale(1, math.clamp(left / len, 0, 1))
			s.Timer.Text = left >= 10 and tostring(math.floor(left)) or string.format("%.1f", left)
			s.Timer.Visible = slot ~= "LMB"
		else
			s.Shade.Size = UDim2.fromScale(1, 0)
			s.Timer.Visible = false
		end
	end

	-- vitals --------------------------------------------------------------
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hpFrac = 1
	if hum and hum.MaxHealth > 0 then
		hpFrac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		if lastHealth and math.abs(hum.Health - lastHealth) > 0.5 then
			if hum.Health < lastHealth then
				Hud.Ping("Vitals", HC.DamageLinger)
				-- the chip holds, then drains toward the new value
				task.delay(0.35, function()
					if hpChip then
						H.Tween(hpChip, 0.45, { Size = UDim2.fromScale(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 1) })
					end
				end)
			else
				Hud.Ping("Vitals", 2)
				hpChip.Size = UDim2.fromScale(hpFrac, 1)
			end
		end
		lastHealth = hum.Health
		hpFill.Size = UDim2.fromScale(hpFrac, 1)
		hpText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
		if hpFrac < HC.LowHealth and hum.Health > 0 then
			Hud.Ping("Vitals", 0.5)
		end
	end
	local maxSt = Config.Balance.MaxStamina
	local st = player:GetAttribute("Stamina") or maxSt
	if lastStamina and st < lastStamina - 0.5 then
		Hud.Ping("Vitals", HC.StaminaLinger)
	elseif st < maxSt - 0.5 then
		Hud.Ping("Vitals", 0.6)
	end
	lastStamina = st
	stFill.Size = UDim2.fromScale(math.clamp(st / maxSt, 0, 1), 1)

	-- low-health vignette (soft red edges that pulse)
	local low = hum and hum.Health > 0 and hpFrac < HC.LowHealth
	local vt = 1
	if low then
		vt = 0.35 + 0.2 * math.sin(t * 5) + hpFrac
	end
	for _, v in ipairs(vignette) do
		v.BackgroundTransparency = vt
	end

	-- boost / overdrive tags
	local tags = {}
	if d then
		local now = workspace:GetServerTimeNow()
		local boostLeft = (d.BoostEnds or 0) - now
		if boostLeft > 0 then
			table.insert(tags, '<font color="#ff8a6a">2x DAMAGE ' .. Format.Time(boostLeft) .. "</font>")
		end
		local odLeft = (d.OverdriveEnd or 0) - now
		if odLeft > 0 then
			table.insert(tags, '<font color="#ffb45a">OVERDRIVE ' .. Format.Time(odLeft) .. "</font>")
		end
		if (d.ZenkaiEnd or 0) > now then
			table.insert(tags, '<font color="#ffe15a">ZENKAI</font>')
		end
	end
	tagText.Text = table.concat(tags, "   ")

	-- play-time ladder ----------------------------------------------------
	local session = player:GetAttribute("SessionTime") or 0
	local reward, prevMinutes, index = nextReward(session)
	if reward then
		local remaining = reward.Minutes * 60 - session
		ptTitle.Text = "Next: " .. reward.Name
		ptTimer.Text = Format.Time(remaining)
		ptFill.Size = UDim2.fromScale(math.clamp((session - prevMinutes * 60) / ((reward.Minutes - prevMinutes) * 60), 0, 1), 1)
		if remaining <= HC.PlaytimeHeadsUp then
			Hud.Ping("Playtime", 1)
		end
	else
		ptTitle.Text = "All play-time rewards claimed"
		ptTimer.Text = Format.Time(session)
		ptFill.Size = UDim2.fromScale(1, 1)
	end
	if index ~= lastRewardIndex then
		if lastRewardIndex ~= 0 then
			Hud.Ping("Playtime", 6)
		end
		lastRewardIndex = index
	end

	-- fade every group toward its target ----------------------------------
	for _, g in pairs(groups) do
		local target = (peek or t < g.Until) and 1 or 0
		local speed = target > g.Alpha and 9 or 3.5
		g.Alpha += (target - g.Alpha) * math.min(1, dt * speed)
		if math.abs(target - g.Alpha) < 0.01 then
			g.Alpha = target
		end
		g.Frame.GroupTransparency = 1 - g.Alpha
		g.Frame.Visible = g.Alpha > 0.01
	end
end

local function buildSlot(parent, def, order: number)
	local f = H.Frame(parent, { Color = Color3.fromRGB(10, 8, 22), Transparency = 0.35, Size = UDim2.fromOffset(54, 54), Order = order, Corner = 12 })
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = 1
	stroke.Color = def.Color
	stroke.Transparency = 0.45
	stroke.Parent = f
	local accent = H.Frame(f, { Color = def.Color, Size = UDim2.new(0.5, 0, 0, 2), Position = UDim2.new(0.25, 0, 1, -4), Corner = 1 })
	accent.Name = "Accent"
	local key = text(f, { Text = "", Size = UDim2.fromOffset(26, 13), Position = UDim2.fromOffset(5, 4), XAlign = Enum.TextXAlignment.Left, Color = def.Color })
	local name = text(f, { Text = def.Name, Font = FONT_LIGHT, Size = UDim2.new(1, -8, 0, 12), Position = UDim2.new(0, 4, 1, -20), Transparency = 0.1 })
	local shade = H.Frame(f, { Color = Color3.new(0, 0, 0), Transparency = 0.45, Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), Corner = 12, ZIndex = 3 })
	local timer = text(f, { Text = "", Size = UDim2.fromScale(1, 0.42), Position = UDim2.fromScale(0, 0.24), ZIndex = 4 })
	timer.Visible = false
	local badge = text(f, { Text = "", Font = FONT_LIGHT, Size = UDim2.fromOffset(22, 12), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), XAlign = Enum.TextXAlignment.Right, Color = def.Color })
	badge.Visible = def.Slot == "C"
	-- tap / click the slot to use it
	local btn = Instance.new("TextButton")
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Size = UDim2.fromScale(1, 1)
	btn.ZIndex = 5
	btn.Parent = f
	btn.Activated:Connect(function()
		Abilities.Press(def.Slot)
	end)
	table.insert(slots, { Def = def, Frame = f, Key = key, Name = name, Shade = shade, Timer = timer, Badge = badge })
end

local function edge(root: Instance, size: UDim2, pos: UDim2, anchor: Vector2, rotation: number)
	local f = Instance.new("Frame")
	f.Name = "Vignette"
	f.BackgroundColor3 = Color3.fromRGB(200, 20, 40)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor
	f.ZIndex = 0
	f.Active = false
	f.Parent = root
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	g.Parent = f
	table.insert(vignette, f)
end

function Hud.Init(ui, abilities)
	UI, Abilities = ui, abilities
	H = UI.Helpers
	local root = UI.Root()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)

	-- low-health vignette (4 soft edges)
	local fx = UI.FlyGui()
	edge(fx, UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0), Vector2.zero, 90)
	edge(fx, UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270)
	edge(fx, UDim2.fromScale(0.16, 1), UDim2.fromScale(0, 0), Vector2.zero, 0)
	edge(fx, UDim2.fromScale(0.16, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180)

	-- hotbar (bottom centre, combat only)
	local hotbar = group("Hotbar", { Parent = root, Size = UDim2.fromOffset(5 * 54 + 4 * 8, 56), Position = UDim2.new(0.5, 0, 1, -18), AnchorPoint = Vector2.new(0.5, 1) })
	H.List(hotbar, 8, true)
	for i, def in ipairs(SLOTS) do
		buildSlot(hotbar, def, i)
	end

	-- vitals (slim bars above the hotbar)
	local vitals = group("Vitals", { Parent = root, Size = UDim2.fromOffset(320, 44), Position = UDim2.new(0.5, 0, 1, -82), AnchorPoint = Vector2.new(0.5, 1) })
	tagText = text(vitals, { Text = "", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 0) })
	tagText.RichText = true
	local hpBar = H.Frame(vitals, { Color = Color3.fromRGB(10, 8, 20), Transparency = 0.45, Size = UDim2.new(1, -70, 0, 7), Position = UDim2.fromOffset(0, 22), Corner = 4 })
	hpChip = H.Frame(hpBar, { Color = Color3.fromRGB(255, 240, 240), Transparency = 0.25, Size = UDim2.fromScale(1, 1), Corner = 4 })
	hpFill = H.Frame(hpBar, { Color = Color3.fromRGB(110, 235, 130), Size = UDim2.fromScale(1, 1), Corner = 4, ZIndex = 2 })
	UITheme.Gradient(hpFill, Color3.fromRGB(150, 255, 170), Color3.fromRGB(70, 200, 110), 0)
	hpText = text(vitals, { Text = "", Font = FONT_LIGHT, Size = UDim2.fromOffset(64, 12), Position = UDim2.new(1, 0, 0, 20), AnchorPoint = Vector2.new(1, 0), XAlign = Enum.TextXAlignment.Right, Transparency = 0.15 })
	stBar = H.Frame(vitals, { Color = Color3.fromRGB(10, 8, 20), Transparency = 0.55, Size = UDim2.new(1, -70, 0, 3), Position = UDim2.fromOffset(0, 34), Corner = 2 })
	stFill = H.Frame(stBar, { Color = Color3.fromRGB(110, 200, 255), Size = UDim2.fromScale(1, 1), Corner = 2 })

	-- play-time timer (bottom left, only near a reward)
	local pt = group("Playtime", { Parent = root, Size = UDim2.fromOffset(250, 50), Position = UDim2.new(0, 18, 1, -18), AnchorPoint = Vector2.new(0, 1) })
	ptTitle = text(pt, { Text = "", Font = FONT_LIGHT, Size = UDim2.new(1, -70, 0, 15), Position = UDim2.fromOffset(0, 6), XAlign = Enum.TextXAlignment.Left })
	ptTimer = text(pt, { Text = "", Size = UDim2.fromOffset(68, 17), Position = UDim2.new(1, 0, 0, 5), AnchorPoint = Vector2.new(1, 0), XAlign = Enum.TextXAlignment.Right, Color = UITheme.Colors.Gold })
	local ptBar = H.Frame(pt, { Color = Color3.fromRGB(10, 8, 20), Transparency = 0.5, Size = UDim2.new(1, 0, 0, 3), Position = UDim2.fromOffset(0, 28), Corner = 2 })
	ptFill = H.Frame(ptBar, { Color = UITheme.Colors.Gold, Size = UDim2.fromScale(0, 1), Corner = 2 })
	local open = Instance.new("TextButton")
	open.BackgroundTransparency = 1
	open.Text = ""
	open.Size = UDim2.fromScale(1, 1)
	open.Parent = pt
	open.Activated:Connect(function()
		UI.Toggle("Rewards")
	end)

	refreshKeys()
	UserInputService.LastInputTypeChanged:Connect(refreshKeys)
	player:GetAttributeChangedSignal("WeaponId"):Connect(Hud.RefreshSkillNames)
	Hud.RefreshSkillNames()
	-- introduce the play-time timer once so new players know it exists
	Hud.Ping("Playtime", 8)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Movement (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Movement
-- Sprint + footsteps.
--   * Hold Left Shift (or click the left stick, L3) to sprint: +40% speed
--     and a soft, smoothed FOV widening.
--   * Footsteps: Roblox's looping default run sound is muted and replaced
--     by one-shot steps timed to distance travelled, with a different
--     layered sound per floor material (grass, stone, wood, metal, soft).
--     Nearby players get footsteps too; bosses stomp.

local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local Movement = {}
Movement.Sprinting = false

local player = Players.LocalPlayer
local S = Config.Sprint
local wantSprint = false
local baseSpeed: number? = nil
local settingSpeed = false
local walkers = {} -- [Model] = { Dist, Last, Foot }
local floorRay = RaycastParams.new()
floorRay.FilterType = Enum.RaycastFilterType.Exclude

local STEP_FOR = {
	[Enum.Material.Grass] = "StepGrass",
	[Enum.Material.LeafyGrass] = "StepGrass",
	[Enum.Material.Ground] = "StepGrass",
	[Enum.Material.Mud] = "StepGrass",
	[Enum.Material.Sand] = "StepSoft",
	[Enum.Material.Snow] = "StepSoft",
	[Enum.Material.Fabric] = "StepSoft",
	[Enum.Material.Wood] = "StepWood",
	[Enum.Material.WoodPlanks] = "StepWood",
	[Enum.Material.Metal] = "StepMetal",
	[Enum.Material.DiamondPlate] = "StepMetal",
	[Enum.Material.CorrodedMetal] = "StepMetal",
	[Enum.Material.Foil] = "StepMetal",
	[Enum.Material.ForceField] = "StepMetal",
}

local function humanoid(): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function applySpeed()
	local hum = humanoid()
	if not hum then
		return
	end
	baseSpeed = baseSpeed or hum.WalkSpeed
	settingSpeed = true
	hum.WalkSpeed = Movement.Sprinting and baseSpeed * S.SpeedMult or baseSpeed
	settingSpeed = false
end

local function onSprint(_, state)
	if state == Enum.UserInputState.Begin then
		wantSprint = true
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		wantSprint = false
	end
	return Enum.ContextActionResult.Pass
end

-- Mute the default looping run sound on a character (we play real steps).
local function muteDefaultRun(char: Model)
	task.spawn(function()
		local root = char:WaitForChild("HumanoidRootPart", 10)
		local running = root and root:WaitForChild("Running", 10)
		if running and running:IsA("Sound") then
			running.Volume = 0
		end
	end)
end

local function onCharacter(char: Model)
	baseSpeed = nil
	Movement.Sprinting = false
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum then
		baseSpeed = hum.WalkSpeed
		-- the server can change WalkSpeed (races, Overdrive): respect it
		hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if not settingSpeed then
				-- a new base speed from the server; re-apply sprint on top of it
				baseSpeed = hum.WalkSpeed
				if Movement.Sprinting then
					task.defer(applySpeed)
				end
			end
		end)
	end
	muteDefaultRun(char)
end

local function stepFor(model: Model, hum: Humanoid?, root: BasePart, dt: number, heavy: boolean)
	local w = walkers[model]
	if not w then
		w = { Dist = 0, Last = root.Position, Foot = 1 }
		walkers[model] = w
	end
	local pos = root.Position
	local moved = Vector3.new(pos.X - w.Last.X, 0, pos.Z - w.Last.Z).Magnitude
	w.Last = pos
	local isLocal = model == player.Character
	-- FloorMaterial is only reliable for your own character
	local grounded = not isLocal or (hum ~= nil and hum.FloorMaterial ~= Enum.Material.Air)
	if not grounded or moved > 20 then
		w.Dist = 0
		return
	end
	w.Dist += moved
	local speed = moved / math.max(dt, 1 / 240)
	local stride = heavy and 7 or (speed > 20 and 6.2 or 4.8)
	if w.Dist >= stride then
		w.Dist = 0
		w.Foot = -w.Foot
		local mat = Enum.Material.Slate
		if isLocal and hum then
			mat = hum.FloorMaterial
		else
			floorRay.FilterDescendantsInstances = { model }
			local hit = workspace:Raycast(pos, Vector3.new(0, heavy and -14 or -6, 0), floorRay)
			if not hit then
				return -- airborne
			end
			mat = hit.Material
		end
		local cue = heavy and "StepHeavy" or (STEP_FOR[mat] or "StepStone")
		local foot = pos - Vector3.new(0, heavy and 5 or 2.6, 0) + root.CFrame.RightVector * 0.5 * w.Foot
		SFX.Play(cue, { At = foot, Volume = isLocal and 0.9 or 0.6, Pitch = (w.Foot > 0 and 1.03 or 0.97) * (speed > 20 and 1.05 or 1) })
		if heavy then
			local me = player.Character
			local myRoot = me and me:FindFirstChild("HumanoidRootPart")
			if myRoot and (myRoot.Position - pos).Magnitude < 45 then
				VFX.Rumble(0.12)
			end
		end
	end
end

function Movement.Step(dt: number)
	-- sprint state
	local hum = humanoid()
	if hum then
		local sprint = wantSprint and hum.MoveDirection.Magnitude > 0.1 and hum.Health > 0
		if sprint ~= Movement.Sprinting then
			Movement.Sprinting = sprint
			applySpeed()
		end
	end
	VFX.SetFovOffset("Sprint", Movement.Sprinting and S.FovBoost or 0)

	-- footsteps for you + nearby players
	local me = player.Character
	local myRoot = me and me:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if r and h and h.Health > 0 and (p == player or (myRoot and (r.Position - myRoot.Position).Magnitude < 60)) then
			stepFor(c, h, r, dt, false)
		end
	end
	-- boss stomps
	for _, m in ipairs(CollectionService:GetTagged("Enemy")) do
		if m:GetAttribute("Boss") and (m:GetAttribute("HP") or 0) > 0 then
			local r = m:FindFirstChild("HumanoidRootPart")
			if r and myRoot and (r.Position - myRoot.Position).Magnitude < 90 then
				stepFor(m, nil, r, dt, true)
			end
		end
	end
	for model in pairs(walkers) do
		if not model.Parent then
			walkers[model] = nil
		end
	end
end

function Movement.Init()
	ContextActionService:BindAction("AnimeSprint", onSprint, false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			p.CharacterAdded:Connect(muteDefaultRun)
			if p.Character then
				muteDefaultRun(p.Character)
			end
		end
	end
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(muteDefaultRun)
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ProcAnim</string>
            <string name="Source"><![CDATA[--!nonstrict
-- ProcAnim (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/ProcAnim
-- Procedural combat animation (no uploaded animation assets needed).
-- Every swing is a short keyframed pose sequence played on the R15 joints
-- (shoulders, elbows, waist, neck) on top of the normal Roblox animations:
--   * PreAnimation resets the joints we drive, the Animator writes its own
--     pose, then PreSimulation multiplies our offset on top - so walking
--     and running still blend underneath the attack.
--   * Shapes: horizontal slashes both ways, overhead chops, thrusts, jabs,
--     spins, aimed shots, casts and ultimate slams, picked per weapon type
--     and combo step (Katana: right-left-overhead, Spear: thrust-thrust-
--     spin, Gloves: jab-cross-hook...).
--   * Runs for your character and for other players (from their Attack /
--     Skill events) and for enemies (their strike / wind-up events), so
--     everyone sees the same motion.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameShared"):WaitForChild("Config"))

local ProcAnim = {}

-- joint key -> R15 Motor6D name
local JOINTS = {
	RS = "RightShoulder",
	LS = "LeftShoulder",
	RE = "RightElbow",
	LE = "LeftElbow",
	W = "Waist",
	N = "Neck",
}

-- Poses: joint -> { rx, ry, rz } in degrees, in the joint's own frame.
-- Shoulder: +rx raises the arm forward, +rz swings it out to the right.
-- Waist: +ry turns the chest left, -rx leans forward.
local SHAPES = {
	SlashR = {
		{ T = 0.3, P = { RS = { 95, -15, 80 }, RE = { 25, 0, 0 }, W = { 0, -32, 0 }, LS = { 25, 0, -25 }, N = { 0, 15, 0 } } },
		{ T = 0.55, P = { RS = { 88, 25, -38 }, RE = { 4, 0, 0 }, W = { -6, 38, 0 }, LS = { 15, 0, -10 }, N = { 0, -12, 0 } } },
		{ T = 0.8, P = { RS = { 62, 20, -46 }, RE = { 10, 0, 0 }, W = { -4, 28, 0 } } },
	},
	SlashL = {
		{ T = 0.3, P = { RS = { 82, 20, -42 }, RE = { 30, 0, 0 }, W = { 0, 30, 0 }, LS = { 20, 0, -30 }, N = { 0, -10, 0 } } },
		{ T = 0.55, P = { RS = { 96, -18, 78 }, RE = { 3, 0, 0 }, W = { -6, -36, 0 }, LS = { 10, 0, -20 }, N = { 0, 14, 0 } } },
		{ T = 0.8, P = { RS = { 70, -10, 70 }, RE = { 8, 0, 0 }, W = { -3, -24, 0 } } },
	},
	Overhead = {
		{ T = 0.35, P = { RS = { 172, 0, 12 }, LS = { 168, 0, -14 }, RE = { 35, 0, 0 }, LE = { 35, 0, 0 }, W = { 14, 0, 0 }, N = { 10, 0, 0 } } },
		{ T = 0.6, P = { RS = { 38, 0, -6 }, LS = { 36, 0, 8 }, RE = { 5, 0, 0 }, LE = { 5, 0, 0 }, W = { -24, 0, 0 }, N = { -12, 0, 0 } } },
		{ T = 0.85, P = { RS = { 30, 0, 0 }, LS = { 30, 0, 0 }, W = { -16, 0, 0 } } },
	},
	Thrust = {
		{ T = 0.3, P = { RS = { 55, 0, 14 }, RE = { 85, 0, 0 }, W = { 4, -28, 0 }, LS = { 50, 0, -18 }, LE = { 60, 0, 0 } } },
		{ T = 0.5, P = { RS = { 92, 0, 0 }, RE = { 0, 0, 0 }, W = { -12, 22, 0 }, LS = { 70, 0, -10 }, LE = { 20, 0, 0 } } },
		{ T = 0.8, P = { RS = { 80, 0, 0 }, RE = { 8, 0, 0 }, W = { -8, 14, 0 } } },
	},
	JabR = {
		{ T = 0.25, P = { RS = { 40, 0, 10 }, RE = { 115, 0, 0 }, W = { 0, -18, 0 }, LS = { 55, 0, -10 }, LE = { 110, 0, 0 } } },
		{ T = 0.45, P = { RS = { 92, 0, -8 }, RE = { 0, 0, 0 }, W = { -6, 26, 0 }, LS = { 50, 0, -10 }, LE = { 115, 0, 0 } } },
	},
	JabL = {
		{ T = 0.25, P = { LS = { 40, 0, -10 }, LE = { 115, 0, 0 }, W = { 0, 18, 0 }, RS = { 55, 0, 10 }, RE = { 110, 0, 0 } } },
		{ T = 0.45, P = { LS = { 92, 0, 8 }, LE = { 0, 0, 0 }, W = { -6, -26, 0 }, RS = { 50, 0, 10 }, RE = { 115, 0, 0 } } },
	},
	Spin = {
		{ T = 0.2, P = { RS = { 90, 0, 80 }, LS = { 30, 0, -40 }, W = { 0, -60, 0 } } },
		{ T = 0.7, P = { RS = { 90, 0, 80 }, LS = { 30, 0, -40 }, W = { 0, 300, 0 } } },
		{ T = 0.9, P = { RS = { 70, 0, 50 }, W = { 0, 360, 0 } } },
	},
	Aim = {
		{ T = 0.15, P = { RS = { 92, 0, 0 }, RE = { 0, 0, 0 }, LS = { 70, 0, 20 }, LE = { 30, 0, 0 }, W = { 0, -12, 0 }, N = { 0, 10, 0 } } },
		{ T = 0.35, P = { RS = { 104, 0, 0 }, RE = { 12, 0, 0 }, LS = { 70, 0, 20 }, LE = { 30, 0, 0 }, W = { 6, -12, 0 }, N = { 0, 10, 0 } } },
		{ T = 0.75, P = { RS = { 90, 0, 0 }, LS = { 60, 0, 15 }, W = { 0, -8, 0 } } },
	},
	Cast = {
		{ T = 0.35, P = { RS = { 60, 0, 30 }, LS = { 60, 0, -30 }, RE = { 70, 0, 0 }, LE = { 70, 0, 0 }, W = { 12, 0, 0 } } },
		{ T = 0.6, P = { RS = { 100, 0, 8 }, LS = { 100, 0, -8 }, RE = { 0, 0, 0 }, LE = { 0, 0, 0 }, W = { -16, 0, 0 } } },
		{ T = 0.85, P = { RS = { 92, 0, 6 }, LS = { 92, 0, -6 }, W = { -10, 0, 0 } } },
	},
	Ultimate = {
		{ T = 0.35, P = { RS = { 175, 0, 25 }, LS = { 175, 0, -25 }, W = { 22, 0, 0 }, N = { 20, 0, 0 } } },
		{ T = 0.55, P = { RS = { 180, 0, 20 }, LS = { 180, 0, -20 }, W = { 26, 0, 0 }, N = { 25, 0, 0 } } },
		{ T = 0.75, P = { RS = { 40, 0, 10 }, LS = { 40, 0, -10 }, W = { -30, 0, 0 }, N = { -15, 0, 0 } } },
	},
	Dash = {
		{ T = 0.3, P = { RS = { -45, 0, 20 }, LS = { -45, 0, -20 }, W = { -28, 0, 0 }, N = { 15, 0, 0 } } },
		{ T = 0.75, P = { RS = { -35, 0, 15 }, LS = { -35, 0, -15 }, W = { -20, 0, 0 } } },
	},
	-- enemies
	Windup = {
		{ T = 0.5, P = { RS = { 150, 0, 40 }, RE = { 60, 0, 0 }, W = { 18, -25, 0 }, LS = { 40, 0, -40 } } },
		{ T = 1, P = { RS = { 160, 0, 45 }, RE = { 70, 0, 0 }, W = { 20, -28, 0 }, LS = { 45, 0, -45 } } },
	},
}

-- combo shapes per weapon class
local COMBOS = {
	Katana = { "SlashR", "SlashL", "Overhead" },
	Greatsword = { "SlashR", "SlashL", "SlashR", "Overhead" },
	Scythe = { "SlashR", "SlashL", "Spin" },
	Glove = { "JabR", "JabL", "JabR" },
	Claws = { "SlashR", "SlashL", "JabR", "SlashL" },
	Daggers = { "SlashR", "SlashL", "SlashR", "SlashL" },
	Spear = { "Thrust", "Thrust", "Spin" },
	Hammer = { "Overhead", "SlashR", "Overhead" },
	Chain = { "SlashR", "Spin" },
	Fan = { "SlashL", "SlashR", "Spin" },
	Pistols = { "Aim" },
	FingerGun = { "Aim" },
	Bow = { "Aim" },
	Cannon = { "Aim" },
	Staff = { "Cast", "Aim" },
	Kunai = { "Aim", "JabR" },
}

local active: { [Model]: any } = {}

local function motors(model: Model)
	local out = {}
	for key, name in pairs(JOINTS) do
		local m = model:FindFirstChild(name, true)
		if m and m:IsA("Motor6D") then
			out[key] = m
		end
	end
	return out
end

local function ease(t: number): number
	return 1 - (1 - t) ^ 3
end

local ZERO = { 0, 0, 0 }
local function angles(pose, key)
	return (pose and pose[key]) or ZERO
end

-- wrap to (-180, 180] so a finished spin does not unwind backwards
local function wrap(a: number): number
	return ((a + 180) % 360) - 180
end
local function wrapped(p)
	return { wrap(p[1]), wrap(p[2]), wrap(p[3]) }
end

-- Plays a shape on a character / enemy model. speed scales the duration.
function ProcAnim.Play(model: Model?, shapeName: string, duration: number?, scale: number?)
	if not model or not model.Parent then
		return
	end
	local shape = SHAPES[shapeName]
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not shape or not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end
	local m = motors(model)
	if not m.RS then
		return
	end
	-- the previous clip's current pose is the starting point (smooth chains)
	local prev = active[model]
	local startPose = prev and prev.Current or {}
	active[model] = {
		Motors = m,
		Shape = shape,
		Start = os.clock(),
		Duration = duration or 0.45,
		Scale = scale or 1,
		From = startPose,
		Current = startPose,
	}
end

-- Weapon basic attack for a class + combo step (1-based).
function ProcAnim.Attack(model: Model?, class: string?, combo: number?)
	local list = COMBOS[class or ""] or COMBOS.Katana
	local shape = list[((combo or 1) - 1) % #list + 1]
	local cls = Config.WeaponClasses[class or ""]
	local interval = cls and cls.Interval or 0.45
	ProcAnim.Play(model, shape, math.clamp(interval * 1.15, 0.3, 0.75))
end

-- Enemy weapon look -> the class whose swings it borrows.
local ENEMY_CLASS = { Katana = "Katana", Kunai = "Daggers", Blades = "Daggers", Staff = "Staff", Scythe = "Scythe", Club = "Hammer", Fists = "Glove", Gun = "Pistols", Bow = "Bow", Fan = "Fan" }
function ProcAnim.EnemyStrike(model: Model?)
	if not model then
		return
	end
	local arch = Config.EnemyArchetypes[model:GetAttribute("Archetype") or ""]
	local class = ENEMY_CLASS[arch and arch.Weapon or "Fists"] or "Glove"
	ProcAnim.Attack(model, class, math.random(1, 3))
end

function ProcAnim.Skill(model: Model?, class: string?, slot: string?)
	if slot == "R" then
		ProcAnim.Play(model, "Ultimate", 0.8)
		return
	end
	local cls = Config.WeaponClasses[class or ""]
	if cls and cls.Kind == "Ranged" then
		ProcAnim.Play(model, "Cast", 0.55)
	else
		local list = COMBOS[class or ""] or COMBOS.Katana
		ProcAnim.Play(model, list[#list], 0.55)
	end
end

local function sample(clip, now: number)
	local u = (now - clip.Start) / clip.Duration
	if u >= 1 then
		return nil
	end
	local keys = clip.Shape
	-- find the segment
	local prevT, prevPose, first = 0, clip.From, true
	for _, k in ipairs(keys) do
		if u <= k.T then
			local a = ease((u - prevT) / math.max(1e-3, k.T - prevT))
			local out = {}
			for key in pairs(JOINTS) do
				local p0, p1 = angles(prevPose, key), angles(k.P, key)
				if first then
					p0 = wrapped(p0)
				end
				out[key] = { p0[1] + (p1[1] - p0[1]) * a, p0[2] + (p1[2] - p0[2]) * a, p0[3] + (p1[3] - p0[3]) * a }
			end
			return out
		end
		prevT, prevPose, first = k.T, k.P, false
	end
	-- tail: ease back to rest
	local a = ease((u - prevT) / math.max(1e-3, 1 - prevT))
	local out = {}
	for key in pairs(JOINTS) do
		local p0 = wrapped(angles(prevPose, key))
		out[key] = { p0[1] * (1 - a), p0[2] * (1 - a), p0[3] * (1 - a) }
	end
	return out
end

-- Flash the equipped weapon's swing trail (WeaponModels adds "SwingTrail").
function ProcAnim.TrailBurst(model: Model?, duration: number)
	if not model then
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Trail") and d.Name == "SwingTrail" then
			d.Enabled = true
			local token = (d:GetAttribute("Burst") or 0) + 1
			d:SetAttribute("Burst", token)
			task.delay(duration, function()
				if d.Parent and d:GetAttribute("Burst") == token then
					d.Enabled = false
				end
			end)
		end
	end
end

function ProcAnim.Init()
	-- 1) before the Animator: clear what we added last frame
	RunService.PreAnimation:Connect(function()
		for model, clip in pairs(active) do
			if not model.Parent then
				active[model] = nil
			else
				for _, motor in pairs(clip.Motors) do
					if motor.Parent then
						motor.Transform = CFrame.identity
					end
				end
			end
		end
	end)
	-- 2) after the Animator: layer our pose on top
	RunService.PreSimulation:Connect(function()
		local now = os.clock()
		for model, clip in pairs(active) do
			local pose = sample(clip, now)
			if not pose then
				active[model] = nil
			else
				clip.Current = pose
				local s = clip.Scale
				for key, motor in pairs(clip.Motors) do
					local a = pose[key]
					if a and motor.Parent then
						motor.Transform = motor.Transform * CFrame.Angles(math.rad(a[1] * s), math.rad(a[2] * s), math.rad(a[3] * s))
					end
				end
			end
		end
	end)
end

return ProcAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PromptUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- PromptUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/PromptUI
-- Custom ProximityPrompt UI (prompts use Style = Custom so Roblox draws
-- nothing). Each prompt gets a small AlwaysOnTop BillboardGui (key cap +
-- text on a soft glow, no background box) in a CanvasGroup that fades in on
-- PromptShown and out on PromptHidden. The key cap follows
-- the player's current input device (keyboard / controller / touch), touch
-- users can tap the cap, and Triggered fires a RemoteEvent to the server.

local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local SFX = require(Shared:WaitForChild("SFX"))

local PromptUI = {}

local player = Players.LocalPlayer
local shown = {} -- [prompt] = { Gui, Group, Key, Fill, Button }

local GAMEPAD_NAMES = {
	ButtonA = "A",
	ButtonB = "B",
	ButtonX = "X",
	ButtonY = "Y",
	ButtonL1 = "LB",
	ButtonR1 = "RB",
	ButtonL2 = "LT",
	ButtonR2 = "RT",
	DPadUp = "D-Up",
	DPadDown = "D-Down",
	DPadLeft = "D-Left",
	DPadRight = "D-Right",
}

local function deviceType(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	end
	if last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Touch"
	end
	return "Keyboard"
end
PromptUI.DeviceType = deviceType

local function keyText(prompt: ProximityPrompt, device: string): string
	if device == "Touch" then
		return "TAP"
	elseif device == "Gamepad" then
		return GAMEPAD_NAMES[prompt.GamepadKeyCode.Name] or prompt.GamepadKeyCode.Name
	end
	local k = prompt.KeyboardKeyCode
	local s = UserInputService:GetStringForKeyCode(k)
	return (s ~= nil and s ~= "") and s:upper() or k.Name
end

local function adorneeFor(prompt: ProximityPrompt): Instance?
	local parent = prompt.Parent
	if parent and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
		return parent
	end
	if parent and parent:IsA("Model") then
		return parent.PrimaryPart
	end
	return nil
end

-- Text with a light drop shadow (no heavy outline, no background box).
local function softText(parent: Instance, text: string, font: Enum.Font, color: Color3, pos: UDim2, size: UDim2, transparency: number)
	local shadow = Instance.new("TextLabel")
	shadow.BackgroundTransparency = 1
	shadow.Position = pos + UDim2.fromOffset(0, 1.5)
	shadow.Size = size
	shadow.Font = font
	shadow.TextScaled = true
	shadow.TextXAlignment = Enum.TextXAlignment.Left
	shadow.Text = text
	shadow.TextColor3 = Color3.fromRGB(6, 4, 14)
	shadow.TextTransparency = 0.5
	shadow.Parent = parent
	local t = shadow:Clone()
	t.Position = pos
	t.TextColor3 = color
	t.TextTransparency = transparency
	t.Parent = parent
	return t
end

-- Minimal prompt: a small key cap + action text on a soft glow. About 45%
-- smaller than the old boxed panel.
local function build(prompt: ProximityPrompt)
	local bb = Instance.new("BillboardGui")
	bb.Name = "CustomPrompt"
	bb.AlwaysOnTop = true
	bb.Active = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(190, 40)
	bb.StudsOffset = Vector3.new(0, 2, 0)
	bb.Adornee = adorneeFor(prompt)
	bb.ResetOnSpawn = false
	bb.Parent = player:WaitForChild("PlayerGui")

	local group = Instance.new("CanvasGroup")
	group.Size = UDim2.fromScale(1, 1)
	group.BackgroundTransparency = 1
	group.GroupTransparency = 1
	group.Parent = bb
	local scale = Instance.new("UIScale")
	scale.Scale = 0.85
	scale.Parent = group

	-- soft glow streak behind the text
	local glow = Instance.new("Frame")
	glow.AnchorPoint = Vector2.new(0, 0.5)
	glow.Position = UDim2.new(0, 10, 0.5, 0)
	glow.Size = UDim2.new(1, -10, 0.9, 0)
	glow.BackgroundColor3 = Color3.fromRGB(150, 120, 255)
	glow.BorderSizePixel = 0
	glow.Parent = group
	UITheme.Corner(glow, 20)
	local gg = Instance.new("UIGradient")
	gg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.6, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	gg.Parent = glow

	local key = Instance.new("TextButton")
	key.Name = "Key"
	key.AutoButtonColor = false
	key.AnchorPoint = Vector2.new(0, 0.5)
	key.Size = UDim2.fromOffset(28, 28)
	key.Position = UDim2.new(0, 2, 0.5, 0)
	key.BackgroundColor3 = Color3.fromRGB(245, 242, 255)
	key.BackgroundTransparency = 0.1
	key.Font = Config.Fonts.Display
	key.TextScaled = true
	key.TextColor3 = Color3.fromRGB(24, 18, 40)
	key.Text = ""
	key.Parent = group
	UITheme.Corner(key, 7)
	local ks = Instance.new("UIStroke")
	ks.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ks.Thickness = 1
	ks.Color = Color3.new(1, 1, 1)
	ks.Transparency = 0.3
	ks.Parent = key
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 5)
	pad.PaddingBottom = UDim.new(0, 5)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 4)
	pad.Parent = key

	-- thin hold-progress line under the key cap
	local fill = Instance.new("Frame")
	fill.Name = "Hold"
	fill.AnchorPoint = Vector2.new(0, 0)
	fill.Position = UDim2.new(0, 2, 0.5, 16)
	fill.Size = UDim2.fromOffset(0, 2)
	fill.BackgroundColor3 = Color3.fromRGB(255, 215, 110)
	fill.BorderSizePixel = 0
	fill.Parent = group

	softText(group, prompt.ActionText, Config.Fonts.Heading, Color3.new(1, 1, 1), UDim2.fromOffset(38, 3), UDim2.new(1, -40, 0, 20), 0)
	softText(group, prompt.ObjectText, Config.Fonts.Body, Color3.fromRGB(215, 208, 240), UDim2.fromOffset(38, 23), UDim2.new(1, -40, 0, 13), 0.2)

	-- touch: tap the key cap to trigger
	key.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	key.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)

	local entry = { Gui = bb, Group = group, Scale = scale, Key = key, Fill = fill }
	return entry
end

local function refreshKey(prompt: ProximityPrompt, entry)
	local device = deviceType()
	entry.Key.Text = keyText(prompt, device)
end

local function show(prompt: ProximityPrompt)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		return
	end
	local entry = shown[prompt]
	if entry and entry.Hiding then
		entry.Gui:Destroy()
		entry = nil
	end
	if not entry then
		entry = build(prompt)
		shown[prompt] = entry
	end
	refreshKey(prompt, entry)
	TweenService:Create(entry.Group, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { GroupTransparency = 0 }):Play()
	TweenService:Create(entry.Scale, TweenInfo.new(0.3, Enum.EasingStyle.Quart), { Scale = 1 }):Play()
	SFX.Play("PromptShow")
end

local function hide(prompt: ProximityPrompt)
	local entry = shown[prompt]
	if not entry then
		return
	end
	entry.Hiding = true
	local tw = TweenService:Create(entry.Group, TweenInfo.new(0.18), { GroupTransparency = 1 })
	TweenService:Create(entry.Scale, TweenInfo.new(0.18), { Scale = 0.85 }):Play()
	tw:Play()
	tw.Completed:Once(function()
		if shown[prompt] == entry and entry.Hiding then
			shown[prompt] = nil
			entry.Gui:Destroy()
		end
	end)
end

function PromptUI.Init(interactRemote: RemoteEvent)
	ProximityPromptService.PromptShown:Connect(function(prompt)
		show(prompt)
	end)
	ProximityPromptService.PromptHidden:Connect(hide)

	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		local entry = shown[prompt]
		if entry and prompt.HoldDuration > 0 then
			entry.Fill.Size = UDim2.fromOffset(0, 2)
			TweenService:Create(entry.Fill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.fromOffset(28, 2) }):Play()
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		local entry = shown[prompt]
		if entry then
			TweenService:Create(entry.Fill, TweenInfo.new(0.15), { Size = UDim2.fromOffset(0, 2) }):Play()
		end
	end)

	-- Triggered -> server-authoritative interaction
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom or prompt:GetAttribute("Action") == nil then
			return
		end
		SFX.Play("PromptTrigger")
		local entry = shown[prompt]
		if entry then
			entry.Scale.Scale = 0.9
			TweenService:Create(entry.Scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		interactRemote:FireServer(prompt)
	end)

	-- keep key caps in sync with the device the player is using
	UserInputService.LastInputTypeChanged:Connect(function()
		for prompt, entry in pairs(shown) do
			refreshKey(prompt, entry)
		end
	end)
end

return PromptUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- UI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/UI
-- HUD, menus, race roll, notifications. Styled through UITheme (UIPackPlus).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local SFX = require(Shared:WaitForChild("SFX"))
local VFX = require(Shared:WaitForChild("VFX"))

local player = Players.LocalPlayer
local C = UITheme.Colors

local UI = {}
UI.Data = nil
UI.ApplySettings = nil :: ((any) -> ())?
UI.ToggleMap = nil :: (() -> ())?
local request: (string, any?) -> () = function() end

local screen: ScreenGui
local root: Frame
local uiScale: UIScale
local flyGui: ScreenGui
local pills: { [string]: any } = {}
local panels = {}
local current = nil
local dim: Frame
local toastHolder: Frame
local padLabel: TextLabel
local zoneBanner: Frame
local towerHud: Frame
local stageHud: Frame
local eventRow: Frame
local menuHint: TextLabel
local adminButton: GuiObject
local DRAWER_X = 204
local drawer: CanvasGroup
local drawerOpen = false
local numberValues = {}
local prevValues = {}

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.Color or C.Bg
	f.BackgroundTransparency = props.Transparency or 0
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.fromScale(1, 1)
	f.Position = props.Position or UDim2.new()
	f.AnchorPoint = props.AnchorPoint or Vector2.zero
	f.LayoutOrder = props.Order or 0
	f.ZIndex = props.ZIndex or 1
	f.Name = props.Name or "Frame"
	f.Parent = parent
	if props.Corner then
		UITheme.Corner(f, props.Corner)
	end
	if props.Stroke then
		UITheme.Stroke(f, props.Stroke, nil, true)
	end
	return f
end

local function list(parent, padding, horizontal, align)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 8)
	l.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = align or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

local function scroller(parent, props)
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = props.Size or UDim2.fromScale(1, 1)
	s.Position = props.Position or UDim2.new()
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = Color3.fromRGB(200, 180, 255)
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = s
	return s
end

local function clearList(container: Instance)
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function hex(c: Color3): string
	return "#" .. c:ToHex()
end

-- Count-up animation for HUD numbers.
local function animateNumber(key: string, label: TextLabel, target: number, fmt: (number) -> string)
	local nv = numberValues[key]
	if not nv then
		nv = Instance.new("NumberValue")
		nv.Value = target
		numberValues[key] = nv
		nv.Changed:Connect(function(v)
			label.Text = fmt(v)
		end)
		label.Text = fmt(target)
		return
	end
	if math.abs(nv.Value - target) < 0.5 then
		nv.Value = target
		label.Text = fmt(target)
		return
	end
	tween(nv, 0.45, { Value = target }, Enum.EasingStyle.Quart)
end

---------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------
-- Minimal text with a light drop shadow (used across the clean-screen HUD).
local function softLabel(parent: Instance, props)
	local t = Instance.new("TextLabel")
	t.Name = props.Name or "Label"
	t.BackgroundTransparency = 1
	t.Font = props.Font or Config.Fonts.Heading
	t.TextScaled = true
	t.Text = props.Text or ""
	t.TextColor3 = props.Color or C.Text
	t.TextTransparency = props.Transparency or 0
	t.Size = props.Size or UDim2.fromScale(1, 1)
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	t.RichText = props.Rich == true
	t.ZIndex = props.ZIndex or 1
	t.LayoutOrder = props.Order or 0
	t.Parent = parent
	local st = Instance.new("UIStroke")
	st.Thickness = props.StrokeThickness or 1
	st.Color = Color3.fromRGB(6, 4, 14)
	st.Transparency = 0.5
	st.Parent = t
	if props.MaxText then
		local cons = Instance.new("UITextSizeConstraint")
		cons.MaxTextSize = props.MaxText
		cons.Parent = t
	end
	return t
end

-- Compact currency pills (left). Pinned pills are always shown; a small
-- badge on the right flags "REBIRTH!" / "FULL". Clicking opens the menu.
local function makePill(parent, key: string, role: string, color: Color3, order: number, pinned: boolean?, panelName: string?)
	local holder = Instance.new("CanvasGroup")
	holder.Name = key
	holder.BackgroundTransparency = 1
	holder.GroupTransparency = pinned and 0 or 1
	holder.Visible = pinned == true
	holder.Size = UDim2.fromOffset(138, 30)
	holder.LayoutOrder = order
	holder.Parent = parent
	local f = frame(holder, { Color = Color3.fromRGB(10, 8, 18), Transparency = 0.3, Corner = 15 })
	f.Name = "Pill"
	local st = Instance.new("UIStroke")
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Thickness = 1.2
	st.Color = color
	st.Transparency = 0.5
	st.Parent = f
	UITheme.Icon(f, role, UDim2.fromOffset(20, 20), UDim2.fromOffset(6, 5))
	local value = softLabel(f, { Name = "Value", Text = "0", Font = Config.Fonts.Display, Size = UDim2.new(1, -38, 0, 20), Position = UDim2.fromOffset(31, 5), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
	local sub = softLabel(f, { Name = "Sub", Text = "", Font = Config.Fonts.Display, Size = UDim2.fromOffset(52, 12), Position = UDim2.new(1, -6, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), XAlign = Enum.TextXAlignment.Right, Color = C.Gold, MaxText = 11 })
	sub.Visible = false
	local sc = Instance.new("UIScale")
	sc.Parent = f
	if panelName then
		local click = Instance.new("TextButton")
		click.Name = "Click"
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.ZIndex = 5
		click.Parent = holder
		click.Activated:Connect(function()
			SFX.Play("UIClick")
			UI.Toggle(panelName)
		end)
	end
	pills[key] = { Holder = holder, Frame = f, Value = value, Sub = sub, Scale = sc, Color = color, Until = 0, Alpha = pinned and 1 or 0, Pinned = pinned == true }
end

-- Show a resource pill for a few seconds.
function UI.Reveal(key: string, seconds: number?)
	local p = pills[key]
	if p then
		p.Until = math.max(p.Until, os.clock() + (seconds or Config.Hud.ResourceLinger))
		if not p.Holder.Visible then
			p.Holder.Visible = true
		end
	end
end

function UI.Bump(key: string)
	local p = pills[key]
	if not p then
		return
	end
	UI.Reveal(key)
	p.Scale.Scale = 1.12
	tween(p.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UI.PillScreenPos(key: string): Vector2?
	local p = pills[key]
	if not p then
		return nil
	end
	return p.Holder.AbsolutePosition + Vector2.new(21, p.Holder.AbsoluteSize.Y / 2)
end

-- Little icons that fly from a world position into a HUD pill. The pill is
-- revealed first; the target is read after the burst so the layout has
-- already placed the (previously hidden) pill.
function UI.FlyToHud(key: string, worldPos: Vector3?, color: Color3, count)
	local cam = workspace.CurrentCamera
	if not pills[key] or not cam then
		return
	end
	UI.Reveal(key, Config.Hud.ResourceLinger + 1)
	local start
	if worldPos then
		local v, onScreen = cam:WorldToViewportPoint(worldPos)
		if not onScreen then
			return
		end
		start = Vector2.new(v.X, v.Y)
	else
		start = cam.ViewportSize / 2
	end
	count = math.clamp(count or 5, 1, 10)
	for i = 1, count do
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Size = UDim2.fromOffset(12, 12)
		dot.BackgroundColor3 = color
		dot.BorderSizePixel = 0
		dot.Rotation = 45
		dot.Position = UDim2.fromOffset(start.X, start.Y)
		dot.ZIndex = 40
		dot.Parent = flyGui
		local glow = Instance.new("UIStroke")
		glow.Thickness = 1.5
		glow.Color = Color3.new(1, 1, 1)
		glow.Transparency = 0.3
		glow.Parent = dot
		local burst = start + Vector2.new(math.random(-60, 60), math.random(-60, 25))
		local delay = (i - 1) * 0.035
		task.delay(delay, function()
			tween(dot, 0.22, { Position = UDim2.fromOffset(burst.X, burst.Y), Rotation = 225 }, Enum.EasingStyle.Quad)
			task.delay(0.24, function()
				local target = UI.PillScreenPos(key) or burst
				tween(dot, 0.35, { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(6, 6) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.35, function()
					dot:Destroy()
					UI.Bump(key)
				end)
			end)
		end)
	end
end

---------------------------------------------------------------------
-- NOTIFICATIONS
---------------------------------------------------------------------
function UI.Notify(text: string, colorArg: Color3?)
	local color: Color3 = colorArg or Color3.fromRGB(255, 255, 255)
	local holder = frame(toastHolder, { Transparency = 1, Size = UDim2.fromOffset(240, 22) })
	local toast = frame(holder, { Color = Color3.fromRGB(8, 6, 18), Transparency = 0.45, Size = UDim2.fromScale(1, 1), Corner = 6 })
	toast.Position = UDim2.fromOffset(260, 0)
	local bar = frame(toast, { Color = color, Size = UDim2.new(0, 2, 1, -8), Position = UDim2.fromOffset(5, 4), Corner = 1 })
	bar.Name = "Bar"
	softLabel(toast, { Text = text, Size = UDim2.new(1, -18, 1, -6), Position = UDim2.fromOffset(12, 3), XAlign = Enum.TextXAlignment.Left, Color = color:Lerp(Color3.new(1, 1, 1), 0.35), MaxText = 12 })
	tween(toast, 0.3, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quart)
	local kids = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 4 then
		kids[1]:Destroy()
	end
	task.delay(3, function()
		if toast.Parent then
			tween(toast, 0.3, { Position = UDim2.fromOffset(260, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(holder, 0.4)
		end
	end)
end

---------------------------------------------------------------------
-- PANEL FRAMEWORK
---------------------------------------------------------------------
local function makePanel(name: string, title: string, size: Vector2, accent: Color3)
	local panelFrame, content = UITheme.Panel(root, { Name = name, Size = UDim2.fromOffset(size.X, size.Y), ZIndex = 5, Accent = accent })
	panelFrame.Visible = false
	local sc = Instance.new("UIScale")
	sc.Parent = panelFrame

	-- consistent header: a slanted accent tab riding the top-left edge, a thin
	-- accent rule across the top, and a square close button
	local tabWidth = math.clamp(#title * 19 + 56, 150, size.X - 90)
	local header = frame(panelFrame, { Color = accent, Size = UDim2.fromOffset(tabWidth, 46), Position = UDim2.fromOffset(20, -20), Corner = 8, Stroke = 2 })
	header.Name = "Header"
	header.Rotation = -2
	UITheme.Gradient(header, Color3.new(1, 1, 1), Color3.fromRGB(165, 165, 165), 90)
	local notch = frame(header, { Color = Color3.fromRGB(10, 8, 18), Transparency = 0.2, Size = UDim2.fromOffset(6, 26), Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Corner = 2 })
	notch.Name = "Notch"
	UITheme.Label(header, { Text = title, Title = true, Size = UDim2.new(1, -40, 1, -8), Position = UDim2.fromOffset(28, 4), XAlign = Enum.TextXAlignment.Left, MaxText = 32, StrokeThickness = 2.5 })
	local rule = frame(panelFrame, { Color = accent, Transparency = 0.25, Size = UDim2.new(1, -tabWidth - 60, 0, 2), Position = UDim2.fromOffset(tabWidth + 30, 12) })
	rule.Name = "Rule"

	UITheme.Button(panelFrame, {
		Name = "Close",
		Text = "X",
		Color = "Red",
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.new(1, 8, 0, -12),
		AnchorPoint = Vector2.new(1, 0),
		MaxText = 26,
		Corner = 8,
		Sound = "UIClose",
		OnClick = function()
			UI.Close()
		end,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(0, 40)
	body.Size = UDim2.new(1, 0, 1, -40)
	body.Parent = content

	local panel = { Frame = panelFrame, Body = body, Scale = sc, Mode = nil, Sig = nil, Refresh = nil, Accent = accent }
	panels[name] = panel
	return panel
end

-- Depth of field blur behind menus / shop / dialogue.
local dof: DepthOfFieldEffect? = nil
function UI.SetMenuFocus(on: boolean)
	local cfg = Config.Graphics.MenuDepthOfField
	if not dof then
		local d = Instance.new("DepthOfFieldEffect")
		d.Name = "MenuFocus"
		d.FarIntensity = 0
		d.NearIntensity = 0
		d.FocusDistance = cfg.FocusDistance
		d.InFocusRadius = cfg.InFocusRadius
		d.Parent = game:GetService("Lighting")
		dof = d
	end
	tween(dof, 0.3, { FarIntensity = on and cfg.FarIntensity or 0, NearIntensity = on and cfg.NearIntensity or 0 })
end

function UI.Open(name: string, mode: string?)
	local panel = panels[name]
	if not panel then
		return
	end
	if current and current ~= panel then
		current.Frame.Visible = false
	end
	panel.Mode = mode
	panel.Sig = nil
	current = panel
	panel.Frame.Visible = true
	panel.Scale.Scale = 0.6
	tween(panel.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	dim.Visible = true
	tween(dim, 0.25, { BackgroundTransparency = 0.55 })
	UI.SetMenuFocus(true)
	if panel.Refresh and UI.Data then
		panel.Refresh(UI.Data)
	end
end

function UI.Toggle(name: string, mode: string?)
	if current == panels[name] and current and current.Frame.Visible then
		UI.Close()
	else
		UI.Open(name, mode)
	end
end

function UI.Close()
	local panel = current
	current = nil
	if panel then
		local tw = tween(panel.Scale, 0.15, { Scale = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tw.Completed:Once(function()
			if current ~= panel then
				panel.Frame.Visible = false
			end
		end)
	end
	UI.SetMenuFocus(false)
	tween(dim, 0.2, { BackgroundTransparency = 1 }).Completed:Once(function()
		if not current then
			dim.Visible = false
		end
	end)
end

local function rowFrame(parent, height: number, order: number, color: Color3?)
	local f = frame(parent, { Color = color or C.Row, Size = UDim2.new(1, 0, 0, height), Order = order, Corner = 10 })
	local st = UITheme.Stroke(f, 1, C.Line, true)
	st.Transparency = 0.35
	UITheme.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(200, 196, 215), 90)
	return f
end

-- Thin coloured bar on the left edge of a row (rarity / accent marker).
local function accentBar(row: GuiObject, color: Color3)
	local b = frame(row, { Color = color, Size = UDim2.new(0, 4, 1, -14), Position = UDim2.fromOffset(6, 7), Corner = 2 })
	b.Name = "Accent"
	return b
end

---------------------------------------------------------------------
-- PANELS
---------------------------------------------------------------------
local function buildUpgrades()
	local p = makePanel("Upgrades", "UPGRADES", Vector2.new(660, 450), C.Blue)
	UITheme.Label(p.Body, { Text = "Levels never cap. Prices climb linearly to level " .. Config.UpgradeLinearUntil .. ", then grow exponentially.", Size = UDim2.new(1, 0, 0, 22), Color = C.Sub, MaxText = 15 })
	local holder = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	list(holder, 10)
	local rows = {}
	local icons = { Backpack = "Icon_Backpack", Luck = "Icon_Gem", Training = "Icon_Power" }
	local colors = { Backpack = C.Gold, Luck = C.Green, Training = C.Red }
	for i, key in ipairs(Config.UpgradeOrder) do
		local cfg = Config.Upgrades[key]
		local r = rowFrame(holder, 108, i)
		accentBar(r, colors[key])
		UITheme.Icon(r, icons[key], UDim2.fromOffset(60, 60), UDim2.fromOffset(20, 24))
		UITheme.Label(r, { Text = cfg.Name, Title = true, Size = UDim2.new(0.45, 0, 0, 32), Position = UDim2.fromOffset(94, 8), XAlign = Enum.TextXAlignment.Left, MaxText = 28 })
		local lvl = UITheme.Label(r, { Text = "", Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromOffset(94, 42), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 17, Rich = true })
		local val = UITheme.Label(r, { Text = "", Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromOffset(94, 70), XAlign = Enum.TextXAlignment.Left, Color = C.Green, MaxText = 17, Rich = true })
		local btn = UITheme.Button(r, {
			Text = "Buy",
			Color = "Gold",
			Size = UDim2.fromOffset(180, 62),
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Sound = "Purchase",
			OnClick = function()
				request("Upgrade", key)
			end,
		})
		rows[key] = { Level = lvl, Value = val, Button = btn }
	end
	p.Refresh = function(d)
		for key, r in pairs(rows) do
			local u = Config.Upgrades[key]
			local lvl = d.Upgrades[key] or 0
			local cost = d.UpgradeCosts[key]
			local expo = lvl >= Config.UpgradeLinearUntil
			r.Level.Text = "Level <b>" .. Format.Commas(lvl) .. "</b>  " .. (expo and '<font color="#ff64b9">EXPONENTIAL</font>' or ("linear until " .. Config.UpgradeLinearUntil))
			if key == "Backpack" then
				r.Value.Text = string.format("Ore bag: <b>%s</b> -> %s", Format.Abbrev(d.BackpackMax), Format.Abbrev(d.BackpackMax + u.Per))
			else
				local now = math.floor(lvl * u.Per * 100 + 0.5)
				local nxt = math.floor((lvl + 1) * u.Per * 100 + 0.5)
				r.Value.Text = string.format("%s: <b>+%s%%</b> -> +%s%%", key == "Luck" and "Luck" or "Power gain", Format.Abbrev(now), Format.Abbrev(nxt))
			end
			UITheme.SetButtonText(r.Button, cost and cost >= 0 and (Format.Abbrev(cost) .. " Coins") or "...")
		end
	end
end

local function buildRace()
	local p = makePanel("Race", "RACE", Vector2.new(680, 470), C.Purple)
	local top = rowFrame(p.Body, 150, 0, Color3.fromRGB(40, 30, 70))
	local raceName = UITheme.Label(top, { Text = "???", Title = true, Size = UDim2.new(0.62, 0, 0, 52), Position = UDim2.fromOffset(18, 10), XAlign = Enum.TextXAlignment.Left, MaxText = 44, StrokeThickness = 3 })
	local tierName = UITheme.Label(top, { Text = "", Size = UDim2.new(0.62, 0, 0, 26), Position = UDim2.fromOffset(18, 62), XAlign = Enum.TextXAlignment.Left, MaxText = 22 })
	local desc = UITheme.Label(top, { Text = "", Size = UDim2.new(0.62, 0, 0, 52), Position = UDim2.fromOffset(18, 90), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 18 })
	desc.TextWrapped = true
	local rerolls = UITheme.Label(top, { Text = "", Size = UDim2.fromOffset(200, 26), Position = UDim2.new(1, -18, 0, 16), AnchorPoint = Vector2.new(1, 0), Color = C.Gold, MaxText = 22 })
	UITheme.Button(top, {
		Text = "ROLL RACE",
		Color = "Purple",
		Size = UDim2.fromOffset(200, 70),
		Position = UDim2.new(1, -18, 1, -14),
		AnchorPoint = Vector2.new(1, 1),
		MaxText = 26,
		OnClick = function()
			request("Reroll")
		end,
	})
	local odds = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -160), Position = UDim2.fromOffset(0, 160) })
	list(odds, 6)
	for i, race in ipairs(Config.Races) do
		local r = rowFrame(odds, 44, i)
		local sw = frame(r, { Color = race.Color, Size = UDim2.fromOffset(10, 30), Position = UDim2.fromOffset(10, 7), Corner = 4 })
		sw.Name = "Swatch"
		UITheme.Label(r, { Text = race.Name, Title = true, Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(28, 7), XAlign = Enum.TextXAlignment.Left, Color = race.Color, MaxText = 22 })
		UITheme.Label(r, { Text = Format.Percent(race.Weight), Size = UDim2.fromOffset(70, 30), Position = UDim2.fromOffset(196, 7), Color = C.Gold, MaxText = 20 })
		local d = UITheme.Label(r, { Text = race.Desc, Size = UDim2.new(1, -290, 1, -8), Position = UDim2.fromOffset(276, 4), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 14, StrokeThickness = 1 })
		d.TextWrapped = true
	end
	local tierRow = rowFrame(odds, 40, 99, Color3.fromRGB(30, 26, 44))
	local parts = {}
	for _, t in ipairs(Config.RaceTiers) do
		table.insert(parts, string.format('<font color="%s">%s %s</font>', hex(t.Color), t.Label or t.Id, Format.Percent(t.Weight)))
	end
	UITheme.Label(tierRow, { Text = "Skin tiers: " .. table.concat(parts, "  "), Rich = true, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), MaxText = 16 })
	p.Refresh = function(d)
		local race = Config.RaceById[d.Race]
		local tier = Config.RaceTierById[d.RaceTier]
		raceName.Text = race and race.Name or "Unrolled"
		raceName.TextColor3 = race and race.Color or C.Text
		tierName.Text = tier and ((tier.Label or tier.Id) .. " skin") or ""
		tierName.TextColor3 = tier and tier.Color or C.Sub
		desc.Text = race and race.Desc or "Roll to awaken your bloodline!"
		rerolls.Text = "Rerolls: " .. d.Rerolls
	end
end

local function buildBackpack()
	local p = makePanel("Backpack", "ORE BAG", Vector2.new(660, 480), C.Gold)
	local items = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -96) })
	list(items, 6)
	local footer = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 86), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1) })
	local capBg = frame(footer, { Color = Color3.fromRGB(12, 10, 20), Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Corner = 8, Stroke = 2 })
	local capFill = frame(capBg, { Color = C.Gold, Size = UDim2.fromScale(0, 1), Corner = 8 })
	UITheme.Gradient(capFill, Color3.new(1, 1, 1), Color3.fromRGB(200, 150, 60), 90)
	local capText = UITheme.Label(capBg, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 18 })
	local hint = UITheme.Label(footer, { Text = "", Size = UDim2.new(0.5, 0, 0, 34), Position = UDim2.fromOffset(0, 44), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	hint.TextWrapped = true
	local actionBtn = UITheme.Button(footer, {
		Text = "SELL ALL",
		Color = "Gold",
		Size = UDim2.fromOffset(250, 72),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		MaxText = 28,
		OnClick = function()
			request("Sell")
		end,
	})
	p.Refresh = function(d)
		local mode = p.Mode == "Sell" and "Sell" or "View"
		local sigParts = { mode, d.BackpackMax, math.floor(d.Derived.CoinMult * 100) }
		for _, ore in ipairs(Config.Ores) do
			table.insert(sigParts, d.Backpack[ore.Id] or 0)
		end
		local sig = table.concat(sigParts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(items)
		local any = false
		for i, ore in ipairs(Config.Ores) do
			local count = d.Backpack[ore.Id] or 0
			if count > 0 then
				any = true
				local r = rowFrame(items, 64, i)
				accentBar(r, Config.Rarity[ore.Rarity].Color)
				local gem = frame(r, { Color = ore.Color, Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(34, 32), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 2 })
				gem.Rotation = 45
				UITheme.Label(r, { Text = ore.Name .. "  x" .. Format.Commas(count), Title = true, Size = UDim2.fromOffset(260, 26), Position = UDim2.fromOffset(62, 6), XAlign = Enum.TextXAlignment.Left, Color = ore.Color, MaxText = 22 })
				local eff = Config.Effects[ore.Effect]
				UITheme.Label(r, { Text = Config.Rarity[ore.Rarity].Label .. "  -  forges " .. Config.EffectText(ore.Effect, ore.Points), Size = UDim2.new(1, -250, 0, 22), Position = UDim2.fromOffset(62, 34), XAlign = Enum.TextXAlignment.Left, Color = eff and eff.Color or C.Sub, MaxText = 15 })
				if mode == "Sell" then
					UITheme.Label(r, { Text = "+" .. Format.Abbrev(ore.Sell * count * d.Derived.CoinMult), Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -130, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Color = C.Gold, MaxText = 20 })
					UITheme.Button(r, {
						Text = "Sell",
						Color = "Gold",
						Size = UDim2.fromOffset(110, 46),
						Position = UDim2.new(1, -10, 0.5, 0),
						AnchorPoint = Vector2.new(1, 0.5),
						OnClick = function()
							request("Sell", ore.Id)
						end,
					})
				end
			end
		end
		if not any then
			local r = rowFrame(items, 60, 1)
			UITheme.Label(r, { Text = "Your bag is empty. Fight down the Path and press F on dropped ore to pick it up!", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Color = C.Sub, MaxText = 17 })
		end
		capFill.Size = UDim2.fromScale(math.clamp(d.BackpackCount / math.max(1, d.BackpackMax), 0, 1), 1)
		capText.Text = Format.Abbrev(d.BackpackCount) .. " / " .. Format.Abbrev(d.BackpackMax) .. " ores"
		actionBtn.Visible = mode == "Sell"
		hint.Text = mode == "Sell" and "Keep rare ore for the Soul Forge - every ore stamps an effect on your weapon!" or "Forge ore into weapons at the Soul Forge, sell it at the stall. Upgrade the bag for more slots."
	end
end

-- Ore Index: every ore starts LOCKED. Picking one up marks it FOUND; click
-- the glowing card to unlock it, reveal its effect and claim the coins.
local function firstFloorFor(ore): number
	return math.max(1, 5 * (ore.Order - 3) + 1)
end

local function buildIndex()
	local p = makePanel("Index", "ORE INDEX", Vector2.new(720, 500), C.Cyan)
	local grid = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -34) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(160, 150)
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = grid
	local footer = UITheme.Label(p.Body, { Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), Color = C.Gold, MaxText = 16 })
	p.Refresh = function(d)
		local sigParts = {}
		for _, ore in ipairs(Config.Ores) do
			table.insert(sigParts, d.Index[ore.Id] and "U" or ((d.IndexFound or {})[ore.Id] and "F" or "L"))
		end
		local sig = table.concat(sigParts)
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(grid)
		local unlocked, waiting = 0, 0
		for i, ore in ipairs(Config.Ores) do
			local known = d.Index[ore.Id] == true
			local found = not known and (d.IndexFound or {})[ore.Id] == true
			if known then
				unlocked += 1
			elseif found then
				waiting += 1
			end
			local rarity = Config.Rarity[ore.Rarity]
			local eff = Config.Effects[ore.Effect]
			local card = frame(grid, { Color = known and C.Row or Color3.fromRGB(14, 12, 20), Order = i, Corner = 10 })
			local st = UITheme.Stroke(card, (known or found) and 2 or 1, (known or found) and rarity.Color or C.Line, true)
			st.Transparency = (known or found) and 0.1 or 0.6
			local gem = frame(card, { Color = known and ore.Color or (found and rarity.Color or Color3.fromRGB(40, 38, 50)), Size = UDim2.fromOffset(38, 38), Position = UDim2.new(0.5, 0, 0, 30), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 2 })
			gem.Rotation = 45
			if found then
				gem.BackgroundTransparency = 0.4
				local q = UITheme.Label(card, { Text = "?", Title = true, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0.5, 0, 0, 30), AnchorPoint = Vector2.new(0.5, 0.5), MaxText = 24 })
				q.ZIndex = 3
			end
			if known then
				UITheme.Label(card, { Text = ore.Name, Title = true, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 56), Color = ore.Color, MaxText = 17 })
				UITheme.Label(card, { Text = rarity.Label, Size = UDim2.new(1, -10, 0, 15), Position = UDim2.fromOffset(5, 76), Color = rarity.Color, MaxText = 13 })
				local t = UITheme.Label(card, { Text = Config.EffectText(ore.Effect, ore.Points), Size = UDim2.new(1, -12, 0, 50), Position = UDim2.fromOffset(6, 94), Color = eff and eff.Color or C.Text, MaxText = 12, StrokeThickness = 1 })
				t.TextWrapped = true
			elseif found then
				UITheme.Label(card, { Text = "NEW ORE FOUND!", Title = true, Size = UDim2.new(1, -10, 0, 18), Position = UDim2.fromOffset(5, 58), Color = rarity.Color, MaxText = 15 })
				local btn = UITheme.Button(card, { Text = "UNLOCK +" .. Format.Abbrev(Config.IndexReward[ore.Rarity]), Color = "Gold", Size = UDim2.new(1, -16, 0, 40), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), MaxText = 15, Corner = 8, Sound = "Discover", OnClick = function()
					request("UnlockIndex", ore.Id)
				end })
				local pulse = btn:FindFirstChildOfClass("UIScale")
				if pulse then
					task.spawn(function()
						while btn.Parent do
							tween(pulse, 0.5, { Scale = 1.05 })
							task.wait(0.5)
							tween(pulse, 0.5, { Scale = 1 })
							task.wait(0.5)
						end
					end)
				end
			else
				UITheme.Label(card, { Text = "LOCKED", Title = true, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 58), Color = C.Sub, MaxText = 16 })
				UITheme.Label(card, { Text = rarity.Label .. " ore", Size = UDim2.new(1, -10, 0, 15), Position = UDim2.fromOffset(5, 80), Color = rarity.Color, MaxText = 13 })
				local hint = UITheme.Label(card, { Text = "Drops from floor " .. firstFloorFor(ore) .. "+", Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 100), Color = C.Sub, MaxText = 12 })
				hint.TextWrapped = true
			end
		end
		footer.Text = string.format("Unlocked %d / %d ores%s", unlocked, #Config.Ores, waiting > 0 and ("  -  " .. waiting .. " waiting to be unlocked!") or "")
	end
end

local function buildShop()
	local p = makePanel("Shop", "SHOP", Vector2.new(720, 500), C.Green)
	local tabs = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 48) })
	list(tabs, 10, true)
	local pages = {}
	local function showTab(name)
		for n, page in pairs(pages) do
			page.Visible = n == name
		end
	end
	for i, name in ipairs({ "Passes", "Items", "Codes" }) do
		UITheme.Button(tabs, { Text = name, Color = i == 1 and "Green" or (i == 2 and "Blue" or "Purple"), Size = UDim2.fromOffset(150, 44), Order = i, OnClick = function()
			showTab(name)
		end })
		local page = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -56), Position = UDim2.fromOffset(0, 56) })
		page.Visible = i == 1
		pages[name] = page
	end
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(210, 150)
	g.CellPadding = UDim2.fromOffset(10, 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = pages.Passes
	local passButtons = {}
	for i, key in ipairs(Config.GamePassOrder) do
		local pass = Config.GamePasses[key]
		local card = frame(pages.Passes, { Color = Color3.fromRGB(36, 30, 60), Order = i, Corner = 14, Stroke = 3 })
		UITheme.Label(card, { Text = pass.Name, Title = true, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), Color = C.Gold, MaxText = 22 })
		local d = UITheme.Label(card, { Text = pass.Desc, Size = UDim2.new(1, -16, 0, 54), Position = UDim2.fromOffset(8, 38), Color = C.Sub, MaxText = 15, StrokeThickness = 1 })
		d.TextWrapped = true
		passButtons[key] = UITheme.Button(card, { Text = "Buy", Color = "Green", Size = UDim2.new(1, -24, 0, 44), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), OnClick = function()
			request("BuyPass", key)
		end })
	end
	local g2 = g:Clone()
	g2.Parent = pages.Items
	for i, key in ipairs(Config.ProductOrder) do
		local prod = Config.Products[key]
		local card = frame(pages.Items, { Color = Color3.fromRGB(30, 36, 64), Order = i, Corner = 14, Stroke = 3 })
		UITheme.Label(card, { Text = prod.Name, Title = true, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), Color = C.Blue, MaxText = 22 })
		local contents = {}
		if prod.Coins then
			table.insert(contents, Format.Abbrev(prod.Coins) .. " Coins" .. (prod.ScaleWithRebirth and " (x rebirths)" or ""))
		end
		if prod.Rerolls then
			table.insert(contents, prod.Rerolls .. " Race Rerolls")
		end
		if prod.Overdrive then
			table.insert(contents, prod.Overdrive .. " Overdrive")
		end
		local d = UITheme.Label(card, { Text = table.concat(contents, "\n"), Size = UDim2.new(1, -16, 0, 54), Position = UDim2.fromOffset(8, 38), Color = C.Sub, MaxText = 15, StrokeThickness = 1 })
		d.TextWrapped = true
		UITheme.Button(card, { Text = "Buy", Color = "Blue", Size = UDim2.new(1, -24, 0, 44), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), OnClick = function()
			request("BuyProduct", key)
		end })
	end
	-- codes
	local codeRow = rowFrame(pages.Codes, 140, 1)
	UITheme.Label(codeRow, { Text = "Enter a code for free rewards!", Title = true, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), MaxText = 26 })
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.62, 0, 0, 54)
	box.Position = UDim2.fromOffset(14, 62)
	box.BackgroundColor3 = Color3.fromRGB(16, 12, 26)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.PlaceholderText = "Type code here..."
	box.PlaceholderColor3 = C.Sub
	box.Font = UITheme.BodyFont
	box.TextScaled = true
	box.ClearTextOnFocus = false
	box.Text = ""
	box.Parent = codeRow
	UITheme.Corner(box, 10)
	UITheme.Stroke(box, 2, nil, true)
	UITheme.Button(codeRow, { Text = "REDEEM", Color = "Purple", Size = UDim2.new(0.33, -20, 0, 54), Position = UDim2.new(1, -14, 0, 62), AnchorPoint = Vector2.new(1, 0), OnClick = function()
		request("Redeem", box.Text)
		box.Text = ""
	end })
	list(pages.Codes, 8)
	p.Refresh = function(d)
		for key, btn in pairs(passButtons) do
			local owned = d.Passes[key] == true
			UITheme.SetButtonText(btn, owned and "OWNED" or "Buy")
		end
	end
end

local function buildTeleport()
	local p = makePanel("Teleport", "TRAVEL", Vector2.new(560, 330), C.Cyan)
	UITheme.Label(p.Body, { Text = "Travelling ends a dungeon run.", Size = UDim2.new(1, 0, 0, 22), Color = C.Sub, MaxText = 15 })
	local grid = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(240, 64)
	g.CellPadding = UDim2.fromOffset(10, 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = grid
	for i, d in ipairs({ { "Spawn", "Hub", "Green" }, { "Dungeon Gate", "Dungeon", "Purple" }, { "Training", "Train", "Blue" }, { "Boss Rush", "Tower", "Red" } }) do
		UITheme.Button(grid, { Text = d[1], Color = d[3], Order = i, MaxText = 22, Sound = "Teleport", OnClick = function()
			request("Teleport", d[2])
			UI.Close()
		end })
	end
end

-- Dungeon: pick a start floor (floor 1 or an unlocked checkpoint).
local function buildDungeon()
	local p = makePanel("Dungeon", "THE DUNGEON", Vector2.new(640, 470), C.Purple)
	local info = rowFrame(p.Body, 96, 0)
	accentBar(info, C.Purple)
	local best = UITheme.Label(info, { Text = "", Title = true, Size = UDim2.new(1, -30, 0, 30), Position = UDim2.fromOffset(18, 8), XAlign = Enum.TextXAlignment.Left, Color = C.Purple, MaxText = 26 })
	local rules = UITheme.Label(info, { Text = "", Rich = true, Size = UDim2.new(1, -30, 0, 50), Position = UDim2.fromOffset(18, 40), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 14 })
	rules.TextWrapped = true
	rules.TextYAlignment = Enum.TextYAlignment.Top
	UITheme.Label(p.Body, { Text = "START FROM", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 104), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	local grid = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -196), Position = UDim2.fromOffset(0, 126) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(190, 58)
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = grid
	local footer = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1) })
	local runLabel = UITheme.Label(footer, { Text = "", Size = UDim2.new(0.6, 0, 1, 0), XAlign = Enum.TextXAlignment.Left, Color = C.Gold, MaxText = 17 })
	local actionBtn = UITheme.Button(footer, { Text = "GO TO GATE", Color = "Blue", Size = UDim2.fromOffset(220, 54), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxText = 20, OnClick = function()
		local d = UI.Data
		if d and d.Run then
			request("Teleport", "Hub")
		else
			request("Teleport", "Dungeon")
		end
		UI.Close()
	end })
	p.Refresh = function(d)
		local D = Config.Dungeon
		local bestFloor = d.BestFloor or 0
		best.Text = "DEEPEST FLOOR: " .. bestFloor
		local cps = d.Checkpoints or { 1 }
		local last = cps[#cps]
		local lockedCp = last == 1 and D.CheckpointEvery or last + D.CheckpointEvery
		rules.Text = string.format('Clear each room to open the next door. <font color="#ff5a6e">Boss every %d floors.</font> Dying or going HOME ends the run.\nNext checkpoint: <font color="#ffc432">start at floor %d</font> once you reach floor %d.', D.BossEvery, lockedCp, lockedCp + D.CheckpointEvery)
		local sig = table.concat(d.Checkpoints or { 1 }, ",") .. (d.Run and ("R" .. d.Run.Floor) or "")
		if d.Run then
			runLabel.Text = "In a run: floor " .. d.Run.Floor .. " (started at " .. d.Run.Start .. ")"
			UITheme.SetButtonText(actionBtn, "END RUN (HOME)")
		else
			runLabel.Text = ""
			UITheme.SetButtonText(actionBtn, "GO TO GATE")
		end
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(grid)
		for i, f in ipairs(cps) do
			UITheme.Button(grid, { Text = "FLOOR " .. f, Color = f == 1 and "Green" or "Purple", Order = i, MaxText = 20, Sound = "Teleport", OnClick = function()
				request("DungeonStart", f)
				UI.Close()
			end })
		end
		-- the next locked checkpoint, as a teaser
		UITheme.Button(grid, { Text = "FLOOR " .. lockedCp .. " (reach " .. (lockedCp + D.CheckpointEvery) .. ")", Color = "Red", Order = 999, MaxText = 15, OnClick = function()
			UI.Notify("Reach floor " .. (lockedCp + D.CheckpointEvery) .. " to unlock this checkpoint.", C.Red)
		end })
	end
end

-- Skill mastery per weapon type.
local function buildMastery()
	local p = makePanel("Mastery", "SKILL MASTERY", Vector2.new(680, 500), C.Gold)
	local legend = rowFrame(p.Body, 64, 0)
	accentBar(legend, C.Gold)
	local parts = {}
	for _, m in ipairs(Config.Mastery.Milestones) do
		table.insert(parts, string.format('<font color="#ffc432">Lv %d %s</font>: %s', m.Level, m.Name, m.Desc))
	end
	local lt = UITheme.Label(legend, { Text = "Use E / R skills and get kills with a weapon type to level it. +3% skill damage per level.\n" .. table.concat(parts, "   "), Rich = true, Size = UDim2.new(1, -30, 1, -10), Position = UDim2.fromOffset(18, 5), XAlign = Enum.TextXAlignment.Left, MaxText = 13, StrokeThickness = 1 })
	lt.TextWrapped = true
	local listFrame = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -72), Position = UDim2.fromOffset(0, 72) })
	list(listFrame, 5)
	p.Refresh = function(d)
		local cur = player:GetAttribute("WeaponClass")
		local sigParts = { tostring(cur) }
		for _, cls in ipairs(Config.ClassOrder) do
			table.insert(sigParts, math.floor((d.Mastery or {})[cls] or 0))
		end
		local sig = table.concat(sigParts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(listFrame)
		for i, cls in ipairs(Config.ClassOrder) do
			local xp = (d.Mastery or {})[cls] or 0
			local level, into, need = Config.MasteryLevel(xp)
			local r = rowFrame(listFrame, 44, (cls == cur) and 0 or i, cls == cur and Color3.fromRGB(44, 38, 20) or nil)
			accentBar(r, cls == cur and C.Gold or C.Line)
			UITheme.Label(r, { Text = cls .. (cls == cur and "  (equipped)" or ""), Title = true, Size = UDim2.fromOffset(200, 22), Position = UDim2.fromOffset(18, 4), XAlign = Enum.TextXAlignment.Left, Color = cls == cur and C.Gold or C.Text, MaxText = 17 })
			local title = "Novice"
			for _, m in ipairs(Config.Mastery.Milestones) do
				if level >= m.Level then
					title = m.Name
				end
			end
			UITheme.Label(r, { Text = "Lv " .. level .. "  " .. title, Size = UDim2.fromOffset(200, 16), Position = UDim2.fromOffset(18, 25), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 13 })
			local barBg = frame(r, { Color = Color3.fromRGB(12, 10, 20), Size = UDim2.new(1, -250, 0, 14), Position = UDim2.new(0, 230, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Corner = 7 })
			local fill = frame(barBg, { Color = C.Gold, Size = UDim2.fromScale(need > 0 and math.clamp(into / need, 0, 1) or 1, 1), Corner = 7 })
			fill.Name = "Fill"
			UITheme.Label(barBg, { Text = need > 0 and (Format.Abbrev(into) .. " / " .. Format.Abbrev(need) .. " xp") or "MAX", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 11, StrokeThickness = 1 })
		end
	end
end

local function buildRebirth()
	local p = makePanel("Rebirth", "REBIRTH & ASCEND", Vector2.new(660, 520), C.Gold)
	local function card(order: number, color: Color3, y: number)
		local r = rowFrame(p.Body, 222, order)
		r.Position = UDim2.fromOffset(0, y)
		accentBar(r, color)
		local title = UITheme.Label(r, { Text = "", Title = true, Size = UDim2.new(1, -250, 0, 38), Position = UDim2.fromOffset(20, 8), XAlign = Enum.TextXAlignment.Left, Color = color, MaxText = 32 })
		local barBg = frame(r, { Color = Color3.fromRGB(12, 10, 20), Size = UDim2.new(1, -250, 0, 28), Position = UDim2.fromOffset(20, 52), Corner = 8, Stroke = 2 })
		local fill = frame(barBg, { Color = color, Size = UDim2.fromScale(0, 1), Corner = 8 })
		UITheme.Gradient(fill, Color3.new(1, 1, 1), color:Lerp(Color3.new(0, 0, 0), 0.35), 90)
		local barText = UITheme.Label(barBg, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 17 })
		local info = UITheme.Label(r, { Text = "", Rich = true, Size = UDim2.new(1, -250, 0, 120), Position = UDim2.fromOffset(20, 90), XAlign = Enum.TextXAlignment.Left, MaxText = 16 })
		info.TextWrapped = true
		info.TextYAlignment = Enum.TextYAlignment.Top
		return r, title, fill, barText, info
	end
	local reb, rebTitle, rebFill, rebBar, rebInfo = card(1, C.Gold, 0)
	local rebBtn = UITheme.Button(reb, { Text = "REBIRTH", Color = "Gold", Size = UDim2.fromOffset(200, 72), Position = UDim2.new(1, -16, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxText = 30, OnClick = function()
		request("Rebirth")
	end })
	local asc, ascTitle, ascFill, ascBar, ascInfo = card(2, C.Pink, 234)
	local ascBtn = UITheme.Button(asc, { Text = "ASCEND", Color = "Purple", Size = UDim2.fromOffset(200, 72), Position = UDim2.new(1, -16, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxText = 30, OnClick = function()
		request("Ascend")
	end })
	p.Refresh = function(d)
		local R, A = Config.Rebirth, Config.Ascension
		local powerNow = R.PowerMult ^ d.Rebirths * A.PowerMult ^ d.Ascensions
		local coinsNow = R.CoinMult ^ d.Rebirths * A.CoinMult ^ d.Ascensions
		rebTitle.Text = "REBIRTH  #" .. Format.Abbrev(d.Rebirths + 1)
		local rp = math.clamp(d.Power / math.max(1, d.RebirthReq), 0, 1)
		rebFill.Size = UDim2.fromScale(rp, 1)
		rebBar.Text = Format.Abbrev(d.Power) .. " / " .. Format.Abbrev(d.RebirthReq) .. " Power"
		rebInfo.Text = string.format(
			'<font color="#78ff9c">Power x%s</font> (x%s -> x%s)\n<font color="#ffd75a">Coins x%s</font> (x%s -> x%s)\n+%d Race Reroll\n<font color="#ff7a7a">Resets Power and Coins.</font>',
			tostring(R.PowerMult), Format.Abbrev(powerNow), Format.Abbrev(powerNow * R.PowerMult),
			tostring(R.CoinMult), Format.Abbrev(coinsNow), Format.Abbrev(coinsNow * R.CoinMult),
			R.RerollReward
		)
		UITheme.SetButtonText(rebBtn, rp >= 1 and "REBIRTH!" or (math.floor(rp * 100) .. "%"))
		ascTitle.Text = "ASCENSION  " .. (d.Ascensions > 0 and ("#" .. (d.Ascensions + 1)) or "I")
		local ap = math.clamp(d.Rebirths / math.max(1, d.AscendReq), 0, 1)
		ascFill.Size = UDim2.fromScale(ap, 1)
		ascBar.Text = d.Rebirths .. " / " .. d.AscendReq .. " Rebirths"
		ascInfo.Text = string.format(
			'<font color="#78ff9c">Power x%s</font>  <font color="#ffd75a">Coins x%s</font> (forever)\n+%d Rerolls, +1 %s\nUnlocks higher Training pads\n<font color="#ff7a7a">Resets Rebirths, Power and Coins.</font>',
			tostring(A.PowerMult), tostring(A.CoinMult), A.Rerolls, Config.KeyNames[A.Catalyst] or "Catalyst"
		)
		UITheme.SetButtonText(ascBtn, ap >= 1 and "ASCEND!" or (math.floor(ap * 100) .. "%"))
	end
end

local function buildSettings()
	local p = makePanel("Settings", "SETTINGS", Vector2.new(480, 440), Color3.fromRGB(150, 150, 170))
	local holder = frame(p.Body, { Transparency = 1 })
	list(holder, 10)
	local KEYS = { { "Music", "Music" }, { "SFX", "Sound effects" }, { "AutoEquip", "Auto-equip forged weapons" }, { "Shake", "Screen shake" }, { "DamageNumbers", "Damage numbers" } }
	local state = { Music = true, SFX = true, AutoEquip = true, Shake = true, DamageNumbers = true }
	local buttons = {}
	local function apply()
		SFX.SetMusicVolume(state.Music and 0.3 or 0)
		SFX.SetSFXVolume(state.SFX and 0.55 or 0)
		VFX.Settings.Shake = state.Shake
		VFX.Settings.DamageNumbers = state.DamageNumbers
		for _, k in ipairs(KEYS) do
			local btn = buttons[k[1]]
			UITheme.SetButtonText(btn, k[2] .. ": " .. (state[k[1]] and "ON" or "OFF"))
		end
	end
	for i, k in ipairs(KEYS) do
		buttons[k[1]] = UITheme.Button(holder, { Text = k[2], Color = "Blue", Size = UDim2.fromOffset(380, 52), Order = i, MaxText = 20, OnClick = function()
			state[k[1]] = not state[k[1]]
			apply()
			request("Settings", state)
		end })
	end
	UITheme.Label(holder, { Text = Config.GameName, Title = true, Size = UDim2.fromOffset(320, 26), Order = 99, Color = C.Pink, MaxText = 20 })
	p.Refresh = function(d)
		if d.Settings then
			for _, k in ipairs(KEYS) do
				state[k[1]] = d.Settings[k[1]] ~= false
			end
		end
		apply()
	end
	UI.ApplySettings = function(d)
		p.Refresh(d)
	end
end

---------------------------------------------------------------------
-- RACE ROLL (slot machine)
---------------------------------------------------------------------
function UI.RaceRoll(raceId: string, tierId: string, initial: boolean?)
	local race = Config.RaceById[raceId]
	local tier = Config.RaceTierById[tierId]
	if not race or not tier then
		return
	end
	UI.Close()
	local overlay = frame(flyGui, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 60 })
	tween(overlay, 0.3, { BackgroundTransparency = 0.35 })
	local card = frame(overlay, { Color = Color3.fromRGB(26, 20, 44), Size = UDim2.fromOffset(520, 240), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 22, Stroke = 5, ZIndex = 61 })
	local sc = Instance.new("UIScale")
	sc.Scale = math.clamp(math.min(workspace.CurrentCamera.ViewportSize.X / 1400, workspace.CurrentCamera.ViewportSize.Y / 820), 0.55, 1.1)
	sc.Parent = card
	UITheme.Label(card, { Text = initial and "AWAKENING YOUR BLOODLINE..." or "ROLLING RACE...", Title = true, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 12), Color = C.Sub, ZIndex = 62, MaxText = 28 })
	local nameLabel = UITheme.Label(card, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 90), Position = UDim2.fromOffset(10, 64), ZIndex = 62, MaxText = 70, StrokeThickness = 4 })
	local tierLabel = UITheme.Label(card, { Text = "", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 160), ZIndex = 62, MaxText = 28 })
	local stroke = card:FindFirstChildOfClass("UIStroke")

	task.spawn(function()
		local steps = 26
		for i = 1, steps do
			local r = Config.Races[math.random(1, #Config.Races)]
			nameLabel.Text = r.Name
			nameLabel.TextColor3 = r.Color
			if stroke then
				stroke.Color = r.Color
			end
			SFX.Play("RaceTick", { Pitch = 0.8 + i / steps })
			task.wait(0.03 + (i / steps) ^ 3 * 0.22)
		end
		nameLabel.Text = race.Name
		nameLabel.TextColor3 = race.Color
		tierLabel.Text = (tier.Label or tier.Id) .. " skin"
		tierLabel.TextColor3 = tier.Color
		if stroke then
			stroke.Color = race.Color
		end
		local s2 = Instance.new("UIScale")
		s2.Scale = 1.5
		s2.Parent = nameLabel
		tween(s2, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		local legendary = race.Weight <= 7 or tier.Id == "Legendary" or tier.Id == "Mythic"
		if legendary then
			SFX.Play("RaceRevealLegend")
			VFX.ImpactFrame(race.Color, 1.3)
			VFX.TitleCard(race.Name:upper() .. "!", (tier.Label or tier.Id) .. " skin  -  " .. Format.Percent(race.Weight) .. " chance", race.Color, 2)
		else
			SFX.Play("RaceReveal")
			VFX.ScreenFlash(race.Color, 0.4, 0.4)
		end
		task.wait(legendary and 2.4 or 1.6)
		tween(overlay, 0.3, { BackgroundTransparency = 1 })
		tween(sc, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.3)
		overlay:Destroy()
		UI.Notify("You are a " .. (tier.Label or tier.Id) .. " " .. race.Name .. "!", race.Color)
	end)
end

---------------------------------------------------------------------
-- STATUS WIDGETS
---------------------------------------------------------------------
function UI.SetPad(mult: number?, locked: boolean?)
	if not mult then
		padLabel.Visible = false
		return
	end
	padLabel.Visible = true
	padLabel.Text = locked and ("x" .. Format.Abbrev(mult) .. "  LOCKED - REBIRTH / ASCEND TO USE") or ("x" .. Format.Abbrev(mult) .. "  TRAINING")
	padLabel.TextColor3 = locked and C.Red or C.Green
end

local bannerToken = 0
function UI.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	local t = zoneBanner:FindFirstChild("Title") :: TextLabel
	local s = zoneBanner:FindFirstChild("Sub") :: TextLabel
	t.Text = title
	t.TextColor3 = color or C.Text
	s.Text = sub or ""
	zoneBanner.Visible = true
	zoneBanner.Position = UDim2.new(0.5, 0, 0, 150)
	t.TextTransparency = 1
	s.TextTransparency = 1
	tween(t, 0.4, { TextTransparency = 0 })
	tween(s, 0.4, { TextTransparency = 0 })
	tween(zoneBanner, 0.5, { Position = UDim2.new(0.5, 0, 0, 170) }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if bannerToken == my then
			tween(t, 0.5, { TextTransparency = 1 })
			tween(s, 0.5, { TextTransparency = 1 }).Completed:Once(function()
				if bannerToken == my then
					zoneBanner.Visible = false
				end
			end)
		end
	end)
end

function UI.Tower(state: string?, wave: number?, endsAt: number?)
	if not state then
		towerHud.Visible = false
		return
	end
	towerHud.Visible = true
	towerHud:SetAttribute("EndsAt", endsAt or 0)
	towerHud:SetAttribute("Floor", wave or 1)
	local title = towerHud:FindFirstChild("Title") :: TextLabel
	title.Text = "BOSS RUSH  -  WAVE " .. tostring(wave or 1)
end

local function refreshStageHud(d)
	local run = d and d.Run
	if not run or towerHud.Visible then
		stageHud.Visible = false
		return
	end
	stageHud.Visible = true
	local fd = Config.Floor(run.Floor)
	local zone = fd.ZoneData
	local title = stageHud:FindFirstChild("Title") :: TextLabel
	local count = stageHud:FindFirstChild("Count") :: TextLabel
	local fill = (stageHud:FindFirstChild("Bar") :: Frame):FindFirstChild("Fill") :: Frame
	title.Text = (fd.Boss and "BOSS FLOOR " or "FLOOR ") .. run.Floor .. "  " .. zone.Name:upper()
	title.TextColor3 = fd.Boss and C.Red or zone.Accent
	fill.BackgroundColor3 = fd.Boss and C.Red or zone.Accent
	if run.State == "Fighting" then
		local kills = math.min(run.Kills or 0, run.Need)
		count.Text = fd.Boss and "SLAY THE BOSS" or (kills .. " / " .. run.Need .. " KOs")
		count.TextColor3 = C.Gold
		fill.Size = UDim2.fromScale(math.clamp(kills / math.max(1, run.Need), 0, 1), 1)
	else
		count.Text = "ENTER THE ROOM"
		count.TextColor3 = C.Sub
		fill.Size = UDim2.fromScale(0, 1)
	end
end

-- Small end-of-run card (death / HOME).
function UI.RunSummary(p)
	local fly = flyGui
	local card = frame(fly, { Color = Color3.fromRGB(10, 8, 18), Transparency = 0.15, Size = UDim2.fromOffset(300, 118), Position = UDim2.new(0.5, 0, 0, 150), AnchorPoint = Vector2.new(0.5, 0), Corner = 10, ZIndex = 50 })
	local st = UITheme.Stroke(card, 1.5, p.Reason == "Died" and C.Red or C.Purple, true)
	st.Transparency = 0.2
	local reason = p.Reason == "Died" and "YOU FELL" or (p.Reason == "Home" and "RUN ENDED" or "RUN OVER")
	softLabel(card, { Text = reason, Font = Config.Fonts.Display, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 6), Color = p.Reason == "Died" and C.Red or C.Purple, MaxText = 22, ZIndex = 51 })
	softLabel(card, { Text = string.format("Reached floor %d  -  cleared %d  -  +%s coins", p.Reached or 1, p.Cleared or 0, Format.Abbrev(p.Coins or 0)), Font = Config.Fonts.Body, Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(10, 34), MaxText = 14, ZIndex = 51 })
	local cps = p.Checkpoints or { 1 }
	softLabel(card, { Text = "Deepest: " .. (p.Best or 0) .. "  -  next run can start at floor " .. cps[#cps], Font = Config.Fonts.Body, Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 54), Color = C.Sub, MaxText = 13, ZIndex = 51 })
	UITheme.Button(card, { Text = "BACK TO THE GATE", Color = "Purple", Size = UDim2.new(1, -20, 0, 34), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), MaxText = 16, Corner = 8, ZIndex = 52, OnClick = function()
		request("Teleport", "Dungeon")
		card:Destroy()
	end })
	local sc = Instance.new("UIScale")
	sc.Scale = 0.7
	sc.Parent = card
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(7, function()
		if card.Parent then
			tween(sc, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(card, 0.25)
		end
	end)
end

local eventSig = ""
local function refreshEvents(d)
	local keys = {}
	for key in pairs(d.Events or {}) do
		table.insert(keys, key)
	end
	table.sort(keys)
	local sig = table.concat(keys, ",")
	if sig == eventSig then
		return
	end
	eventSig = sig
	clearList(eventRow)
	for i, key in ipairs(keys) do
		local e = Config.Events[key]
		if e then
			local chip = frame(eventRow, { Name = key, Color = e.Color, Transparency = 0.1, Size = UDim2.fromOffset(150, 24), Order = i, Corner = 6, Stroke = 1.5 })
			UITheme.Gradient(chip, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
			softLabel(chip, { Name = "Label", Text = e.Name, Font = Config.Fonts.Display, Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), MaxText = 17 })
		end
	end
end

---------------------------------------------------------------------
-- UPDATE
---------------------------------------------------------------------
function UI.Update(d)
	local first = UI.Data == nil
	UI.Data = d
	animateNumber("Power", pills.Power.Value, d.Power, Format.Abbrev)
	local ready = d.Power >= d.RebirthReq
	pills.Power.Sub.Text = "REBIRTH!"
	pills.Power.Sub.Visible = ready
	animateNumber("Coins", pills.Coins.Value, d.Coins, Format.Abbrev)
	pills.Backpack.Value.Text = Format.Abbrev(d.BackpackCount) .. "/" .. Format.Abbrev(d.BackpackMax)
	local full = d.BackpackCount >= d.BackpackMax
	pills.Backpack.Sub.Text = "FULL"
	pills.Backpack.Sub.TextColor3 = C.Red
	pills.Backpack.Sub.Visible = full
	adminButton.Visible = d.IsAdmin == true

	local now = { Power = d.Power, Coins = d.Coins, Backpack = d.BackpackCount }
	for key, v in pairs(now) do
		if not first and prevValues[key] ~= nil and prevValues[key] ~= v then
			UI.Reveal(key)
		end
		prevValues[key] = v
	end
	refreshEvents(d)

	if current and current.Refresh then
		current.Refresh(d)
	end
	if first and UI.ApplySettings then
		UI.ApplySettings(d)
	end
end

-- Called every frame by the client (timers + contextual fades).
local stageTick = 0
function UI.Tick(dt: number)
	local now = workspace:GetServerTimeNow()
	if towerHud.Visible then
		local endsAt = towerHud:GetAttribute("EndsAt") or 0
		local timer = towerHud:FindFirstChild("Timer") :: TextLabel
		local left = endsAt - now
		if endsAt > 0 and left > 0 then
			timer.Text = Format.Time(left)
			timer.TextColor3 = left < 8 and C.Red or C.Text
		else
			timer.Text = "--:--"
		end
	end
	stageTick += dt
	if stageTick > 0.2 then
		stageTick = 0
		refreshStageHud(UI.Data)
		local events = UI.Data and UI.Data.Events or {}
		for _, chip in ipairs(eventRow:GetChildren()) do
			local e = events[chip.Name]
			local label = chip:FindFirstChild("Label") :: TextLabel?
			if e and label then
				label.Text = Config.Events[chip.Name].Name .. "  " .. Format.Time(math.max(0, e.EndsAt - now))
			end
		end
	end
	local menuOpen = drawerOpen or current ~= nil
	menuHint.Visible = not menuOpen
	local t = os.clock()
	for _, p in pairs(pills) do
		local target = (p.Pinned or menuOpen or t < p.Until) and 1 or 0
		local speed = target > p.Alpha and 9 or 3
		p.Alpha += (target - p.Alpha) * math.min(1, dt * speed)
		if math.abs(target - p.Alpha) < 0.01 then
			p.Alpha = target
		end
		p.Holder.GroupTransparency = 1 - p.Alpha
		p.Holder.Visible = p.Alpha > 0.01
	end
end

-- True while the menu drawer is open: every contextual HUD group shows.
function UI.IsPeeking(): boolean
	return drawerOpen
end

function UI.IsPanelOpen(): boolean
	return current ~= nil
end

function UI.ToggleDrawer(force: boolean?)
	local open = if force == nil then not drawerOpen else force
	if open == drawerOpen then
		return
	end
	drawerOpen = open
	SFX.Play(open and "UIOpen" or "UIClose")
	if open then
		drawer.Visible = true
		drawer.Position = UDim2.new(0, DRAWER_X - 28, 0, drawer.Position.Y.Offset)
	end
	tween(drawer, 0.28, { GroupTransparency = open and 0 or 1, Position = UDim2.new(0, open and DRAWER_X or DRAWER_X - 28, 0, drawer.Position.Y.Offset) }, Enum.EasingStyle.Quart).Completed:Once(function()
		if not drawerOpen then
			drawer.Visible = false
		end
	end)
end

---------------------------------------------------------------------
-- INIT
---------------------------------------------------------------------
function UI.Init(requestFn)
	request = requestFn
	UITheme.Init()
	local pg = player:WaitForChild("PlayerGui")

	screen = Instance.new("ScreenGui")
	screen.Name = "GameUI"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = pg

	flyGui = Instance.new("ScreenGui")
	flyGui.Name = "GameUIFx"
	flyGui.ResetOnSpawn = false
	flyGui.IgnoreGuiInset = true
	flyGui.DisplayOrder = 40
	flyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	flyGui.Parent = pg

	root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Parent = screen
	uiScale = Instance.new("UIScale")
	uiScale.Parent = root
	local inset = GuiService:GetGuiInset()
	local function rescale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1400, 820)
		local s = math.clamp(math.min(vp.X / 1400, vp.Y / 820), 0.5, 1.15)
		uiScale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	dim = frame(root, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 4 })
	dim.Name = "Dim"
	dim.Visible = false
	dim.Size = UDim2.fromScale(3, 3)
	dim.Position = UDim2.fromScale(-1, -1)
	dim.Active = true
	dim.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			UI.Close()
		end
	end)

	-- compact currency stack (left): Power, Coins and the ore bag only.
	-- Clicking a pill opens the matching menu.
	local stack = frame(root, { Transparency = 1, Size = UDim2.fromOffset(140, 110), Position = UDim2.new(0, 16, 0.5, -10), AnchorPoint = Vector2.new(0, 0.5) })
	stack.Name = "Resources"
	local sl = list(stack, 5, false, Enum.HorizontalAlignment.Left)
	sl.VerticalAlignment = Enum.VerticalAlignment.Center
	makePill(stack, "Power", "Icon_Power", Color3.fromRGB(120, 255, 170), 1, true, "Rebirth")
	makePill(stack, "Coins", "Icon_Coins", C.Gold, 2, true, "Upgrades")
	makePill(stack, "Backpack", "Icon_Backpack", Color3.fromRGB(120, 200, 255), 3, true, "Backpack")

	-- single small menu button; everything else lives in the drawer
	local menuBtn = Instance.new("TextButton")
	menuBtn.Name = "MenuButton"
	menuBtn.AutoButtonColor = false
	menuBtn.Text = ""
	menuBtn.Size = UDim2.fromOffset(40, 40)
	menuBtn.Position = UDim2.fromOffset(18, inset.Y + 10)
	menuBtn.BackgroundColor3 = Color3.fromRGB(10, 8, 18)
	menuBtn.BackgroundTransparency = 0.35
	menuBtn.Parent = root
	UITheme.Corner(menuBtn, 10)
	local mbStroke = Instance.new("UIStroke")
	mbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	mbStroke.Thickness = 1.5
	mbStroke.Color = C.Cyan
	mbStroke.Transparency = 0.55
	mbStroke.Parent = menuBtn
	for k = -1, 1 do
		local line = frame(menuBtn, { Color = Color3.new(1, 1, 1), Transparency = 0.1, Size = UDim2.fromOffset(k == 0 and 12 or 16, 2), Position = UDim2.new(0.5, 0, 0.5, k * 5), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 1 })
		line.Name = "Line"
	end
	menuBtn.MouseEnter:Connect(function()
		tween(mbStroke, 0.15, { Transparency = 0.05 })
		SFX.Play("UIHover")
	end)
	menuBtn.MouseLeave:Connect(function()
		tween(mbStroke, 0.15, { Transparency = 0.55 })
	end)
	menuBtn.Activated:Connect(function()
		UI.ToggleDrawer()
	end)

	-- "G for menus" hint: small text on the left, hidden while a menu is open
	menuHint = softLabel(root, { Name = "MenuHint", Text = "G for menus", Font = Config.Fonts.Body, Size = UDim2.fromOffset(110, 16), Position = UDim2.fromOffset(66, inset.Y + 22), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 15 })

	-- HOME: top centre, always one click back to spawn (also leaves the Boss Rush)
	local homeBtn = UITheme.Button(root, {
		Name = "Home",
		Text = "HOME",
		Color = "Blue",
		Size = UDim2.fromOffset(112, 38),
		Position = UDim2.new(0.5, 0, 0, inset.Y + 8),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxText = 22,
		Corner = 8,
		Sound = "Teleport",
		OnClick = function()
			request("Teleport", "Hub")
		end,
	})
	homeBtn.ZIndex = 2

	-- floor tracker (under HOME, only during a dungeon run)
	stageHud = frame(root, { Color = Color3.fromRGB(10, 8, 18), Transparency = 0.3, Size = UDim2.fromOffset(330, 50), Position = UDim2.new(0.5, 0, 0, inset.Y + 54), AnchorPoint = Vector2.new(0.5, 0), Corner = 8 })
	stageHud.Name = "FloorTracker"
	stageHud.Visible = false
	local shStroke = UITheme.Stroke(stageHud, 1, C.Line, true)
	shStroke.Transparency = 0.3
	softLabel(stageHud, { Name = "Title", Text = "", Font = Config.Fonts.Display, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 4), XAlign = Enum.TextXAlignment.Left, MaxText = 22 })
	softLabel(stageHud, { Name = "Count", Text = "", Font = Config.Fonts.Heading, Size = UDim2.new(0.4, 0, 0, 20), Position = UDim2.new(1, -10, 0, 5), AnchorPoint = Vector2.new(1, 0), XAlign = Enum.TextXAlignment.Right, MaxText = 18, Color = C.Gold })
	local shBar = frame(stageHud, { Name = "Bar", Color = Color3.fromRGB(30, 26, 44), Size = UDim2.new(1, -20, 0, 10), Position = UDim2.fromOffset(10, 32), Corner = 4 })
	local shFill = frame(shBar, { Name = "Fill", Color = C.Green, Size = UDim2.fromScale(0, 1), Corner = 4 })
	UITheme.Gradient(shFill, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)

	-- global event chips (admin abuse events), top right of HOME
	eventRow = frame(root, { Transparency = 1, Size = UDim2.fromOffset(420, 26), Position = UDim2.new(0.5, 70, 0, inset.Y + 14), AnchorPoint = Vector2.new(0, 0) })
	eventRow.Name = "Events"
	list(eventRow, 6, true, Enum.HorizontalAlignment.Left)

	-- menu drawer (slides out next to the menu button)
	drawer = Instance.new("CanvasGroup")
	drawer.Name = "Drawer"
	drawer.BackgroundColor3 = Color3.fromRGB(8, 6, 14)
	drawer.BackgroundTransparency = 0.2
	drawer.GroupTransparency = 1
	drawer.Visible = false
	drawer.Size = UDim2.fromOffset(188, 540)
	drawer.Position = UDim2.new(0, DRAWER_X - 28, 0, inset.Y + 60)
	drawer.ZIndex = 3
	drawer.Parent = root
	UITheme.Corner(drawer, 12)
	local dStroke = Instance.new("UIStroke")
	dStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	dStroke.Thickness = 1.5
	dStroke.Color = C.Cyan
	dStroke.Transparency = 0.6
	dStroke.Parent = drawer
	softLabel(drawer, { Text = "MENU [G]   MAP [M]   HOME [B]", Font = Config.Fonts.Body, Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 10), Color = C.Sub, Transparency = 0.2 })
	local grid = frame(drawer, { Transparency = 1, Size = UDim2.new(1, -16, 1, -36), Position = UDim2.fromOffset(8, 30) })
	grid.Name = "Grid"
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(82, 50)
	gl.CellPadding = UDim2.fromOffset(6, 6)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	local function drawerButton(label: string, icon: string, color: Color3, order: number, onClick)
		local b = Instance.new("TextButton")
		b.Name = label
		b.AutoButtonColor = false
		b.Text = ""
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.9
		b.LayoutOrder = order
		b.Parent = grid
		UITheme.Corner(b, 8)
		local st = Instance.new("UIStroke")
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Thickness = 1
		st.Color = color
		st.Transparency = 0.6
		st.Parent = b
		local tick = frame(b, { Color = color, Size = UDim2.new(0, 3, 0, 16), Position = UDim2.fromOffset(4, 6), Corner = 1 })
		tick.Name = "Tick"
		UITheme.Icon(b, icon, UDim2.fromOffset(20, 20), UDim2.new(0.5, 0, 0, 5), Vector2.new(0.5, 0))
		softLabel(b, { Text = label, Font = Config.Fonts.Heading, Size = UDim2.new(1, -8, 0, 14), Position = UDim2.new(0, 4, 1, -19), Color = Color3.new(1, 1, 1) })
		b.MouseEnter:Connect(function()
			tween(st, 0.12, { Transparency = 0.1 })
			tween(b, 0.12, { BackgroundTransparency = 0.75 })
			SFX.Play("UIHover")
		end)
		b.MouseLeave:Connect(function()
			tween(st, 0.12, { Transparency = 0.6 })
			tween(b, 0.12, { BackgroundTransparency = 0.9 })
		end)
		b.Activated:Connect(function()
			SFX.Play("UIClick")
			UI.ToggleDrawer(false)
			onClick()
		end)
		return b
	end
	drawerButton("Dungeon", "Icon_Tower", C.Purple, 0, function() UI.Toggle("Dungeon") end)
	drawerButton("Weapons", "Icon_Blade", C.Purple, 1, function() UI.Toggle("Weapons") end)
	drawerButton("Forge", "Icon_Blade", Color3.fromRGB(255, 140, 60), 2, function() UI.Toggle("Forge") end)
	drawerButton("Armor", "Icon_Rune", C.Cyan, 3, function() UI.Toggle("Armor") end)
	drawerButton("Map", "Icon_Teleport", C.Cyan, 4, function()
		if UI.ToggleMap then
			UI.ToggleMap()
		end
	end)
	drawerButton("Bag", "Icon_Backpack", C.Gold, 5, function() UI.Toggle("Backpack", "View") end)
	drawerButton("Upgrades", "Icon_Upgrades", C.Blue, 6, function() UI.Toggle("Upgrades") end)
	drawerButton("Rebirth", "Icon_Rebirth", C.Gold, 7, function() UI.Toggle("Rebirth") end)
	drawerButton("Race", "Icon_Race", C.Purple, 8, function() UI.Toggle("Race") end)
	drawerButton("Mastery", "Icon_Power", C.Gold, 8, function() UI.Toggle("Mastery") end)
	drawerButton("Index", "Icon_Index", C.Blue, 9, function() UI.Toggle("Index") end)
	drawerButton("Travel", "Icon_Teleport", C.Green, 10, function() UI.Toggle("Teleport") end)
	drawerButton("Shop", "Icon_Shop", C.Green, 11, function() UI.Toggle("Shop") end)
	drawerButton("Power", "Icon_Power", C.Red, 12, function() UI.Toggle("Power") end)
	drawerButton("Rewards", "Icon_Tower", C.Green, 13, function() UI.Toggle("Rewards") end)
	drawerButton("Settings", "Icon_Settings", C.Sub, 14, function() UI.Toggle("Settings") end)
	adminButton = drawerButton("Admin", "Icon_Settings", C.Red, 15, function() UI.Toggle("Admin") end)
	adminButton.Visible = false

	-- keyboard / gamepad shortcuts
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G or input.KeyCode == Enum.KeyCode.DPadDown then
			UI.ToggleDrawer()
		elseif input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.DPadRight then
			if UI.ToggleMap then
				UI.ToggleMap()
			end
		elseif input.KeyCode == Enum.KeyCode.B then
			request("Teleport", "Hub")
		elseif input.KeyCode == Enum.KeyCode.P and UI.Data and UI.Data.IsAdmin then
			UI.Toggle("Admin")
		end
	end)

	-- pad indicator (only while standing on a training pad)
	padLabel = softLabel(root, { Text = "", Font = Config.Fonts.Display, Size = UDim2.fromOffset(300, 24), Position = UDim2.new(0.5, 0, 0, inset.Y + 112), AnchorPoint = Vector2.new(0.5, 0), MaxText = 22 })
	padLabel.Visible = false

	-- zone banner (fades in and out on arrival)
	zoneBanner = frame(root, { Transparency = 1, Size = UDim2.fromOffset(320, 40), Position = UDim2.new(0.5, 0, 0, 170), AnchorPoint = Vector2.new(0.5, 0) })
	zoneBanner.Name = "ZoneBanner"
	zoneBanner.Visible = false
	softLabel(zoneBanner, { Name = "Title", Text = "", Font = Config.Fonts.Display, Size = UDim2.new(1, 0, 0, 22), MaxText = 22 })
	softLabel(zoneBanner, { Name = "Sub", Text = "", Font = Config.Fonts.Body, Size = UDim2.new(1, 0, 0, 13), Position = UDim2.fromOffset(0, 24), MaxText = 13, Color = C.Sub })

	-- boss rush hud (only during a run)
	towerHud = frame(root, { Color = Color3.fromRGB(10, 8, 18), Transparency = 0.3, Size = UDim2.fromOffset(330, 64), Position = UDim2.new(0.5, 0, 0, inset.Y + 54), AnchorPoint = Vector2.new(0.5, 0), Corner = 8 })
	towerHud.Name = "TowerHud"
	towerHud.Visible = false
	softLabel(towerHud, { Name = "Title", Text = "BOSS RUSH", Font = Config.Fonts.Body, Size = UDim2.new(0.6, 0, 0, 18), Position = UDim2.fromOffset(14, 8), XAlign = Enum.TextXAlignment.Left, Color = C.Pink })
	softLabel(towerHud, { Name = "Timer", Text = "--:--", Font = Config.Fonts.Display, Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(14, 28), XAlign = Enum.TextXAlignment.Left })
	UITheme.Button(towerHud, { Text = "LEAVE", Color = "Red", Size = UDim2.fromOffset(96, 40), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxText = 20, OnClick = function()
		request("TowerLeave")
	end })

	-- notifications
	toastHolder = frame(root, { Transparency = 1, Size = UDim2.fromOffset(240, 160), Position = UDim2.new(1, -12, 0, inset.Y + 56), AnchorPoint = Vector2.new(1, 0) })
	toastHolder.Name = "Toasts"
	local tl = list(toastHolder, 3)
	tl.VerticalAlignment = Enum.VerticalAlignment.Top
	tl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	toastHolder.ClipsDescendants = false

	buildUpgrades()
	buildRace()
	buildBackpack()
	buildIndex()
	buildShop()
	buildTeleport()
	buildDungeon()
	buildMastery()
	buildRebirth()
	buildSettings()
end

-- Helpers for the other client UI modules (Hud, WeaponUI).
UI.Helpers = {
	Frame = frame,
	List = list,
	Scroller = scroller,
	Clear = clearList,
	Tween = tween,
	Row = rowFrame,
	Accent = accentBar,
	MakePanel = makePanel,
	Hex = hex,
	Text = softLabel,
}
function UI.Root()
	return root
end
function UI.FlyGui()
	return flyGui
end
function UI.Panel(name: string)
	return panels[name]
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WeaponUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- WeaponUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/WeaponUI
-- Weapons inventory (3D previews + forged ore effects), Armor inventory,
-- the forge reveal, 2x Power shop (3^n Robux -> 2^n power) and the
-- play-time Rewards ladder.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))
local SFX = require(Shared:WaitForChild("SFX"))
local VFX = require(Shared:WaitForChild("VFX"))

local WeaponUI = {}
local UI, H
local request: (string, any?) -> () = function() end
local C = UITheme.Colors
local player = Players.LocalPlayer

local function rarityOf(id: string)
	return Config.WeaponRarityById[id] or Config.WeaponRarities[1]
end

local function rarityLabel(r): string
	return r.Label or r.Id
end

-- Spinning 3D weapon preview in a ViewportFrame. Returns a cleanup function.
local function preview(parent: GuiObject, weaponId: string, rarityId: string, size: UDim2, pos: UDim2?)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = size
	vp.Position = pos or UDim2.new()
	vp.Ambient = Color3.fromRGB(190, 185, 210)
	vp.LightColor = Color3.new(1, 1, 1)
	vp.LightDirection = Vector3.new(-1, -1.2, -0.8)
	vp.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local built = WeaponModels.Build(weaponId, rarityId)
	built.Main.Parent = world
	if built.Off then
		built.Off:Destroy()
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local cf, sz = built.Main:GetBoundingBox()
	local center = cf.Position
	local dist = math.max(sz.X, sz.Y, sz.Z) * 1.7 + 1
	local start = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - start) * 0.9
		cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * dist, dist * 0.25, math.sin(a) * dist), center)
	end)
	return function()
		conn:Disconnect()
		vp:Destroy()
	end
end
WeaponUI.Preview = preview

-- Ore effects on a weapon, strongest first: { {Id, Points, Def} }
local function effectList(effects)
	local out = {}
	for id, pts in pairs(effects or {}) do
		local def = Config.Effects[id]
		if def then
			table.insert(out, { Id = id, Points = pts, Def = def })
		end
	end
	table.sort(out, function(a, b)
		if a.Points ~= b.Points then
			return a.Points > b.Points
		end
		return a.Id < b.Id
	end)
	return out
end
WeaponUI.EffectList = effectList

local function effectRich(effects): string
	local lines = {}
	for _, e in ipairs(effectList(effects)) do
		table.insert(lines, string.format('<font color="#%s">%s</font>', e.Def.Color:ToHex(), Config.EffectText(e.Id, e.Points)))
	end
	return table.concat(lines, "\n")
end
WeaponUI.EffectRich = effectRich

local function sortedWeapons(d)
	local list = {}
	for uid, rec in pairs(d.Weapons or {}) do
		local def = Config.WeaponById[rec.W]
		if def then
			table.insert(list, { Uid = uid, Def = def, Rarity = rarityOf(rec.R), Effects = rec.E })
		end
	end
	table.sort(list, function(a, b)
		if a.Uid == d.Equipped then
			return true
		elseif b.Uid == d.Equipped then
			return false
		end
		if a.Rarity.Index ~= b.Rarity.Index then
			return a.Rarity.Index > b.Rarity.Index
		end
		return a.Def.Name < b.Def.Name
	end)
	return list
end

---------------------------------------------------------------------
-- WEAPONS PANEL
---------------------------------------------------------------------
local function buildWeapons()
	local p = H.MakePanel("Weapons", "WEAPONS", Vector2.new(820, 500), C.Purple)
	local grid = H.Scroller(p.Body, { Size = UDim2.new(1, -300, 1, -46) })
	-- QoL: bulk scrap
	local bulk = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(1, -300, 0, 40), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1) })
	H.List(bulk, 6, true, Enum.HorizontalAlignment.Left)
	local armed = { [1] = 0, [2] = 0 }
	for i, lvl in ipairs({ 1, 2 }) do
		local label = lvl == 1 and "SCRAP ALL COMMON" or "SCRAP COMMON+UNCOMMON"
		local b
		b = UITheme.Button(bulk, { Text = label, Color = "Red", Size = UDim2.fromOffset(i == 1 and 180 or 240, 38), Order = i, MaxText = 14, Corner = 8, OnClick = function()
			if os.clock() - armed[lvl] < 3 then
				armed[lvl] = 0
				UITheme.SetButtonText(b, label)
				request("ScrapBulk", lvl)
			else
				armed[lvl] = os.clock()
				UITheme.SetButtonText(b, "CLICK AGAIN")
				task.delay(3, function()
					UITheme.SetButtonText(b, label)
				end)
			end
		end })
	end
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(150, 78)
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = grid
	local detail = H.Frame(p.Body, { Color = Color3.fromRGB(26, 20, 44), Size = UDim2.new(0, 288, 1, 0), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Corner = 14, Stroke = 2 })
	local selected = nil
	local cleanupPreview = nil
	local lastD = nil

	local function showDetail(entry)
		H.Clear(detail)
		if cleanupPreview then
			cleanupPreview()
			cleanupPreview = nil
		end
		if not entry then
			UITheme.Label(detail, { Text = "Select a weapon", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 20), Color = C.Sub, MaxText = 18 })
			return
		end
		local def, r = entry.Def, entry.Rarity
		local class = Config.WeaponClasses[def.Class]
		cleanupPreview = preview(detail, def.Id, r.Id, UDim2.new(1, -16, 0, 130), UDim2.fromOffset(8, 6))
		UITheme.Label(detail, { Text = def.Name, Title = true, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 138), Color = r.Color, MaxText = 26 })
		UITheme.Label(detail, { Text = rarityLabel(r) .. "  |  " .. def.Class, Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 168), Color = C.Sub, MaxText = 15 })
		local skill = Config.Skills[def.Skill]
		local ult = Config.Skills[class.Ultimate]
		local lines = {
			string.format('<font color="#78ff9c">+%d%% Base Damage</font>%s', math.floor(r.Damage * 100 + 0.5), (r.AttackSpeed or 0) > 0 and string.format('  <font color="#8fd3ff">+%d%% Atk Speed</font>', math.floor(r.AttackSpeed * 100)) or ""),
			string.format('<font color="#ffc35a">E</font> %s   <font color="#ff6a8a">R</font> %s', skill and skill.Name or "-", ult and ult.Name or "-"),
		}
		if r.Passive and def.Passive then
			table.insert(lines, string.format('<font color="#ffd75a">Passive: %s</font> - %s', def.Passive.Name, def.Passive.Desc))
		end
		if r.Aura then
			table.insert(lines, '<font color="#ff5a6e">Celestial aura + signature skill</font>')
		elseif r.Trail then
			table.insert(lines, '<font color="#c78cff">Custom particle trail</font>')
		end
		if def.Recipe then
			table.insert(lines, 1, '<font color="#ff64b9">Unique recipe weapon</font>')
		end
		local fx = effectRich(entry.Effects)
		if fx ~= "" then
			table.insert(lines, fx)
		else
			table.insert(lines, '<font color="#8a86a0">No ore effects (forge one at the Soul Forge!)</font>')
		end
		-- skill mastery for this weapon type
		local mxp = lastD and lastD.Mastery and lastD.Mastery[def.Class] or 0
		local mlvl = Config.MasteryLevel(mxp)
		table.insert(lines, 3, string.format('<font color="#ffc432">%s mastery Lv %d</font> (+%d%% skill dmg)', def.Class, mlvl, math.floor(mlvl * Config.Mastery.DamagePerLevel * 100 + 0.5)))
		local info = UITheme.Label(detail, { Text = table.concat(lines, "\n"), Rich = true, Size = UDim2.new(1, -16, 0, 176), Position = UDim2.fromOffset(8, 192), XAlign = Enum.TextXAlignment.Left, MaxText = 15, StrokeThickness = 1 })
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.TextWrapped = true
		local equipped = lastD and lastD.Equipped == entry.Uid
		UITheme.Button(detail, { Text = equipped and "EQUIPPED" or "EQUIP", Color = equipped and "Blue" or "Green", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), OnClick = function()
			request("Equip", entry.Uid)
		end })
		UITheme.Button(detail, { Text = "SCRAP " .. Format.Abbrev(r.Scrap), Color = "Red", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(1, -8, 1, -8), AnchorPoint = Vector2.new(1, 1), MaxText = 18, OnClick = function()
			request("Scrap", entry.Uid)
		end })
	end

	p.Refresh = function(d)
		lastD = d
		local parts = { d.Equipped or "" }
		for uid, rec in pairs(d.Weapons or {}) do
			local e = {}
			for id, pts in pairs(rec.E or {}) do
				table.insert(e, id .. pts)
			end
			table.sort(e)
			table.insert(parts, uid .. rec.W .. rec.R .. table.concat(e))
		end
		table.sort(parts)
		local sig = table.concat(parts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		H.Clear(grid)
		local list = sortedWeapons(d)
		local stillThere = nil
		for i, entry in ipairs(list) do
			local r = entry.Rarity
			local card = H.Frame(grid, { Color = Color3.fromRGB(34, 28, 56), Order = i, Corner = 12, Stroke = 3 })
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Color = r.Color
			end
			UITheme.Gradient(card, Color3.new(1, 1, 1), r.Color:Lerp(Color3.new(0, 0, 0), 0.4), 90)
			UITheme.Label(card, { Text = entry.Def.Name, Title = true, Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 6), Color = r.Color, MaxText = 20 })
			UITheme.Label(card, { Text = rarityLabel(r) .. " " .. entry.Def.Class, Size = UDim2.new(1, -10, 0, 18), Position = UDim2.fromOffset(5, 34), Color = C.Text, MaxText = 13 })
			if entry.Uid == d.Equipped then
				UITheme.Label(card, { Text = "EQUIPPED", Size = UDim2.new(0.6, 0, 0, 16), Position = UDim2.fromOffset(5, 55), XAlign = Enum.TextXAlignment.Left, Color = C.Green, MaxText = 13 })
			end
			-- one dot per ore effect
			for k, e in ipairs(effectList(entry.Effects)) do
				if k > 4 then
					break
				end
				local dot = H.Frame(card, { Color = e.Def.Color, Size = UDim2.fromOffset(10, 10), Position = UDim2.new(1, -10 - (k - 1) * 13, 1, -10), AnchorPoint = Vector2.new(1, 1), Corner = 5 })
				dot.Name = "Effect"
			end
			local btn = Instance.new("TextButton")
			btn.BackgroundTransparency = 1
			btn.Text = ""
			btn.Size = UDim2.fromScale(1, 1)
			btn.Parent = card
			btn.Activated:Connect(function()
				SFX.Play("UIClick")
				selected = entry.Uid
				showDetail(entry)
			end)
			if entry.Uid == selected then
				stillThere = entry
			end
		end
		if not stillThere then
			stillThere = list[1]
			selected = stillThere and stillThere.Uid or nil
		end
		showDetail(stillThere)
	end
end

---------------------------------------------------------------------
-- ARMOR PANEL (rare drops: defense + one bonus stat)
---------------------------------------------------------------------
local function buildArmor()
	local p = H.MakePanel("Armor", "ARMOR", Vector2.new(760, 480), C.Cyan)
	local listFrame = H.Scroller(p.Body, { Size = UDim2.new(1, -290, 1, -30) })
	H.List(listFrame, 6)
	local detail = H.Frame(p.Body, { Color = C.Row, Size = UDim2.new(0, 280, 1, -30), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Corner = 10, Stroke = 1 })
	local foot = UITheme.Label(p.Body, { Text = "", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), Color = C.Sub, MaxText = 15 })
	local selected = nil
	local lastD = nil

	local function armorEntries(d)
		local out = {}
		for uid, rec in pairs(d.Armors or {}) do
			local def = Config.ArmorById[rec.A]
			if def then
				table.insert(out, { Uid = uid, Def = def, Rarity = rarityOf(rec.R) })
			end
		end
		table.sort(out, function(a, b)
			if a.Uid == d.EquippedArmor then
				return true
			elseif b.Uid == d.EquippedArmor then
				return false
			end
			if a.Rarity.Index ~= b.Rarity.Index then
				return a.Rarity.Index > b.Rarity.Index
			end
			return a.Def.Name < b.Def.Name
		end)
		return out
	end

	local function showDetail(entry)
		H.Clear(detail)
		if not entry then
			local t = UITheme.Label(detail, { Text = "No armor yet.\n\nArmor is a rare drop from dungeon enemies, elites, bosses and the Boss Rush.", Size = UDim2.new(1, -20, 0, 160), Position = UDim2.fromOffset(10, 20), Color = C.Sub, MaxText = 17 })
			t.TextWrapped = true
			return
		end
		local def, r = entry.Def, entry.Rarity
		local swatch = H.Frame(detail, { Color = def.Color, Size = UDim2.fromOffset(84, 84), Position = UDim2.new(0.5, 0, 0, 14), AnchorPoint = Vector2.new(0.5, 0), Corner = 12, Stroke = 3 })
		local st = swatch:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = r.Color
		end
		local trim = H.Frame(swatch, { Color = def.Trim, Size = UDim2.new(1, -16, 0, 10), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 3 })
		trim.Name = "Trim"
		UITheme.Label(detail, { Text = def.Name, Title = true, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 106), Color = r.Color, MaxText = 24 })
		UITheme.Label(detail, { Text = rarityLabel(r) .. " armor", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 136), Color = C.Sub, MaxText = 15 })
		local defense = Config.ArmorDefense[math.min(r.Index, #Config.ArmorDefense)] or 0
		local info = UITheme.Label(detail, {
			Text = string.format('<font color="#8fd3ff">-%d%% damage taken</font>\n<font color="#78ff9c">%s</font>', math.floor(defense * 100 + 0.5), Config.ArmorBonusText(def.Bonus, r.Index)),
			Rich = true,
			Size = UDim2.new(1, -16, 0, 70),
			Position = UDim2.fromOffset(8, 164),
			MaxText = 17,
		})
		info.TextWrapped = true
		local equipped = lastD and lastD.EquippedArmor == entry.Uid
		UITheme.Button(detail, { Text = equipped and "UNEQUIP" or "EQUIP", Color = equipped and "Blue" or "Green", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), OnClick = function()
			request("EquipArmor", entry.Uid)
		end })
		UITheme.Button(detail, { Text = "SCRAP " .. Format.Abbrev(r.Scrap), Color = "Red", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(1, -8, 1, -8), AnchorPoint = Vector2.new(1, 1), MaxText = 18, OnClick = function()
			request("ScrapArmor", entry.Uid)
		end })
	end

	p.Refresh = function(d)
		lastD = d
		local parts = { d.EquippedArmor or "" }
		for uid, rec in pairs(d.Armors or {}) do
			table.insert(parts, uid .. rec.A .. rec.R)
		end
		table.sort(parts)
		local sig = table.concat(parts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		H.Clear(listFrame)
		local entries = armorEntries(d)
		local keep = nil
		for i, entry in ipairs(entries) do
			local r = entry.Rarity
			local row = H.Row(listFrame, 58, i)
			H.Accent(row, r.Color)
			local sw = H.Frame(row, { Color = entry.Def.Color, Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(20, 12), Corner = 6, Stroke = 2 })
			sw.Name = "Swatch"
			UITheme.Label(row, { Text = entry.Def.Name, Title = true, Size = UDim2.new(1, -150, 0, 24), Position = UDim2.fromOffset(64, 6), XAlign = Enum.TextXAlignment.Left, Color = r.Color, MaxText = 19 })
			UITheme.Label(row, { Text = rarityLabel(r) .. "  -  " .. Config.ArmorBonusText(entry.Def.Bonus, r.Index), Size = UDim2.new(1, -150, 0, 18), Position = UDim2.fromOffset(64, 32), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 14 })
			if entry.Uid == d.EquippedArmor then
				UITheme.Label(row, { Text = "WORN", Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Color = C.Green, MaxText = 16 })
			end
			local btn = Instance.new("TextButton")
			btn.BackgroundTransparency = 1
			btn.Text = ""
			btn.Size = UDim2.fromScale(1, 1)
			btn.Parent = row
			btn.Activated:Connect(function()
				SFX.Play("UIClick")
				selected = entry.Uid
				showDetail(entry)
			end)
			if entry.Uid == selected then
				keep = entry
			end
		end
		if not keep then
			keep = entries[1]
			selected = keep and keep.Uid or nil
		end
		showDetail(keep)
		foot.Text = string.format("%d / %d armor pieces  -  total defense caps at %d%%", #entries, Config.MaxArmors, math.floor(Config.Balance.DefenseCap * 100))
	end
end

function WeaponUI.Reveal(weaponId: string, rarityId: string, title: string?, effects: { [string]: number }?, equipped: boolean?)
	local def = Config.WeaponById[weaponId]
	local r = rarityOf(rarityId)
	if not def then
		return
	end
	UI.Close()
	local fly = UI.FlyGui()
	local overlay = H.Frame(fly, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 60 })
	H.Tween(overlay, 0.3, { BackgroundTransparency = 0.35 })
	local card = H.Frame(overlay, { Color = C.Bg, Size = UDim2.fromOffset(540, 440), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 22, Stroke = 5, ZIndex = 61 })
	local sc = Instance.new("UIScale")
	local cam = workspace.CurrentCamera
	sc.Scale = math.clamp(math.min(cam.ViewportSize.X / 1400, cam.ViewportSize.Y / 820), 0.55, 1.1)
	sc.Parent = card
	UITheme.Label(card, { Text = title or "OPENING...", Title = true, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 10), Color = C.Sub, ZIndex = 62, MaxText = 26 })
	local nameLabel = UITheme.Label(card, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 230), ZIndex = 62, MaxText = 48, StrokeThickness = 4 })
	local rarityText = UITheme.Label(card, { Text = "", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 290), ZIndex = 62, MaxText = 24 })
	local fxLabel = UITheme.Label(card, { Text = "", Rich = true, Size = UDim2.new(1, -40, 0, 96), Position = UDim2.fromOffset(20, 326), ZIndex = 62, MaxText = 17, StrokeThickness = 1 })
	fxLabel.TextWrapped = true
	fxLabel.TextYAlignment = Enum.TextYAlignment.Top
	local stroke = card:FindFirstChildOfClass("UIStroke")
	task.spawn(function()
		local steps = 24
		for i = 1, steps do
			local rr = Config.WeaponRarities[math.random(1, 4)]
			local pool = Config.WeaponsByRarity[rr.Id]
			local w = pool and #pool > 0 and pool[math.random(1, #pool)] or def
			nameLabel.Text = w.Name
			nameLabel.TextColor3 = rr.Color
			if stroke then
				stroke.Color = rr.Color
			end
			SFX.Play("ChestTick", { Pitch = 0.8 + i / steps })
			task.wait(0.03 + (i / steps) ^ 3 * 0.2)
		end
		nameLabel.Text = def.Name
		nameLabel.TextColor3 = r.Color
		rarityText.Text = rarityLabel(r) .. " " .. def.Class .. (def.Recipe and "  -  UNIQUE" or "")
		rarityText.TextColor3 = r.Color
		fxLabel.Text = effectRich(effects)
		if stroke then
			stroke.Color = r.Color
		end
		local cleanup = preview(card, def.Id, r.Id, UDim2.new(1, -40, 0, 180), UDim2.fromOffset(20, 48))
		for _, d in ipairs(card:GetChildren()) do
			if d:IsA("ViewportFrame") then
				d.ZIndex = 62
			end
		end
		if r.Index >= 5 then
			SFX.Play("RaceRevealLegend")
			VFX.ImpactFrame(r.Color, 1.4)
			VFX.TitleCard(def.Name:upper() .. "!", rarityLabel(r) .. " weapon", r.Color, 2.2)
		elseif r.Index >= 4 then
			SFX.Play("RaceReveal")
			VFX.ImpactFrame(r.Color, 0.9)
		else
			SFX.Play("RaceReveal", { Volume = 0.7 })
			VFX.ScreenFlash(r.Color, 0.5, 0.4)
		end
		task.wait(r.Index >= 5 and 2.6 or 1.8)
		H.Tween(overlay, 0.3, { BackgroundTransparency = 1 })
		H.Tween(sc, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.3)
		cleanup()
		overlay:Destroy()
		UI.Notify("Forged " .. rarityLabel(r) .. " " .. def.Name .. (equipped and " - equipped!" or "! Equip it from Weapons."), r.Color)
	end)
end

---------------------------------------------------------------------
-- POWER PANEL (3^n Robux -> 2^n damage)
---------------------------------------------------------------------
local function buildPower()
	local p = H.MakePanel("Power", "2x POWER", Vector2.new(560, 430), C.Red)
	local box = H.Row(p.Body, 250, 0, Color3.fromRGB(50, 24, 34))
	local cur = UITheme.Label(box, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 12), Color = C.Gold, MaxText = 42 })
	local nxt = UITheme.Label(box, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 70), Color = Color3.fromRGB(120, 255, 170), MaxText = 34 })
	local price = UITheme.Label(box, { Text = "", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 118), MaxText = 24 })
	local note = UITheme.Label(box, { Text = "Each tier doubles ALL your damage (applied after the gameplay damage cap). Tiers cost 3, 9, 27, 81... Robux.", Size = UDim2.new(1, -20, 0, 80), Position = UDim2.fromOffset(10, 158), Color = C.Sub, MaxText = 16 })
	note.TextWrapped = true
	local buy = UITheme.Button(p.Body, { Text = "BUY", Color = "Red", Size = UDim2.fromOffset(300, 74), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1), MaxText = 30, Sound = "Purchase", OnClick = function()
		request("BuyPower")
	end })
	p.Refresh = function(d)
		local n = d.PowerTier or 0
		cur.Text = "Current: x" .. Format.Abbrev(Config.PowerTierMult(n)) .. " Power"
		if Config.PowerTiers[n + 1] then
			nxt.Text = "Next: x" .. Format.Abbrev(Config.PowerTierMult(n + 1))
			price.Text = "Tier " .. (n + 1) .. " price: " .. Format.Commas(Config.PowerTierPrice(n + 1)) .. " Robux"
			UITheme.SetButtonText(buy, "BUY x2  (R$ " .. Format.Commas(Config.PowerTierPrice(n + 1)) .. ")")
		else
			nxt.Text = "MAX TIER REACHED"
			price.Text = ""
			UITheme.SetButtonText(buy, "MAXED")
		end
	end
end

---------------------------------------------------------------------
-- REWARDS PANEL (play-time ladder + streak)
---------------------------------------------------------------------
local function buildRewards()
	local p = H.MakePanel("Rewards", "PLAY-TIME REWARDS", Vector2.new(620, 470), C.Green)
	local holder = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 1, -70) })
	H.List(holder, 8)
	local rows = {}
	for i, reward in ipairs(Config.PlaytimeRewards) do
		local r = H.Row(holder, 56, i)
		UITheme.Label(r, { Text = reward.Minutes .. " min", Title = true, Size = UDim2.fromOffset(90, 40), Position = UDim2.fromOffset(10, 8), Color = C.Gold, MaxText = 24 })
		UITheme.Label(r, { Text = reward.Name, Size = UDim2.new(1, -250, 0, 40), Position = UDim2.fromOffset(104, 8), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
		rows[i] = UITheme.Label(r, { Text = "", Title = true, Size = UDim2.fromOffset(130, 40), Position = UDim2.new(1, -10, 0, 8), AnchorPoint = Vector2.new(1, 0), MaxText = 20 })
	end
	local foot = UITheme.Label(p.Body, { Text = "", Rich = true, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), MaxText = 16 })
	foot.TextWrapped = true
	p.Refresh = function(d)
		local session = player:GetAttribute("SessionTime") or 0
		for i, reward in ipairs(Config.PlaytimeRewards) do
			local claimed = d.PlaytimeClaimed and d.PlaytimeClaimed[i]
			if claimed then
				rows[i].Text = "CLAIMED"
				rows[i].TextColor3 = C.Green
			else
				rows[i].Text = Format.Time(reward.Minutes * 60 - session)
				rows[i].TextColor3 = C.Text
			end
		end
		foot.Text = string.format('Daily streak: <font color="#8fd3ff">%d day(s)</font> (log in every day for bigger bonuses)   Total play time: <font color="#ffd75a">%s</font>', d.Streak or 0, Format.Time(d.TotalPlaytime or 0))
	end
end

function WeaponUI.Tick()
	local panel = UI.Panel("Rewards")
	if panel and panel.Frame.Visible and UI.Data and panel.Refresh then
		panel.Refresh(UI.Data)
	end
end

function WeaponUI.Init(ui, requestFn)
	UI = ui
	H = UI.Helpers
	request = requestFn
	buildWeapons()
	buildArmor()
	buildPower()
	buildRewards()
end

return WeaponUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">WorldMap</string>
            <string name="Source"><![CDATA[--!nonstrict
-- WorldMap (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/WorldMap
-- Full-screen stylized world map (M / D-pad right / drawer "Map").
--   * Look: dark holographic grid + topo contour lines + glowing region
--     outlines, a slow scanline shimmer and soft vignette.
--   * Layered depth: stars, grid, contours, terrain and two cloud layers
--     sit at different depths, so dragging the map gives subtle parallax.
--   * Fog of war: regions you have not walked into yet are hidden under
--     drifting cloud banks that dissolve the moment you explore them
--     (saved per player via the "Explore" request).
--   * Minimal waypoints: small colour-coded geometric symbols
--     (diamond = service, square = power, ring = travel, red diamond =
--     danger) that expand into a detailed callout on
--     hover / tap, with Track (world marker) and Travel buttons.
-- Controls: drag / WASD / left stick to pan, wheel / pinch / Q-E / LB-RB to
-- zoom, M to close. Layout: the lobby - spawn plaza in the middle, the
-- Dungeon Gate to the north, Training Grounds west, Boss Rush east. Dungeon
-- runs are private and far away, so they show up at the gate.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local SFX = require(Shared:WaitForChild("SFX"))

local WorldMap = {}
WorldMap.IsOpen = false

local player = Players.LocalPlayer
local UI
local request: (string, any?) -> () = function() end
local data = nil

---------------------------------------------------------------------
-- LAYOUT (map units; 1 unit = 1 px at zoom 1)
---------------------------------------------------------------------
local OW = 2 -- map units per stud in the lobby
local W = Config.World
local GATE_MAP = Vector2.new(W.DungeonGate.X * OW, W.DungeonGate.Z * OW)
local BOUNDS_MIN = Vector2.new(-700, GATE_MAP.Y - 200)
local BOUNDS_MAX = Vector2.new(700, 320)
local TRAIN_MAP = Vector2.new(W.TrainCenter.X * OW, W.TrainCenter.Z * OW)
local RUSH_MAP = Vector2.new(W.BossRushCenter.X * OW, W.BossRushCenter.Z * OW)

local COL = {
	Bg = Color3.fromRGB(5, 8, 17),
	Grid = Color3.fromRGB(0, 190, 255),
	Land = Color3.fromRGB(16, 26, 48),
	Land2 = Color3.fromRGB(24, 38, 68),
	Edge = Color3.fromRGB(90, 205, 255),
	Text = Color3.fromRGB(210, 235, 255),
	Fog = Color3.fromRGB(150, 170, 205),
	Service = Color3.fromRGB(255, 205, 80),
	Power = Color3.fromRGB(190, 130, 255),
	Travel = Color3.fromRGB(80, 225, 255),
	Danger = Color3.fromRGB(255, 70, 90),
	Stage = Color3.fromRGB(150, 255, 170),
	Locked = Color3.fromRGB(120, 125, 145),
	Player = Color3.new(1, 1, 1),
}
local KIND_LABEL = { Service = "SERVICE", Power = "POWER", Travel = "TRAVEL", Danger = "BOSS", Stage = "STAGE" }

local gui: ScreenGui
local viewport: Frame
local overlay: Frame
local cover: Frame
local callout: CanvasGroup
local CO: { [string]: any } = {} -- callout parts: Title, Kind, Desc, Status, Track, TrackLabel, Travel, Accent, Icon
local layers: { [string]: any } = {} -- [name] = { Frame, Scale, F }
local regions = {} -- [key] = { Rect, Fog = { Frame... }, Explored, Label }
local icons = {} -- list of icon records
local explored = {} -- [key] = true (local mirror)
local pan = Vector2.zero
local zoom = 1
local velocity = Vector2.zero
local dragging = false
local dragLast: Vector2? = nil
local dragTime = 0
local keyPan = Vector2.zero
local stick = Vector2.zero
local pinchStart = 1
local hovered = nil
local selected = nil
local playerMarker: Frame
local trackedMarker: Frame
local tracked = nil -- { Pos, Name, Map }
local worldMarker: BillboardGui? = nil
local worldAnchor: Attachment? = nil
local fogTime = 0
local exploreTimer = 0
local scanGrad: UIGradient

---------------------------------------------------------------------
-- small builders
---------------------------------------------------------------------
local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function frame(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, transparency: number): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.Parent = parent
	return f
end

local function corner(f: GuiObject, r: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = f
end

local function stroke(f: GuiObject, color: Color3, thickness: number, transparency: number)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency
	s.Parent = f
	return s
end

local function circle(parent: Instance, cx: number, cy: number, r: number, color: Color3, transparency: number): Frame
	local f = frame(parent, cx - r, cy - r, r * 2, r * 2, color, transparency)
	corner(f, UDim.new(0.5, 0))
	return f
end

local function dotted(parent: Instance, a: Vector2, b: Vector2, spacing: number, size: number, color: Color3, transparency: number)
	local d = b - a
	local n = math.floor(d.Magnitude / spacing)
	for i = 0, n do
		local p = a + d * (i / math.max(1, n))
		local dot = frame(parent, p.X - size / 2, p.Y - size / 2, size, size, color, transparency)
		corner(dot, UDim.new(0.5, 0))
	end
end

local function text(parent: Instance, x: number, y: number, str: string, size: number, color: Color3, font: Enum.Font?, anchor: Vector2?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.AutomaticSize = Enum.AutomaticSize.XY
	t.Size = UDim2.fromOffset(0, 0)
	t.Position = UDim2.fromOffset(x, y)
	t.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
	t.Font = font or Config.Fonts.Heading
	t.TextSize = size
	t.Text = str
	t.TextColor3 = color
	t.Parent = parent
	local s = Instance.new("UIStroke")
	s.Thickness = 1
	s.Color = Color3.fromRGB(0, 0, 0)
	s.Transparency = 0.5
	s.Parent = t
	return t
end

---------------------------------------------------------------------
-- COORDINATES
---------------------------------------------------------------------
local function worldToMap(pos: Vector3): Vector2
	if pos.X > 2000 then
		-- private Boss Rush arenas live far away; show them at the island
		return RUSH_MAP
	elseif pos.X < -2000 then
		-- private dungeon runs live far below; show them at the gate
		return GATE_MAP
	end
	return Vector2.new(pos.X * OW, pos.Z * OW)
end

---------------------------------------------------------------------
-- FOG OF WAR
---------------------------------------------------------------------
local fogRng = Random.new(42)

-- Soft cloud puff: two stacked circles (a pale core inside a softer rim).
local function puff(parent: Instance, cx: number, cy: number, r: number)
	local holder = frame(parent, cx, cy, 0, 0, COL.Fog, 1)
	for k, mul in ipairs({ 1, 0.6 }) do
		local c = circle(holder, 0, 0, r * mul, COL.Fog:Lerp(Color3.new(1, 1, 1), (k - 1) * 0.15), 0.62 - (k - 1) * 0.08)
		c.Name = "Puff"
	end
	return holder
end

local function addFog(key: string, rect, label: string?, permanent: boolean?)
	local x, y, w, h = rect[1], rect[2], rect[3], rect[4]
	local banks = {}
	for li, layerName in ipairs({ "FogLow", "FogHigh" }) do
		local layer = layers[layerName].Frame
		local bank = frame(layer, 0, 0, 0, 0, COL.Fog, 1)
		bank.Name = "Fog_" .. key
		local step = li == 1 and 34 or 50
		local pad = li == 1 and 10 or 22
		local yy = y - pad
		while yy <= y + h + pad do
			local xx = x - pad
			while xx <= x + w + pad do
				local r = fogRng:NextNumber(26, 44) * (li == 1 and 1 or 0.85)
				puff(bank, xx + fogRng:NextNumber(-8, 8), yy + fogRng:NextNumber(-8, 8), r)
				xx += step
			end
			yy += step
		end
		table.insert(banks, { Frame = bank, Phase = fogRng:NextNumber(0, 6.28), Layer = li })
	end
	local lbl = nil
	if label then
		lbl = text(layers.FogHigh.Frame, x + w / 2, y + h / 2, label, 13, Color3.fromRGB(235, 240, 255), Config.Fonts.Heading)
		lbl.TextTransparency = 0.15
		lbl.ZIndex = 5
	end
	regions[key] = { Rect = rect, Fog = banks, Label = lbl, Explored = false, Permanent = permanent }
end

local function dissolve(key: string, instant: boolean?)
	local r = regions[key]
	if not r or r.Explored or r.Permanent then
		return
	end
	r.Explored = true
	for _, bank in ipairs(r.Fog) do
		for _, d in ipairs(bank.Frame:GetDescendants()) do
			if d:IsA("Frame") and d.Name == "Puff" then
				if instant then
					d.BackgroundTransparency = 1
				else
					tween(d, 1.6 + math.random() * 0.8, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
				end
			end
		end
	end
	if r.Label then
		if instant then
			r.Label.Visible = false
		else
			tween(r.Label, 0.8, { TextTransparency = 1 })
		end
	end
end

local function isExplored(region: string?): boolean
	if not region or region == "Hub" then
		return true
	end
	return explored[region] == true
end

---------------------------------------------------------------------
-- STATIC ART
---------------------------------------------------------------------
local function drawBackground()
	-- deep star field (farthest layer)
	local stars = layers.Stars.Frame
	local rng = Random.new(7)
	for _ = 1, 140 do
		local s = rng:NextNumber(1.5, 4)
		local d = circle(stars, rng:NextNumber(-3200, 3200), rng:NextNumber(-3800, 2400), s, Color3.fromRGB(150, 200, 255), rng:NextNumber(0.35, 0.85))
		d.Name = "Star"
	end
	-- holographic grid
	local grid = layers.Grid.Frame
	for i = -36, 36 do
		local major = i % 4 == 0
		local v = frame(grid, i * 100, -3600, major and 2 or 1, 7200, COL.Grid, major and 0.82 or 0.92)
		v.AnchorPoint = Vector2.new(0.5, 0)
		local h = frame(grid, -3600, i * 100, 7200, major and 2 or 1, COL.Grid, major and 0.82 or 0.92)
		h.AnchorPoint = Vector2.new(0, 0.5)
	end
	-- topo contour rings (blueprint flavour)
	local topo = layers.Topo.Frame
	local function rings(cx, cy, from, to, stepR, t)
		for r = from, to, stepR do
			local c = circle(topo, cx, cy, r, COL.Edge, 1)
			stroke(c, COL.Edge, 1, t + (r - from) / (to - from + 1) * 0.08)
		end
	end
	rings(0, 0, 170, 560, 46, 0.84)
	rings(TRAIN_MAP.X, TRAIN_MAP.Y, 120, 260, 45, 0.88)
	rings(RUSH_MAP.X, RUSH_MAP.Y, 120, 260, 45, 0.88)
	rings(GATE_MAP.X, GATE_MAP.Y, 90, 220, 45, 0.88)
end

local function region(parent, rect, fill: Color3, edge: Color3, r: number?)
	local f = frame(parent, rect[1], rect[2], rect[3], rect[4], fill, 0.15)
	corner(f, UDim.new(0, r or 8))
	stroke(f, edge, 1.5, 0.35)
	return f
end

local function drawWorld()
	local w = layers.World.Frame
	local path = Color3.fromRGB(40, 60, 100)

	-- spawn plaza
	local plaza = circle(w, 0, 0, W.PlazaRadius * OW, COL.Land, 0.1)
	stroke(plaza, COL.Edge, 1.5, 0.3)
	local core = circle(w, 0, 0, 22 * OW, COL.Land2, 0.1)
	stroke(core, Color3.fromRGB(255, 140, 60), 1, 0.45)
	text(w, 0, W.PlazaRadius * OW + 18, "SPAWN", 13, COL.Text, Config.Fonts.Display).TextTransparency = 0.2

	-- bridges: plaza -> training (west), boss rush (east), dungeon gate (north)
	frame(w, TRAIN_MAP.X + 60 * OW, -6 * OW, (-W.PlazaRadius * OW) - (TRAIN_MAP.X + 60 * OW), 12 * OW, path, 0.2)
	frame(w, W.PlazaRadius * OW, -6 * OW, RUSH_MAP.X - 50 * OW - W.PlazaRadius * OW, 12 * OW, path, 0.2)
	frame(w, -11 * OW, GATE_MAP.Y + 24 * OW, 22 * OW, -W.PlazaRadius * OW - GATE_MAP.Y - 24 * OW, path, 0.2)

	-- training grounds
	local train = { TRAIN_MAP.X - 60 * OW, TRAIN_MAP.Y - 50 * OW, 120 * OW, 100 * OW }
	region(w, train, COL.Land, Color3.fromRGB(150, 255, 190), 20)
	for _, part in ipairs(CollectionService:GetTagged("TrainPad")) do
		if part:IsA("BasePart") then
			local m = worldToMap(part.Position)
			local c = circle(w, m.X, m.Y, Config.TrainPadRadius * OW * 0.8, part.Color, 0.55)
			stroke(c, part.Color, 1, 0.2)
		end
	end
	text(w, TRAIN_MAP.X, train[2] + train[4] + 16, "TRAINING GROUNDS", 12, COL.Text, Config.Fonts.Display).TextTransparency = 0.25

	-- boss rush island
	local rush = circle(w, RUSH_MAP.X, RUSH_MAP.Y, 46 * OW, COL.Land2, 0.1)
	stroke(rush, COL.Danger, 1.5, 0.3)
	text(w, RUSH_MAP.X, RUSH_MAP.Y + 46 * OW + 16, "BOSS RUSH", 12, COL.Text, Config.Fonts.Display).TextTransparency = 0.25

	-- the dungeon gate
	local gate = circle(w, GATE_MAP.X, GATE_MAP.Y, 28 * OW, COL.Land2, 0.1)
	stroke(gate, Color3.fromRGB(170, 110, 255), 2, 0.2)
	local portal = frame(w, GATE_MAP.X - 11 * OW, GATE_MAP.Y - 6 * OW, 22 * OW, 3 * OW, Color3.fromRGB(170, 110, 255), 0.2)
	portal.Name = "Portal"
	text(w, GATE_MAP.X, GATE_MAP.Y - 28 * OW - 16, "THE DUNGEON", 13, Color3.fromRGB(220, 190, 255), Config.Fonts.Display).TextTransparency = 0.15
	dotted(w, Vector2.new(0, 0), GATE_MAP, 22, 3, COL.Edge, 0.6)

	-- fog over everything that can be explored
	addFog("Train", { train[1] - 20, train[2] - 30, train[3] + 40, train[4] + 70 }, "UNCHARTED")
	addFog("BossRush", { RUSH_MAP.X - 110, RUSH_MAP.Y - 110, 220, 250 }, "UNCHARTED")
end

---------------------------------------------------------------------
-- ICONS + CALLOUT
---------------------------------------------------------------------
local function dungeonStatus(): (boolean, string)
	if not data then
		return true, ""
	end
	if data.Run then
		return true, "In a run: floor " .. data.Run.Floor
	end
	return true, "Deepest floor: " .. (data.BestFloor or 0)
end

local function shapeFor(kind: string, color: Color3, parent: Instance)
	local holder = Instance.new("Frame")
	holder.Name = "Shape"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(18, 18)
	holder.Parent = parent
	local sc = Instance.new("UIScale")
	sc.Parent = holder
	local main
	if kind == "Service" then
		main = frame(holder, 3, 3, 12, 12, color, 0)
		main.Rotation = 45
		stroke(main, Color3.new(1, 1, 1), 1, 0.4)
	elseif kind == "Power" then
		main = frame(holder, 4, 4, 10, 10, color, 0)
		corner(main, UDim.new(0, 2))
		stroke(main, Color3.new(1, 1, 1), 1, 0.4)
	elseif kind == "Travel" then
		main = frame(holder, 2, 2, 14, 14, color, 1)
		corner(main, UDim.new(0.5, 0))
		stroke(main, color, 2, 0)
		local dot = frame(holder, 7, 7, 4, 4, color, 0)
		corner(dot, UDim.new(0.5, 0))
	elseif kind == "Danger" then
		main = frame(holder, 2, 2, 14, 14, color, 0.7)
		main.Rotation = 45
		stroke(main, color, 2, 0)
		local dot = frame(holder, 7, 7, 4, 4, Color3.new(1, 1, 1), 0)
		dot.Rotation = 45
	else -- Stage
		main = frame(holder, 3, 3, 12, 12, color, 0.85)
		corner(main, UDim.new(0, 2))
		stroke(main, color, 1.5, 0)
	end
	main.Name = "Main"
	return holder, sc
end

local hideCallout

local function showCallout(icon)
	CO.Title.Text = icon.Name
	CO.Kind.Text = KIND_LABEL[icon.Kind] or string.upper(icon.Kind)
	CO.Kind.TextColor3 = icon.Color
	CO.Desc.Text = icon.Desc or ""
	local statusText, statusColor = "", COL.Text
	if icon.Region == "Dungeon" then
		local ok, st = dungeonStatus()
		statusText, statusColor = st, ok and Color3.fromRGB(200, 170, 255) or Color3.fromRGB(255, 120, 120)
	elseif icon.WorldPos then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			statusText = math.floor((root.Position - icon.WorldPos).Magnitude) .. " studs away"
		end
	end
	CO.Status.Text = statusText
	CO.Status.TextColor3 = statusColor
	CO.Travel.Visible = icon.Travel ~= nil
	CO.Track.Visible = icon.WorldPos ~= nil
	CO.TrackLabel.Text = (tracked and tracked.Icon == icon) and "UNTRACK" or "TRACK"
	CO.Accent.BackgroundColor3 = icon.Color
	local wasHidden = not callout.Visible or CO.Icon == nil
	callout.Visible = true
	CO.Icon = icon
	if wasHidden then
		CO.Scale.Scale = 0.92
		tween(CO.Scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Quart)
	end
	tween(callout, 0.15, { GroupTransparency = 0 })
end

hideCallout = function()
	if callout.Visible then
		tween(callout, 0.12, { GroupTransparency = 1 }).Completed:Once(function()
			if not (hovered or selected) then
				callout.Visible = false
				CO.Icon = nil
			end
		end)
	end
end

local function setEmphasis(icon, on: boolean)
	if icon then
		tween(icon.Scale, 0.16, { Scale = on and 1.45 or 1 }, Enum.EasingStyle.Back)
	end
end

local function addIcon(opts)
	local b = Instance.new("TextButton")
	b.Name = "Icon_" .. opts.Name
	b.AutoButtonColor = false
	b.Text = ""
	b.BackgroundTransparency = 1
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Size = UDim2.fromOffset(28, 28)
	b.ZIndex = 4
	b.Parent = overlay
	local shape, sc = shapeFor(opts.Kind, opts.Color, b)
	local icon = {
		Button = b,
		Shape = shape,
		Scale = sc,
		Map = opts.Map,
		Kind = opts.Kind,
		Name = opts.Name,
		Desc = opts.Desc,
		Region = opts.Region,
		Travel = opts.Travel,
		WorldPos = opts.WorldPos,
		Color = opts.Color,
		Stage = opts.Stage,
	}
	b.MouseEnter:Connect(function()
		hovered = icon
		setEmphasis(icon, true)
		showCallout(icon)
		SFX.Play("UIHover")
	end)
	b.MouseLeave:Connect(function()
		if hovered == icon then
			hovered = nil
		end
		if selected ~= icon then
			setEmphasis(icon, false)
		end
		if selected then
			showCallout(selected)
		else
			hideCallout()
		end
	end)
	b.Activated:Connect(function()
		SFX.Play("UIClick")
		if selected == icon then
			selected = nil
			setEmphasis(icon, false)
			hideCallout()
		else
			if selected then
				setEmphasis(selected, false)
			end
			selected = icon
			setEmphasis(icon, true)
			showCallout(icon)
		end
	end)
	table.insert(icons, icon)
	return icon
end

local function recolorStages()
	-- (kept for the Update hook; lobby icons have fixed colours)
end

local function buildIcons()
	-- landmarks tagged by the server (MapBuilder.poi)
	local function fromPoi(part: Instance)
		if not part:IsA("BasePart") then
			return
		end
		local kind = part:GetAttribute("POIKind")
		if not kind then
			return
		end
		addIcon({
			Name = part:GetAttribute("POIName") or part.Name,
			Kind = kind,
			Desc = part:GetAttribute("POIDesc"),
			Region = part:GetAttribute("Region"),
			Travel = part:GetAttribute("Travel"),
			WorldPos = part.Position,
			Map = worldToMap(part.Position),
			Color = COL[kind] or COL.Edge,
		})
	end
	for _, part in ipairs(CollectionService:GetTagged("POI")) do
		fromPoi(part)
	end
	CollectionService:GetInstanceAddedSignal("POI"):Connect(fromPoi)
	recolorStages()
end

local function buildCallout(parent: Instance)
	local c = Instance.new("CanvasGroup")
	c.Name = "Callout"
	c.BackgroundColor3 = Color3.fromRGB(8, 12, 24)
	c.BackgroundTransparency = 0.12
	c.GroupTransparency = 1
	c.Visible = false
	c.Size = UDim2.fromOffset(236, 132)
	c.ZIndex = 20
	c.Parent = parent
	corner(c, UDim.new(0, 10))
	stroke(c, COL.Edge, 1, 0.55)
	local sc = Instance.new("UIScale")
	sc.Parent = c
	CO.Scale = sc
	local accent = frame(c, 0, 0, 3, 132, COL.Edge, 0)
	accent.Name = "Accent"
	accent.Size = UDim2.new(0, 3, 1, 0)
	CO.Accent = accent
	local function lbl(name, y, h, font, color, size)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromOffset(14, y)
		t.Size = UDim2.new(1, -24, 0, h)
		t.Font = font
		t.TextSize = size
		t.TextWrapped = true
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextYAlignment = Enum.TextYAlignment.Top
		t.TextColor3 = color
		t.ZIndex = 21
		t.Parent = c
		return t
	end
	CO.Kind = lbl("Kind", 9, 12, Config.Fonts.Heading, COL.Edge, 11)
	CO.Title = lbl("Title", 22, 20, Config.Fonts.Display, Color3.new(1, 1, 1), 17)
	CO.Desc = lbl("Desc", 44, 32, Config.Fonts.Body, COL.Text, 13)
	CO.Status = lbl("Status", 76, 14, Config.Fonts.Heading, COL.Text, 12)
	local function btn(name, label, x, color, onClick)
		local b = Instance.new("TextButton")
		b.Name = name
		b.AutoButtonColor = false
		b.Text = ""
		b.Position = UDim2.fromOffset(x, 98)
		b.Size = UDim2.fromOffset(100, 24)
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.8
		b.ZIndex = 22
		b.Parent = c
		corner(b, UDim.new(0, 6))
		local st = stroke(b, color, 1, 0.3)
		local t = Instance.new("TextLabel")
		t.Name = "Label"
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Config.Fonts.Heading
		t.TextSize = 12
		t.Text = label
		t.TextColor3 = Color3.new(1, 1, 1)
		t.ZIndex = 23
		t.Parent = b
		b.MouseEnter:Connect(function()
			tween(b, 0.1, { BackgroundTransparency = 0.55 })
			tween(st, 0.1, { Transparency = 0 })
		end)
		b.MouseLeave:Connect(function()
			tween(b, 0.1, { BackgroundTransparency = 0.8 })
			tween(st, 0.1, { Transparency = 0.3 })
		end)
		b.Activated:Connect(function()
			SFX.Play("UIClick")
			onClick()
		end)
		return b, t
	end
	CO.Track, CO.TrackLabel = btn("Track", "TRACK", 14, COL.Edge, function()
		local icon = CO.Icon
		if icon then
			WorldMap.Track(if tracked and tracked.Icon == icon then nil else icon)
			showCallout(icon)
		end
	end)
	CO.Travel = btn("Travel", "TRAVEL", 122, COL.Service, function()
		local icon = CO.Icon
		if icon and icon.Travel then
			request("Teleport", icon.Travel)
			WorldMap.Close()
		end
	end)
	return c
end

---------------------------------------------------------------------
-- TRACKING (optional world marker; nothing shows until you pick a target)
---------------------------------------------------------------------
function WorldMap.Track(icon)
	if worldMarker then
		worldMarker:Destroy()
		worldMarker = nil
	end
	if worldAnchor then
		worldAnchor:Destroy()
		worldAnchor = nil
	end
	tracked = nil
	trackedMarker.Visible = false
	if not icon or not icon.WorldPos then
		return
	end
	tracked = { Icon = icon, Pos = icon.WorldPos, Map = icon.Map }
	trackedMarker.Visible = true
	local a = Instance.new("Attachment")
	a.WorldPosition = icon.WorldPos + Vector3.new(0, 6, 0)
	a.Parent = workspace.Terrain
	worldAnchor = a
	local bb = Instance.new("BillboardGui")
	bb.Name = "TrackedWaypoint"
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(120, 34)
	bb.Adornee = a
	bb.ResetOnSpawn = false
	bb.Parent = player:WaitForChild("PlayerGui")
	local d = frame(bb, 54, 2, 10, 10, icon.Color, 0.1)
	d.Rotation = 45
	stroke(d, Color3.new(1, 1, 1), 1, 0.3)
	local t = Instance.new("TextLabel")
	t.Name = "Dist"
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromOffset(0, 16)
	t.Size = UDim2.new(1, 0, 0, 14)
	t.Font = Config.Fonts.Heading
	t.TextSize = 12
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = ""
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 1
	st.Transparency = 0.5
	st.Parent = t
	worldMarker = bb
	SFX.Play("PromptTrigger")
end

---------------------------------------------------------------------
-- VIEW
---------------------------------------------------------------------
local function clampPan()
	pan = Vector2.new(math.clamp(pan.X, BOUNDS_MIN.X, BOUNDS_MAX.X), math.clamp(pan.Y, BOUNDS_MIN.Y, BOUNDS_MAX.Y))
end

local function toScreen(m: Vector2): Vector2
	local size = viewport.AbsoluteSize
	return size / 2 + (m - pan) * zoom
end

local function layout()
	for _, layer in pairs(layers) do
		layer.Frame.Position = UDim2.new(0.5, -pan.X * zoom * layer.F, 0.5, -pan.Y * zoom * layer.F)
		layer.Scale.Scale = zoom * layer.F
	end
	for _, icon in ipairs(icons) do
		local p = toScreen(icon.Map)
		icon.Button.Position = UDim2.fromOffset(p.X, p.Y)
		local visible = isExplored(icon.Region)
		icon.Button.Visible = visible
	end
	if tracked then
		local p = toScreen(tracked.Map)
		trackedMarker.Position = UDim2.fromOffset(p.X, p.Y)
	end
	local c = callout
	if c.Visible and CO.Icon then
		local p = toScreen(CO.Icon.Map)
		local size = viewport.AbsoluteSize
		local x = p.X + 20
		if x + c.AbsoluteSize.X > size.X - 10 then
			x = p.X - 20 - c.AbsoluteSize.X
		end
		local y = math.clamp(p.Y - 30, 70, size.Y - c.AbsoluteSize.Y - 10)
		c.Position = UDim2.fromOffset(x, y)
	end
end

local function setZoom(z: number, around: Vector2?)
	z = math.clamp(z, 0.45, 2.4)
	if around then
		local size = viewport.AbsoluteSize
		local m = pan + (around - size / 2) / zoom
		zoom = z
		pan = m - (around - size / 2) / zoom
	else
		zoom = z
	end
	clampPan()
end

local function centerOnPlayer()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		pan = worldToMap(root.Position)
		clampPan()
	end
end

---------------------------------------------------------------------
-- INPUT (bound only while the map is open)
---------------------------------------------------------------------
local held = {}
local PAN_KEYS = {
	[Enum.KeyCode.W] = Vector2.new(0, -1),
	[Enum.KeyCode.Up] = Vector2.new(0, -1),
	[Enum.KeyCode.S] = Vector2.new(0, 1),
	[Enum.KeyCode.Down] = Vector2.new(0, 1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
}

local function onMapInput(_, state, input)
	local key = input.KeyCode
	if PAN_KEYS[key] then
		if state == Enum.UserInputState.Begin then
			held[key] = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			held[key] = nil
		end
	elseif key == Enum.KeyCode.Thumbstick1 then
		local v = Vector2.new(input.Position.X, -input.Position.Y)
		stick = v.Magnitude > 0.15 and v or Vector2.zero
	elseif state == Enum.UserInputState.Begin then
		if key == Enum.KeyCode.E or key == Enum.KeyCode.ButtonR1 then
			setZoom(zoom * 1.25)
		elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.ButtonL1 then
			setZoom(zoom / 1.25)
		elseif key == Enum.KeyCode.ButtonB then
			WorldMap.Close()
		end
	end
	return Enum.ContextActionResult.Sink
end

local SINK = {
	Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
	Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right,
	Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.R, Enum.KeyCode.C, Enum.KeyCode.F, Enum.KeyCode.H,
	Enum.KeyCode.Space, Enum.KeyCode.LeftShift,
	Enum.KeyCode.Thumbstick1, Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonB,
	Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonY, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonR2,
	Enum.KeyCode.ButtonL3, Enum.KeyCode.DPadUp,
	Enum.UserInputType.MouseButton1,
}

---------------------------------------------------------------------
-- OPEN / CLOSE
---------------------------------------------------------------------
function WorldMap.Open()
	if WorldMap.IsOpen then
		return
	end
	WorldMap.IsOpen = true
	if UI then
		UI.Close()
		UI.ToggleDrawer(false)
		UI.SetMenuFocus(true)
	end
	held = {}
	stick = Vector2.zero
	velocity = Vector2.zero
	centerOnPlayer()
	gui.Enabled = true
	cover.BackgroundTransparency = 0
	tween(cover, 0.45, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
	zoom = 0.7
	local tw = Instance.new("NumberValue")
	tw.Value = 0.7
	tw.Changed:Connect(function(v)
		zoom = v
	end)
	tween(tw, 0.55, { Value = 1 }, Enum.EasingStyle.Quart).Completed:Once(function()
		tw:Destroy()
	end)
	layout()
	ContextActionService:BindActionAtPriority("WorldMapInput", onMapInput, false, 3000, table.unpack(SINK))
	SFX.Play("UIOpen")
end

function WorldMap.Close()
	if not WorldMap.IsOpen then
		return
	end
	WorldMap.IsOpen = false
	ContextActionService:UnbindAction("WorldMapInput")
	if UI then
		UI.SetMenuFocus(false)
	end
	if selected then
		setEmphasis(selected, false)
	end
	selected, hovered = nil, nil
	callout.Visible = false
	callout.GroupTransparency = 1
	CO.Icon = nil
	tween(cover, 0.2, { BackgroundTransparency = 0 }).Completed:Once(function()
		if not WorldMap.IsOpen then
			gui.Enabled = false
		end
	end)
	SFX.Play("UIClose")
end

function WorldMap.Toggle()
	if WorldMap.IsOpen then
		WorldMap.Close()
	else
		WorldMap.Open()
	end
end

---------------------------------------------------------------------
-- EXPLORATION
---------------------------------------------------------------------
local function markExplored(key: string, announce: boolean)
	if explored[key] then
		return
	end
	explored[key] = true
	dissolve(key, not announce)
	if announce then
		request("Explore", key)
		if UI then
			local r = regions[key]
			local name = key
			if key == "Dungeon" then
				name = "The Dungeon"
			elseif key == "Train" then
				name = "Training Grounds"
			elseif key == "BossRush" then
				name = "Boss Rush"
			end
			if r then
				UI.Notify("Map updated: " .. name, Color3.fromRGB(120, 220, 255))
			end
		end
	end
end

local function currentRegions(pos: Vector3): { string }
	local out = {}
	if pos.X < -2000 or (Vector3.new(pos.X, 0, pos.Z) - W.DungeonGate).Magnitude < 40 then
		table.insert(out, "Dungeon")
		return out
	end
	if pos.X > 2000 or (Vector3.new(pos.X, 0, pos.Z) - W.BossRushCenter).Magnitude < 70 then
		table.insert(out, "BossRush")
	elseif (Vector3.new(pos.X, 0, pos.Z) - W.TrainCenter).Magnitude < 90 then
		table.insert(out, "Train")
	end
	return out
end

---------------------------------------------------------------------
-- PER-FRAME
---------------------------------------------------------------------
function WorldMap.Step(dt: number)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	exploreTimer -= dt
	if exploreTimer <= 0 and root and data then
		exploreTimer = 0.5
		for _, key in ipairs(currentRegions(root.Position)) do
			markExplored(key, true)
		end
	end

	-- tracked waypoint distance / arrival
	if tracked and worldMarker and root then
		local dist = (root.Position - tracked.Pos).Magnitude
		local label = worldMarker:FindFirstChild("Dist")
		if label then
			(label :: TextLabel).Text = math.floor(dist) .. " studs"
		end
		if dist < 14 then
			SFX.Play("Discover")
			if UI then
				UI.Notify("Arrived: " .. tracked.Icon.Name, Color3.fromRGB(120, 220, 255))
			end
			WorldMap.Track(nil)
		end
	end

	if not WorldMap.IsOpen then
		return
	end

	-- pan: keys / stick / inertia
	keyPan = Vector2.zero
	for key in pairs(held) do
		keyPan += PAN_KEYS[key] or Vector2.zero
	end
	local input = keyPan + stick
	if input.Magnitude > 0 then
		pan += input.Unit * math.min(1, input.Magnitude) * 620 * dt / zoom
		velocity = Vector2.zero
	elseif not dragging and velocity.Magnitude > 1 then
		pan += velocity * dt
		velocity *= math.max(0, 1 - dt * 6)
	end
	clampPan()

	-- drifting clouds + holo shimmer
	fogTime += dt
	for _, r in pairs(regions) do
		for _, bank in ipairs(r.Fog) do
			local amp = bank.Layer == 1 and 5 or 9
			bank.Frame.Position = UDim2.fromOffset(math.sin(fogTime * 0.25 + bank.Phase) * amp, math.cos(fogTime * 0.18 + bank.Phase) * amp * 0.6)
		end
	end
	scanGrad.Offset = Vector2.new(0, ((fogTime * 0.12) % 2) - 1)

	-- player marker
	if root then
		local p = toScreen(worldToMap(root.Position))
		playerMarker.Position = UDim2.fromOffset(p.X, p.Y)
		local look = root.CFrame.LookVector
		local arrow = playerMarker:FindFirstChild("Arrow")
		if arrow then
			(arrow :: Frame).Rotation = math.deg(math.atan2(look.X, -look.Z))
		end
		local ring = playerMarker:FindFirstChild("Pulse") :: Frame?
		if ring then
			local k = (fogTime % 1.6) / 1.6
			ring.Size = UDim2.fromOffset(12 + k * 34, 12 + k * 34)
			local st = ring:FindFirstChildOfClass("UIStroke")
			if st then
				st.Transparency = 0.2 + k * 0.8
			end
		end
	end
	-- pulse boss icons
	for _, icon in ipairs(icons) do
		if icon.Kind == "Danger" and icon ~= selected and icon ~= hovered then
			icon.Scale.Scale = 1 + math.sin(fogTime * 3) * 0.08
		end
	end
	layout()
end

function WorldMap.Update(snapshot)
	data = snapshot
	if snapshot.Explored then
		for key, v in pairs(snapshot.Explored) do
			if v and not explored[key] then
				markExplored(key, false)
			end
		end
	end
	recolorStages()
end

---------------------------------------------------------------------
-- INIT
---------------------------------------------------------------------
local function makeLayer(name: string, f: number, z: number)
	local fr = Instance.new("Frame")
	fr.Name = name
	fr.BackgroundTransparency = 1
	fr.Size = UDim2.fromOffset(0, 0)
	fr.ZIndex = z
	fr.Parent = viewport
	local sc = Instance.new("UIScale")
	sc.Parent = fr
	layers[name] = { Frame = fr, Scale = sc, F = f }
	return fr
end

local function legendChip(parent: Instance, x: number, kind: string, label: string)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.fromOffset(x, 0)
	holder.Size = UDim2.fromOffset(90, 22)
	holder.Parent = parent
	local s = shapeFor(kind, COL[kind], holder)
	s.Position = UDim2.fromOffset(10, 11)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromOffset(24, 0)
	t.Size = UDim2.new(1, -24, 1, 0)
	t.Font = Config.Fonts.Body
	t.TextSize = 13
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextColor3 = COL.Text
	t.Text = label
	t.Parent = holder
end

local function roundButton(parent: Instance, label: string, pos: UDim2, onClick)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.fromRGB(10, 16, 30)
	b.BackgroundTransparency = 0.2
	b.Size = UDim2.fromOffset(36, 36)
	b.Position = pos
	b.AnchorPoint = Vector2.new(1, 1)
	b.Font = Config.Fonts.Display
	b.TextSize = label:len() > 1 and 12 or 20
	b.TextColor3 = COL.Text
	b.Text = label
	b.ZIndex = 30
	b.Parent = parent
	corner(b, UDim.new(0.5, 0))
	local st = stroke(b, COL.Edge, 1, 0.5)
	b.MouseEnter:Connect(function()
		tween(st, 0.1, { Transparency = 0 })
		SFX.Play("UIHover")
	end)
	b.MouseLeave:Connect(function()
		tween(st, 0.1, { Transparency = 0.5 })
	end)
	b.Activated:Connect(function()
		SFX.Play("UIClick")
		onClick()
	end)
	return b
end

function WorldMap.Init(ui, requestFn)
	UI = ui
	request = requestFn
	gui = Instance.new("ScreenGui")
	gui.Name = "WorldMap"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 30
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	viewport = Instance.new("Frame")
	viewport.Name = "Viewport"
	viewport.BackgroundColor3 = COL.Bg
	viewport.BorderSizePixel = 0
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.ClipsDescendants = true
	viewport.Active = true
	viewport.Parent = gui

	makeLayer("Stars", 0.3, 1)
	makeLayer("Grid", 0.6, 2)
	makeLayer("Topo", 0.85, 3)
	makeLayer("World", 1, 4)
	makeLayer("FogLow", 1, 6)
	makeLayer("FogHigh", 1.12, 7)

	overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.BackgroundTransparency = 1
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 10
	overlay.Parent = viewport

	drawBackground()
	drawWorld()

	-- holo scanline shimmer + vignette
	local scan = frame(viewport, 0, 0, 0, 0, COL.Grid, 0.93)
	scan.Size = UDim2.fromScale(1, 1)
	scan.ZIndex = 9
	scan.Active = false
	scanGrad = Instance.new("UIGradient")
	scanGrad.Rotation = 90
	scanGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.45, 1),
		NumberSequenceKeypoint.new(0.5, 0.3),
		NumberSequenceKeypoint.new(0.55, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	scanGrad.Parent = scan
	for i, spec in ipairs({ { 90, UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0) }, { 270, UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75) }, { 0, UDim2.fromScale(0.2, 1), UDim2.fromScale(0, 0) }, { 180, UDim2.fromScale(0.2, 1), UDim2.fromScale(0.8, 0) } }) do
		local v = frame(viewport, 0, 0, 0, 0, Color3.new(0, 0, 0), 0)
		v.Name = "Vignette" .. i
		v.Size = spec[2]
		v.Position = spec[3]
		v.ZIndex = 11
		local g = Instance.new("UIGradient")
		g.Rotation = spec[1]
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = v
	end

	-- player + tracked markers (unscaled, above the fog)
	playerMarker = Instance.new("Frame")
	playerMarker.Name = "PlayerMarker"
	playerMarker.BackgroundTransparency = 1
	playerMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	playerMarker.Size = UDim2.fromOffset(24, 24)
	playerMarker.ZIndex = 15
	playerMarker.Parent = overlay
	local pulse = circle(playerMarker, 12, 12, 6, COL.Player, 1)
	pulse.Name = "Pulse"
	pulse.AnchorPoint = Vector2.new(0.5, 0.5)
	pulse.Position = UDim2.fromScale(0.5, 0.5)
	stroke(pulse, COL.Player, 1.5, 0.3)
	local arrow = Instance.new("Frame")
	arrow.Name = "Arrow"
	arrow.BackgroundTransparency = 1
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Position = UDim2.fromScale(0.5, 0.5)
	arrow.Size = UDim2.fromOffset(24, 24)
	arrow.Parent = playerMarker
	for _, side in ipairs({ -1, 1 }) do
		local bar = frame(arrow, 12 + side * 4, 12, 3, 13, COL.Player, 0)
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Rotation = -side * 32 -- tops meet in the middle: a "^" chevron
		corner(bar, UDim.new(0.5, 0))
	end
	local dot = circle(arrow, 12, 14, 2.5, COL.Player, 0)
	dot.Name = "Dot"

	trackedMarker = Instance.new("Frame")
	trackedMarker.Name = "Tracked"
	trackedMarker.BackgroundTransparency = 1
	trackedMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	trackedMarker.Size = UDim2.fromOffset(30, 30)
	trackedMarker.Visible = false
	trackedMarker.ZIndex = 14
	trackedMarker.Parent = overlay
	local tr = circle(trackedMarker, 15, 15, 14, Color3.new(1, 1, 1), 1)
	stroke(tr, Color3.new(1, 1, 1), 1.5, 0.2)

	callout = buildCallout(overlay)
	buildIcons()

	-- header + legend + buttons
	local header = Instance.new("Frame")
	header.BackgroundTransparency = 1
	header.Position = UDim2.fromOffset(28, 22)
	header.Size = UDim2.fromOffset(500, 50)
	header.ZIndex = 30
	header.Parent = gui
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 26)
	title.Font = Config.Fonts.Display
	title.TextSize = 24
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = "WORLD MAP"
	title.Parent = header
	local hint = title:Clone()
	hint.Position = UDim2.fromOffset(0, 28)
	hint.Size = UDim2.new(1, 0, 0, 16)
	hint.Font = Config.Fonts.Body
	hint.TextSize = 13
	hint.TextColor3 = COL.Text
	hint.TextTransparency = 0.25
	hint.Text = "Drag / WASD to pan  ·  Scroll / Q-E to zoom  ·  Click a marker for details  ·  M to close"
	hint.Parent = header

	local legend = Instance.new("Frame")
	legend.BackgroundTransparency = 1
	legend.Position = UDim2.new(0, 28, 1, -44)
	legend.Size = UDim2.fromOffset(520, 22)
	legend.ZIndex = 30
	legend.Parent = gui
	legendChip(legend, 0, "Service", "Service")
	legendChip(legend, 90, "Power", "Power")
	legendChip(legend, 170, "Travel", "Travel")
	legendChip(legend, 250, "Danger", "Danger")

	roundButton(gui, "X", UDim2.new(1, -24, 0, 60), WorldMap.Close)
	roundButton(gui, "+", UDim2.new(1, -24, 1, -110), function()
		setZoom(zoom * 1.25)
	end)
	roundButton(gui, "-", UDim2.new(1, -24, 1, -68), function()
		setZoom(zoom / 1.25)
	end)
	roundButton(gui, "ME", UDim2.new(1, -24, 1, -26), function()
		centerOnPlayer()
		velocity = Vector2.zero
	end)

	cover = Instance.new("Frame")
	cover.Name = "Cover"
	cover.BackgroundColor3 = Color3.new(0, 0, 0)
	cover.BorderSizePixel = 0
	cover.Size = UDim2.fromScale(1, 1)
	cover.ZIndex = 50
	cover.Active = false
	cover.Parent = gui

	-- drag to pan (with inertia), wheel / pinch to zoom
	viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragLast = Vector2.new(input.Position.X, input.Position.Y)
			dragTime = os.clock()
			velocity = Vector2.zero
			if selected then
				setEmphasis(selected, false)
				selected = nil
				hideCallout()
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not WorldMap.IsOpen then
			return
		end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			local now = os.clock()
			if dragLast then
				local delta = p - dragLast
				pan -= delta / zoom
				velocity = -delta / zoom / math.max(now - dragTime, 1 / 240)
				clampPan()
			end
			dragLast = p
			dragTime = now
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			local m = UserInputService:GetMouseLocation()
			setZoom(zoom * (input.Position.Z > 0 and 1.15 or 1 / 1.15), m - viewport.AbsolutePosition)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			dragLast = nil
			if os.clock() - dragTime > 0.08 then
				velocity = Vector2.zero -- released after holding still: no fling
			elseif velocity.Magnitude > 2400 then
				velocity = velocity.Unit * 2400
			end
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if not WorldMap.IsOpen then
			return
		end
		if state == Enum.UserInputState.Begin then
			pinchStart = zoom
			dragging = false
		elseif state == Enum.UserInputState.Change then
			setZoom(pinchStart * scale)
		end
	end)

	layout()
end

return WorldMap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">WorldText</string>
            <string name="Source"><![CDATA[--!nonstrict
-- WorldText (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/WorldText
-- Proximity-based world text. Every BillboardGui tagged "WorldLabel" is
-- built by the server at 0% opacity (a "Fade" CanvasGroup). This module
-- measures the distance from your character to the label's part (closest
-- point on the part, so big landmarks work too) and smoothly fades the text
-- in inside Config.WorldText.ShowDistance, with a small rise + scale-in.
-- Labels that are fully hidden are disabled so they cost nothing to render.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))

local WorldText = {}

local player = Players.LocalPlayer
local W = Config.WorldText
local labels = {} -- [BillboardGui] = { Fade, Scale, Alpha, BaseOffset }

local function track(bb: Instance)
	if not bb:IsA("BillboardGui") or labels[bb] then
		return
	end
	local fade = bb:WaitForChild("Fade", 5)
	if not fade or not fade:IsA("CanvasGroup") then
		return
	end
	local scale = fade:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Scale = 0.9
	scale.Parent = fade
	fade.GroupTransparency = 1
	bb.Enabled = false
	labels[bb] = { Fade = fade, Scale = scale, Alpha = 0, BaseOffset = bb.StudsOffset }
end

local function untrack(bb: Instance)
	labels[bb] = nil
end

-- Distance from a point to the closest point on a part's box. Height above
-- or below the part is relaxed by VerticalSlack so tall signs still count.
local function distanceTo(part: BasePart, pos: Vector3): number
	local rel = part.CFrame:PointToObjectSpace(pos)
	local half = part.Size / 2
	local dx = math.max(math.abs(rel.X) - half.X, 0)
	local dy = math.max(math.abs(rel.Y) - half.Y - W.VerticalSlack, 0)
	local dz = math.max(math.abs(rel.Z) - half.Z, 0)
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function adorneeOf(bb: BillboardGui): BasePart?
	local a = bb.Adornee or bb.Parent
	if a and a:IsA("BasePart") then
		return a
	elseif a and a:IsA("Model") then
		return a.PrimaryPart
	end
	return nil
end

function WorldText.Step(dt: number)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local pos = root and root.Position
	local k = math.min(1, dt * 7)
	for bb, entry in pairs(labels) do
		if not bb.Parent then
			labels[bb] = nil
			continue
		end
		local target = 0
		local part = adorneeOf(bb)
		if pos and part then
			-- your own name tag never shows (it is clutter for you)
			if char and bb:IsDescendantOf(char) then
				target = 0
			else
				local show = bb:GetAttribute("Radius") or W.ShowDistance
				local d = distanceTo(part, pos)
				target = math.clamp((show + W.FadeBand - d) / W.FadeBand, 0, 1)
			end
		end
		local a = entry.Alpha + (target - entry.Alpha) * k
		if math.abs(a - target) < 0.01 then
			a = target
		end
		if a ~= entry.Alpha then
			entry.Alpha = a
			local eased = a * a * (3 - 2 * a) -- smoothstep
			entry.Fade.GroupTransparency = 1 - eased
			entry.Scale.Scale = 0.9 + 0.1 * eased
			bb.StudsOffset = entry.BaseOffset + Vector3.new(0, (eased - 1) * 0.4, 0)
		end
		local enabled = a > 0.001
		if bb.Enabled ~= enabled then
			bb.Enabled = enabled
		end
	end
end

function WorldText.Init()
	for _, bb in ipairs(CollectionService:GetTagged("WorldLabel")) do
		task.spawn(track, bb)
	end
	CollectionService:GetInstanceAddedSignal("WorldLabel"):Connect(function(bb)
		task.spawn(track, bb)
	end)
	CollectionService:GetInstanceRemovedSignal("WorldLabel"):Connect(untrack)
end

-- Updates a label's text (and its drop shadow).
function WorldText.SetText(bb: Instance, name: string, text: string)
	local t = bb:FindFirstChild(name, true)
	local s = bb:FindFirstChild(name .. "Shadow", true)
	if t and t:IsA("TextLabel") then
		t.Text = text
	end
	if s and s:IsA("TextLabel") then
		s.Text = text
	end
end

return WorldText
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="50">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>