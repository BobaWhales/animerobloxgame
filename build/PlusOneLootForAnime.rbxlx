---------------------------------------------------------------------
-- Sound groups (so the Settings panel can mute music / sfx separately)
---------------------------------------------------------------------
local function getGroup(name: string, volume: number): SoundGroup
	local g = SoundService:FindFirstChild(name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Volume = volume
		g.Parent = SoundService
	end
	return g
end
local sfxGroup = getGroup("GameSFX", 0.9)
local musicGroup = getGroup("GameMusic", 0.45)

function SFX.SetSFXVolume(v: number)
	sfxGroup.Volume = v
end
function SFX.SetMusicVolume(v: number)
	musicGroup.Volume = v
end

---------------------------------------------------------------------
local function resolve(key: string): (string, number)
	local override = Config.SoundOverrides and Config.SoundOverrides[key]
	if typeof(override) == "string" and override ~= "" then
		return override, 1
	end
	if unavailable[key] and FALLBACK[key] then
		local fb = FALLBACK[key]
		return SOURCES[fb[1]], fb[2]
	end
	return SOURCES[key] or SOURCES.Blip, 1
end

local function addFx(sound: Sound, fx)
	if not fx then
		return
	end
	if fx.Reverb then
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = 1.6
		r.WetLevel = -4
		r.DryLevel = 0
		r.Parent = sound
	end
	if fx.Echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = 0.12
		e.Feedback = 0.25
		e.WetLevel = -8
		e.Parent = sound
	end
	if fx.Distort then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = fx.Distort
		d.Parent = sound
	end
	if fx.Bass then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = fx.Bass
		eq.MidGain = 0
		eq.HighGain = -2
		eq.Parent = sound
	end
end

local function pick(p): number
	if typeof(p) == "table" then
		return p[1] + math.random() * (p[2] - p[1])
	end
	return p or 1
end

local function makeParent(at): (Instance, Instance?)
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at
		a.Parent = workspace.Terrain
		return a, a
	elseif typeof(at) == "Instance" then
		return at, nil
	end
	return SoundService, nil
end

local function playOne(key: string, volume: number, pitch: number, parent: Instance, fx, positional: boolean)
	local id, pitchMul = resolve(key)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.PlaybackSpeed = pitch * pitchMul
	s.SoundGroup = sfxGroup
	if positional then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 12
		s.RollOffMaxDistance = 140
	end
	addFx(s, fx)
	s.Parent = parent
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	Debris:AddItem(s, 6)
end

-- SFX.Play("Hit", {At = position | part, Pitch = 1, Volume = 1})
function SFX.Play(name: string, opts)
	local cue = CUES[name]
	if not cue then
		return
	end
	opts = opts or {}
	local volMul = opts.Volume or 1
	local pitchMul = opts.Pitch or 1
	local parent, temp = makeParent(opts.At)
	local positional = parent ~= SoundService
	local longest = 0

	for _, layer in ipairs(cue) do
		local delay = layer.D or 0
		local vol = (layer.V or 0.5) * volMul
		if layer.Arp then
			local gap = layer.Gap or 0.06
			for i, p in ipairs(layer.Arp) do
				local t = delay + (i - 1) * gap
				longest = math.max(longest, t)
				task.delay(t, playOne, layer.S, vol, p * pitchMul, parent, layer.Fx, positional)
			end
		elseif layer.Chord then
			for _, p in ipairs(layer.Chord) do
				task.delay(delay, playOne, layer.S, vol, p * pitchMul, parent, layer.Fx, positional)
			end
		else
			longest = math.max(longest, delay)
			if delay > 0 then
				task.delay(delay, playOne, layer.S, vol, pick(layer.P) * pitchMul, parent, layer.Fx, positional)
			else
				playOne(layer.S, vol, pick(layer.P) * pitchMul, parent, layer.Fx, positional)
			end
		end
	end

	if temp then
		Debris:AddItem(temp, longest + 6)
	end
end

-- Looping ambient sound on a part (forge bubbling, portal hum...).
function SFX.Loop(sourceKey: string, parent: Instance, volume: number, pitch: number): Sound
	local id, pitchMul = resolve(sourceKey)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = volume
	s.PlaybackSpeed = pitch * pitchMul
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 90
	s.SoundGroup = sfxGroup
	s.Parent = parent
	s:Play()
	return s
end

---------------------------------------------------------------------
-- Music (optional; ids in Config.Music)
---------------------------------------------------------------------
local currentMusic: Sound? = nil
local currentMusicId = nil
function SFX.PlayMusic(assetId: number?)
	if assetId == currentMusicId then
		return
	end
	currentMusicId = assetId
	local old = currentMusic
	if old then
		local t = TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 })
		t:Play()
		t.Completed:Once(function()
			old:Destroy()
		end)
		currentMusic = nil
	end
	if not assetId or assetId == 0 then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(assetId)
	s.Looped = true
	s.Volume = 0
	s.SoundGroup = musicGroup
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(2), { Volume = 0.6 }):Play()
	currentMusic = s
end

---------------------------------------------------------------------
-- Preload + detect unavailable web assets (falls back automatically)
---------------------------------------------------------------------
function SFX.Init()
	task.spawn(function()
		local list = {}
		for key, id in pairs(SOURCES) do
			local s = Instance.new("Sound")
			s.Name = key
			s.SoundId = id
			table.insert(list, s)
		end
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(list, function(contentId, status)
				if status ~= Enum.AssetFetchStatus.Success then
					for key, id in pairs(SOURCES) do
						if id == contentId then
							unavailable[key] = true
						end
					end
				end
			end)
		end)
		if not ok then
			warn("[SFX] preload failed:", err)
		end
		for _, s in ipairs(list) do
			s:Destroy()
		end
	end)
end

SFX.Sources = SOURCES
return SFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">UITheme</string>
          <string name="Source"><![CDATA[--!nonstrict
-- UITheme (ModuleScript) -> ReplicatedStorage/GameShared/UITheme
--
-- Skins every panel / button / icon with the images from UIPackPlus.
--   1. Insert UIPackPlus.rbxm into Studio (drag the file into the viewport).
--   2. Move the inserted object into ReplicatedStorage and name it "UIPackPlus".
--   3. Press Play. The Output window prints every image name found in the
--      pack. If a role below doesn't pick the image you want, put that
--      image's exact name at the FRONT of the role's list.
-- Without the pack, a clean built-in anime style is used instead.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local SFX = require(script.Parent:WaitForChild("SFX"))

local UITheme = {}

UITheme.PackNames = { "UIPackPlus", "UI Pack Plus", "UIPack", "UI Pack" }

-- Role -> candidate image names inside the pack (case-insensitive).
-- Exact matches win; otherwise the first image whose name CONTAINS a
-- candidate is used.
UITheme.Templates = {
	Panel = { "Panel", "Frame", "Window", "Background", "Menu", "Container", "Box" },
	Header = { "Header", "TitleBar", "Title", "Banner", "Ribbon" },
	Button = { "GreenButton", "Button_Green", "ButtonGreen", "Button", "Btn" },
	ButtonBlue = { "BlueButton", "Button_Blue", "ButtonBlue" },
	ButtonRed = { "RedButton", "Button_Red", "ButtonRed" },
	ButtonGold = { "YellowButton", "OrangeButton", "GoldButton", "Button_Yellow", "Button_Orange" },
	ButtonPurple = { "PurpleButton", "Button_Purple", "PinkButton" },
	Close = { "CloseButton", "Close", "Exit", "XButton", "X" },
	Slot = { "Slot", "Card", "Item", "Tile", "Cell" },
	Bar = { "Bar", "Pill", "Counter", "StatFrame", "Stat" },
	ProgressBack = { "ProgressBar", "BarBackground", "BarBg", "Progress" },
	Icon_Coins = { "Coin", "Coins", "Gold", "Money", "Cash" },
	Icon_Power = { "Power", "Strength", "Fist", "Muscle", "Lightning", "Energy" },
	Icon_Blade = { "Sword", "Weapon", "Blade", "Katana", "Attack" },
	Icon_Rebirth = { "Rebirth", "Star", "Prestige", "Crown" },
	Icon_Backpack = { "Backpack", "Bag", "Inventory", "Chest" },
	Icon_Shop = { "Shop", "Cart", "Store", "Robux" },
	Icon_Index = { "Index", "Book", "Collection", "Quest" },
	Icon_Race = { "Race", "DNA", "Dice", "Character", "Profile" },
	Icon_Teleport = { "Teleport", "Map", "World", "Portal" },
	Icon_Upgrades = { "Upgrade", "Arrow", "Up", "Level" },
	Icon_Overdrive = { "Potion", "Boost", "Flask", "Fire" },
	Icon_Settings = { "Settings", "Gear", "Cog", "Options" },
	Icon_Gem = { "Gem", "Diamond", "Crystal", "Ore" },
	Icon_Rune = { "Rune", "Magic", "Scroll" },
	Icon_Home = { "Home", "House", "Hub" },
	Icon_Tower = { "Tower", "Castle", "Trophy" },
}

UITheme.Colors = {
	Bg = Color3.fromRGB(24, 20, 40),
	Bg2 = Color3.fromRGB(44, 34, 74),
	Stroke = Color3.fromRGB(10, 8, 18),
	Text = Color3.new(1, 1, 1),
	Sub = Color3.fromRGB(200, 195, 225),
	Green = Color3.fromRGB(80, 220, 110),
	Blue = Color3.fromRGB(70, 160, 255),
	Red = Color3.fromRGB(255, 80, 95),
	Gold = Color3.fromRGB(255, 195, 50),
	Purple = Color3.fromRGB(170, 90, 255),
	Pink = Color3.fromRGB(255, 110, 190),
}
UITheme.TitleFont = Enum.Font.LuckiestGuy
UITheme.BodyFont = Enum.Font.FredokaOne

-- Emoji fallbacks when the pack has no icon for a role.
local ICON_TEXT = {
	Icon_Coins = "💰",
	Icon_Power = "💪",
	Icon_Blade = "⚔️",
	Icon_Rebirth = "🌟",
	Icon_Backpack = "🎒",
	Icon_Shop = "🛒",
	Icon_Index = "📖",
	Icon_Race = "🧬",
	Icon_Teleport = "🌀",
	Icon_Upgrades = "⬆️",
	Icon_Overdrive = "🔥",
	Icon_Settings = "⚙️",
	Icon_Gem = "💎",
	Icon_Rune = "🔮",
	Icon_Home = "🏠",
	Icon_Tower = "🗼",
}

local pack: Instance? = nil
local images: { [string]: ImageLabel | ImageButton } = {}
local imageNames: { string } = {}
local cache: { [string]: any } = {}

local function findPack(): Instance?
	for _, parent in ipairs({ ReplicatedStorage, StarterGui }) do
		for _, name in ipairs(UITheme.PackNames) do
			local p = parent:FindFirstChild(name)
			if p then
				return p
			end
		end
	end
	for _, c in ipairs(ReplicatedStorage:GetChildren()) do
		if c.Name:lower():find("uipack") then
			return c
		end
	end
	return nil
end

function UITheme.Init()
	pack = findPack()
	if not pack then
		print("[UITheme] UIPackPlus not found in ReplicatedStorage - using built-in style.")
		return
	end
	for _, d in ipairs(pack:GetDescendants()) do
		if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
			local key = d.Name:lower()
			if not images[key] then
				images[key] = d
				table.insert(imageNames, d.Name)
			end
		end
	end
	table.sort(imageNames)
	print(("[UITheme] UIPackPlus found with %d images: %s"):format(#imageNames, table.concat(imageNames, ", ")))
end

function UITheme.HasPack(): boolean
	return pack ~= nil and #imageNames > 0
end

-- Returns the source image instance for a role (or nil).
function UITheme.Find(role: string)
	if cache[role] ~= nil then
		return cache[role] or nil
	end
	local candidates = UITheme.Templates[role]
	local found = nil
	if candidates and pack then
		for _, name in ipairs(candidates) do
			local img = images[name:lower()]
			if img then
				found = img
				break
			end
		end
		if not found then
			for _, name in ipairs(candidates) do
				local lower = name:lower()
				if #lower >= 3 then
					for _, n in ipairs(imageNames) do
						if n:lower():find(lower, 1, true) then
							found = images[n:lower()]
							break
						end
					end
				end
				if found then
					break
				end
			end
		end
	end
	cache[role] = found or false
	return found
end

-- Copy the image look (9-slice etc.) from a pack image onto ours.
local function applySkin(target: any, src)
	target.Image = src.Image
	target.ImageColor3 = src.ImageColor3
	target.ImageTransparency = src.ImageTransparency
	target.ScaleType = src.ScaleType
	target.SliceCenter = src.SliceCenter
	target.SliceScale = src.SliceScale
	target.ImageRectOffset = src.ImageRectOffset
	target.ImageRectSize = src.ImageRectSize
	target.ResampleMode = src.ResampleMode
	target.BackgroundTransparency = 1
end

---------------------------------------------------------------------
-- small builders
---------------------------------------------------------------------
function UITheme.Corner(inst: GuiObject, px: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 14)
	c.Parent = inst
	return c
end

function UITheme.Stroke(inst: GuiObject, thickness: number?, color: Color3?, border: boolean?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2.5
	s.Color = color or UITheme.Colors.Stroke
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = inst
	return s
end

function UITheme.Gradient(inst: GuiObject, a: Color3, b: Color3, rot: number?)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rot or 90
	g.Parent = inst
	return g
end

function UITheme.Label(parent: Instance, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = props.Title and UITheme.TitleFont or UITheme.BodyFont
	t.TextScaled = props.TextScaled ~= false
	t.TextColor3 = props.Color or UITheme.Colors.Text
	t.Text = props.Text or ""
	t.Size = props.Size or UDim2.fromScale(1, 1)
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	t.RichText = props.Rich == true
	t.ZIndex = props.ZIndex or 1
	t.LayoutOrder = props.Order or 0
	if props.TextSize then
		t.TextSize = props.TextSize
	end
	t.Name = props.Name or "Label"
	t.Parent = parent
	if props.Stroke ~= false then
		UITheme.Stroke(t, props.StrokeThickness or 2)
	end
	local cons = Instance.new("UITextSizeConstraint")
	cons.MaxTextSize = props.MaxText or 40
	cons.Parent = t
	return t
end

-- Icon: pack image if available, emoji otherwise.
function UITheme.Icon(parent: Instance, role: string, size: UDim2, pos: UDim2?, anchor: Vector2?)
	local src = UITheme.Find(role)
	local icon
	if src then
		icon = Instance.new("ImageLabel")
		applySkin(icon, src)
		icon.ScaleType = Enum.ScaleType.Fit
	else
		icon = Instance.new("TextLabel")
		icon.BackgroundTransparency = 1
		icon.Text = ICON_TEXT[role] or "✦"
		icon.TextScaled = true
		icon.Font = Enum.Font.GothamBold
	end
	icon.Name = "Icon"
	icon.Size = size
	icon.Position = pos or UDim2.new()
	icon.AnchorPoint = anchor or Vector2.zero
	icon.Parent = parent
	return icon
end

-- Panel container. Returns (frame, content).
function UITheme.Panel(parent: Instance, props)
	local src = UITheme.Find(props.Role or "Panel")
	local frame
	if src then
		frame = Instance.new("ImageLabel")
		applySkin(frame, src)
	else
		frame = Instance.new("Frame")
		frame.BackgroundColor3 = UITheme.Colors.Bg
		UITheme.Corner(frame, 18)
		UITheme.Stroke(frame, 4, UITheme.Colors.Stroke, true)
		UITheme.Gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 200), 90)
		frame.BackgroundColor3 = UITheme.Colors.Bg2
	end
	frame.Name = props.Name or "Panel"
	frame.Size = props.Size
	frame.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.ZIndex or 1
	frame.Parent = parent

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = frame
	local pad = Instance.new("UIPadding")
	local p = props.Padding or 14
	pad.PaddingTop = UDim.new(0, p)
	pad.PaddingBottom = UDim.new(0, p)
	pad.PaddingLeft = UDim.new(0, p)
	pad.PaddingRight = UDim.new(0, p)
	pad.Parent = content
	return frame, content
end

local COLOR_ROLE = {
	Green = "Button",
	Blue = "ButtonBlue",
	Red = "ButtonRed",
	Gold = "ButtonGold",
	Purple = "ButtonPurple",
}

-- Animated button with hover / press feedback and UI sounds.
function UITheme.Button(parent: Instance, props)
	local colorName = props.Color or "Green"
	local src = UITheme.Find(COLOR_ROLE[colorName] or "Button") or UITheme.Find("Button")
	local btn
	if src then
		btn = Instance.new("ImageButton")
		applySkin(btn, src)
		btn.AutoButtonColor = false
	else
		btn = Instance.new("TextButton")
		btn.Text = ""
		btn.AutoButtonColor = false
		local base = UITheme.Colors[colorName] or UITheme.Colors.Green
		btn.BackgroundColor3 = base
		UITheme.Corner(btn, props.Corner or 12)
		UITheme.Stroke(btn, 3, UITheme.Colors.Stroke, true)
		UITheme.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(175, 175, 175), 90)
		-- glossy top shine
		local shine = Instance.new("Frame")
		shine.Name = "Shine"
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BackgroundTransparency = 0.75
		shine.Size = UDim2.new(1, -10, 0.35, 0)
		shine.Position = UDim2.fromOffset(5, 4)
		shine.BorderSizePixel = 0
		UITheme.Corner(shine, 8)
		shine.Parent = btn
	end
	btn.Name = props.Name or "Button"
	btn.Size = props.Size or UDim2.fromOffset(160, 50)
	btn.Position = props.Position or UDim2.new()
	btn.AnchorPoint = props.AnchorPoint or Vector2.zero
	btn.LayoutOrder = props.Order or 0
	btn.ZIndex = props.ZIndex or 1
	btn.Parent = parent

	local scale = Instance.new("UIScale")
	scale.Parent = btn

	if props.Icon then
		UITheme.Icon(btn, props.Icon, UDim2.fromScale(props.Text and 0.62 or 0.8, props.Text and 0.62 or 0.8), UDim2.fromScale(0.5, props.Text and 0.4 or 0.5), Vector2.new(0.5, 0.5))
	end
	if props.Text then
		local label = UITheme.Label(btn, {
			Text = props.Text,
			Title = props.TitleFont ~= false,
			Size = props.Icon and UDim2.fromScale(1, 0.34) or UDim2.new(1, -12, 1, -8),
			Position = props.Icon and UDim2.fromScale(0, 0.68) or UDim2.fromOffset(6, 4),
			MaxText = props.MaxText or 28,
			ZIndex = btn.ZIndex + 1,
		})
		label.Name = "Text"
	end

	local hoverTween = TweenInfo.new(0.12, Enum.EasingStyle.Back)
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1.06 }):Play()
		SFX.Play("UIHover")
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, hoverTween, { Scale = 1.06 }):Play()
	end)
	if props.OnClick then
		btn.Activated:Connect(function()
			SFX.Play(props.Sound or "UIClick")
			props.OnClick()
		end)
	end
	return btn
end

function UITheme.SetButtonText(btn: GuiObject, text: string)
	local t = btn:FindFirstChild("Text")
	if t then
		(t :: TextLabel).Text = text
	end
end

return UITheme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">VFX</string>
          <string name="Source"><![CDATA[--!nonstrict
-- VFX (ModuleScript) -> ReplicatedStorage/GameShared/VFX
-- Anime-style effects: curved slash arcs, hit sparks, shockwaves, light
-- pillars, impact frames, speed lines, title cards, camera shake, FOV punch.
-- MakeEmitter() is also used by the server for auras / map decoration.
-- Only uses built-in Roblox particle textures, so nothing needs uploading.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Format = require(script.Parent:WaitForChild("Format"))

local VFX = {}

local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	FireSparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	Shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Core = "rbxasset://textures/particles/explosion01_core_main.dds",
	Implode = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	Square = "rbxasset://textures/particles/SquareParticle.png",
}
VFX.Textures = TEX

local WHITE = Color3.new(1, 1, 1)

local function NS(...): NumberSequence
	local args = { ... }
	if #args == 1 then
		return NumberSequence.new(args[1])
	end
	local kps = {}
	for i = 1, #args, 2 do
		table.insert(kps, NumberSequenceKeypoint.new(args[i], args[i + 1]))
	end
	return NumberSequence.new(kps)
end
VFX.NS = NS

local function CS(a: Color3, b: Color3?): ColorSequence
	return ColorSequence.new(a, b or a)
end

---------------------------------------------------------------------
-- PARTICLE PRESETS
---------------------------------------------------------------------
local PRESETS = {
	Sparks = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Square
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 0.35, 1, 0)
		e.Squash = NS(-2.5)
		e.Orientation = Enum.ParticleOrientation.VelocityParallel
		e.Lifetime = NumberRange.new(0.2, 0.45)
		e.Speed = NumberRange.new(30, 60)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Drag = 7
		e.Acceleration = Vector3.new(0, -35, 0)
		e.LightEmission = 1
		e.Brightness = 4
	end,
	Stars = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Sparkle
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 0.4, 0.3, 1.4, 1, 0)
		e.Lifetime = NumberRange.new(0.4, 0.9)
		e.Speed = NumberRange.new(8, 22)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Drag = 4
		e.RotSpeed = NumberRange.new(-180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.LightEmission = 1
		e.Brightness = 3
	end,
	Glow = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Glow
		e.Color = CS(c)
		e.Size = NS(0, 2, 0.2, 7, 1, 9)
		e.Transparency = NS(0, 0.1, 1, 1)
		e.Lifetime = NumberRange.new(0.25, 0.35)
		e.Speed = NumberRange.new(0)
		e.LightEmission = 1
		e.Brightness = 3
		e.ZOffset = 1
	end,
	Core = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Core
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 3, 1, 12)
		e.Transparency = NS(0, 0, 1, 1)
		e.Lifetime = NumberRange.new(0.35, 0.5)
		e.Speed = NumberRange.new(0)
		e.Rotation = NumberRange.new(0, 360)
		e.LightEmission = 1
		e.Brightness = 2
	end,
	Shock = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Shock
		e.Color = CS(c)
		e.Size = NS(0, 1, 1, 22)
		e.Transparency = NS(0, 0, 1, 1)
		e.Lifetime = NumberRange.new(0.45)
		e.Speed = NumberRange.new(0)
		e.LightEmission = 1
		e.Brightness = 3
	end,
	Smoke = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Smoke
		e.Color = CS(c)
		e.Size = NS(0, 2, 1, 7)
		e.Transparency = NS(0, 0.4, 1, 1)
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(4, 12)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Drag = 3
		e.Acceleration = Vector3.new(0, 4, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-40, 40)
		e.LightInfluence = 0.4
	end,
	Fire = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Fire
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 1.2, 1, 0)
		e.Transparency = NS(0, 0.2, 1, 1)
		e.Lifetime = NumberRange.new(0.4, 0.8)
		e.Speed = NumberRange.new(2, 5)
		e.SpreadAngle = Vector2.new(20, 20)
		e.Acceleration = Vector3.new(0, 8, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-90, 90)
		e.LightEmission = 1
		e.Brightness = 2
	end,
	Embers = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.FireSparks
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 0.25, 1, 0)
		e.Lifetime = NumberRange.new(1, 2)
		e.Speed = NumberRange.new(2, 6)
		e.SpreadAngle = Vector2.new(40, 40)
		e.Acceleration = Vector3.new(0, 6, 0)
		e.LightEmission = 1
		e.Brightness = 3
	end,
	Shards = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Square
		e.Color = CS(c)
		e.Size = NS(0, 0.5, 1, 0)
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Speed = NumberRange.new(18, 34)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-400, 400)
		e.Acceleration = Vector3.new(0, -60, 0)
		e.Drag = 2
		e.LightEmission = 0.6
		e.Brightness = 2
	end,
	Petals = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Square
		e.Color = CS(c, Color3.fromRGB(255, 220, 235))
		e.Size = NS(0, 0.25, 1, 0.15)
		e.Squash = NS(0.5)
		e.Lifetime = NumberRange.new(2, 4)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-120, 120)
		e.Acceleration = Vector3.new(1, -2, 0.5)
		e.LightEmission = 0.3
	end,
	Rise = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Sparkle
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 0.5, 1, 0)
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(4, 9)
		e.EmissionDirection = Enum.NormalId.Top
		e.SpreadAngle = Vector2.new(15, 15)
		e.LightEmission = 1
		e.Brightness = 3
	end,
	Aura = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Fire
		e.Color = CS(WHITE, c)
		e.Size = NS(0, 1.2, 0.5, 2.2, 1, 0)
		e.Transparency = NS(0, 0.4, 0.6, 0.6, 1, 1)
		e.Lifetime = NumberRange.new(0.5, 0.8)
		e.Speed = NumberRange.new(4, 7)
		e.EmissionDirection = Enum.NormalId.Top
		e.SpreadAngle = Vector2.new(10, 10)
		e.Acceleration = Vector3.new(0, 6, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.LightEmission = 1
		e.Brightness = 2
		e.LockedToPart = false
	end,
	Vortex = function(e: ParticleEmitter, c: Color3)
		e.Texture = TEX.Vortex
		e.Color = CS(c)
		e.Size = NS(0, 2, 1, 4)
		e.Transparency = NS(0, 0.3, 1, 1)
		e.Lifetime = NumberRange.new(0.8, 1.2)
		e.Speed = NumberRange.new(0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(90, 180)
		e.LightEmission = 1
		e.LockedToPart = true
	end,
}
VFX.Presets = PRESETS

-- Create an emitter from a preset. Rate defaults to 0 (use :Emit()).
function VFX.MakeEmitter(preset: string, color: Color3, parent: Instance, rate: number?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate or 0
	e.LightInfluence = 0
	local fn = PRESETS[preset] or PRESETS.Sparks
	fn(e, color or WHITE)
	e.Parent = parent
	return e
end

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------
local fxFolder: Folder? = nil
local function folder(): Instance
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local f = workspace:FindFirstChild("ClientFX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "ClientFX"
		f.Parent = workspace
	end
	fxFolder = f
	return f
end

local function fxPart(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.Parent = folder()
	return p
end
VFX.FxPart = fxPart

local function tween(inst: Instance, t: number, props, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
VFX.Tween = tween

-- Burst a preset at a world position.
function VFX.Emit(pos: Vector3, preset: string, count: number, color: Color3?)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local e = VFX.MakeEmitter(preset, color or WHITE, a)
	e:Emit(count)
	local maxLife = e.Lifetime.Max
	Debris:AddItem(a, maxLife + 0.5)
end

function VFX.Light(pos: Vector3, color: Color3, range: number, brightness: number, t: number)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = a
	tween(l, t, { Brightness = 0 })
	Debris:AddItem(a, t + 0.1)
end

-- Expanding neon ball flash.
function VFX.Flash(pos: Vector3, color: Color3, size: number, t)
	t = t or 0.25
	local p = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * (size * 0.3), CFrame = CFrame.new(pos), Color = color, Transparency = 0.05 })
	tween(p, t, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(p, t + 0.05)
end

-- Flat expanding shockwave disc.
function VFX.Ring(pos: Vector3, color: Color3, radius: number, t, height)
	t = t or 0.45
	local p = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height or 0.25, 1, 1),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.15,
	})
	tween(p, t, { Size = Vector3.new(0.05, radius * 2, radius * 2), Transparency = 1 }, Enum.EasingStyle.Quart)
	Debris:AddItem(p, t + 0.05)
end

-- Ring of shards flying outward (reads as a crisp anime shockwave).
function VFX.ShardRing(pos: Vector3, color: Color3, radius: number, count, t)
	count = count or 18
	t = t or 0.5
	for i = 1, count do
		local ang = (i / count) * math.pi * 2
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local start = CFrame.lookAt(pos + dir * 1.5, pos + dir * 3)
		local p = fxPart({ Size = Vector3.new(0.25, 0.25, 2.2), CFrame = start, Color = color })
		tween(p, t, { CFrame = CFrame.lookAt(pos + dir * radius, pos + dir * (radius + 1)), Size = Vector3.new(0.05, 0.05, 0.6), Transparency = 1 }, Enum.EasingStyle.Quart)
		Debris:AddItem(p, t + 0.05)
	end
end

-- Vertical pillar of light.
function VFX.Pillar(pos: Vector3, color: Color3, height: number, radius: number, t)
	t = t or 0.9
	local base = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local p = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 0.4, radius * 0.4), CFrame = base, Color = color, Transparency = 0.1 })
	local core = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 0.15, radius * 0.15), CFrame = base, Color = WHITE, Transparency = 0 })
	tween(p, t * 0.25, { Size = Vector3.new(height, radius * 2, radius * 2) }, Enum.EasingStyle.Back)
	task.delay(t * 0.3, function()
		tween(p, t * 0.7, { Size = Vector3.new(height * 1.1, 0.1, 0.1), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(core, t * 0.7, { Size = Vector3.new(height * 1.1, 0.05, 0.05), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	Debris:AddItem(p, t + 0.1)
	Debris:AddItem(core, t + 0.1)
end

---------------------------------------------------------------------
-- SLASH ARC (two curved beams -> crescent that sweeps and fades)
---------------------------------------------------------------------
local function arcAttachment(holder: BasePart, radius: number, angle: number): Attachment
	local p = Vector3.new(math.sin(angle) * radius, 0, -math.cos(angle) * radius)
	local tangent = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local a = Instance.new("Attachment")
	a.CFrame = CFrame.fromMatrix(p, tangent, Vector3.yAxis)
	a.Parent = holder
	return a
end

function VFX.Slash(origin: CFrame, color: Color3, scale, flip: boolean?)
	scale = scale or 1
	local radius = 6 * scale
	local half = math.rad(75)
	local roll = math.rad(math.random(-30, 30))
	local cf = origin * CFrame.Angles(0, 0, roll)
	if flip then
		cf = cf * CFrame.Angles(0, 0, math.pi)
	end
	local holder = fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = cf * CFrame.Angles(0, math.rad(35), 0) })

	local a0 = arcAttachment(holder, radius, -half)
	local am = arcAttachment(holder, radius, 0)
	local a1 = arcAttachment(holder, radius, half)
	local ctrl = (4 / 3) * math.tan(half / 4) * radius

	local beams = {}
	local function mk(att0, att1, w0, w1, col, bright)
		local b = Instance.new("Beam")
		b.Attachment0 = att0
		b.Attachment1 = att1
		b.CurveSize0 = ctrl
		b.CurveSize1 = ctrl
		b.Width0 = w0
		b.Width1 = w1
		b.Segments = 24
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = bright
		b.Color = col
		b.Transparency = NS(0)
		b.Parent = holder
		table.insert(beams, b)
	end
	local w = 2.2 * scale
	mk(a0, am, 0.05, w, ColorSequence.new(color, WHITE), 4)
	mk(am, a1, w, 0.05, ColorSequence.new(WHITE, color), 4)
	mk(a0, am, 0.02, w * 0.35, CS(WHITE), 6)
	mk(am, a1, w * 0.35, 0.02, CS(WHITE), 6)

	local start = os.clock()
	local life = 0.24
	local startCF = holder.CFrame
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / life
		if t >= 1 then
			conn:Disconnect()
			holder:Destroy()
			return
		end
		local ease = 1 - (1 - t) ^ 3
		holder.CFrame = startCF * CFrame.Angles(0, -math.rad(70) * ease, 0)
		local tr = NS(0, math.min(1, t * 1.6), 1, math.min(1, t * 0.6 + 0.2))
		for _, b in ipairs(beams) do
			b.Transparency = tr
		end
	end)
end

---------------------------------------------------------------------
-- HITS / DAMAGE NUMBERS / ENEMY FEEDBACK
---------------------------------------------------------------------
function VFX.HitSpark(pos: Vector3, color: Color3, crit: boolean?)
	VFX.Emit(pos, "Sparks", crit and 26 or 12, color)
	VFX.Flash(pos, crit and Color3.fromRGB(255, 230, 120) or WHITE, crit and 6 or 3.2, crit and 0.22 or 0.15)
	if crit then
		VFX.Emit(pos, "Stars", 8, Color3.fromRGB(255, 220, 80))
		VFX.Emit(pos, "Glow", 1, Color3.fromRGB(255, 200, 80))
		VFX.Light(pos, Color3.fromRGB(255, 210, 120), 16, 4, 0.25)
	end
end

function VFX.DamageNumber(pos: Vector3, amount: number, crit: boolean?, color: Color3?)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(crit and 220 or 160, crit and 70 or 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 120
	bb.StudsOffset = Vector3.new((math.random() - 0.5) * 3, 1.5, 0)
	bb.Adornee = a
	bb.Parent = a
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.Text = (crit and "CRIT " or "") .. Format.Abbrev(amount)
	label.TextColor3 = color or (crit and Color3.fromRGB(255, 215, 60) or WHITE)
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = crit and 3 or 2
	stroke.Color = crit and Color3.fromRGB(120, 30, 0) or Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(WHITE, Color3.fromRGB(200, 200, 200))
	grad.Rotation = 90
	grad.Parent = label
	local sc = Instance.new("UIScale")
	sc.Scale = 0.2
	sc.Parent = label
	tween(sc, 0.12, { Scale = crit and 1.35 or 1.1 }, Enum.EasingStyle.Back)
	task.delay(0.12, function()
		tween(sc, 0.15, { Scale = 1 })
	end)
	tween(bb, 0.9, { StudsOffset = bb.StudsOffset + Vector3.new(0, crit and 5 or 4, 0) }, Enum.EasingStyle.Quart)
	task.delay(0.5, function()
		tween(label, 0.4, { TextTransparency = 1 })
		tween(stroke, 0.4, { Transparency = 1 })
	end)
	Debris:AddItem(a, 1)
end

-- Floating text (e.g. "+12 Power", "BACKPACK FULL").
function VFX.TextPop(pos: Vector3, text: string, color: Color3, size)
	size = size or 1
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240 * size, 44 * size)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 100
	bb.StudsOffset = Vector3.new(0, 2, 0)
	bb.Adornee = a
	bb.Parent = a
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(15, 15, 25)
	stroke.Parent = label
	tween(bb, 1, { StudsOffset = Vector3.new(0, 5, 0) }, Enum.EasingStyle.Quart)
	task.delay(0.6, function()
		tween(label, 0.4, { TextTransparency = 1 })
		tween(stroke, 0.4, { Transparency = 1 })
	end)
	Debris:AddItem(a, 1.1)
end

function VFX.EnemyHitFlash(model: Model)
	if not model or not model.Parent then
		return
	end
	local existing = model:FindFirstChild("HitFlash")
	if existing then
		existing:Destroy()
	end
	local h = Instance.new("Highlight")
	h.Name = "HitFlash"
	h.FillColor = WHITE
	h.OutlineColor = WHITE
	h.FillTransparency = 0.05
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = model
	h.Parent = model
	tween(h, 0.18, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(h, 0.2)
end

function VFX.EnemyDeath(model: Model, color: Color3, big: boolean?)
	if not model or not model.Parent then
		return
	end
	local pos = model:GetPivot().Position
	local h = Instance.new("Highlight")
	h.FillColor = WHITE
	h.OutlineColor = color
	h.FillTransparency = 0
	h.Adornee = model
	h.Parent = model
	tween(h, 0.5, { FillTransparency = 1, OutlineTransparency = 1 })
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			tween(d, 0.45, { Transparency = 1 })
		elseif d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	local scale = big and 2.5 or 1
	VFX.Emit(pos, "Shards", big and 40 or 16, color)
	VFX.Emit(pos, "Sparks", big and 40 or 18, color)
	VFX.Emit(pos, "Smoke", big and 14 or 5, Color3.fromRGB(220, 220, 230))
	VFX.Flash(pos, color, 7 * scale, 0.3)
	VFX.Ring(pos - Vector3.new(0, 1.5 * scale, 0), color, 10 * scale, 0.45)
	VFX.Light(pos, color, 20 * scale, 5, 0.4)
	if big then
		VFX.Emit(pos, "Core", 3, color)
		VFX.ShardRing(pos, color, 30, 24, 0.7)
		VFX.Pillar(pos - Vector3.new(0, 4, 0), color, 60, 8, 1.2)
	end
end

-- Red ground telegraph that fills up before a boss slam.
function VFX.Telegraph(pos: Vector3, radius: number, t: number)
	local flat = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	local outline = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, radius * 2, radius * 2), CFrame = flat, Color = Color3.fromRGB(255, 40, 40), Transparency = 0.6 })
	local fill = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 0.5, 0.5), CFrame = flat, Color = Color3.fromRGB(255, 80, 40), Transparency = 0.35 })
	tween(fill, t, { Size = Vector3.new(0.15, radius * 2, radius * 2) }, Enum.EasingStyle.Linear)
	task.delay(t, function()
		outline:Destroy()
		fill:Destroy()
		VFX.Ring(pos, Color3.fromRGB(255, 120, 60), radius * 1.2, 0.4, 0.8)
		VFX.Emit(pos + Vector3.new(0, 1, 0), "Smoke", 18, Color3.fromRGB(180, 150, 130))
		VFX.Emit(pos + Vector3.new(0, 1, 0), "Shards", 20, Color3.fromRGB(140, 110, 90))
	end)
end

function VFX.Explosion(pos: Vector3, color: Color3, scale)
	scale = scale or 1
	VFX.Flash(pos, WHITE, 8 * scale, 0.2)
	VFX.Flash(pos, color, 14 * scale, 0.45)
	VFX.Emit(pos, "Core", 2, color)
	VFX.Emit(pos, "Sparks", math.floor(30 * scale), color)
	VFX.Emit(pos, "Smoke", math.floor(10 * scale), Color3.fromRGB(200, 200, 210))
	VFX.Ring(pos, color, 16 * scale, 0.5)
	VFX.Light(pos, color, 30 * scale, 6, 0.5)
end

---------------------------------------------------------------------
-- SCREEN FX (local player only; call VFX.Init() on the client first)
---------------------------------------------------------------------
local screenGui: ScreenGui? = nil
local shakeTrauma = 0
local fovPunch = 0
local baseFov = 70

function VFX.Init()
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "ScreenFX"
	sg.IgnoreGuiInset = true
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 50
	sg.Parent = player:WaitForChild("PlayerGui")
	screenGui = sg

	RunService:BindToRenderStep("VFXCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		if shakeTrauma > 0 then
			local s = shakeTrauma * shakeTrauma
			local t = os.clock() * 40
			local rx = (math.noise(t, 0.3) * 2) * s * 0.035
			local ry = (math.noise(0.7, t) * 2) * s * 0.035
			local rz = (math.noise(t, t * 0.5) * 2) * s * 0.02
			cam.CFrame = cam.CFrame * CFrame.Angles(rx, ry, rz)
			shakeTrauma = math.max(0, shakeTrauma - dt * 1.8)
		end
		fovPunch = fovPunch + (0 - fovPunch) * math.min(1, dt * 8)
		cam.FieldOfView = baseFov + fovPunch
	end)
end

function VFX.SetBaseFov(f: number)
	baseFov = f
end

function VFX.Shake(amount: number)
	shakeTrauma = math.min(1, shakeTrauma + amount)
end

function VFX.FOVPunch(amount: number)
	fovPunch = amount
end

function VFX.ScreenFlash(color: Color3, startTransparency: number?, t: number?)
	if not screenGui then
		return
	end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = startTransparency or 0.2
	f.BorderSizePixel = 0
	f.ZIndex = 20
	f.Parent = screenGui
	tween(f, t or 0.4, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (t or 0.4) + 0.05)
end

-- Radial anime speed lines around the screen edge.
function VFX.SpeedLines(duration: number, color: Color3?)
	if not screenGui then
		return
	end
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 18
	holder.Parent = screenGui
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local diag = vp.Magnitude / 2
	local stopAt = os.clock() + duration
	task.spawn(function()
		while os.clock() < stopAt and holder.Parent do
			for _ = 1, 6 do
				local ang = math.random() * math.pi * 2
				local dir = Vector2.new(math.cos(ang), math.sin(ang))
				local len = diag * (0.25 + math.random() * 0.25)
				local startDist = diag * (0.75 + math.random() * 0.2)
				local line = Instance.new("Frame")
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.BorderSizePixel = 0
				line.BackgroundColor3 = color or WHITE
				line.BackgroundTransparency = 0.15
				line.Size = UDim2.fromOffset(len, math.random(2, 5))
				line.Rotation = math.deg(ang)
				local p = vp / 2 + dir * startDist
				line.Position = UDim2.fromOffset(p.X, p.Y)
				line.ZIndex = 18
				line.Parent = holder
				local endP = vp / 2 + dir * (startDist - diag * 0.3)
				tween(line, 0.25, { Position = UDim2.fromOffset(endP.X, endP.Y), BackgroundTransparency = 1, Size = UDim2.fromOffset(len * 0.4, 1) }, Enum.EasingStyle.Linear)
				Debris:AddItem(line, 0.3)
			end
			task.wait(0.03)
		end
		task.wait(0.3)
		holder:Destroy()
	end)
end

-- "Impact frame": a split-second high-contrast frame + speed lines + shake.
function VFX.ImpactFrame(color: Color3?, strength)
	strength = strength or 1
	if not screenGui then
		return
	end
	local dark = Instance.new("Frame")
	dark.Size = UDim2.fromScale(1, 1)
	dark.BackgroundColor3 = Color3.new(0, 0, 0)
	dark.BackgroundTransparency = 0.25
	dark.BorderSizePixel = 0
	dark.ZIndex = 19
	dark.Parent = screenGui
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Contrast = 1.2
	cc.Saturation = -1
	cc.Brightness = 0.1
	cc.Parent = workspace.CurrentCamera
	task.delay(0.07, function()
		dark:Destroy()
		cc:Destroy()
		VFX.ScreenFlash(color or WHITE, 0.1, 0.35)
	end)
	VFX.SpeedLines(0.35 * strength, color)
	VFX.Shake(0.55 * strength)
	VFX.FOVPunch(-8 * strength)
end

-- Big dramatic banner ("OVERDRIVE!", "NEW TIER", race reveals...).
function VFX.TitleCard(title: string, subtitle: string?, color, duration)
	if not screenGui then
		return
	end
	color = color or Color3.fromRGB(255, 200, 60)
	duration = duration or 1.6
	local band = Instance.new("Frame")
	band.AnchorPoint = Vector2.new(0.5, 0.5)
	band.Position = UDim2.fromScale(-0.6, 0.38)
	band.Size = UDim2.new(1.4, 0, 0, 120)
	band.Rotation = -4
	band.BackgroundColor3 = Color3.fromRGB(12, 12, 20)
	band.BackgroundTransparency = 0.1
	band.BorderSizePixel = 0
	band.ZIndex = 30
	band.Parent = screenGui
	local grad = Instance.new("UIGradient")
	grad.Transparency = NS(0, 1, 0.2, 0.1, 0.8, 0.1, 1, 1)
	grad.Parent = band
	for _, y in ipairs({ 0, 1 }) do
		local stripe = Instance.new("Frame")
		stripe.AnchorPoint = Vector2.new(0, y)
		stripe.Position = UDim2.fromScale(0, y)
		stripe.Size = UDim2.new(1, 0, 0, 6)
		stripe.BackgroundColor3 = color
		stripe.BorderSizePixel = 0
		stripe.ZIndex = 31
		stripe.Parent = band
	end
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, subtitle and 0.42 or 0.5)
	t.Size = UDim2.new(0.6, 0, 0, 72)
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = true
	t.Text = title
	t.TextColor3 = color
	t.ZIndex = 32
	t.Parent = band
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Color = Color3.new(0, 0, 0)
	st.Parent = t
	local tg = Instance.new("UIGradient")
	tg.Color = ColorSequence.new(WHITE, color)
	tg.Rotation = 90
	tg.Parent = t
	if subtitle then
		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.AnchorPoint = Vector2.new(0.5, 0)
		s.Position = UDim2.fromScale(0.5, 0.72)
		s.Size = UDim2.new(0.6, 0, 0, 26)
		s.Font = Enum.Font.FredokaOne
		s.TextScaled = true
		s.Text = subtitle
		s.TextColor3 = WHITE
		s.ZIndex = 32
		s.Parent = band
	end
	tween(band, 0.28, { Position = UDim2.fromScale(0.5, 0.38) }, Enum.EasingStyle.Back)
	local sc = Instance.new("UIScale")
	sc.Scale = 1.4
	sc.Parent = t
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		tween(band, 0.25, { Position = UDim2.fromScale(1.6, 0.38) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(band, 0.3)
	end)
end

---------------------------------------------------------------------
-- COMPOSITE MOMENTS
---------------------------------------------------------------------
-- Transformation (Overdrive / Zenkai). isLocal = true for the owner's screen FX.
function VFX.Transform(character: Model, color: Color3, isLocal: boolean, title: string?)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local pos = root.Position
	local ground = pos - Vector3.new(0, 3, 0)
	VFX.Emit(pos, "Glow", 2, color)
	task.delay(0.15, function()
		VFX.Pillar(ground, color, 70, 7, 1.1)
		VFX.Ring(ground, color, 22, 0.6, 0.5)
		VFX.ShardRing(ground + Vector3.new(0, 1, 0), color, 26, 22, 0.6)
		VFX.Emit(pos, "Sparks", 50, color)
		VFX.Emit(pos, "Stars", 20, color)
		VFX.Emit(ground, "Smoke", 16, Color3.fromRGB(230, 230, 240))
		VFX.Light(pos, color, 40, 8, 1)
	end)
	if isLocal then
		VFX.FOVPunch(14)
		VFX.Shake(0.5)
		VFX.ScreenFlash(color, 0.15, 0.6)
		task.delay(0.15, function()
			VFX.ImpactFrame(color, 1.2)
			if title then
				VFX.TitleCard(title, nil, color, 1.4)
			end
		end)
	end
end

function VFX.LevelBurst(character: Model, color: Color3)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local ground = root.Position - Vector3.new(0, 3, 0)
	VFX.Ring(ground, color, 12, 0.5)
	VFX.Emit(root.Position, "Rise", 30, color)
	VFX.Emit(root.Position, "Stars", 12, color)
	VFX.Light(root.Position, color, 20, 4, 0.6)
end

---------------------------------------------------------------------
-- COMBAT EFFECTS (projectiles, charge orbs, zones, dashes)
---------------------------------------------------------------------
local projectiles = {}
local projConn: RBXScriptConnection? = nil

local function crescent(holder: BasePart, width: number, color: Color3)
	local half = math.rad(70)
	local radius = width * 0.55
	local a0 = arcAttachment(holder, radius, -half)
	local am = arcAttachment(holder, radius, 0)
	local a1 = arcAttachment(holder, radius, half)
	local ctrl = (4 / 3) * math.tan(half / 4) * radius
	local function mk(att0, att1, w0, w1, col, bright)
		local b = Instance.new("Beam")
		b.Attachment0 = att0
		b.Attachment1 = att1
		b.CurveSize0 = ctrl
		b.CurveSize1 = ctrl
		b.Width0 = w0
		b.Width1 = w1
		b.Segments = 20
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = bright
		b.Color = col
		b.Parent = holder
	end
	mk(a0, am, 0.1, width * 0.28, ColorSequence.new(color, WHITE), 5)
	mk(am, a1, width * 0.28, 0.1, ColorSequence.new(WHITE, color), 5)
	mk(a0, am, 0.05, width * 0.12, CS(WHITE), 8)
	mk(am, a1, width * 0.12, 0.05, CS(WHITE), 8)
end

local function makeProjectileVisual(kind: string, color: Color3, size: number)
	local holder
	if kind == "Orb" or kind == "Cero" then
		local s = kind == "Cero" and 1.1 or size
		holder = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * s, Color = color })
		local core = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.55, Color = WHITE })
		core.Name = "Core"
		core.Parent = holder
		local g = VFX.MakeEmitter("Glow", color, holder, 14)
		g.Lifetime = NumberRange.new(0.15)
		g.Size = NS(0, s * 1.6, 1, s * 2.2)
		VFX.MakeEmitter("Sparks", color, holder, 20).Speed = NumberRange.new(3, 8)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = 10 + s * 3
		l.Brightness = 3
		l.Parent = holder
	elseif kind == "Crescent" then
		holder = fxPart({ Size = Vector3.one * 0.2, Transparency = 1 })
		crescent(holder, size, color)
		VFX.MakeEmitter("Sparks", color, holder, 60).Speed = NumberRange.new(4, 12)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = 24
		l.Brightness = 4
		l.Parent = holder
	else -- Ray / bullet
		holder = fxPart({ Size = Vector3.new(0.22, 0.22, 3.5), Color = color })
		local core = fxPart({ Size = Vector3.new(0.1, 0.1, 3.6), Color = WHITE })
		core.Name = "Core"
		core.Parent = holder
	end
	-- trail
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = holder
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = holder
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = kind == "Crescent" and 0.3 or 0.12
	tr.LightEmission = 1
	tr.FaceCamera = true
	tr.Color = ColorSequence.new(WHITE, color)
	tr.Transparency = NS(0, 0.2, 1, 1)
	tr.WidthScale = NS(0, kind == "Crescent" and size or 1, 1, 0)
	tr.Parent = holder
	return holder
end

local function stepProjectiles(dt)
	for id, p in pairs(projectiles) do
		p.Traveled += p.Speed * dt
		local pos = p.Origin + p.Dir * math.min(p.Traveled, p.Range)
		local cf = CFrame.lookAt(pos, pos + p.Dir)
		p.Holder.CFrame = cf
		local core = p.Holder:FindFirstChild("Core")
		if core then
			(core :: BasePart).CFrame = cf
		end
		if p.Traveled >= p.Range then
			VFX.EndProjectile(id, pos, false)
		end
	end
	if next(projectiles) == nil and projConn then
		projConn:Disconnect()
		projConn = nil
	end
end

function VFX.StartProjectile(id, kind: string, origin: Vector3, dir: Vector3, speed: number, range: number, color: Color3, size: number?)
	local holder = makeProjectileVisual(kind, color, size or 1.5)
	projectiles[id] = { Holder = holder, Origin = origin, Dir = dir.Unit, Speed = speed, Range = range, Traveled = 0, Color = color, Kind = kind }
	holder.CFrame = CFrame.lookAt(origin, origin + dir)
	if not projConn then
		projConn = RunService.RenderStepped:Connect(stepProjectiles)
	end
end

function VFX.EndProjectile(id, pos: Vector3?, hit: boolean?, explode: number?)
	local p = projectiles[id]
	if not p then
		return
	end
	projectiles[id] = nil
	local at = pos or p.Holder.Position
	p.Holder.Transparency = 1
	for _, d in ipairs(p.Holder:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			d.Enabled = false
		elseif d:IsA("Beam") then
			d.Enabled = false
		elseif d:IsA("BasePart") then
			d.Transparency = 1
		end
	end
	Debris:AddItem(p.Holder, 0.6)
	if hit or explode then
		VFX.Flash(at, p.Color, explode and explode * 0.8 or (p.Kind == "Crescent" and 8 or 3), 0.2)
		VFX.Emit(at, "Sparks", explode and 40 or 10, p.Color)
		if explode then
			VFX.Explosion(at, p.Color, explode / 10)
		end
	end
end

function VFX.Muzzle(pos: Vector3, dir: Vector3, color: Color3)
	local p = fxPart({ Size = Vector3.new(0.6, 0.6, 1.4), CFrame = CFrame.lookAt(pos, pos + dir), Color = WHITE })
	tween(p, 0.08, { Size = Vector3.new(0.1, 0.1, 2.2), Transparency = 1 })
	Debris:AddItem(p, 0.1)
	VFX.Emit(pos, "Sparks", 5, color)
	VFX.Light(pos, color, 8, 3, 0.08)
end

-- A spinning energy orb that follows a part (Rasengan / charged shots).
function VFX.ChargeOrb(follow: BasePart, offset: Vector3, color: Color3, maxSize: number, chargeTime: number)
	local orb = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = color, Transparency = 0.25 })
	local core = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.15, Color = WHITE })
	local rings = {}
	for i = 1, 3 do
		local r = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, 0.4, 0.4), Color = color, Transparency = 0.3 })
		rings[i] = r
	end
	local e = VFX.MakeEmitter("Vortex", color, orb, 6)
	e.Size = NS(0, 1, 1, 2)
	local sp = VFX.MakeEmitter("Sparks", color, orb, 30)
	sp.Speed = NumberRange.new(2, 6)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 12
	l.Brightness = 3
	l.Parent = orb
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not follow.Parent then
			return
		end
		local t = os.clock() - start
		local k = math.clamp(t / chargeTime, 0, 1)
		local s = 0.4 + (maxSize - 0.4) * k
		local cf = follow.CFrame * CFrame.new(offset)
		orb.Size = Vector3.one * s
		orb.CFrame = cf
		core.Size = Vector3.one * s * 0.5
		core.CFrame = cf
		for i, r in ipairs(rings) do
			r.Size = Vector3.new(0.05, s * 1.25, s * 1.25)
			r.CFrame = cf * CFrame.Angles(t * (6 + i * 2), t * (4 + i), i)
		end
	end)
	return {
		Destroy = function()
			conn:Disconnect()
			orb:Destroy()
			core:Destroy()
			for _, r in ipairs(rings) do
				r:Destroy()
			end
		end,
		Position = function()
			return orb.Position
		end,
	}
end

-- Swirling vortex zone (Dimensional Rift, Reap pulls).
function VFX.Zone(pos: Vector3, radius: number, duration: number, color: Color3)
	local flat = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	local disc = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 0.5, 0.5), CFrame = flat, Color = color, Transparency = 0.35 })
	local inner = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 0.3, 0.3), CFrame = flat, Color = Color3.new(0, 0, 0), Transparency = 0.1, Material = Enum.Material.SmoothPlastic })
	tween(disc, 0.3, { Size = Vector3.new(0.2, radius * 2, radius * 2) }, Enum.EasingStyle.Back)
	tween(inner, 0.3, { Size = Vector3.new(0.25, radius * 1.2, radius * 1.2) }, Enum.EasingStyle.Back)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos + Vector3.new(0, 1, 0)
	a.Parent = workspace.Terrain
	local v = VFX.MakeEmitter("Vortex", color, a, 8)
	v.Size = NS(0, radius * 0.8, 1, radius * 1.6)
	v.LockedToPart = false
	local sp = VFX.MakeEmitter("Rise", color, a, 40)
	sp.Shape = Enum.ParticleEmitterShape.Cylinder
	sp.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		disc.CFrame = flat * CFrame.Angles(t * 4, 0, 0)
		inner.CFrame = flat * CFrame.Angles(-t * 6, 0, 0)
	end)
	task.delay(duration, function()
		conn:Disconnect()
		v.Enabled = false
		sp.Enabled = false
		tween(disc, 0.3, { Size = Vector3.new(0.2, 0.1, 0.1), Transparency = 1 })
		tween(inner, 0.3, { Size = Vector3.new(0.2, 0.1, 0.1), Transparency = 1 })
		Debris:AddItem(disc, 0.35)
		Debris:AddItem(inner, 0.35)
		Debris:AddItem(a, 2)
		VFX.Flash(pos, color, radius, 0.3)
	end)
end

-- Neon afterimage of a character (dashes).
function VFX.Afterimage(character: Model, color: Color3)
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "HumanoidRootPart" then
			local g = fxPart({ Size = d.Size, CFrame = d.CFrame, Color = color, Transparency = 0.45 })
			tween(g, 0.35, { Transparency = 1 })
			Debris:AddItem(g, 0.4)
		end
	end
end

-- Big frontal swipe used by cone skills.
function VFX.ConeSwipe(origin: CFrame, range: number, color: Color3)
	VFX.Slash(origin, color, range / 7, math.random() < 0.5)
	VFX.Slash(origin * CFrame.Angles(0, 0, math.rad(20)), WHITE, range / 8, true)
	local front = origin.Position + origin.LookVector * range * 0.6
	VFX.Emit(front, "Sparks", 20, color)
	VFX.Ring(front - Vector3.new(0, 2.5, 0), color, range * 0.6, 0.35)
end

function VFX.Nova(pos: Vector3, radius: number, color: Color3)
	VFX.Ring(pos - Vector3.new(0, 2.5, 0), color, radius, 0.4)
	VFX.ShardRing(pos - Vector3.new(0, 2, 0), color, radius, 18, 0.4)
	VFX.Emit(pos, "Sparks", 24, color)
	VFX.Flash(pos, color, radius * 0.5, 0.2)
end

-- Rectangular ground telegraph for lunges / line attacks.
function VFX.TelegraphLine(pos: Vector3, dir: Vector3, length: number, width: number, t: number)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	flatDir = flatDir.Magnitude > 0 and flatDir.Unit or Vector3.new(0, 0, -1)
	local center = pos + flatDir * (length / 2)
	local cf = CFrame.lookAt(center, center + flatDir)
	local outline = fxPart({ Size = Vector3.new(width, 0.1, length), CFrame = cf, Color = Color3.fromRGB(255, 40, 40), Transparency = 0.6 })
	local fill = fxPart({ Size = Vector3.new(width, 0.15, 0.2), CFrame = CFrame.lookAt(pos, pos + flatDir) * CFrame.new(0, 0, -0.1), Color = Color3.fromRGB(255, 90, 40), Transparency = 0.35 })
	tween(fill, t, { Size = Vector3.new(width, 0.15, length), CFrame = cf }, Enum.EasingStyle.Linear)
	task.delay(t, function()
		outline:Destroy()
		fill:Destroy()
	end)
end

-- Straight energy streak between two points (dash strikes, lunges).
function VFX.Streak(from: Vector3, to: Vector3, color: Color3, width: number?)
	local d = (to - from).Magnitude
	if d < 0.5 then
		return
	end
	local w = width or 1.2
	local p = fxPart({ Size = Vector3.new(w, w * 0.4, d), CFrame = CFrame.lookAt((from + to) / 2, to), Color = color, Transparency = 0.1 })
	local core = fxPart({ Size = Vector3.new(w * 0.35, w * 0.2, d), CFrame = p.CFrame, Color = WHITE })
	tween(p, 0.3, { Size = Vector3.new(0.05, 0.05, d), Transparency = 1 })
	tween(core, 0.3, { Size = Vector3.new(0.02, 0.02, d), Transparency = 1 })
	Debris:AddItem(p, 0.35)
	Debris:AddItem(core, 0.35)
end

return VFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[--!nonstrict
-- WeaponModels (ModuleScript) -> ReplicatedStorage/GameShared/WeaponModels
-- Builds every weapon from parts (no uploads needed). Rarity adds glow,
-- trails (Epic+), light + sparkles (Legendary+) and an aura (Mythic).
-- Models are built with the blade along +Y of the "Grip" part.

local Config = require(script.Parent:WaitForChild("Config"))
local VFX = require(script.Parent:WaitForChild("VFX"))

local WeaponModels = {}

local WHITE = Color3.new(1, 1, 1)

local function newModel(name: string): (Model, Part)
	local m = Instance.new("Model")
	m.Name = name
	local grip = Instance.new("Part")
	grip.Name = "Grip"
	grip.Size = Vector3.new(0.3, 0.3, 0.3)
	grip.Transparency = 1
	grip.CanCollide = false
	grip.CanQuery = false
	grip.CanTouch = false
	grip.Massless = true
	grip.CFrame = CFrame.new()
	grip.Parent = m
	m.PrimaryPart = grip
	return m, grip
end

local function part(m: Model, grip: BasePart, props, cf: CFrame): Part
	local p = Instance.new("Part")
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Metal
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.CFrame = grip.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = grip
	w.Part1 = p
	w.Parent = p
	p.Parent = m
	return p
end

local function attach(parent: BasePart, name: string, pos: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos
	a.Parent = parent
	return a
end

local function etch(blade: BasePart, text: string, color: Color3)
	for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
		local sg = Instance.new("SurfaceGui")
		sg.Name = "Etch"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 90
		sg.LightInfluence = 0
		sg.Parent = blade
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Rotation = 0
		t.Text = text
		t.TextColor3 = color
		t.Parent = sg
	end
end

---------------------------------------------------------------------
-- CLASS BUILDERS  (return model, primary effect part, glow color)
---------------------------------------------------------------------
local builders = {}

builders.Katana = function(w, glow)
	local m, grip = newModel(w.Name)
	part(m, grip, { Name = "Handle", Size = Vector3.new(0.24, 1.2, 0.24), Color = w.Accent, Material = Enum.Material.Fabric }, CFrame.new(0, 0, 0))
	part(m, grip, { Name = "Pommel", Size = Vector3.new(0.28, 0.12, 0.28), Color = Color3.fromRGB(200, 170, 90) }, CFrame.new(0, -0.66, 0))
	part(m, grip, { Name = "Tsuba", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 0.62, 0.62), Color = Color3.fromRGB(40, 35, 30) }, CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local len = 4 + (w.Rarity == "Legendary" and 0.4 or 0)
	local blade = part(m, grip, { Name = "Blade", Size = Vector3.new(0.07, len, 0.26), Color = w.Blade, Reflectance = 0.2 }, CFrame.new(0, 0.7 + len / 2, 0))
	part(m, grip, { Name = "Tip", Size = Vector3.new(0.07, 0.19, 0.19), Color = w.Blade }, CFrame.new(0, 0.7 + len, 0.04) * CFrame.Angles(math.rad(45), 0, 0))
	if glow then
		part(m, grip, { Name = "Edge", Size = Vector3.new(0.08, len * 0.96, 0.05), Color = glow, Material = Enum.Material.Neon }, CFrame.new(0, 0.7 + len / 2, 0.13))
	end
	attach(blade, "TrailA", Vector3.new(0, -len / 2 + 0.2, 0))
	attach(blade, "TrailB", Vector3.new(0, len / 2, 0))
	return m, blade
end

builders.Greatsword = function(w, glow)
	local m, grip = newModel(w.Name)
	part(m, grip, { Name = "Handle", Size = Vector3.new(0.34, 1.7, 0.34), Color = w.Accent, Material = Enum.Material.Fabric }, CFrame.new(0, 0, 0))
	part(m, grip, { Name = "Guard", Size = Vector3.new(0.45, 0.35, 1.5), Color = Color3.fromRGB(60, 55, 60) }, CFrame.new(0, 0.95, 0))
	local len = 5.6
	local blade = part(m, grip, { Name = "Blade", Size = Vector3.new(0.2, len, 1.35), Color = w.Blade, Reflectance = 0.1 }, CFrame.new(0, 1.1 + len / 2, 0.1))
	part(m, grip, { Name = "Tip", Size = Vector3.new(0.2, 0.95, 0.95), Color = w.Blade }, CFrame.new(0, 1.1 + len, 0.1) * CFrame.Angles(math.rad(45), 0, 0))
	part(m, grip, { Name = "Spine", Size = Vector3.new(0.22, len * 0.97, 0.12), Color = w.Accent }, CFrame.new(0, 1.1 + len / 2, -0.55))
	if glow then
		part(m, grip, { Name = "Edge", Size = Vector3.new(0.22, len * 0.97, 0.08), Color = glow, Material = Enum.Material.Neon }, CFrame.new(0, 1.1 + len / 2, 0.78))
	end
	if w.Id == "Zangetsu" then
		-- cloth wrap + chain at the pommel
		for i = 1, 4 do
			part(m, grip, { Name = "Chain", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22, Color = Color3.fromRGB(200, 200, 210) }, CFrame.new(0, -0.9 - i * 0.22, 0.05 * i))
		end
		part(m, grip, { Name = "Wrap", Size = Vector3.new(0.36, 1.2, 0.36), Color = WHITE, Material = Enum.Material.Fabric }, CFrame.new(0, 0.1, 0))
	end
	attach(blade, "TrailA", Vector3.new(0, -len / 2 + 0.3, 0))
	attach(blade, "TrailB", Vector3.new(0, len / 2, 0))
	return m, blade
end

local function pistol(w, glow, name)
	local m, grip = newModel(name)
	part(m, grip, { Name = "Handle", Size = Vector3.new(0.28, 0.75, 0.42), Color = w.Accent }, CFrame.new(0, 0, -0.1) * CFrame.Angles(math.rad(-15), 0, 0))
	local barrel = part(m, grip, { Name = "Barrel", Size = Vector3.new(0.32, 1.7, 0.42), Color = w.Blade }, CFrame.new(0, 0.9, 0.12))
	part(m, grip, { Name = "Muzzle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.18, 0.3, 0.3), Color = Color3.fromRGB(30, 30, 35) }, CFrame.new(0, 1.8, 0.12) * CFrame.Angles(0, 0, math.rad(90)))
	if glow then
		part(m, grip, { Name = "Glow", Size = Vector3.new(0.34, 1.2, 0.08), Color = glow, Material = Enum.Material.Neon }, CFrame.new(0, 0.9, 0.35))
	end
	attach(barrel, "Muzzle", Vector3.new(0, 0.95, 0))
	attach(barrel, "TrailA", Vector3.new(0, -0.6, 0))
	attach(barrel, "TrailB", Vector3.new(0, 0.9, 0))
	return m, barrel
end

builders.Pistols = function(w, glow)
	local main, eff = pistol(w, glow, w.Name)
	local off = pistol(w, glow, w.Name .. " (Off-hand)")
	return main, eff, off
end

local function glove(w, glow, name)
	local m, grip = newModel(name)
	local body = part(m, grip, { Name = "Glove", Size = Vector3.new(0.75, 0.55, 0.75), Color = w.Blade, Material = Enum.Material.Fabric }, CFrame.new())
	part(m, grip, { Name = "Cuff", Size = Vector3.new(0.85, 0.25, 0.85), Color = w.Accent }, CFrame.new(0, 0.35, 0))
	if glow then
		part(m, grip, { Name = "Knuckles", Size = Vector3.new(0.8, 0.12, 0.3), Color = glow, Material = Enum.Material.Neon }, CFrame.new(0, -0.15, -0.36))
	end
	attach(body, "TrailA", Vector3.new(0, 0.2, 0))
	attach(body, "TrailB", Vector3.new(0, -0.3, 0))
	return m, body
end

builders.Glove = function(w, glow)
	local main, eff = glove(w, glow, w.Name)
	local off = glove(w, glow, w.Name .. " (Off-hand)")
	return main, eff, off
end

builders.FingerGun = function(w, glow)
	local m, grip = newModel(w.Name)
	local tip = part(m, grip, { Name = "Fingertip", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35, Color = glow or w.Blade, Material = Enum.Material.Neon }, CFrame.new(0, -0.45, 0))
	part(m, grip, { Name = "Ring", Size = Vector3.new(0.5, 0.12, 0.5), Color = w.Accent, Material = Enum.Material.Neon, Transparency = 0.3 }, CFrame.new(0, 0.1, 0))
	attach(tip, "Muzzle", Vector3.zero)
	attach(tip, "TrailA", Vector3.new(0, 0.15, 0))
	attach(tip, "TrailB", Vector3.new(0, -0.15, 0))
	return m, tip
end

builders.Scythe = function(w, glow)
	local m, grip = newModel(w.Name)
	local pole = part(m, grip, { Name = "Pole", Size = Vector3.new(0.2, 7, 0.2), Color = w.Accent, Material = Enum.Material.Wood }, CFrame.new(0, 2.3, 0))
	part(m, grip, { Name = "Cap", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35, Color = glow or w.Blade, Material = glow and Enum.Material.Neon or Enum.Material.Metal }, CFrame.new(0, -1.25, 0))
	-- curved blade built from rotated segments
	local seg = 6
	local lastBlade = pole
	for i = 1, seg do
		local t = i / seg
		local ang = math.rad(10 + t * 55)
		local cf = CFrame.new(0, 5.6 + math.sin(ang) * 0.6, -0.1 - t * 2.9) * CFrame.Angles(-ang * 0.6, 0, 0)
		lastBlade = part(m, grip, { Name = "Blade", Size = Vector3.new(0.08, 0.55 - t * 0.35, 0.62), Color = w.Blade, Reflectance = 0.15 }, cf)
		if glow then
			part(m, grip, { Name = "Edge", Size = Vector3.new(0.09, 0.06, 0.62), Color = glow, Material = Enum.Material.Neon }, cf * CFrame.new(0, -(0.55 - t * 0.35) / 2, 0))
		end
	end
	attach(pole, "TrailA", Vector3.new(0, 2.8, 0))
	attach(lastBlade, "TrailB", Vector3.zero)
	return m, pole
end

---------------------------------------------------------------------
-- rarity dressing
---------------------------------------------------------------------
local function dress(m: Model, effectPart: BasePart, w, rarity, glow: Color3)
	if not m then
		return
	end
	local a0 = m:FindFirstChild("TrailA", true)
	local a1 = m:FindFirstChild("TrailB", true)
	if rarity.Trail and a0 and a1 then
		local tr = Instance.new("Trail")
		tr.Name = "RarityTrail"
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.25
		tr.MinLength = 0.05
		tr.LightEmission = 1
		tr.LightInfluence = 0
		tr.FaceCamera = true
		tr.Transparency = VFX.NS(0, 0.15, 1, 1)
		tr.WidthScale = VFX.NS(0, 1, 1, 0.1)
		if rarity.Rainbow then
			tr.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 80)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 220, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
			})
		else
			tr.Color = ColorSequence.new(WHITE, glow)
		end
		tr.Parent = effectPart
	end
	if rarity.Index >= 5 then
		local l = Instance.new("PointLight")
		l.Color = glow
		l.Range = 9
		l.Brightness = 1.6
		l.Shadows = false
		l.Parent = effectPart
		VFX.MakeEmitter("Stars", glow, effectPart, 4)
	end
	if rarity.Aura then
		local e = VFX.MakeEmitter("Aura", glow, effectPart, 14)
		e.Size = VFX.NS(0, 0.5, 0.5, 0.9, 1, 0)
		e.Speed = NumberRange.new(1, 3)
	end
end

-- Build a weapon. Returns { Main = Model, Off = Model?, Effect = BasePart }
function WeaponModels.Build(weaponId: string, rarityId: string?, forgeLevel: number?)
	local w = Config.WeaponById[weaponId] or Config.WeaponById[Config.StarterWeapon]
	local rarity = Config.WeaponRarityById[rarityId or w.Rarity] or Config.WeaponRarities[1]
	local glow = w.Glow or (rarity.Index >= 3 and rarity.Color) or nil
	local builder = builders[w.Class] or builders.Katana
	local main, effect, off = builder(w, glow)
	dress(main, effect, w, rarity, glow or rarity.Color)
	if off then
		local offEffect = off:FindFirstChild("Glove") or off:FindFirstChild("Barrel")
		if offEffect then
			dress(off, offEffect, w, rarity, glow or rarity.Color)
		end
	end
	if forgeLevel and forgeLevel > 0 then
		local blade = main:FindFirstChild("Blade")
		if blade and (w.Class == "Katana" or w.Class == "Greatsword") then
			etch(blade, "+" .. forgeLevel, glow or Color3.fromRGB(255, 220, 140))
		end
	end
	main:SetAttribute("WeaponId", w.Id)
	return { Main = main, Off = off, Effect = effect, Glow = glow or rarity.Color }
end

-- Weld a built weapon to a character's hands (R15 or R6).
function WeaponModels.AttachToCharacter(character: Model, built)
	local function hand(side: string): BasePart?
		return (character:FindFirstChild(side .. "Hand") or character:FindFirstChild(side .. " Arm")) :: any
	end
	local function weldTo(model: Model?, side: string)
		if not model then
			return
		end
		local h = hand(side)
		if not h then
			model:Destroy()
			return
		end
		local grip = model.PrimaryPart :: BasePart
		local gripAtt = h:FindFirstChild(side .. "GripAttachment") :: Attachment?
		local isGlove = model:FindFirstChild("Glove") ~= nil or model:FindFirstChild("Fingertip") ~= nil
		local c0
		if isGlove then
			c0 = CFrame.new(0, h.Name:find("Arm") and -0.8 or 0, 0)
		elseif gripAtt then
			c0 = gripAtt.CFrame
		else
			c0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
		end
		model:PivotTo(h.CFrame * c0)
		local weld = Instance.new("Weld")
		weld.Name = "WeaponWeld"
		weld.Part0 = h
		weld.Part1 = grip
		weld.C0 = c0
		weld.C1 = CFrame.new()
		weld.Parent = grip
		model.Name = "EquippedWeapon_" .. side
		model.Parent = character
	end
	weldTo(built.Main, "Right")
	weldTo(built.Off, "Left")
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
-- Server (Script) -> ServerScriptService/Server
-- Entry point. All the ModuleScripts listed in SETUP.md go INSIDE this Script.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local Net = require(script:WaitForChild("Net"))
local DataService = require(script:WaitForChild("DataService"))
local Stats = require(script:WaitForChild("Stats"))
local MapBuilder = require(script:WaitForChild("MapBuilder"))
local Weapons = require(script:WaitForChild("Weapons"))
local Playtime = require(script:WaitForChild("Playtime"))
local Cosmetics = require(script:WaitForChild("Cosmetics"))
local Loot = require(script:WaitForChild("Loot"))
local EnemyService = require(script:WaitForChild("EnemyService"))
local TowerService = require(script:WaitForChild("TowerService"))
local Combat = require(script:WaitForChild("Combat"))
local Monetization = require(script:WaitForChild("Monetization"))
local Actions = require(script:WaitForChild("Actions"))
local Util = require(script:WaitForChild("Util"))

---------------------------------------------------------------------
-- WORLD
---------------------------------------------------------------------
local map = MapBuilder.Build()
task.spawn(EnemyService.Init, map) -- builds enemy rigs (yields), players can join meanwhile
TowerService.Init(map)
Combat.Init(map)
Actions.Init(map)


---------------------------------------------------------------------
-- PORTALS
---------------------------------------------------------------------
-- Prompts use Style = Custom. The client draws them (Client/PromptUI) and
-- fires Remotes.Interact on Triggered; Actions validates and runs them.

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function portalDebounce(player: Player): boolean
	local s = DataService.Session(player)
	if not s or os.clock() - s.LastPortal < 2 then
		return false
	end
	s.LastPortal = os.clock()
	return true
end

for zoneId, portal in pairs(map.Portals) do
	local zone = Config.Zones[zoneId]
	if not zone.ComingSoon then
		portal.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if not player or not portalDebounce(player) then
				return
			end
			local data = DataService.Get(player)
			if not data then
				return
			end
			if data.Blade < (zone.BladeReq or 0) then
				Net.Notify(player, zone.Name .. " needs Blade +" .. zone.BladeReq .. ". Forge more ore!", Color3.fromRGB(255, 110, 90), "Error")
				return
			end
			local dungeon = map.Dungeons[zoneId]
			if dungeon then
				Util.Teleport(player, dungeon.StartCFrame, zone.Name)
			end
		end)
	end
end

for _, ret in ipairs(CollectionService:GetTagged("ReturnPortal")) do
	ret.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player and portalDebounce(player) then
			Util.Teleport(player, map.HubCFrame, "Hub")
		end
	end)
end

---------------------------------------------------------------------
-- SYNC + LEADERSTATS
---------------------------------------------------------------------
local function setStat(player: Player, name: string, value: string)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then
		(v :: StringValue).Value = value
	end
end

DataService.OnFlush = function(player: Player)
	local snap = Stats.Snapshot(player)
	if snap then
		Net.Sync:FireClient(player, snap)
		setStat(player, "Power", Format.Abbrev(snap.Power))
		setStat(player, "Forge", "+" .. Format.Abbrev(snap.Blade))
		setStat(player, "Rebirths", Format.Abbrev(snap.Rebirths))
	end
end

Monetization.OnPassesChanged = function(player: Player)
	Cosmetics.Apply(player)
	Actions.ApplyCharacter(player)
end

Playtime.OnCosmeticsChanged = function(player: Player)
	Cosmetics.Apply(player)
end

EnemyService.OnZenkai = function(player: Player)
	Cosmetics.RefreshTransform(player)
end

---------------------------------------------------------------------
-- PLAYERS
---------------------------------------------------------------------
local function onCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then
		return
	end
	while player.Parent and not DataService.IsLoaded(player) do
		task.wait(0.2)
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	task.wait(0.1)
	Weapons.EnsureStarter(player)
	Weapons.Refresh(player)
	Cosmetics.Apply(player)
	Actions.ApplyCharacter(player)
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in ipairs({ "Power", "Forge", "Rebirths" }) do
		local v = Instance.new("StringValue")
		v.Name = name
		v.Value = "0"
		v.Parent = ls
	end
	ls.Parent = player

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)

	DataService.Load(player)
	Monetization.LoadPasses(player)
	Weapons.EnsureStarter(player)
	Playtime.OnJoin(player)
	player:SetAttribute("Stamina", Config.Balance.MaxStamina)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	DataService.MarkDirty(player)
	Actions.InitialRoll(player, 5)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	TowerService.PlayerRemoving(player)
	Actions.PlayerRemoving(player)
	DataService.Release(player)
end)

---------------------------------------------------------------------
-- BUFF TIMERS + DROP CLEANUP
---------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, player in ipairs(Players:GetPlayers()) do
			local s = DataService.Session(player)
			if s then
				local active = Stats.OverdriveActive(player) or Stats.ZenkaiActive(player)
				if active ~= (s.TransformShown == true) then
					s.TransformShown = active
					Cosmetics.RefreshTransform(player)
					Actions.ApplyCharacter(player)
					DataService.MarkDirty(player)
				end
				Loot.CleanupDrops(player)
			end
		end
	end
end)

---------------------------------------------------------------------
-- GLOBAL LEADERBOARD (Top Blade levels)
---------------------------------------------------------------------
task.spawn(function()
	local ok, board = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if not ok then
		map.LeaderboardText.Text = "Leaderboard needs\nStudio API access"
		return
	end
	local names = {}
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			if data then
				pcall(function()
					board:SetAsync(tostring(player.UserId), math.floor(data.Blade))
				end)
			end
		end
		local success, pages = pcall(function()
			return board:GetSortedAsync(false, 10)
		end)
		if success and pages then
			local lines = {}
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				local userId = tonumber(entry.key)
				local name = userId and names[userId]
				if userId and not name then
					local okName, result = pcall(Players.GetNameFromUserIdAsync, Players, userId)
					name = okName and result or ("User " .. entry.key)
					names[userId] = name
				end
				local color = rank == 1 and "#ffd75a" or (rank == 2 and "#dfe6f0" or (rank == 3 and "#ff9e5a" or "#ffffff"))
				table.insert(lines, string.format('<font color="%s">%d. %s</font>  +%s', color, rank, name or "?", Format.Abbrev(entry.value)))
			end
			map.LeaderboardText.Text = #lines > 0 and table.concat(lines, "\n") or "No blades forged yet!"
		else
			map.LeaderboardText.Text = "Leaderboard unavailable\n(enable Studio API access)"
		end
		task.wait(90)
	end
end)

print(("[%s] server ready"):format(Config.GameName))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Actions (ModuleScript) -> ServerScriptService/Server/Actions
-- Handles every client request (forge, sell, upgrade, rebirth, race reroll,
-- overdrive, codes, teleports, shop, tower) with server-side validation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local Cosmetics = require(script.Parent:WaitForChild("Cosmetics"))
local Monetization = require(script.Parent:WaitForChild("Monetization"))
local TowerService = require(script.Parent:WaitForChild("TowerService"))
local Util = require(script.Parent:WaitForChild("Util"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))

local Actions = {}
local map = nil

local RED = Color3.fromRGB(255, 110, 90)

local function near(player: Player, part: BasePart?, dist: number): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root ~= nil and part ~= nil and (root.Position - part.Position).Magnitude <= dist
end

function Actions.ApplyCharacter(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not hum then
		return
	end
	hum.WalkSpeed = Stats.WalkSpeed(player)
end

---------------------------------------------------------------------
local handlers = {}

handlers.Collect = function(player, id)
	Loot.Collect(player, id)
end

handlers.Forge = function(player, oreId)
	if not near(player, map.Forge, 32) then
		Net.Notify(player, "Bring your ore to the Forge cauldron in the Hub!", RED, "Error")
		return
	end
	if type(oreId) ~= "string" then
		oreId = nil
	end
	if Loot.Forge(player, oreId) <= 0 then
		Net.Notify(player, "No ore to forge. Go slay monsters in the Dungeon!", RED, "Error")
	end
end

handlers.Sell = function(player, oreId)
	if not near(player, map.Sell, 30) then
		Net.Notify(player, "Visit the Sell stall in the Hub to sell ore.", RED, "Error")
		return
	end
	if type(oreId) ~= "string" then
		oreId = nil
	end
	if Loot.Sell(player, oreId) <= 0 then
		Net.Notify(player, "Nothing to sell.", RED, "Error")
	end
end

handlers.Upgrade = function(player, key)
	local data = DataService.Get(player)
	if type(key) ~= "string" or not Config.Upgrades[key] then
		return
	end
	local level = data.Upgrades[key]
	local cost = Stats.UpgradeCost(key, level)
	if not cost then
		Net.Notify(player, Config.Upgrades[key].Name .. " is maxed!", RED, "Error")
		return
	end
	if data.Coins < cost then
		Net.Notify(player, "Not enough Coins (" .. Format.Abbrev(cost) .. " needed).", RED, "Error")
		return
	end
	data.Coins -= cost
	data.Upgrades[key] = level + 1
	Net.FX(player, "Upgraded", { Key = key, Level = level + 1 })
	DataService.MarkDirty(player)
end

handlers.Rebirth = function(player)
	local data = DataService.Get(player)
	local req = Stats.RebirthReq(data)
	if data.Power < req then
		Net.Notify(player, "You need " .. Format.Abbrev(req) .. " Power to Rebirth.", RED, "Error")
		return
	end
	local keep = Stats.Race(data).Id == "Isekai" and math.floor(data.Power * 0.1) or 0
	data.Rebirths += 1
	data.Power = keep
	data.Coins = 0
	data.Rerolls += Config.RebirthRerollReward
	TowerService.Leave(player)
	Util.Teleport(player, map.HubCFrame, "Hub")
	Net.FXAll("Rebirth", { Player = player, Rebirths = data.Rebirths })
	Cosmetics.Apply(player)
	DataService.MarkDirty(player)
end

function Actions.RollRace(player: Player, initial: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if not initial then
		if data.Rerolls <= 0 then
			Net.Notify(player, "No Race Rerolls left! Get more from bosses, rebirths, codes or the Shop.", RED, "Error")
			return
		end
		data.Rerolls -= 1
	end
	local raceId, tierId = Stats.RollRace(player)
	data.Race = raceId
	data.RaceTier = tierId
	Net.FX(player, "RaceRoll", { Race = raceId, Tier = tierId, Initial = initial })
	-- let the slot-machine animation finish before auras appear
	task.delay(2.6, function()
		if player.Parent then
			Cosmetics.Apply(player)
			Actions.ApplyCharacter(player)
			if raceId == "MainCharacter" or tierId == "Mythic" then
				Net.FXAll("Transform", { Player = player, Kind = "Awaken", Color = Config.RaceById[raceId].Color })
			end
		end
	end)
	DataService.MarkDirty(player)
end

handlers.Reroll = function(player)
	Actions.RollRace(player, false)
end

handlers.Overdrive = function(player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if Stats.OverdriveActive(player) then
		Net.Notify(player, "Overdrive is already active!", RED, "Error")
		return
	end
	if data.Overdrive <= 0 then
		Net.Notify(player, "No Overdrive potions. Get them from codes or the Shop.", RED, "Error")
		return
	end
	data.Overdrive -= 1
	local duration = Stats.OverdriveDuration(player)
	s.OverdriveEnd = Stats.Now() + duration
	Net.FXAll("Transform", { Player = player, Kind = "Overdrive", Color = Stats.Race(data).Color })
	Cosmetics.RefreshTransform(player)
	Actions.ApplyCharacter(player)
	DataService.MarkDirty(player)
end

handlers.Redeem = function(player, code)
	local data = DataService.Get(player)
	if type(code) ~= "string" or #code > 40 then
		return
	end
	code = string.upper((code:gsub("%s", "")))
	local grants = Config.Codes[code]
	if not grants then
		Net.Notify(player, "Invalid code.", RED, "Error")
		return
	end
	if data.Codes[code] then
		Net.Notify(player, "You already redeemed that code.", RED, "Error")
		return
	end
	data.Codes[code] = true
	local text = Monetization.Grant(player, grants)
	Net.FX(player, "Purchase", { Name = "Code " .. code, Text = text })
	DataService.MarkDirty(player)
end

handlers.Teleport = function(player, dest)
	local data = DataService.Get(player)
	if type(dest) ~= "string" then
		return
	end
	if TowerService.InTower(player) then
		Net.Notify(player, "Leave the Tower first.", RED, "Error")
		return
	end
	if dest == "Hub" then
		Util.Teleport(player, map.HubCFrame, "Hub")
		return
	end
	if not Stats.HasPass(player, "FastTravel") then
		Net.Notify(player, "Fast Travel gamepass needed. Use the portals in the Hub for free!", RED, "Error")
		return
	end
	if dest == "Train" then
		Util.Teleport(player, map.TrainCFrame, "Train Area")
	elseif dest == "Tower" then
		Util.Teleport(player, map.TowerCFrame, "Tower")
	elseif dest:sub(1, 6) == "Stage_" then
		local idx = tonumber(dest:sub(7))
		local stage = idx and Config.Stages[idx]
		if not stage then
			return
		end
		if not Stats.StageUnlocked(data, idx) then
			Net.Notify(player, "Stage " .. idx .. " is locked.", RED, "Error")
			return
		end
		local dungeon = map.Dungeons[stage.Zone]
		local info = dungeon and dungeon.Stages[idx]
		if info then
			Util.Teleport(player, info.Entry, "Stage " .. idx)
		end
	end
end

handlers.BuyPass = function(player, key)
	if type(key) == "string" then
		Monetization.PromptPass(player, key)
	end
end

handlers.BuyProduct = function(player, key)
	if type(key) == "string" then
		Monetization.PromptProduct(player, key)
	end
end

handlers.TowerStart = function(player)
	TowerService.Start(player)
end

handlers.TowerLeave = function(player)
	TowerService.Leave(player)
end

handlers.Settings = function(player, settings)
	local data = DataService.Get(player)
	if type(settings) ~= "table" then
		return
	end
	data.Settings.Music = settings.Music == true
	data.Settings.SFX = settings.SFX == true
end

-- First-time players get a free race roll once their client is ready.
function Actions.InitialRoll(player: Player, delay: number)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s or data.Race ~= "" or s.InitialRoll then
		return
	end
	s.InitialRoll = true
	task.delay(delay, function()
		if player.Parent and DataService.Get(player) then
			Actions.RollRace(player, true)
		end
	end)
end

handlers.Ready = function(player)
	DataService.MarkDirty(player)
	Actions.InitialRoll(player, 1.5)
end

---------------------------------------------------------------------
-- WEAPONS / CHESTS / POWER
---------------------------------------------------------------------
handlers.Equip = function(player, uid)
	Weapons.Equip(player, uid)
	Cosmetics.Apply(player)
end

handlers.Scrap = function(player, uid)
	Weapons.Scrap(player, uid)
end

function Actions.ChestCost(data, chest): number
	return math.floor((chest.CoinCost or 0) * (1 + data.Rebirths))
end

handlers.OpenChest = function(player, chestId)
	local data = DataService.Get(player)
	local chest = type(chestId) == "string" and Config.ChestById[chestId]
	if not chest then
		return
	end
	if chest.Key then
		if (data.Keys[chest.Key] or 0) <= 0 then
			Net.Notify(player, "You need a " .. Config.KeyNames[chest.Key] .. ". Earn them from play-time rewards!", RED, "Error")
			return
		end
		data.Keys[chest.Key] -= 1
	else
		local cost = Actions.ChestCost(data, chest)
		if data.Coins < cost then
			Net.Notify(player, "Not enough Coins (" .. Format.Abbrev(cost) .. " needed).", RED, "Error")
			return
		end
		data.Coins -= cost
	end
	local weaponId, rarityId = Weapons.Roll(chest.MinRarity, 1)
	local uid = Weapons.Add(player, weaponId, rarityId)
	Net.FX(player, "ChestResult", { Chest = chest.Id, Weapon = weaponId, Rarity = rarityId, Uid = uid })
	DataService.MarkDirty(player)
end

handlers.BuyPower = function(player)
	Monetization.PromptPowerTier(player)
end

---------------------------------------------------------------------
-- CUSTOM PROXIMITY PROMPTS (client fires Interact after Triggered)
---------------------------------------------------------------------
local PANEL_FOR = { Upgrades = "Upgrades", Race = "Race", Rebirth = "Rebirth", Index = "Index", Chests = "Chests" }

handlers.Interact = function(player, prompt)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then
		return
	end
	if not prompt:IsDescendantOf(map.Root) then
		return
	end
	local parent = prompt.Parent
	local pos = parent and (parent:IsA("BasePart") and parent.Position or (parent:IsA("Attachment") and parent.WorldPosition))
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not pos or not root or (root.Position - pos).Magnitude > prompt.MaxActivationDistance + 6 then
		return
	end
	local action = prompt:GetAttribute("Action")
	if action == "Forge" then
		handlers.Forge(player, nil)
	elseif action == "Sell" then
		Net.FX(player, "OpenPanel", { Name = "Backpack", Mode = "Sell" })
	elseif action == "Tower" then
		TowerService.Start(player)
	elseif PANEL_FOR[action] then
		Net.FX(player, "OpenPanel", { Name = PANEL_FOR[action] })
	end
end

---------------------------------------------------------------------
local lastRequests: { [Player]: { number } } = {}

function Actions.Handle(player: Player, action, arg)
	if type(action) ~= "string" or not DataService.Get(player) then
		return
	end
	-- simple rate limit: 25 requests per second
	local t = os.clock()
	local list = lastRequests[player]
	if not list then
		list = {}
		lastRequests[player] = list
	end
	while list[1] and t - list[1] > 1 do
		table.remove(list, 1)
	end
	if #list >= 25 then
		return
	end
	table.insert(list, t)

	local fn = handlers[action]
	if fn then
		local ok, err = pcall(fn, player, arg)
		if not ok then
			warn("[Actions] " .. action .. " failed: " .. tostring(err))
		end
	end
end

function Actions.PlayerRemoving(player: Player)
	lastRequests[player] = nil
end

function Actions.Init(m)
	map = m
	Net.Request.OnServerEvent:Connect(Actions.Handle)
	Net.Interact.OnServerEvent:Connect(function(player, prompt)
		Actions.Handle(player, "Interact", prompt)
	end)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Combat (ModuleScript) -> ServerScriptService/Server/Combat
-- Server-authoritative abilities bound on the client with ContextActionService:
--   LMB  basic attack / combo (also trains Power)
--   Q    dash (short i-frames)
--   E    weapon skill (signature skill on iconic weapons)
--   R    class ultimate
--   C    Overdrive (handled in Actions)
-- Stamina, cooldowns (with the global nerf multipliers), stun caps and
-- damage caps are all enforced here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local Projectiles = require(script.Parent:WaitForChild("Projectiles"))

local Combat = {}
local map = nil
local B = Config.Balance

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include
wallParams.RespectCanCollide = true

---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function rootOf(player: Player): BasePart?
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then
		return nil
	end
	return c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

local function readAim(payload, root: BasePart): Vector3
	local aim = type(payload) == "table" and payload.Aim
	if typeof(aim) == "Vector3" and aim.Magnitude > 0.5 and aim.Magnitude < 2 then
		-- horizontal: projectiles fly at chest height and never dive into the floor
		return flat(aim)
	end
	return flat(root.CFrame.LookVector)
end

local function limitByWalls(from: Vector3, dir: Vector3, dist: number): number
	local hit = workspace:Raycast(from, dir * dist, wallParams)
	if hit then
		return math.max(0, (hit.Position - from).Magnitude - 2)
	end
	return dist
end

function Combat.PadAt(player: Player)
	local root = rootOf(player)
	if not root or not map then
		return nil, nil
	end
	local pos = root.Position
	for _, pad in ipairs(map.TrainPads) do
		local d = Vector3.new(pos.X - pad.Position.X, 0, pos.Z - pad.Position.Z).Magnitude
		if d <= Config.TrainPadRadius and math.abs(pos.Y - pad.Position.Y) < 7 then
			return pad.Index, pad.Config
		end
	end
	return nil, nil
end

local function padReqText(pad): string
	if pad.Rebirths > 0 then
		return pad.Rebirths .. " Rebirth" .. (pad.Rebirths > 1 and "s" or "")
	end
	return Format.Abbrev(pad.Power) .. " Power"
end

local function spendStamina(player: Player, s, cost: number): boolean
	if s.Stamina < cost then
		Net.FX(player, "NoStamina", {})
		return false
	end
	s.Stamina -= cost
	s.LastStaminaSpend = os.clock()
	player:SetAttribute("Stamina", math.floor(s.Stamina))
	return true
end

-- One damage instance with crits, race passives and weapon passives.
local function hit(player: Player, e, coef: number, opts): boolean
	if e.Dead or not EnemyService.CanDamage(player, e) then
		return false
	end
	local data = DataService.Get(player)
	local race = Stats.Race(data)
	local dmg = Stats.Damage(player) * coef * (0.92 + math.random() * 0.16)
	local crit = math.random() < Stats.CritChance(player)
	if crit then
		dmg *= Stats.CritMult()
	end
	if race.FirstHit and e.HP >= e.MaxHP then
		dmg *= race.FirstHit
		crit = true
	end
	EnemyService.Damage(e, player, dmg, crit)
	if opts then
		if opts.Knockback and opts.From then
			EnemyService.Knockback(e, flat(e.Root.Position - opts.From), opts.Knockback)
		end
		if opts.Stun then
			EnemyService.Stun(e, opts.Stun)
		end
		if opts.Pull then
			EnemyService.Pull(e, opts.Pull, 40)
		end
		if opts.Ragdoll then
			EnemyService.Ragdoll(e, opts.Ragdoll)
		end
		if opts.Ticks then
			EnemyService.DoT(e, player, Stats.Damage(player) * opts.Ticks.Damage, opts.Ticks.Count, opts.Ticks.Interval)
		end
	end
	if (opts and opts.Burn or Stats.HasPassive(player, "Hellfire")) and math.random() < 0.2 then
		EnemyService.DoT(e, player, Stats.Damage(player) * 0.3, 3, 0.4, Color3.fromRGB(190, 80, 255))
	end
	return true
end

local function notifyBlocked(player: Player, s, e)
	local t = os.clock()
	if e.StageIndex and t - (s.LastBlockedNotify or 0) > 3 then
		s.LastBlockedNotify = t
		local stage = Config.Stages[e.StageIndex]
		Net.Notify(player, "Too weak! Stage " .. e.StageIndex .. " needs " .. Format.Abbrev(stage.PowerReq) .. " Power.", Color3.fromRGB(255, 120, 90), "Error")
	end
end

local function hitList(player: Player, s, list, coef: number, opts)
	for _, e in ipairs(list) do
		if not hit(player, e, coef, opts) and not e.Dead then
			notifyBlocked(player, s, e)
		end
	end
end

---------------------------------------------------------------------
-- BASIC ATTACK (LMB)
---------------------------------------------------------------------
local function train(player: Player, data)
	local padIndex, pad = Combat.PadAt(player)
	local mult = 1
	if pad and Stats.PadUnlocked(data, pad) then
		mult = pad.Mult
	else
		padIndex = nil
	end
	local gain = Config.ClickPower * mult * Stats.PowerMult(player)
	data.Power += gain
	Net.FX(player, "Power", { Amount = gain, Pad = padIndex })
end

local function basicAttack(player: Player, payload)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not data or not s or not root or os.clock() < s.StunnedUntil then
		return
	end
	local def, rarity = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local interval = class.Interval / (1 + Stats.AttackSpeed(player))
	local t = os.clock()
	if t - s.LastAttack < interval * 0.8 then
		return
	end
	if t - s.LastAttack > interval * 2.5 then
		s.Combo = 0
	end
	s.LastAttack = t
	s.Combo = s.Combo % #class.Combo + 1
	s.SwingCount += 1
	local coef = class.Combo[s.Combo]
	local aim = readAim(payload, root)

	train(player, data)

	if class.Kind == "Ranged" then
		local origin = root.Position + Vector3.new(0, 1.2, 0) + aim * 2
		local pierce = Stats.HasPassive(player, "LoneWolf") and 1 or nil
		Projectiles.Fire({
			Owner = player,
			Origin = origin,
			Dir = aim,
			Speed = class.Speed,
			Range = class.Range,
			Radius = class.Radius,
			Pierce = pierce,
			Kind = class.Projectile,
			Color = def.Glow or rarity.Color,
			Size = 1.2,
			OnHit = function(e)
				if not hit(player, e, coef) then
					notifyBlocked(player, s, e)
				end
			end,
		})
	else
		local dir = flat(aim)
		hitList(player, s, EnemyService.InCone(root.Position, dir, class.Range, class.Arc), coef, nil)
	end

	-- Sorcerer race: every Nth swing is an elemental AoE
	local race = Stats.Race(data)
	local heavy = race.AoEEvery ~= nil and s.SwingCount % race.AoEEvery == 0
	if heavy then
		hitList(player, s, EnemyService.InSphere(root.Position, 18), 1.5, nil)
	end

	Net.FXAll("Attack", { Player = player, Class = def.Class, Combo = s.Combo, Dir = aim, Color = def.Glow or rarity.Color, Heavy = heavy })
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
-- DASH (Q)
---------------------------------------------------------------------
local function dash(player: Player, payload)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not s or not root then
		return
	end
	local t = os.clock()
	if (s.Cooldowns.Q or 0) > t + 0.1 then
		return
	end
	if not spendStamina(player, s, Stats.StaminaCost(player, B.DashStamina)) then
		return
	end
	s.Cooldowns.Q = t + B.DashCooldown * B.CooldownMult
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + B.DashIFrames)
	Net.FX(player, "Cooldown", { Slot = "Q", Duration = B.DashCooldown * B.CooldownMult })
	Net.FXAll("Dash", { Player = player, Dir = readAim(payload, root) })
end

---------------------------------------------------------------------
-- SKILLS (E / R)
---------------------------------------------------------------------
local executors = {}

executors.Cone = function(player, s, skill, root, aim)
	local dir = flat(aim)
	local hits = skill.Hits or 1
	task.spawn(function()
		for i = 1, hits do
			if i > 1 then
				task.wait(skill.Interval or 0.1)
			end
			local r = rootOf(player)
			if not r then
				return
			end
			hitList(player, s, EnemyService.InCone(r.Position, dir, skill.Range, skill.Arc or 0), skill.Damage, { Knockback = skill.Knockback, From = r.Position, Stun = skill.Stun })
		end
	end)
end

executors.Nova = function(player, s, skill, root)
	local hits = skill.Hits or 1
	task.spawn(function()
		for i = 1, hits do
			if i > 1 then
				task.wait(skill.Interval or 0.12)
			end
			local r = rootOf(player)
			if not r then
				return
			end
			hitList(player, s, EnemyService.InSphere(r.Position, skill.Radius), skill.Damage, {
				Knockback = skill.Knockback,
				From = r.Position,
				Stun = skill.Stun,
				Pull = skill.Pull and r.Position or nil,
			})
		end
	end)
end

local function fireSkillProjectile(player, s, skill, origin: Vector3, dir: Vector3, coef: number, size: number?)
	Projectiles.Fire({
		Owner = player,
		Origin = origin,
		Dir = dir,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = skill.Radius,
		Pierce = skill.Pierce,
		Kind = skill.Projectile,
		Color = skill.Color,
		Size = size or skill.Size,
		Explode = skill.Explode,
		OnHit = function(e)
			if not hit(player, e, coef, { Knockback = skill.Knockback, From = origin }) then
				notifyBlocked(player, s, e)
			end
		end,
		OnExplode = function(pos, radius)
			hitList(player, s, EnemyService.InSphere(pos, radius), coef * 0.5, { Knockback = 40, From = pos })
		end,
	})
end

executors.Projectile = function(player, s, skill, root, aim, charge)
	local frac = skill.Charge and math.clamp((charge or 0) / skill.Charge, 0, 1) or 0
	local coef = skill.Damage * (1 + (skill.ChargeBonus or 0) * frac)
	local size = (skill.Size or 1.5) * (1 + frac * 0.6)
	fireSkillProjectile(player, s, skill, root.Position + Vector3.new(0, 1.2, 0) + aim * 2.5, aim, coef, size)
end

executors.Barrage = function(player, s, skill, _root, aim)
	local count = skill.Count
	local gap = skill.Duration / count
	task.spawn(function()
		for i = 1, count do
			local r = rootOf(player)
			if not r then
				return
			end
			local dir
			if skill.Spread >= 360 then
				local a = (i / count) * math.pi * 2 * 3
				dir = Vector3.new(math.cos(a), 0, math.sin(a))
			else
				local yaw = math.rad((math.random() - 0.5) * skill.Spread)
				local pitch = math.rad((math.random() - 0.5) * skill.Spread * 0.25)
				dir = (CFrame.lookAt(Vector3.zero, aim) * CFrame.Angles(pitch, yaw, 0)).LookVector
			end
			fireSkillProjectile(player, s, skill, r.Position + Vector3.new(0, 1.2, 0) + dir * 2, dir, skill.Damage)
			task.wait(gap)
		end
	end)
end

executors.DashStrike = function(player, s, skill, root, aim)
	local dir = flat(aim)
	local start = root.Position
	local dist = limitByWalls(start, dir, skill.Distance)
	local finish = start + dir * dist
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + 0.15)
	task.delay(0.08, function()
		hitList(player, s, EnemyService.InSegment(start, finish, skill.Width / 2), skill.Damage, { Knockback = skill.Knockback, From = start, Burn = skill.Burn })
	end)
	return { Finish = finish }
end

executors.ChargeLunge = function(player, s, skill, root, aim, charge)
	local dir = flat(aim)
	local start = root.Position
	local dist = limitByWalls(start, dir, skill.Distance)
	local finish = start + dir * dist
	local frac = math.clamp((charge or 0) / skill.Charge, 0, 1)
	local coef = skill.Damage * (1 + (skill.ChargeBonus or 0) * frac)
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + 0.2)
	task.delay(0.12, function()
		local targets = EnemyService.InSegment(start, finish, skill.Width / 2)
		local first = nil
		local best = math.huge
		for _, e in ipairs(targets) do
			local d = (e.Root.Position - start).Magnitude
			if d < best and EnemyService.CanDamage(player, e) then
				first, best = e, d
			end
		end
		if not first then
			return
		end
		local impact = first.Root.Position
		hit(player, first, coef, { Knockback = skill.Knockback * (0.6 + frac * 0.4), From = start, Ragdoll = skill.Ragdoll, Ticks = skill.Ticks })
		for _, e in ipairs(EnemyService.InSphere(impact, 9)) do
			if e ~= first then
				hit(player, e, coef * 0.4, { Knockback = 50, From = impact })
			end
		end
		Net.FXAll("Impact", { Pos = impact, Color = skill.Color, Radius = 12, Kind = "Rasengan" })
	end)
	return { Finish = finish }
end

local function targetPoint(root: BasePart, aim: Vector3, payload, range: number): Vector3
	local tp = type(payload) == "table" and payload.Target
	if typeof(tp) == "Vector3" and (tp - root.Position).Magnitude <= range + 5 then
		return Vector3.new(tp.X, root.Position.Y - 2.5, tp.Z)
	end
	local p = root.Position + flat(aim) * range * 0.6
	return Vector3.new(p.X, root.Position.Y - 2.5, p.Z)
end

executors.Zone = function(player, s, skill, root, aim, _charge, payload)
	local center = targetPoint(root, aim, payload, skill.Range)
	task.spawn(function()
		for _ = 1, skill.Ticks do
			hitList(player, s, EnemyService.InSphere(center, skill.Radius), skill.Damage, { Pull = center })
			task.wait(skill.Interval)
		end
	end)
	return { Target = center, Duration = skill.Ticks * skill.Interval }
end

executors.Rain = function(player, s, skill, root, aim, _charge, payload)
	local center = targetPoint(root, aim, payload, skill.Range)
	task.spawn(function()
		for _ = 1, skill.Hits do
			local a = math.random() * math.pi * 2
			local r = math.sqrt(math.random()) * skill.Radius
			local pt = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			Net.FXAll("Impact", { Pos = pt, Color = skill.Color, Radius = 7, Kind = "Rain" })
			hitList(player, s, EnemyService.InSphere(pt, 7), skill.Damage, nil)
			task.wait(skill.Interval)
		end
	end)
	return { Target = center }
end

local function castSkill(player: Player, slot: string, payload, charge: number?)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not data or not s or not root or os.clock() < s.StunnedUntil then
		return
	end
	local def = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local skillId = slot == "E" and def.Skill or class.Ultimate
	local skill = Config.Skills[skillId]
	local exec = skill and executors[skill.Type]
	if not exec then
		return
	end
	local t = os.clock()
	if (s.Cooldowns[slot] or 0) > t + 0.1 then
		Net.FX(player, "AbilityFail", { Slot = slot })
		return
	end
	if not spendStamina(player, s, Stats.StaminaCost(player, skill.Stamina)) then
		return
	end
	local cd = Stats.Cooldown(player, skillId, skill.Cooldown)
	s.Cooldowns[slot] = t + cd
	Net.FX(player, "Cooldown", { Slot = slot, Duration = cd })

	local aim = readAim(payload, root)
	local extra = exec(player, s, skill, root, aim, charge, payload) or {}
	Net.FXAll("Skill", {
		Player = player,
		Skill = skillId,
		Slot = slot,
		Pos = root.Position,
		Dir = aim,
		Charge = charge,
		Finish = extra.Finish,
		Target = extra.Target,
		Duration = extra.Duration,
	})
end

---------------------------------------------------------------------
-- POTION
---------------------------------------------------------------------
local function potion(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not s or not hum or hum.Health <= 0 then
		return
	end
	if data.Potions <= 0 then
		Net.Notify(player, "No Health Potions. Earn them from play-time rewards!", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	if os.clock() - s.LastPotion < Config.Potion.Cooldown then
		return
	end
	s.LastPotion = os.clock()
	data.Potions -= 1
	hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * Config.Potion.Heal)
	Net.FX(player, "Potion", { Cooldown = Config.Potion.Cooldown })
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
local function onAbility(player: Player, action, payload)
	if type(action) ~= "string" then
		return
	end
	local s = DataService.Session(player)
	if not s then
		return
	end
	if action == "Attack" then
		basicAttack(player, payload)
	elseif action == "Dash" then
		dash(player, payload)
	elseif action == "Skill" or action == "Ultimate" then
		local slot = action == "Skill" and "E" or "R"
		local def = Stats.Weapon(player)
		local skillId = slot == "E" and def.Skill or Config.WeaponClasses[def.Class].Ultimate
		local skill = Config.Skills[skillId]
		if skill and not skill.Charge then
			castSkill(player, slot, payload, nil)
		end
	elseif action == "ChargeBegin" then
		local slot = type(payload) == "table" and payload.Slot
		if slot == "E" or slot == "R" then
			s.Charge[slot] = os.clock()
			Net.FXAll("Charge", { Player = player, Slot = slot })
		end
	elseif action == "ChargeRelease" then
		local slot = type(payload) == "table" and payload.Slot
		if (slot == "E" or slot == "R") and s.Charge[slot] then
			local held = os.clock() - s.Charge[slot]
			s.Charge[slot] = nil
			castSkill(player, slot, payload, held)
		end
	elseif action == "Potion" then
		potion(player)
	end
end

function Combat.Init(m)
	map = m
	wallParams.FilterDescendantsInstances = { map.Root, map.TowerArenas }
	Projectiles.SetWorld({ map.Root, map.TowerArenas })
	Net.Ability.OnServerEvent:Connect(function(player, action, payload)
		local ok, err = pcall(onAbility, player, action, payload)
		if not ok then
			warn("[Ability]", err)
		end
	end)

	EnemyService.OnKill = function(player: Player)
		if Stats.HasPassive(player, "RiftHunger") then
			local s = DataService.Session(player)
			if s then
				s.Stamina = math.min(B.MaxStamina, s.Stamina + 12)
				player:SetAttribute("Stamina", math.floor(s.Stamina))
			end
		end
	end

	-- stamina regen
	task.spawn(function()
		while true do
			local dt = task.wait(0.1)
			local t = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local s = DataService.Session(player)
				if s and s.Stamina < B.MaxStamina and t - s.LastStaminaSpend >= B.StaminaRegenDelay then
					s.Stamina = math.min(B.MaxStamina, s.Stamina + B.StaminaRegen * dt)
					local shown = math.floor(s.Stamina)
					if player:GetAttribute("Stamina") ~= shown then
						player:SetAttribute("Stamina", shown)
					end
				end
			end
		end
	end)

	-- auto-training while standing on a pad
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				local s = DataService.Session(player)
				if data and s then
					local padIndex, pad = Combat.PadAt(player)
					if pad then
						if Stats.PadUnlocked(data, pad) then
							local gain = Config.AutoTrainPerSecond * pad.Mult * Stats.PowerMult(player)
							data.Power += gain
							Net.FX(player, "Power", { Amount = gain, Pad = padIndex, Auto = true })
							DataService.MarkDirty(player)
						elseif s.Pad ~= padIndex then
							Net.Notify(player, "This pad needs " .. padReqText(pad) .. ".", Color3.fromRGB(255, 120, 90), "Error")
						end
					end
					s.Pad = padIndex or 0
				end
			end
		end
	end)
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Cosmetics (ModuleScript) -> ServerScriptService/Server/Cosmetics
-- Overhead name tag (race + title), race / ascension auras, the Overdrive
-- transformation aura and the Chroma Trail gamepass. Server-side so every
-- player can see them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))

local Cosmetics = {}

local TIER_RATE = { Common = 0, Rare = 0, Epic = 6, Legendary = 10, Mythic = 16 }

local function clear(root: Instance, prefix: string)
	for _, c in ipairs(root:GetChildren()) do
		if c.Name:sub(1, #prefix) == prefix then
			c:Destroy()
		end
	end
end

local function attachment(root: BasePart, name: string, pos: Vector3?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos or Vector3.zero
	a.Parent = root
	return a
end

local function nametag(player: Player, char: Model, data)
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("Nametag")
	if old then
		old:Destroy()
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local race = Stats.Race(data)
	local tier = Stats.Tier(data)
	local isMC = race.Id == "MainCharacter"

	local bb = Instance.new("BillboardGui")
	bb.Name = "Nametag"
	bb.Size = UDim2.fromOffset(240, isMC and 84 or 62)
	bb.StudsOffset = Vector3.new(0, isMC and 3.4 or 2.9, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = head
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = bb

	local function line(text: string, color: Color3, h: number, font: Enum.Font, order: number)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, h)
		t.Font = font
		t.TextScaled = true
		t.Text = text
		t.TextColor3 = color
		t.LayoutOrder = order
		t.Parent = bb
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Color = Color3.fromRGB(15, 10, 20)
		st.Parent = t
		return t
	end
	if isMC then
		local title = line("MAIN CHARACTER", Color3.fromRGB(255, 220, 90), 20, Enum.Font.LuckiestGuy, 0)
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 160)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 190, 40)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 160)),
		})
		g.Parent = title
	end
	line(player.DisplayName, Color3.new(1, 1, 1), 28, Enum.Font.FredokaOne, 1)
	if data.Race ~= "" then
		local tierLabel = tier.Label or tier.Id
		line(string.format("%s %s%s", tierLabel, race.Name, data.Rebirths > 0 and ("  |  R" .. data.Rebirths) or ""), tier.Id == "Common" and race.Color or tier.Color, 20, Enum.Font.FredokaOne, 2)
	end
end

function Cosmetics.Apply(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	nametag(player, char, data)
	clear(root, "Cos_")

	local race = Stats.Race(data)
	local tier = Stats.Tier(data)
	local isMC = race.Id == "MainCharacter"

	-- race aura (Epic+ skins, and always for Main Character)
	local rate = TIER_RATE[tier.Id] or 0
	if isMC then
		rate = math.max(rate, 18)
	end
	if data.Race ~= "" and rate > 0 then
		local a = attachment(root, "Cos_RaceAura", Vector3.new(0, -1.5, 0))
		local color = isMC and Color3.fromRGB(255, 205, 60) or tier.Color
		local e = VFX.MakeEmitter("Aura", color, a, rate)
		e.Transparency = VFX.NS(0, 0.6, 0.6, 0.7, 1, 1)
		if tier.Id == "Mythic" or isMC then
			VFX.MakeEmitter("Stars", color, a, 3)
		end
	end

	-- ascension aura from rebirths
	local asc = nil
	for _, a in ipairs(Config.AscensionAuras) do
		if data.Rebirths >= a.Rebirths then
			asc = a
		end
	end
	if asc then
		local a = attachment(root, "Cos_Ascension", Vector3.new(0, -2.8, 0))
		local e = VFX.MakeEmitter("Rise", asc.Color, a, 5)
		e.Shape = Enum.ParticleEmitterShape.Cylinder
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Size = VFX.NS(0, 0.35, 1, 0)
	end

	-- chroma trail gamepass
	if Stats.HasPass(player, "ChromaTrail") then
		local a0 = attachment(root, "Cos_Trail0", Vector3.new(0, 1, 0))
		local a1 = attachment(root, "Cos_Trail1", Vector3.new(0, -1.6, 0))
		local tr = Instance.new("Trail")
		tr.Name = "Cos_ChromaTrail"
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.6
		tr.LightEmission = 1
		tr.Transparency = VFX.NS(0, 0.2, 1, 1)
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 90)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 255, 120)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(140, 90, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 200)),
		})
		tr.Parent = root
	end

	-- exclusive play-time aura (120 minute reward)
	if data.Cosmetics and data.Cosmetics.PlaytimeAura then
		local a = attachment(root, "Cos_Playtime", Vector3.new(0, -2.6, 0))
		for i, c in ipairs({ Color3.fromRGB(255, 90, 160), Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 220, 90) }) do
			local e = VFX.MakeEmitter("Rise", c, a, 3)
			e.Shape = Enum.ParticleEmitterShape.Cylinder
			e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			e.Size = VFX.NS(0, 0.3 + i * 0.05, 1, 0)
		end
	end

	-- Mythic / Celestial weapon aura
	local def, rarity = Stats.Weapon(player)
	if rarity.Aura then
		local a = attachment(root, "Cos_Mythic", Vector3.new(0, -1.2, 0))
		local color = def.Glow or rarity.Color
		local e = VFX.MakeEmitter("Aura", color, a, 22)
		e.Transparency = VFX.NS(0, 0.5, 0.6, 0.6, 1, 1)
		VFX.MakeEmitter("Sparks", color, a, 6).Speed = NumberRange.new(3, 8)
	end

	Cosmetics.RefreshTransform(player)
end

-- Overdrive / Zenkai transformation aura (on while the buff is active).
function Cosmetics.RefreshTransform(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	clear(root, "Cos_Transform")
	local overdrive = Stats.OverdriveActive(player)
	local zenkai = Stats.ZenkaiActive(player)
	if not overdrive and not zenkai then
		return
	end
	local color = zenkai and Color3.fromRGB(255, 225, 60) or Stats.Race(data).Color
	local a = attachment(root, "Cos_Transform", Vector3.new(0, -1, 0))
	local e = VFX.MakeEmitter("Aura", color, a, 45)
	e.Size = VFX.NS(0, 1.8, 0.5, 3, 1, 0)
	VFX.MakeEmitter("Sparks", color, a, 10).Speed = NumberRange.new(6, 14)
	local l = Instance.new("PointLight")
	l.Name = "Cos_TransformLight"
	l.Color = color
	l.Range = 16
	l.Brightness = 2
	l.Parent = root
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- DataService (ModuleScript) -> ServerScriptService/Server/DataService
-- DataStore-backed player profiles + per-session runtime state.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameShared"):WaitForChild("Config"))

local DataService = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore unavailable (enable Studio API access to save):", result)
	end
end

local DEFAULT = {
	Version = 1,
	Power = 0,
	Coins = 0,
	Blade = 0,
	Rebirths = 0,
	Runes = 0,
	Backpack = {}, -- [oreId] = count
	Upgrades = { Backpack = 0, Luck = 0, Training = 0 },
	Race = "",
	RaceTier = "",
	Rerolls = Config.StartingRerolls,
	Overdrive = Config.Overdrive.StartingPotions,
	Index = {}, -- [oreId] = true
	Kills = 0,
	TowerBest = 0,
	Codes = {}, -- [CODE] = true
	StarterPack = false,
	Receipts = {}, -- recent purchase ids (dedupe)
	Settings = { Music = true, SFX = true },
	-- weapons / loot
	Weapons = {}, -- ["w1"] = { W = weaponId, R = rarityId }
	NextWeaponId = 1,
	Equipped = "",
	Keys = { Uncommon = 0, RareScroll = 0, Legendary = 0 },
	Potions = 1,
	BoostEnds = 0, -- 2x damage boost end (server time)
	PowerTier = 0, -- purchased 2x power tiers (multiplier = 2^PowerTier)
	-- retention
	TotalPlaytime = 0,
	LastLoginDay = 0,
	Streak = 0,
	Cosmetics = { PlaytimeAura = false },
}

local profiles: { [Player]: any } = {}
local sessions: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}

DataService.OnFlush = nil :: ((Player) -> ())?

local function deepCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return out
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
end

local function newSession()
	return {
		LastSwing = 0,
		SwingCount = 0,
		OverdriveEnd = 0,
		ZenkaiEnd = 0,
		ZenkaiReady = 0,
		InvulnUntil = 0,
		Passes = {},
		Drops = {},
		NextDropId = 0,
		Tower = nil,
		LastFullNotify = 0,
		LastPortal = 0,
		Pad = 0,
		Loaded = false,
		-- combat
		Stamina = Config.Balance.MaxStamina,
		LastStaminaSpend = 0,
		Cooldowns = {},
		Charge = {},
		LastAttack = 0,
		Combo = 0,
		LastPotion = 0,
		StunnedUntil = 0,
		-- retention
		SessionTime = 0,
		PlaytimeClaimed = {},
	}
end

function DataService.Load(player: Player)
	sessions[player] = newSession()
	local data = nil
	local success = store == nil -- no store (Studio without API) -> play with fresh data
	if store then
		for attempt = 1, 4 do
			local ok, result = pcall(function()
				return store:GetAsync("Player_" .. player.UserId)
			end)
			if ok then
				data = result
				success = true
				break
			end
			warn(("[Data] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
			task.wait(attempt * 1.5)
		end
	end
	if type(data) ~= "table" then
		data = deepCopy(DEFAULT)
	end
	reconcile(data, DEFAULT)
	profiles[player] = data
	canSave[player] = success and store ~= nil
	sessions[player].Loaded = true
	if not success then
		warn("[Data] could not load " .. player.Name .. " - progress will NOT be saved this session to protect old data")
	end
	return data
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync("Player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.Session(player: Player)
	return sessions[player]
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

function DataService.Release(player: Player)
	DataService.Save(player)
	profiles[player] = nil
	sessions[player] = nil
	canSave[player] = nil
	dirty[player] = nil
end

function DataService.All()
	return profiles
end

-- Flush dirty profiles to their clients once per frame (batches many changes).
RunService.Heartbeat:Connect(function()
	for player in pairs(dirty) do
		dirty[player] = nil
		if player.Parent and profiles[player] and DataService.OnFlush then
			DataService.OnFlush(player)
		end
	end
end)

-- Autosave
task.spawn(function()
	while true do
		task.wait(120)
		for player in pairs(profiles) do
			task.spawn(DataService.Save, player)
		end
	end
end)

game:BindToClose(function()
	local threads = 0
	for _, player in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			DataService.Save(player)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- EnemyService (ModuleScript) -> ServerScriptService/Server/EnemyService
-- Anime avatar enemies:
--   * R15 rigs built from a HumanoidDescription (optional catalog hair /
--     accessories / Shirt / Pants ids from Config.EnemyCatalog) plus
--     procedural anime hair; falls back to a hand-built R6 rig if needed.
--   * Animator with preloaded Idle / Walk / Run / BasicAttack /
--     SpecialWindup / SpecialRelease tracks.
--   * PathfindingService chasing + AI state machine for special attacks:
--     cooldown/proximity check -> wind-up anim + ground telegraph ->
--     release; damage lands on the animation's "Hit" keyframe/marker
--     (AnimationTrack.KeyframeReached) with a timed fallback.
--   * Head health bar that only shows when damaged or when players are near.

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))

local EnemyService = {}
EnemyService.Active = {} :: { any }
EnemyService.OnZenkai = nil :: ((Player) -> ())?
EnemyService.OnKill = nil :: ((Player, any) -> ())?

local map = nil
local templates = {}
local animCache = {}
local AI = Config.EnemyAI
local B = Config.Balance

---------------------------------------------------------------------
-- RIG BUILDING
---------------------------------------------------------------------
local function weldTo(head: BasePart, p: BasePart)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local w = Instance.new("WeldConstraint")
	w.Part0 = head
	w.Part1 = p
	w.Parent = p
	p.Parent = head.Parent
end

local function hairPart(head: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CFrame = head.CFrame * offset
	weldTo(head, p)
	return p
end

-- Procedural anime hair + accessories (used when no catalog hair is set).
local function decorate(model: Model, look)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local hs = head.Size
	local u = math.min(hs.X, hs.Y, hs.Z) -- unit size of the head
	local c = look.HairColor
	-- hair cap
	hairPart(head, "HairCap", Vector3.new(hs.X * 1.1, hs.Y * 0.75, hs.Z * 1.12), CFrame.new(0, hs.Y * 0.28, u * 0.06), c, Enum.PartType.Ball)
	if look.Hair == "Spiky" then
		for i = 1, 8 do
			local a = (i / 8) * math.pi * 2
			local tilt = CFrame.Angles(math.rad(35) * math.cos(a), 0, math.rad(35) * math.sin(a))
			hairPart(head, "Spike", Vector3.new(u * 0.32, u * 0.95, u * 0.32), CFrame.new(math.sin(a) * u * 0.35, hs.Y * 0.55, math.cos(a) * u * 0.3 + u * 0.1) * tilt, c)
		end
		for i = -1, 1 do
			hairPart(head, "Bang", Vector3.new(u * 0.3, u * 0.55, u * 0.2), CFrame.new(i * u * 0.3, hs.Y * 0.28, -hs.Z * 0.45) * CFrame.Angles(math.rad(-20), 0, math.rad(i * 15)), c)
		end
	elseif look.Hair == "Long" then
		hairPart(head, "BackHair", Vector3.new(hs.X * 1.05, hs.Y * 1.7, u * 0.35), CFrame.new(0, -hs.Y * 0.25, hs.Z * 0.5), c)
		for _, side in ipairs({ -1, 1 }) do
			hairPart(head, "SideHair", Vector3.new(u * 0.22, hs.Y * 1.1, u * 0.5), CFrame.new(side * hs.X * 0.52, -hs.Y * 0.1, 0), c)
		end
		hairPart(head, "Fringe", Vector3.new(hs.X * 1.02, u * 0.3, u * 0.2), CFrame.new(0, hs.Y * 0.32, -hs.Z * 0.45) * CFrame.Angles(math.rad(-15), 0, 0), c)
	elseif look.Hair == "Bun" then
		hairPart(head, "Bun", Vector3.one * u * 0.6, CFrame.new(0, hs.Y * 0.55, hs.Z * 0.35), c, Enum.PartType.Ball)
		hairPart(head, "Fringe", Vector3.new(hs.X * 1.02, u * 0.3, u * 0.2), CFrame.new(0, hs.Y * 0.3, -hs.Z * 0.45) * CFrame.Angles(math.rad(-15), 0, 0), c)
	end
	if look.Extra == "Headband" then
		hairPart(head, "Headband", Vector3.new(hs.X * 1.08, u * 0.18, hs.Z * 1.08), CFrame.new(0, hs.Y * 0.15, 0), Color3.fromRGB(40, 50, 90))
		hairPart(head, "Plate", Vector3.new(u * 0.5, u * 0.25, u * 0.06), CFrame.new(0, hs.Y * 0.15, -hs.Z * 0.56), Color3.fromRGB(200, 205, 215), nil, Enum.Material.Metal)
	elseif look.Extra == "Horns" then
		for _, side in ipairs({ -1, 1 }) do
			hairPart(head, "Horn", Vector3.new(u * 0.2, u * 0.7, u * 0.2), CFrame.new(side * hs.X * 0.35, hs.Y * 0.7, 0) * CFrame.Angles(0, 0, math.rad(-side * 20)), Color3.fromRGB(240, 230, 220))
		end
	elseif look.Extra == "Mask" then
		hairPart(head, "Mask", Vector3.new(hs.X * 1.02, hs.Y * 0.4, u * 0.1), CFrame.new(0, -hs.Y * 0.22, -hs.Z * 0.5), Color3.fromRGB(25, 25, 30))
	elseif look.Extra == "Crown" then
		for i = 1, 5 do
			local a = (i / 5) * math.pi * 2
			hairPart(head, "Crown", Vector3.new(u * 0.15, u * 0.4, u * 0.15), CFrame.new(math.cos(a) * u * 0.4, hs.Y * 0.85, math.sin(a) * u * 0.4), Color3.fromRGB(255, 205, 60), nil, Enum.Material.Neon)
		end
	elseif look.Extra == "Visor" then
		hairPart(head, "Visor", Vector3.new(hs.X * 1.05, u * 0.22, u * 0.1), CFrame.new(0, hs.Y * 0.05, -hs.Z * 0.52), look.HairColor, nil, Enum.Material.Neon)
	end
end

-- Hand-built classic R6 rig (fallback if the R15 description fails).
local function buildR6(look): Model
	local m = Instance.new("Model")
	local function p(name, size, color)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = m
		return part
	end
	local root = p("HumanoidRootPart", Vector3.new(2, 2, 1), look.Shirt)
	root.Transparency = 1
	local torso = p("Torso", Vector3.new(2, 2, 1), look.Shirt)
	local head = p("Head", Vector3.new(2, 1, 1), look.Skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = head
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head
	local la = p("Left Arm", Vector3.new(1, 2, 1), look.Skin)
	local ra = p("Right Arm", Vector3.new(1, 2, 1), look.Skin)
	local ll = p("Left Leg", Vector3.new(1, 2, 1), look.Pants)
	local rl = p("Right Leg", Vector3.new(1, 2, 1), look.Pants)
	local function motor(name, p0, p1, c0, c1)
		local mo = Instance.new("Motor6D")
		mo.Name = name
		mo.Part0 = p0
		mo.Part1 = p1
		mo.C0 = c0
		mo.C1 = c1
		mo.Parent = p0
	end
	local rj = CFrame.Angles(math.rad(-90), 0, math.rad(180))
	motor("RootJoint", root, torso, rj, rj)
	motor("Neck", torso, head, CFrame.new(0, 1, 0) * rj, CFrame.new(0, -0.5, 0) * rj)
	motor("Right Shoulder", torso, ra, CFrame.new(1, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(-0.5, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0))
	motor("Left Shoulder", torso, la, CFrame.new(-1, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(0.5, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0))
	motor("Right Hip", torso, rl, CFrame.new(1, -1, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(0.5, 1, 0) * CFrame.Angles(0, math.rad(90), 0))
	motor("Left Hip", torso, ll, CFrame.new(-1, -1, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(-0.5, 1, 0) * CFrame.Angles(0, math.rad(-90), 0))
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R6
	hum.Parent = m
	m.PrimaryPart = root
	root.CFrame = CFrame.new(0, 3, 0)
	torso.CFrame = root.CFrame
	head.CFrame = root.CFrame * CFrame.new(0, 1.5, 0)
	ra.CFrame = root.CFrame * CFrame.new(1.5, 0, 0)
	la.CFrame = root.CFrame * CFrame.new(-1.5, 0, 0)
	rl.CFrame = root.CFrame * CFrame.new(0.5, -2, 0)
	ll.CFrame = root.CFrame * CFrame.new(-0.5, -2, 0)
	return m
end

local function buildTemplate(index: number): Model
	local look = Config.EnemyLooks[index] or Config.EnemyLooks[1]
	local catalog = Config.EnemyCatalog[index]
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = look.Skin
	desc.TorsoColor = look.Shirt
	desc.LeftArmColor = look.Shirt
	desc.RightArmColor = look.Shirt
	desc.LeftLegColor = look.Pants
	desc.RightLegColor = look.Pants
	local catalogHair = false
	if catalog then
		if catalog.HairAccessory and catalog.HairAccessory ~= "" then
			desc.HairAccessory = catalog.HairAccessory
			catalogHair = true
		end
		if catalog.HatAccessory and catalog.HatAccessory ~= "" then
			desc.HatAccessory = catalog.HatAccessory
		end
		if catalog.Shirt and catalog.Shirt ~= 0 then
			desc.Shirt = catalog.Shirt
		end
		if catalog.Pants and catalog.Pants ~= 0 then
			desc.Pants = catalog.Pants
		end
		if catalog.Face and catalog.Face ~= 0 then
			desc.Face = catalog.Face
		end
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[Enemies] R15 rig build failed, using R6 fallback:", model)
		model = buildR6(look)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("BasePart") and (d.Name == "LeftHand" or d.Name == "RightHand") then
			d.Color = look.Skin
		end
	end
	if not catalogHair then
		decorate(model, look)
	end
	return model
end

---------------------------------------------------------------------
-- ANIMATION
---------------------------------------------------------------------
local function animation(id: string): Animation
	local a = animCache[id]
	if not a then
		a = Instance.new("Animation")
		a.AnimationId = id
		animCache[id] = a
	end
	return a
end

local function loadTracks(hum: Humanoid)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local set = hum.RigType == Enum.HumanoidRigType.R15 and Config.EnemyAnims.R15 or Config.EnemyAnims.R6
	local tracks = {}
	for key, id in pairs(set) do
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation(id))
		end)
		if ok and track then
			tracks[key] = track
			if key == "Idle" or key == "Walk" or key == "Run" then
				track.Looped = true
				track.Priority = Enum.AnimationPriority.Core
			else
				track.Priority = Enum.AnimationPriority.Action
			end
		end
	end
	return tracks
end

-- Waits for a "Hit" keyframe / marker on the track, or the fallback time.
local function waitForHit(track: AnimationTrack?, fallback: number)
	local done = Instance.new("BindableEvent")
	local fired = false
	local function fire()
		if not fired then
			fired = true
			done:Fire()
		end
	end
	local conns = {}
	if track then
		table.insert(conns, track.KeyframeReached:Connect(function(name)
			if name == "Hit" then
				fire()
			end
		end))
		table.insert(conns, track:GetMarkerReachedSignal("Hit"):Connect(fire))
	end
	task.delay(fallback, fire)
	if not fired then
		done.Event:Wait()
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	done:Destroy()
end

---------------------------------------------------------------------
-- HEALTH BAR
---------------------------------------------------------------------
local function healthBar(e)
	local head = e.Head
	local bb = Instance.new("BillboardGui")
	bb.Name = "HealthGui"
	bb.Size = UDim2.fromOffset(e.Boss and 260 or 150, e.Boss and 58 or 42)
	bb.StudsOffset = Vector3.new(0, head.Size.Y * 1.3 + 0.8, 0)
	bb.MaxDistance = e.Boss and 200 or 90
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.Enabled = e.Boss == true
	bb.Parent = head
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.5)
	name.Font = Enum.Font.LuckiestGuy
	name.TextScaled = true
	name.Text = e.Name
	name.TextColor3 = e.Elite and Color3.fromRGB(255, 215, 70) or (e.Boss and Color3.fromRGB(255, 90, 110) or Color3.new(1, 1, 1))
	name.Parent = bb
	local ns = Instance.new("UIStroke")
	ns.Thickness = 2
	ns.Parent = name
	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.fromScale(0, 0.55)
	barBg.Size = UDim2.fromScale(1, 0.4)
	barBg.BackgroundColor3 = Color3.fromRGB(25, 20, 30)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = barBg
	local bs = Instance.new("UIStroke")
	bs.Thickness = 2
	bs.Color = Color3.fromRGB(10, 8, 12)
	bs.Parent = barBg
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0.5, 0)
	fc.Parent = fill
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 190, 80))
	grad.Parent = fill
	local hpText = Instance.new("TextLabel")
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.Font = Enum.Font.FredokaOne
	hpText.TextScaled = true
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.Text = Format.Abbrev(e.HP)
	hpText.ZIndex = 2
	hpText.Parent = barBg
	local hs = Instance.new("UIStroke")
	hs.Thickness = 1.5
	hs.Parent = hpText
	e.Bar, e.Fill, e.HPText = bb, fill, hpText
end

---------------------------------------------------------------------
-- SPAWNING
---------------------------------------------------------------------
local function randomPoint(minV: Vector3, maxV: Vector3): Vector3
	return Vector3.new(math.random() * (maxV.X - minV.X) + minV.X, 0, math.random() * (maxV.Z - minV.Z) + minV.Z)
end

local function tierKey(e): string
	return e.Boss and "Boss" or (e.Elite and "Elite" or "Normal")
end

function EnemyService.Create(opts)
	local lookIndex = opts.LookIndex or 1
	local template = templates[lookIndex]
	if not template then
		template = buildTemplate(lookIndex)
		templates[lookIndex] = template
	end
	local model = template:Clone()
	model.Name = opts.Label
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local head = model:FindFirstChild("Head") :: BasePart
	if opts.Scale and opts.Scale ~= 1 then
		pcall(function()
			model:ScaleTo(opts.Scale)
		end)
	end
	hum.WalkSpeed = opts.Speed or 12
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	for _, st in ipairs({ Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.Seated }) do
		hum:SetStateEnabled(st, false)
	end
	local rootY = hum.RigType == Enum.HumanoidRigType.R15 and (hum.HipHeight + root.Size.Y / 2) or 3 * (opts.Scale or 1)
	model:PivotTo(CFrame.new(opts.Position.X, opts.Position.Y + rootY + 0.3, opts.Position.Z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))

	local color = opts.Color or Color3.new(1, 1, 1)
	if opts.Boss then
		local aura = Instance.new("Attachment")
		aura.Parent = root
		VFX.MakeEmitter("Aura", color, aura, 25).Size = VFX.NS(0, 2 * (opts.Scale or 1), 0.5, 3 * (opts.Scale or 1), 1, 0)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = 30
		l.Brightness = 2
		l.Shadows = true
		l.Parent = root
	end
	if opts.Elite then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromRGB(255, 200, 50)
		h.FillTransparency = 0.75
		h.OutlineColor = Color3.fromRGB(255, 230, 120)
		h.Parent = model
		local aura = Instance.new("Attachment")
		aura.Parent = root
		VFX.MakeEmitter("Aura", Color3.fromRGB(255, 200, 60), aura, 16)
	end

	model.Parent = map.Enemies
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local enemy = {
		Model = model,
		Root = root,
		Head = head,
		Humanoid = hum,
		HP = opts.HP,
		MaxHP = opts.HP,
		Name = opts.Label,
		Color = color,
		Boss = opts.Boss,
		Elite = opts.Elite,
		StageIndex = opts.StageIndex,
		Owner = opts.Owner,
		Min = opts.Min,
		Max = opts.Max,
		Home = opts.Position,
		Damagers = {},
		Dead = false,
		OnDeath = opts.OnDeath,
		Scale = opts.Scale or 1,
		Radius = 1.6 * (opts.Scale or 1),
		HitPercent = opts.HitPercent or Config.EnemyHitPercent,
		State = "Idle",
		LastBasic = 0,
		NextSpecial = os.clock() + 2 + math.random() * 3,
		NextWander = 0,
		StunnedUntil = 0,
		LastDamaged = -100,
		NextPath = 0,
	}
	healthBar(enemy)
	enemy.Tracks = loadTracks(hum)
	if enemy.Tracks.Idle then
		enemy.Tracks.Idle:Play()
	end
	hum.Running:Connect(function(speed)
		local run, idle = enemy.Tracks.Run, enemy.Tracks.Idle
		if speed > 1 then
			if run and not run.IsPlaying then
				run:Play(0.15)
				if idle then
					idle:Stop(0.15)
				end
			end
		else
			if idle and not idle.IsPlaying then
				idle:Play(0.2)
				if run then
					run:Stop(0.2)
				end
			end
		end
	end)
	table.insert(EnemyService.Active, enemy)
	return enemy
end

local function spawnForStage(stageIndex: number, announce: boolean?)
	local stage = Config.Stages[stageIndex]
	local info = map.Dungeons[stage.Zone] and map.Dungeons[stage.Zone].Stages[stageIndex]
	if not info then
		return
	end
	local elite = not stage.Boss and math.random() < Config.EliteChance
	local scale = stage.Boss and 2.6 or (elite and 1.3 or 1)
	local pos = stage.Boss and info.Center or randomPoint(info.SpawnMin, info.SpawnMax)
	local enemy = EnemyService.Create({
		Label = (elite and "ELITE " or "") .. stage.Enemy,
		LookIndex = stageIndex,
		Color = stage.Color,
		Scale = scale,
		HP = stage.HP * (elite and Config.EliteHPMult or 1),
		Boss = stage.Boss,
		Elite = elite,
		StageIndex = stageIndex,
		Position = pos,
		Min = info.SpawnMin,
		Max = info.SpawnMax,
		Speed = stage.Boss and 13 or (elite and 15 or 12),
	})
	if stage.Boss and announce then
		Net.FXAll("BossSpawn", { Name = stage.Enemy, Stage = stageIndex, Zone = stage.Zone, Pos = pos, Color = stage.Color })
	end
	return enemy
end

---------------------------------------------------------------------
-- QUERIES
---------------------------------------------------------------------
function EnemyService.CanDamage(player: Player, e): boolean
	if e.Dead or (e.Owner and e.Owner ~= player) then
		return false
	end
	if e.StageIndex then
		local data = DataService.Get(player)
		return data ~= nil and Stats.StageUnlocked(data, e.StageIndex)
	end
	return true
end

function EnemyService.InSphere(pos: Vector3, radius: number)
	local out = {}
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead and (e.Root.Position - pos).Magnitude - e.Radius <= radius then
			table.insert(out, e)
		end
	end
	return out
end

function EnemyService.InCone(pos: Vector3, dir: Vector3, range: number, arcDot: number)
	local out = {}
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead then
			local offset = e.Root.Position - pos
			local flatV = Vector3.new(offset.X, 0, offset.Z)
			local dist = flatV.Magnitude
			if dist - e.Radius <= range and math.abs(offset.Y) < 10 * e.Scale then
				if dist < 3 * e.Scale or flatV.Unit:Dot(dir) > arcDot then
					table.insert(out, e)
				end
			end
		end
	end
	return out
end

function EnemyService.InSegment(a: Vector3, b: Vector3, radius: number)
	local out = {}
	local ab = b - a
	local len2 = ab:Dot(ab)
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead then
			local p = e.Root.Position
			local t = len2 > 0 and math.clamp((p - a):Dot(ab) / len2, 0, 1) or 0
			local closest = a + ab * t
			if (p - closest).Magnitude <= radius + e.Radius + 1 then
				table.insert(out, e)
			end
		end
	end
	return out
end

---------------------------------------------------------------------
-- STATUS EFFECTS (all stun-like effects are capped by Balance.MaxStun)
---------------------------------------------------------------------
function EnemyService.Stun(e, duration: number)
	if e.Dead then
		return
	end
	duration = math.min(duration, B.MaxStun) * (e.Boss and 0.3 or 1)
	e.StunnedUntil = math.max(e.StunnedUntil, os.clock() + duration)
	e.Humanoid:MoveTo(e.Root.Position)
end

function EnemyService.Knockback(e, dir: Vector3, force: number)
	if e.Dead then
		return
	end
	local f = force * (e.Boss and 0.2 or 1)
	e.Root.AssemblyLinearVelocity = dir * f + Vector3.new(0, f * 0.3, 0)
	EnemyService.Stun(e, 0.3)
end

function EnemyService.Pull(e, point: Vector3, strength: number)
	if e.Dead or e.Boss then
		return
	end
	local off = Vector3.new(point.X - e.Root.Position.X, 0, point.Z - e.Root.Position.Z)
	if off.Magnitude > 3 then
		e.Root.AssemblyLinearVelocity = off.Unit * strength
		EnemyService.Stun(e, 0.25)
	end
end

function EnemyService.Ragdoll(e, duration: number, force: boolean?)
	if (e.Dead and not force) or e.Ragdolled then
		return
	end
	if e.Boss and not force then
		EnemyService.Stun(e, duration)
		return
	end
	duration = math.min(duration, B.MaxStun)
	e.Ragdolled = true
	e.StunnedUntil = math.max(e.StunnedUntil, os.clock() + duration)
	local restore = {}
	for _, motor in ipairs(e.Model:GetDescendants()) do
		if motor:IsA("Motor6D") and motor.Name ~= "Root" and motor.Name ~= "RootJoint" and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local bs = Instance.new("BallSocketConstraint")
			bs.Attachment0 = a0
			bs.Attachment1 = a1
			bs.LimitsEnabled = true
			bs.UpperAngle = 60
			bs.TwistLimitsEnabled = true
			bs.Parent = motor.Part0
			motor.Enabled = false
			table.insert(restore, { motor, a0, a1, bs, motor.Part1.CanCollide })
			motor.Part1.CanCollide = true
		end
	end
	e.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	task.delay(duration, function()
		for _, r in ipairs(restore) do
			local motor, a0, a1, bs, collide = r[1], r[2], r[3], r[4], r[5]
			if motor.Parent then
				motor.Enabled = true
				if motor.Part1 then
					motor.Part1.CanCollide = collide
				end
			end
			a0:Destroy()
			a1:Destroy()
			bs:Destroy()
		end
		e.Ragdolled = false
		if not e.Dead and e.Humanoid.Parent then
			e.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

---------------------------------------------------------------------
-- PLAYER DAMAGE (race passives: dodge, plot armor, zenkai; stun cap)
---------------------------------------------------------------------
function EnemyService.HitPlayer(player: Player, fraction: number, attackerPos: Vector3?, stun: number?)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not hum or hum.Health <= 0 or not data or not s then
		return
	end
	local now = Stats.Now()
	if s.InvulnUntil > now then
		Net.FX(player, "Dodge", {})
		return
	end
	local race = Stats.Race(data)
	local dmg = hum.MaxHealth * fraction
	local newHealth = hum.Health - dmg
	if newHealth <= 0 and race.PlotArmor and math.random() < race.PlotArmor then
		newHealth = 1
		s.InvulnUntil = now + Config.PlotArmorIFrames
		Net.FX(player, "PlotArmor", {})
	end
	hum.Health = math.max(0, newHealth)
	if stun and stun > 0 then
		s.StunnedUntil = os.clock() + math.min(stun, B.PlayerStunCap)
	end
	Net.FX(player, "Hurt", { Amount = dmg, From = attackerPos, Stun = stun and math.min(stun, B.PlayerStunCap) or nil })
	if race.Zenkai and hum.Health > 0 and hum.Health / hum.MaxHealth < Config.ZenkaiThreshold and now >= s.ZenkaiReady then
		s.ZenkaiEnd = now + Config.ZenkaiDuration
		s.ZenkaiReady = now + Config.ZenkaiCooldown
		hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.3)
		Net.FXAll("Transform", { Player = player, Kind = "Zenkai", Color = Color3.fromRGB(255, 225, 60) })
		if EnemyService.OnZenkai then
			EnemyService.OnZenkai(player)
		end
		DataService.MarkDirty(player)
	end
end

---------------------------------------------------------------------
-- DAMAGE / DEATH / REWARDS
---------------------------------------------------------------------
local function weaponDrop(player: Player, chance: number)
	if math.random() >= chance then
		return
	end
	local weaponId, rarityId = Weapons.Roll(nil, Stats.Luck(player))
	if Weapons.Add(player, weaponId, rarityId) then
		Net.FX(player, "WeaponDrop", { Weapon = weaponId, Rarity = rarityId })
	end
end

local function reward(player: Player, enemy)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return
	end
	local stage = Config.Stages[enemy.StageIndex]
	if not stage then
		return
	end
	local mult = enemy.Elite and Config.EliteDropMult or 1
	local coins = math.floor(stage.Coins * mult * Stats.CoinMult(player))
	data.Coins += coins
	data.Kills += 1
	local luck = Stats.Luck(player) * (enemy.Elite and 2 or 1)
	local count
	if enemy.Boss then
		count = Config.BossOreDrops
	elseif enemy.Elite then
		count = 3
	else
		count = (math.random() < 0.25) and 2 or 1
	end
	local pos = enemy.Root.Position
	for i = 1, count do
		local minOrder = (enemy.Boss and i == 1) and 4 or nil
		local oreId = Loot.RollOre(stage.Drops, luck, minOrder)
		local off = Vector3.new(math.random() * 8 - 4, 0, math.random() * 8 - 4) * (enemy.Boss and 2 or 1)
		Loot.Drop(player, oreId, Vector3.new(pos.X + off.X, enemy.Home.Y + 1.2, pos.Z + off.Z))
	end
	if enemy.Boss and math.random() < Config.BossRerollChance then
		data.Rerolls += 1
		Net.Notify(player, "The boss dropped a Race Reroll!", Color3.fromRGB(200, 150, 255), "RarePickup")
	end
	weaponDrop(player, enemy.Boss and Config.WeaponDropChance.Boss or (enemy.Elite and Config.WeaponDropChance.Elite or Config.WeaponDropChance.Normal))
	if Stats.Race(data).Id == "Ninja" then
		s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + Config.NinjaDodgeTime)
	end
	Net.FX(player, "Reward", { Coins = coins, Pos = pos })
	DataService.MarkDirty(player)
end
EnemyService.WeaponDrop = weaponDrop

function EnemyService.Kill(enemy, killer: Player?)
	if enemy.Dead then
		return
	end
	enemy.Dead = true
	enemy.Humanoid.WalkSpeed = 0
	enemy.Bar.Enabled = false
	Net.FXAll("Kill", { Model = enemy.Model, Color = enemy.Color, Big = enemy.Boss, Elite = enemy.Elite, Pos = enemy.Root.Position, By = killer })
	if killer and EnemyService.OnKill then
		task.spawn(EnemyService.OnKill, killer, enemy)
	end
	if enemy.OnDeath then
		task.spawn(enemy.OnDeath, killer)
	else
		for player in pairs(enemy.Damagers) do
			if player.Parent then
				reward(player, enemy)
			end
		end
	end
	EnemyService.Ragdoll(enemy, 1, true)
	task.delay(0.9, function()
		local idx = table.find(EnemyService.Active, enemy)
		if idx then
			table.remove(EnemyService.Active, idx)
		end
		enemy.Model:Destroy()
	end)
	if enemy.StageIndex and not enemy.Owner then
		local stage = Config.Stages[enemy.StageIndex]
		task.delay(stage.Boss and Config.BossRespawn or Config.EnemyRespawn, spawnForStage, enemy.StageIndex, true)
	end
end

function EnemyService.Damage(enemy, player: Player, amount: number, crit: boolean?)
	if enemy.Dead or (enemy.Owner and enemy.Owner ~= player) then
		return
	end
	amount = math.max(1, math.floor(amount))
	enemy.HP -= amount
	enemy.Damagers[player] = true
	enemy.LastDamaged = os.clock()
	enemy.Bar.Enabled = true
	enemy.Fill.Size = UDim2.fromScale(math.clamp(enemy.HP / enemy.MaxHP, 0, 1), 1)
	enemy.HPText.Text = Format.Abbrev(math.max(0, enemy.HP))
	Net.FXAll("Hit", { Pos = enemy.Root.Position + Vector3.new(0, enemy.Scale, 0), Amount = amount, Crit = crit, Model = enemy.Model, Color = enemy.Color, By = player })
	if enemy.HP <= 0 then
		EnemyService.Kill(enemy, player)
	end
end

function EnemyService.DoT(e, player: Player, perTick: number, count: number, interval: number, color: Color3?)
	task.spawn(function()
		for _ = 1, count do
			task.wait(interval)
			if e.Dead then
				return
			end
			EnemyService.Damage(e, player, perTick, false)
			if color then
				Net.FXAll("Impact", { Pos = e.Root.Position, Color = color, Radius = 3, Kind = "Burn" })
			end
		end
	end)
end

---------------------------------------------------------------------
-- AI
---------------------------------------------------------------------
local function playerRoots()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if r and h and h.Health > 0 then
			table.insert(list, { Player = p, Root = r })
		end
	end
	return list
end

local function inBounds(e, pos: Vector3, pad: number): boolean
	return pos.X >= e.Min.X - pad and pos.X <= e.Max.X + pad and pos.Z >= e.Min.Z - pad and pos.Z <= e.Max.Z + pad and math.abs(pos.Y - e.Home.Y) < 40
end

local function clampToBounds(e, pos: Vector3): Vector3
	return Vector3.new(math.clamp(pos.X, e.Min.X, e.Max.X), pos.Y, math.clamp(pos.Z, e.Min.Z, e.Max.Z))
end

local function face(e, pos: Vector3)
	local from = e.Root.Position
	local look = Vector3.new(pos.X, from.Y, pos.Z)
	if (look - from).Magnitude > 0.1 then
		e.Root.CFrame = CFrame.lookAt(from, look)
	end
end

local function moveToward(e, goal: Vector3)
	goal = clampToBounds(e, goal)
	local t = os.clock()
	local dist = (goal - e.Root.Position).Magnitude
	if dist < 16 then
		e.Waypoints = nil
		e.Humanoid:MoveTo(goal)
		return
	end
	if t >= e.NextPath and not e.Computing then
		e.NextPath = t + AI.PathRecompute
		e.Computing = true
		task.spawn(function()
			e.Path = e.Path or PathfindingService:CreatePath({ AgentRadius = 2 * e.Scale, AgentHeight = 5 * e.Scale, AgentCanJump = false })
			local ok = pcall(function()
				e.Path:ComputeAsync(e.Root.Position, goal)
			end)
			if ok and e.Path.Status == Enum.PathStatus.Success then
				e.Waypoints = e.Path:GetWaypoints()
				e.WpIndex = 2
			else
				e.Waypoints = nil
			end
			e.Computing = false
		end)
	end
	local wps = e.Waypoints
	if wps and e.WpIndex and e.WpIndex <= #wps then
		local wp = wps[e.WpIndex].Position
		local flatD = Vector3.new(wp.X - e.Root.Position.X, 0, wp.Z - e.Root.Position.Z).Magnitude
		if flatD < 3 then
			e.WpIndex += 1
		end
		e.Humanoid:MoveTo(wp)
	else
		e.Humanoid:MoveTo(goal)
	end
end

local function basicAttack(e, target)
	e.State = "Attack"
	e.LastBasic = os.clock()
	e.Humanoid:MoveTo(e.Root.Position)
	face(e, target.Root.Position)
	local track = e.Tracks.BasicAttack
	if track then
		track:Play(0.05)
	end
	Net.FXAll("EnemySwipe", { Pos = e.Root.Position, Target = target.Root.Position, Color = e.Color })
	task.spawn(function()
		waitForHit(track, Config.EnemyAnims.BasicHitTime)
		if not e.Dead and not e.Ragdolled and os.clock() >= e.StunnedUntil and target.Root.Parent then
			local reach = Config.EnemyAttackRange + e.Radius
			if (target.Root.Position - e.Root.Position).Magnitude <= reach * 1.2 then
				EnemyService.HitPlayer(target.Player, e.HitPercent, e.Root.Position)
			end
		end
		task.wait(0.25)
		if e.State == "Attack" then
			e.State = "Chase"
		end
	end)
end

-- Special attack state machine: wind-up (telegraph) -> release (hit sync).
local function specialAttack(e, target)
	local tier = tierKey(e)
	e.State = "Windup"
	e.NextSpecial = os.clock() + AI.SpecialCooldown[tier]
	e.Humanoid:MoveTo(e.Root.Position)
	face(e, target.Root.Position)
	local windup = AI.Windup[tier]
	local kind = e.Boss and "Slam" or "Lunge"
	local start = e.Root.Position
	local dir = Vector3.new(target.Root.Position.X - start.X, 0, target.Root.Position.Z - start.Z)
	dir = dir.Magnitude > 0.1 and dir.Unit or e.Root.CFrame.LookVector
	local ground = Vector3.new(start.X, e.Home.Y + 0.2, start.Z)
	local slamAt = Vector3.new(target.Root.Position.X, e.Home.Y + 0.2, target.Root.Position.Z)
	local lungeLen = 16 * math.max(1, e.Scale * 0.7)
	local radius = e.Boss and Config.BossSlamRadius or 5
	local wind = e.Tracks.SpecialWindup
	if wind then
		wind:Play(0.1)
		wind:AdjustSpeed(math.clamp(wind.Length / windup, 0.5, 2))
	end
	Net.FXAll("EnemyWindup", {
		Model = e.Model,
		Kind = kind,
		Pos = kind == "Slam" and slamAt or ground,
		Dir = dir,
		Length = lungeLen,
		Radius = radius,
		Time = windup,
		Color = e.Color,
	})
	task.spawn(function()
		task.wait(windup)
		if wind then
			wind:Stop(0.1)
		end
		if e.Dead or e.Ragdolled or os.clock() < e.StunnedUntil then
			e.State = "Chase"
			return
		end
		local release = e.Tracks.SpecialRelease
		if release then
			release:Play(0.05)
		end
		if kind == "Lunge" then
			e.Root.AssemblyLinearVelocity = dir * 70 + Vector3.new(0, 5, 0)
		end
		waitForHit(release, Config.EnemyAnims.SpecialHitTime)
		if e.Dead then
			return
		end
		local pct = AI.SpecialPercent[tier]
		if kind == "Slam" then
			Net.FXAll("Slam", { Pos = slamAt, Radius = radius, Color = e.Color })
			for _, pr in ipairs(playerRoots()) do
				local d = Vector3.new(pr.Root.Position.X - slamAt.X, 0, pr.Root.Position.Z - slamAt.Z).Magnitude
				if d <= radius and (not e.Owner or e.Owner == pr.Player) then
					EnemyService.HitPlayer(pr.Player, pct, slamAt, 0.6)
				end
			end
		else
			local finish = start + dir * lungeLen
			Net.FXAll("EnemyLunge", { From = start, To = finish, Color = e.Color })
			for _, pr in ipairs(playerRoots()) do
				local p = pr.Root.Position
				local ab = finish - start
				local tt = math.clamp((p - start):Dot(ab) / ab:Dot(ab), 0, 1)
				if (p - (start + ab * tt)).Magnitude <= 4.5 and (not e.Owner or e.Owner == pr.Player) then
					EnemyService.HitPlayer(pr.Player, pct, start, 0.3)
				end
			end
		end
		task.wait(0.5)
		e.State = "Chase"
	end)
end

local function stepAI()
	local roots = playerRoots()
	local t = os.clock()
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead and e.Root.Parent and not e.Ragdolled and t >= e.StunnedUntil and e.State ~= "Windup" and e.State ~= "Attack" then
			local epos = e.Root.Position
			local target, targetDist = nil, math.huge
			local nearest = math.huge
			for _, pr in ipairs(roots) do
				local d = (pr.Root.Position - epos).Magnitude
				nearest = math.min(nearest, d)
				if (not e.Owner or e.Owner == pr.Player) and d < Config.EnemyAggroRange * (e.Boss and 1.6 or 1) and d < targetDist and inBounds(e, pr.Root.Position, 6) then
					target, targetDist = pr, d
				end
			end
			-- health bar only while recently damaged or players are in aggro range
			local showBar = e.Boss or (t - e.LastDamaged < AI.HealthBarShowTime) or nearest < Config.EnemyAggroRange
			if e.Bar.Enabled ~= showBar then
				e.Bar.Enabled = showBar
			end
			if nearest < 220 then
				if target then
					e.State = "Chase"
					local tier = tierKey(e)
					local reach = Config.EnemyAttackRange + e.Radius
					if t >= e.NextSpecial and targetDist <= AI.SpecialRange[tier] then
						specialAttack(e, target)
					elseif targetDist <= reach and t - e.LastBasic >= Config.EnemyAttackCooldown then
						basicAttack(e, target)
					elseif targetDist > reach * 0.8 then
						moveToward(e, target.Root.Position)
					else
						e.Humanoid:MoveTo(epos)
						face(e, target.Root.Position)
					end
				else
					e.State = "Idle"
					if t >= e.NextWander then
						e.NextWander = t + 2 + math.random() * 3
						e.Humanoid:MoveTo(e.Boss and e.Home or (randomPoint(e.Min, e.Max) + Vector3.new(0, e.Home.Y, 0)))
					end
				end
			end
		end
	end
end

function EnemyService.Init(m)
	map = m
	-- build one rig template per look (yields while the rigs load)
	for i in pairs(Config.EnemyLooks) do
		templates[i] = buildTemplate(i)
	end
	for stageIndex, stage in ipairs(Config.Stages) do
		if map.Dungeons[stage.Zone] then
			for _ = 1, stage.Count do
				spawnForStage(stageIndex, false)
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.15)
			local ok, err = pcall(stepAI)
			if not ok then
				warn("[Enemy AI]", err)
			end
		end
	end)
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Loot</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Loot (ModuleScript) -> ServerScriptService/Server/Loot
-- Ore rolls, drops, pickup, backpack, forging and selling.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))

local Loot = {}

-- Roll one ore from a weight table. Luck multiplies rarer ores' weights.
function Loot.RollOre(drops: { [string]: number }, luck: number, minOrder: number?): string
	local total = 0
	local entries = {}
	for oreId, weight in pairs(drops) do
		local ore = Config.OreById[oreId]
		if ore and (not minOrder or ore.Order >= minOrder) then
			local w = weight * luck ^ ((ore.Order - 1) * 0.5)
			total += w
			table.insert(entries, { oreId, w })
		end
	end
	if #entries == 0 then
		-- nothing matched the minimum rarity: give the rarest ore in the table
		local best, bestOrder = "RiftPebble", 0
		for oreId in pairs(drops) do
			local ore = Config.OreById[oreId]
			if ore and ore.Order > bestOrder then
				best, bestOrder = oreId, ore.Order
			end
		end
		return best
	end
	local r = math.random() * total
	for _, e in ipairs(entries) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return entries[#entries][1]
end

---------------------------------------------------------------------
-- INDEX (first-time discovery rewards)
---------------------------------------------------------------------
local function discover(player: Player, data, oreId: string)
	if data.Index[oreId] then
		return
	end
	data.Index[oreId] = true
	local ore = Config.OreById[oreId]
	local reward = Config.IndexReward[ore.Rarity] or 0
	data.Coins += reward
	Net.FX(player, "Discover", { Ore = oreId, Reward = reward })
end

---------------------------------------------------------------------
-- ADD ORE (backpack / auto-forge)
---------------------------------------------------------------------
function Loot.Forge(player: Player, oreId: string?, silent: boolean?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local gained = 0
	local used = {}
	local mult = Stats.ForgeMult(player)
	for id, count in pairs(data.Backpack) do
		if count > 0 and (oreId == nil or oreId == id) then
			local ore = Config.OreById[id]
			if ore then
				gained += ore.Forge * count
				used[id] = count
			end
			data.Backpack[id] = nil
		end
	end
	if gained <= 0 then
		return 0
	end
	gained = math.max(1, math.floor(gained * mult))
	local before = data.Blade
	data.Blade += gained
	local _, tierBefore = Config.GetBladeTier(before)
	local tier, tierAfter = Config.GetBladeTier(data.Blade)
	Weapons.Refresh(player)
	DataService.MarkDirty(player)
	if not silent then
		Net.FX(player, "Forge", {
			Gained = gained,
			From = before,
			To = data.Blade,
			Ores = used,
			TierUp = tierAfter > tierBefore and tierAfter or nil,
			TierName = tier.Name,
			Milestone = math.floor(data.Blade / 10) > math.floor(before / 10),
		})
		Net.FXAll("ForgeBurst", { Player = player })
	end
	return gained
end

function Loot.AddOre(player: Player, oreId: string, count: number): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	count = count or 1
	discover(player, data, oreId)
	if Stats.HasPass(player, "AutoForge") then
		local ore = Config.OreById[oreId]
		local before = data.Blade
		local gained = math.max(1, math.floor(ore.Forge * count * Stats.ForgeMult(player)))
		data.Blade += gained
		local _, tb = Config.GetBladeTier(before)
		local tier, ta = Config.GetBladeTier(data.Blade)
		if ta > tb or math.floor(data.Blade / 10) > math.floor(before / 10) then
			Weapons.Refresh(player)
			Net.FX(player, "Forge", { Gained = gained, From = before, To = data.Blade, Ores = { [oreId] = count }, TierUp = ta > tb and ta or nil, TierName = tier.Name, Milestone = true, Auto = true })
		end
		DataService.MarkDirty(player)
		return true
	end
	local max = Stats.BackpackMax(player)
	local have = Stats.BackpackCount(data)
	if have >= max then
		return false
	end
	data.Backpack[oreId] = (data.Backpack[oreId] or 0) + math.min(count, max - have)
	DataService.MarkDirty(player)
	return true
end

---------------------------------------------------------------------
-- DROPS (rendered on the owner's client, validated here)
---------------------------------------------------------------------
function Loot.Drop(player: Player, oreId: string, pos: Vector3)
	local s = DataService.Session(player)
	if not s then
		return
	end
	if Stats.HasPass(player, "AutoCollect") then
		local ok = Loot.AddOre(player, oreId, 1)
		Net.FX(player, "Drop", { Ore = oreId, Pos = pos, Auto = ok })
		if ok then
			return
		end
		Loot.NotifyFull(player)
	end
	s.NextDropId += 1
	local id = s.NextDropId
	s.Drops[id] = { Ore = oreId, Pos = pos, Expire = os.clock() + Config.DropLifetime }
	Net.FX(player, "Drop", { Id = id, Ore = oreId, Pos = pos })
end

function Loot.NotifyFull(player: Player)
	local s = DataService.Session(player)
	if s and os.clock() - s.LastFullNotify > 3 then
		s.LastFullNotify = os.clock()
		Net.Notify(player, "Backpack full! Forge or Sell your ore in the Hub.", Color3.fromRGB(255, 120, 90), "Error")
	end
end

function Loot.Collect(player: Player, id: number)
	local s = DataService.Session(player)
	if not s or type(id) ~= "number" then
		return
	end
	local drop = s.Drops[id]
	if not drop then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - drop.Pos).Magnitude > Config.PickupRadius + 14 then
		Net.FX(player, "CollectFail", { Id = id })
		return
	end
	if Loot.AddOre(player, drop.Ore, 1) then
		s.Drops[id] = nil
		Net.FX(player, "Collected", { Id = id, Ore = drop.Ore })
	else
		Loot.NotifyFull(player)
		Net.FX(player, "CollectFail", { Id = id, Full = true })
	end
end

function Loot.CleanupDrops(player: Player)
	local s = DataService.Session(player)
	if not s then
		return
	end
	local t = os.clock()
	for id, d in pairs(s.Drops) do
		if d.Expire < t then
			s.Drops[id] = nil
		end
	end
end

---------------------------------------------------------------------
-- SELL
---------------------------------------------------------------------
function Loot.Sell(player: Player, oreId: string?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local coins = 0
	for id, count in pairs(data.Backpack) do
		if oreId == nil or oreId == id then
			local ore = Config.OreById[id]
			if ore then
				coins += ore.Sell * count
			end
			data.Backpack[id] = nil
		end
	end
	if coins <= 0 then
		return 0
	end
	coins = math.floor(coins * Stats.CoinMult(player))
	data.Coins += coins
	DataService.MarkDirty(player)
	Net.FX(player, "Sell", { Coins = coins, Text = "+" .. Format.Abbrev(coins) .. " Coins" })
	return coins
end

return Loot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapBuilder (ModuleScript) -> ServerScriptService/Server/MapBuilder
-- Builds the whole world in code, laid out like +1 Loot To Forge:
--   Hub (spawn plaza) with the Forge cauldron, Sell stall, Upgrade stall,
--   Rebirth statue, Race altar, Index board and Leaderboard.
--   Train area (multiplier pads) to the west.
--   Dungeon portals to the north -> linear stage-by-stage dungeons.
--   Infinite Tower to the east.
-- There is NO VIP room and NO PvP arena.

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local Format = require(Shared:WaitForChild("Format"))

local MapBuilder = {}

local WHITE = Color3.new(1, 1, 1)
local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> Y (flat disc)

local root: Folder
local buildChestShrine, buildAmbient

local function P(parent: Instance, props): Part
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "ClassName" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p :: any
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function disc(parent, pos: Vector3, diameter: number, thickness: number, color: Color3, material: Enum.Material?, name: string?)
	return P(parent, {
		Name = name or "Disc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, diameter, diameter),
		CFrame = CFrame.new(pos) * FLAT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function billboard(adornee: Instance, title: string, sub: string?, color: Color3, height: number, scale)
	scale = scale or 1
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(320 * scale, (sub and 110 or 70) * scale)
	bb.StudsOffset = Vector3.new(0, height, 0)
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.Parent = adornee
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, sub and 0.62 or 1)
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = true
	t.Text = title
	t.TextColor3 = color
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(15, 10, 25)
	st.Parent = t
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(WHITE, color)
	g.Rotation = 90
	g.Parent = t
	if sub then
		local s = Instance.new("TextLabel")
		s.Name = "Sub"
		s.BackgroundTransparency = 1
		s.Position = UDim2.fromScale(0, 0.62)
		s.Size = UDim2.fromScale(1, 0.38)
		s.Font = Enum.Font.FredokaOne
		s.TextScaled = true
		s.Text = sub
		s.TextColor3 = WHITE
		s.Parent = bb
		local ss = Instance.new("UIStroke")
		ss.Thickness = 2
		ss.Color = Color3.fromRGB(15, 10, 25)
		ss.Parent = s
	end
	return bb
end

-- Custom-styled prompt (drawn by Client/PromptUI). "key" is the server
-- action run when the client reports the prompt was triggered.
local function prompt(parent: Instance, action: string, object: string, name: string, key: string): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = Config.Prompt.MaxActivationDistance
	pp.RequiresLineOfSight = Config.Prompt.RequiresLineOfSight
	pp.Style = Enum.ProximityPromptStyle.Custom
	-- F / D-pad up, because E / X are the weapon-skill binds
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp.GamepadKeyCode = Enum.KeyCode.DPadUp
	pp:SetAttribute("Action", key)
	pp.Parent = parent
	return pp
end

local function emitter(parent: Instance, preset: string, color: Color3, rate: number, offset: Vector3?)
	local a = Instance.new("Attachment")
	a.Position = offset or Vector3.zero
	a.Parent = parent
	local e = VFX.MakeEmitter(preset, color, a, rate)
	return e, a
end

local function light(parent: Instance, color: Color3, range: number, brightness: number, shadows: boolean?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

local function loopSound(parent: Instance, id: string, volume: number, pitch: number)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = volume
	s.PlaybackSpeed = pitch
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 80
	s.Parent = parent
	s.Playing = true
	return s
end

local function spin(inst: Instance, speed: number, bob: number?)
	inst:SetAttribute("SpinSpeed", speed)
	if bob then
		inst:SetAttribute("Bob", bob)
	end
	CollectionService:AddTag(inst, "Spin")
end

---------------------------------------------------------------------
-- LIGHTING (bright anime look: bloom, saturation, sun rays)
---------------------------------------------------------------------
local function buildLighting()
	local G = Config.Graphics
	-- Technology can't be set from scripts (Roblox security); the place file
	-- ships with Future. This pcall just makes the intent explicit.
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = 15.3
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(80, 75, 100)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 130, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0.05
	Lighting.GeographicLatitude = 30

	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = G.Atmosphere.Density
	atm.Offset = G.Atmosphere.Offset
	atm.Color = G.Atmosphere.Color
	atm.Decay = G.Atmosphere.Decay
	atm.Glare = G.Atmosphere.Glare
	atm.Haze = G.Atmosphere.Haze
	atm.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Threshold = G.Bloom.Threshold
	bloom.Size = G.Bloom.Size
	bloom.Intensity = G.Bloom.Intensity
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GameColor"
	cc.Contrast = G.ColorCorrection.Contrast
	cc.Saturation = G.ColorCorrection.Saturation
	cc.Brightness = G.ColorCorrection.Brightness
	cc.TintColor = Color3.fromRGB(255, 250, 255)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = G.SunRays.Intensity
	rays.Spread = G.SunRays.Spread
	rays.Parent = Lighting
end

-- Optional PBR MaterialVariants from Config.Graphics.MaterialVariants.
local function applyMaterialVariants(folderRoot: Instance)
	local variants = {}
	for matName, maps in pairs(Config.Graphics.MaterialVariants) do
		local base = (Enum.Material :: any)[matName]
		if base and maps.ColorMap and maps.ColorMap ~= "rbxassetid://0" then
			local name = "Anime_" .. matName
			local mv = MaterialService:FindFirstChild(name) or Instance.new("MaterialVariant")
			mv.Name = name
			mv.BaseMaterial = base
			mv.ColorMap = maps.ColorMap
			mv.NormalMap = maps.NormalMap or ""
			mv.RoughnessMap = maps.RoughnessMap or ""
			mv.MetalnessMap = maps.MetalnessMap or ""
			mv.Parent = MaterialService
			variants[base] = name
		end
	end
	if next(variants) == nil then
		return
	end
	for _, d in ipairs(folderRoot:GetDescendants()) do
		if d:IsA("BasePart") and variants[d.Material] then
			d.MaterialVariant = variants[d.Material]
		end
	end
end

-- Big invisible volumes that emit ambient particles.
local function ambientVolume(parent: Instance, cf: CFrame, size: Vector3, preset: string, color: Color3, rate: number)
	local vol = P(parent, { Name = "AmbientFX", Size = size, CFrame = cf, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	local e = VFX.MakeEmitter(preset, color, vol, rate)
	e.Shape = Enum.ParticleEmitterShape.Box
	return e
end

---------------------------------------------------------------------
-- DECOR PIECES
---------------------------------------------------------------------
local function cherryTree(parent, pos: Vector3, scale: number, rng: Random)
	local m = Instance.new("Model")
	m.Name = "CherryTree"
	local trunkH = 10 * scale
	P(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(trunkH, 1.8 * scale, 1.8 * scale), CFrame = CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * FLAT, Color = Color3.fromRGB(95, 60, 55), Material = Enum.Material.Wood })
	local pinks = { Color3.fromRGB(255, 170, 205), Color3.fromRGB(255, 195, 220), Color3.fromRGB(250, 145, 190) }
	local top = pos + Vector3.new(0, trunkH, 0)
	local canopy
	for i = 1, 4 do
		local off = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-0.5, 2.5), rng:NextNumber(-3, 3)) * scale
		local s = rng:NextNumber(7, 10) * scale
		canopy = P(m, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * s, CFrame = CFrame.new(top + off), Color = pinks[(i % 3) + 1], Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = true })
	end
	if canopy then
		emitter(canopy, "Petals", Color3.fromRGB(255, 170, 210), 1.2)
	end
	m.Parent = parent
	return m
end

local function lantern(parent, pos: Vector3, color: Color3?)
	color = color or Color3.fromRGB(255, 190, 110)
	P(parent, { Name = "LanternPost", Size = Vector3.new(0.6, 8, 0.6), CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)), Color = Color3.fromRGB(60, 40, 40), Material = Enum.Material.Wood })
	P(parent, { Name = "LanternArm", Size = Vector3.new(0.4, 0.4, 2.2), CFrame = CFrame.new(pos + Vector3.new(0, 7.8, 0.9)), Color = Color3.fromRGB(60, 40, 40), Material = Enum.Material.Wood })
	local lamp = P(parent, { Name = "Lantern", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8), CFrame = CFrame.new(pos + Vector3.new(0, 6.8, 1.8)), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	light(lamp, color :: Color3, 18, 1.4, true)
	return lamp
end

local function torii(parent, cf: CFrame, width: number, height: number)
	local red = Color3.fromRGB(215, 45, 45)
	local black = Color3.fromRGB(30, 25, 30)
	for _, side in ipairs({ -1, 1 }) do
		P(parent, { Name = "ToriiPillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 1.8, 1.8), CFrame = cf * CFrame.new(side * width / 2, height / 2, 0) * FLAT, Color = red, Material = Enum.Material.SmoothPlastic })
	end
	P(parent, { Name = "ToriiTop", Size = Vector3.new(width + 6, 1.4, 2.2), CFrame = cf * CFrame.new(0, height + 0.7, 0), Color = black })
	P(parent, { Name = "ToriiBeam", Size = Vector3.new(width + 4, 1.2, 1.6), CFrame = cf * CFrame.new(0, height - 2.2, 0), Color = red })
	P(parent, { Name = "ToriiBeam2", Size = Vector3.new(width + 2, 1, 1.4), CFrame = cf * CFrame.new(0, height - 0.4, 0), Color = red })
end

local function stall(parent, cf: CFrame, color: Color3, title: string, sub: string)
	local m = Instance.new("Model")
	m.Name = title .. "Stall"
	local wood = Color3.fromRGB(140, 95, 60)
	P(m, { Name = "Floor", Size = Vector3.new(16, 0.6, 12), CFrame = cf * CFrame.new(0, 0.3, 0), Color = Color3.fromRGB(110, 80, 55), Material = Enum.Material.WoodPlanks })
	local counter = P(m, { Name = "Counter", Size = Vector3.new(12, 3.4, 2.6), CFrame = cf * CFrame.new(0, 2.3, 3), Color = wood, Material = Enum.Material.WoodPlanks })
	P(m, { Name = "CounterTop", Size = Vector3.new(12.6, 0.4, 3.2), CFrame = cf * CFrame.new(0, 4.1, 3), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood })
	for _, x in ipairs({ -7, 7 }) do
		for _, z in ipairs({ -5, 4.5 }) do
			P(m, { Name = "Post", Size = Vector3.new(0.8, 10, 0.8), CFrame = cf * CFrame.new(x, 5, z), Color = wood, Material = Enum.Material.Wood })
		end
	end
	-- striped awning
	for i = 0, 7 do
		local c = (i % 2 == 0) and color or WHITE
		P(m, { Name = "Awning", Size = Vector3.new(1.95, 0.4, 12), CFrame = cf * CFrame.new(-7 + i * 2 + 1, 10.4, 0) * CFrame.Angles(math.rad(-12), 0, 0), Color = c })
	end
	-- crates of glowing ore
	for i, ore in ipairs({ Config.Ores[1], Config.Ores[3], Config.Ores[4] }) do
		local crate = P(m, { Name = "Crate", Size = Vector3.new(2.6, 2, 2.6), CFrame = cf * CFrame.new(-6 + i * 3, 1.6, -3.5), Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.WoodPlanks })
		for j = 1, 3 do
			P(m, { Name = "Ore", Size = Vector3.one * 0.8, CFrame = crate.CFrame * CFrame.new((j - 2) * 0.7, 1.2, (j % 2) * 0.4) * CFrame.Angles(0.4 * j, 0.7 * j, 0.2), Color = ore.Color, Material = Enum.Material.Neon, CanCollide = false })
		end
	end
	billboard(counter, title, sub, color, 10.5, 0.9)
	m.Parent = parent
	return m, counter
end

---------------------------------------------------------------------
-- HUB
---------------------------------------------------------------------
local function buildHub(map)
	local hub = folder("Hub", root)
	local rng = Random.new(7)

	P(hub, { Name = "Ground", Size = Vector3.new(900, 4, 900), CFrame = CFrame.new(0, -2, 0), Color = Color3.fromRGB(105, 175, 95), Material = Enum.Material.Grass })

	-- Plaza rings
	disc(hub, Vector3.new(0, 0.15, 0), 120, 0.3, Color3.fromRGB(215, 205, 190), Enum.Material.Slate, "Plaza")
	disc(hub, Vector3.new(0, 0.2, 0), 104, 0.3, Color3.fromRGB(235, 225, 215), Enum.Material.Marble, "PlazaInner")
	disc(hub, Vector3.new(0, 0.25, 0), 60, 0.3, Color3.fromRGB(245, 200, 215), Enum.Material.Marble, "PlazaCore")
	local ringNeon = disc(hub, Vector3.new(0, 0.27, 0), 62, 0.25, Color3.fromRGB(255, 120, 190), Enum.Material.Neon, "PlazaGlow")
	ringNeon.Transparency = 0.4

	-- Paths
	local path = Color3.fromRGB(190, 180, 165)
	P(hub, { Name = "PathTrain", Size = Vector3.new(50, 0.3, 14), CFrame = CFrame.new(-80, 0.15, 0), Color = path, Material = Enum.Material.Cobblestone })
	P(hub, { Name = "PathPortals", Size = Vector3.new(14, 0.3, 50), CFrame = CFrame.new(0, 0.15, -82), Color = path, Material = Enum.Material.Cobblestone })
	P(hub, { Name = "PathTower", Size = Vector3.new(80, 0.3, 14), CFrame = CFrame.new(95, 0.15, 0), Color = path, Material = Enum.Material.Cobblestone })

	-- Spawn
	local spawn = P(hub, { ClassName = "SpawnLocation", Name = "Spawn", Size = Vector3.new(10, 0.6, 10), CFrame = CFrame.new(0, 0.5, 26), Color = Color3.fromRGB(255, 150, 200), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = true })
	spawn.Duration = 0
	spawn.Neutral = true
	emitter(spawn, "Rise", Color3.fromRGB(255, 170, 220), 6)
	map.HubCFrame = CFrame.new(0, 4, 22)

	---------------- FORGE (center) ----------------
	local forgeModel = Instance.new("Model")
	forgeModel.Name = "Forge"
	local fpos = Vector3.new(0, 0, -30)
	disc(forgeModel, fpos + Vector3.new(0, 0.6, 0), 28, 1.2, Color3.fromRGB(70, 65, 75), Enum.Material.Slate, "ForgeBase")
	disc(forgeModel, fpos + Vector3.new(0, 1.3, 0), 24, 0.3, Color3.fromRGB(255, 110, 30), Enum.Material.Neon, "ForgeGlowRing").Transparency = 0.5
	for i = 1, 3 do
		local a = i * (math.pi * 2 / 3)
		P(forgeModel, { Name = "Leg", Size = Vector3.new(1.4, 3, 1.4), CFrame = CFrame.new(fpos + Vector3.new(math.cos(a) * 4.6, 2.7, math.sin(a) * 4.6)), Color = Color3.fromRGB(35, 30, 35), Material = Enum.Material.Metal })
	end
	local pot = P(forgeModel, { Name = "Cauldron", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 13, 13), CFrame = CFrame.new(fpos + Vector3.new(0, 6.5, 0)) * FLAT, Color = Color3.fromRGB(40, 35, 45), Material = Enum.Material.Metal })
	P(forgeModel, { Name = "Belly", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 9, 14), CFrame = CFrame.new(fpos + Vector3.new(0, 5.5, 0)), Color = Color3.fromRGB(40, 35, 45), Material = Enum.Material.Metal })
	disc(forgeModel, fpos + Vector3.new(0, 9.6, 0), 14.4, 0.9, Color3.fromRGB(60, 55, 65), Enum.Material.Metal, "Rim")
	local lava = disc(forgeModel, fpos + Vector3.new(0, 9.7, 0), 12, 0.6, Color3.fromRGB(255, 120, 30), Enum.Material.Neon, "Lava")
	light(lava, Color3.fromRGB(255, 140, 50), 34, 3, true)
	emitter(lava, "Embers", Color3.fromRGB(255, 150, 60), 14, Vector3.new(0, 0.5, 0))
	emitter(lava, "Fire", Color3.fromRGB(255, 120, 30), 10, Vector3.new(0, 0.5, 0))
	local _, fireAtt = emitter(forgeModel.PrimaryPart or pot, "Fire", Color3.fromRGB(255, 90, 20), 22)
	fireAtt.WorldPosition = fpos + Vector3.new(0, 1.8, 0)
	loopSound(lava, "rbxasset://sounds/action_swim.mp3", 0.5, 0.35)
	-- chimney hood
	P(forgeModel, { Name = "Chimney", Size = Vector3.new(7, 26, 7), CFrame = CFrame.new(fpos + Vector3.new(0, 13, -12)), Color = Color3.fromRGB(120, 70, 60), Material = Enum.Material.Brick })
	local chimTop = P(forgeModel, { Name = "ChimneyTop", Size = Vector3.new(8.5, 1.5, 8.5), CFrame = CFrame.new(fpos + Vector3.new(0, 26.5, -12)), Color = Color3.fromRGB(60, 50, 55), Material = Enum.Material.Slate })
	emitter(chimTop, "Smoke", Color3.fromRGB(120, 115, 125), 4, Vector3.new(0, 1, 0))
	-- anvil
	P(forgeModel, { Name = "AnvilBase", Size = Vector3.new(2, 2.4, 2), CFrame = CFrame.new(fpos + Vector3.new(10, 2.4, 5)), Color = Color3.fromRGB(50, 50, 60), Material = Enum.Material.Metal })
	P(forgeModel, { Name = "AnvilTop", Size = Vector3.new(4.5, 1.2, 2.2), CFrame = CFrame.new(fpos + Vector3.new(10, 4.2, 5)), Color = Color3.fromRGB(70, 70, 85), Material = Enum.Material.Metal })
	billboard(lava, "FORGE", "Smelt ore -> +1 Forge level", Color3.fromRGB(255, 160, 60), 9)
	local forgePrompt = prompt(lava, "Forge Ore", "Forge Cauldron", "ForgePrompt", "Forge")
	forgeModel.Parent = hub
	map.Forge = lava
	map.ForgePrompt = forgePrompt

	---------------- SELL + UPGRADES ----------------
	local _, sellCounter = stall(hub, CFrame.new(-40, 0, -20) * CFrame.Angles(0, math.rad(35), 0), Color3.fromRGB(255, 200, 60), "SELL", "Ore -> Coins")
	map.Sell = sellCounter
	map.SellPrompt = prompt(sellCounter, "Sell Ore", "Merchant", "SellPrompt", "Sell")
	local _, upCounter = stall(hub, CFrame.new(40, 0, -20) * CFrame.Angles(0, math.rad(-35), 0), Color3.fromRGB(80, 170, 255), "UPGRADES", "Backpack / Luck / Training")
	map.Upgrades = upCounter
	map.UpgradePrompt = prompt(upCounter, "Open Upgrades", "Trainer", "UpgradePrompt", "Upgrades")

	---------------- RACE ALTAR ----------------
	local altar = Instance.new("Model")
	altar.Name = "RaceAltar"
	local apos = Vector3.new(-42, 0, 22)
	disc(altar, apos + Vector3.new(0, 0.6, 0), 20, 1.2, Color3.fromRGB(60, 55, 90), Enum.Material.Slate, "AltarBase")
	disc(altar, apos + Vector3.new(0, 1.25, 0), 16, 0.2, Color3.fromRGB(140, 110, 255), Enum.Material.Neon, "AltarGlow").Transparency = 0.3
	local orb = P(altar, { Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 4, CFrame = CFrame.new(apos + Vector3.new(0, 7, 0)), Color = Color3.fromRGB(200, 170, 255), Material = Enum.Material.Neon, CanCollide = false })
	spin(orb, 0, 0.8)
	light(orb, Color3.fromRGB(170, 130, 255), 26, 2.5, true)
	emitter(orb, "Vortex", Color3.fromRGB(170, 120, 255), 3)
	emitter(orb, "Stars", Color3.fromRGB(200, 170, 255), 4)
	P(altar, { Name = "Pedestal", Size = Vector3.new(3, 4, 3), CFrame = CFrame.new(apos + Vector3.new(0, 3, 0)), Color = Color3.fromRGB(80, 70, 110), Material = Enum.Material.Marble })
	for i, race in ipairs(Config.Races) do
		local a = (i / #Config.Races) * math.pi * 2
		local crystal = P(altar, { Name = "Crystal_" .. race.Id, Size = Vector3.new(1.2, 3, 1.2), CFrame = CFrame.new(apos + Vector3.new(math.cos(a) * 7, 5, math.sin(a) * 7)) * CFrame.Angles(0, a, math.rad(45)), Color = race.Color, Material = Enum.Material.Neon, CanCollide = false })
		spin(crystal, 60, 0.6)
	end
	billboard(orb, "RACE ALTAR", "Roll your bloodline", Color3.fromRGB(190, 150, 255), 5)
	map.RacePrompt = prompt(orb, "Roll Race", "Race Altar", "RacePrompt", "Race")
	map.RacePrompt.MaxActivationDistance = 12
	altar.Parent = hub

	---------------- REBIRTH STATUE (giant sword in stone) ----------------
	local statue = Instance.new("Model")
	statue.Name = "RebirthStatue"
	local spos = Vector3.new(42, 0, 22)
	P(statue, { Name = "Rock", Size = Vector3.new(12, 5, 12), CFrame = CFrame.new(spos + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(120, 115, 130), Material = Enum.Material.Rock })
	P(statue, { Name = "Rock2", Size = Vector3.new(8, 3, 9), CFrame = CFrame.new(spos + Vector3.new(0, 5.5, 0)) * CFrame.Angles(0, math.rad(55), 0), Color = Color3.fromRGB(105, 100, 115), Material = Enum.Material.Rock })
	local blade = P(statue, { Name = "Blade", Size = Vector3.new(1.4, 20, 4), CFrame = CFrame.new(spos + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(6)), Color = Color3.fromRGB(220, 230, 245), Material = Enum.Material.Metal })
	P(statue, { Name = "Edge", Size = Vector3.new(0.6, 20, 0.5), CFrame = blade.CFrame * CFrame.new(0, 0, 2.1), Color = Color3.fromRGB(255, 215, 90), Material = Enum.Material.Neon, CanCollide = false })
	P(statue, { Name = "Guard", Size = Vector3.new(2, 1.6, 10), CFrame = blade.CFrame * CFrame.new(0, 10.6, 0), Color = Color3.fromRGB(255, 200, 70), Material = Enum.Material.Metal })
	P(statue, { Name = "Hilt", Size = Vector3.new(1.4, 6, 1.4), CFrame = blade.CFrame * CFrame.new(0, 14.2, 0), Color = Color3.fromRGB(80, 30, 40), Material = Enum.Material.Fabric })
	local pommel = P(statue, { Name = "Pommel", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, CFrame = blade.CFrame * CFrame.new(0, 17.6, 0), Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.Neon })
	light(pommel, Color3.fromRGB(255, 210, 90), 30, 2, true)
	emitter(blade, "Rise", Color3.fromRGB(255, 220, 110), 5)
	billboard(pommel, "REBIRTH", "Reset Power for permanent boosts", Color3.fromRGB(255, 215, 90), 4)
	local holder = P(statue, { Name = "PromptHolder", Size = Vector3.one, Transparency = 1, CanCollide = false, CFrame = CFrame.new(spos + Vector3.new(0, 4, 0)) })
	map.RebirthPrompt = prompt(holder, "Rebirth", "Sword of Ascension", "RebirthPrompt", "Rebirth")
	statue.Parent = hub

	---------------- INDEX + LEADERBOARD ----------------
	local function board(pos: Vector3, title: string, color: Color3)
		local b = P(hub, { Name = title .. "Board", Size = Vector3.new(18, 12, 1), CFrame = CFrame.lookAt(pos + Vector3.new(0, 8, 0), Vector3.new(0, 8, 0)), Color = Color3.fromRGB(40, 35, 50), Material = Enum.Material.Wood })
		for _, x in ipairs({ -8, 8 }) do
			P(hub, { Name = "BoardPost", Size = Vector3.new(1, 14, 1), CFrame = b.CFrame * CFrame.new(x, -1, 0.8), Color = Color3.fromRGB(90, 60, 45), Material = Enum.Material.Wood })
		end
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.Parent = b
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(20, 16, 32)
		bg.Parent = sg
		local grad = Instance.new("UIGradient")
		grad.Color = ColorSequence.new(Color3.fromRGB(40, 30, 70), Color3.fromRGB(15, 12, 25))
		grad.Rotation = 90
		grad.Parent = bg
		local t = Instance.new("TextLabel")
		t.Name = "Title"
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0.16, 0)
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Text = title
		t.TextColor3 = color
		t.Parent = bg
		local list = Instance.new("TextLabel")
		list.Name = "Body"
		list.BackgroundTransparency = 1
		list.Position = UDim2.fromScale(0.05, 0.18)
		list.Size = UDim2.fromScale(0.9, 0.8)
		list.Font = Enum.Font.FredokaOne
		list.TextScaled = true
		list.TextXAlignment = Enum.TextXAlignment.Left
		list.TextYAlignment = Enum.TextYAlignment.Top
		list.TextColor3 = WHITE
		list.RichText = true
		list.Text = ""
		list.Parent = bg
		return b, list
	end
	local indexBoard, indexBody = board(Vector3.new(-20, 0, 52), "ORE INDEX", Color3.fromRGB(120, 220, 255))
	local lines = {}
	for _, ore in ipairs(Config.Ores) do
		table.insert(lines, string.format('<font color="#%s">%s</font>  (%s)', ore.Color:ToHex(), ore.Name, Config.Rarity[ore.Rarity].Label))
	end
	indexBody.Text = table.concat(lines, "\n")
	map.IndexPrompt = prompt(indexBoard, "Open Index", "Ore Index", "IndexPrompt", "Index")
	local _, lbBody = board(Vector3.new(20, 0, 52), "TOP BLADES", Color3.fromRGB(255, 210, 80))
	lbBody.Text = "Loading..."
	map.LeaderboardText = lbBody

	---------------- TREES / LANTERNS / SKY RIFT ----------------
	for i = 1, 14 do
		local a = (i / 14) * math.pi * 2 + 0.2
		local r = 72 + rng:NextNumber(-4, 8)
		local pos = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		-- keep the paths clear
		if math.abs(pos.Z) > 12 or pos.X > -60 and pos.X < 60 then
			if not (math.abs(pos.X) < 12 and pos.Z < 0) then
				cherryTree(hub, pos, rng:NextNumber(0.9, 1.3), rng)
			end
		end
	end
	for _, pos in ipairs({ Vector3.new(-62, 0, 9), Vector3.new(-62, 0, -9), Vector3.new(-9, 0, -62), Vector3.new(9, 0, -62), Vector3.new(62, 0, 9), Vector3.new(62, 0, -9), Vector3.new(-9, 0, -100), Vector3.new(9, 0, -100) }) do
		lantern(hub, pos)
	end
	torii(hub, CFrame.new(-92, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 14, 16)
	torii(hub, CFrame.new(0, 0, -95), 14, 16)

	local rift = Instance.new("Model")
	rift.Name = "SkyRift"
	local center = Vector3.new(0, 150, -260)
	local segs = 28
	local ringHolder = P(rift, { Name = "RiftCore", Size = Vector3.one, Transparency = 1, CanCollide = false, CFrame = CFrame.new(center) })
	for i = 1, segs do
		local a = (i / segs) * math.pi * 2
		P(rift, { Name = "Seg", Size = Vector3.new(3, 10, 3), CFrame = CFrame.new(center) * CFrame.Angles(0, 0, a) * CFrame.new(0, 45, 0), Color = (i % 2 == 0) and Color3.fromRGB(0, 255, 225) or Color3.fromRGB(190, 90, 255), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
	end
	emitter(ringHolder, "Vortex", Color3.fromRGB(140, 90, 255), 2).Size = VFX.NS(0, 40, 1, 80)
	rift.PrimaryPart = ringHolder
	spin(rift, 8)
	rift:SetAttribute("SpinAxis", "Z")
	rift.Parent = hub
end

---------------------------------------------------------------------
-- TRAIN AREA
---------------------------------------------------------------------
local function buildTrain(map)
	local train = folder("TrainArea", root)
	local count = #Config.TrainPads
	local startX = -110
	local spacing = 24
	local endX = startX - (count - 1) * spacing
	local centerX = (startX + endX) / 2
	P(train, { Name = "Platform", Size = Vector3.new(math.abs(endX - startX) + 40, 1, 56), CFrame = CFrame.new(centerX, 0.4, 0), Color = Color3.fromRGB(175, 165, 180), Material = Enum.Material.Slate })
	P(train, { Name = "Trim", Size = Vector3.new(math.abs(endX - startX) + 42, 0.6, 58), CFrame = CFrame.new(centerX, 0.2, 0), Color = Color3.fromRGB(255, 130, 190), Material = Enum.Material.Neon, Transparency = 0.3 })
	local sign = P(train, { Name = "Sign", Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, CFrame = CFrame.new(startX + 12, 0, -22) })
	billboard(sign, "TRAIN AREA", "Swing or stand on a pad to gain Power", Color3.fromRGB(120, 255, 170), 10, 1.2)
	map.TrainCFrame = CFrame.new(startX + 8, 4, 0) * CFrame.Angles(0, math.rad(90), 0)

	map.TrainPads = {}
	for i, pad in ipairs(Config.TrainPads) do
		local pos = Vector3.new(startX - (i - 1) * spacing, 1, 0)
		local base = disc(train, pos, Config.TrainPadRadius * 2 + 1.2, 0.3, Color3.fromRGB(40, 35, 50), Enum.Material.Metal, "PadBase")
		local glow = disc(train, pos + Vector3.new(0, 0.15, 0), Config.TrainPadRadius * 2, 0.25, pad.Color, Enum.Material.Neon, "Pad")
		glow.Transparency = 0.35
		glow:SetAttribute("PadIndex", i)
		glow:SetAttribute("Mult", pad.Mult)
		glow:SetAttribute("PowerReq", pad.Power)
		glow:SetAttribute("RebirthReq", pad.Rebirths)
		CollectionService:AddTag(glow, "TrainPad")
		emitter(glow, "Rise", pad.Color, 3 + i)
		light(glow, pad.Color, 16, 1.2)
		local req = "Free"
		if pad.Rebirths > 0 then
			req = pad.Rebirths .. " Rebirth" .. (pad.Rebirths > 1 and "s" or "")
		elseif pad.Power > 0 then
			req = Format.Abbrev(pad.Power) .. " Power"
		end
		billboard(base, "x" .. Format.Abbrev(pad.Mult), req, pad.Color, 7, 0.7)
		-- training dummy behind each pad
		local dpos = pos + Vector3.new(0, 0, -16)
		P(train, { Name = "DummyPost", Size = Vector3.new(0.8, 6, 0.8), CFrame = CFrame.new(dpos + Vector3.new(0, 3, 0)), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.Wood })
		P(train, { Name = "Dummy", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 2.6, 2.6), CFrame = CFrame.new(dpos + Vector3.new(0, 5, 0)) * FLAT, Color = Color3.fromRGB(210, 180, 130), Material = Enum.Material.Fabric })
		P(train, { Name = "DummyHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(dpos + Vector3.new(0, 7.8, 0)), Color = Color3.fromRGB(210, 180, 130), Material = Enum.Material.Fabric })
		table.insert(map.TrainPads, { Part = glow, Config = pad, Index = i, Position = pos })
	end
end

---------------------------------------------------------------------
-- PORTALS
---------------------------------------------------------------------
local function buildPortals(map)
	local portals = folder("Portals", root)
	map.Portals = {}
	for i, zone in ipairs(Config.Zones) do
		local x = -64 + (i - 1) * 32
		local base = CFrame.new(x, 0, -118)
		local accent = zone.Accent or WHITE
		local stone = Color3.fromRGB(70, 65, 85)
		P(portals, { Name = "Step", Size = Vector3.new(22, 1, 10), CFrame = base * CFrame.new(0, 0.5, 0), Color = stone, Material = Enum.Material.Slate })
		for _, side in ipairs({ -1, 1 }) do
			P(portals, { Name = "Pillar", Size = Vector3.new(2.6, 18, 2.6), CFrame = base * CFrame.new(side * 8.5, 9.5, 0), Color = stone, Material = Enum.Material.Slate })
			P(portals, { Name = "PillarGlow", Size = Vector3.new(0.5, 16, 2.7), CFrame = base * CFrame.new(side * 7.1, 9.5, 0), Color = accent, Material = Enum.Material.Neon })
		end
		P(portals, { Name = "Lintel", Size = Vector3.new(22, 2.4, 3.2), CFrame = base * CFrame.new(0, 19.4, 0), Color = stone, Material = Enum.Material.Slate })
		local surface = P(portals, {
			Name = "Portal_" .. zone.Id,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 14.5, 14.5),
			CFrame = base * CFrame.new(0, 9.5, 0) * CFrame.Angles(0, math.rad(90), 0),
			Color = zone.ComingSoon and Color3.fromRGB(90, 90, 100) or accent,
			Material = Enum.Material.Neon,
			Transparency = zone.ComingSoon and 0.6 or 0.25,
			CanCollide = zone.ComingSoon == true,
		})
		surface:SetAttribute("Zone", zone.Id)
		if not zone.ComingSoon then
			emitter(surface, "Vortex", accent, 3).Size = VFX.NS(0, 8, 1, 14)
			emitter(surface, "Sparks", accent, 8).Speed = NumberRange.new(4, 10)
			light(surface, accent, 26, 2.5, true)
			loopSound(surface, "rbxasset://sounds/action_swim.mp3", 0.25, 0.22)
		end
		local sub
		if zone.ComingSoon then
			sub = "COMING SOON"
		elseif zone.BladeReq > 0 then
			sub = "Requires Blade +" .. zone.BladeReq
		else
			sub = "Stages 1-" .. Config.StagesPerZone
		end
		billboard(surface, zone.Name, sub, accent, 12, 0.85)
		map.Portals[zone.Id] = surface
	end
end

---------------------------------------------------------------------
-- TOWER
---------------------------------------------------------------------
local function buildTower(map)
	local tower = folder("Tower", root)
	local c = Vector3.new(160, 0, 0)
	local purple = Color3.fromRGB(90, 60, 140)
	disc(tower, c + Vector3.new(0, 1, 0), 40, 2, Color3.fromRGB(70, 65, 85), Enum.Material.Slate, "TowerBase")
	P(tower, { Name = "TowerBody", Shape = Enum.PartType.Cylinder, Size = Vector3.new(120, 26, 26), CFrame = CFrame.new(c + Vector3.new(0, 62, 0)) * FLAT, Color = purple, Material = Enum.Material.Brick })
	for h = 16, 112, 16 do
		disc(tower, c + Vector3.new(0, h, 0), 27.4, 0.8, Color3.fromRGB(200, 120, 255), Enum.Material.Neon, "TowerRing")
	end
	P(tower, { Name = "TowerCap", Shape = Enum.PartType.Ball, Size = Vector3.new(30, 16, 30), CFrame = CFrame.new(c + Vector3.new(0, 122, 0)), Color = Color3.fromRGB(60, 40, 100), Material = Enum.Material.Slate })
	local crystal = P(tower, { Name = "TowerCrystal", Size = Vector3.new(6, 12, 6), CFrame = CFrame.new(c + Vector3.new(0, 140, 0)) * CFrame.Angles(0, 0, math.rad(45)), Color = Color3.fromRGB(220, 150, 255), Material = Enum.Material.Neon, CanCollide = false })
	spin(crystal, 40, 2)
	light(crystal, Color3.fromRGB(210, 140, 255), 60, 3, true)
	emitter(crystal, "Stars", Color3.fromRGB(220, 160, 255), 5)
	local door = P(tower, { Name = "TowerDoor", Size = Vector3.new(1, 14, 9), CFrame = CFrame.new(c + Vector3.new(-13.2, 9, 0)), Color = Color3.fromRGB(200, 120, 255), Material = Enum.Material.Neon, Transparency = 0.2 })
	emitter(door, "Vortex", Color3.fromRGB(180, 110, 255), 2)
	billboard(door, "INFINITE TOWER", "Beat the Guardian before time runs out", Color3.fromRGB(220, 160, 255), 12, 1.1)
	local pp = prompt(door, "Enter Tower", "Infinite Tower", "TowerPrompt", "Tower")
	pp.HoldDuration = 0.4
	map.TowerPrompt = pp
	map.TowerCFrame = CFrame.new(c + Vector3.new(-22, 4, 0)) * CFrame.Angles(0, math.rad(90), 0)
end

---------------------------------------------------------------------
-- DUNGEONS (one linear hall per zone, stage rooms behind power gates)
---------------------------------------------------------------------
local ROOM_LEN = 100
local ROOM_W = 80
local START_LEN = 60
local WALL_H = 26
local DOOR_W = 24
local DOOR_H = 18

local ZONE_ORIGINS = {
	[1] = Vector3.new(0, 0, -1400),
	[2] = Vector3.new(700, 0, -1400),
}

local function decorateRoom(parent, zone, center: Vector3, rng: Random)
	if zone.Style == "Creature" then
		-- ruined academy: broken pillars, desks, vines, a cherry tree
		for _ = 1, 6 do
			local x = rng:NextNumber(-32, 32)
			local z = rng:NextNumber(-40, 40)
			if math.abs(x) > 10 then
				local h = rng:NextNumber(5, 16)
				P(parent, { Name = "RuinPillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 3.2, 3.2), CFrame = CFrame.new(center + Vector3.new(x, h / 2, z)) * FLAT, Color = zone.Wall, Material = Enum.Material.Marble })
			end
		end
		for _ = 1, 4 do
			local x = rng:NextNumber(-30, 30)
			local z = rng:NextNumber(-38, 38)
			P(parent, { Name = "Desk", Size = Vector3.new(4, 0.4, 2.4), CFrame = CFrame.new(center + Vector3.new(x, 2.4, z)) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood, CanCollide = false })
		end
		cherryTree(parent, center + Vector3.new(rng:NextNumber(-30, -24), 0, rng:NextNumber(-30, 30)), 1, rng)
		for _ = 1, 3 do
			local g = P(parent, { Name = "Crystal", Size = Vector3.new(1.4, 3.5, 1.4), CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-34, 34), 1.5, rng:NextNumber(-44, 44))) * CFrame.Angles(0.3, rng:NextNumber(0, 3), 0.4), Color = zone.Accent, Material = Enum.Material.Neon, CanCollide = false })
			light(g, zone.Accent, 12, 1)
		end
	else
		-- neon mecha docks: containers, floor strips, crane beams
		local colors = { Color3.fromRGB(220, 70, 60), Color3.fromRGB(60, 120, 220), Color3.fromRGB(230, 170, 50) }
		for _ = 1, 5 do
			local x = rng:NextNumber(-30, 30)
			local z = rng:NextNumber(-38, 38)
			if math.abs(x) > 12 then
				local crate = P(parent, { Name = "Container", Size = Vector3.new(8, 7, 16), CFrame = CFrame.new(center + Vector3.new(x, 3.5, z)) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), Color = colors[rng:NextInteger(1, 3)], Material = Enum.Material.CorrodedMetal })
				P(parent, { Name = "Stripe", Size = Vector3.new(8.1, 0.4, 16.1), CFrame = crate.CFrame * CFrame.new(0, 2, 0), Color = zone.Accent, Material = Enum.Material.Neon, CanCollide = false })
			end
		end
		for _, side in ipairs({ -1, 1 }) do
			P(parent, { Name = "FloorStrip", Size = Vector3.new(0.6, 0.2, ROOM_LEN - 4), CFrame = CFrame.new(center + Vector3.new(side * (ROOM_W / 2 - 4), 0.1, 0)), Color = side < 0 and zone.Accent or Color3.fromRGB(255, 60, 200), Material = Enum.Material.Neon, CanCollide = false })
		end
		local beam = P(parent, { Name = "CraneBeam", Size = Vector3.new(ROOM_W, 2, 2), CFrame = CFrame.new(center + Vector3.new(0, WALL_H + 2, rng:NextNumber(-20, 20))), Color = Color3.fromRGB(230, 170, 50), Material = Enum.Material.DiamondPlate })
		light(beam, zone.Accent, 30, 1.5, true)
	end
end

local function buildDungeon(map, zone)
	local origin = ZONE_ORIGINS[zone.Id]
	if not origin then
		return
	end
	local df = folder("Dungeon_" .. zone.Id, root)
	local stageCount = Config.StagesPerZone
	local firstStage = (zone.Id - 1) * stageCount + 1
	local totalLen = START_LEN + ROOM_LEN * stageCount
	local zCenter = origin.Z + START_LEN / 2 - totalLen / 2
	local rng = Random.new(zone.Id * 1000)

	P(df, { Name = "Floor", Size = Vector3.new(ROOM_W, 2, totalLen), CFrame = CFrame.new(origin.X, -1, zCenter), Color = zone.Floor, Material = zone.Style == "Creature" and Enum.Material.Grass or Enum.Material.DiamondPlate })
	for _, side in ipairs({ -1, 1 }) do
		P(df, { Name = "SideWall", Size = Vector3.new(4, WALL_H, totalLen), CFrame = CFrame.new(origin.X + side * (ROOM_W / 2 + 2), WALL_H / 2, zCenter), Color = zone.Wall, Material = zone.Style == "Creature" and Enum.Material.Brick or Enum.Material.Metal })
		P(df, { Name = "WallTrim", Size = Vector3.new(4.2, 0.8, totalLen), CFrame = CFrame.new(origin.X + side * (ROOM_W / 2 + 2), WALL_H, zCenter), Color = zone.Accent, Material = Enum.Material.Neon })
	end
	P(df, { Name = "BackWall", Size = Vector3.new(ROOM_W + 8, WALL_H, 4), CFrame = CFrame.new(origin.X, WALL_H / 2, origin.Z + START_LEN / 2 + 2), Color = zone.Wall, Material = Enum.Material.Slate })
	P(df, { Name = "EndWall", Size = Vector3.new(ROOM_W + 8, WALL_H, 4), CFrame = CFrame.new(origin.X, WALL_H / 2, origin.Z + START_LEN / 2 - totalLen - 2), Color = zone.Wall, Material = Enum.Material.Slate })

	-- start area: return portal + title
	local ret = P(df, { Name = "ReturnPortal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 12, 12), CFrame = CFrame.new(origin + Vector3.new(0, 7, START_LEN / 2 - 3)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 150, 210), Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false })
	emitter(ret, "Vortex", Color3.fromRGB(255, 150, 210), 2).Size = VFX.NS(0, 6, 1, 10)
	billboard(ret, "RETURN TO HUB", nil, Color3.fromRGB(255, 170, 220), 9, 0.7)
	CollectionService:AddTag(ret, "ReturnPortal")
	local titleHolder = P(df, { Name = "ZoneTitle", Size = Vector3.one, Transparency = 1, CanCollide = false, CFrame = CFrame.new(origin + Vector3.new(0, 16, 0)) })
	billboard(titleHolder, zone.Name, "Zone " .. zone.Id, zone.Accent, 0, 1.3)

	local dungeon = { Zone = zone, Origin = origin, StartCFrame = CFrame.new(origin + Vector3.new(0, 4, 18)), Stages = {} }

	for i = 1, stageCount do
		local stageIndex = firstStage + i - 1
		local stage = Config.Stages[stageIndex]
		local gateZ = origin.Z + START_LEN / 2 - START_LEN - (i - 1) * ROOM_LEN
		local center = Vector3.new(origin.X, 0, gateZ - ROOM_LEN / 2)

		-- cross wall with doorway
		local segW = (ROOM_W - DOOR_W) / 2
		for _, side in ipairs({ -1, 1 }) do
			P(df, { Name = "CrossWall", Size = Vector3.new(segW, WALL_H, 3), CFrame = CFrame.new(origin.X + side * (DOOR_W / 2 + segW / 2), WALL_H / 2, gateZ), Color = zone.Wall, Material = Enum.Material.Slate })
		end
		local lintel = P(df, { Name = "Lintel", Size = Vector3.new(DOOR_W, WALL_H - DOOR_H, 3), CFrame = CFrame.new(origin.X, DOOR_H + (WALL_H - DOOR_H) / 2, gateZ), Color = zone.Wall, Material = Enum.Material.Slate })
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local sg = Instance.new("SurfaceGui")
			sg.Face = face
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 30
			sg.LightInfluence = 0
			sg.Parent = lintel
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Enum.Font.LuckiestGuy
			t.TextScaled = true
			t.RichText = true
			t.Text = string.format('STAGE %d<br/><font size="30" color="#ffffff">%s</font>', stageIndex, stage.Boss and ("BOSS: " .. stage.Enemy) or stage.Enemy)
			t.TextColor3 = zone.Accent
			t.Parent = sg
		end

		local gate = P(df, { Name = "Gate_" .. stageIndex, Size = Vector3.new(DOOR_W, DOOR_H, 1.4), CFrame = CFrame.new(origin.X, DOOR_H / 2, gateZ), Color = stage.Boss and Color3.fromRGB(255, 60, 80) or zone.Accent, Material = Enum.Material.ForceField, Transparency = 0.1, CanCollide = true })
		gate:SetAttribute("Stage", stageIndex)
		gate:SetAttribute("PowerReq", stage.PowerReq)
		CollectionService:AddTag(gate, "StageGate")
		billboard(gate, stage.PowerReq > 0 and ("LOCKED - " .. Format.Abbrev(stage.PowerReq) .. " Power") or "OPEN", nil, Color3.fromRGB(255, 240, 200), 0, 0.8).Name = "GateLabel"

		-- room trigger volume (client uses it for stage banners / lighting)
		local room = P(df, { Name = "Room_" .. stageIndex, Size = Vector3.new(ROOM_W, WALL_H, ROOM_LEN), CFrame = CFrame.new(center + Vector3.new(0, WALL_H / 2, 0)), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
		room:SetAttribute("Stage", stageIndex)
		room:SetAttribute("Zone", zone.Id)
		CollectionService:AddTag(room, "StageRoom")

		decorateRoom(df, zone, center, rng)
		if stage.Boss then
			local arena = disc(df, center + Vector3.new(0, 0.1, 0), 50, 0.2, Color3.fromRGB(255, 60, 80), Enum.Material.Neon, "BossArena")
			arena.Transparency = 0.7
			arena.CanCollide = false
		end

		dungeon.Stages[stageIndex] = {
			Stage = stage,
			Center = center,
			SpawnMin = center + Vector3.new(-ROOM_W / 2 + 10, 0, -ROOM_LEN / 2 + 12),
			SpawnMax = center + Vector3.new(ROOM_W / 2 - 10, 0, ROOM_LEN / 2 - 12),
			Entry = CFrame.new(Vector3.new(origin.X, 4, gateZ - 8)) * CFrame.Angles(0, 0, 0),
			Gate = gate,
			Room = room,
		}
	end
	map.Dungeons[zone.Id] = dungeon
end

---------------------------------------------------------------------
-- WEAPON CHEST SHRINE (hub)
---------------------------------------------------------------------
buildChestShrine = function(map)
	local shrine = Instance.new("Model")
	shrine.Name = "ChestShrine"
	local c = Vector3.new(0, 0, 58)
	local gold = Color3.fromRGB(255, 200, 70)
	disc(shrine, c + Vector3.new(0, 0.6, 0), 16, 1.2, Color3.fromRGB(60, 45, 70), Enum.Material.Marble, "ShrineBase")
	disc(shrine, c + Vector3.new(0, 1.25, 0), 13, 0.15, gold, Enum.Material.Neon, "ShrineGlow").Transparency = 0.4
	local base = P(shrine, { Name = "ChestBase", Size = Vector3.new(7, 3.2, 4.5), CFrame = CFrame.new(c + Vector3.new(0, 2.9, 0)), Color = Color3.fromRGB(120, 60, 40), Material = Enum.Material.WoodPlanks })
	P(shrine, { Name = "ChestLid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 4.5, 4.5), CFrame = CFrame.new(c + Vector3.new(0, 4.5, 0)), Color = Color3.fromRGB(135, 70, 45), Material = Enum.Material.WoodPlanks })
	for _, x in ipairs({ -3.2, 0, 3.2 }) do
		P(shrine, { Name = "Band", Size = Vector3.new(0.4, 3.3, 4.6), CFrame = CFrame.new(c + Vector3.new(x, 2.9, 0)), Color = gold, Material = Enum.Material.Metal })
	end
	local lock = P(shrine, { Name = "Lock", Size = Vector3.new(1, 1.2, 0.4), CFrame = CFrame.new(c + Vector3.new(0, 3.6, -2.35)), Color = gold, Material = Enum.Material.Neon })
	local crack = P(shrine, { Name = "Crack", Size = Vector3.new(6.6, 0.15, 4.4), CFrame = CFrame.new(c + Vector3.new(0, 4.5, 0)), Color = gold, Material = Enum.Material.Neon })
	light(crack, gold, 22, 2.5, true)
	emitter(crack, "Stars", gold, 6, Vector3.new(0, 1, 0))
	for i, r in ipairs(Config.WeaponRarities) do
		local a = (i / #Config.WeaponRarities) * math.pi * 2
		local gem = P(shrine, { Name = "Gem_" .. r.Id, Size = Vector3.new(0.9, 1.6, 0.9), CFrame = CFrame.new(c + Vector3.new(math.cos(a) * 6, 8, math.sin(a) * 6)) * CFrame.Angles(0, a, math.rad(45)), Color = r.Color, Material = Enum.Material.Neon, CanCollide = false })
		spin(gem, 70, 0.5)
	end
	billboard(lock, "WEAPON CHESTS", "Keys, scrolls and gacha spins", gold, 7, 1)
	map.ChestPrompt = prompt(base, "Open Chests", "Weapon Shrine", "ChestPrompt", "Chests")
	shrine.Parent = root:FindFirstChild("Hub") or root
end

---------------------------------------------------------------------
-- AMBIENT PARTICLES (energy motes, cherry blossoms, dark aura trails)
---------------------------------------------------------------------
buildAmbient = function(map)
	local amb = folder("Ambient", root)
	local motes = ambientVolume(amb, CFrame.new(0, 10, -10), Vector3.new(180, 16, 180), "Rise", Color3.fromRGB(180, 220, 255), 14)
	motes.Speed = NumberRange.new(0.5, 1.5)
	motes.Lifetime = NumberRange.new(3, 5)
	motes.Size = VFX.NS(0, 0, 0.2, 0.25, 0.8, 0.25, 1, 0)
	local petals = ambientVolume(amb, CFrame.new(0, 45, 0), Vector3.new(220, 4, 220), "Petals", Color3.fromRGB(255, 170, 210), 20)
	petals.Lifetime = NumberRange.new(8, 12)
	petals.Acceleration = Vector3.new(1.5, -3, 0.8)
	petals.Size = VFX.NS(0, 0.35, 1, 0.25)
	for zoneId, dungeon in pairs(map.Dungeons) do
		local o = dungeon.Origin
		local len = 60 + 100 * Config.StagesPerZone
		local cf = CFrame.new(o.X, 3, o.Z + 30 - len / 2)
		if zoneId == 2 then
			local dark = ambientVolume(amb, cf, Vector3.new(76, 2, len), "Aura", Color3.fromRGB(110, 40, 180), 30)
			dark.Transparency = VFX.NS(0, 0.7, 0.5, 0.8, 1, 1)
			dark.Speed = NumberRange.new(1, 3)
			dark.Lifetime = NumberRange.new(1.5, 2.5)
			dark.LockedToPart = false
		else
			local flies = ambientVolume(amb, cf + Vector3.new(0, 5, 0), Vector3.new(76, 10, len), "Stars", Color3.fromRGB(170, 255, 140), 18)
			flies.Speed = NumberRange.new(0.2, 1)
			flies.Lifetime = NumberRange.new(2, 4)
			flies.Size = VFX.NS(0, 0, 0.5, 0.35, 1, 0)
		end
	end
end

---------------------------------------------------------------------
function MapBuilder.Build()
	local old = workspace:FindFirstChild("GeneratedMap")
	if old then
		old:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "GeneratedMap"
	root.Parent = workspace

	buildLighting()
	local map = { Root = root, Dungeons = {} }
	buildHub(map)
	buildTrain(map)
	buildPortals(map)
	buildTower(map)
	buildChestShrine(map)
	for _, zone in ipairs(Config.Zones) do
		if not zone.ComingSoon then
			buildDungeon(map, zone)
		end
	end
	buildAmbient(map)
	applyMaterialVariants(root)

	local arenas = folder("TowerArenas", workspace)
	map.TowerArenas = arenas
	local enemies = folder("Enemies", workspace)
	map.Enemies = enemies
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Monetization (ModuleScript) -> ServerScriptService/Server/Monetization
-- Gamepasses, developer products (ProcessReceipt) and code rewards.
-- Put your real IDs in Config.GamePasses / Config.Products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Net = require(script.Parent:WaitForChild("Net"))

local Monetization = {}
Monetization.OnPassesChanged = nil :: ((Player) -> ())?

local passKeyById = {}
for key, pass in pairs(Config.GamePasses) do
	if pass.Id and pass.Id ~= 0 then
		passKeyById[pass.Id] = key
	end
end
-- 2x power tiers: product id -> tier number n (price 3^n, multiplier 2^n)
local powerTierById = {}
for n, tier in ipairs(Config.PowerTiers) do
	if tier.Id and tier.Id ~= 0 then
		powerTierById[tier.Id] = n
	end
end

local productKeyById = {}
for key, prod in pairs(Config.Products) do
	if prod.Id and prod.Id ~= 0 then
		productKeyById[prod.Id] = key
	end
end

function Monetization.LoadPasses(player: Player)
	local s = DataService.Session(player)
	if not s then
		return
	end
	for key, pass in pairs(Config.GamePasses) do
		if Config.StudioOwnsAllPasses and RunService:IsStudio() then
			s.Passes[key] = true
		elseif pass.Id and pass.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				s.Passes[key] = true
			end
		end
	end
end

-- Coins / Rerolls / Overdrive grant used by products and codes.
function Monetization.Grant(player: Player, grants): string
	local data = DataService.Get(player)
	if not data then
		return ""
	end
	local parts = {}
	if grants.Coins then
		local amount = grants.Coins
		if grants.ScaleWithRebirth then
			amount *= 1 + data.Rebirths
		end
		data.Coins += amount
		table.insert(parts, Format.Abbrev(amount) .. " Coins")
	end
	if grants.Rerolls then
		data.Rerolls += grants.Rerolls
		table.insert(parts, grants.Rerolls .. " Rerolls")
	end
	if grants.Overdrive then
		data.Overdrive += grants.Overdrive
		table.insert(parts, grants.Overdrive .. " Overdrive")
	end
	DataService.MarkDirty(player)
	return table.concat(parts, " + ")
end

function Monetization.PromptPass(player: Player, key: string)
	local pass = Config.GamePasses[key]
	if not pass then
		return
	end
	if not pass.Id or pass.Id == 0 then
		Net.Notify(player, pass.Name .. " isn't set up yet (add its ID in Config).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

function Monetization.PromptProduct(player: Player, key: string)
	local prod = Config.Products[key]
	local data = DataService.Get(player)
	if not prod or not data then
		return
	end
	if prod.OneTime and data.StarterPack then
		Net.Notify(player, "You already bought the Starter Pack!", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	if not prod.Id or prod.Id == 0 then
		Net.Notify(player, prod.Name .. " isn't set up yet (add its ID in Config).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptProductPurchase(player, prod.Id)
end

-- Prompts the NEXT power tier only (n = PowerTier + 1).
function Monetization.PromptPowerTier(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local n = data.PowerTier + 1
	local tier = Config.PowerTiers[n]
	if not tier then
		Net.Notify(player, "You own every Power tier!", Color3.fromRGB(255, 215, 80), "Error")
		return
	end
	if not tier.Id or tier.Id == 0 then
		Net.Notify(player, "Power tier " .. n .. " isn't set up yet (add its product ID in Config.PowerTiers).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptProductPurchase(player, tier.Id)
end

local function grantPowerTier(player: Player, data, n: number): string
	local expected = data.PowerTier + 1
	if n >= expected then
		-- normal case (n == expected). If a higher tier was bought (paid more),
		-- jump straight to it so no Robux is ever wasted.
		data.PowerTier = n
		Net.FX(player, "PowerTier", { Tier = n, Mult = Config.PowerTierMult(n) })
		return "Power x" .. Format.Abbrev(Config.PowerTierMult(n))
	end
	-- stale purchase of a tier the player already owns: compensate with coins
	local coins = 1000 * Config.PowerTierPrice(n) * (1 + data.Rebirths)
	data.Coins += coins
	Net.Notify(player, "You already had Power tier " .. n .. " - converted to " .. Format.Abbrev(coins) .. " Coins.", Color3.fromRGB(255, 215, 80), "Purchase")
	return Format.Abbrev(coins) .. " Coins"
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local key = passKeyById[passId]
	local s = DataService.Session(player)
	if key and s then
		s.Passes[key] = true
		Net.FX(player, "Purchase", { Name = Config.GamePasses[key].Name })
		DataService.MarkDirty(player)
		if Monetization.OnPassesChanged then
			Monetization.OnPassesChanged(player)
		end
	end
end)

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.Get(player)
	if not player or not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- dedupe (receipts can be delivered more than once)
	for _, id in ipairs(data.Receipts) do
		if id == receipt.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	-- 2x power tier purchase
	local tierN = powerTierById[receipt.ProductId]
	if tierN then
		local text = grantPowerTier(player, data, tierN)
		table.insert(data.Receipts, receipt.PurchaseId)
		while #data.Receipts > 50 do
			table.remove(data.Receipts, 1)
		end
		DataService.MarkDirty(player)
		DataService.Save(player)
		Net.FX(player, "Purchase", { Name = "Power Tier " .. tierN, Text = text })
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = productKeyById[receipt.ProductId]
	local prod = key and Config.Products[key]
	if not prod then
		warn("[Monetization] unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local text = Monetization.Grant(player, prod)
	if prod.OneTime then
		data.StarterPack = true
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	DataService.Save(player)
	Net.FX(player, "Purchase", { Name = prod.Name, Text = text })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Net (ModuleScript) -> ServerScriptService/Server/Net
-- Creates the RemoteEvents in ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if folder then
	folder:Destroy()
end
folder = Instance.new("Folder")
folder.Name = "Remotes"

local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = folder
	return r
end

Net.Ability = remote("Ability") -- client -> server: (action, payload) combat input
Net.Interact = remote("Interact") -- client -> server: custom ProximityPrompt triggered
Net.Request = remote("Request") -- client -> server: (action, arg)
Net.Sync = remote("Sync") -- server -> client: data snapshot
Net.FXEvent = remote("FX") -- server -> client: (kind, payload)
folder.Parent = ReplicatedStorage

function Net.FX(player: Player, kind: string, payload)
	Net.FXEvent:FireClient(player, kind, payload or {})
end

function Net.FXAll(kind: string, payload)
	Net.FXEvent:FireAllClients(kind, payload or {})
end

function Net.Notify(player: Player, text: string, color: Color3?, sound: string?)
	Net.FXEvent:FireClient(player, "Notify", { Text = text, Color = color, Sound = sound })
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Playtime</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Playtime (ModuleScript) -> ServerScriptService/Server/Playtime
-- Session time tracker (server, 1s loop), play-time reward ladder, total
-- playtime and the daily login streak (all saved in the DataStore profile).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))

local Playtime = {}
Playtime.OnCosmeticsChanged = nil :: ((Player) -> ())?

local function grant(player: Player, reward)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if reward.Coins then
		data.Coins += reward.Coins
	end
	if reward.Potions then
		data.Potions += reward.Potions
	end
	if reward.Keys then
		for key, n in pairs(reward.Keys) do
			data.Keys[key] = (data.Keys[key] or 0) + n
		end
	end
	if reward.DamageBoost then
		local now = Stats.Now()
		data.BoostEnds = math.max(data.BoostEnds, now) + reward.DamageBoost
	end
	if reward.Aura == "Playtime" and not data.Cosmetics.PlaytimeAura then
		data.Cosmetics.PlaytimeAura = true
		if Playtime.OnCosmeticsChanged then
			Playtime.OnCosmeticsChanged(player)
		end
	end
	DataService.MarkDirty(player)
end
Playtime.Grant = grant

-- Called once after the profile loads.
function Playtime.OnJoin(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return
	end
	s.SessionTime = 0
	s.PlaytimeClaimed = {}
	for i = 1, #Config.PlaytimeRewards do
		s.PlaytimeClaimed[i] = false
	end
	player:SetAttribute("SessionTime", 0)

	-- daily streak (UTC days)
	local today = math.floor(os.time() / 86400)
	if data.LastLoginDay ~= today then
		if data.LastLoginDay == today - 1 then
			data.Streak += 1
		else
			data.Streak = 1
		end
		data.LastLoginDay = today
		local days = math.min(data.Streak, Config.Daily.MaxScaleDays)
		local coins = Config.Daily.BaseCoins * days * (1 + data.Rebirths)
		data.Coins += coins
		local text = Format.Abbrev(coins) .. " Coins"
		if data.Streak % 7 == 0 then
			data.Keys[Config.Daily.WeeklyKey] = (data.Keys[Config.Daily.WeeklyKey] or 0) + 1
			text ..= " + " .. Config.KeyNames[Config.Daily.WeeklyKey]
		end
		DataService.MarkDirty(player)
		task.delay(6, function()
			if player.Parent then
				local bonus = math.min(data.Streak * Config.Daily.CoinBonusPerDay, Config.Daily.MaxCoinBonus)
				Net.FX(player, "Daily", { Streak = data.Streak, Text = text, Bonus = bonus })
			end
		end)
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			local s = DataService.Session(player)
			if data and s and s.PlaytimeClaimed then
				s.SessionTime += 1
				data.TotalPlaytime += 1
				player:SetAttribute("SessionTime", s.SessionTime)
				for i, reward in ipairs(Config.PlaytimeRewards) do
					if not s.PlaytimeClaimed[i] and s.SessionTime >= reward.Minutes * 60 then
						s.PlaytimeClaimed[i] = true
						grant(player, reward)
						Net.FX(player, "PlaytimeReward", { Index = i, Name = reward.Name, Minutes = reward.Minutes })
					end
				end
			end
		end
	end
end)

return Playtime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Projectiles (ModuleScript) -> ServerScriptService/Server/Projectiles
-- Server-authoritative projectiles: stepped every Heartbeat, raycast against
-- map geometry, swept-sphere hit tests against enemies. Clients only draw
-- them (FX "Proj" / "ProjEnd").

local RunService = game:GetService("RunService")

local Net = require(script.Parent:WaitForChild("Net"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))

local Projectiles = {}

local active = {}
local nextId = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.RespectCanCollide = true

function Projectiles.SetWorld(blockers: { Instance })
	rayParams.FilterDescendantsInstances = blockers
end

--[[ opts:
	Owner: Player, Origin: Vector3, Dir: Vector3, Speed, Range, Radius,
	Pierce: boolean | number (extra enemies), Kind: string, Color: Color3,
	Size: number?, Explode: number? (radius), OnHit: (enemy, pos) -> ()
	OnExplode: (pos, radius) -> ()
]]
function Projectiles.Fire(opts)
	nextId += 1
	local p = {
		Id = nextId,
		Owner = opts.Owner,
		Pos = opts.Origin,
		Dir = opts.Dir.Unit,
		Speed = opts.Speed,
		Range = opts.Range,
		Radius = opts.Radius or 2,
		Pierce = opts.Pierce,
		Traveled = 0,
		Hit = {},
		Hits = 0,
		OnHit = opts.OnHit,
		OnExplode = opts.OnExplode,
		Explode = opts.Explode,
	}
	active[p.Id] = p
	Net.FXAll("Proj", { Id = p.Id, Kind = opts.Kind or "Ray", Pos = p.Pos, Dir = p.Dir, Speed = p.Speed, Range = p.Range, Color = opts.Color, Size = opts.Size })
	return p.Id
end

local function finish(p, pos: Vector3, hit: boolean)
	active[p.Id] = nil
	if p.Explode and p.OnExplode then
		p.OnExplode(pos, p.Explode)
	end
	Net.FXAll("ProjEnd", { Id = p.Id, Pos = pos, Hit = hit, Explode = p.Explode })
end

local function maxHits(p): number
	if p.Pierce == true then
		return math.huge
	elseif type(p.Pierce) == "number" then
		return 1 + p.Pierce
	end
	return 1
end

RunService.Heartbeat:Connect(function(dt)
	for _, p in pairs(active) do
		local step = math.min(p.Speed * dt, p.Range - p.Traveled)
		local from = p.Pos
		local to = from + p.Dir * step
		local wall = workspace:Raycast(from, p.Dir * step, rayParams)
		if wall then
			to = wall.Position
		end
		local done = false
		for _, e in ipairs(EnemyService.InSegment(from, to, p.Radius)) do
			if not p.Hit[e] then
				p.Hit[e] = true
				p.Hits += 1
				if p.OnHit then
					local ok, err = pcall(p.OnHit, e, e.Root.Position)
					if not ok then
						warn("[Projectile]", err)
					end
				end
				if p.Hits >= maxHits(p) then
					finish(p, e.Root.Position, true)
					done = true
					break
				end
			end
		end
		if not done then
			p.Pos = to
			p.Traveled += step
			if wall then
				finish(p, to, true)
			elseif p.Traveled >= p.Range - 0.01 then
				finish(p, to, false)
			end
		end
	end
end)

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Stats (ModuleScript) -> ServerScriptService/Server/Stats
-- All formulas: damage, power gain, luck, coins, backpack, race rolls.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameShared"):WaitForChild("Config"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local Stats = {}

local function now()
	return workspace:GetServerTimeNow()
end
Stats.Now = now

function Stats.HasPass(player: Player, key: string): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.Passes[key] == true
end

function Stats.Race(data)
	return Config.RaceById[data.Race] or Config.RaceById.Pirate
end

function Stats.Tier(data)
	return Config.RaceTierById[data.RaceTier] or Config.RaceTiers[1]
end

local function allStats(data): number
	local race = Stats.Race(data)
	return race.AllStats or 1
end

function Stats.OverdriveActive(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.OverdriveEnd > now()
end

function Stats.ZenkaiActive(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.ZenkaiEnd > now()
end

---------------------------------------------------------------------
-- WEAPON
---------------------------------------------------------------------
-- Returns weaponDef, rarityDef, record (or starter defaults).
function Stats.Weapon(player: Player)
	local data = DataService.Get(player)
	local rec = data and data.Weapons[data.Equipped]
	local def = rec and Config.WeaponById[rec.W] or Config.WeaponById[Config.StarterWeapon]
	local rarity = rec and Config.WeaponRarityById[rec.R] or Config.WeaponRarities[1]
	return def, rarity, rec
end

function Stats.HasPassive(player: Player, passiveId: string): boolean
	local def, rarity = Stats.Weapon(player)
	return rarity.Passive == true and def.Passive ~= nil and def.Passive.Id == passiveId
end

function Stats.AttackSpeed(player: Player): number
	local _, rarity = Stats.Weapon(player)
	local bonus = rarity.AttackSpeed or 0
	if Stats.HasPassive(player, "Released") then
		bonus += 0.15
	end
	if Stats.OverdriveActive(player) then
		bonus += 0.1
	end
	return math.min(bonus, Config.Balance.AttackSpeedCap)
end

function Stats.BoostActive(player: Player): boolean
	local data = DataService.Get(player)
	return data ~= nil and data.BoostEnds > now()
end

function Stats.PowerTierMult(player: Player): number
	local data = DataService.Get(player)
	return Config.PowerTierMult(data and data.PowerTier or 0)
end

---------------------------------------------------------------------
-- DAMAGE
---------------------------------------------------------------------
-- Gameplay multipliers (race, skin, rebirth, runes, buffs) are multiplied
-- together and HARD CAPPED at Config.Balance.DamageMultCap.
function Stats.GameplayMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local mult = (race.Damage or 1) * Stats.Tier(data).Damage
	mult *= 1 + data.Rebirths * Config.RebirthDamageBonus
	mult *= 1 + data.Runes * Config.Tower.RuneDamageBonus
	if Stats.OverdriveActive(player) then
		mult *= Config.Overdrive.Damage
	end
	if Stats.BoostActive(player) then
		mult *= 2
	end
	if race.Zenkai then
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			local missing = 1 - math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			mult *= 1 + missing
		end
		if Stats.ZenkaiActive(player) then
			mult *= 2
		end
	end
	return math.min(mult, Config.Balance.DamageMultCap)
end

-- Base hit damage for the equipped weapon (skill coefficients multiply this).
function Stats.Damage(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local def, rarity = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local base = (Config.BaseDamage + data.Blade) * (1 + data.Power / Config.PowerDamageDivisor)
	base *= (class and class.Base or 1) * (1 + rarity.Damage)
	return base * Stats.GameplayMult(player) * Stats.PowerTierMult(player)
end

function Stats.CritChance(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local race = Stats.Race(data)
	return math.min(0.5, (Config.BaseCritChance + (race.Crit or 0)) * allStats(data))
end

function Stats.CritMult(): number
	return math.min(Config.CritMultiplier, Config.Balance.CritMultCap)
end

function Stats.StaminaCost(player: Player, base: number): number
	local cost = base * Config.Balance.StaminaCostMult
	if Stats.HasPassive(player, "ChakraFlow") then
		cost *= 0.8
	end
	return cost
end

function Stats.Cooldown(player: Player, skillId: string, base: number): number
	local cd = base * Config.Balance.CooldownMult
	if skillId == "GetsugaTensho" and Stats.HasPassive(player, "Released") then
		cd *= 0.8
	end
	return cd
end

---------------------------------------------------------------------
-- POWER / LUCK / COINS / BACKPACK / FORGE / SPEED
---------------------------------------------------------------------
function Stats.PowerMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local per = Stats.HasPass(player, "DoubleTraining") and 0.2 or 0.1
	local mult = (1 + data.Rebirths * Config.RebirthPowerBonus) * (1 + data.Upgrades.Training * per)
	mult *= (race.Power or 1) * allStats(data)
	if Stats.OverdriveActive(player) then
		mult *= Config.Overdrive.Power
	end
	return mult
end

function Stats.Luck(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local luck = (1 + data.Upgrades.Luck * 0.05) * (race.Luck or 1) * allStats(data)
	if Stats.HasPass(player, "DoubleLuck") then
		luck *= 2
	end
	return luck
end

function Stats.CoinMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local mult = (1 + data.Rebirths * Config.RebirthCoinBonus) * (race.Coins or 1) * allStats(data)
	if Stats.HasPass(player, "DoubleCoins") then
		mult *= 2
	end
	mult *= 1 + math.min(data.Streak * Config.Daily.CoinBonusPerDay, Config.Daily.MaxCoinBonus)
	-- Pirate crew aura: +10% if another Pirate is nearby
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local od = DataService.Get(other)
				local oc = other.Character
				local orr = oc and oc:FindFirstChild("HumanoidRootPart")
				if od and od.Race == "Pirate" and orr and (orr.Position - root.Position).Magnitude < 30 then
					mult *= 1.1
					break
				end
			end
		end
	end
	return mult
end

function Stats.BackpackMax(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return Config.BaseBackpack
	end
	local cap = Config.BaseBackpack + data.Upgrades.Backpack * 10
	if Stats.HasPass(player, "ExtraBackpack") then
		cap = math.floor(cap * 1.5)
	end
	return cap
end

function Stats.BackpackCount(data): number
	local n = 0
	for _, c in pairs(data.Backpack) do
		n += c
	end
	return n
end

function Stats.ForgeMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	return (race.Forge or 1) * allStats(data)
end

function Stats.WalkSpeed(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 16
	end
	local race = Stats.Race(data)
	local speed = 16 * (race.Speed or 1) * math.min(allStats(data), 1.1)
	if Stats.OverdriveActive(player) then
		speed *= Config.Overdrive.Speed
	end
	return speed
end

function Stats.OverdriveDuration(player: Player): number
	local data = DataService.Get(player)
	local d = Config.Overdrive.Duration
	if data then
		d *= Stats.Race(data).OverdriveDuration or 1
	end
	if Stats.HasPass(player, "DoubleOverdrive") then
		d *= 2
	end
	return d
end

function Stats.RebirthReq(data): number
	return math.floor(Config.RebirthBasePower * Config.RebirthPowerGrowth ^ data.Rebirths)
end

function Stats.UpgradeCost(key: string, level: number): number?
	local u = Config.Upgrades[key]
	if not u or level >= u.Max then
		return nil
	end
	return math.floor(u.Base * u.Growth ^ level)
end

function Stats.PadUnlocked(data, pad): boolean
	return data.Power >= pad.Power and data.Rebirths >= pad.Rebirths
end

function Stats.StageUnlocked(data, stageIndex: number): boolean
	local stage = Config.Stages[stageIndex]
	if not stage then
		return false
	end
	local zone = Config.Zones[stage.Zone]
	return data.Power >= stage.PowerReq and data.Blade >= (zone.BladeReq or 0)
end

---------------------------------------------------------------------
-- RACE ROLL (weighted; luck only nudges the Main Character tail)
---------------------------------------------------------------------
local function weightedPick(list, weightFn)
	local total = 0
	for _, item in ipairs(list) do
		total += weightFn(item)
	end
	local r = math.random() * total
	for _, item in ipairs(list) do
		r -= weightFn(item)
		if r <= 0 then
			return item
		end
	end
	return list[#list]
end
Stats.WeightedPick = weightedPick

function Stats.RollRace(player: Player)
	local data = DataService.Get(player)
	local mcBoost = 1
	if Stats.HasPass(player, "DoubleLuck") then
		mcBoost *= 1.5
	end
	if Stats.HasPass(player, "MCPity") then
		mcBoost *= 1.5
	end
	if data then
		mcBoost *= 1 + math.min(data.Upgrades.Luck * 0.01, 0.5)
	end
	local race = weightedPick(Config.Races, function(r)
		return if r.Id == "MainCharacter" then r.Weight * mcBoost else r.Weight
	end)
	local tier = weightedPick(Config.RaceTiers, function(t)
		return t.Weight
	end)
	return race.Id, tier.Id
end

---------------------------------------------------------------------
-- SNAPSHOT sent to the client
---------------------------------------------------------------------
function Stats.Snapshot(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return nil
	end
	local costs = {}
	for key in pairs(Config.Upgrades) do
		costs[key] = Stats.UpgradeCost(key, data.Upgrades[key]) or -1
	end
	local tower = s.Tower
	return {
		Power = data.Power,
		Coins = data.Coins,
		Blade = data.Blade,
		Rebirths = data.Rebirths,
		Runes = data.Runes,
		Backpack = data.Backpack,
		BackpackCount = Stats.BackpackCount(data),
		BackpackMax = Stats.BackpackMax(player),
		Upgrades = data.Upgrades,
		UpgradeCosts = costs,
		Race = data.Race,
		RaceTier = data.RaceTier,
		Rerolls = data.Rerolls,
		Overdrive = data.Overdrive,
		OverdriveEnd = s.OverdriveEnd,
		ZenkaiEnd = s.ZenkaiEnd,
		Index = data.Index,
		Kills = data.Kills,
		TowerBest = data.TowerBest,
		Codes = data.Codes,
		StarterPack = data.StarterPack,
		Passes = s.Passes,
		Settings = data.Settings,
		RebirthReq = Stats.RebirthReq(data),
		Tower = tower and { Floor = tower.Floor, EndsAt = tower.EndsAt, Active = tower.Active } or nil,
		Weapons = data.Weapons,
		Equipped = data.Equipped,
		Keys = data.Keys,
		Potions = data.Potions,
		BoostEnds = data.BoostEnds,
		PowerTier = data.PowerTier,
		Streak = data.Streak,
		TotalPlaytime = data.TotalPlaytime,
		Cosmetics = data.Cosmetics,
		PlaytimeClaimed = s.PlaytimeClaimed,
		Derived = {
			PowerMult = Stats.PowerTierMult(player),
			GameplayMult = Stats.GameplayMult(player),
			AttackSpeed = Stats.AttackSpeed(player),
			Damage = Stats.Damage(player),
			PowerPerSwing = Config.ClickPower * Stats.PowerMult(player),
			Luck = Stats.Luck(player),
			CoinMult = Stats.CoinMult(player),
			Crit = Stats.CritChance(player),
			ForgeMult = Stats.ForgeMult(player),
		},
	}
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">TowerService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- TowerService (ModuleScript) -> ServerScriptService/Server/TowerService
-- Infinite Tower: a private arena per player. Beat the floor Guardian
-- before the timer runs out to earn Coins, Runes (+2% dmg each) and ore.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local Util = require(script.Parent:WaitForChild("Util"))

local TowerService = {}

local map = nil
local usedSlots = {}
local ARENA_R = 34

local function allocSlot(): number
	local i = 1
	while usedSlots[i] do
		i += 1
	end
	usedSlots[i] = true
	return i
end

local function buildArena(slot: number)
	local center = Vector3.new(3000 + slot * 300, 300, 0)
	local m = Instance.new("Model")
	m.Name = "Arena_" .. slot
	local function P(props)
		local p = Instance.new("Part")
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		for k, v in pairs(props) do
			(p :: any)[k] = v
		end
		p.Parent = m
		return p
	end
	local flat = CFrame.Angles(0, 0, math.rad(90))
	P({ Name = "Floor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, ARENA_R * 2 + 6, ARENA_R * 2 + 6), CFrame = CFrame.new(center - Vector3.new(0, 1, 0)) * flat, Color = Color3.fromRGB(45, 35, 70), Material = Enum.Material.Slate })
	P({ Name = "Glyph", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, ARENA_R * 1.4, ARENA_R * 1.4), CFrame = CFrame.new(center + Vector3.new(0, 0.05, 0)) * flat, Color = Color3.fromRGB(190, 110, 255), Material = Enum.Material.Neon, Transparency = 0.75, CanCollide = false })
	P({ Name = "Edge", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, ARENA_R * 2 + 6.4, ARENA_R * 2 + 6.4), CFrame = CFrame.new(center - Vector3.new(0, 0.3, 0)) * flat, Color = Color3.fromRGB(210, 130, 255), Material = Enum.Material.Neon })
	for i = 1, 10 do
		local a = (i / 10) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * (ARENA_R + 1), 0, math.sin(a) * (ARENA_R + 1))
		P({ Name = "Pillar", Size = Vector3.new(3, 22, 3), CFrame = CFrame.new(pos + Vector3.new(0, 11, 0)), Color = Color3.fromRGB(70, 55, 100), Material = Enum.Material.Marble })
		local c = P({ Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(pos + Vector3.new(0, 23, 0)), Color = Color3.fromRGB(200, 120, 255), Material = Enum.Material.Neon, CanCollide = false })
		VFX.MakeEmitter("Fire", Color3.fromRGB(190, 110, 255), c, 12)
	end
	-- invisible wall so nobody falls off
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * (ARENA_R + 3), 10, math.sin(a) * (ARENA_R + 3))
		P({ Name = "Barrier", Size = Vector3.new(15, 24, 1), CFrame = CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)), Transparency = 1 })
	end
	m.Parent = map.TowerArenas
	return m, center
end

local function oreTable(floor: number)
	if floor < 5 then
		return Config.Stages[3].Drops
	elseif floor < 10 then
		return Config.Stages[4].Drops
	elseif floor < 20 then
		return Config.Stages[7].Drops
	end
	return Config.Stages[9].Drops
end

local function floorColor(floor: number): Color3
	return Color3.fromHSV((floor * 0.13) % 1, 0.7, 1)
end

local function cleanup(player: Player, run)
	if run.Guardian and not run.Guardian.Dead then
		run.Guardian.Dead = true
		local idx = table.find(EnemyService.Active, run.Guardian)
		if idx then
			table.remove(EnemyService.Active, idx)
		end
		run.Guardian.Model:Destroy()
	end
	if run.Arena then
		run.Arena:Destroy()
	end
	usedSlots[run.Slot] = nil
	local s = DataService.Session(player)
	if s and s.Tower == run then
		s.Tower = nil
		DataService.MarkDirty(player)
	end
end

local function finish(player: Player, run, state: string)
	if not run.Active then
		return
	end
	run.Active = false
	Net.FX(player, "Tower", { State = state, Floor = run.Floor })
	task.delay(state == "Leave" and 0.2 or 2.2, function()
		if player.Parent and player.Character and map then
			Util.Teleport(player, map.TowerCFrame, "Tower")
		end
		cleanup(player, run)
	end)
end

local startFloor

local function onWin(player: Player, run)
	local data = DataService.Get(player)
	if not data or not run.Active then
		return
	end
	local floor = run.Floor
	local coins = math.floor(Config.Tower.CoinBase * floor ^ 1.6 * Stats.CoinMult(player))
	data.Coins += coins
	data.Runes += Config.Tower.RunesPerFloor
	data.TowerBest = math.max(data.TowerBest, floor)
	local drops = oreTable(floor)
	local luck = Stats.Luck(player)
	for i = 1, 2 + math.floor(floor / 5) do
		local oreId = (floor % 25 == 0 and i == 1) and "RiftCore" or Loot.RollOre(drops, luck)
		local a = math.random() * math.pi * 2
		Loot.Drop(player, oreId, run.Center + Vector3.new(math.cos(a) * 6, 1.2, math.sin(a) * 6))
	end
	EnemyService.WeaponDrop(player, Config.WeaponDropChance.Tower)
	DataService.MarkDirty(player)
	Net.FX(player, "Tower", { State = "Win", Floor = floor, Coins = coins, Runes = Config.Tower.RunesPerFloor, Text = "+" .. Format.Abbrev(coins) .. " Coins  +" .. Config.Tower.RunesPerFloor .. " Rune" })
	run.Paused = true
	task.delay(4, function()
		if run.Active and player.Parent then
			run.Floor += 1
			startFloor(player, run)
		end
	end)
end

startFloor = function(player: Player, run)
	local floor = run.Floor
	local hp = Config.Tower.BaseHP * Config.Tower.HPGrowth ^ (floor - 1)
	local color = floorColor(floor)
	run.Paused = true
	Net.FX(player, "Tower", { State = "Floor", Floor = floor, Color = color })
	task.delay(1.5, function()
		if not run.Active or not player.Parent then
			return
		end
		run.Guardian = EnemyService.Create({
			Label = "FLOOR " .. floor .. " GUARDIAN",
			LookIndex = ((floor - 1) % #Config.EnemyLooks) + 1,
			Color = color,
			Scale = 2,
			HP = hp,
			Boss = true,
			Owner = player,
			Position = run.Center + Vector3.new(0, 0, -14),
			Min = run.Center - Vector3.new(ARENA_R - 4, 0, ARENA_R - 4),
			Max = run.Center + Vector3.new(ARENA_R - 4, 0, ARENA_R - 4),
			Speed = 12 + math.min(floor, 20) * 0.3,
			HitPercent = 0.08,
			OnDeath = function()
				onWin(player, run)
			end,
		})
		run.EndsAt = Stats.Now() + Config.Tower.TimeLimit
		run.Paused = false
		DataService.MarkDirty(player)
		Net.FX(player, "Tower", { State = "Start", Floor = floor, EndsAt = run.EndsAt, Color = color })
	end)
end

function TowerService.Start(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not s or not hum or hum.Health <= 0 then
		return
	end
	if s.Tower then
		return
	end
	if data.Power < Config.Tower.PowerReq then
		Net.Notify(player, "The Tower needs " .. Format.Abbrev(Config.Tower.PowerReq) .. " Power. Train first!", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	local slot = allocSlot()
	local arena, center = buildArena(slot)
	local run = {
		Slot = slot,
		Arena = arena,
		Center = center,
		Floor = math.max(1, data.TowerBest - 2),
		Active = true,
		Paused = true,
		EndsAt = 0,
	}
	s.Tower = run
	Util.Teleport(player, CFrame.new(center + Vector3.new(0, 4, 20)), "Tower")
	startFloor(player, run)

	task.spawn(function()
		while run.Active do
			task.wait(0.25)
			if not player.Parent then
				run.Active = false
				cleanup(player, run)
				return
			end
			local c = player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if not h or h.Health <= 0 then
				finish(player, run, "Lose")
			elseif not run.Paused and Stats.Now() > run.EndsAt then
				finish(player, run, "Lose")
			end
		end
	end)
end

function TowerService.Leave(player: Player)
	local s = DataService.Session(player)
	if s and s.Tower then
		finish(player, s.Tower, "Leave")
	end
end

function TowerService.InTower(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.Tower ~= nil
end

function TowerService.PlayerRemoving(player: Player)
	local s = DataService.Session(player)
	if s and s.Tower then
		s.Tower.Active = false
		cleanup(player, s.Tower)
	end
end

function TowerService.Init(m)
	map = m
end

return TowerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Util (ModuleScript) -> ServerScriptService/Server/Util

local Net = require(script.Parent:WaitForChild("Net"))

local Util = {}

-- Streaming-safe teleport with a client flash + sound.
function Util.Teleport(player: Player, cf: CFrame, label: string?)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not root then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 3)
	end)
	if not char.Parent or not root.Parent then
		return
	end
	char:PivotTo(cf)
	root.AssemblyLinearVelocity = Vector3.zero
	Net.FX(player, "Teleported", { Where = label })
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Weapons (ModuleScript) -> ServerScriptService/Server/Weapons
-- Weapon inventory, weighted rarity rolls (Random.new), equip + welding the
-- weapon model to the character's hands.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Net = require(script.Parent:WaitForChild("Net"))

local Weapons = {}
local rng = Random.new()

local function count(t): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

-- Weighted rarity roll. minRarity filters out lower tiers (chests / keys);
-- luck (>= 1) shifts weight toward rarer tiers.
function Weapons.RollRarity(minRarity: string?, luck: number?): string
	local minIndex = minRarity and Config.WeaponRarityById[minRarity].Index or 1
	luck = math.max(1, luck or 1)
	local total = 0
	local weights = {}
	for _, r in ipairs(Config.WeaponRarities) do
		if r.Index >= minIndex then
			local w = r.Chance * luck ^ ((r.Index - 1) * 0.35)
			weights[r.Id] = w
			total += w
		end
	end
	local roll = rng:NextNumber() * total
	for _, r in ipairs(Config.WeaponRarities) do
		local w = weights[r.Id]
		if w then
			roll -= w
			if roll <= 0 then
				return r.Id
			end
		end
	end
	return Config.WeaponRarities[#Config.WeaponRarities].Id
end

function Weapons.Roll(minRarity: string?, luck: number?): (string, string)
	local rarity = Weapons.RollRarity(minRarity, luck)
	local pool = Config.WeaponsByRarity[rarity]
	if not pool or #pool == 0 then
		return Config.StarterWeapon, "Common"
	end
	local w = pool[rng:NextInteger(1, #pool)]
	return w.Id, rarity
end

-- Adds a weapon. If the inventory is full it is scrapped for coins.
function Weapons.Add(player: Player, weaponId: string, rarityId: string): string?
	local data = DataService.Get(player)
	if not data or not Config.WeaponById[weaponId] then
		return nil
	end
	if count(data.Weapons) >= Config.MaxWeapons then
		local scrap = Config.WeaponRarityById[rarityId].Scrap
		data.Coins += scrap
		Net.Notify(player, "Weapon inventory full - auto-scrapped for " .. scrap .. " Coins.", Color3.fromRGB(255, 170, 90), "Error")
		DataService.MarkDirty(player)
		return nil
	end
	local uid = "w" .. data.NextWeaponId
	data.NextWeaponId += 1
	data.Weapons[uid] = { W = weaponId, R = rarityId }
	DataService.MarkDirty(player)
	return uid
end

function Weapons.EnsureStarter(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if next(data.Weapons) == nil then
		data.Equipped = Weapons.Add(player, Config.StarterWeapon, "Common") or ""
	end
	if not data.Weapons[data.Equipped] then
		data.Equipped = next(data.Weapons) or ""
	end
end

-- Rebuilds the weapon on the character and publishes attributes the client
-- uses to bind abilities.
function Weapons.Refresh(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not char or not hum or hum.Health <= 0 then
		return
	end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Model") and c.Name:sub(1, 15) == "EquippedWeapon_" then
			c:Destroy()
		end
	end
	local rec = data.Weapons[data.Equipped]
	local def = rec and Config.WeaponById[rec.W] or Config.WeaponById[Config.StarterWeapon]
	local rarityId = rec and rec.R or "Common"
	local built = WeaponModels.Build(def.Id, rarityId, data.Blade)
	WeaponModels.AttachToCharacter(char, built)
	local class = Config.WeaponClasses[def.Class]
	player:SetAttribute("WeaponId", def.Id)
	player:SetAttribute("WeaponClass", def.Class)
	player:SetAttribute("WeaponRarity", rarityId)
	player:SetAttribute("WeaponSkill", def.Skill)
	player:SetAttribute("WeaponUltimate", class and class.Ultimate or "")
end

function Weapons.Equip(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" or not data.Weapons[uid] then
		return
	end
	data.Equipped = uid
	Weapons.Refresh(player)
	DataService.MarkDirty(player)
	local rec = data.Weapons[uid]
	Net.FX(player, "Equipped", { Weapon = rec.W, Rarity = rec.R })
end

function Weapons.Scrap(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" then
		return
	end
	local rec = data.Weapons[uid]
	if not rec then
		return
	end
	if uid == data.Equipped then
		Net.Notify(player, "Unequip that weapon before scrapping it.", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	local scrap = Config.WeaponRarityById[rec.R].Scrap
	data.Weapons[uid] = nil
	data.Coins += scrap
	Net.Notify(player, "Scrapped " .. Config.WeaponById[rec.W].Name .. " for " .. scrap .. " Coins.", Color3.fromRGB(255, 215, 70), "Sell")
	DataService.MarkDirty(player)
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="30">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Client (LocalScript) -> StarterPlayer/StarterPlayerScripts/Client
-- Put the UI, Hud, WeaponUI, Abilities, PromptUI and Drops ModuleScripts
-- INSIDE this LocalScript. Handles server FX events, world VFX/SFX, gates,
-- pads and zones.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local UI = require(script:WaitForChild("UI"))
local Drops = require(script:WaitForChild("Drops"))
local Abilities = require(script:WaitForChild("Abilities"))
local Hud = require(script:WaitForChild("Hud"))
local WeaponUI = require(script:WaitForChild("WeaponUI"))
local PromptUI = require(script:WaitForChild("PromptUI"))

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local AbilityRemote = Remotes:WaitForChild("Ability") :: RemoteEvent
local InteractRemote = Remotes:WaitForChild("Interact") :: RemoteEvent
local RequestRemote = Remotes:WaitForChild("Request") :: RemoteEvent
local SyncRemote = Remotes:WaitForChild("Sync") :: RemoteEvent
local FXRemote = Remotes:WaitForChild("FX") :: RemoteEvent

local function request(action: string, arg: any?)
	RequestRemote:FireServer(action, arg)
end

VFX.Init()
SFX.Init()
UI.Init(request)
WeaponUI.Init(UI, request)
Abilities.Init(AbilityRemote, request)
Hud.Init(UI, Abilities)
PromptUI.Init(InteractRemote)
Drops.Init(request)

Abilities.OnFeedback = function(kind)
	if kind == "NoStamina" then
		Hud.FlashStamina()
	end
end

local data = nil
local currentStage = 0
local currentZone = 0

local function myRoot(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function charOf(p: Player?): Model?
	return p and p.Character
end

local function weaponColor(who: Player?): Color3
	local p: Player = who or player
	local def = Config.WeaponById[p:GetAttribute("WeaponId") or Config.StarterWeapon]
	local r = Config.WeaponRarityById[p:GetAttribute("WeaponRarity") or "Common"]
	return (def and def.Glow) or (r and r.Color) or Color3.fromRGB(230, 240, 255)
end

local function bladeColor(): Color3
	return weaponColor(player)
end

player.CharacterAdded:Connect(function()
	Drops.ClearAll()
	currentStage = -1
end)

---------------------------------------------------------------------
-- GATES (opened locally when you meet the Power requirement)
---------------------------------------------------------------------
local function refreshGate(gate: BasePart)
	if not data then
		return
	end
	local stageIndex = gate:GetAttribute("Stage")
	local stage = stageIndex and Config.Stages[stageIndex]
	if not stage then
		return
	end
	local zone = Config.Zones[stage.Zone]
	local open = data.Power >= stage.PowerReq and data.Blade >= (zone.BladeReq or 0)
	if gate:GetAttribute("Open") == open then
		return
	end
	gate:SetAttribute("Open", open)
	gate.CanCollide = not open
	gate.Transparency = open and 0.85 or 0.1
	local label = gate:FindFirstChild("GateLabel")
	local title = label and label:FindFirstChild("Title")
	if title then
		(title :: TextLabel).Text = open and ("STAGE " .. stageIndex .. " - OPEN") or ("LOCKED - " .. Format.Abbrev(stage.PowerReq) .. " Power")
	end
	if open and stage.PowerReq > 0 and gate:GetAttribute("Seen") then
		UI.Notify("Stage " .. stageIndex .. " unlocked!", zone.Accent)
		SFX.Play("Stage")
	end
	gate:SetAttribute("Seen", true)
end

local function refreshGates()
	for _, g in ipairs(CollectionService:GetTagged("StageGate")) do
		refreshGate(g)
	end
end
CollectionService:GetInstanceAddedSignal("StageGate"):Connect(function(g)
	refreshGate(g)
end)

---------------------------------------------------------------------
-- SYNC
---------------------------------------------------------------------
SyncRemote.OnClientEvent:Connect(function(snapshot)
	local old = data
	data = snapshot
	UI.Update(snapshot)
	refreshGates()
	if old and snapshot.Blade > old.Blade then
		UI.Bump("Blade")
	end
end)

---------------------------------------------------------------------
-- FX EVENTS FROM THE SERVER
---------------------------------------------------------------------
local FX = {}

local SWING_SOUND = { Katana = "Swing", Greatsword = "HeavySwing", Scythe = "ScytheSwing", Glove = "Punch", Pistols = "GunShot", FingerGun = "SpiritShot" }

-- Basic attacks of OTHER players (yours are drawn instantly by Abilities).
FX.Attack = function(p)
	local char = charOf(p.Player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if p.Player ~= player then
		local class = Config.WeaponClasses[p.Class]
		if class and class.Kind == "Melee" then
			VFX.Slash(root.CFrame * CFrame.new(0, 0.6, 0), p.Color, class.Range / 9, p.Combo % 2 == 0)
		elseif p.Dir then
			VFX.Muzzle(root.Position + Vector3.new(0, 1.2, 0) + p.Dir * 2, p.Dir, p.Color)
		end
		SFX.Play(SWING_SOUND[p.Class] or "Swing", { At = root.Position, Volume = 0.6 })
	end
	if p.Heavy then
		local ground = root.Position - Vector3.new(0, 2.8, 0)
		VFX.Ring(ground, Color3.fromRGB(80, 220, 255), 18, 0.45)
		VFX.ShardRing(ground + Vector3.new(0, 1, 0), Color3.fromRGB(120, 230, 255), 18, 16, 0.45)
		VFX.Emit(root.Position, "Sparks", 30, Color3.fromRGB(80, 220, 255))
		VFX.Emit(root.Position, "Glow", 1, Color3.fromRGB(80, 220, 255))
		SFX.Play("AoE", { At = root.Position })
		if p.Player == player then
			VFX.Shake(0.25)
		end
	end
end

FX.Hit = function(p)
	local color = p.Color or Color3.new(1, 1, 1)
	VFX.HitSpark(p.Pos, color, p.Crit)
	if p.Model then
		VFX.EnemyHitFlash(p.Model)
	end
	if p.By == player then
		VFX.DamageNumber(p.Pos + Vector3.new(0, 1.5, 0), p.Amount, p.Crit)
		SFX.Play(p.Crit and "Crit" or "Hit", { At = p.Pos })
		VFX.Shake(p.Crit and 0.16 or 0.05)
	end
end

FX.Kill = function(p)
	if p.Model then
		VFX.EnemyDeath(p.Model, p.Color or Color3.new(1, 1, 1), p.Big)
	elseif p.Pos then
		VFX.Explosion(p.Pos, p.Color or Color3.new(1, 1, 1), p.Big and 2.5 or 1)
	end
	if p.Big then
		SFX.Play("BossKill")
		local root = myRoot()
		if root and (root.Position - p.Pos).Magnitude < 150 then
			VFX.ImpactFrame(p.Color, 1.4)
			VFX.TitleCard("BOSS DEFEATED!", nil, Color3.fromRGB(255, 215, 80), 1.6)
		end
	elseif p.Elite then
		SFX.Play("EliteKill", { At = p.Pos })
		if p.By == player then
			VFX.ImpactFrame(Color3.fromRGB(255, 210, 80), 0.7)
		end
	else
		SFX.Play("Kill", { At = p.Pos })
		if p.By == player then
			VFX.Shake(0.12)
		end
	end
end

FX.Reward = function(p)
	UI.FlyToHud("Coins", p.Pos, Config.Rarity.Legendary.Color, 3)
	VFX.TextPop(p.Pos + Vector3.new(0, 3, 0), "+" .. Format.Abbrev(p.Coins) .. " Coins", Color3.fromRGB(255, 215, 70), 0.8)
	task.delay(0.5, SFX.Play, "Coins", { Volume = 0.5 })
end

FX.Drop = function(p)
	Drops.Spawn(p)
end

FX.Collected = function(p)
	Drops.Collected(p.Id)
end

FX.CollectFail = function(p)
	Drops.Fail(p.Id, p.Full)
end

local lastPowerPop = 0
FX.Power = function(p)
	local root = myRoot()
	if not root then
		return
	end
	UI.Bump("Power")
	if os.clock() - lastPowerPop > 0.12 then
		lastPowerPop = os.clock()
		VFX.TextPop(root.Position + Vector3.new(math.random() * 2 - 1, 2, 0), "+" .. Format.Abbrev(p.Amount) .. " Power", Color3.fromRGB(120, 255, 170), p.Pad and 0.9 or 0.7)
	end
	if p.Pad then
		VFX.Emit(root.Position - Vector3.new(0, 2.5, 0), "Rise", p.Auto and 4 or 8, Config.TrainPads[p.Pad].Color)
	end
	if not p.Auto then
		SFX.Play("PowerGain", { Volume = 0.8 })
	end
end

FX.Forge = function(p)
	UI.Bump("Blade")
	local char = player.Character
	if p.TierUp then
		SFX.Play("ForgeTierUp")
		VFX.ImpactFrame(bladeColor(), 1.3)
		VFX.TitleCard("NEW BLADE TIER!", p.TierName .. " Blade  (+" .. Format.Abbrev(p.To) .. ")", bladeColor(), 2.2)
		if char then
			VFX.Transform(char, bladeColor(), false)
		end
	else
		SFX.Play(p.Auto and "Milestone" or "Forge")
		if not p.Auto then
			VFX.TitleCard("+" .. Format.Abbrev(p.Gained) .. " BLADE", "Blade +" .. Format.Abbrev(p.From) .. "  ->  +" .. Format.Abbrev(p.To), Color3.fromRGB(255, 160, 60), 1.3)
		end
		if p.Milestone and char then
			VFX.LevelBurst(char, bladeColor())
		end
	end
end

FX.ForgeBurst = function(p)
	local map = workspace:FindFirstChild("GeneratedMap")
	local lava = map and map:FindFirstChild("Lava", true)
	if not lava then
		return
	end
	local pos = lava.Position
	local color = Color3.fromRGB(255, 140, 40)
	VFX.Pillar(pos, color, 40, 5, 0.9)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Sparks", 40, color)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Embers", 30, color)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Smoke", 10, Color3.fromRGB(90, 80, 90))
	VFX.Ring(pos, color, 16, 0.5)
	VFX.Light(pos, color, 40, 6, 0.8)
	if p.Player == player then
		VFX.Shake(0.35)
		VFX.FOVPunch(-6)
	else
		SFX.Play("Forge", { At = pos, Volume = 0.5 })
	end
end

FX.Sell = function(p)
	SFX.Play("Sell")
	UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 8)
	UI.Notify(p.Text, Color3.fromRGB(255, 215, 70))
end

FX.Rebirth = function(p)
	local char = charOf(p.Player)
	if not char then
		return
	end
	local gold = Color3.fromRGB(255, 215, 80)
	if p.Player == player then
		SFX.Play("Rebirth")
		VFX.Transform(char, gold, true)
		task.delay(0.6, function()
			VFX.TitleCard("REBIRTH " .. p.Rebirths .. "!", "Power gain, Coins and Damage boosted forever", gold, 2.4)
		end)
	else
		VFX.Transform(char, gold, false)
	end
end

FX.RaceRoll = function(p)
	UI.RaceRoll(p.Race, p.Tier, p.Initial)
end

FX.Transform = function(p)
	local char = charOf(p.Player)
	if not char then
		return
	end
	local isLocal = p.Player == player
	local titles = { Overdrive = "OVERDRIVE!", Zenkai = "ZENKAI BOOST!", Awaken = "AWAKENED!" }
	VFX.Transform(char, p.Color, isLocal, titles[p.Kind])
	local root = char:FindFirstChild("HumanoidRootPart")
	local sound = p.Kind == "Zenkai" and "Zenkai" or (p.Kind == "Awaken" and "RaceRevealLegend" or "Overdrive")
	if isLocal then
		if p.Kind ~= "Awaken" then
			SFX.Play(sound)
		end
	elseif root then
		SFX.Play(sound, { At = root.Position, Volume = 0.7 })
	end
end

FX.Notify = function(p)
	UI.Notify(p.Text, p.Color)
	if p.Sound then
		SFX.Play(p.Sound)
	end
end

FX.Discover = function(p)
	local ore = Config.OreById[p.Ore]
	if not ore then
		return
	end
	SFX.Play("Discover")
	VFX.TitleCard("NEW ORE DISCOVERED!", ore.Name .. "  (+" .. Format.Abbrev(p.Reward) .. " Coins)", ore.Color, 2)
	UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 6)
end

FX.BossSpawn = function(p)
	if currentZone ~= p.Zone then
		return
	end
	SFX.Play("BossSpawn")
	VFX.Shake(0.5)
	VFX.TitleCard("BOSS APPEARED!", p.Name, Color3.fromRGB(255, 70, 90), 2)
end

FX.Telegraph = function(p)
	VFX.Telegraph(p.Pos, p.Radius, p.Time)
	SFX.Play("Telegraph", { At = p.Pos })
end

FX.Slam = function(p)
	VFX.Explosion(p.Pos + Vector3.new(0, 1, 0), p.Color or Color3.fromRGB(255, 90, 60), 1.4)
	SFX.Play("BossSlam", { At = p.Pos })
	local root = myRoot()
	if root and (root.Position - p.Pos).Magnitude < 60 then
		VFX.Shake(0.45)
	end
end

FX.EnemySwipe = function(p)
	local cf = CFrame.lookAt(p.Pos, Vector3.new(p.Target.X, p.Pos.Y, p.Target.Z))
	VFX.Slash(cf, Color3.fromRGB(255, 70, 70), 0.6, math.random() < 0.5)
	SFX.Play("Swing", { At = p.Pos, Pitch = 0.7, Volume = 0.5 })
end

FX.Hurt = function(p)
	SFX.Play("Hurt")
	VFX.ScreenFlash(Color3.fromRGB(255, 30, 40), 0.55, 0.35)
	VFX.Shake(0.22)
end

FX.Dodge = function()
	local root = myRoot()
	if root then
		VFX.TextPop(root.Position + Vector3.new(0, 3, 0), "DODGE!", Color3.fromRGB(140, 160, 255), 1)
		SFX.Play("UIHover", { Pitch = 0.8, Volume = 2 })
	end
end

FX.PlotArmor = function()
	SFX.Play("PlotArmor")
	VFX.ImpactFrame(Color3.fromRGB(255, 215, 80), 1)
	VFX.TitleCard("PLOT ARMOR!", "Main Characters don't go down that easy", Color3.fromRGB(255, 215, 80), 1.8)
end

FX.Tower = function(p)
	if p.State == "Floor" then
		UI.Tower("Floor", p.Floor, 0)
		UI.Banner("FLOOR " .. p.Floor, "Get ready...", p.Color)
		SFX.Play("TowerStart")
		SFX.PlayMusic(Config.Music.Tower)
	elseif p.State == "Start" then
		UI.Tower("Start", p.Floor, p.EndsAt)
		VFX.TitleCard("FIGHT!", "Beat the Guardian in " .. Config.Tower.TimeLimit .. "s", p.Color, 1)
	elseif p.State == "Win" then
		UI.Tower("Win", p.Floor, 0)
		SFX.Play("TowerWin")
		VFX.TitleCard("FLOOR " .. p.Floor .. " CLEARED!", p.Text, Color3.fromRGB(120, 255, 170), 2)
		UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 8)
	elseif p.State == "Lose" then
		SFX.Play("TowerLose")
		VFX.TitleCard("DEFEATED", "You reached floor " .. p.Floor, Color3.fromRGB(255, 90, 90), 2)
		task.delay(2, UI.Tower, nil)
	else
		UI.Tower(nil)
	end
end

FX.OpenPanel = function(p)
	UI.Open(p.Name, p.Mode)
	SFX.Play("UIOpen")
end

FX.Teleported = function(p)
	SFX.Play("Teleport")
	VFX.ScreenFlash(Color3.fromRGB(230, 220, 255), 0.1, 0.5)
	VFX.FOVPunch(12)
	currentStage = -1
	if p.Where then
		UI.Banner(p.Where, nil, Color3.fromRGB(220, 200, 255))
	end
end

FX.Purchase = function(p)
	SFX.Play("Purchase")
	VFX.ScreenFlash(Color3.fromRGB(120, 255, 150), 0.6, 0.4)
	UI.Notify("Got " .. (p.Text and p.Text ~= "" and p.Text or p.Name) .. "!", Color3.fromRGB(120, 255, 150))
end

FX.Upgraded = function(p)
	local char = player.Character
	UI.Notify(Config.Upgrades[p.Key].Name .. " upgraded to level " .. p.Level .. "!", Color3.fromRGB(120, 200, 255))
	if char then
		VFX.LevelBurst(char, Color3.fromRGB(120, 200, 255))
	end
end

---------------------------------------------------------------------
-- ABILITIES / PROJECTILES
---------------------------------------------------------------------
local SKILL_SOUND = {
	GetsugaTensho = "Getsuga",
	CeroMetralleta = "BigBlast",
	SpiritGun = "BigBlast",
	ChargedShot = "BigBlast",
	DimensionalRift = "Vortex",
	Reap = "Vortex",
	VoidHarvest = "Vortex",
	HellDragon = "Getsuga",
	BlackBladeRush = "HeavySwing",
	IaidoDash = "HeavySwing",
	ChakraPalm = "Punch",
	GroundCleave = "BossSlam",
	StormCleave = "BossSlam",
	BurstFire = "GunShot",
}

FX.Dash = function(p)
	if p.Player == player then
		return
	end
	local char = charOf(p.Player)
	if char then
		VFX.Afterimage(char, weaponColor(p.Player))
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then
			SFX.Play("Dash", { At = root.Position, Volume = 0.6 })
		end
	end
end

FX.Charge = function(p)
	if p.Player == player then
		return
	end
	local char = charOf(p.Player)
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if hand then
		local def = Config.WeaponById[p.Player:GetAttribute("WeaponId") or ""]
		local skill = def and Config.Skills[p.Slot == "E" and def.Skill or ""]
		local orb = VFX.ChargeOrb(hand, Vector3.new(0, -0.9, 0), skill and skill.Color or weaponColor(p.Player), 2.2, skill and skill.Charge or 1.5)
		task.delay(skill and skill.Charge or 1.5, orb.Destroy)
	end
end

FX.Skill = function(p)
	local skill = Config.Skills[p.Skill]
	if not skill then
		return
	end
	local char = charOf(p.Player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local isLocal = p.Player == player
	local pos = root and root.Position or p.Pos
	local color = skill.Color
	local dir = p.Dir or Vector3.new(0, 0, -1)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	flatDir = flatDir.Magnitude > 0.01 and flatDir.Unit or Vector3.new(0, 0, -1)

	if skill.Type == "Cone" then
		local hits = skill.Hits or 1
		task.spawn(function()
			for i = 1, hits do
				local r = char and char:FindFirstChild("HumanoidRootPart")
				local o = r and r.Position or pos
				VFX.ConeSwipe(CFrame.lookAt(o, o + flatDir) * CFrame.new(0, 0.6, 0), skill.Range, color)
				if i < hits then
					task.wait(skill.Interval or 0.1)
				end
			end
		end)
	elseif skill.Type == "Nova" then
		local hits = skill.Hits or 1
		task.spawn(function()
			for i = 1, hits do
				local r = char and char:FindFirstChild("HumanoidRootPart")
				VFX.Nova(r and r.Position or pos, skill.Radius, color)
				if skill.Pull then
					VFX.Zone((r and r.Position or pos) - Vector3.new(0, 2.8, 0), skill.Radius * 0.6, 0.5, color)
				end
				if i < hits then
					task.wait(skill.Interval or 0.12)
				end
			end
		end)
	elseif skill.Type == "DashStrike" or skill.Type == "ChargeLunge" then
		if p.Finish then
			task.delay(0.05, function()
				VFX.Streak(p.Pos, p.Finish, color, skill.Width * 0.3)
				VFX.Slash(CFrame.lookAt(p.Finish, p.Finish + flatDir), color, 1.6, math.random() < 0.5)
			end)
		end
		if char and not isLocal then
			VFX.Afterimage(char, color)
		end
	elseif skill.Type == "Zone" and p.Target then
		VFX.Zone(p.Target, skill.Radius, p.Duration or 2.5, color)
	elseif skill.Type == "Rain" and p.Target then
		VFX.Ring(p.Target, color, skill.Radius, 0.6)
	end

	SFX.Play(p.Slot == "R" and "Ultimate" or (SKILL_SOUND[p.Skill] or "HeavySwing"), { At = not isLocal and pos or nil })
	if isLocal then
		local def = Config.WeaponById[player:GetAttribute("WeaponId") or ""]
		local rarity = Config.WeaponRarityById[player:GetAttribute("WeaponRarity") or "Common"]
		-- anime call-out for ultimates and signature skills
		if p.Slot == "R" or (rarity and rarity.Index >= 5) then
			VFX.ImpactFrame(color, p.Slot == "R" and 1.2 or 0.8)
			VFX.TitleCard(skill.Name:upper() .. "!", def and def.Name or nil, color, 1.1)
		else
			VFX.Shake(0.2)
			if root then
				VFX.TextPop(root.Position + Vector3.new(0, 3, 0), skill.Name, color, 1.1)
			end
		end
	end
end

local lastProjSound = 0
FX.Proj = function(p)
	VFX.StartProjectile(p.Id, p.Kind, p.Pos, p.Dir, p.Speed, p.Range, p.Color or Color3.new(1, 1, 1), p.Size)
	local t = os.clock()
	if t - lastProjSound > 0.06 then
		lastProjSound = t
		local cue = p.Kind == "Cero" and "CeroShot" or (p.Kind == "Orb" and "SpiritShot" or (p.Kind == "Ray" and "GunShot" or nil))
		if cue then
			SFX.Play(cue, { At = p.Pos, Volume = 0.7 })
		end
	end
end

FX.ProjEnd = function(p)
	VFX.EndProjectile(p.Id, p.Pos, p.Hit, p.Explode)
	if p.Explode then
		SFX.Play("BigBlast", { At = p.Pos })
	end
end

FX.Impact = function(p)
	local color = p.Color or Color3.new(1, 1, 1)
	if p.Kind == "Rasengan" then
		VFX.Explosion(p.Pos, color, 1.3)
		VFX.Zone(p.Pos - Vector3.new(0, 2.5, 0), p.Radius or 10, 0.4, color)
		VFX.ShardRing(p.Pos, color, 22, 20, 0.5)
		SFX.Play("RasenganHit", { At = p.Pos })
		local root = myRoot()
		if root and (root.Position - p.Pos).Magnitude < 60 then
			VFX.Shake(0.45)
		end
	elseif p.Kind == "Rain" then
		VFX.Pillar(p.Pos - Vector3.new(0, 1, 0), color, 40, 2.5, 0.5)
		VFX.Emit(p.Pos, "Sparks", 14, color)
		VFX.Ring(p.Pos, color, p.Radius or 7, 0.35)
		SFX.Play("Hit", { At = p.Pos, Volume = 0.6 })
	elseif p.Kind == "Burn" then
		VFX.Emit(p.Pos, "Fire", 6, color)
	else
		VFX.Explosion(p.Pos, color, 0.8)
	end
end

FX.Cooldown = function(p)
	Abilities.SetCooldown(p.Slot, p.Duration)
end

FX.AbilityFail = function()
	SFX.Play("Error", { Volume = 0.4 })
end

FX.NoStamina = function()
	SFX.Play("NoStamina")
	Hud.FlashStamina()
end

FX.Potion = function()
	SFX.Play("Potion")
	local char = player.Character
	if char then
		VFX.LevelBurst(char, Color3.fromRGB(120, 255, 140))
	end
end

---------------------------------------------------------------------
-- ENEMY TELEGRAPHS
---------------------------------------------------------------------
FX.EnemyWindup = function(p)
	if p.Kind == "Slam" then
		VFX.Telegraph(p.Pos, p.Radius, p.Time)
	else
		VFX.TelegraphLine(p.Pos, p.Dir, p.Length, 9, p.Time)
	end
	local model = p.Model
	local head = model and model:FindFirstChild("Head")
	if head then
		VFX.Emit(head.Position, "Glow", 1, Color3.fromRGB(255, 60, 60))
		VFX.Emit(head.Position, "Rise", 12, p.Color or Color3.fromRGB(255, 80, 80))
	end
	SFX.Play("EnemyWindup", { At = p.Pos })
end

FX.EnemyLunge = function(p)
	VFX.Streak(p.From, p.To, Color3.fromRGB(255, 70, 70), 2)
	SFX.Play("HeavySwing", { At = p.From, Pitch = 0.8 })
end

---------------------------------------------------------------------
-- LOOT / RETENTION / MONETIZATION
---------------------------------------------------------------------
FX.Equipped = function(p)
	SFX.Play("Equip")
	local def = Config.WeaponById[p.Weapon]
	local r = Config.WeaponRarityById[p.Rarity]
	if def and r then
		UI.Notify("Equipped " .. def.Name .. " (" .. (r.Label or r.Id) .. ")", r.Color)
	end
	local char = player.Character
	if char then
		VFX.LevelBurst(char, r and r.Color or Color3.new(1, 1, 1))
	end
end

FX.WeaponDrop = function(p)
	local r = Config.WeaponRarityById[p.Rarity]
	if r and r.Index >= 4 then
		WeaponUI.Reveal(p.Weapon, p.Rarity, "WEAPON DROP!")
	else
		local def = Config.WeaponById[p.Weapon]
		SFX.Play("RarePickup")
		UI.Notify("Weapon drop: " .. (r and (r.Label or r.Id) or "") .. " " .. (def and def.Name or "?"), r and r.Color or nil)
	end
end

FX.ChestResult = function(p)
	WeaponUI.Reveal(p.Weapon, p.Rarity, Config.ChestById[p.Chest] and Config.ChestById[p.Chest].Name:upper() or "CHEST")
end

FX.PlaytimeReward = function(p)
	SFX.Play("PlaytimeReward")
	VFX.TitleCard("PLAY-TIME REWARD!", p.Minutes .. " min: " .. p.Name, Color3.fromRGB(255, 215, 80), 2)
	UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 6)
end

FX.Daily = function(p)
	SFX.Play("PlaytimeReward")
	VFX.TitleCard("DAY " .. p.Streak .. " STREAK!", p.Text .. "  |  +" .. math.floor((p.Bonus or 0) * 100 + 0.5) .. "% Coins", Color3.fromRGB(120, 220, 255), 2.4)
end

FX.PowerTier = function(p)
	SFX.Play("PowerUp")
	VFX.ImpactFrame(Color3.fromRGB(255, 80, 80), 1.4)
	VFX.TitleCard("POWER x" .. Format.Abbrev(p.Mult) .. "!", "Tier " .. p.Tier .. " unlocked", Color3.fromRGB(255, 90, 90), 2.2)
	local char = player.Character
	if char then
		VFX.Transform(char, Color3.fromRGB(255, 80, 80), false)
	end
end

FXRemote.OnClientEvent:Connect(function(kind, payload)
	local fn = FX[kind]
	if fn then
		local ok, err = pcall(fn, payload or {})
		if not ok then
			warn("[FX] " .. tostring(kind) .. ": " .. tostring(err))
		end
	end
end)

Drops.OnPickup = function(oreId, pos)
	UI.Bump("Backpack")
	local ore = Config.OreById[oreId]
	if ore and ore.Order >= 3 then
		VFX.TextPop(pos + Vector3.new(0, 3, 0), "+1 " .. ore.Name, ore.Color, 0.8)
	end
end

---------------------------------------------------------------------
-- WORLD: spinning props, pads, rooms / zone lighting & music
---------------------------------------------------------------------
local spinners = {}
local function addSpinner(inst: Instance)
	local pivot = if inst:IsA("Model") then inst:GetPivot() elseif inst:IsA("BasePart") then inst.CFrame else nil
	if pivot then
		spinners[inst] = { Base = pivot, Angle = 0, Phase = math.random() * 6 }
	end
end
for _, inst in ipairs(CollectionService:GetTagged("Spin")) do
	addSpinner(inst)
end
CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpinner)
CollectionService:GetInstanceRemovedSignal("Spin"):Connect(function(inst)
	spinners[inst] = nil
end)

local gameColor = Lighting:FindFirstChild("GameColor") :: ColorCorrectionEffect?
local function setZoneLook(zoneId: number)
	local zone = Config.Zones[zoneId]
	local tint = zone and zone.Tint or Color3.fromRGB(255, 250, 255)
	gameColor = gameColor or Lighting:FindFirstChild("GameColor") :: ColorCorrectionEffect?
	if gameColor then
		TweenService:Create(gameColor, TweenInfo.new(1.5), { TintColor = tint }):Play()
	end
	local music = zoneId == 0 and Config.Music.Hub or Config.Music["Zone" .. zoneId]
	SFX.PlayMusic(music)
end

local function pointInPart(part: BasePart, pos: Vector3): boolean
	local rel = part.CFrame:PointToObjectSpace(pos)
	local half = part.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

local accum = 0
RunService.RenderStepped:Connect(function(dt)
	UI.Tick()
	Hud.Tick()
	local root = myRoot()
	Drops.Step(dt, root)

	local t = os.clock()
	for inst, s in pairs(spinners) do
		if inst.Parent then
			s.Angle += math.rad(inst:GetAttribute("SpinSpeed") or 30) * dt
			local bob = inst:GetAttribute("Bob") or 0
			local rot = inst:GetAttribute("SpinAxis") == "Z" and CFrame.Angles(0, 0, s.Angle) or CFrame.Angles(0, s.Angle, 0)
			local cf = s.Base * CFrame.new(0, math.sin(t * 1.6 + s.Phase) * bob, 0) * rot
			if inst:IsA("Model") then
				inst:PivotTo(cf)
			else
				(inst :: BasePart).CFrame = cf
			end
		else
			spinners[inst] = nil
		end
	end

	accum += dt
	if accum < 0.25 or not root or not data then
		return
	end
	accum = 0
	WeaponUI.Tick()

	-- training pad indicator
	local padMult, padLocked = nil, false
	for _, pad in ipairs(CollectionService:GetTagged("TrainPad")) do
		local p = pad :: BasePart
		local flat = Vector3.new(root.Position.X - p.Position.X, 0, root.Position.Z - p.Position.Z)
		if flat.Magnitude <= Config.TrainPadRadius and math.abs(root.Position.Y - p.Position.Y) < 7 then
			padMult = p:GetAttribute("Mult")
			padLocked = data.Power < (p:GetAttribute("PowerReq") or 0) or data.Rebirths < (p:GetAttribute("RebirthReq") or 0)
			break
		end
	end
	UI.SetPad(padMult, padLocked)

	-- which stage room are we in?
	local stageNow, zoneNow = 0, 0
	for _, room in ipairs(CollectionService:GetTagged("StageRoom")) do
		if pointInPart(room :: BasePart, root.Position) then
			stageNow = room:GetAttribute("Stage") or 0
			zoneNow = room:GetAttribute("Zone") or 0
			break
		end
	end
	if stageNow == 0 then
		-- start area of a dungeon still counts as that zone
		if root.Position.Z < -900 then
			zoneNow = root.Position.X > 350 and 2 or 1
		end
	end
	if zoneNow ~= currentZone then
		currentZone = zoneNow
		setZoneLook(zoneNow)
	end
	if stageNow ~= currentStage then
		local prev = currentStage
		currentStage = stageNow
		if stageNow > 0 and prev >= 0 then
			local stage = Config.Stages[stageNow]
			local zone = Config.Zones[stage.Zone]
			UI.Banner("STAGE " .. stageNow, (stage.Boss and "BOSS: " or "") .. stage.Enemy, zone.Accent)
			SFX.Play("Stage")
		end
	end
end)

task.spawn(function()
	for _ = 1, 10 do
		request("Ready")
		task.wait(2)
		if data then
			break
		end
	end
end)
print("[" .. Config.GameName .. "] client ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Abilities (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Abilities
-- Combat input through ContextActionService:
--   LMB / RT / touch button   basic attack (hold to keep attacking)
--   Q   / B                   dash (short i-frames)
--   E   / X                   weapon skill (hold for charge skills)
--   R   / Y                   ultimate
--   C   / LB                  Overdrive transformation
--   H                         health potion
-- The client plays animations + instant feedback; the server validates
-- stamina, cooldowns and hits.

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local Abilities = {}
Abilities.CooldownEnds = { LMB = 0, Q = 0, E = 0, R = 0, C = 0 }
Abilities.CooldownLength = { LMB = 1, Q = 1, E = 1, R = 1, C = 1 }
Abilities.OnFeedback = nil :: ((string) -> ())? -- "NoStamina", ...

local player = Players.LocalPlayer
local remote: RemoteEvent
local request: (string, any?) -> ()
local tracks: { [string]: AnimationTrack } = {}
local attackHeld = false
local lastAttack = 0
local combo = 0
local charging = nil -- { Slot, Orb, Start }
local B = Config.Balance

local SWING_SOUND = { Katana = "Swing", Greatsword = "HeavySwing", Scythe = "ScytheSwing", Glove = "Punch", Pistols = "GunShot", FingerGun = "SpiritShot" }

---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function character()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil, nil, nil
	end
	return c, hum, root :: BasePart
end

local function weapon()
	local id = player:GetAttribute("WeaponId") or Config.StarterWeapon
	local def = Config.WeaponById[id] or Config.WeaponById[Config.StarterWeapon]
	local rarity = Config.WeaponRarityById[player:GetAttribute("WeaponRarity") or "Common"] or Config.WeaponRarities[1]
	return def, Config.WeaponClasses[def.Class], rarity
end

function Abilities.SkillFor(slot: string)
	local def, class = weapon()
	local id = slot == "E" and def.Skill or class.Ultimate
	return id, Config.Skills[id]
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Aim direction + target point (mouse on PC, camera direction otherwise).
local function aim(): (Vector3, Vector3)
	local c, _, root = character()
	local cam = workspace.CurrentCamera
	if not root or not cam then
		return Vector3.new(0, 0, -1), Vector3.zero
	end
	local origin = root.Position + Vector3.new(0, 1.2, 0)
	local target
	local last = UserInputService:GetLastInputType()
	if UserInputService.MouseEnabled and (last == Enum.UserInputType.MouseButton1 or last == Enum.UserInputType.MouseMovement or last == Enum.UserInputType.Keyboard or last == Enum.UserInputType.MouseButton2 or last == Enum.UserInputType.MouseWheel) then
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local ignore = { c }
		local fx = workspace:FindFirstChild("ClientFX")
		if fx then
			table.insert(ignore, fx)
		end
		rayParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
		target = hit and hit.Position or (ray.Origin + ray.Direction * 400)
	else
		target = origin + flat(cam.CFrame.LookVector) * 40
	end
	local dir = target - origin
	if dir.Magnitude < 0.1 then
		dir = root.CFrame.LookVector
	end
	return dir.Unit, target
end

local function faceTowards(dir: Vector3)
	local _, _, root = character()
	if root then
		local f = flat(dir)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + f)
	end
end

local function stamina(): number
	return player:GetAttribute("Stamina") or B.MaxStamina
end

local function staminaCost(base: number): number
	local def, _, rarity = weapon()
	local cost = base * B.StaminaCostMult
	if rarity.Passive and def.Passive and def.Passive.Id == "ChakraFlow" then
		cost *= 0.8
	end
	return cost
end

local function play(name: string, speed: number?)
	local t = tracks[name]
	if t then
		t:Play(0.05)
		if speed then
			t:AdjustSpeed(speed)
		end
	end
	return t
end

local function rightHand(): BasePart?
	local c = player.Character
	return c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")) :: any
end

local function muzzlePosition(dir: Vector3): Vector3
	local c = player.Character
	local w = c and c:FindFirstChild("EquippedWeapon_Right")
	local m = w and w:FindFirstChild("Muzzle", true)
	if m and m:IsA("Attachment") then
		return m.WorldPosition
	end
	local _, _, root = character()
	return root and (root.Position + Vector3.new(0, 1.2, 0) + dir * 2) or Vector3.zero
end

local function feedback(kind: string)
	if Abilities.OnFeedback then
		Abilities.OnFeedback(kind)
	end
end

---------------------------------------------------------------------
-- ANIMATIONS
---------------------------------------------------------------------
local function loadTracks(char: Model)
	tracks = {}
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	local animator = hum:WaitForChild("Animator", 10) :: Animator?
	if not animator then
		return
	end
	local set = hum.RigType == Enum.HumanoidRigType.R15 and Config.PlayerAnims.R15 or Config.PlayerAnims.R6
	for name, id in pairs(set) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, t = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok and t then
			t.Priority = name == "Hold" and Enum.AnimationPriority.Action or Enum.AnimationPriority.Action4
			if name == "Hold" or name == "Charge" then
				t.Looped = true
			end
			tracks[name] = t
		end
	end
	Abilities.RefreshHold()
end

function Abilities.RefreshHold()
	local def = weapon()
	local wantsHold = def.Class ~= "Glove" and def.Class ~= "FingerGun"
	local t = tracks.Hold
	if not t then
		return
	end
	if wantsHold and not t.IsPlaying then
		t:Play(0.2)
	elseif not wantsHold and t.IsPlaying then
		t:Stop(0.2)
	end
end

---------------------------------------------------------------------
-- BASIC ATTACK
---------------------------------------------------------------------
local function tryAttack()
	local c, _, root = character()
	if not c or charging then
		return
	end
	local def, class, rarity = weapon()
	local as = rarity.AttackSpeed or 0
	local interval = class.Interval / (1 + as)
	local t = os.clock()
	if t - lastAttack < interval then
		return
	end
	if t - lastAttack > interval * 2.5 then
		combo = 0
	end
	lastAttack = t
	combo = combo % #class.Combo + 1
	Abilities.CooldownEnds.LMB = t + interval
	Abilities.CooldownLength.LMB = interval

	local dir, _ = aim()
	faceTowards(dir)
	remote:FireServer("Attack", { Aim = dir })

	local color = def.Glow or rarity.Color
	if class.Kind == "Ranged" then
		play(def.Class == "FingerGun" and "Point" or "Slash", 1.6)
		VFX.Muzzle(muzzlePosition(dir), dir, color)
	else
		local big = combo == #class.Combo
		play(big and "Lunge" or "Slash", 1 + (1 - class.Interval) * 0.6)
		local scale = class.Range / 9 * (big and 1.25 or 1)
		VFX.Slash(root.CFrame * CFrame.new(0, 0.6, 0), color, scale, combo % 2 == 0)
		if big then
			VFX.Shake(0.08)
		end
	end
	SFX.Play(SWING_SOUND[def.Class] or "Swing", { Pitch = 0.95 + math.random() * 0.1 })
	VFX.Shake(0.02)
end

---------------------------------------------------------------------
-- DASH
---------------------------------------------------------------------
local function doDash(dir: Vector3, speed: number, duration: number)
	local c, _, root = character()
	if not c then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VectorVelocity = flat(dir) * speed
	lv.Parent = root
	Debris:AddItem(lv, duration)
	Debris:AddItem(att, duration)
	local def, _, rarity = weapon()
	local color = def.Glow or rarity.Color
	VFX.Afterimage(c, color)
	task.delay(duration * 0.5, function()
		if c.Parent then
			VFX.Afterimage(c, color)
		end
	end)
end

local function tryDash()
	local c, hum, root = character()
	if not c then
		return
	end
	local t = os.clock()
	if t < Abilities.CooldownEnds.Q then
		return
	end
	if stamina() < staminaCost(B.DashStamina) then
		SFX.Play("NoStamina")
		feedback("NoStamina")
		return
	end
	local dir = hum.MoveDirection.Magnitude > 0.1 and hum.MoveDirection or root.CFrame.LookVector
	Abilities.CooldownEnds.Q = t + B.DashCooldown * B.CooldownMult
	Abilities.CooldownLength.Q = B.DashCooldown * B.CooldownMult
	remote:FireServer("Dash", { Aim = flat(dir) })
	doDash(dir, B.DashDistanceSpeed, B.DashDuration)
	SFX.Play("Dash")
	VFX.FOVPunch(6)
end

---------------------------------------------------------------------
-- SKILLS
---------------------------------------------------------------------
local function canCast(slot: string, skill): boolean
	if os.clock() < Abilities.CooldownEnds[slot] then
		SFX.Play("Error", { Volume = 0.5 })
		return false
	end
	if stamina() < staminaCost(skill.Stamina) then
		SFX.Play("NoStamina")
		feedback("NoStamina")
		return false
	end
	return true
end

-- local movement for dash-type skills (server does the damage)
local function skillMovement(skill, dir: Vector3, charge: number?)
	if skill.Type == "DashStrike" or skill.Type == "ChargeLunge" then
		local dur = 0.22
		doDash(dir, skill.Distance / dur, dur)
		play("Lunge", 1.4)
	elseif skill.Type == "Projectile" or skill.Type == "Barrage" then
		play(weapon().Class == "FingerGun" and "Point" or "Lunge", 1.2)
	else
		play("Lunge", 1)
	end
end

local function castInstant(slot: string)
	local skillId, skill = Abilities.SkillFor(slot)
	if not skill or not canCast(slot, skill) then
		return
	end
	local dir, target = aim()
	faceTowards(dir)
	remote:FireServer(slot == "E" and "Skill" or "Ultimate", { Aim = dir, Target = target })
	skillMovement(skill, dir)
	-- optimistic cooldown (server sends the exact value back)
	local cd = skill.Cooldown * B.CooldownMult
	Abilities.CooldownEnds[slot] = os.clock() + cd
	Abilities.CooldownLength[slot] = cd
	local _ = skillId
end

local function beginCharge(slot: string)
	local _, skill = Abilities.SkillFor(slot)
	if not skill or not canCast(slot, skill) then
		return
	end
	local hand = rightHand()
	local orb = hand and VFX.ChargeOrb(hand, Vector3.new(0, -0.9, 0), skill.Color, skill.Type == "ChargeLunge" and 2.6 or 1.8, skill.Charge)
	charging = { Slot = slot, Orb = orb, Start = os.clock() }
	remote:FireServer("ChargeBegin", { Slot = slot })
	play("Charge")
	SFX.Play("ChargeUp")
end

local function releaseCharge(slot: string)
	if not charging or charging.Slot ~= slot then
		return
	end
	local _, skill = Abilities.SkillFor(slot)
	local held = math.min(os.clock() - charging.Start, skill and skill.Charge or 1)
	if charging.Orb then
		charging.Orb.Destroy()
	end
	if tracks.Charge then
		tracks.Charge:Stop(0.1)
	end
	charging = nil
	if not skill then
		return
	end
	local dir, target = aim()
	faceTowards(dir)
	remote:FireServer("ChargeRelease", { Slot = slot, Aim = dir, Target = target })
	skillMovement(skill, dir, held)
	local cd = skill.Cooldown * B.CooldownMult
	Abilities.CooldownEnds[slot] = os.clock() + cd
	Abilities.CooldownLength[slot] = cd
end

---------------------------------------------------------------------
-- CAS handlers
---------------------------------------------------------------------
local function onAttack(_, state)
	if state == Enum.UserInputState.Begin then
		attackHeld = true
		task.spawn(function()
			while attackHeld do
				tryAttack()
				task.wait(0.05)
			end
		end)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		attackHeld = false
	end
	return Enum.ContextActionResult.Pass
end

local function onDash(_, state)
	if state == Enum.UserInputState.Begin then
		tryDash()
	end
	return Enum.ContextActionResult.Sink
end

local function skillHandler(slot: string)
	return function(_, state)
		local _, skill = Abilities.SkillFor(slot)
		if not skill then
			return Enum.ContextActionResult.Sink
		end
		if skill.Charge then
			if state == Enum.UserInputState.Begin then
				beginCharge(slot)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				releaseCharge(slot)
			end
		elseif state == Enum.UserInputState.Begin then
			castInstant(slot)
		end
		return Enum.ContextActionResult.Sink
	end
end

local function onOverdrive(_, state)
	if state == Enum.UserInputState.Begin then
		request("Overdrive")
	end
	return Enum.ContextActionResult.Sink
end

local function onPotion(_, state)
	if state == Enum.UserInputState.Begin then
		remote:FireServer("Potion")
	end
	return Enum.ContextActionResult.Sink
end

function Abilities.SetCooldown(slot: string, duration: number)
	Abilities.CooldownEnds[slot] = os.clock() + duration
	Abilities.CooldownLength[slot] = duration
end

function Abilities.Press(slot: string)
	if slot == "Q" then
		tryDash()
	elseif slot == "E" or slot == "R" then
		local _, skill = Abilities.SkillFor(slot)
		if skill and skill.Charge then
			beginCharge(slot)
			task.delay(skill.Charge, releaseCharge, slot)
		else
			castInstant(slot)
		end
	elseif slot == "C" then
		request("Overdrive")
	elseif slot == "LMB" then
		tryAttack()
	end
end

function Abilities.Init(abilityRemote: RemoteEvent, requestFn)
	remote = abilityRemote
	request = requestFn
	ContextActionService:BindAction("AnimeAttack", onAttack, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:BindAction("AnimeDash", onDash, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("AnimeSkill", skillHandler("E"), true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	ContextActionService:BindAction("AnimeUltimate", skillHandler("R"), true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
	ContextActionService:BindAction("AnimeOverdrive", onOverdrive, true, Enum.KeyCode.C, Enum.KeyCode.ButtonL1)
	ContextActionService:BindAction("AnimePotion", onPotion, false, Enum.KeyCode.H)
	ContextActionService:SetTitle("AnimeAttack", "Attack")
	ContextActionService:SetTitle("AnimeDash", "Dash")
	ContextActionService:SetTitle("AnimeSkill", "Skill")
	ContextActionService:SetTitle("AnimeUltimate", "Ult")
	ContextActionService:SetTitle("AnimeOverdrive", "OD")
	for i, name in ipairs({ "AnimeAttack", "AnimeDash", "AnimeSkill", "AnimeUltimate", "AnimeOverdrive" }) do
		local positions = { UDim2.new(1, -95, 1, -170), UDim2.new(1, -170, 1, -95), UDim2.new(1, -175, 1, -175), UDim2.new(1, -250, 1, -110), UDim2.new(1, -100, 1, -250) }
		ContextActionService:SetPosition(name, positions[i])
	end

	player.CharacterAdded:Connect(function(c)
		attackHeld = false
		charging = nil
		task.spawn(loadTracks, c)
	end)
	if player.Character then
		task.spawn(loadTracks, player.Character)
	end
	player:GetAttributeChangedSignal("WeaponId"):Connect(Abilities.RefreshHold)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Drops</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Drops (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Drops
-- Client-rendered ore drops: pop out of the enemy, bob and glow (loot beams
-- for Epic+), magnet into the player when close, server-validated pickup.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local Drops = {}
Drops.OnPickup = nil :: ((string, Vector3) -> ())?

local items = {}
local request: (string, any?) -> () = function() end

local function makeGem(ore)
	local order = ore.Order
	local size = 0.8 + order * 0.12
	local gem = VFX.FxPart({ Size = Vector3.one * size, Color = ore.Color, Transparency = 0 })
	gem.Name = "OreDrop"
	gem.Material = Enum.Material.Neon
	local l = Instance.new("PointLight")
	l.Color = ore.Color
	l.Range = 6 + order * 1.5
	l.Brightness = 1.2
	l.Parent = gem
	if order >= 3 then
		VFX.MakeEmitter("Stars", ore.Color, gem, 2 + order)
	end
	local beamHolder = nil
	if order >= 4 then
		beamHolder = VFX.FxPart({ Size = Vector3.one * 0.1, Transparency = 1 })
		local a0 = Instance.new("Attachment")
		a0.Parent = beamHolder
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, 10 + order * 3, 0)
		a1.Parent = beamHolder
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.Width0 = 1.4 + order * 0.2
		b.Width1 = 0.2
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = 3
		b.Color = ColorSequence.new(Color3.new(1, 1, 1), ore.Color)
		b.Transparency = VFX.NS(0, 0.2, 1, 1)
		b.Parent = beamHolder
		if order >= 5 then
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(180, 30)
			bb.StudsOffset = Vector3.new(0, 2.4, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 80
			bb.LightInfluence = 0
			bb.Adornee = gem
			bb.Parent = gem
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Enum.Font.LuckiestGuy
			t.TextScaled = true
			t.Text = ore.Name
			t.TextColor3 = ore.Color
			t.Parent = bb
			local st = Instance.new("UIStroke")
			st.Thickness = 2
			st.Parent = t
		end
	end
	return gem, beamHolder
end

function Drops.Init(requestFn)
	request = requestFn
end

-- payload = {Id?, Ore, Pos, Auto?}
function Drops.Spawn(payload)
	local ore = Config.OreById[payload.Ore]
	if not ore then
		return
	end
	local gem, beamHolder = makeGem(ore)
	local from = payload.Pos + Vector3.new(0, 2.5, 0)
	local ang = math.random() * math.pi * 2
	local land = Vector3.new(payload.Pos.X + math.cos(ang) * 2.5, payload.Pos.Y, payload.Pos.Z + math.sin(ang) * 2.5)
	gem.CFrame = CFrame.new(from)
	if beamHolder then
		beamHolder.CFrame = CFrame.new(land)
	end
	local item = {
		Gem = gem,
		Beam = beamHolder,
		Ore = ore,
		Id = payload.Id,
		State = "Pop",
		T = 0,
		From = from,
		Land = land,
		NextTry = 0,
		Expire = os.clock() + Config.DropLifetime,
		Auto = payload.Auto,
		Spin = math.random() * 6,
	}
	if ore.Order >= 4 then
		VFX.Flash(from, ore.Color, 5, 0.3)
		SFX.Play("RarePickup", { At = from, Volume = 0.5, Pitch = 0.8 })
	end
	table.insert(items, item)
end

local function find(id)
	for _, it in ipairs(items) do
		if it.Id == id then
			return it
		end
	end
	return nil
end

function Drops.Collected(id)
	local it = find(id)
	if it then
		it.State = "Fly"
		it.T = 0
		it.FlyFrom = it.Gem.Position
	end
end

function Drops.Fail(id, full: boolean?)
	local it = find(id)
	if it then
		it.State = "Idle"
		it.NextTry = os.clock() + (full and 3 or 1.5)
	end
end

local function destroy(it)
	it.Gem:Destroy()
	if it.Beam then
		it.Beam:Destroy()
	end
end

function Drops.Step(dt: number, root: BasePart?)
	local t = os.clock()
	for i = #items, 1, -1 do
		local it = items[i]
		it.T += dt
		it.Spin += dt * 2.5
		local remove = false
		if it.State == "Pop" then
			local a = math.min(1, it.T / 0.45)
			local pos = it.From:Lerp(it.Land, a) + Vector3.new(0, math.sin(a * math.pi) * 4, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(it.Spin, it.Spin * 0.7, 0)
			if a >= 1 then
				it.State = it.Auto and "Fly" or "Idle"
				it.T = 0
				it.FlyFrom = it.Gem.Position
				VFX.Emit(it.Land, "Sparks", 6, it.Ore.Color)
			end
		elseif it.State == "Idle" or it.State == "Pending" then
			local pos = it.Land + Vector3.new(0, 0.9 + math.sin(t * 3 + it.Spin) * 0.35, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(0.6, it.Spin, 0.6)
			if it.Beam then
				it.Beam.CFrame = CFrame.new(it.Land)
			end
			if it.State == "Idle" and root and it.Id and t >= it.NextTry and (root.Position - pos).Magnitude <= Config.PickupRadius then
				it.State = "Pending"
				it.NextTry = t + 1.5
				request("Collect", it.Id)
			elseif it.State == "Pending" and t >= it.NextTry then
				it.State = "Idle"
			end
			if t > it.Expire then
				remove = true
			end
		elseif it.State == "Fly" then
			if it.Beam then
				it.Beam:Destroy()
				it.Beam = nil
			end
			local target = root and root.Position or it.FlyFrom
			local a = math.min(1, it.T / 0.28)
			local ease = a * a
			local pos = it.FlyFrom:Lerp(target, ease) + Vector3.new(0, math.sin(a * math.pi) * 2.5, 0)
			it.Gem.CFrame = CFrame.new(pos) * CFrame.Angles(it.Spin * 3, it.Spin * 3, 0)
			it.Gem.Size = Vector3.one * math.max(0.2, (0.8 + it.Ore.Order * 0.12) * (1 - a * 0.6))
			if a >= 1 then
				remove = true
				VFX.Emit(target, "Stars", 4 + it.Ore.Order, it.Ore.Color)
				if it.Ore.Order >= 4 then
					SFX.Play("RarePickup", { Pitch = 0.9 + it.Ore.Order * 0.05 })
				else
					SFX.Play("OrePickup", { Pitch = 0.85 + it.Ore.Order * 0.12 })
				end
				if Drops.OnPickup then
					Drops.OnPickup(it.Ore.Id, target)
				end
			end
		end
		if remove then
			destroy(it)
			table.remove(items, i)
		end
	end
end

function Drops.ClearAll()
	for _, it in ipairs(items) do
		destroy(it)
	end
	table.clear(items)
end

return Drops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hud (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/Hud
-- Ability hotbar (LMB / Q / E / R / C) with cooldown sweeps and key labels
-- that follow the input device, HP + stamina bars, play-time reward timer,
-- daily streak and the 2x damage boost timer.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))

local Hud = {}

local player = Players.LocalPlayer
local UI, Abilities
local H
local slots = {}
local hpFill, hpText, stFill, stText, stBar
local ptTitle, ptTimer, ptFill, ptStreak, boostLabel
local C = UITheme.Colors

local SLOTS = {
	{ Slot = "LMB", Name = "Attack", Keys = { Keyboard = "LMB", Gamepad = "RT", Touch = "" }, Color = Color3.fromRGB(230, 230, 240) },
	{ Slot = "Q", Name = "Dash", Keys = { Keyboard = "Q", Gamepad = "B", Touch = "" }, Color = Color3.fromRGB(120, 200, 255) },
	{ Slot = "E", Name = "Skill", Keys = { Keyboard = "E", Gamepad = "X", Touch = "" }, Color = Color3.fromRGB(255, 190, 90) },
	{ Slot = "R", Name = "Ultimate", Keys = { Keyboard = "R", Gamepad = "Y", Touch = "" }, Color = Color3.fromRGB(255, 90, 120) },
	{ Slot = "C", Name = "Overdrive", Keys = { Keyboard = "C", Gamepad = "LB", Touch = "" }, Color = Color3.fromRGB(255, 140, 60) },
}

local function device(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	end
	return "Keyboard"
end

local function refreshKeys()
	local d = device()
	for _, s in ipairs(slots) do
		s.Key.Text = s.Def.Keys[d] or ""
		s.Key.Visible = s.Key.Text ~= ""
	end
end

function Hud.RefreshSkillNames()
	for _, s in ipairs(slots) do
		if s.Def.Slot == "E" or s.Def.Slot == "R" then
			local _, skill = Abilities.SkillFor(s.Def.Slot)
			s.Name.Text = skill and skill.Name or s.Def.Name
			s.Cost.Text = skill and (math.floor(skill.Stamina * Config.Balance.StaminaCostMult) .. " ST") or ""
		elseif s.Def.Slot == "Q" then
			s.Cost.Text = math.floor(Config.Balance.DashStamina * Config.Balance.StaminaCostMult) .. " ST"
		elseif s.Def.Slot == "LMB" then
			local def = Config.WeaponById[player:GetAttribute("WeaponId") or Config.StarterWeapon]
			s.Name.Text = def and def.Name or "Attack"
		end
	end
end

function Hud.FlashStamina()
	if stBar then
		stBar.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
		H.Tween(stBar, 0.4, { BackgroundColor3 = Color3.fromRGB(20, 16, 30) })
	end
end

function Hud.Tick()
	local t = os.clock()
	for _, s in ipairs(slots) do
		local slot = s.Def.Slot
		local ends = Abilities.CooldownEnds[slot] or 0
		local len = math.max(0.01, Abilities.CooldownLength[slot] or 1)
		local left = ends - t
		if slot == "C" and UI.Data then
			left = (UI.Data.OverdriveEnd or 0) - workspace:GetServerTimeNow()
			len = 180
		end
		if left > 0 then
			s.Shade.Size = UDim2.fromScale(1, math.clamp(left / len, 0, 1))
			s.Timer.Text = left >= 10 and tostring(math.floor(left)) or string.format("%.1f", left)
			s.Timer.Visible = slot ~= "LMB"
		else
			s.Shade.Size = UDim2.fromScale(1, 0)
			s.Timer.Visible = false
		end
	end
	-- HP / stamina
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.MaxHealth > 0 then
		local f = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		hpFill.Size = UDim2.fromScale(f, 1)
		hpText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
	end
	local st = player:GetAttribute("Stamina") or Config.Balance.MaxStamina
	stFill.Size = UDim2.fromScale(math.clamp(st / Config.Balance.MaxStamina, 0, 1), 1)
	stText.Text = "Stamina " .. math.floor(st)

	-- play-time ladder
	local session = player:GetAttribute("SessionTime") or 0
	local nextReward = nil
	local prevMinutes = 0
	for _, r in ipairs(Config.PlaytimeRewards) do
		if session < r.Minutes * 60 then
			nextReward = r
			break
		end
		prevMinutes = r.Minutes
	end
	if nextReward then
		local remaining = nextReward.Minutes * 60 - session
		ptTitle.Text = "Next: " .. nextReward.Name
		ptTimer.Text = Format.Time(remaining)
		ptFill.Size = UDim2.fromScale(math.clamp((session - prevMinutes * 60) / ((nextReward.Minutes - prevMinutes) * 60), 0, 1), 1)
	else
		ptTitle.Text = "All play-time rewards claimed!"
		ptTimer.Text = Format.Time(session)
		ptFill.Size = UDim2.fromScale(1, 1)
	end
	local d = UI.Data
	if d then
		local bonus = math.min(d.Streak * Config.Daily.CoinBonusPerDay, Config.Daily.MaxCoinBonus)
		ptStreak.Text = string.format("Day %d streak  (+%d%% Coins)", d.Streak, math.floor(bonus * 100 + 0.5))
		local boostLeft = (d.BoostEnds or 0) - workspace:GetServerTimeNow()
		boostLabel.Visible = boostLeft > 0
		if boostLeft > 0 then
			boostLabel.Text = "2x DAMAGE  " .. Format.Time(boostLeft)
		end
	end
end

local function buildSlot(parent, def, order: number)
	local f = H.Frame(parent, { Color = Color3.fromRGB(20, 16, 34), Transparency = 0.1, Size = UDim2.fromOffset(88, 88), Order = order, Corner = 14, Stroke = 3 })
	local stroke = f:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = def.Color
	end
	UITheme.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(150, 140, 190), 90)
	local key = UITheme.Label(f, { Text = "", Title = true, Size = UDim2.fromOffset(40, 22), Position = UDim2.fromOffset(4, 2), XAlign = Enum.TextXAlignment.Left, Color = def.Color, MaxText = 18 })
	local name = UITheme.Label(f, { Text = def.Name, Size = UDim2.new(1, -8, 0, 28), Position = UDim2.new(0, 4, 0.5, -10), MaxText = 15 })
	name.TextWrapped = true
	local cost = UITheme.Label(f, { Text = "", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 1, -20), Color = Color3.fromRGB(120, 220, 255), MaxText = 13, StrokeThickness = 1 })
	local shade = H.Frame(f, { Color = Color3.new(0, 0, 0), Transparency = 0.35, Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), Corner = 14, ZIndex = 3 })
	local timer = UITheme.Label(f, { Text = "", Title = true, Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, 0.25), ZIndex = 4, MaxText = 34 })
	timer.Visible = false
	-- tap / click the slot to use it (handy on touch screens)
	local btn = Instance.new("TextButton")
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Size = UDim2.fromScale(1, 1)
	btn.ZIndex = 5
	btn.Parent = f
	btn.Activated:Connect(function()
		Abilities.Press(def.Slot)
	end)
	table.insert(slots, { Def = def, Frame = f, Key = key, Name = name, Cost = cost, Shade = shade, Timer = timer })
end

function Hud.Init(ui, abilities)
	UI, Abilities = ui, abilities
	H = UI.Helpers
	local root = UI.Root()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)

	-- hotbar + bars (bottom centre)
	local bottom = H.Frame(root, { Transparency = 1, Size = UDim2.fromOffset(540, 160), Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1) })
	bottom.Name = "Hotbar"
	local bars = H.Frame(bottom, { Transparency = 1, Size = UDim2.new(1, 0, 0, 58) })
	local hpBar = H.Frame(bars, { Color = Color3.fromRGB(20, 16, 30), Size = UDim2.new(1, 0, 0, 26), Corner = 13, Stroke = 2 })
	hpFill = H.Frame(hpBar, { Color = Color3.fromRGB(90, 230, 110), Size = UDim2.fromScale(1, 1), Corner = 13 })
	UITheme.Gradient(hpFill, Color3.new(1, 1, 1), Color3.fromRGB(140, 180, 140), 90)
	hpText = UITheme.Label(hpBar, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 17 })
	stBar = H.Frame(bars, { Color = Color3.fromRGB(20, 16, 30), Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 32), Corner = 11, Stroke = 2 })
	stFill = H.Frame(stBar, { Color = Color3.fromRGB(80, 190, 255), Size = UDim2.fromScale(1, 1), Corner = 11 })
	UITheme.Gradient(stFill, Color3.new(1, 1, 1), Color3.fromRGB(120, 150, 200), 90)
	stText = UITheme.Label(stBar, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 15 })

	local row = H.Frame(bottom, { Transparency = 1, Size = UDim2.new(1, 0, 0, 92), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1) })
	H.List(row, 10, true)
	for i, def in ipairs(SLOTS) do
		buildSlot(row, def, i)
	end

	-- play-time widget (bottom left)
	local pt = H.Frame(root, { Color = Color3.fromRGB(18, 14, 32), Transparency = 0.1, Size = UDim2.fromOffset(310, 104), Position = UDim2.new(0, 14, 1, -14), AnchorPoint = Vector2.new(0, 1), Corner = 14, Stroke = 2 })
	pt.Name = "Playtime"
	UITheme.Label(pt, { Text = "PLAY-TIME REWARDS", Title = true, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 6), XAlign = Enum.TextXAlignment.Left, Color = C.Gold, MaxText = 18 })
	ptTimer = UITheme.Label(pt, { Text = "0:00", Title = true, Size = UDim2.fromOffset(80, 22), Position = UDim2.new(1, -10, 0, 6), AnchorPoint = Vector2.new(1, 0), XAlign = Enum.TextXAlignment.Right, MaxText = 20 })
	ptTitle = UITheme.Label(pt, { Text = "", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 30), XAlign = Enum.TextXAlignment.Left, MaxText = 15 })
	local ptBar = H.Frame(pt, { Color = Color3.fromRGB(35, 28, 55), Size = UDim2.new(1, -20, 0, 12), Position = UDim2.fromOffset(10, 54), Corner = 6 })
	ptFill = H.Frame(ptBar, { Color = C.Gold, Size = UDim2.fromScale(0, 1), Corner = 6 })
	ptStreak = UITheme.Label(pt, { Text = "", Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 74), XAlign = Enum.TextXAlignment.Left, Color = Color3.fromRGB(150, 230, 255), MaxText = 14 })
	local open = Instance.new("TextButton")
	open.BackgroundTransparency = 1
	open.Text = ""
	open.Size = UDim2.fromScale(1, 1)
	open.Parent = pt
	open.Activated:Connect(function()
		UI.Toggle("Rewards")
	end)

	boostLabel = UITheme.Label(root, { Text = "", Title = true, Size = UDim2.fromOffset(320, 30), Position = UDim2.new(0.5, 0, 1, -182), AnchorPoint = Vector2.new(0.5, 1), Color = Color3.fromRGB(255, 120, 90), MaxText = 24, StrokeThickness = 3 })
	boostLabel.Visible = false

	refreshKeys()
	UserInputService.LastInputTypeChanged:Connect(refreshKeys)
	player:GetAttributeChangedSignal("WeaponId"):Connect(Hud.RefreshSkillNames)
	Hud.RefreshSkillNames()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PromptUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- PromptUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/PromptUI
-- Custom ProximityPrompt UI (prompts use Style = Custom so Roblox draws
-- nothing). Each prompt gets an AlwaysOnTop BillboardGui with a CanvasGroup
-- that fades in on PromptShown and out on PromptHidden. The key cap follows
-- the player's current input device (keyboard / controller / touch), touch
-- users can tap the cap, and Triggered fires a RemoteEvent to the server.

local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local UITheme = require(Shared:WaitForChild("UITheme"))
local SFX = require(Shared:WaitForChild("SFX"))

local PromptUI = {}

local player = Players.LocalPlayer
local shown = {} -- [prompt] = { Gui, Group, Key, Fill, Button }

local GAMEPAD_NAMES = {
	ButtonA = "A",
	ButtonB = "B",
	ButtonX = "X",
	ButtonY = "Y",
	ButtonL1 = "LB",
	ButtonR1 = "RB",
	ButtonL2 = "LT",
	ButtonR2 = "RT",
	DPadUp = "D-Up",
	DPadDown = "D-Down",
	DPadLeft = "D-Left",
	DPadRight = "D-Right",
}

local function deviceType(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	end
	if last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Touch"
	end
	return "Keyboard"
end
PromptUI.DeviceType = deviceType

local function keyText(prompt: ProximityPrompt, device: string): string
	if device == "Touch" then
		return "TAP"
	elseif device == "Gamepad" then
		return GAMEPAD_NAMES[prompt.GamepadKeyCode.Name] or prompt.GamepadKeyCode.Name
	end
	local k = prompt.KeyboardKeyCode
	local s = UserInputService:GetStringForKeyCode(k)
	return (s ~= nil and s ~= "") and s:upper() or k.Name
end

local function adorneeFor(prompt: ProximityPrompt): Instance?
	local parent = prompt.Parent
	if parent and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
		return parent
	end
	if parent and parent:IsA("Model") then
		return parent.PrimaryPart
	end
	return nil
end

local function build(prompt: ProximityPrompt)
	local bb = Instance.new("BillboardGui")
	bb.Name = "CustomPrompt"
	bb.AlwaysOnTop = true
	bb.Active = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(300, 78)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.Adornee = adorneeFor(prompt)
	bb.ResetOnSpawn = false
	bb.Parent = player:WaitForChild("PlayerGui")

	local group = Instance.new("CanvasGroup")
	group.Size = UDim2.fromScale(1, 1)
	group.BackgroundTransparency = 1
	group.GroupTransparency = 1
	group.Parent = bb
	local scale = Instance.new("UIScale")
	scale.Scale = 0.8
	scale.Parent = group

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(1, -8, 1, -8)
	panel.BackgroundColor3 = Color3.fromRGB(18, 14, 32)
	panel.BackgroundTransparency = 0.15
	panel.Parent = group
	UITheme.Corner(panel, 16)
	UITheme.Stroke(panel, 2.5, Color3.fromRGB(190, 150, 255), true)
	UITheme.Gradient(panel, Color3.new(1, 1, 1), Color3.fromRGB(160, 150, 200), 90)

	local key = Instance.new("TextButton")
	key.Name = "Key"
	key.AutoButtonColor = false
	key.Size = UDim2.fromOffset(56, 56)
	key.Position = UDim2.fromOffset(8, 7)
	key.BackgroundColor3 = Color3.fromRGB(245, 240, 255)
	key.Font = UITheme.TitleFont
	key.TextScaled = true
	key.TextColor3 = Color3.fromRGB(30, 20, 50)
	key.Text = ""
	key.Parent = panel
	UITheme.Corner(key, 12)
	UITheme.Stroke(key, 3, Color3.fromRGB(30, 20, 50), true)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = key

	local fill = Instance.new("Frame")
	fill.Name = "Hold"
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.new(0, 8, 1, -4)
	fill.Size = UDim2.fromOffset(0, 4)
	fill.BackgroundColor3 = Color3.fromRGB(255, 210, 90)
	fill.BorderSizePixel = 0
	fill.Parent = panel

	UITheme.Label(panel, { Text = prompt.ActionText, Title = true, Size = UDim2.new(1, -80, 0, 32), Position = UDim2.fromOffset(74, 6), XAlign = Enum.TextXAlignment.Left, MaxText = 28 })
	UITheme.Label(panel, { Text = prompt.ObjectText, Size = UDim2.new(1, -80, 0, 22), Position = UDim2.fromOffset(74, 40), XAlign = Enum.TextXAlignment.Left, Color = Color3.fromRGB(200, 190, 230), MaxText = 18 })

	-- touch: tap the key cap to trigger
	key.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	key.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)

	local entry = { Gui = bb, Group = group, Scale = scale, Key = key, Fill = fill, Panel = panel }
	return entry
end

local function refreshKey(prompt: ProximityPrompt, entry)
	local device = deviceType()
	entry.Key.Text = keyText(prompt, device)
end

local function show(prompt: ProximityPrompt)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		return
	end
	local entry = shown[prompt]
	if entry and entry.Hiding then
		entry.Gui:Destroy()
		entry = nil
	end
	if not entry then
		entry = build(prompt)
		shown[prompt] = entry
	end
	refreshKey(prompt, entry)
	TweenService:Create(entry.Group, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
	TweenService:Create(entry.Scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	SFX.Play("PromptShow")
end

local function hide(prompt: ProximityPrompt)
	local entry = shown[prompt]
	if not entry then
		return
	end
	entry.Hiding = true
	local tw = TweenService:Create(entry.Group, TweenInfo.new(0.18), { GroupTransparency = 1 })
	TweenService:Create(entry.Scale, TweenInfo.new(0.18), { Scale = 0.85 }):Play()
	tw:Play()
	tw.Completed:Once(function()
		if shown[prompt] == entry and entry.Hiding then
			shown[prompt] = nil
			entry.Gui:Destroy()
		end
	end)
end

function PromptUI.Init(interactRemote: RemoteEvent)
	ProximityPromptService.PromptShown:Connect(function(prompt)
		show(prompt)
	end)
	ProximityPromptService.PromptHidden:Connect(hide)

	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		local entry = shown[prompt]
		if entry and prompt.HoldDuration > 0 then
			entry.Fill.Size = UDim2.fromOffset(0, 4)
			TweenService:Create(entry.Fill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.new(1, -16, 0, 4) }):Play()
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		local entry = shown[prompt]
		if entry then
			TweenService:Create(entry.Fill, TweenInfo.new(0.15), { Size = UDim2.fromOffset(0, 4) }):Play()
		end
	end)

	-- Triggered -> server-authoritative interaction
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom or prompt:GetAttribute("Action") == nil then
			return
		end
		SFX.Play("PromptTrigger")
		local entry = shown[prompt]
		if entry then
			entry.Scale.Scale = 0.9
			TweenService:Create(entry.Scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		interactRemote:FireServer(prompt)
	end)

	-- keep key caps in sync with the device the player is using
	UserInputService.LastInputTypeChanged:Connect(function()
		for prompt, entry in pairs(shown) do
			refreshKey(prompt, entry)
		end
	end)
end

return PromptUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- UI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/UI
-- HUD, menus, race roll, notifications. Styled through UITheme (UIPackPlus).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local SFX = require(Shared:WaitForChild("SFX"))
local VFX = require(Shared:WaitForChild("VFX"))

local player = Players.LocalPlayer
local C = UITheme.Colors

local UI = {}
UI.Data = nil
UI.ApplySettings = nil :: ((any) -> ())?
local request: (string, any?) -> () = function() end

local screen: ScreenGui
local root: Frame
local uiScale: UIScale
local flyGui: ScreenGui
local pills = {}
local panels = {}
local current = nil
local dim: Frame
local toastHolder: Frame
local padLabel: TextLabel
local zoneBanner: Frame
local towerHud: Frame
local overdriveBtn: GuiButton
local overdriveBar: Frame
local overdriveCount: TextLabel
local overdriveTimer: TextLabel
local numberValues = {}

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.Color or C.Bg
	f.BackgroundTransparency = props.Transparency or 0
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.fromScale(1, 1)
	f.Position = props.Position or UDim2.new()
	f.AnchorPoint = props.AnchorPoint or Vector2.zero
	f.LayoutOrder = props.Order or 0
	f.ZIndex = props.ZIndex or 1
	f.Name = props.Name or "Frame"
	f.Parent = parent
	if props.Corner then
		UITheme.Corner(f, props.Corner)
	end
	if props.Stroke then
		UITheme.Stroke(f, props.Stroke, nil, true)
	end
	return f
end

local function list(parent, padding, horizontal, align)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 8)
	l.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = align or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

local function scroller(parent, props)
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = props.Size or UDim2.fromScale(1, 1)
	s.Position = props.Position or UDim2.new()
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = Color3.fromRGB(200, 180, 255)
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = s
	return s
end

local function clearList(container: Instance)
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function hex(c: Color3): string
	return "#" .. c:ToHex()
end

-- Count-up animation for HUD numbers.
local function animateNumber(key: string, label: TextLabel, target: number, fmt: (number) -> string)
	local nv = numberValues[key]
	if not nv then
		nv = Instance.new("NumberValue")
		nv.Value = target
		numberValues[key] = nv
		nv.Changed:Connect(function(v)
			label.Text = fmt(v)
		end)
		label.Text = fmt(target)
		return
	end
	if math.abs(nv.Value - target) < 0.5 then
		nv.Value = target
		label.Text = fmt(target)
		return
	end
	tween(nv, 0.45, { Value = target }, Enum.EasingStyle.Quart)
end

---------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------
local function makePill(parent, key: string, role: string, color: Color3, order: number)
	local f
	local src = UITheme.Find("Bar")
	if src then
		f = Instance.new("ImageLabel")
		f.Image = src.Image
		f.ScaleType = src.ScaleType
		f.SliceCenter = src.SliceCenter
		f.SliceScale = src.SliceScale
		f.ImageRectOffset = src.ImageRectOffset
		f.ImageRectSize = src.ImageRectSize
		f.BackgroundTransparency = 1
	else
		f = frame(parent, { Color = Color3.fromRGB(20, 16, 34), Transparency = 0.15, Corner = 24, Stroke = 3 })
		UITheme.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(150, 140, 180), 90)
		local accent = frame(f, { Color = color, Size = UDim2.new(0, 46, 1, -8), Position = UDim2.fromOffset(4, 4), Corner = 20, Transparency = 0.25 })
		accent.Name = "Accent"
	end
	f.Name = key
	f.Size = UDim2.fromOffset(158, 50)
	f.LayoutOrder = order
	f.Parent = parent
	UITheme.Icon(f, role, UDim2.fromOffset(36, 36), UDim2.fromOffset(9, 7))
	local value = UITheme.Label(f, { Name = "Value", Text = "0", Title = true, Size = UDim2.new(1, -60, 0, 28), Position = UDim2.fromOffset(54, 3), XAlign = Enum.TextXAlignment.Left, MaxText = 26 })
	local sub = UITheme.Label(f, { Name = "Sub", Text = "", Size = UDim2.new(1, -60, 0, 16), Position = UDim2.fromOffset(54, 30), XAlign = Enum.TextXAlignment.Left, Color = color, MaxText = 15, StrokeThickness = 1.5 })
	local sc = Instance.new("UIScale")
	sc.Parent = f
	pills[key] = { Frame = f, Value = value, Sub = sub, Scale = sc, Color = color }
end

function UI.Bump(key: string)
	local p = pills[key]
	if not p then
		return
	end
	p.Scale.Scale = 1.18
	tween(p.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UI.PillScreenPos(key: string): Vector2?
	local p = pills[key]
	if not p then
		return nil
	end
	return p.Frame.AbsolutePosition + Vector2.new(27, p.Frame.AbsoluteSize.Y / 2)
end

-- Little icons that fly from a world position into a HUD pill.
function UI.FlyToHud(key: string, worldPos: Vector3?, color: Color3, count)
	local target = UI.PillScreenPos(key)
	local cam = workspace.CurrentCamera
	if not target or not cam then
		return
	end
	local start
	if worldPos then
		local v, onScreen = cam:WorldToViewportPoint(worldPos)
		if not onScreen then
			return
		end
		start = Vector2.new(v.X, v.Y)
	else
		start = cam.ViewportSize / 2
	end
	count = math.clamp(count or 5, 1, 10)
	for i = 1, count do
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Size = UDim2.fromOffset(18, 18)
		dot.BackgroundColor3 = color
		dot.BorderSizePixel = 0
		dot.Rotation = 45
		dot.Position = UDim2.fromOffset(start.X, start.Y)
		dot.ZIndex = 40
		dot.Parent = flyGui
		UITheme.Stroke(dot, 2, Color3.new(1, 1, 1), true)
		local burst = start + Vector2.new(math.random(-70, 70), math.random(-70, 30))
		local delay = (i - 1) * 0.035
		task.delay(delay, function()
			tween(dot, 0.22, { Position = UDim2.fromOffset(burst.X, burst.Y), Rotation = 225 }, Enum.EasingStyle.Quad)
			task.delay(0.24, function()
				tween(dot, 0.35, { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(10, 10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.35, function()
					dot:Destroy()
					UI.Bump(key)
				end)
			end)
		end)
	end
end

local function sideButton(parent, text: string, icon: string, color: string, order: number, onClick)
	return UITheme.Button(parent, {
		Name = text,
		Text = text,
		Icon = icon,
		Color = color,
		Size = UDim2.fromOffset(72, 72),
		Order = order,
		MaxText = 16,
		OnClick = onClick,
		Sound = "UIOpen",
	})
end

---------------------------------------------------------------------
-- NOTIFICATIONS
---------------------------------------------------------------------
function UI.Notify(text: string, color: Color3?)
	color = color or Color3.fromRGB(255, 255, 255)
	local toast = frame(toastHolder, { Color = Color3.fromRGB(18, 14, 30), Transparency = 0.1, Size = UDim2.fromOffset(380, 48), Corner = 12, Stroke = 2 })
	toast.Position = UDim2.fromOffset(420, 0)
	local bar = frame(toast, { Color = color, Size = UDim2.new(0, 6, 1, -12), Position = UDim2.fromOffset(6, 6), Corner = 3 })
	bar.Name = "Bar"
	UITheme.Label(toast, { Text = text, Size = UDim2.new(1, -28, 1, -10), Position = UDim2.fromOffset(20, 5), XAlign = Enum.TextXAlignment.Left, Color = color, MaxText = 20 })
	local holder = frame(toastHolder, { Transparency = 1, Size = UDim2.fromOffset(380, 48) })
	toast.Parent = holder
	tween(toast, 0.3, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	local kids = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 5 then
		kids[1]:Destroy()
	end
	task.delay(3.2, function()
		if toast.Parent then
			tween(toast, 0.3, { Position = UDim2.fromOffset(420, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(holder, 0.35)
		end
	end)
end

---------------------------------------------------------------------
-- PANEL FRAMEWORK
---------------------------------------------------------------------
local function makePanel(name: string, title: string, size: Vector2, accent: Color3)
	local panelFrame, content = UITheme.Panel(root, { Name = name, Size = UDim2.fromOffset(size.X, size.Y), ZIndex = 5 })
	panelFrame.Visible = false
	local sc = Instance.new("UIScale")
	sc.Parent = panelFrame

	local header = frame(panelFrame, { Color = accent, Size = UDim2.new(0.6, 0, 0, 54), Position = UDim2.new(0.5, 0, 0, -22), AnchorPoint = Vector2.new(0.5, 0), Corner = 16, Stroke = 4 })
	header.Name = "Header"
	UITheme.Gradient(header, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
	UITheme.Label(header, { Text = title, Title = true, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), MaxText = 34, StrokeThickness = 3 })

	UITheme.Button(panelFrame, {
		Name = "Close",
		Text = "X",
		Color = "Red",
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.new(1, 10, 0, -14),
		AnchorPoint = Vector2.new(1, 0),
		MaxText = 30,
		Sound = "UIClose",
		OnClick = function()
			UI.Close()
		end,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(0, 40)
	body.Size = UDim2.new(1, 0, 1, -40)
	body.Parent = content

	local panel = { Frame = panelFrame, Body = body, Scale = sc, Mode = nil, Sig = nil, Refresh = nil }
	panels[name] = panel
	return panel
end

-- Depth of field blur behind menus / shop / dialogue.
local dof: DepthOfFieldEffect? = nil
function UI.SetMenuFocus(on: boolean)
	local cfg = Config.Graphics.MenuDepthOfField
	if not dof then
		local d = Instance.new("DepthOfFieldEffect")
		d.Name = "MenuFocus"
		d.FarIntensity = 0
		d.NearIntensity = 0
		d.FocusDistance = cfg.FocusDistance
		d.InFocusRadius = cfg.InFocusRadius
		d.Parent = game:GetService("Lighting")
		dof = d
	end
	tween(dof, 0.3, { FarIntensity = on and cfg.FarIntensity or 0, NearIntensity = on and cfg.NearIntensity or 0 })
end

function UI.Open(name: string, mode: string?)
	local panel = panels[name]
	if not panel then
		return
	end
	if current and current ~= panel then
		current.Frame.Visible = false
	end
	panel.Mode = mode
	panel.Sig = nil
	current = panel
	panel.Frame.Visible = true
	panel.Scale.Scale = 0.6
	tween(panel.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	dim.Visible = true
	tween(dim, 0.25, { BackgroundTransparency = 0.55 })
	UI.SetMenuFocus(true)
	if panel.Refresh and UI.Data then
		panel.Refresh(UI.Data)
	end
end

function UI.Toggle(name: string, mode: string?)
	if current == panels[name] and current and current.Frame.Visible then
		UI.Close()
	else
		UI.Open(name, mode)
	end
end

function UI.Close()
	local panel = current
	current = nil
	if panel then
		local tw = tween(panel.Scale, 0.15, { Scale = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tw.Completed:Once(function()
			if current ~= panel then
				panel.Frame.Visible = false
			end
		end)
	end
	UI.SetMenuFocus(false)
	tween(dim, 0.2, { BackgroundTransparency = 1 }).Completed:Once(function()
		if not current then
			dim.Visible = false
		end
	end)
end

local function rowFrame(parent, height: number, order: number, color: Color3?)
	local f = frame(parent, { Color = color or Color3.fromRGB(34, 28, 56), Transparency = 0.1, Size = UDim2.new(1, 0, 0, height), Order = order, Corner = 12, Stroke = 2 })
	UITheme.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(190, 185, 210), 90)
	return f
end

---------------------------------------------------------------------
-- PANELS
---------------------------------------------------------------------
local function buildUpgrades()
	local p = makePanel("Upgrades", "UPGRADES", Vector2.new(640, 430), C.Blue)
	local holder = frame(p.Body, { Transparency = 1 })
	list(holder, 10)
	local rows = {}
	local order = { "Backpack", "Luck", "Training" }
	local icons = { Backpack = "Icon_Backpack", Luck = "Icon_Gem", Training = "Icon_Power" }
	for i, key in ipairs(order) do
		local cfg = Config.Upgrades[key]
		local r = rowFrame(holder, 104, i)
		UITheme.Icon(r, icons[key], UDim2.fromOffset(64, 64), UDim2.fromOffset(16, 20))
		UITheme.Label(r, { Text = cfg.Name, Title = true, Size = UDim2.new(0.45, 0, 0, 34), Position = UDim2.fromOffset(96, 10), XAlign = Enum.TextXAlignment.Left, MaxText = 30 })
		local lvl = UITheme.Label(r, { Text = "", Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.fromOffset(96, 44), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 20 })
		local val = UITheme.Label(r, { Text = "", Size = UDim2.new(0.45, 0, 0, 22), Position = UDim2.fromOffset(96, 70), XAlign = Enum.TextXAlignment.Left, Color = C.Green, MaxText = 18, Rich = true })
		local btn = UITheme.Button(r, {
			Text = "Buy",
			Color = "Gold",
			Size = UDim2.fromOffset(170, 64),
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Sound = "Purchase",
			OnClick = function()
				request("Upgrade", key)
			end,
		})
		rows[key] = { Level = lvl, Value = val, Button = btn }
	end
	p.Refresh = function(d)
		local extra = d.Passes and d.Passes.DoubleTraining
		for key, r in pairs(rows) do
			local lvl = d.Upgrades[key]
			local cost = d.UpgradeCosts[key]
			r.Level.Text = "Level " .. lvl .. " / " .. Config.Upgrades[key].Max
			if key == "Backpack" then
				r.Value.Text = string.format("Capacity: <b>%s</b> -> %s", Format.Abbrev(d.BackpackMax), Format.Abbrev(d.BackpackMax + 10))
			elseif key == "Luck" then
				r.Value.Text = string.format("Luck: <b>x%.2f</b> -> x%.2f", 1 + lvl * 0.05, 1 + (lvl + 1) * 0.05)
			else
				local per = extra and 20 or 10
				r.Value.Text = string.format("Power gain: <b>+%d%%</b> -> +%d%%", lvl * per, (lvl + 1) * per)
			end
			UITheme.SetButtonText(r.Button, cost and cost >= 0 and (Format.Abbrev(cost) .. " Coins") or "MAXED")
		end
	end
end

local function buildRace()
	local p = makePanel("Race", "RACE", Vector2.new(680, 470), C.Purple)
	local top = rowFrame(p.Body, 150, 0, Color3.fromRGB(40, 30, 70))
	local raceName = UITheme.Label(top, { Text = "???", Title = true, Size = UDim2.new(0.62, 0, 0, 52), Position = UDim2.fromOffset(18, 10), XAlign = Enum.TextXAlignment.Left, MaxText = 44, StrokeThickness = 3 })
	local tierName = UITheme.Label(top, { Text = "", Size = UDim2.new(0.62, 0, 0, 26), Position = UDim2.fromOffset(18, 62), XAlign = Enum.TextXAlignment.Left, MaxText = 22 })
	local desc = UITheme.Label(top, { Text = "", Size = UDim2.new(0.62, 0, 0, 52), Position = UDim2.fromOffset(18, 90), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 18 })
	desc.TextWrapped = true
	local rerolls = UITheme.Label(top, { Text = "", Size = UDim2.fromOffset(200, 26), Position = UDim2.new(1, -18, 0, 16), AnchorPoint = Vector2.new(1, 0), Color = C.Gold, MaxText = 22 })
	UITheme.Button(top, {
		Text = "ROLL RACE",
		Color = "Purple",
		Size = UDim2.fromOffset(200, 70),
		Position = UDim2.new(1, -18, 1, -14),
		AnchorPoint = Vector2.new(1, 1),
		MaxText = 26,
		OnClick = function()
			request("Reroll")
		end,
	})
	local odds = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -160), Position = UDim2.fromOffset(0, 160) })
	list(odds, 6)
	for i, race in ipairs(Config.Races) do
		local r = rowFrame(odds, 44, i)
		local sw = frame(r, { Color = race.Color, Size = UDim2.fromOffset(10, 30), Position = UDim2.fromOffset(10, 7), Corner = 4 })
		sw.Name = "Swatch"
		UITheme.Label(r, { Text = race.Name, Title = true, Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(28, 7), XAlign = Enum.TextXAlignment.Left, Color = race.Color, MaxText = 22 })
		UITheme.Label(r, { Text = Format.Percent(race.Weight), Size = UDim2.fromOffset(70, 30), Position = UDim2.fromOffset(196, 7), Color = C.Gold, MaxText = 20 })
		local d = UITheme.Label(r, { Text = race.Desc, Size = UDim2.new(1, -290, 1, -8), Position = UDim2.fromOffset(276, 4), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 14, StrokeThickness = 1 })
		d.TextWrapped = true
	end
	local tierRow = rowFrame(odds, 40, 99, Color3.fromRGB(30, 26, 44))
	local parts = {}
	for _, t in ipairs(Config.RaceTiers) do
		table.insert(parts, string.format('<font color="%s">%s %s</font>', hex(t.Color), t.Label or t.Id, Format.Percent(t.Weight)))
	end
	UITheme.Label(tierRow, { Text = "Skin tiers: " .. table.concat(parts, "  "), Rich = true, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), MaxText = 16 })
	p.Refresh = function(d)
		local race = Config.RaceById[d.Race]
		local tier = Config.RaceTierById[d.RaceTier]
		raceName.Text = race and race.Name or "Unrolled"
		raceName.TextColor3 = race and race.Color or C.Text
		tierName.Text = tier and ((tier.Label or tier.Id) .. " skin") or ""
		tierName.TextColor3 = tier and tier.Color or C.Sub
		desc.Text = race and race.Desc or "Roll to awaken your bloodline!"
		rerolls.Text = "Rerolls: " .. d.Rerolls
	end
end

local function buildBackpack()
	local p = makePanel("Backpack", "BACKPACK", Vector2.new(640, 470), C.Gold)
	local items = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -96) })
	list(items, 6)
	local footer = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 86), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1) })
	local capBg = frame(footer, { Color = Color3.fromRGB(20, 16, 30), Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Corner = 15, Stroke = 2 })
	local capFill = frame(capBg, { Color = C.Gold, Size = UDim2.fromScale(0, 1), Corner = 15 })
	UITheme.Gradient(capFill, Color3.new(1, 1, 1), Color3.fromRGB(200, 150, 60), 90)
	local capText = UITheme.Label(capBg, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 18 })
	local hint = UITheme.Label(footer, { Text = "", Size = UDim2.new(0.5, 0, 0, 34), Position = UDim2.fromOffset(0, 44), Color = C.Sub, MaxText = 15, XAlign = Enum.TextXAlignment.Left })
	hint.TextWrapped = true
	local actionBtn = UITheme.Button(footer, {
		Text = "SELL ALL",
		Color = "Gold",
		Size = UDim2.fromOffset(250, 76),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		MaxText = 28,
		OnClick = function()
			if p.Mode == "Sell" then
				request("Sell")
			else
				request("Forge")
			end
		end,
	})
	p.Refresh = function(d)
		local mode = p.Mode or "View"
		local sigParts = { mode, d.BackpackMax, math.floor(d.Derived.CoinMult * 100), math.floor(d.Derived.ForgeMult * 100) }
		for _, ore in ipairs(Config.Ores) do
			table.insert(sigParts, d.Backpack[ore.Id] or 0)
		end
		local sig = table.concat(sigParts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(items)
		local any = false
		for i, ore in ipairs(Config.Ores) do
			local count = d.Backpack[ore.Id] or 0
			if count > 0 then
				any = true
				local r = rowFrame(items, 62, i)
				local gem = frame(r, { Color = ore.Color, Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(16, 15), Stroke = 2 })
				gem.Rotation = 45
				UITheme.Label(r, { Text = ore.Name, Title = true, Size = UDim2.fromOffset(220, 28), Position = UDim2.fromOffset(62, 6), XAlign = Enum.TextXAlignment.Left, Color = ore.Color, MaxText = 22 })
				UITheme.Label(r, { Text = Config.Rarity[ore.Rarity].Label .. "  x" .. Format.Commas(count), Size = UDim2.fromOffset(220, 22), Position = UDim2.fromOffset(62, 34), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 16 })
				local valueText = mode == "Sell" and ("+" .. Format.Abbrev(ore.Sell * count * d.Derived.CoinMult) .. " Coins") or ("+" .. Format.Abbrev(ore.Forge * count * d.Derived.ForgeMult) .. " Blade")
				UITheme.Label(r, { Text = valueText, Size = UDim2.fromOffset(160, 30), Position = UDim2.new(1, -150, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Color = mode == "Sell" and C.Gold or Color3.fromRGB(255, 160, 80), MaxText = 20 })
				if mode ~= "View" then
					UITheme.Button(r, {
						Text = mode == "Sell" and "Sell" or "Forge",
						Color = mode == "Sell" and "Gold" or "Red",
						Size = UDim2.fromOffset(110, 46),
						Position = UDim2.new(1, -10, 0.5, 0),
						AnchorPoint = Vector2.new(1, 0.5),
						OnClick = function()
							request(mode == "Sell" and "Sell" or "Forge", ore.Id)
						end,
					})
				end
			end
		end
		if not any then
			local r = rowFrame(items, 60, 1)
			UITheme.Label(r, { Text = "Your backpack is empty. Slay monsters in the Dungeon to loot ore!", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Color = C.Sub, MaxText = 18 })
		end
		capFill.Size = UDim2.fromScale(math.clamp(d.BackpackCount / math.max(1, d.BackpackMax), 0, 1), 1)
		capText.Text = Format.Abbrev(d.BackpackCount) .. " / " .. Format.Abbrev(d.BackpackMax)
		actionBtn.Visible = mode ~= "View"
		UITheme.SetButtonText(actionBtn, mode == "Sell" and "SELL ALL" or "FORGE ALL")
		hint.Text = mode == "Sell" and "Tip: keep rare ore for the Forge!" or (mode == "Forge" and "Every ore forged = +Blade levels" or "Forge at the cauldron, sell at the stall.")
	end
end

local function buildIndex()
	local p = makePanel("Index", "ORE INDEX", Vector2.new(680, 470), Color3.fromRGB(80, 200, 255))
	local grid = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -40) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(148, 170)
	g.CellPadding = UDim2.fromOffset(10, 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = grid
	local footer = UITheme.Label(p.Body, { Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), Color = C.Gold, MaxText = 20 })
	p.Refresh = function(d)
		local sigParts = {}
		for _, ore in ipairs(Config.Ores) do
			table.insert(sigParts, d.Index[ore.Id] and "1" or "0")
		end
		local sig = table.concat(sigParts)
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		clearList(grid)
		local found = 0
		for i, ore in ipairs(Config.Ores) do
			local known = d.Index[ore.Id] == true
			if known then
				found += 1
			end
			local card = frame(grid, { Color = known and Color3.fromRGB(40, 32, 66) or Color3.fromRGB(22, 20, 30), Order = i, Corner = 14, Stroke = 3 })
			local st = card:FindFirstChildOfClass("UIStroke")
			if st and known then
				st.Color = ore.Color
			end
			local gem = frame(card, { Color = known and ore.Color or Color3.fromRGB(50, 50, 60), Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0.5, 0, 0, 40), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 2 })
			gem.Rotation = 45
			if known then
				local shine = frame(gem, { Color = Color3.new(1, 1, 1), Transparency = 0.5, Size = UDim2.fromScale(0.35, 0.35), Position = UDim2.fromScale(0.15, 0.15) })
				shine.Name = "Shine"
			end
			UITheme.Label(card, { Text = known and ore.Name or "???", Title = true, Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 78), Color = known and ore.Color or C.Sub, MaxText = 20 })
			UITheme.Label(card, { Text = Config.Rarity[ore.Rarity].Label, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 104), Color = C.Sub, MaxText = 15 })
			UITheme.Label(card, { Text = known and ("Forge +" .. ore.Forge .. " | Sell " .. ore.Sell) or ("Reward: " .. Format.Abbrev(Config.IndexReward[ore.Rarity]) .. " Coins"), Size = UDim2.new(1, -10, 0, 34), Position = UDim2.fromOffset(5, 128), Color = known and C.Text or C.Gold, MaxText = 14 })
		end
		footer.Text = string.format("Discovered %d / %d ores  -  new discoveries pay Coins!", found, #Config.Ores)
	end
end

local function buildShop()
	local p = makePanel("Shop", "SHOP", Vector2.new(720, 500), C.Green)
	local tabs = frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 0, 48) })
	list(tabs, 10, true)
	local pages = {}
	local function showTab(name)
		for n, page in pairs(pages) do
			page.Visible = n == name
		end
	end
	for i, name in ipairs({ "Passes", "Items", "Codes" }) do
		UITheme.Button(tabs, { Text = name, Color = i == 1 and "Green" or (i == 2 and "Blue" or "Purple"), Size = UDim2.fromOffset(150, 44), Order = i, OnClick = function()
			showTab(name)
		end })
		local page = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -56), Position = UDim2.fromOffset(0, 56) })
		page.Visible = i == 1
		pages[name] = page
	end
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(210, 150)
	g.CellPadding = UDim2.fromOffset(10, 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = pages.Passes
	local passButtons = {}
	for i, key in ipairs(Config.GamePassOrder) do
		local pass = Config.GamePasses[key]
		local card = frame(pages.Passes, { Color = Color3.fromRGB(36, 30, 60), Order = i, Corner = 14, Stroke = 3 })
		UITheme.Label(card, { Text = pass.Name, Title = true, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), Color = C.Gold, MaxText = 22 })
		local d = UITheme.Label(card, { Text = pass.Desc, Size = UDim2.new(1, -16, 0, 54), Position = UDim2.fromOffset(8, 38), Color = C.Sub, MaxText = 15, StrokeThickness = 1 })
		d.TextWrapped = true
		passButtons[key] = UITheme.Button(card, { Text = "Buy", Color = "Green", Size = UDim2.new(1, -24, 0, 44), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), OnClick = function()
			request("BuyPass", key)
		end })
	end
	local g2 = g:Clone()
	g2.Parent = pages.Items
	for i, key in ipairs(Config.ProductOrder) do
		local prod = Config.Products[key]
		local card = frame(pages.Items, { Color = Color3.fromRGB(30, 36, 64), Order = i, Corner = 14, Stroke = 3 })
		UITheme.Label(card, { Text = prod.Name, Title = true, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), Color = C.Blue, MaxText = 22 })
		local contents = {}
		if prod.Coins then
			table.insert(contents, Format.Abbrev(prod.Coins) .. " Coins" .. (prod.ScaleWithRebirth and " (x rebirths)" or ""))
		end
		if prod.Rerolls then
			table.insert(contents, prod.Rerolls .. " Race Rerolls")
		end
		if prod.Overdrive then
			table.insert(contents, prod.Overdrive .. " Overdrive")
		end
		local d = UITheme.Label(card, { Text = table.concat(contents, "\n"), Size = UDim2.new(1, -16, 0, 54), Position = UDim2.fromOffset(8, 38), Color = C.Sub, MaxText = 15, StrokeThickness = 1 })
		d.TextWrapped = true
		UITheme.Button(card, { Text = "Buy", Color = "Blue", Size = UDim2.new(1, -24, 0, 44), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), OnClick = function()
			request("BuyProduct", key)
		end })
	end
	-- codes
	local codeRow = rowFrame(pages.Codes, 140, 1)
	UITheme.Label(codeRow, { Text = "Enter a code for free rewards!", Title = true, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), MaxText = 26 })
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.62, 0, 0, 54)
	box.Position = UDim2.fromOffset(14, 62)
	box.BackgroundColor3 = Color3.fromRGB(16, 12, 26)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.PlaceholderText = "Type code here..."
	box.PlaceholderColor3 = C.Sub
	box.Font = UITheme.BodyFont
	box.TextScaled = true
	box.ClearTextOnFocus = false
	box.Text = ""
	box.Parent = codeRow
	UITheme.Corner(box, 10)
	UITheme.Stroke(box, 2, nil, true)
	UITheme.Button(codeRow, { Text = "REDEEM", Color = "Purple", Size = UDim2.new(0.33, -20, 0, 54), Position = UDim2.new(1, -14, 0, 62), AnchorPoint = Vector2.new(1, 0), OnClick = function()
		request("Redeem", box.Text)
		box.Text = ""
	end })
	list(pages.Codes, 8)
	p.Refresh = function(d)
		for key, btn in pairs(passButtons) do
			local owned = d.Passes[key] == true
			UITheme.SetButtonText(btn, owned and "OWNED" or "Buy")
		end
	end
end

local function buildTeleport()
	local p = makePanel("Teleport", "TELEPORT", Vector2.new(640, 470), Color3.fromRGB(80, 220, 255))
	UITheme.Label(p.Body, { Text = "Hub is free. Everything else needs the Fast Travel pass (or walk through the portals!).", Size = UDim2.new(1, 0, 0, 28), Color = C.Sub, MaxText = 16 })
	local grid = scroller(p.Body, { Size = UDim2.new(1, 0, 1, -36), Position = UDim2.fromOffset(0, 36) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(190, 64)
	g.CellPadding = UDim2.fromOffset(10, 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = Enum.HorizontalAlignment.Center
	g.Parent = grid
	p.Refresh = function(d)
		local unlockedCount = 0
		for _, stage in ipairs(Config.Stages) do
			local zone = Config.Zones[stage.Zone]
			if d.Power >= stage.PowerReq and d.Blade >= (zone.BladeReq or 0) then
				unlockedCount += 1
			end
		end
		if p.Sig == unlockedCount then
			return
		end
		p.Sig = unlockedCount
		clearList(grid)
		local function add(order, text, dest, color, locked)
			UITheme.Button(grid, { Text = locked and (text .. " [LOCKED]") or text, Color = locked and "Red" or color, Order = order, MaxText = 20, Sound = "Teleport", OnClick = function()
				request("Teleport", dest)
				UI.Close()
			end })
		end
		add(1, "Hub", "Hub", "Green")
		add(2, "Train Area", "Train", "Blue")
		add(3, "Tower", "Tower", "Purple")
		for i, stage in ipairs(Config.Stages) do
			local zone = Config.Zones[stage.Zone]
			local unlocked = d.Power >= stage.PowerReq and d.Blade >= (zone.BladeReq or 0)
			add(10 + i, "Stage " .. i .. (stage.Boss and " (Boss)" or ""), "Stage_" .. i, "Gold", not unlocked)
		end
	end
end

local function buildRebirth()
	local p = makePanel("Rebirth", "REBIRTH", Vector2.new(600, 440), C.Gold)
	local info = rowFrame(p.Body, 250, 0, Color3.fromRGB(44, 34, 30))
	local count = UITheme.Label(info, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 8), Color = C.Gold, MaxText = 36 })
	local barBg = frame(info, { Color = Color3.fromRGB(20, 16, 30), Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 60), Corner = 17, Stroke = 2 })
	local barFill = frame(barBg, { Color = C.Gold, Size = UDim2.fromScale(0, 1), Corner = 17 })
	UITheme.Gradient(barFill, Color3.new(1, 1, 1), Color3.fromRGB(220, 140, 40), 90)
	local barText = UITheme.Label(barBg, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 20 })
	local rewards = UITheme.Label(info, { Text = "", Rich = true, Size = UDim2.new(1, -30, 0, 140), Position = UDim2.fromOffset(15, 102), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
	rewards.TextWrapped = true
	UITheme.Button(p.Body, { Text = "REBIRTH", Color = "Gold", Size = UDim2.fromOffset(260, 70), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1), MaxText = 32, OnClick = function()
		request("Rebirth")
		UI.Close()
	end })
	p.Refresh = function(d)
		count.Text = "Rebirths: " .. Format.Abbrev(d.Rebirths)
		barFill.Size = UDim2.fromScale(math.clamp(d.Power / math.max(1, d.RebirthReq), 0, 1), 1)
		barText.Text = Format.Abbrev(d.Power) .. " / " .. Format.Abbrev(d.RebirthReq) .. " Power"
		rewards.Text = table.concat({
			'<font color="#78ff9c">+100% Power gain</font>, <font color="#ffd75a">+25% Coins</font>, <font color="#ff8a8a">+10% Damage</font> (permanent)',
			'<font color="#c8a0ff">+1 Race Reroll</font> and a stronger Ascension aura',
			'<font color="#ff7a7a">Resets Power and Coins.</font> Keeps Blade level, ore, race and runes.',
		}, "\n")
	end
end

local function buildSettings()
	local p = makePanel("Settings", "SETTINGS", Vector2.new(480, 330), Color3.fromRGB(150, 150, 170))
	local holder = frame(p.Body, { Transparency = 1 })
	list(holder, 12)
	local state = { Music = true, SFX = true }
	local buttons = {}
	local function apply()
		SFX.SetMusicVolume(state.Music and 0.45 or 0)
		SFX.SetSFXVolume(state.SFX and 0.9 or 0)
		for key, btn in pairs(buttons) do
			UITheme.SetButtonText(btn, key .. ": " .. (state[key] and "ON" or "OFF"))
		end
	end
	for i, key in ipairs({ "Music", "SFX" }) do
		buttons[key] = UITheme.Button(holder, { Text = key, Color = "Blue", Size = UDim2.fromOffset(320, 64), Order = i, OnClick = function()
			state[key] = not state[key]
			apply()
			request("Settings", state)
		end })
	end
	UITheme.Label(holder, { Text = Config.GameName, Title = true, Size = UDim2.fromOffset(320, 30), Order = 9, Color = C.Pink, MaxText = 22 })
	p.Refresh = function(d)
		if d.Settings then
			state.Music = d.Settings.Music ~= false
			state.SFX = d.Settings.SFX ~= false
		end
		apply()
	end
	UI.ApplySettings = function(d)
		p.Refresh(d)
	end
end

---------------------------------------------------------------------
-- RACE ROLL (slot machine)
---------------------------------------------------------------------
function UI.RaceRoll(raceId: string, tierId: string, initial: boolean?)
	local race = Config.RaceById[raceId]
	local tier = Config.RaceTierById[tierId]
	if not race or not tier then
		return
	end
	UI.Close()
	local overlay = frame(flyGui, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 60 })
	tween(overlay, 0.3, { BackgroundTransparency = 0.35 })
	local card = frame(overlay, { Color = Color3.fromRGB(26, 20, 44), Size = UDim2.fromOffset(520, 240), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 22, Stroke = 5, ZIndex = 61 })
	local sc = Instance.new("UIScale")
	sc.Scale = math.clamp(math.min(workspace.CurrentCamera.ViewportSize.X / 1400, workspace.CurrentCamera.ViewportSize.Y / 820), 0.55, 1.1)
	sc.Parent = card
	UITheme.Label(card, { Text = initial and "AWAKENING YOUR BLOODLINE..." or "ROLLING RACE...", Title = true, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 12), Color = C.Sub, ZIndex = 62, MaxText = 28 })
	local nameLabel = UITheme.Label(card, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 90), Position = UDim2.fromOffset(10, 64), ZIndex = 62, MaxText = 70, StrokeThickness = 4 })
	local tierLabel = UITheme.Label(card, { Text = "", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 160), ZIndex = 62, MaxText = 28 })
	local stroke = card:FindFirstChildOfClass("UIStroke")

	task.spawn(function()
		local steps = 26
		for i = 1, steps do
			local r = Config.Races[math.random(1, #Config.Races)]
			nameLabel.Text = r.Name
			nameLabel.TextColor3 = r.Color
			if stroke then
				stroke.Color = r.Color
			end
			SFX.Play("RaceTick", { Pitch = 0.8 + i / steps })
			task.wait(0.03 + (i / steps) ^ 3 * 0.22)
		end
		nameLabel.Text = race.Name
		nameLabel.TextColor3 = race.Color
		tierLabel.Text = (tier.Label or tier.Id) .. " skin"
		tierLabel.TextColor3 = tier.Color
		if stroke then
			stroke.Color = race.Color
		end
		local s2 = Instance.new("UIScale")
		s2.Scale = 1.5
		s2.Parent = nameLabel
		tween(s2, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		local legendary = race.Weight <= 7 or tier.Id == "Legendary" or tier.Id == "Mythic"
		if legendary then
			SFX.Play("RaceRevealLegend")
			VFX.ImpactFrame(race.Color, 1.3)
			VFX.TitleCard(race.Name:upper() .. "!", (tier.Label or tier.Id) .. " skin  -  " .. Format.Percent(race.Weight) .. " chance", race.Color, 2)
		else
			SFX.Play("RaceReveal")
			VFX.ScreenFlash(race.Color, 0.4, 0.4)
		end
		task.wait(legendary and 2.4 or 1.6)
		tween(overlay, 0.3, { BackgroundTransparency = 1 })
		tween(sc, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.3)
		overlay:Destroy()
		UI.Notify("You are a " .. (tier.Label or tier.Id) .. " " .. race.Name .. "!", race.Color)
	end)
end

---------------------------------------------------------------------
-- STATUS WIDGETS
---------------------------------------------------------------------
function UI.SetPad(mult: number?, locked: boolean?)
	if not mult then
		padLabel.Visible = false
		return
	end
	padLabel.Visible = true
	padLabel.Text = locked and ("x" .. Format.Abbrev(mult) .. " PAD LOCKED") or ("x" .. Format.Abbrev(mult) .. " TRAINING")
	padLabel.TextColor3 = locked and C.Red or C.Green
end

local bannerToken = 0
function UI.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	local t = zoneBanner:FindFirstChild("Title") :: TextLabel
	local s = zoneBanner:FindFirstChild("Sub") :: TextLabel
	t.Text = title
	t.TextColor3 = color or C.Text
	s.Text = sub or ""
	zoneBanner.Visible = true
	zoneBanner.Position = UDim2.new(0.5, 0, 0, 150)
	t.TextTransparency = 1
	s.TextTransparency = 1
	tween(t, 0.4, { TextTransparency = 0 })
	tween(s, 0.4, { TextTransparency = 0 })
	tween(zoneBanner, 0.5, { Position = UDim2.new(0.5, 0, 0, 170) }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if bannerToken == my then
			tween(t, 0.5, { TextTransparency = 1 })
			tween(s, 0.5, { TextTransparency = 1 })
		end
	end)
end

function UI.Tower(state: string?, floor: number?, endsAt: number?)
	if not state then
		towerHud.Visible = false
		return
	end
	towerHud.Visible = true
	towerHud:SetAttribute("EndsAt", endsAt or 0)
	towerHud:SetAttribute("Floor", floor or 1)
	local title = towerHud:FindFirstChild("Title") :: TextLabel
	title.Text = "TOWER FLOOR " .. tostring(floor or 1)
end

---------------------------------------------------------------------
-- UPDATE
---------------------------------------------------------------------
function UI.Update(d)
	local first = UI.Data == nil
	UI.Data = d
	local tier = Config.GetBladeTier(d.Blade)
	animateNumber("Power", pills.Power.Value, d.Power, Format.Abbrev)
	pills.Power.Sub.Text = "+" .. Format.Abbrev(d.Derived.PowerPerSwing) .. " / swing"
	animateNumber("Blade", pills.Blade.Value, d.Blade, function(v)
		return "+" .. Format.Abbrev(math.floor(v))
	end)
	pills.Blade.Sub.Text = tier.Name
	pills.Blade.Sub.TextColor3 = tier.Edge or C.Sub
	animateNumber("Coins", pills.Coins.Value, d.Coins, Format.Abbrev)
	pills.Coins.Sub.Text = "x" .. string.format("%.2f", d.Derived.CoinMult)
	pills.Backpack.Value.Text = Format.Abbrev(d.BackpackCount) .. "/" .. Format.Abbrev(d.BackpackMax)
	local full = d.BackpackCount >= d.BackpackMax
	pills.Backpack.Sub.Text = full and "FULL!" or "Ore"
	pills.Backpack.Sub.TextColor3 = full and C.Red or pills.Backpack.Color
	pills.Rebirths.Value.Text = Format.Abbrev(d.Rebirths)
	pills.Rebirths.Sub.Text = math.floor(math.clamp(d.Power / math.max(1, d.RebirthReq), 0, 1) * 100) .. "% to next"
	pills.Damage.Value.Text = Format.Abbrev(d.Derived.Damage)
	pills.Damage.Sub.Text = "Runes: " .. d.Runes

	overdriveCount.Text = "x" .. d.Overdrive
	if current and current.Refresh then
		current.Refresh(d)
	end
	if first and UI.ApplySettings then
		UI.ApplySettings(d)
	end
end

-- Called every frame by the client (timers).
function UI.Tick()
	local d = UI.Data
	local now = workspace:GetServerTimeNow()
	if d then
		local remaining = (d.OverdriveEnd or 0) - now
		if remaining > 0 then
			overdriveTimer.Visible = true
			overdriveTimer.Text = Format.Time(remaining)
			overdriveBar.Visible = true
		else
			overdriveTimer.Visible = false
			overdriveBar.Visible = false
		end
	end
	if towerHud.Visible then
		local endsAt = towerHud:GetAttribute("EndsAt") or 0
		local timer = towerHud:FindFirstChild("Timer") :: TextLabel
		local left = endsAt - now
		if endsAt > 0 and left > 0 then
			timer.Text = Format.Time(left)
			timer.TextColor3 = left < 8 and C.Red or C.Text
		else
			timer.Text = "--:--"
		end
	end
end

---------------------------------------------------------------------
-- INIT
---------------------------------------------------------------------
function UI.Init(requestFn)
	request = requestFn
	UITheme.Init()
	local pg = player:WaitForChild("PlayerGui")

	screen = Instance.new("ScreenGui")
	screen.Name = "GameUI"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = pg

	flyGui = Instance.new("ScreenGui")
	flyGui.Name = "GameUIFx"
	flyGui.ResetOnSpawn = false
	flyGui.IgnoreGuiInset = true
	flyGui.DisplayOrder = 40
	flyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	flyGui.Parent = pg

	root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Parent = screen
	uiScale = Instance.new("UIScale")
	uiScale.Parent = root
	local inset = GuiService:GetGuiInset()
	local function rescale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1400, 820)
		local s = math.clamp(math.min(vp.X / 1400, vp.Y / 820), 0.5, 1.15)
		uiScale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	dim = frame(root, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 4 })
	dim.Name = "Dim"
	dim.Visible = false
	dim.Size = UDim2.fromScale(3, 3)
	dim.Position = UDim2.fromScale(-1, -1)
	dim.Active = true
	dim.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			UI.Close()
		end
	end)

	-- top stat bar
	local top = frame(root, { Transparency = 1, Size = UDim2.new(1, -280, 0, 56), Position = UDim2.new(0.5, 0, 0, inset.Y + 8), AnchorPoint = Vector2.new(0.5, 0) })
	top.Name = "TopBar"
	list(top, 8, true)
	makePill(top, "Power", "Icon_Power", Color3.fromRGB(120, 255, 170), 1)
	makePill(top, "Blade", "Icon_Blade", Color3.fromRGB(255, 170, 80), 2)
	makePill(top, "Damage", "Icon_Rune", Color3.fromRGB(255, 110, 120), 3)
	makePill(top, "Coins", "Icon_Coins", C.Gold, 4)
	makePill(top, "Backpack", "Icon_Backpack", Color3.fromRGB(120, 200, 255), 5)
	makePill(top, "Rebirths", "Icon_Rebirth", Color3.fromRGB(210, 150, 255), 6)

	-- left menu
	local left = frame(root, { Transparency = 1, Size = UDim2.fromOffset(160, 480), Position = UDim2.new(0, 14, 0.5, -10), AnchorPoint = Vector2.new(0, 0.5) })
	left.Name = "LeftMenu"
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(72, 72)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = left
	sideButton(left, "Shop", "Icon_Shop", "Green", 1, function()
		UI.Toggle("Shop")
	end)
	sideButton(left, "Upgrade", "Icon_Upgrades", "Blue", 2, function()
		UI.Toggle("Upgrades")
	end)
	sideButton(left, "Race", "Icon_Race", "Purple", 3, function()
		UI.Toggle("Race")
	end)
	sideButton(left, "Index", "Icon_Index", "Blue", 4, function()
		UI.Toggle("Index")
	end)
	sideButton(left, "Bag", "Icon_Backpack", "Gold", 5, function()
		UI.Toggle("Backpack", "View")
	end)
	sideButton(left, "Travel", "Icon_Teleport", "Green", 6, function()
		UI.Toggle("Teleport")
	end)
	sideButton(left, "Rebirth", "Icon_Rebirth", "Gold", 7, function()
		UI.Toggle("Rebirth")
	end)
	sideButton(left, "Settings", "Icon_Settings", "Red", 12, function()
		UI.Toggle("Settings")
	end)
	sideButton(left, "Weapons", "Icon_Blade", "Purple", 0, function()
		UI.Toggle("Weapons")
	end)
	sideButton(left, "Chests", "Icon_Gem", "Gold", 8, function()
		UI.Toggle("Chests")
	end)
	sideButton(left, "Power", "Icon_Power", "Red", 9, function()
		UI.Toggle("Power")
	end)
	sideButton(left, "Rewards", "Icon_Tower", "Green", 10, function()
		UI.Toggle("Rewards")
	end)

	-- right side: hub + overdrive
	local right = frame(root, { Transparency = 1, Size = UDim2.fromOffset(130, 250), Position = UDim2.new(1, -14, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5) })
	right.Name = "RightMenu"
	UITheme.Button(right, { Name = "Hub", Text = "HUB", Icon = "Icon_Home", Color = "Blue", Size = UDim2.fromOffset(90, 90), Position = UDim2.new(0.5, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0), Sound = "Teleport", OnClick = function()
		request("Teleport", "Hub")
	end })
	overdriveBtn = UITheme.Button(right, { Name = "Overdrive", Text = "OVERDRIVE", Icon = "Icon_Overdrive", Color = "Red", Size = UDim2.fromOffset(122, 122), Position = UDim2.new(0.5, 0, 0, 104), AnchorPoint = Vector2.new(0.5, 0), MaxText = 18, OnClick = function()
		request("Overdrive")
	end })
	local badge = frame(overdriveBtn, { Color = C.Gold, Size = UDim2.fromOffset(46, 30), Position = UDim2.new(1, 4, 0, -6), AnchorPoint = Vector2.new(1, 0), Corner = 15, Stroke = 2, ZIndex = 5 })
	overdriveCount = UITheme.Label(badge, { Text = "x0", Size = UDim2.fromScale(1, 1), ZIndex = 6, MaxText = 20 })
	overdriveBar = frame(overdriveBtn, { Color = Color3.fromRGB(255, 80, 60), Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, 6), Corner = 10, Stroke = 2, ZIndex = 5 })
	overdriveBar.Visible = false
	overdriveTimer = UITheme.Label(overdriveBar, { Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 6, MaxText = 20 })

	-- pad indicator
	padLabel = UITheme.Label(root, { Text = "", Title = true, Size = UDim2.fromOffset(420, 44), Position = UDim2.new(0.5, 0, 0, inset.Y + 74), AnchorPoint = Vector2.new(0.5, 0), MaxText = 34, StrokeThickness = 3 })
	padLabel.Visible = false

	-- zone banner
	zoneBanner = frame(root, { Transparency = 1, Size = UDim2.fromOffset(700, 110), Position = UDim2.new(0.5, 0, 0, 170), AnchorPoint = Vector2.new(0.5, 0) })
	zoneBanner.Name = "ZoneBanner"
	zoneBanner.Visible = false
	UITheme.Label(zoneBanner, { Name = "Title", Text = "", Title = true, Size = UDim2.new(1, 0, 0, 64), MaxText = 56, StrokeThickness = 4 })
	UITheme.Label(zoneBanner, { Name = "Sub", Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 66), MaxText = 26 })

	-- tower hud
	towerHud = frame(root, { Color = Color3.fromRGB(30, 20, 50), Transparency = 0.1, Size = UDim2.fromOffset(360, 96), Position = UDim2.new(0.5, 0, 0, inset.Y + 74), AnchorPoint = Vector2.new(0.5, 0), Corner = 16, Stroke = 3 })
	towerHud.Name = "TowerHud"
	towerHud.Visible = false
	UITheme.Label(towerHud, { Name = "Title", Text = "TOWER", Title = true, Size = UDim2.new(0.6, 0, 0, 36), Position = UDim2.fromOffset(12, 8), XAlign = Enum.TextXAlignment.Left, Color = Color3.fromRGB(220, 160, 255), MaxText = 28 })
	UITheme.Label(towerHud, { Name = "Timer", Text = "--:--", Title = true, Size = UDim2.new(0.6, 0, 0, 40), Position = UDim2.fromOffset(12, 48), XAlign = Enum.TextXAlignment.Left, MaxText = 36 })
	UITheme.Button(towerHud, { Text = "LEAVE", Color = "Red", Size = UDim2.fromOffset(120, 60), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), OnClick = function()
		request("TowerLeave")
	end })

	-- notifications
	toastHolder = frame(root, { Transparency = 1, Size = UDim2.fromOffset(380, 300), Position = UDim2.new(1, -16, 0, inset.Y + 80), AnchorPoint = Vector2.new(1, 0) })
	toastHolder.Name = "Toasts"
	local tl = list(toastHolder, 6)
	tl.VerticalAlignment = Enum.VerticalAlignment.Top
	tl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	toastHolder.ClipsDescendants = false

	buildUpgrades()
	buildRace()
	buildBackpack()
	buildIndex()
	buildShop()
	buildTeleport()
	buildRebirth()
	buildSettings()
end

-- Helpers for the other client UI modules (Hud, WeaponUI).
UI.Helpers = {
	Frame = frame,
	List = list,
	Scroller = scroller,
	Clear = clearList,
	Tween = tween,
	Row = rowFrame,
	MakePanel = makePanel,
	Hex = hex,
}
function UI.Root()
	return root
end
function UI.FlyGui()
	return flyGui
end
function UI.Panel(name: string)
	return panels[name]
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WeaponUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- WeaponUI (ModuleScript) -> StarterPlayer/StarterPlayerScripts/Client/WeaponUI
-- Weapons inventory (3D previews), Chests + gacha reveal, 2x Power shop
-- (3^n Robux -> 2^n power) and the play-time Rewards ladder.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UITheme = require(Shared:WaitForChild("UITheme"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))
local SFX = require(Shared:WaitForChild("SFX"))
local VFX = require(Shared:WaitForChild("VFX"))

local WeaponUI = {}
local UI, H
local request: (string, any?) -> () = function() end
local C = UITheme.Colors
local player = Players.LocalPlayer

local function rarityOf(id: string)
	return Config.WeaponRarityById[id] or Config.WeaponRarities[1]
end

local function rarityLabel(r): string
	return r.Label or r.Id
end

-- Spinning 3D weapon preview in a ViewportFrame. Returns a cleanup function.
local function preview(parent: GuiObject, weaponId: string, rarityId: string, size: UDim2, pos: UDim2?)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = size
	vp.Position = pos or UDim2.new()
	vp.Ambient = Color3.fromRGB(190, 185, 210)
	vp.LightColor = Color3.new(1, 1, 1)
	vp.LightDirection = Vector3.new(-1, -1.2, -0.8)
	vp.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local built = WeaponModels.Build(weaponId, rarityId)
	built.Main.Parent = world
	if built.Off then
		built.Off:Destroy()
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local cf, sz = built.Main:GetBoundingBox()
	local center = cf.Position
	local dist = math.max(sz.X, sz.Y, sz.Z) * 1.7 + 1
	local start = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - start) * 0.9
		cam.CFrame = CFrame.lookAt(center + Vector3.new(math.cos(a) * dist, dist * 0.25, math.sin(a) * dist), center)
	end)
	return function()
		conn:Disconnect()
		vp:Destroy()
	end
end
WeaponUI.Preview = preview

local function sortedWeapons(d)
	local list = {}
	for uid, rec in pairs(d.Weapons or {}) do
		local def = Config.WeaponById[rec.W]
		if def then
			table.insert(list, { Uid = uid, Def = def, Rarity = rarityOf(rec.R) })
		end
	end
	table.sort(list, function(a, b)
		if a.Uid == d.Equipped then
			return true
		elseif b.Uid == d.Equipped then
			return false
		end
		if a.Rarity.Index ~= b.Rarity.Index then
			return a.Rarity.Index > b.Rarity.Index
		end
		return a.Def.Name < b.Def.Name
	end)
	return list
end

---------------------------------------------------------------------
-- WEAPONS PANEL
---------------------------------------------------------------------
local function buildWeapons()
	local p = H.MakePanel("Weapons", "WEAPONS", Vector2.new(820, 500), C.Purple)
	local grid = H.Scroller(p.Body, { Size = UDim2.new(1, -300, 1, 0) })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(150, 78)
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = grid
	local detail = H.Frame(p.Body, { Color = Color3.fromRGB(26, 20, 44), Size = UDim2.new(0, 288, 1, 0), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), Corner = 14, Stroke = 2 })
	local selected = nil
	local cleanupPreview = nil
	local lastD = nil

	local function showDetail(entry)
		H.Clear(detail)
		if cleanupPreview then
			cleanupPreview()
			cleanupPreview = nil
		end
		if not entry then
			UITheme.Label(detail, { Text = "Select a weapon", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 20), Color = C.Sub, MaxText = 18 })
			return
		end
		local def, r = entry.Def, entry.Rarity
		local class = Config.WeaponClasses[def.Class]
		cleanupPreview = preview(detail, def.Id, r.Id, UDim2.new(1, -16, 0, 130), UDim2.fromOffset(8, 6))
		UITheme.Label(detail, { Text = def.Name, Title = true, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 138), Color = r.Color, MaxText = 26 })
		UITheme.Label(detail, { Text = rarityLabel(r) .. "  |  " .. def.Class, Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 168), Color = C.Sub, MaxText = 15 })
		local skill = Config.Skills[def.Skill]
		local ult = Config.Skills[class.Ultimate]
		local lines = {
			string.format('<font color="#78ff9c">+%d%% Base Damage</font>%s', math.floor(r.Damage * 100 + 0.5), (r.AttackSpeed or 0) > 0 and string.format('  <font color="#8fd3ff">+%d%% Atk Speed</font>', math.floor(r.AttackSpeed * 100)) or ""),
			string.format('<font color="#ffc35a">E</font> %s   <font color="#ff6a8a">R</font> %s', skill and skill.Name or "-", ult and ult.Name or "-"),
		}
		if r.Passive and def.Passive then
			table.insert(lines, string.format('<font color="#ffd75a">Passive: %s</font> - %s', def.Passive.Name, def.Passive.Desc))
		end
		if r.Aura then
			table.insert(lines, '<font color="#ff5a6e">Celestial aura + signature skill</font>')
		elseif r.Trail then
			table.insert(lines, '<font color="#c78cff">Custom particle trail</font>')
		end
		local info = UITheme.Label(detail, { Text = table.concat(lines, "\n"), Rich = true, Size = UDim2.new(1, -16, 0, 150), Position = UDim2.fromOffset(8, 192), XAlign = Enum.TextXAlignment.Left, MaxText = 15, StrokeThickness = 1 })
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.TextWrapped = true
		local equipped = lastD and lastD.Equipped == entry.Uid
		UITheme.Button(detail, { Text = equipped and "EQUIPPED" or "EQUIP", Color = equipped and "Blue" or "Green", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), OnClick = function()
			request("Equip", entry.Uid)
		end })
		UITheme.Button(detail, { Text = "SCRAP " .. Format.Abbrev(r.Scrap), Color = "Red", Size = UDim2.new(0.5, -12, 0, 50), Position = UDim2.new(1, -8, 1, -8), AnchorPoint = Vector2.new(1, 1), MaxText = 18, OnClick = function()
			request("Scrap", entry.Uid)
		end })
	end

	p.Refresh = function(d)
		lastD = d
		local parts = { d.Equipped or "" }
		for uid, rec in pairs(d.Weapons or {}) do
			table.insert(parts, uid .. rec.W .. rec.R)
		end
		table.sort(parts)
		local sig = table.concat(parts, ",")
		if p.Sig == sig then
			return
		end
		p.Sig = sig
		H.Clear(grid)
		local list = sortedWeapons(d)
		local stillThere = nil
		for i, entry in ipairs(list) do
			local r = entry.Rarity
			local card = H.Frame(grid, { Color = Color3.fromRGB(34, 28, 56), Order = i, Corner = 12, Stroke = 3 })
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Color = r.Color
			end
			UITheme.Gradient(card, Color3.new(1, 1, 1), r.Color:Lerp(Color3.new(0, 0, 0), 0.4), 90)
			UITheme.Label(card, { Text = entry.Def.Name, Title = true, Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 6), Color = r.Color, MaxText = 20 })
			UITheme.Label(card, { Text = rarityLabel(r) .. " " .. entry.Def.Class, Size = UDim2.new(1, -10, 0, 18), Position = UDim2.fromOffset(5, 34), Color = C.Text, MaxText = 13 })
			if entry.Uid == d.Equipped then
				UITheme.Label(card, { Text = "EQUIPPED", Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 55), Color = C.Green, MaxText = 13 })
			end
			local btn = Instance.new("TextButton")
			btn.BackgroundTransparency = 1
			btn.Text = ""
			btn.Size = UDim2.fromScale(1, 1)
			btn.Parent = card
			btn.Activated:Connect(function()
				SFX.Play("UIClick")
				selected = entry.Uid
				showDetail(entry)
			end)
			if entry.Uid == selected then
				stillThere = entry
			end
		end
		if not stillThere then
			stillThere = list[1]
			selected = stillThere and stillThere.Uid or nil
		end
		showDetail(stillThere)
	end
end

---------------------------------------------------------------------
-- CHESTS PANEL + REVEAL
---------------------------------------------------------------------
local function buildChests()
	local p = H.MakePanel("Chests", "WEAPON CHESTS", Vector2.new(700, 470), C.Gold)
	local holder = H.Scroller(p.Body, { Size = UDim2.new(1, 0, 1, -40) })
	H.List(holder, 8)
	local rows = {}
	for i, chest in ipairs(Config.Chests) do
		local r = H.Row(holder, 84, i)
		H.Frame(r, { Color = chest.Color, Size = UDim2.fromOffset(10, 64), Position = UDim2.fromOffset(10, 10), Corner = 5 })
		UITheme.Label(r, { Text = chest.Name, Title = true, Size = UDim2.new(0.55, 0, 0, 32), Position = UDim2.fromOffset(30, 8), XAlign = Enum.TextXAlignment.Left, Color = chest.Color, MaxText = 26 })
		local sub = UITheme.Label(r, { Text = "", Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.fromOffset(30, 44), XAlign = Enum.TextXAlignment.Left, Color = C.Sub, MaxText = 16 })
		local btn = UITheme.Button(r, { Text = "OPEN", Color = "Gold", Size = UDim2.fromOffset(200, 60), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxText = 22, Sound = "ChestOpen", OnClick = function()
			request("OpenChest", chest.Id)
		end })
		rows[chest.Id] = { Sub = sub, Button = btn }
	end
	local odds = {}
	for _, r in ipairs(Config.WeaponRarities) do
		table.insert(odds, string.format('<font color="%s">%s %s</font>', H.Hex(r.Color), r.Id, Format.Percent(r.Chance)))
	end
	UITheme.Label(p.Body, { Text = "Drop rates: " .. table.concat(odds, "  "), Rich = true, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), MaxText = 15 })
	p.Refresh = function(d)
		for _, chest in ipairs(Config.Chests) do
			local row = rows[chest.Id]
			local minR = rarityOf(chest.MinRarity)
			if chest.Key then
				local have = d.Keys and d.Keys[chest.Key] or 0
				row.Sub.Text = string.format("Guaranteed %s+  |  You have %d", rarityLabel(minR), have)
				UITheme.SetButtonText(row.Button, "USE KEY")
			else
				local cost = math.floor(chest.CoinCost * (1 + d.Rebirths))
				row.Sub.Text = "Any rarity  |  " .. Format.Abbrev(cost) .. " Coins"
				UITheme.SetButtonText(row.Button, "OPEN " .. Format.Abbrev(cost))
			end
		end
	end
end

function WeaponUI.Reveal(weaponId: string, rarityId: string, title: string?)
	local def = Config.WeaponById[weaponId]
	local r = rarityOf(rarityId)
	if not def then
		return
	end
	UI.Close()
	local fly = UI.FlyGui()
	local overlay = H.Frame(fly, { Color = Color3.new(0, 0, 0), Transparency = 1, ZIndex = 60 })
	H.Tween(overlay, 0.3, { BackgroundTransparency = 0.35 })
	local card = H.Frame(overlay, { Color = Color3.fromRGB(26, 20, 44), Size = UDim2.fromOffset(520, 360), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Corner = 22, Stroke = 5, ZIndex = 61 })
	local sc = Instance.new("UIScale")
	local cam = workspace.CurrentCamera
	sc.Scale = math.clamp(math.min(cam.ViewportSize.X / 1400, cam.ViewportSize.Y / 820), 0.55, 1.1)
	sc.Parent = card
	UITheme.Label(card, { Text = title or "OPENING...", Title = true, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 10), Color = C.Sub, ZIndex = 62, MaxText = 26 })
	local nameLabel = UITheme.Label(card, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 230), ZIndex = 62, MaxText = 48, StrokeThickness = 4 })
	local rarityText = UITheme.Label(card, { Text = "", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 290), ZIndex = 62, MaxText = 24 })
	local stroke = card:FindFirstChildOfClass("UIStroke")
	task.spawn(function()
		local steps = 24
		for i = 1, steps do
			local rr = Config.WeaponRarities[math.random(1, 4)]
			local pool = Config.WeaponsByRarity[rr.Id]
			local w = pool[math.random(1, #pool)]
			nameLabel.Text = w.Name
			nameLabel.TextColor3 = rr.Color
			if stroke then
				stroke.Color = rr.Color
			end
			SFX.Play("ChestTick", { Pitch = 0.8 + i / steps })
			task.wait(0.03 + (i / steps) ^ 3 * 0.2)
		end
		nameLabel.Text = def.Name
		nameLabel.TextColor3 = r.Color
		rarityText.Text = rarityLabel(r) .. " " .. def.Class
		rarityText.TextColor3 = r.Color
		if stroke then
			stroke.Color = r.Color
		end
		local cleanup = preview(card, def.Id, r.Id, UDim2.new(1, -40, 0, 180), UDim2.fromOffset(20, 48))
		for _, d in ipairs(card:GetChildren()) do
			if d:IsA("ViewportFrame") then
				d.ZIndex = 62
			end
		end
		if r.Index >= 5 then
			SFX.Play("RaceRevealLegend")
			VFX.ImpactFrame(r.Color, 1.4)
			VFX.TitleCard(def.Name:upper() .. "!", rarityLabel(r) .. " weapon", r.Color, 2.2)
		elseif r.Index >= 4 then
			SFX.Play("RaceReveal")
			VFX.ImpactFrame(r.Color, 0.9)
		else
			SFX.Play("RaceReveal", { Volume = 0.7 })
			VFX.ScreenFlash(r.Color, 0.5, 0.4)
		end
		task.wait(r.Index >= 5 and 2.6 or 1.8)
		H.Tween(overlay, 0.3, { BackgroundTransparency = 1 })
		H.Tween(sc, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.3)
		cleanup()
		overlay:Destroy()
		UI.Notify("Got " .. rarityLabel(r) .. " " .. def.Name .. "! Equip it from Weapons.", r.Color)
	end)
end

---------------------------------------------------------------------
-- POWER PANEL (3^n Robux -> 2^n damage)
---------------------------------------------------------------------
local function buildPower()
	local p = H.MakePanel("Power", "2x POWER", Vector2.new(560, 430), C.Red)
	local box = H.Row(p.Body, 250, 0, Color3.fromRGB(50, 24, 34))
	local cur = UITheme.Label(box, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 12), Color = C.Gold, MaxText = 42 })
	local nxt = UITheme.Label(box, { Text = "", Title = true, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 70), Color = Color3.fromRGB(120, 255, 170), MaxText = 34 })
	local price = UITheme.Label(box, { Text = "", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 118), MaxText = 24 })
	local note = UITheme.Label(box, { Text = "Each tier doubles ALL your damage (applied after the gameplay damage cap). Tiers cost 3, 9, 27, 81... Robux.", Size = UDim2.new(1, -20, 0, 80), Position = UDim2.fromOffset(10, 158), Color = C.Sub, MaxText = 16 })
	note.TextWrapped = true
	local buy = UITheme.Button(p.Body, { Text = "BUY", Color = "Red", Size = UDim2.fromOffset(300, 74), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1), MaxText = 30, Sound = "Purchase", OnClick = function()
		request("BuyPower")
	end })
	p.Refresh = function(d)
		local n = d.PowerTier or 0
		cur.Text = "Current: x" .. Format.Abbrev(Config.PowerTierMult(n)) .. " Power"
		if Config.PowerTiers[n + 1] then
			nxt.Text = "Next: x" .. Format.Abbrev(Config.PowerTierMult(n + 1))
			price.Text = "Tier " .. (n + 1) .. " price: " .. Format.Commas(Config.PowerTierPrice(n + 1)) .. " Robux"
			UITheme.SetButtonText(buy, "BUY x2  (R$ " .. Format.Commas(Config.PowerTierPrice(n + 1)) .. ")")
		else
			nxt.Text = "MAX TIER REACHED"
			price.Text = ""
			UITheme.SetButtonText(buy, "MAXED")
		end
	end
end

---------------------------------------------------------------------
-- REWARDS PANEL (play-time ladder + streak)
---------------------------------------------------------------------
local function buildRewards()
	local p = H.MakePanel("Rewards", "PLAY-TIME REWARDS", Vector2.new(620, 470), C.Green)
	local holder = H.Frame(p.Body, { Transparency = 1, Size = UDim2.new(1, 0, 1, -70) })
	H.List(holder, 8)
	local rows = {}
	for i, reward in ipairs(Config.PlaytimeRewards) do
		local r = H.Row(holder, 56, i)
		UITheme.Label(r, { Text = reward.Minutes .. " min", Title = true, Size = UDim2.fromOffset(90, 40), Position = UDim2.fromOffset(10, 8), Color = C.Gold, MaxText = 24 })
		UITheme.Label(r, { Text = reward.Name, Size = UDim2.new(1, -250, 0, 40), Position = UDim2.fromOffset(104, 8), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
		rows[i] = UITheme.Label(r, { Text = "", Title = true, Size = UDim2.fromOffset(130, 40), Position = UDim2.new(1, -10, 0, 8), AnchorPoint = Vector2.new(1, 0), MaxText = 20 })
	end
	local foot = UITheme.Label(p.Body, { Text = "", Rich = true, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), MaxText = 16 })
	foot.TextWrapped = true
	p.Refresh = function(d)
		local session = player:GetAttribute("SessionTime") or 0
		for i, reward in ipairs(Config.PlaytimeRewards) do
			local claimed = d.PlaytimeClaimed and d.PlaytimeClaimed[i]
			if claimed then
				rows[i].Text = "CLAIMED"
				rows[i].TextColor3 = C.Green
			else
				rows[i].Text = Format.Time(reward.Minutes * 60 - session)
				rows[i].TextColor3 = C.Text
			end
		end
		foot.Text = string.format('Daily streak: <font color="#8fd3ff">%d day(s)</font> (log in every day for bigger bonuses)   Total play time: <font color="#ffd75a">%s</font>', d.Streak or 0, Format.Time(d.TotalPlaytime or 0))
	end
end

function WeaponUI.Tick()
	local panel = UI.Panel("Rewards")
	if panel and panel.Frame.Visible and UI.Data and panel.Refresh then
		panel.Refresh(UI.Data)
	end
end

function WeaponUI.Init(ui, requestFn)
	UI = ui
	H = UI.Helpers
	request = requestFn
	buildWeapons()
	buildChests()
	buildPower()
	buildRewards()
end

return WeaponUI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="37">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
