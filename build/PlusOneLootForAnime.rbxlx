---------------------------------------------------------------------
-- rarity dressing
---------------------------------------------------------------------
local function dress(m: Model, effectPart: BasePart, w, rarity, glow: Color3)
	if not m then
		return
	end
	local a0 = m:FindFirstChild("TrailA", true)
	local a1 = m:FindFirstChild("TrailB", true)
	-- crisp swing trail, flashed by the client on every swing
	if a0 and a1 then
		local sw = Instance.new("Trail")
		sw.Name = "SwingTrail"
		sw.Enabled = false
		sw.Attachment0 = a0
		sw.Attachment1 = a1
		sw.Lifetime = 0.16
		sw.MinLength = 0.02
		sw.LightEmission = 1
		sw.LightInfluence = 0
		sw.FaceCamera = false
		sw.Transparency = VFX.NS(0, 0.05, 0.6, 0.55, 1, 1)
		sw.WidthScale = VFX.NS(0, 1, 1, 0.3)
		sw.Color = ColorSequence.new(WHITE, glow)
		sw.Parent = effectPart
	end
	if rarity.Trail and a0 and a1 then
		local tr = Instance.new("Trail")
		tr.Name = "RarityTrail"
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.25
		tr.MinLength = 0.05
		tr.LightEmission = 1
		tr.LightInfluence = 0
		tr.FaceCamera = true
		tr.Transparency = VFX.NS(0, 0.15, 1, 1)
		tr.WidthScale = VFX.NS(0, 1, 1, 0.1)
		if rarity.Rainbow then
			tr.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 80)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 220, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
			})
		else
			tr.Color = ColorSequence.new(WHITE, glow)
		end
		tr.Parent = effectPart
	end
	if rarity.Index >= 5 then
		local l = Instance.new("PointLight")
		l.Color = glow
		l.Range = 9
		l.Brightness = 1.6
		l.Shadows = false
		l.Parent = effectPart
		VFX.MakeEmitter("Stars", glow, effectPart, 4)
	end
	if rarity.Aura then
		local e = VFX.MakeEmitter("Aura", glow, effectPart, 14)
		e.Size = VFX.NS(0, 0.5, 0.5, 0.9, 1, 0)
		e.Speed = NumberRange.new(1, 3)
	end
end

-- Ore effects forged into the weapon show as element particles on it.
function WeaponModels.ApplyEffects(built, effects)
	if not effects or not built or not built.Effect then
		return
	end
	-- strongest effect gets the particle, second strongest tints a light
	local best, second = nil, nil
	for id, pts in pairs(effects) do
		if Config.Effects[id] then
			if not best or pts > effects[best] then
				second = best
				best = id
			elseif not second or pts > effects[second] then
				second = id
			end
		end
	end
	if best then
		local e = Config.Effects[best]
		local em = VFX.MakeEmitter(e.VFX or "Sparks", e.Color, built.Effect, 3 + math.min(10, effects[best] / 3))
		em.Name = "OreEffect"
		em.LockedToPart = true
	end
	if second then
		local l = Instance.new("PointLight")
		l.Name = "OreEffectLight"
		l.Color = Config.Effects[second].Color
		l.Range = 6
		l.Brightness = 1
		l.Parent = built.Effect
	end
end

-- Build a weapon. Returns { Main = Model, Off = Model?, Effect = BasePart }
function WeaponModels.Build(weaponId: string, rarityId: string?, forgeLevel: number?)
	local w = Config.WeaponById[weaponId] or Config.WeaponById[Config.StarterWeapon]
	local rarity = Config.WeaponRarityById[rarityId or w.Rarity] or Config.WeaponRarities[1]
	local glow = w.Glow or (rarity.Index >= 3 and rarity.Color) or nil
	local builder = builders[w.Class] or builders.Katana
	local main, effect, off, offEffect = builder(w, glow)
	dress(main, effect, w, rarity, glow or rarity.Color)
	if off then
		offEffect = offEffect or off:FindFirstChild("Glove") or off:FindFirstChild("Barrel")
		if offEffect then
			dress(off, offEffect, w, rarity, glow or rarity.Color)
		end
	end
	if forgeLevel and forgeLevel > 0 then
		local blade = main:FindFirstChild("Blade")
		if blade and (w.Class == "Katana" or w.Class == "Greatsword") then
			etch(blade, "+" .. forgeLevel, glow or Color3.fromRGB(255, 220, 140))
		end
	end
	main:SetAttribute("WeaponId", w.Id)
	return { Main = main, Off = off, Effect = effect, Glow = glow or rarity.Color }
end

-- Weld a built weapon to a character's hands (R15 or R6).
function WeaponModels.AttachToCharacter(character: Model, built)
	local function hand(side: string): BasePart?
		return (character:FindFirstChild(side .. "Hand") or character:FindFirstChild(side .. " Arm")) :: any
	end
	local function weldTo(model: Model?, side: string)
		if not model then
			return
		end
		local h = hand(side)
		if not h then
			model:Destroy()
			return
		end
		local grip = model.PrimaryPart :: BasePart
		local gripAtt = h:FindFirstChild(side .. "GripAttachment") :: Attachment?
		local isGlove = model:GetAttribute("HandMount") == true or model:FindFirstChild("Glove") ~= nil or model:FindFirstChild("Fingertip") ~= nil
		local c0
		if isGlove then
			c0 = CFrame.new(0, h.Name:find("Arm") and -0.8 or 0, 0)
		elseif gripAtt then
			c0 = gripAtt.CFrame
		else
			c0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
		end
		model:PivotTo(h.CFrame * c0)
		local weld = Instance.new("Weld")
		weld.Name = "WeaponWeld"
		weld.Part0 = h
		weld.Part1 = grip
		weld.C0 = c0
		weld.C1 = CFrame.new()
		weld.Parent = grip
		model.Name = "EquippedWeapon_" .. side
		model.Parent = character
	end
	weldTo(built.Main, "Right")
	weldTo(built.Off, "Left")
end

---------------------------------------------------------------------
-- ARMOR (welded onto the character's body parts, R15 or R6)
---------------------------------------------------------------------
local function bodyPart(char: Model, r15: string, r6: string): BasePart?
	return (char:FindFirstChild(r15) or char:FindFirstChild(r6)) :: any
end

local function armorPiece(folder: Instance, body: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = body.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = body
	weld.Part1 = p
	weld.C0 = offset
	weld.Parent = p
	p.Parent = folder
	return p
end

function WeaponModels.RemoveArmor(char: Model)
	local old = char:FindFirstChild("EquippedArmor")
	if old then
		old:Destroy()
	end
end

-- Builds the armour set on a character. rarityId controls trim glow.
function WeaponModels.AttachArmor(char: Model, armorId: string, rarityId: string)
	WeaponModels.RemoveArmor(char)
	local a = Config.ArmorById[armorId]
	local r = Config.WeaponRarityById[rarityId] or Config.WeaponRarities[1]
	local torso = bodyPart(char, "UpperTorso", "Torso")
	local lower = bodyPart(char, "LowerTorso", "Torso")
	local lArm = bodyPart(char, "LeftUpperArm", "Left Arm")
	local rArm = bodyPart(char, "RightUpperArm", "Right Arm")
	local head = char:FindFirstChild("Head") :: BasePart?
	if not a or not torso or not lArm or not rArm then
		return nil
	end
	local folder = Instance.new("Folder")
	folder.Name = "EquippedArmor"
	folder.Parent = char
	local ts = torso.Size
	local base, trim = a.Color, a.Trim
	local glowing = r.Index >= 4
	local trimMat = glowing and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local u = ts.X / 2

	-- chest + back plates (every set)
	local chest = armorPiece(folder, torso, "ChestPlate", Vector3.new(ts.X * 0.95, ts.Y * 0.75, 0.16), CFrame.new(0, ts.Y * 0.08, -ts.Z / 2 - 0.05), base, Enum.Material.SmoothPlastic)
	chest.Reflectance = 0.08
	armorPiece(folder, torso, "BackPlate", Vector3.new(ts.X * 0.9, ts.Y * 0.7, 0.14), CFrame.new(0, ts.Y * 0.08, ts.Z / 2 + 0.05), base)
	armorPiece(folder, torso, "ChestTrim", Vector3.new(ts.X * 0.96, 0.08, 0.18), CFrame.new(0, ts.Y * 0.44, -ts.Z / 2 - 0.05), trim, trimMat)
	if lower then
		armorPiece(folder, lower, "Belt", Vector3.new(lower.Size.X * 1.06, 0.25, lower.Size.Z * 1.08), CFrame.new(0, lower.Size.Y * 0.2, 0), trim, trimMat)
	end

	local style = a.Style
	for _, pair in ipairs({ { lArm, -1 }, { rArm, 1 } }) do
		local arm, side = pair[1], pair[2]
		local top = CFrame.new(side * 0.05, arm.Size.Y * 0.38, 0)
		if style == "Samurai" then
			armorPiece(folder, arm, "Sode", Vector3.new(0.16, u * 1.1, u * 1.2), top * CFrame.new(side * 0.35, -0.2, 0) * CFrame.Angles(0, 0, math.rad(side * 18)), base)
			armorPiece(folder, arm, "SodeTrim", Vector3.new(0.18, 0.08, u * 1.22), top * CFrame.new(side * 0.35, -0.72, 0) * CFrame.Angles(0, 0, math.rad(side * 18)), trim, trimMat)
		elseif style == "Mech" then
			local box = armorPiece(folder, arm, "ShoulderBox", Vector3.new(u * 1.1, u * 0.6, u * 1.15), top * CFrame.new(side * 0.1, 0.1, 0), base, Enum.Material.Metal)
			armorPiece(folder, arm, "ShoulderGlow", Vector3.new(u * 1.12, 0.06, u * 1.17), top * CFrame.new(side * 0.1, -0.1, 0), trim, Enum.Material.Neon)
			local _ = box
		elseif style == "Oni" then
			armorPiece(folder, arm, "Spike", Vector3.new(0.18, u * 0.9, 0.18), top * CFrame.new(side * 0.2, 0.45, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)), trim)
			armorPiece(folder, arm, "Pad", Vector3.new(u, u * 0.5, u), top, base, nil, Enum.PartType.Ball)
		elseif style == "Saiyan" then
			armorPiece(folder, arm, "Flap", Vector3.new(u * 1.05, 0.14, u * 1.1), top * CFrame.new(side * 0.25, 0.1, 0) * CFrame.Angles(0, 0, math.rad(side * 20)), base)
			armorPiece(folder, arm, "FlapTrim", Vector3.new(u * 1.06, 0.06, u * 1.12), top * CFrame.new(side * 0.25, 0.02, 0) * CFrame.Angles(0, 0, math.rad(side * 20)), trim, trimMat)
		elseif style == "Aegis" then
			armorPiece(folder, arm, "Pauldron", Vector3.new(u * 1.25, u * 0.7, u * 1.2), top * CFrame.new(side * 0.12, 0.05, 0), base, Enum.Material.SmoothPlastic, Enum.PartType.Ball).Reflectance = 0.2
			armorPiece(folder, arm, "Gem", Vector3.one * 0.26, top * CFrame.new(side * 0.4, 0.15, -0.25), trim, Enum.Material.Neon, Enum.PartType.Ball)
		elseif style == "Robe" then
			armorPiece(folder, arm, "Sleeve", Vector3.new(arm.Size.X * 1.3, arm.Size.Y * 0.9, arm.Size.Z * 1.3), CFrame.new(0, -0.05, 0), base, Enum.Material.Fabric)
		elseif style == "Vest" then
			armorPiece(folder, arm, "Strap", Vector3.new(arm.Size.X * 1.08, 0.2, arm.Size.Z * 1.08), CFrame.new(0, arm.Size.Y * 0.1, 0), trim)
		else -- Gi
			armorPiece(folder, arm, "Wrap", Vector3.new(arm.Size.X * 1.05, arm.Size.Y * 0.35, arm.Size.Z * 1.05), CFrame.new(0, -arm.Size.Y * 0.3, 0), trim, Enum.Material.Fabric)
		end
	end

	-- signature piece per style
	if style == "Robe" or style == "Gi" then
		armorPiece(folder, torso, "CoatTail", Vector3.new(ts.X * 1.05, ts.Y * 1.9, 0.08), CFrame.new(0, -ts.Y * 0.9, ts.Z / 2 + 0.12) * CFrame.Angles(math.rad(6), 0, 0), base, Enum.Material.Fabric)
	elseif style == "Vest" then
		for i = -1, 1 do
			armorPiece(folder, torso, "Pouch", Vector3.new(0.3, 0.36, 0.14), CFrame.new(i * 0.4, -ts.Y * 0.2, -ts.Z / 2 - 0.14), trim)
		end
	elseif style == "Samurai" and head then
		armorPiece(folder, head, "Kuwagata", Vector3.new(0.08, 0.9, 0.3), CFrame.new(-0.25, head.Size.Y * 0.62, -head.Size.Z * 0.4) * CFrame.Angles(0, 0, math.rad(25)), trim, trimMat)
		armorPiece(folder, head, "Kuwagata", Vector3.new(0.08, 0.9, 0.3), CFrame.new(0.25, head.Size.Y * 0.62, -head.Size.Z * 0.4) * CFrame.Angles(0, 0, math.rad(-25)), trim, trimMat)
	elseif style == "Aegis" and head then
		local halo = armorPiece(folder, head, "Halo", Vector3.new(0.08, head.Size.X * 1.4, head.Size.X * 1.4), CFrame.new(0, head.Size.Y * 0.95, 0) * CFrame.Angles(0, 0, math.rad(90)), trim, Enum.Material.Neon, Enum.PartType.Cylinder)
		halo.Transparency = 0.35
	elseif style == "Mech" then
		armorPiece(folder, torso, "Reactor", Vector3.one * 0.4, CFrame.new(0, ts.Y * 0.1, -ts.Z / 2 - 0.16), trim, Enum.Material.Neon, Enum.PartType.Ball)
	elseif style == "Oni" then
		armorPiece(folder, torso, "Fur", Vector3.new(ts.X * 1.2, 0.35, ts.Z * 1.3), CFrame.new(0, ts.Y * 0.5, 0), trim, Enum.Material.Fabric)
	end

	-- rarity dressing
	if r.Index >= 5 then
		VFX.MakeEmitter("Holy", r.Color, chest, 3)
	end
	if r.Index >= 4 then
		local l = Instance.new("PointLight")
		l.Color = trim
		l.Range = 7
		l.Brightness = 0.8
		l.Parent = chest
	end
	return folder
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
-- Server (Script) -> ServerScriptService/Server
-- Entry point. All the ModuleScripts listed in SETUP.md go INSIDE this Script.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))

local Net = require(script:WaitForChild("Net"))
local DataService = require(script:WaitForChild("DataService"))
local Stats = require(script:WaitForChild("Stats"))
local MapBuilder = require(script:WaitForChild("MapBuilder"))
local Weapons = require(script:WaitForChild("Weapons"))
local Playtime = require(script:WaitForChild("Playtime"))
local Cosmetics = require(script:WaitForChild("Cosmetics"))
local Loot = require(script:WaitForChild("Loot"))
local EnemyService = require(script:WaitForChild("EnemyService"))
local TowerService = require(script:WaitForChild("TowerService"))
local Combat = require(script:WaitForChild("Combat"))
local Monetization = require(script:WaitForChild("Monetization"))
local Actions = require(script:WaitForChild("Actions"))
local Admin = require(script:WaitForChild("Admin"))
local Leaderboards = require(script:WaitForChild("Leaderboards"))
local DungeonService = require(script:WaitForChild("DungeonService"))

---------------------------------------------------------------------
-- WORLD
---------------------------------------------------------------------
VFX.BuildLibrary() -- ReplicatedStorage.VFX: the editable effect hierarchy
local map = MapBuilder.Build()
task.spawn(EnemyService.Init, map) -- builds enemy rigs (yields), players can join meanwhile
TowerService.Init(map)
DungeonService.Init()
Combat.Init(map)
Actions.Init(map)
Admin.Init(map)
Leaderboards.Init(map)

---------------------------------------------------------------------
-- SYNC + LEADERSTATS
---------------------------------------------------------------------
local function setStat(player: Player, name: string, value: string)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then
		(v :: StringValue).Value = value
	end
end

DataService.OnFlush = function(player: Player)
	local snap = Stats.Snapshot(player)
	if snap then
		Net.Sync:FireClient(player, snap)
		setStat(player, "Power", Format.Abbrev(snap.Power))
		setStat(player, "Floor", tostring(snap.BestFloor))
		setStat(player, "Rebirths", (snap.Ascensions > 0 and ("A" .. snap.Ascensions .. " ") or "") .. Format.Abbrev(snap.Rebirths))
	end
end

Monetization.OnPassesChanged = function(player: Player)
	Cosmetics.Apply(player)
	Actions.ApplyCharacter(player)
end

Playtime.OnCosmeticsChanged = function(player: Player)
	Cosmetics.Apply(player)
end

Admin.OnApplyCharacter = function(player: Player)
	Actions.ApplyCharacter(player)
end

Admin.OnCosmetics = function(player: Player)
	Cosmetics.Apply(player)
end

-- skill mastery xp for every kill you took part in
EnemyService.OnReward = function(player: Player, enemy)
	local M = Config.Mastery
	Combat.GrantMastery(player, enemy.Boss and M.BossKillXP or (enemy.Elite and M.EliteKillXP or M.KillXP))
end

EnemyService.OnZenkai = function(player: Player)
	Cosmetics.RefreshTransform(player)
end

---------------------------------------------------------------------
-- PLAYERS
---------------------------------------------------------------------
local function onCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then
		return
	end
	while player.Parent and not DataService.IsLoaded(player) do
		task.wait(0.2)
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	task.wait(0.1)
	Weapons.EnsureStarter(player)
	Weapons.Refresh(player)
	Weapons.RefreshArmor(player)
	Cosmetics.Apply(player)
	Actions.ApplyCharacter(player)
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in ipairs({ "Power", "Floor", "Rebirths" }) do
		local v = Instance.new("StringValue")
		v.Name = name
		v.Value = "0"
		v.Parent = ls
	end
	ls.Parent = player

	player.CharacterAdded:Connect(function(char)
		task.spawn(DungeonService.CharacterAdded, player, char)
		onCharacter(player, char)
	end)

	DataService.Load(player)
	Admin.PlayerAdded(player)
	Monetization.LoadPasses(player)
	Weapons.EnsureStarter(player)
	Playtime.OnJoin(player)
	player:SetAttribute("Stamina", Config.Balance.MaxStamina)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	DataService.MarkDirty(player)
	Actions.InitialRoll(player, 5)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	TowerService.PlayerRemoving(player)
	DungeonService.PlayerRemoving(player)
	Actions.PlayerRemoving(player)
	DataService.Release(player)
end)

---------------------------------------------------------------------
-- BUFF TIMERS + DROP CLEANUP
---------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, player in ipairs(Players:GetPlayers()) do
			local s = DataService.Session(player)
			if s then
				local active = Stats.OverdriveActive(player) or Stats.ZenkaiActive(player)
				if active ~= (s.TransformShown == true) then
					s.TransformShown = active
					Cosmetics.RefreshTransform(player)
					Actions.ApplyCharacter(player)
					DataService.MarkDirty(player)
				end
				Loot.CleanupDrops(player)
			end
		end
	end
end)

print(("[%s] server ready"):format(Config.GameName))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Actions (ModuleScript) -> ServerScriptService/Server/Actions
-- Handles every client request (forge, sell, upgrade, rebirth, race reroll,
-- overdrive, codes, teleports, shop, dungeon, boss rush, index) with
-- server-side validation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local Cosmetics = require(script.Parent:WaitForChild("Cosmetics"))
local Monetization = require(script.Parent:WaitForChild("Monetization"))
local TowerService = require(script.Parent:WaitForChild("TowerService"))
local Util = require(script.Parent:WaitForChild("Util"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))
local Forge = require(script.Parent:WaitForChild("Forge"))
local DungeonService = require(script.Parent:WaitForChild("DungeonService"))

local Actions = {}
local map = nil

local RED = Color3.fromRGB(255, 110, 90)

local function near(player: Player, part: BasePart?, dist: number): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root ~= nil and part ~= nil and (root.Position - part.Position).Magnitude <= dist
end

function Actions.ApplyCharacter(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not hum then
		return
	end
	local s = DataService.Session(player)
	hum.WalkSpeed = Stats.WalkSpeed(player) * (s and s.AdminSpeed and 3 or 1)
end

---------------------------------------------------------------------
local handlers = {}

handlers.Collect = function(player, id)
	Loot.Collect(player, id)
end

-- payload = { Ores = {...}, Catalyst = key? }  (see Forge.luau)
handlers.Forge = function(player, payload)
	if not near(player, map.Forge, 40) then
		Net.Notify(player, "Stand next to the Soul Forge at spawn to forge weapons.", RED, "Error")
		return
	end
	Forge.Craft(player, payload)
end

handlers.Sell = function(player, oreId)
	if not near(player, map.Sell, 30) then
		Net.Notify(player, "Visit the Sell stall at spawn to sell ore.", RED, "Error")
		return
	end
	if type(oreId) ~= "string" then
		oreId = nil
	end
	if Loot.Sell(player, oreId) <= 0 then
		Net.Notify(player, "Nothing to sell.", RED, "Error")
	end
end

handlers.Upgrade = function(player, key)
	local data = DataService.Get(player)
	if type(key) ~= "string" or not Config.Upgrades[key] then
		return
	end
	local level = data.Upgrades[key]
	local cost = Stats.UpgradeCost(key, level)
	if not cost then
		return
	end
	if data.Coins < cost then
		Net.Notify(player, "Not enough Coins (" .. Format.Abbrev(cost) .. " needed).", RED, "Error")
		return
	end
	data.Coins -= cost
	data.Upgrades[key] = level + 1
	Net.FX(player, "Upgraded", { Key = key, Level = level + 1 })
	DataService.MarkDirty(player)
end

handlers.Rebirth = function(player)
	local data = DataService.Get(player)
	local req = Stats.RebirthReq(data)
	if data.Power < req then
		Net.Notify(player, "You need " .. Format.Abbrev(req) .. " Power to Rebirth.", RED, "Error")
		return
	end
	local keep = Stats.Race(data).Id == "Isekai" and math.floor(data.Power * 0.1) or 0
	data.Rebirths += 1
	data.Power = keep
	data.Coins = 0
	data.Rerolls += Config.Rebirth.RerollReward
	TowerService.Leave(player)
	Util.Teleport(player, map.HubCFrame, "Spawn")
	Net.FXAll("Rebirth", { Player = player, Rebirths = data.Rebirths })
	Cosmetics.Apply(player)
	DataService.MarkDirty(player)
end

-- Ascension: needs Config.AscendReq rebirths. Resets rebirths, Power and
-- Coins for a huge permanent multiplier (x8 Power, x4 Coins each).
handlers.Ascend = function(player)
	local data = DataService.Get(player)
	local req = Config.AscendReq(data.Ascensions)
	if data.Rebirths < req then
		Net.Notify(player, "Ascending needs " .. req .. " Rebirths.", RED, "Error")
		return
	end
	data.Ascensions += 1
	data.Rebirths = 0
	data.Power = 0
	data.Coins = 0
	data.Rerolls += Config.Ascension.Rerolls
	local cat = Config.Ascension.Catalyst
	data.Keys[cat] = (data.Keys[cat] or 0) + 1
	TowerService.Leave(player)
	Util.Teleport(player, map.HubCFrame, "Spawn")
	Net.FXAll("Ascend", { Player = player, Ascensions = data.Ascensions })
	Cosmetics.Apply(player)
	DataService.MarkDirty(player)
end

function Actions.RollRace(player: Player, initial: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if not initial then
		if data.Rerolls <= 0 then
			Net.Notify(player, "No Race Rerolls left! Get more from bosses, rebirths, codes or the Shop.", RED, "Error")
			return
		end
		data.Rerolls -= 1
	end
	local raceId, tierId = Stats.RollRace(player)
	data.Race = raceId
	data.RaceTier = tierId
	Net.FX(player, "RaceRoll", { Race = raceId, Tier = tierId, Initial = initial })
	-- let the slot-machine animation finish before auras appear
	task.delay(2.6, function()
		if player.Parent then
			Cosmetics.Apply(player)
			Actions.ApplyCharacter(player)
			if raceId == "MainCharacter" or tierId == "Mythic" then
				Net.FXAll("Transform", { Player = player, Kind = "Awaken", Color = Config.RaceById[raceId].Color })
			end
		end
	end)
	DataService.MarkDirty(player)
end

handlers.Reroll = function(player)
	Actions.RollRace(player, false)
end

handlers.Overdrive = function(player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if Stats.OverdriveActive(player) then
		Net.Notify(player, "Overdrive is already active!", RED, "Error")
		return
	end
	if data.Overdrive <= 0 then
		Net.Notify(player, "No Overdrive potions. Get them from codes or the Shop.", RED, "Error")
		return
	end
	data.Overdrive -= 1
	local duration = Stats.OverdriveDuration(player)
	s.OverdriveEnd = Stats.Now() + duration
	Net.FXAll("Transform", { Player = player, Kind = "Overdrive", Color = Stats.Race(data).Color })
	Cosmetics.RefreshTransform(player)
	Actions.ApplyCharacter(player)
	DataService.MarkDirty(player)
end

handlers.Redeem = function(player, code)
	local data = DataService.Get(player)
	if type(code) ~= "string" or #code > 40 then
		return
	end
	code = string.upper((code:gsub("%s", "")))
	local grants = Config.Codes[code]
	if not grants then
		Net.Notify(player, "Invalid code.", RED, "Error")
		return
	end
	if data.Codes[code] then
		Net.Notify(player, "You already redeemed that code.", RED, "Error")
		return
	end
	data.Codes[code] = true
	local text = Monetization.Grant(player, grants)
	Net.FX(player, "Purchase", { Name = "Code " .. code, Text = text })
	DataService.MarkDirty(player)
end

handlers.Teleport = function(player, dest)
	if type(dest) ~= "string" then
		return
	end
	if TowerService.InTower(player) then
		-- the HOME button also works as "leave Boss Rush"
		if dest == "Hub" then
			TowerService.Leave(player)
		else
			Net.Notify(player, "Leave the Boss Rush first.", RED, "Error")
		end
		return
	end
	-- leaving the dungeon ends the run (back to floor 1 / a checkpoint)
	if DungeonService.InRun(player) then
		DungeonService.End(player, dest == "Hub" and "Home" or "Left")
	end
	if dest == "Hub" then
		Util.Teleport(player, map.HubCFrame, "Spawn")
	elseif dest == "Train" then
		Util.Teleport(player, map.TrainCFrame, "Training Grounds")
	elseif dest == "Tower" then
		Util.Teleport(player, map.TowerCFrame, "Boss Rush")
	elseif dest == "Dungeon" then
		Util.Teleport(player, map.DungeonCFrame, "The Dungeon")
	end
end

-- Start a dungeon run at floor 1 or an unlocked checkpoint.
handlers.DungeonStart = function(player, floor)
	if not near(player, map.DungeonPrompt and map.DungeonPrompt.Parent, 40) and not DungeonService.InRun(player) then
		Net.Notify(player, "Go to the Dungeon gate (north of spawn) to start a run.", RED, "Error")
		return
	end
	DungeonService.Start(player, floor)
end

handlers.UnlockIndex = function(player, oreId)
	Loot.UnlockIndex(player, oreId)
end

handlers.ScrapBulk = function(player, maxRarity)
	Weapons.ScrapBulk(player, tonumber(maxRarity) or 2)
end

handlers.BuyPass = function(player, key)
	if type(key) == "string" then
		Monetization.PromptPass(player, key)
	end
end

handlers.BuyProduct = function(player, key)
	if type(key) == "string" then
		Monetization.PromptProduct(player, key)
	end
end

handlers.TowerStart = function(player)
	TowerService.Start(player)
end

handlers.TowerLeave = function(player)
	TowerService.Leave(player)
end

handlers.Settings = function(player, settings)
	local data = DataService.Get(player)
	if type(settings) ~= "table" then
		return
	end
	for _, key in ipairs({ "Music", "SFX", "AutoEquip", "Shake", "DamageNumbers" }) do
		if settings[key] ~= nil then
			data.Settings[key] = settings[key] == true
		end
	end
	DataService.MarkDirty(player)
end

-- World map fog of war (cosmetic). Only known region keys are accepted.
handlers.Explore = function(player, key)
	local data = DataService.Get(player)
	if type(key) ~= "string" or not Config.ExploreKeys[key] or data.Explored[key] then
		return
	end
	data.Explored[key] = true
	DataService.MarkDirty(player)
end

-- First-time players get a free race roll once their client is ready.
function Actions.InitialRoll(player: Player, delay: number)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s or data.Race ~= "" or s.InitialRoll then
		return
	end
	s.InitialRoll = true
	task.delay(delay, function()
		if player.Parent and DataService.Get(player) then
			Actions.RollRace(player, true)
		end
	end)
end

handlers.Ready = function(player)
	DataService.MarkDirty(player)
	Actions.InitialRoll(player, 1.5)
end

---------------------------------------------------------------------
-- WEAPONS / CHESTS / POWER
---------------------------------------------------------------------
handlers.Equip = function(player, uid)
	Weapons.Equip(player, uid)
	Cosmetics.Apply(player)
end

handlers.Scrap = function(player, uid)
	Weapons.Scrap(player, uid)
end

handlers.EquipArmor = function(player, uid)
	Weapons.EquipArmor(player, uid)
	Actions.ApplyCharacter(player)
end

handlers.ScrapArmor = function(player, uid)
	Weapons.ScrapArmor(player, uid)
end

handlers.BuyPower = function(player)
	Monetization.PromptPowerTier(player)
end

---------------------------------------------------------------------
-- CUSTOM PROXIMITY PROMPTS (client fires Interact after Triggered)
---------------------------------------------------------------------
local PANEL_FOR = { Upgrades = "Upgrades", Race = "Race", Rebirth = "Rebirth", Index = "Index", Forge = "Forge", Dungeon = "Dungeon" }

handlers.Interact = function(player, prompt)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then
		return
	end
	if not prompt:IsDescendantOf(map.Root) then
		return
	end
	local parent = prompt.Parent
	local pos = parent and (parent:IsA("BasePart") and parent.Position or (parent:IsA("Attachment") and parent.WorldPosition))
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not pos or not root or (root.Position - pos).Magnitude > prompt.MaxActivationDistance + 6 then
		return
	end
	local action = prompt:GetAttribute("Action")
	if action == "Sell" then
		Net.FX(player, "OpenPanel", { Name = "Backpack", Mode = "Sell" })
	elseif action == "Tower" then
		TowerService.Start(player)
	elseif PANEL_FOR[action] then
		Net.FX(player, "OpenPanel", { Name = PANEL_FOR[action] })
	end
end

---------------------------------------------------------------------
local lastRequests: { [Player]: { number } } = {}

function Actions.Handle(player: Player, action, arg)
	if type(action) ~= "string" or not DataService.Get(player) then
		return
	end
	-- simple rate limit: 25 requests per second
	local t = os.clock()
	local list = lastRequests[player]
	if not list then
		list = {}
		lastRequests[player] = list
	end
	while list[1] and t - list[1] > 1 do
		table.remove(list, 1)
	end
	if #list >= 25 then
		return
	end
	table.insert(list, t)

	local fn = handlers[action]
	if fn then
		local ok, err = pcall(fn, player, arg)
		if not ok then
			warn("[Actions] " .. action .. " failed: " .. tostring(err))
		end
	end
end

function Actions.PlayerRemoving(player: Player)
	lastRequests[player] = nil
end

function Actions.Init(m)
	map = m
	Net.Request.OnServerEvent:Connect(Actions.Handle)
	Net.Interact.OnServerEvent:Connect(function(player, prompt)
		Actions.Handle(player, "Interact", prompt)
	end)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Admin (ModuleScript) -> ServerScriptService/Server/Admin
-- Admin panel backend. Every command is re-checked on the server
-- (Admin.IsAdmin), so the client panel is only a remote control.
-- Admins: the place owner, anyone in Studio, Config.Admins.UserIds, or a
-- group rank >= Config.Admins.MinRank.
--
-- Player commands (target = you, a player, or "All"):
--   give Coins / Power / Rebirths / Ascensions / Rerolls / Overdrive /
--   Catalysts / Ores / a Weapon / an Armor, unlock stages, heal, god mode,
--   speed boost, teleport to / bring, reset data.
-- "Admin abuse" (whole server):
--   2x Luck / 3x Coins / 5x Power / 2x Drops events, Ore Rain, Coin Rain,
--   Boss Invasion at spawn, Everyone Overdrive, Kill All, announcements.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local Util = require(script.Parent:WaitForChild("Util"))

local Admin = {}
Admin.OnApplyCharacter = nil :: ((Player) -> ())?
Admin.OnCosmetics = nil :: ((Player) -> ())?

local map = nil
local GOLD = Color3.fromRGB(255, 215, 90)
local calls = {}
local groupCache: { [number]: { [number]: number } } = {} -- [userId] = { [groupId] = rank }

-- Group ranks are fetched once per player (web call) and cached.
local function rankIn(player: Player, groupId: number): number
	local ranks = groupCache[player.UserId]
	if not ranks then
		ranks = {}
		local ok, groups = pcall(GroupService.GetGroupsAsync, GroupService, player.UserId)
		if ok and type(groups) == "table" then
			for _, g in ipairs(groups) do
				ranks[g.Id] = g.Rank
			end
			groupCache[player.UserId] = ranks
		end
	end
	return ranks[groupId] or 0
end

function Admin.IsAdmin(player: Player): boolean
	local A = Config.Admins
	if A.StudioIsAdmin and RunService:IsStudio() then
		return true
	end
	if A.OwnerIsAdmin then
		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			return true
		end
		if game.CreatorType == Enum.CreatorType.Group then
			if rankIn(player, game.CreatorId) == 255 then
				return true
			end
		end
	end
	if table.find(A.UserIds, player.UserId) then
		return true
	end
	if A.GroupId and A.GroupId ~= 0 then
		if rankIn(player, A.GroupId) >= A.MinRank then
			return true
		end
	end
	return false
end

local function targets(admin: Player, target): { Player }
	if target == "All" then
		return Players:GetPlayers()
	end
	if type(target) == "number" then
		local p = Players:GetPlayerByUserId(target)
		return p and { p } or {}
	end
	return { admin }
end

local function num(v, default: number, max: number?): number
	local n = tonumber(v) or default
	if n ~= n or n == math.huge then
		n = default
	end
	return math.clamp(n, 0, max or 1e300)
end

local function changed(p: Player)
	DataService.MarkDirty(p)
end

---------------------------------------------------------------------
-- PLAYER COMMANDS
---------------------------------------------------------------------
local cmd = {}

cmd.GiveCoins = function(_, p, args)
	local data = DataService.Get(p)
	data.Coins += num(args.Amount, 1000)
	changed(p)
end

cmd.GivePower = function(_, p, args)
	local data = DataService.Get(p)
	data.Power += num(args.Amount, 1000)
	changed(p)
end

cmd.GiveRebirths = function(_, p, args)
	local data = DataService.Get(p)
	data.Rebirths += math.floor(num(args.Amount, 1, 1e6))
	data.Rebirths = math.max(0, data.Rebirths)
	changed(p)
	if Admin.OnCosmetics then
		Admin.OnCosmetics(p)
	end
end

cmd.GiveAscensions = function(_, p, args)
	local data = DataService.Get(p)
	data.Ascensions += math.floor(num(args.Amount, 1, 1000))
	changed(p)
	if Admin.OnCosmetics then
		Admin.OnCosmetics(p)
	end
end

cmd.GiveRerolls = function(_, p, args)
	local data = DataService.Get(p)
	data.Rerolls += math.floor(num(args.Amount, 5, 1e6))
	changed(p)
end

cmd.GiveOverdrive = function(_, p, args)
	local data = DataService.Get(p)
	data.Overdrive += math.floor(num(args.Amount, 3, 1e6))
	changed(p)
end

cmd.GiveCatalysts = function(_, p, args)
	local data = DataService.Get(p)
	local n = math.floor(num(args.Amount, 1, 1e5))
	for _, key in ipairs(Config.CatalystOrder) do
		data.Keys[key] = (data.Keys[key] or 0) + n
	end
	changed(p)
end

cmd.GiveOre = function(_, p, args)
	local data = DataService.Get(p)
	local ore = type(args.Ore) == "string" and Config.OreById[args.Ore]
	if not ore then
		return
	end
	-- admin ore bypasses the bag limit
	data.Backpack[ore.Id] = (data.Backpack[ore.Id] or 0) + math.floor(num(args.Amount, 10, 1e6))
	data.Index[ore.Id] = true
	changed(p)
end

cmd.GiveAllOres = function(_, p, args)
	local data = DataService.Get(p)
	local n = math.floor(num(args.Amount, 3, 1e5))
	for _, ore in ipairs(Config.Ores) do
		data.Backpack[ore.Id] = (data.Backpack[ore.Id] or 0) + n
		data.Index[ore.Id] = true
	end
	changed(p)
end

cmd.GiveWeapon = function(_, p, args)
	local def = type(args.Weapon) == "string" and Config.WeaponById[args.Weapon]
	local rarity = type(args.Rarity) == "string" and Config.WeaponRarityById[args.Rarity]
	if not def or not rarity then
		return
	end
	-- a strong, clean effect roll so admin weapons feel special
	local effects = {}
	if type(args.Effect) == "string" and Config.Effects[args.Effect] then
		effects[args.Effect] = 30
	end
	local uid = Weapons.Add(p, def.Id, rarity.Id, effects)
	if uid then
		Net.FX(p, "ForgeResult", { Uid = uid, Weapon = def.Id, Rarity = rarity.Id, Effects = effects, Gained = 0, From = 0, To = 0, Admin = true })
	end
end

cmd.GiveArmor = function(_, p, args)
	local def = type(args.Armor) == "string" and Config.ArmorById[args.Armor]
	local rarity = type(args.Rarity) == "string" and Config.WeaponRarityById[args.Rarity]
	if not def or not rarity then
		return
	end
	if Weapons.AddArmor(p, def.Id, rarity.Id) then
		Net.FX(p, "ArmorDrop", { Armor = def.Id, Rarity = rarity.Id })
	end
end

-- sets the deepest floor reached (unlocks the checkpoints below it)
cmd.SetFloor = function(_, p, args)
	local data = DataService.Get(p)
	data.BestFloor = math.clamp(math.floor(num(args.Amount, 100)), 0, 100000)
	changed(p)
end

cmd.Heal = function(_, p)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Health = hum.MaxHealth
	end
end

cmd.God = function(_, p)
	local s = DataService.Session(p)
	if s then
		s.God = not s.God
		p:SetAttribute("God", s.God)
		Net.Notify(p, "God mode " .. (s.God and "ON" or "OFF"), GOLD)
	end
end

cmd.Speed = function(_, p)
	local s = DataService.Session(p)
	if s then
		s.AdminSpeed = not s.AdminSpeed
		if Admin.OnApplyCharacter then
			Admin.OnApplyCharacter(p)
		end
		Net.Notify(p, "Speed boost " .. (s.AdminSpeed and "ON" or "OFF"), GOLD)
	end
end

cmd.GoTo = function(admin, p)
	local char = p.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and p ~= admin then
		Util.Teleport(admin, root.CFrame * CFrame.new(0, 0, 5), p.DisplayName)
	end
end

cmd.Bring = function(admin, p)
	local char = admin.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and p ~= admin then
		Util.Teleport(p, root.CFrame * CFrame.new(0, 0, -5), "Summoned by an admin")
	end
end

cmd.ResetData = function(_, p)
	local data = DataService.Get(p)
	for _, key in ipairs({ "Power", "Coins", "Blade", "Rebirths", "Ascensions", "Runes", "BestFloor", "Kills", "TowerBest" }) do
		data[key] = 0
	end
	data.Backpack = {}
	data.Mastery = {}
	changed(p)
	Net.Notify(p, "Your progress was reset by an admin.", Color3.fromRGB(255, 120, 90), "Error")
end

---------------------------------------------------------------------
-- ADMIN ABUSE (server-wide)
---------------------------------------------------------------------
local global = {}

local function syncAll()
	for _, p in ipairs(Players:GetPlayers()) do
		DataService.MarkDirty(p)
	end
end

global.StartEvent = function(_, args)
	local key = args.Event
	local ev = type(key) == "string" and Config.Events[key]
	if not ev then
		return
	end
	local duration = math.clamp(num(args.Amount, ev.Duration / 60) * 60, 30, 6 * 3600)
	Stats.ActiveEvents[key] = { EndsAt = Stats.Now() + duration, Mult = ev.Mult }
	Net.FXAll("Event", { Key = key, Name = ev.Name, Color = ev.Color, EndsAt = Stats.Now() + duration })
	syncAll()
end

global.StopEvents = function()
	table.clear(Stats.ActiveEvents)
	Net.FXAll("Notify", { Text = "All server events ended.", Color = GOLD })
	syncAll()
end

global.Announce = function(admin, args)
	local text = type(args.Text) == "string" and args.Text:sub(1, 80) or ""
	if text == "" then
		return
	end
	-- run through Roblox text filtering before broadcasting
	local ok, filtered = pcall(function()
		local result = game:GetService("TextService"):FilterStringAsync(text, admin.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	Net.FXAll("Announce", { Text = ok and filtered or "###", From = admin.DisplayName })
end

global.OreRain = function()
	for _, p in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(p)
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if data and root then
			local stage = Config.Floor(math.max(1, data.BestFloor or 1))
			for _ = 1, 12 do
				local a = math.random() * math.pi * 2
				local r = 4 + math.random() * 10
				Loot.Drop(p, Loot.RollOre(stage.Drops, Stats.Luck(p) * 2), root.Position + Vector3.new(math.cos(a) * r, -1.5, math.sin(a) * r))
			end
		end
	end
	Net.FXAll("AdminAbuse", { Kind = "OreRain" })
end

global.CoinRain = function()
	for _, p in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(p)
		if data then
			local coins = math.floor(2000 * Stats.CoinMult(p) * (1 + (data.BestFloor or 0)))
			data.Coins += coins
			Net.FX(p, "Reward", { Coins = coins, Pos = (p.Character and p.Character:GetPivot().Position) or Vector3.zero })
			DataService.MarkDirty(p)
		end
	end
	Net.FXAll("AdminAbuse", { Kind = "CoinRain" })
end

global.EveryoneOverdrive = function()
	for _, p in ipairs(Players:GetPlayers()) do
		local s = DataService.Session(p)
		local data = DataService.Get(p)
		if s and data then
			s.OverdriveEnd = Stats.Now() + Stats.OverdriveDuration(p)
			Net.FXAll("Transform", { Player = p, Kind = "Overdrive", Color = Stats.Race(data).Color })
			if Admin.OnApplyCharacter then
				Admin.OnApplyCharacter(p)
			end
			DataService.MarkDirty(p)
		end
	end
end

global.KillAll = function(admin)
	EnemyService.KillAll(admin)
end

global.BossInvasion = function()
	-- scale HP to the strongest player online so it is a real server fight
	local best = 1
	for _, p in ipairs(Players:GetPlayers()) do
		best = math.max(best, Stats.Damage(p))
	end
	local stage = Config.Floor(math.random(1, #Config.Zones * 5) * Config.Dungeon.BossEvery)
	local stageIndex = stage.Index
	local R = Config.World.PlazaRadius
	local boss
	boss = EnemyService.Create({
		Label = "INVASION: " .. stage.Enemy,
		Look = stage.Look,
		Color = Color3.fromRGB(255, 60, 80),
		Scale = 3.4,
		HP = best * 400 * math.max(1, #Players:GetPlayers()),
		Boss = true,
		Position = Vector3.new(0, 1.6, -8),
		Min = Vector3.new(-R + 8, 1.6, -R + 8),
		Max = Vector3.new(R - 8, 1.6, R - 8),
		Speed = 14,
		HitPercent = 0.05,
		OnDeath = function()
			for p in pairs(boss and boss.Damagers or {}) do
				local data = DataService.Get(p)
				if data and p.Parent then
					local coins = math.floor(10000 * Stats.CoinMult(p) * (1 + (data.BestFloor or 0)))
					data.Coins += coins
					data.Keys.RareScroll = (data.Keys.RareScroll or 0) + 1
					if math.random() < 0.3 then
						data.Keys.Legendary = (data.Keys.Legendary or 0) + 1
					end
					EnemyService.GearDrop(p, 1)
					Net.FX(p, "Reward", { Coins = coins, Pos = Vector3.new(0, 4, -8) })
					DataService.MarkDirty(p)
				end
			end
			Net.FXAll("Notify", { Text = "The invasion was defeated! Everyone who helped got loot.", Color = GOLD, Sound = "BossKill" })
		end,
	})
	Net.FXAll("BossSpawn", { Name = "INVASION: " .. stage.Enemy, Floor = stageIndex, Zone = 0, Pos = Vector3.new(0, 4, -8), Color = stage.Color, Global = true })
end

---------------------------------------------------------------------
local function handle(admin: Player, action, args)
	if type(action) ~= "string" then
		return
	end
	if not Admin.IsAdmin(admin) then
		warn("[Admin] rejected command from non-admin " .. admin.Name)
		return
	end
	-- light rate limit so a stuck button can't flood the server
	local t = os.clock()
	local list = calls[admin] or {}
	calls[admin] = list
	while list[1] and t - list[1] > 1 do
		table.remove(list, 1)
	end
	if #list >= 12 then
		return
	end
	table.insert(list, t)
	args = type(args) == "table" and args or {}

	if cmd[action] then
		for _, p in ipairs(targets(admin, args.Target)) do
			if DataService.Get(p) then
				cmd[action](admin, p, args)
			end
		end
	elseif global[action] then
		global[action](admin, args)
	else
		return
	end
	print(("[Admin] %s ran %s"):format(admin.Name, action))
end

function Admin.PlayerAdded(player: Player)
	task.spawn(function()
		player:SetAttribute("IsAdmin", Admin.IsAdmin(player))
		DataService.MarkDirty(player)
	end)
end

function Admin.Init(m)
	map = m
	Net.Admin.OnServerEvent:Connect(function(player, action, args)
		local ok, err = pcall(handle, player, action, args)
		if not ok then
			warn("[Admin] " .. tostring(action) .. " failed: " .. tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		calls[p] = nil
		groupCache[p.UserId] = nil
	end)
	local _ = map
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Combat (ModuleScript) -> ServerScriptService/Server/Combat
-- Server-authoritative abilities bound on the client with ContextActionService:
--   LMB  basic attack / combo (also trains Power)
--   Q    dash (short i-frames)
--   E    weapon skill (signature skill on iconic weapons)
--   R    class ultimate
--   C    Overdrive (handled in Actions)
-- Stamina, cooldowns (with the global nerf multipliers), stun caps and
-- damage caps are all enforced here, and so are the ore effects forged into
-- the equipped weapon (burn, frost, shock, poison, bleed, lifesteal, echo,
-- radiant splash, void execute, titan, gale...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local Projectiles = require(script.Parent:WaitForChild("Projectiles"))

local Combat = {}
local map = nil
local B = Config.Balance

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include
wallParams.RespectCanCollide = true

---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function rootOf(player: Player): BasePart?
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then
		return nil
	end
	return c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

local function readAim(payload, root: BasePart): Vector3
	local aim = type(payload) == "table" and payload.Aim
	if typeof(aim) == "Vector3" and aim.Magnitude > 0.5 and aim.Magnitude < 2 then
		-- horizontal: projectiles fly at chest height and never dive into the floor
		return flat(aim)
	end
	return flat(root.CFrame.LookVector)
end

local function limitByWalls(from: Vector3, dir: Vector3, dist: number): number
	local hit = workspace:Raycast(from, dir * dist, wallParams)
	if hit then
		return math.max(0, (hit.Position - from).Magnitude - 2)
	end
	return dist
end

function Combat.PadAt(player: Player)
	local root = rootOf(player)
	if not root or not map then
		return nil, nil
	end
	local pos = root.Position
	for _, pad in ipairs(map.TrainPads) do
		local d = Vector3.new(pos.X - pad.Position.X, 0, pos.Z - pad.Position.Z).Magnitude
		if d <= Config.TrainPadRadius and math.abs(pos.Y - pad.Position.Y) < 7 then
			return pad.Index, pad.Config
		end
	end
	return nil, nil
end

local function padReqText(pad): string
	if (pad.Ascensions or 0) > 0 then
		return pad.Ascensions .. " Ascension" .. (pad.Ascensions > 1 and "s" or "")
	end
	return pad.Rebirths .. " Rebirth" .. (pad.Rebirths > 1 and "s" or "")
end

local function spendStamina(player: Player, s, cost: number): boolean
	if s.Stamina < cost then
		Net.FX(player, "NoStamina", {})
		return false
	end
	s.Stamina -= cost
	s.LastStaminaSpend = os.clock()
	player:SetAttribute("Stamina", math.floor(s.Stamina))
	return true
end

local function proc(e, effectId: string)
	Net.FXAll("Proc", { Pos = e.Root.Position + Vector3.new(0, e.Scale, 0), Effect = effectId })
end

local function heal(player: Player, fraction: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and fraction > 0 then
		hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * fraction)
	end
end

-- One damage instance with crits, race passives, weapon passives and the
-- weapon's ore effects. opts.NoProc stops effects re-triggering on splashes.
local function hit(player: Player, e, coef: number, opts): boolean
	if e.Dead or not EnemyService.CanDamage(player, e) then
		return false
	end
	local data = DataService.Get(player)
	local race = Stats.Race(data)
	local E = function(id)
		return Stats.Effect(player, id)
	end
	local dmg = Stats.Damage(player) * coef * (0.92 + math.random() * 0.16)
	local crit = math.random() < Stats.CritChance(player)
	if crit then
		dmg *= Stats.CritMult()
	end
	if race.FirstHit and e.HP >= e.MaxHP then
		dmg *= race.FirstHit
		crit = true
	end
	if e.Boss then
		dmg *= 1 + E("Titan")
		if Stats.HasPassive(player, "OniWrath") then
			dmg *= 1.3
		end
	end
	EnemyService.Damage(e, player, dmg, crit)

	if opts then
		if opts.Knockback and opts.From then
			EnemyService.Knockback(e, flat(e.Root.Position - opts.From), opts.Knockback)
		end
		if opts.Stun then
			EnemyService.Stun(e, opts.Stun)
		end
		if opts.Pull then
			EnemyService.Pull(e, opts.Pull, 40)
		end
		if opts.Ragdoll then
			EnemyService.Ragdoll(e, opts.Ragdoll)
		end
		if opts.Ticks then
			EnemyService.DoT(e, player, Stats.Damage(player) * opts.Ticks.Damage, opts.Ticks.Count, opts.Ticks.Interval)
		end
	end
	if (opts and opts.Burn or Stats.HasPassive(player, "Hellfire")) and math.random() < 0.2 then
		EnemyService.DoT(e, player, Stats.Damage(player) * 0.3, 3, 0.4, Color3.fromRGB(190, 80, 255))
	end
	if opts and opts.NoProc then
		return true
	end

	-- ore effects ------------------------------------------------------
	local base = Stats.Damage(player)
	if math.random() < E("Burn") then
		EnemyService.DoT(e, player, base * 0.3, 3, 0.4, Color3.fromRGB(255, 120, 40))
	end
	if math.random() < E("Frost") then
		EnemyService.Slow(e, 1.5)
		proc(e, "Frost")
	end
	if math.random() < E("Poison") then
		EnemyService.DoT(e, player, base * 0.15, 4, 0.5, Color3.fromRGB(120, 230, 90))
	end
	local bleed = E("Bleed")
	if crit and bleed > 0 then
		EnemyService.DoT(e, player, dmg * bleed / 3, 3, 0.35, Color3.fromRGB(220, 30, 50))
	end
	if math.random() < E("Shock") then
		local best, bestD = nil, 16
		for _, other in ipairs(EnemyService.InSphere(e.Root.Position, 16)) do
			local d = (other.Root.Position - e.Root.Position).Magnitude
			if other ~= e and d < bestD and EnemyService.CanDamage(player, other) then
				best, bestD = other, d
			end
		end
		if best then
			Net.FXAll("Chain", { From = e.Root.Position, To = best.Root.Position, Color = Config.Effects.Shock.Color })
			hit(player, best, coef * 0.5, { NoProc = true })
		end
	end
	local radiant = E("Radiant")
	if radiant > 0 then
		for _, other in ipairs(EnemyService.InSphere(e.Root.Position, 8)) do
			if other ~= e then
				hit(player, other, coef * radiant, { NoProc = true })
			end
		end
		proc(e, "Radiant")
	end
	if math.random() < E("Echo") and not e.Dead then
		task.delay(0.12, function()
			if not e.Dead then
				hit(player, e, coef, { NoProc = true })
				proc(e, "Echo")
			end
		end)
	end
	if Stats.HasPassive(player, "Binding") and math.random() < 0.15 then
		EnemyService.Stun(e, 0.4)
	end
	heal(player, E("Lifesteal") + Stats.ArmorBonus(player, "Lifesteal"))
	local void = E("Void")
	if void > 0 and not e.Dead and not e.Boss and e.HP / e.MaxHP < void then
		proc(e, "Void")
		EnemyService.Damage(e, player, e.HP + 1, true)
	end
	return true
end

local function notifyBlocked(player: Player, s, e)
	local t = os.clock()
	if e.Owner and e.Owner ~= player and t - (s.LastBlockedNotify or 0) > 3 then
		s.LastBlockedNotify = t
		Net.Notify(player, "That enemy belongs to someone else's fight.", Color3.fromRGB(255, 120, 90), "Error")
	end
end

local function hitList(player: Player, s, list, coef: number, opts)
	for _, e in ipairs(list) do
		if not hit(player, e, coef, opts) and not e.Dead then
			notifyBlocked(player, s, e)
		end
	end
end

---------------------------------------------------------------------
-- BASIC ATTACK (LMB)
---------------------------------------------------------------------
local function train(player: Player, data)
	local padIndex, pad = Combat.PadAt(player)
	local mult = 1
	if pad and Stats.PadUnlocked(data, pad) then
		mult = pad.Mult
	else
		padIndex = nil
	end
	local gain = Config.ClickPower * mult * Stats.PowerMult(player)
	data.Power += gain
	Net.FX(player, "Power", { Amount = gain, Pad = padIndex })
end

local function basicAttack(player: Player, payload)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not data or not s or not root or os.clock() < s.StunnedUntil then
		return
	end
	local def, rarity = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local interval = class.Interval / (1 + Stats.AttackSpeed(player))
	local t = os.clock()
	if t - s.LastAttack < interval * 0.8 then
		return
	end
	if t - s.LastAttack > interval * 2.5 then
		s.Combo = 0
	end
	s.LastAttack = t
	s.Combo = s.Combo % #class.Combo + 1
	s.SwingCount += 1
	local coef = class.Combo[s.Combo]
	local aim = readAim(payload, root)

	train(player, data)

	local pierceBonus = Stats.Effect(player, "Pierce")
	if class.Kind == "Ranged" then
		local origin = root.Position + Vector3.new(0, 1.2, 0) + aim * 2
		local pierce = (Stats.HasPassive(player, "LoneWolf") and 1 or 0) + math.floor(pierceBonus * 10)
		local explode = class.Explode and class.Explode * (Stats.HasPassive(player, "Psycho") and 1.5 or 1) or nil
		local shots = class.Multi or 1
		for k = 1, shots do
			local yaw = shots > 1 and math.rad((k - (shots + 1) / 2) * 10) or 0
			local dir = (CFrame.lookAt(Vector3.zero, aim) * CFrame.Angles(0, yaw, 0)).LookVector
			Projectiles.Fire({
				Owner = player,
				Origin = origin,
				Dir = dir,
				Speed = class.Speed,
				Range = class.Range,
				Radius = class.Radius,
				Pierce = pierce > 0 and pierce or nil,
				Kind = class.Projectile,
				Color = def.Glow or rarity.Color,
				Size = 1.2,
				Explode = explode,
				OnHit = function(e)
					if not hit(player, e, coef) then
						notifyBlocked(player, s, e)
					end
				end,
				OnExplode = explode and function(pos, radius)
					hitList(player, s, EnemyService.InSphere(pos, radius), coef * 0.5, { NoProc = true })
				end or nil,
			})
		end
	else
		local dir = flat(aim)
		local kb = (class.Knockback or 0) + Stats.Effect(player, "Gale")
		hitList(player, s, EnemyService.InCone(root.Position, dir, class.Range * (1 + pierceBonus), class.Arc), coef, kb > 0 and { Knockback = kb, From = root.Position } or nil)
	end

	-- Sorcerer race: every Nth swing is an elemental AoE
	local race = Stats.Race(data)
	local heavy = race.AoEEvery ~= nil and s.SwingCount % race.AoEEvery == 0
	if heavy then
		hitList(player, s, EnemyService.InSphere(root.Position, 18), 1.5, nil)
	end

	Net.FXAll("Attack", { Player = player, Class = def.Class, Combo = s.Combo, Dir = aim, Color = def.Glow or rarity.Color, Heavy = heavy })
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
-- DASH (Q)
---------------------------------------------------------------------
local function dash(player: Player, payload)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not s or not root then
		return
	end
	local t = os.clock()
	if (s.Cooldowns.Q or 0) > t + 0.1 then
		return
	end
	if not spendStamina(player, s, Stats.StaminaCost(player, B.DashStamina)) then
		return
	end
	local dashCd = B.DashCooldown * B.CooldownMult * (Stats.HasPassive(player, "Raijin") and 0.6 or 1)
	s.Cooldowns.Q = t + dashCd
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + B.DashIFrames)
	Net.FX(player, "Cooldown", { Slot = "Q", Duration = dashCd })
	Net.FXAll("Dash", { Player = player, Dir = readAim(payload, root) })
end

---------------------------------------------------------------------
-- SKILLS (E / R)
---------------------------------------------------------------------
local executors = {}

executors.Cone = function(player, s, skill, root, aim)
	local dir = flat(aim)
	local hits = skill.Hits or 1
	task.spawn(function()
		for i = 1, hits do
			if i > 1 then
				task.wait(skill.Interval or 0.1)
			end
			local r = rootOf(player)
			if not r then
				return
			end
			hitList(player, s, EnemyService.InCone(r.Position, dir, skill.Range, skill.Arc or 0), skill.Damage, { Knockback = skill.Knockback, From = r.Position, Stun = skill.Stun, Pull = skill.PullIn and r.Position or nil })
		end
	end)
end

executors.Nova = function(player, s, skill, root)
	local hits = skill.Hits or 1
	task.spawn(function()
		for i = 1, hits do
			if i > 1 then
				task.wait(skill.Interval or 0.12)
			end
			local r = rootOf(player)
			if not r then
				return
			end
			hitList(player, s, EnemyService.InSphere(r.Position, skill.Radius), skill.Damage, {
				Knockback = skill.Knockback,
				From = r.Position,
				Stun = skill.Stun,
				Pull = skill.Pull and r.Position or nil,
			})
		end
	end)
end

local function fireSkillProjectile(player, s, skill, origin: Vector3, dir: Vector3, coef: number, size: number?)
	Projectiles.Fire({
		Owner = player,
		Origin = origin,
		Dir = dir,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = skill.Radius,
		Pierce = skill.Pierce,
		Kind = skill.Projectile,
		Color = skill.Color,
		Size = size or skill.Size,
		Explode = skill.Explode and skill.Explode * (Stats.HasPassive(player, "Psycho") and 1.5 or 1) or nil,
		OnHit = function(e)
			if not hit(player, e, coef, { Knockback = skill.Knockback, From = origin }) then
				notifyBlocked(player, s, e)
			end
		end,
		OnExplode = function(pos, radius)
			hitList(player, s, EnemyService.InSphere(pos, radius), coef * 0.5, { Knockback = 40, From = pos })
		end,
	})
end

executors.Projectile = function(player, s, skill, root, aim, charge)
	local frac = skill.Charge and math.clamp((charge or 0) / skill.Charge, 0, 1) or 0
	local coef = skill.Damage * (1 + (skill.ChargeBonus or 0) * frac)
	local size = (skill.Size or 1.5) * (1 + frac * 0.6)
	fireSkillProjectile(player, s, skill, root.Position + Vector3.new(0, 1.2, 0) + aim * 2.5, aim, coef, size)
end

executors.Barrage = function(player, s, skill, _root, aim)
	local count = skill.Count
	local gap = skill.Duration / count
	task.spawn(function()
		for i = 1, count do
			local r = rootOf(player)
			if not r then
				return
			end
			local dir
			if skill.Spread >= 360 then
				local a = (i / count) * math.pi * 2 * 3
				dir = Vector3.new(math.cos(a), 0, math.sin(a))
			else
				local yaw = math.rad((math.random() - 0.5) * skill.Spread)
				local pitch = math.rad((math.random() - 0.5) * skill.Spread * 0.25)
				dir = (CFrame.lookAt(Vector3.zero, aim) * CFrame.Angles(pitch, yaw, 0)).LookVector
			end
			fireSkillProjectile(player, s, skill, r.Position + Vector3.new(0, 1.2, 0) + dir * 2, dir, skill.Damage)
			task.wait(gap)
		end
	end)
end

executors.DashStrike = function(player, s, skill, root, aim)
	local dir = flat(aim)
	local start = root.Position
	local dist = limitByWalls(start, dir, skill.Distance)
	local finish = start + dir * dist
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + 0.15)
	task.delay(0.08, function()
		hitList(player, s, EnemyService.InSegment(start, finish, skill.Width / 2), skill.Damage, { Knockback = skill.Knockback, From = start, Burn = skill.Burn or Stats.HasPassive(player, "DragonBlood") })
	end)
	return { Finish = finish }
end

executors.ChargeLunge = function(player, s, skill, root, aim, charge)
	local dir = flat(aim)
	local start = root.Position
	local dist = limitByWalls(start, dir, skill.Distance)
	local finish = start + dir * dist
	local frac = math.clamp((charge or 0) / skill.Charge, 0, 1)
	local coef = skill.Damage * (1 + (skill.ChargeBonus or 0) * frac)
	s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + 0.2)
	task.delay(0.12, function()
		local targets = EnemyService.InSegment(start, finish, skill.Width / 2)
		local first = nil
		local best = math.huge
		for _, e in ipairs(targets) do
			local d = (e.Root.Position - start).Magnitude
			if d < best and EnemyService.CanDamage(player, e) then
				first, best = e, d
			end
		end
		if not first then
			return
		end
		local impact = first.Root.Position
		hit(player, first, coef, { Knockback = skill.Knockback * (0.6 + frac * 0.4), From = start, Ragdoll = skill.Ragdoll, Ticks = skill.Ticks })
		for _, e in ipairs(EnemyService.InSphere(impact, 9)) do
			if e ~= first then
				hit(player, e, coef * 0.4, { Knockback = 50, From = impact })
			end
		end
		Net.FXAll("Impact", { Pos = impact, Color = skill.Color, Radius = 12, Kind = "Rasengan" })
	end)
	return { Finish = finish }
end

local function targetPoint(root: BasePart, aim: Vector3, payload, range: number): Vector3
	local tp = type(payload) == "table" and payload.Target
	if typeof(tp) == "Vector3" and (tp - root.Position).Magnitude <= range + 5 then
		return Vector3.new(tp.X, root.Position.Y - 2.5, tp.Z)
	end
	local p = root.Position + flat(aim) * range * 0.6
	return Vector3.new(p.X, root.Position.Y - 2.5, p.Z)
end

executors.Zone = function(player, s, skill, root, aim, _charge, payload)
	local center = targetPoint(root, aim, payload, skill.Range)
	task.spawn(function()
		for _ = 1, skill.Ticks do
			hitList(player, s, EnemyService.InSphere(center, skill.Radius), skill.Damage, { Pull = center })
			task.wait(skill.Interval)
		end
	end)
	return { Target = center, Duration = skill.Ticks * skill.Interval }
end

executors.Rain = function(player, s, skill, root, aim, _charge, payload)
	local center = targetPoint(root, aim, payload, skill.Range)
	task.spawn(function()
		for _ = 1, skill.Hits do
			local a = math.random() * math.pi * 2
			local r = math.sqrt(math.random()) * skill.Radius
			local pt = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			Net.FXAll("Impact", { Pos = pt, Color = skill.Color, Radius = 7, Kind = "Rain" })
			hitList(player, s, EnemyService.InSphere(pt, 7), skill.Damage, nil)
			task.wait(skill.Interval)
		end
	end)
	return { Target = center }
end

local function castSkill(player: Player, slot: string, payload, charge: number?)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local root = rootOf(player)
	if not data or not s or not root or os.clock() < s.StunnedUntil then
		return
	end
	local def = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local skillId = slot == "E" and def.Skill or class.Ultimate
	local skill = Config.Skills[skillId]
	local exec = skill and executors[skill.Type]
	if not exec then
		return
	end
	local t = os.clock()
	if (s.Cooldowns[slot] or 0) > t + 0.1 then
		Net.FX(player, "AbilityFail", { Slot = slot })
		return
	end
	-- skill mastery: more damage, Adept+ = bigger area, Expert+ = cheaper
	local mastery = Stats.MasteryLevel(player, def.Class)
	local M = Config.Mastery
	local staminaCost = Stats.StaminaCost(player, skill.Stamina) * (mastery >= M.Milestones[2].Level and 0.8 or 1)
	if not spendStamina(player, s, staminaCost) then
		return
	end
	skill = table.clone(skill)
	skill.Damage = (skill.Damage or 1) * Stats.MasteryDamage(mastery)
	if mastery >= M.Milestones[1].Level then
		for _, key in ipairs({ "Range", "Radius", "Width", "Distance" }) do
			if type(skill[key]) == "number" then
				skill[key] *= 1.15
			end
		end
	end
	local cd = Stats.Cooldown(player, skillId, skill.Cooldown)
	s.Cooldowns[slot] = t + cd
	Net.FX(player, "Cooldown", { Slot = slot, Duration = cd })

	local aim = readAim(payload, root)
	local extra = exec(player, s, skill, root, aim, charge, payload) or {}
	Net.FXAll("Skill", {
		Player = player,
		Skill = skillId,
		Slot = slot,
		Pos = root.Position,
		Dir = aim,
		Charge = charge,
		Finish = extra.Finish,
		Target = extra.Target,
		Duration = extra.Duration,
		Mastery = mastery,
	})
	Combat.GrantMastery(player, M.SkillXP[slot] or 0, def.Class)
end

-- Adds skill-mastery xp to a weapon class (default: the equipped one).
function Combat.GrantMastery(player: Player, xp: number, class: string?)
	local data = DataService.Get(player)
	if not data or xp <= 0 then
		return
	end
	class = class or Stats.Weapon(player).Class
	data.Mastery = data.Mastery or {}
	local before = Config.MasteryLevel(data.Mastery[class] or 0)
	data.Mastery[class] = (data.Mastery[class] or 0) + xp
	local after = Config.MasteryLevel(data.Mastery[class])
	if after > before then
		local milestone = nil
		for _, m in ipairs(Config.Mastery.Milestones) do
			if before < m.Level and after >= m.Level then
				milestone = m
			end
		end
		Net.FX(player, "MasteryUp", { Class = class, Level = after, Milestone = milestone and milestone.Name or nil, Desc = milestone and milestone.Desc or nil })
	end
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
-- POTION
---------------------------------------------------------------------
local function potion(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not s or not hum or hum.Health <= 0 then
		return
	end
	if data.Potions <= 0 then
		Net.Notify(player, "No Health Potions. Earn them from play-time rewards!", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	if os.clock() - s.LastPotion < Config.Potion.Cooldown then
		return
	end
	s.LastPotion = os.clock()
	data.Potions -= 1
	hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * Config.Potion.Heal)
	Net.FX(player, "Potion", { Cooldown = Config.Potion.Cooldown })
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
local function onAbility(player: Player, action, payload)
	if type(action) ~= "string" then
		return
	end
	local s = DataService.Session(player)
	if not s then
		return
	end
	if action == "Attack" then
		basicAttack(player, payload)
	elseif action == "Dash" then
		dash(player, payload)
	elseif action == "Skill" or action == "Ultimate" then
		local slot = action == "Skill" and "E" or "R"
		local def = Stats.Weapon(player)
		local skillId = slot == "E" and def.Skill or Config.WeaponClasses[def.Class].Ultimate
		local skill = Config.Skills[skillId]
		if skill and not skill.Charge then
			castSkill(player, slot, payload, nil)
		end
	elseif action == "ChargeBegin" then
		local slot = type(payload) == "table" and payload.Slot
		if slot == "E" or slot == "R" then
			s.Charge[slot] = os.clock()
			Net.FXAll("Charge", { Player = player, Slot = slot })
		end
	elseif action == "ChargeRelease" then
		local slot = type(payload) == "table" and payload.Slot
		if (slot == "E" or slot == "R") and s.Charge[slot] then
			local held = os.clock() - s.Charge[slot]
			s.Charge[slot] = nil
			castSkill(player, slot, payload, held)
		end
	elseif action == "Potion" then
		potion(player)
	end
end

function Combat.Init(m)
	map = m
	wallParams.FilterDescendantsInstances = { map.Root, map.TowerArenas }
	Projectiles.SetWorld({ map.Root, map.TowerArenas })
	Net.Ability.OnServerEvent:Connect(function(player, action, payload)
		local ok, err = pcall(onAbility, player, action, payload)
		if not ok then
			warn("[Ability]", err)
		end
	end)

	EnemyService.OnKill = function(player: Player)
		local s = DataService.Session(player)
		local data = DataService.Get(player)
		local stamina = 0
		if Stats.HasPassive(player, "RiftHunger") then
			stamina += 12
		end
		if Stats.HasPassive(player, "Chakra9") then
			stamina += 10
			heal(player, 0.05)
		end
		if s and stamina > 0 then
			s.Stamina = math.min(B.MaxStamina, s.Stamina + stamina)
			player:SetAttribute("Stamina", math.floor(s.Stamina))
		end
		-- ore effects on kill
		heal(player, Stats.Effect(player, "Holy"))
		local soul = Stats.Effect(player, "Soul")
		if soul > 0 and data then
			local gain = Config.ClickPower * Stats.PowerMult(player) * soul
			data.Power += gain
			Net.FX(player, "Power", { Amount = gain })
			DataService.MarkDirty(player)
		end
	end

	-- stamina regen
	task.spawn(function()
		while true do
			local dt = task.wait(0.1)
			local t = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local s = DataService.Session(player)
				if s and s.Stamina < B.MaxStamina and t - s.LastStaminaSpend >= B.StaminaRegenDelay then
					s.Stamina = math.min(B.MaxStamina, s.Stamina + B.StaminaRegen * dt)
					local shown = math.floor(s.Stamina)
					if player:GetAttribute("Stamina") ~= shown then
						player:SetAttribute("Stamina", shown)
					end
				end
			end
		end
	end)

	-- auto-training while standing on a pad
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				local s = DataService.Session(player)
				if data and s then
					local padIndex, pad = Combat.PadAt(player)
					if pad then
						if Stats.PadUnlocked(data, pad) then
							local gain = Config.AutoTrainPerSecond * pad.Mult * Stats.PowerMult(player)
							data.Power += gain
							Net.FX(player, "Power", { Amount = gain, Pad = padIndex, Auto = true })
							DataService.MarkDirty(player)
						elseif s.Pad ~= padIndex then
							Net.Notify(player, "This pad needs " .. padReqText(pad) .. ".", Color3.fromRGB(255, 120, 90), "Error")
						end
					end
					s.Pad = padIndex or 0
				end
			end
		end
	end)
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Cosmetics (ModuleScript) -> ServerScriptService/Server/Cosmetics
-- Overhead name tag (race + title), race / ascension auras, the Overdrive
-- transformation aura and the Chroma Trail gamepass. Server-side so every
-- player can see them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))

local Cosmetics = {}

local TIER_RATE = { Common = 0, Rare = 0, Epic = 6, Legendary = 10, Mythic = 16 }

local function clear(root: Instance, prefix: string)
	for _, c in ipairs(root:GetChildren()) do
		if c.Name:sub(1, #prefix) == prefix then
			c:Destroy()
		end
	end
end

local function attachment(root: BasePart, name: string, pos: Vector3?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos or Vector3.zero
	a.Parent = root
	return a
end

local function nametag(player: Player, char: Model, data)
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("Nametag")
	if old then
		old:Destroy()
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local race = Stats.Race(data)
	local tier = Stats.Tier(data)
	local isMC = race.Id == "MainCharacter"

	-- Minimal name tag: 45% smaller, soft shadow instead of a heavy outline,
	-- faded in by Client/WorldText only when you are near the player.
	local S = Config.WorldText.FontScale
	local bb = Instance.new("BillboardGui")
	bb.Name = "Nametag"
	bb.Size = UDim2.fromOffset(240 * S, (isMC and 84 or 62) * S)
	bb.StudsOffset = Vector3.new(0, isMC and 3 or 2.6, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb:SetAttribute("Radius", Config.WorldText.NametagRadius)
	CollectionService:AddTag(bb, "WorldLabel")
	bb.Parent = head
	local fade = Instance.new("CanvasGroup")
	fade.Name = "Fade"
	fade.BackgroundTransparency = 1
	fade.Size = UDim2.fromScale(1, 1)
	fade.GroupTransparency = 1
	fade.Parent = bb
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = fade

	local function line(text: string, color: Color3, h: number, font: Enum.Font, order: number)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, h * S)
		t.Font = font
		t.TextScaled = true
		t.Text = text
		t.TextColor3 = color
		t.LayoutOrder = order
		t.Parent = fade
		local st = Instance.new("UIStroke")
		st.Thickness = 1
		st.Color = Color3.fromRGB(10, 8, 18)
		st.Transparency = 0.45
		st.Parent = t
		return t
	end
	if isMC then
		local title = line("MAIN CHARACTER", Color3.fromRGB(255, 220, 90), 20, Config.Fonts.Display, 0)
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 160)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 190, 40)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 160)),
		})
		g.Parent = title
	end
	line(player.DisplayName, Color3.new(1, 1, 1), 28, Config.Fonts.Heading, 1)
	if data.Race ~= "" then
		local tierLabel = tier.Label or tier.Id
		line(string.format("%s %s%s", tierLabel, race.Name, data.Rebirths > 0 and ("  |  R" .. data.Rebirths) or ""), tier.Id == "Common" and race.Color or tier.Color, 20, Config.Fonts.Body, 2)
	end
end

function Cosmetics.Apply(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	nametag(player, char, data)
	clear(root, "Cos_")

	local race = Stats.Race(data)
	local tier = Stats.Tier(data)
	local isMC = race.Id == "MainCharacter"

	-- race aura (Epic+ skins, and always for Main Character)
	local rate = TIER_RATE[tier.Id] or 0
	if isMC then
		rate = math.max(rate, 18)
	end
	if data.Race ~= "" and rate > 0 then
		local a = attachment(root, "Cos_RaceAura", Vector3.new(0, -1.5, 0))
		local color = isMC and Color3.fromRGB(255, 205, 60) or tier.Color
		local e = VFX.MakeEmitter("Aura", color, a, rate)
		e.Transparency = VFX.NS(0, 0.6, 0.6, 0.7, 1, 1)
		if tier.Id == "Mythic" or isMC then
			VFX.MakeEmitter("Stars", color, a, 3)
		end
	end

	-- ascension aura from rebirths
	local asc = nil
	for _, a in ipairs(Config.AscensionAuras) do
		if data.Rebirths >= a.Rebirths then
			asc = a
		end
	end
	if asc then
		local a = attachment(root, "Cos_Ascension", Vector3.new(0, -2.8, 0))
		local e = VFX.MakeEmitter("Rise", asc.Color, a, 5)
		e.Shape = Enum.ParticleEmitterShape.Cylinder
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Size = VFX.NS(0, 0.35, 1, 0)
	end

	-- chroma trail gamepass
	if Stats.HasPass(player, "ChromaTrail") then
		local a0 = attachment(root, "Cos_Trail0", Vector3.new(0, 1, 0))
		local a1 = attachment(root, "Cos_Trail1", Vector3.new(0, -1.6, 0))
		local tr = Instance.new("Trail")
		tr.Name = "Cos_ChromaTrail"
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.6
		tr.LightEmission = 1
		tr.Transparency = VFX.NS(0, 0.2, 1, 1)
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 90)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 255, 120)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(140, 90, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 200)),
		})
		tr.Parent = root
	end

	-- exclusive play-time aura (120 minute reward)
	if data.Cosmetics and data.Cosmetics.PlaytimeAura then
		local a = attachment(root, "Cos_Playtime", Vector3.new(0, -2.6, 0))
		for i, c in ipairs({ Color3.fromRGB(255, 90, 160), Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 220, 90) }) do
			local e = VFX.MakeEmitter("Rise", c, a, 3)
			e.Shape = Enum.ParticleEmitterShape.Cylinder
			e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			e.Size = VFX.NS(0, 0.3 + i * 0.05, 1, 0)
		end
	end

	-- Mythic / Celestial weapon aura
	local def, rarity = Stats.Weapon(player)
	if rarity.Aura then
		local a = attachment(root, "Cos_Mythic", Vector3.new(0, -1.2, 0))
		local color = def.Glow or rarity.Color
		local e = VFX.MakeEmitter("Aura", color, a, 22)
		e.Transparency = VFX.NS(0, 0.5, 0.6, 0.6, 1, 1)
		VFX.MakeEmitter("Sparks", color, a, 6).Speed = NumberRange.new(3, 8)
	end

	Cosmetics.RefreshTransform(player)
end

-- Overdrive / Zenkai transformation aura (on while the buff is active).
function Cosmetics.RefreshTransform(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	clear(root, "Cos_Transform")
	local overdrive = Stats.OverdriveActive(player)
	local zenkai = Stats.ZenkaiActive(player)
	if not overdrive and not zenkai then
		return
	end
	local color = zenkai and Color3.fromRGB(255, 225, 60) or Stats.Race(data).Color
	local a = attachment(root, "Cos_Transform", Vector3.new(0, -1, 0))
	local e = VFX.MakeEmitter("Aura", color, a, 45)
	e.Size = VFX.NS(0, 1.8, 0.5, 3, 1, 0)
	VFX.MakeEmitter("Sparks", color, a, 10).Speed = NumberRange.new(6, 14)
	local l = Instance.new("PointLight")
	l.Name = "Cos_TransformLight"
	l.Color = color
	l.Range = 16
	l.Brightness = 2
	l.Parent = root
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- DataService (ModuleScript) -> ServerScriptService/Server/DataService
-- DataStore-backed player profiles + per-session runtime state.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameShared"):WaitForChild("Config"))

local DataService = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore unavailable (enable Studio API access to save):", result)
	end
end

local DEFAULT = {
	Version = 1,
	Power = 0,
	Coins = 0,
	Blade = 0,
	Rebirths = 0,
	Runes = 0,
	Backpack = {}, -- [oreId] = count
	Upgrades = { Backpack = 0, Luck = 0, Training = 0 },
	Race = "",
	RaceTier = "",
	Rerolls = Config.StartingRerolls,
	Overdrive = Config.Overdrive.StartingPotions,
	Index = {}, -- [oreId] = true once unlocked in the Index
	IndexFound = {}, -- [oreId] = true once picked up (waiting to be unlocked)
	Kills = 0,
	TowerBest = 0, -- best Boss Rush wave
	-- the Dungeon
	BestFloor = 0, -- deepest floor reached (unlocks checkpoints)
	Ascensions = 0,
	Mastery = {}, -- [weaponClass] = xp
	Codes = {}, -- [CODE] = true
	StarterPack = false,
	Receipts = {}, -- recent purchase ids (dedupe)
	Settings = { Music = true, SFX = true, AutoEquip = true, Shake = true, DamageNumbers = true },
	-- weapons / loot
	Weapons = {}, -- ["w1"] = { W = weaponId, R = rarityId, E = { [effectId] = points } }
	NextWeaponId = 1,
	Equipped = "",
	Armors = {}, -- ["a1"] = { A = armorId, R = rarityId }
	NextArmorId = 1,
	EquippedArmor = "",
	Recipes = {}, -- [recipeKey] = true once discovered
	Keys = { Uncommon = 0, RareScroll = 0, Legendary = 0 },
	Potions = 1,
	BoostEnds = 0, -- 2x damage boost end (server time)
	PowerTier = 0, -- purchased 2x power tiers (multiplier = 2^PowerTier)
	-- retention
	TotalPlaytime = 0,
	LastLoginDay = 0,
	Streak = 0,
	Cosmetics = { PlaytimeAura = false },
	Explored = { Hub = true }, -- world map fog of war
}

local profiles: { [Player]: any } = {}
local sessions: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}

DataService.OnFlush = nil :: ((Player) -> ())?

local function deepCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return out
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
end

local function newSession()
	return {
		LastSwing = 0,
		SwingCount = 0,
		OverdriveEnd = 0,
		ZenkaiEnd = 0,
		ZenkaiReady = 0,
		InvulnUntil = 0,
		Passes = {},
		Drops = {},
		NextDropId = 0,
		Tower = nil,
		LastFullNotify = 0,
		Pad = 0,
		Loaded = false,
		-- combat
		Stamina = Config.Balance.MaxStamina,
		LastStaminaSpend = 0,
		Cooldowns = {},
		Charge = {},
		LastAttack = 0,
		Combo = 0,
		LastPotion = 0,
		StunnedUntil = 0,
		-- retention
		SessionTime = 0,
		PlaytimeClaimed = {},
		Run = nil, -- current dungeon run info (DungeonService)
	}
end

function DataService.Load(player: Player)
	sessions[player] = newSession()
	local data = nil
	local success = store == nil -- no store (Studio without API) -> play with fresh data
	if store then
		for attempt = 1, 4 do
			local ok, result = pcall(function()
				return store:GetAsync("Player_" .. player.UserId)
			end)
			if ok then
				data = result
				success = true
				break
			end
			warn(("[Data] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
			task.wait(attempt * 1.5)
		end
	end
	if type(data) ~= "table" then
		data = deepCopy(DEFAULT)
	end
	reconcile(data, DEFAULT)
	-- older saves tracked the 30-stage Path; carry it over as floors
	if (data.Stage or 0) > (data.BestFloor or 0) then
		data.BestFloor = data.Stage
	end
	-- older saves unlocked ores straight away
	for oreId in pairs(data.Index) do
		data.IndexFound[oreId] = true
	end
	profiles[player] = data
	canSave[player] = success and store ~= nil
	sessions[player].Loaded = true
	if not success then
		warn("[Data] could not load " .. player.Name .. " - progress will NOT be saved this session to protect old data")
	end
	return data
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync("Player_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.Session(player: Player)
	return sessions[player]
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

function DataService.Release(player: Player)
	DataService.Save(player)
	profiles[player] = nil
	sessions[player] = nil
	canSave[player] = nil
	dirty[player] = nil
end

function DataService.All()
	return profiles
end

-- Flush dirty profiles to their clients once per frame (batches many changes).
RunService.Heartbeat:Connect(function()
	for player in pairs(dirty) do
		dirty[player] = nil
		if player.Parent and profiles[player] and DataService.OnFlush then
			DataService.OnFlush(player)
		end
	end
end)

-- Autosave
task.spawn(function()
	while true do
		task.wait(120)
		for player in pairs(profiles) do
			task.spawn(DataService.Save, player)
		end
	end
end)

game:BindToClose(function()
	local threads = 0
	for _, player in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			DataService.Save(player)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DungeonService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- DungeonService (ModuleScript) -> ServerScriptService/Server/DungeonService
-- +1 Loot To Forge style dungeon runs.
--   * Enter at the lobby gate and pick a start floor (floor 1 or an unlocked
--     checkpoint: reach floor 50 to start at 25, floor 75 to start at 50...).
--   * Every player gets a private run far below the lobby, built 5 floors
--     at a time: an entry hall, four rooms and a boss room.
--   * Enemies only spawn when you walk into a room. Clear the room to open
--     the door to the next floor; beat the boss to take the stairs down.
--   * Dying or pressing HOME ends the run: you go back to the lobby and the
--     next run starts from floor 1 (or a checkpoint) again.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Util = require(script.Parent:WaitForChild("Util"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))

local DungeonService = {}
local D = Config.Dungeon
local runs: { [Player]: any } = {}
local slots: { [number]: Player } = {}
local root: Folder = nil
local RED = Color3.fromRGB(255, 110, 90)

---------------------------------------------------------------------
-- tiny part builder
---------------------------------------------------------------------
local function P(parent: Instance, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function label(part: BasePart, text: string, color: Color3, face: Enum.NormalId?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(400, 100)
	sg.LightInfluence = 0
	sg.Parent = part
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Config.Fonts.Display
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.Parent = sg
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(10, 8, 16)
	st.Parent = t
	return t
end

---------------------------------------------------------------------
-- zone decor (a few readable props per room, themed per anime zone)
---------------------------------------------------------------------
local function tree(parent, pos: Vector3, trunk: Color3, leaves: Color3, h: number)
	P(parent, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 2.4, 2.4), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = trunk, Material = Enum.Material.Wood })
	for k = 0, 2 do
		P(parent, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * (10 - k * 2.4), CFrame = CFrame.new(pos + Vector3.new((k - 1) * 1.6, h + k * 2.6, (k % 2) * 1.5)), Color = leaves:Lerp(Color3.new(1, 1, 1), k * 0.06), Material = Enum.Material.Grass, CanCollide = false })
	end
end

local function lantern(parent, pos: Vector3, color: Color3)
	P(parent, { Name = "Post", Size = Vector3.new(0.6, 7, 0.6), CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)), Color = Color3.fromRGB(50, 40, 40), Material = Enum.Material.Wood })
	local l = P(parent, { Name = "Lantern", Size = Vector3.new(1.8, 2.2, 1.8), CFrame = CFrame.new(pos + Vector3.new(0, 7.8, 0)), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	local pl = Instance.new("PointLight")
	pl.Color = color
	pl.Range = 18
	pl.Brightness = 1.3
	pl.Parent = l
end

local function decorate(parent, theme: string, zone, center: Vector3, halfW: number, len: number, rng: Random)
	local sides = { -1, 1 }
	local zs = { -len * 0.3, 0, len * 0.3 }
	if theme == "Forest" then
		for _, s in ipairs(sides) do
			for _, dz in ipairs(zs) do
				tree(parent, center + Vector3.new(s * (halfW - 5), 0, dz + rng:NextNumber(-6, 6)), Color3.fromRGB(96, 70, 48), zone.Accent:Lerp(Color3.fromRGB(60, 140, 60), 0.7), rng:NextNumber(9, 14))
			end
		end
	elseif theme == "Soul" then
		for _, s in ipairs(sides) do
			for _, dz in ipairs(zs) do
				P(parent, { Name = "Pillar", Size = Vector3.new(4, 26, 4), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 4), 13, dz)), Color = zone.Wall, Material = Enum.Material.Marble })
				lantern(parent, center + Vector3.new(s * (halfW - 9), 0, dz + 8), zone.Accent)
			end
		end
	elseif theme == "Walls" then
		for _, s in ipairs(sides) do
			P(parent, { Name = "GreatWall", Size = Vector3.new(6, 40, len), CFrame = CFrame.new(center + Vector3.new(s * (halfW + 2), 20, 0)), Color = zone.Wall, Material = Enum.Material.Cobblestone })
			for _ = 1, 3 do
				P(parent, { Name = "Rubble", Size = Vector3.new(rng:NextNumber(3, 7), rng:NextNumber(2, 5), rng:NextNumber(3, 7)), CFrame = CFrame.new(center + Vector3.new(s * rng:NextNumber(halfW * 0.5, halfW - 6), 1.5, rng:NextNumber(-len / 2 + 8, len / 2 - 8))) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), Color = zone.Wall:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.Slate })
			end
		end
	elseif theme == "Shrine" then
		for _, dz in ipairs({ -len * 0.25, len * 0.25 }) do
			local red = Color3.fromRGB(200, 40, 50)
			for _, s in ipairs(sides) do
				P(parent, { Name = "ToriiPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 1.6, 1.6), CFrame = CFrame.new(center + Vector3.new(s * 9, 8, dz)) * CFrame.Angles(0, 0, math.rad(90)), Color = red })
			end
			P(parent, { Name = "ToriiTop", Size = Vector3.new(24, 1.4, 2), CFrame = CFrame.new(center + Vector3.new(0, 16.4, dz)), Color = Color3.fromRGB(30, 24, 28) })
			P(parent, { Name = "ToriiBeam", Size = Vector3.new(21, 1, 1.4), CFrame = CFrame.new(center + Vector3.new(0, 13.6, dz)), Color = red })
		end
		for _, s in ipairs(sides) do
			for _, dz in ipairs(zs) do
				lantern(parent, center + Vector3.new(s * (halfW - 5), 0, dz), Color3.fromRGB(255, 150, 80))
				P(parent, { Name = "Wisteria", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 7, 5), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 3), 20, dz + 10)), Color = Color3.fromRGB(190, 140, 255), Material = Enum.Material.Neon, Transparency = 0.2, CanCollide = false })
			end
		end
	elseif theme == "Academy" then
		for _, dz in ipairs(zs) do
			local ring = P(parent, { Name = "CurseSigil", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 14, 14), CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-10, 10), 0.15, dz)) * CFrame.Angles(0, 0, math.rad(90)), Color = zone.Accent, Material = Enum.Material.Neon, Transparency = 0.55, CanCollide = false })
			ring.CastShadow = false
		end
		for _, s in ipairs(sides) do
			for _, dz in ipairs(zs) do
				P(parent, { Name = "Desk", Size = Vector3.new(5, 2.6, 3), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 7), 1.3, dz)) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), Color = Color3.fromRGB(120, 90, 60), Material = Enum.Material.Wood })
			end
		end
	elseif theme == "Cove" then
		for _, s in ipairs(sides) do
			P(parent, { Name = "Sea", Size = Vector3.new(14, 0.4, len), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 7), 0.25, 0)), Color = Color3.fromRGB(40, 150, 210), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false })
			for _, dz in ipairs({ -len * 0.25, len * 0.2 }) do
				local base = center + Vector3.new(s * (halfW - 16), 0, dz)
				P(parent, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, 3, 3), CFrame = CFrame.new(base + Vector3.new(0, 1.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(130, 90, 55), Material = Enum.Material.Wood })
				tree(parent, base + Vector3.new(s * 6, 0, 8), Color3.fromRGB(150, 110, 70), Color3.fromRGB(70, 170, 80), 13)
			end
		end
	elseif theme == "City" then
		for _, s in ipairs(sides) do
			for _, dz in ipairs(zs) do
				P(parent, { Name = "ACUnit", Size = Vector3.new(6, 4, 5), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 6), 2, dz)), Color = Color3.fromRGB(150, 155, 165), Material = Enum.Material.DiamondPlate })
			end
			local sign = P(parent, { Name = "NeonSign", Size = Vector3.new(0.5, 5, 16), CFrame = CFrame.new(center + Vector3.new(s * (halfW - 0.5), 14, 0)), Color = zone.Accent, Material = Enum.Material.Neon })
			sign.CastShadow = false
		end
	elseif theme == "Wastes" then
		for _ = 1, 6 do
			local s = rng:NextNumber() < 0.5 and -1 or 1
			P(parent, { Name = "Boulder", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(5, 10), CFrame = CFrame.new(center + Vector3.new(s * rng:NextNumber(halfW * 0.45, halfW - 5), 1, rng:NextNumber(-len / 2 + 8, len / 2 - 8))), Color = zone.Wall, Material = Enum.Material.Rock })
		end
		for _, dz in ipairs({ -len * 0.2, len * 0.25 }) do
			local c = P(parent, { Name = "Crater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 12, 12), CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-12, 12), 0.12, dz)) * CFrame.Angles(0, 0, math.rad(90)), Color = zone.Floor:Lerp(Color3.new(0, 0, 0), 0.35), CanCollide = false })
			c.CastShadow = false
		end
	end
end

local FLOOR_MATERIAL = { Forest = Enum.Material.Grass, Soul = Enum.Material.Marble, Walls = Enum.Material.Sand, Shrine = Enum.Material.WoodPlanks, Academy = Enum.Material.Slate, Cove = Enum.Material.Sand, City = Enum.Material.Concrete, Wastes = Enum.Material.Ground }
local WALL_MATERIAL = { Forest = Enum.Material.Wood, Soul = Enum.Material.Marble, Walls = Enum.Material.Cobblestone, Shrine = Enum.Material.Wood, Academy = Enum.Material.Brick, Cove = Enum.Material.WoodPlanks, City = Enum.Material.Concrete, Wastes = Enum.Material.Rock }

---------------------------------------------------------------------
-- building a 5-floor segment
---------------------------------------------------------------------
local function door(parent, z: number, origin: Vector3, zone, text: string, boss: boolean)
	local W = D.RoomWidth
	local frameColor = zone.Wall:Lerp(Color3.new(0, 0, 0), 0.25)
	for _, s in ipairs({ -1, 1 }) do
		P(parent, { Name = "DoorPost", Size = Vector3.new(4, 26, 4), CFrame = CFrame.new(origin + Vector3.new(s * 9, 13, z)), Color = frameColor, Material = WALL_MATERIAL[zone.Theme] or Enum.Material.Slate })
		P(parent, { Name = "DoorWall", Size = Vector3.new((W / 2 - 11), 26, 3), CFrame = CFrame.new(origin + Vector3.new(s * (11 + (W / 2 - 11) / 2), 13, z)), Color = zone.Wall, Material = WALL_MATERIAL[zone.Theme] or Enum.Material.Slate })
	end
	local lintel = P(parent, { Name = "Lintel", Size = Vector3.new(22, 4, 4), CFrame = CFrame.new(origin + Vector3.new(0, 24, z)), Color = frameColor, Material = WALL_MATERIAL[zone.Theme] or Enum.Material.Slate })
	label(lintel, text, boss and Color3.fromRGB(255, 90, 100) or Color3.fromRGB(255, 240, 210), Enum.NormalId.Back)
	local gate = P(parent, { Name = "Gate", Size = Vector3.new(14, 22, 1), CFrame = CFrame.new(origin + Vector3.new(0, 11, z)), Color = boss and Color3.fromRGB(255, 60, 80) or zone.Accent, Material = Enum.Material.ForceField, Transparency = 0.1 })
	return gate
end

local function openGate(gate: BasePart?, player: Player?)
	if gate and gate.Parent then
		gate.CanCollide = false
		gate.Transparency = 1
		if player then
			Net.FX(player, "GateOpen", { Pos = gate.Position, Color = gate.Color })
		end
	end
end

local function buildSegment(run, fromFloor: number)
	if run.Segment then
		run.Segment:Destroy()
	end
	local seg = Instance.new("Model")
	seg.Name = "Segment_" .. fromFloor
	seg.Parent = run.Folder
	run.Segment = seg
	run.Rooms = {}
	local O = run.Origin
	local W = D.RoomWidth
	local segEnd = math.ceil(fromFloor / D.BossEvery) * D.BossEvery
	local first = Config.Floor(fromFloor)
	local zone = first.ZoneData
	local rng = Random.new(fromFloor * 131 + run.Slot)

	-- entry hall
	local hallLen = D.HallLen
	P(seg, { Name = "HallFloor", Size = Vector3.new(W, 2, hallLen), CFrame = CFrame.new(O + Vector3.new(0, -1, -hallLen / 2)), Color = zone.Floor:Lerp(Color3.new(0, 0, 0), 0.15), Material = FLOOR_MATERIAL[zone.Theme] or Enum.Material.Slate })
	P(seg, { Name = "BackWall", Size = Vector3.new(W, 30, 3), CFrame = CFrame.new(O + Vector3.new(0, 15, 1.5)), Color = zone.Wall, Material = WALL_MATERIAL[zone.Theme] or Enum.Material.Slate })
	for _, s in ipairs({ -1, 1 }) do
		P(seg, { Name = "HallWall", Size = Vector3.new(3, 30, hallLen), CFrame = CFrame.new(O + Vector3.new(s * (W / 2 + 1.5), 15, -hallLen / 2)), Color = zone.Wall, Material = WALL_MATERIAL[zone.Theme] or Enum.Material.Slate })
		lantern(seg, O + Vector3.new(s * (W / 2 - 4), 0, -hallLen / 2), zone.Accent)
	end
	local sign = P(seg, { Name = "ZoneSign", Size = Vector3.new(30, 6, 1), CFrame = CFrame.new(O + Vector3.new(0, 20, 0)), Color = Color3.fromRGB(14, 12, 20) })
	label(sign, zone.Name:upper() .. (first.Cycle > 0 and "  (NIGHTMARE)" or ""), zone.Accent, Enum.NormalId.Front)
	run.SpawnCF = CFrame.new(O + Vector3.new(0, 4, -10)) * CFrame.Angles(0, 0, 0)

	local z = -hallLen
	for f = fromFloor, segEnd do
		local fd = Config.Floor(f)
		local fz = fd.ZoneData
		local len = fd.Boss and D.BossRoomLen or D.RoomLen
		local zStart, zEnd = z, z - len
		local center = O + Vector3.new(0, 0, (zStart + zEnd) / 2)
		local gate = door(seg, zStart, O, fz, (fd.Boss and "BOSS FLOOR " or "FLOOR ") .. f, fd.Boss)
		P(seg, { Name = "RoomFloor", Size = Vector3.new(W, 2, len), CFrame = CFrame.new(center + Vector3.new(0, -1, 0)), Color = fd.Boss and fz.Floor:Lerp(Color3.fromRGB(60, 10, 20), 0.35) or fz.Floor, Material = FLOOR_MATERIAL[fz.Theme] or Enum.Material.Slate })
		for _, s in ipairs({ -1, 1 }) do
			P(seg, { Name = "RoomWall", Size = Vector3.new(3, 30, len), CFrame = CFrame.new(center + Vector3.new(s * (W / 2 + 1.5), 15, 0)), Color = fz.Wall, Material = WALL_MATERIAL[fz.Theme] or Enum.Material.Slate })
		end
		decorate(seg, fz.Theme, fz, center, W / 2, len, rng)
		if fd.Boss then
			local ring = P(seg, { Name = "BossRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 44, 44), CFrame = CFrame.new(center + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 60, 80), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false })
			ring.CastShadow = false
		end
		-- spawn area keeps a margin from the walls and the door you came in
		local min = center + Vector3.new(-W / 2 + 7, 0, -len / 2 + 6)
		local max = center + Vector3.new(W / 2 - 7, 0, len / 2 - 14)
		run.Rooms[f] = { Floor = f, Data = fd, ZStart = zStart, ZEnd = zEnd, Center = center, Min = min, Max = max, Gate = gate, State = "Waiting", Enemies = {}, Alive = 0 }
		if f == fromFloor then
			openGate(gate) -- the hall leads straight into the first room
		end
		z = zEnd
	end
	-- end wall with the stairs down (revealed when the boss falls)
	local lastZone = Config.Floor(segEnd).ZoneData
	P(seg, { Name = "EndWall", Size = Vector3.new(W, 30, 3), CFrame = CFrame.new(O + Vector3.new(0, 15, z - 1.5)), Color = lastZone.Wall, Material = WALL_MATERIAL[lastZone.Theme] or Enum.Material.Slate })
	local stairs = P(seg, { Name = "Stairs", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 16, 16), CFrame = CFrame.new(O + Vector3.new(0, 0.3, z + 12)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(120, 220, 255), Material = Enum.Material.Neon, Transparency = 1, CanCollide = false, CanTouch = false })
	run.Stairs = stairs
	run.SegEnd = segEnd
end

---------------------------------------------------------------------
-- floors, spawns, clears
---------------------------------------------------------------------
local function runInfo(run)
	local room = run.Rooms[run.Floor]
	local fd = Config.Floor(run.Floor)
	return {
		Floor = run.Floor,
		Start = run.StartFloor,
		Kills = room and (room.Kills or 0) or 0,
		Need = fd.Kills,
		Boss = fd.Boss,
		Zone = fd.Zone,
		Enemy = fd.Enemy,
		State = room and room.State or "Waiting",
	}
end

local function sync(run)
	local s = DataService.Session(run.Player)
	if s then
		s.Run = runInfo(run)
	end
	DataService.MarkDirty(run.Player)
end

local function reachFloor(run, f: number)
	local data = DataService.Get(run.Player)
	if data and f > (data.BestFloor or 0) then
		data.BestFloor = f
	end
end

local onRoomCleared

local function spawnRoom(run, room)
	room.State = "Fighting"
	room.Kills = 0
	local player = run.Player
	local fd = room.Data
	reachFloor(run, room.Floor)
	Net.FX(player, "FloorStart", { Floor = room.Floor, Boss = fd.Boss, Name = fd.Enemy, Zone = fd.Zone, Color = fd.Color })
	local count = fd.Count
	room.Alive = count
	for i = 1, count do
		task.spawn(function()
			if not run.Active then
				return
			end
			local lookId = fd.Boss and fd.Look or ((fd.MixLook and i % 2 == 0) and fd.MixLook or fd.Look)
			local arch = Config.EnemyArchetypes[lookId] or {}
			local elite = not fd.Boss and math.random() < Config.EliteChance
			local size = arch.Size or 1
			local scale = fd.Boss and math.min(3.4, 1.9 * size) or (elite and 1.25 * size or size)
			local pos = fd.Boss and room.Center + Vector3.new(0, 0, -8) or Vector3.new(math.random() * (room.Max.X - room.Min.X) + room.Min.X, room.Min.Y, math.random() * (room.Max.Z - room.Min.Z) + room.Min.Z)
			Net.FX(player, "EnemySpawn", { Pos = pos + Vector3.new(0, 1, 0), Color = arch.Aura or fd.Color, Boss = fd.Boss })
			task.wait(0.35 + i * 0.08)
			if not run.Active or room.State ~= "Fighting" then
				return
			end
			local ok, enemy = pcall(EnemyService.Create, {
				Label = (elite and "ELITE " or "") .. ((fd.Cycle > 0 and "Nightmare " or "") .. (arch.Name or fd.Enemy)),
				Look = lookId,
				Color = arch.Aura or fd.Color,
				Scale = scale,
				HP = fd.HP * (elite and Config.EliteHPMult or 1),
				Boss = fd.Boss,
				Elite = elite,
				Floor = fd,
				Owner = player,
				Position = pos,
				Min = room.Min,
				Max = room.Max,
				Speed = fd.Boss and 13 or (elite and 15 or 12.5),
				HitPercent = Config.EnemyHitPercent * (fd.Boss and 1.2 or 1) + math.min(room.Floor, 200) * 0.0002,
				OnKilled = function()
					room.Kills = (room.Kills or 0) + 1
					room.Alive -= 1
					if run.Active and room.Alive <= 0 and room.State == "Fighting" then
						onRoomCleared(run, room)
					else
						sync(run)
					end
				end,
			})
			if not ok then
				-- never leave a room un-clearable because one rig failed to build
				warn("[Dungeon] enemy spawn failed:", enemy)
				room.Alive -= 1
				if run.Active and room.Alive <= 0 and room.State == "Fighting" then
					onRoomCleared(run, room)
				end
				return
			end
			if not run.Active or room.State ~= "Fighting" then
				EnemyService.Despawn(enemy)
				return
			end
			table.insert(room.Enemies, enemy)
			if fd.Boss then
				Net.FX(player, "BossSpawn", { Name = arch.Name or fd.Enemy, Floor = room.Floor, Pos = pos, Color = arch.Aura or fd.Color, Global = true })
			end
		end)
	end
	-- pre-build the next floor's rigs while this room is fought
	local nf = Config.Floor(room.Floor + 1)
	EnemyService.Prebuild(nf.Look)
	if nf.MixLook then
		EnemyService.Prebuild(nf.MixLook)
	end
	sync(run)
end

onRoomCleared = function(run, room)
	room.State = "Cleared"
	local player = run.Player
	local nextFloor = room.Floor + 1
	run.Floor = nextFloor
	run.Cleared += 1
	local nextRoom = run.Rooms[nextFloor]
	if nextRoom then
		openGate(nextRoom.Gate, player)
	else
		-- boss down: reveal the stairs to the next segment
		local stairs = run.Stairs
		if stairs then
			stairs.Transparency = 0.15
			stairs.CanTouch = true
			VFX.MakeEmitter("Rise", Color3.fromRGB(120, 220, 255), stairs, 20)
			stairs.Touched:Connect(function(hit)
				local model = hit:FindFirstAncestorOfClass("Model")
				if run.Active and model and model == player.Character and not run.Descending then
					run.Descending = true
					Net.FX(player, "Descend", { Floor = nextFloor })
					task.wait(0.35)
					if run.Active then
						buildSegment(run, nextFloor)
						Util.Teleport(player, run.SpawnCF, "Floor " .. nextFloor)
					end
					run.Descending = false
					sync(run)
				end
			end)
		end
	end
	reachFloor(run, nextFloor)
	Net.FX(player, "FloorCleared", { Floor = room.Floor, Boss = room.Data.Boss, Next = nextFloor })
	sync(run)
end

---------------------------------------------------------------------
-- runs
---------------------------------------------------------------------
function DungeonService.InRun(player: Player): boolean
	return runs[player] ~= nil
end

function DungeonService.Get(player: Player)
	return runs[player]
end

local function freeSlot(): number?
	for i = 1, D.RunSlots do
		if not slots[i] then
			return i
		end
	end
	return nil
end

function DungeonService.End(player: Player, reason: string)
	local run = runs[player]
	if not run then
		return
	end
	runs[player] = nil
	run.Active = false
	slots[run.Slot] = nil
	for _, room in pairs(run.Rooms or {}) do
		for _, e in ipairs(room.Enemies) do
			EnemyService.Despawn(e)
		end
	end
	if run.Folder then
		run.Folder:Destroy()
	end
	local s = DataService.Session(player)
	if s then
		s.Run = nil
	end
	local data = DataService.Get(player)
	if data and player.Parent then
		local best = data.BestFloor or 0
		Net.FX(player, "RunEnded", {
			Reason = reason,
			Reached = run.Floor,
			Start = run.StartFloor,
			Cleared = run.Cleared,
			Best = best,
			Coins = math.max(0, data.Coins - run.CoinsAtStart),
			Checkpoints = Config.Checkpoints(best, Stats.HasPass(player, "FastTravel")),
		})
		DataService.MarkDirty(player)
	end
end

function DungeonService.Start(player: Player, startFloor)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not s or not hum or hum.Health <= 0 then
		return
	end
	if s.Tower then
		Net.Notify(player, "Leave the Boss Rush first.", RED, "Error")
		return
	end
	startFloor = tonumber(startFloor) or 1
	local allowed = Config.Checkpoints(data.BestFloor or 0, Stats.HasPass(player, "FastTravel"))
	if not table.find(allowed, startFloor) then
		Net.Notify(player, "That checkpoint is locked. Reach floor " .. (startFloor + D.CheckpointEvery) .. " to start there.", RED, "Error")
		return
	end
	if runs[player] then
		DungeonService.End(player, "Restart")
	end
	local slot = freeSlot()
	if not slot then
		Net.Notify(player, "The dungeon is full right now, try again in a moment.", RED, "Error")
		return
	end
	slots[slot] = player
	local folder = Instance.new("Folder")
	folder.Name = "Run_" .. player.UserId
	folder.Parent = root
	local run: any = {
		Player = player,
		Slot = slot,
		Origin = D.SlotOrigin + Vector3.new(slot * D.SlotSpacing, 0, 0),
		Folder = folder,
		Floor = startFloor,
		StartFloor = startFloor,
		Cleared = 0,
		CoinsAtStart = data.Coins,
		Active = true,
		Rooms = {},
	}
	runs[player] = run
	buildSegment(run, startFloor)
	Util.Teleport(player, run.SpawnCF, "Floor " .. startFloor)
	Net.FX(player, "RunStarted", { Floor = startFloor, Zone = Config.Floor(startFloor).Zone })
	sync(run)
end

-- Hooked to every character: dying ends the run.
function DungeonService.CharacterAdded(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum then
		hum.Died:Connect(function()
			if runs[player] then
				DungeonService.End(player, "Died")
			end
		end)
	end
end

function DungeonService.PlayerRemoving(player: Player)
	DungeonService.End(player, "Left")
end

function DungeonService.Init()
	root = Instance.new("Folder")
	root.Name = "DungeonRuns"
	root.Parent = workspace
	-- room triggers: enemies only spawn once you walk into the room
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player, run in pairs(runs) do
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if run.Active and hrp then
					local rel = hrp.Position - run.Origin
					local room = run.Rooms[run.Floor]
					if room and room.State == "Waiting" and rel.Z < room.ZStart - D.SpawnRange and rel.Z > room.ZEnd and math.abs(rel.X) < D.RoomWidth / 2 then
						spawnRoom(run, room)
					end
					-- fell off the map: back to the start of the segment
					if rel.Y < -80 then
						hrp.CFrame = run.SpawnCF
					end
				end
			end
		end
	end)
end

return DungeonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- EnemyService (ModuleScript) -> ServerScriptService/Server/EnemyService
-- Chibi anime enemies for the Dungeon and the Boss Rush:
--   * Built by code from Config.EnemyArchetypes (big head, big anime eyes,
--     bold hair, outfit, gear and a weapon) on an R15 rig, so the default
--     Roblox animations still work. Optional catalog dressing via
--     Config.EnemyModelStyle = "Catalog".
--   * Enemies are spawned on demand by DungeonService (only when you walk
--     into a room) and TowerService; each belongs to one player.
--   * Animator with preloaded Idle / Walk / Run / BasicAttack /
--     SpecialWindup / SpecialRelease tracks.
--   * PathfindingService chasing + AI state machine for special attacks:
--     cooldown/proximity check -> wind-up anim + ground telegraph ->
--     release; damage lands on the animation's "Hit" keyframe/marker
--     (AnimationTrack.KeyframeReached) with a timed fallback.
--   * Attack rhythm: anticipation (lean back) -> strike -> recovery
--     (slumped, takes extra damage). Poses are sent as model attributes and
--     animated on each client (Client/EnemyFX).

local Players = game:GetService("Players")
local AvatarEditorService = game:GetService("AvatarEditorService")
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
