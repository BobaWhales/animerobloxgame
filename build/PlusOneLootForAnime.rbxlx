}

---------------------------------------------------------------------
-- MONETIZATION  (put your real IDs in!  0 = not set up yet)
---------------------------------------------------------------------
Config.GamePasses = {
	DoubleCoins = { Id = 0, Name = "2x Coins", Desc = "Doubles all Coin earnings." },
	DoubleLuck = { Id = 0, Name = "2x Luck", Desc = "Doubles rare ore odds and nudges rare race odds." },
