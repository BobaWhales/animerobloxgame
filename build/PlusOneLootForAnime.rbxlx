---------------------------------------------------------------------
-- RIG BUILDING  (chibi anime figures, built entirely by code)
---------------------------------------------------------------------
local function weldTo(anchor: BasePart, p: BasePart)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local w = Instance.new("WeldConstraint")
	w.Part0 = anchor
	w.Part1 = p
	w.Parent = p
	p.Parent = anchor.Parent
end

-- Welded decoration on any body part (flat, clean materials).
local function piece(body: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CastShadow = material ~= Enum.Material.Neon
	p.CFrame = body.CFrame * offset
	weldTo(body, p)
	return p
end

local function bodyPart(model: Model, r15: string, r6: string): BasePart?
	return (model:FindFirstChild(r15) or model:FindFirstChild(r6)) :: any
end

local function has(list, item: string): boolean
	return list ~= nil and table.find(list, item) ~= nil
end

local HEAD_SCALE = 1.55 -- chibi proportions: big head on a small body
local DARK = Color3.fromRGB(28, 24, 32)
local WHITE = Color3.fromRGB(250, 250, 252)

-- Blow the head up and re-seat it on the neck.
local function chibify(model: Model)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local mesh = head:FindFirstChildOfClass("SpecialMesh")
	head.Size *= HEAD_SCALE
	if mesh and mesh.MeshType == Enum.MeshType.FileMesh then
		mesh.Scale *= HEAD_SCALE
	end
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Attachment") then
			d.Position *= HEAD_SCALE
		elseif d:IsA("Decal") then
			d:Destroy() -- replaced by anime eyes
		end
	end
	local neck = model:FindFirstChild("Neck", true) :: Motor6D?
	if neck and neck:IsA("Motor6D") then
		neck.C1 = CFrame.new(neck.C1.Position * HEAD_SCALE) * neck.C1.Rotation
	end
end

-- Big anime eyes, angry brows, a small mouth.
local function buildFace(head: BasePart, look)
	local hs = head.Size
	local u = math.min(hs.X, hs.Y, hs.Z)
	local covered = has(look.Gear, "Mask") or has(look.Gear, "HollowMask") or has(look.Gear, "Blindfold")
	if not covered then
		for _, side in ipairs({ -1, 1 }) do
			local base = CFrame.new(side * hs.X * 0.19, -hs.Y * 0.04, -hs.Z * 0.43)
			local white = piece(head, "EyeWhite", Vector3.new(u * 0.25, u * 0.33, u * 0.1), base, WHITE, Enum.PartType.Ball)
			white.CastShadow = false
			piece(head, "Iris", Vector3.new(u * 0.19, u * 0.26, u * 0.1), base * CFrame.new(side * -u * 0.015, -u * 0.02, -u * 0.02), look.Eye or DARK, Enum.PartType.Ball).CastShadow = false
			piece(head, "Pupil", Vector3.new(u * 0.09, u * 0.13, u * 0.1), base * CFrame.new(side * -u * 0.015, -u * 0.03, -u * 0.035), DARK, Enum.PartType.Ball).CastShadow = false
			local shine = piece(head, "Shine", Vector3.new(u * 0.06, u * 0.06, u * 0.04), base * CFrame.new(side * u * 0.03, u * 0.07, -u * 0.05), WHITE, Enum.PartType.Ball, Enum.Material.Neon)
			shine.CastShadow = false
			-- angled brow = angry anime glare
			piece(head, "Brow", Vector3.new(u * 0.26, u * 0.05, u * 0.05), CFrame.new(side * hs.X * 0.19, hs.Y * 0.15, -hs.Z * 0.46) * CFrame.Angles(0, 0, math.rad(side * 16)), look.HairColor or DARK).CastShadow = false
		end
		if has(look.Gear, "Eyepatch") then
			piece(head, "Eyepatch", Vector3.new(u * 0.3, u * 0.36, u * 0.06), CFrame.new(hs.X * 0.19, -hs.Y * 0.04, -hs.Z * 0.48), DARK, Enum.PartType.Ball)
			piece(head, "Strap", Vector3.new(hs.X * 1.04, u * 0.05, hs.Z * 1.04), CFrame.new(0, hs.Y * 0.06, 0) * CFrame.Angles(0, 0, math.rad(-14)), DARK)
		end
		if has(look.Gear, "Scouter") then
			piece(head, "Scouter", Vector3.new(u * 0.3, u * 0.24, u * 0.05), CFrame.new(-hs.X * 0.21, -hs.Y * 0.02, -hs.Z * 0.5), Color3.fromRGB(80, 255, 120), nil, Enum.Material.Neon).Transparency = 0.35
			piece(head, "ScouterArm", Vector3.new(u * 0.08, u * 0.3, u * 0.3), CFrame.new(-hs.X * 0.5, -hs.Y * 0.02, -hs.Z * 0.2), Color3.fromRGB(220, 220, 225))
		end
		if has(look.Gear, "Glasses") then
			for _, side in ipairs({ -1, 1 }) do
				local g = piece(head, "Glasses", Vector3.new(u * 0.04, u * 0.3, u * 0.3), CFrame.new(side * hs.X * 0.19, -hs.Y * 0.04, -hs.Z * 0.5) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(200, 220, 255), Enum.PartType.Cylinder, Enum.Material.Glass)
				g.Transparency = 0.55
			end
		end
	end
	piece(head, "Mouth", Vector3.new(u * 0.14, u * 0.035, u * 0.04), CFrame.new(0, -hs.Y * 0.27, -hs.Z * 0.45), Color3.fromRGB(90, 40, 50)).CastShadow = false
	if has(look.Gear, "Marks") then
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 1 do
				piece(head, "Mark", Vector3.new(u * 0.16, u * 0.03, u * 0.03), CFrame.new(side * hs.X * 0.33, -hs.Y * (0.12 + k * 0.07), -hs.Z * 0.4) * CFrame.Angles(0, side * math.rad(25), 0), look.Trim or DARK).CastShadow = false
			end
		end
	end
end

local function hair(head: BasePart, look)
	local hs = head.Size
	local u = math.min(hs.X, hs.Y, hs.Z)
	local c = look.HairColor or DARK
	local style = look.Hair or "Short"
	local function hp(name, size, offset, shape)
		return piece(head, name, size, offset, c, shape)
	end
	if style == "Bald" then
		return
	end
	-- cap that follows the skull
	hp("HairCap", Vector3.new(hs.X * 1.08, hs.Y * 0.72, hs.Z * 1.1), CFrame.new(0, hs.Y * 0.26, u * 0.05), Enum.PartType.Ball)
	if style == "Spiky" then
		for i = 1, 9 do
			local a = (i / 9) * math.pi * 2
			local tilt = CFrame.Angles(math.rad(42) * math.cos(a), 0, math.rad(42) * math.sin(a))
			hp("Spike", Vector3.new(u * 0.3, u * 0.9, u * 0.3), CFrame.new(math.sin(a) * u * 0.36, hs.Y * 0.52, math.cos(a) * u * 0.32 + u * 0.1) * tilt)
		end
		for i = -2, 2 do
			hp("Bang", Vector3.new(u * 0.2, u * 0.46, u * 0.14), CFrame.new(i * u * 0.2, hs.Y * 0.3, -hs.Z * 0.44) * CFrame.Angles(math.rad(-22), 0, math.rad(i * 12)))
		end
	elseif style == "Messy" then
		for i = 1, 12 do
			local a = (i / 12) * math.pi * 2
			hp("Tuft", Vector3.new(u * 0.34, u * 0.5, u * 0.34), CFrame.new(math.cos(a) * u * 0.42, hs.Y * (0.34 + (i % 3) * 0.06), math.sin(a) * u * 0.42) * CFrame.Angles(math.rad(20) * math.sin(a), a, math.rad(30) * math.cos(a)))
		end
		for i = -1, 1 do
			hp("Bang", Vector3.new(u * 0.26, u * 0.4, u * 0.14), CFrame.new(i * u * 0.26, hs.Y * 0.26, -hs.Z * 0.44) * CFrame.Angles(math.rad(-18), 0, math.rad(i * 20)))
		end
	elseif style == "Short" then
		hp("Fringe", Vector3.new(hs.X * 1.02, u * 0.24, u * 0.18), CFrame.new(0, hs.Y * 0.3, -hs.Z * 0.44) * CFrame.Angles(math.rad(-12), 0, 0))
		for _, side in ipairs({ -1, 1 }) do
			hp("Side", Vector3.new(u * 0.14, hs.Y * 0.45, u * 0.5), CFrame.new(side * hs.X * 0.5, hs.Y * 0.05, 0))
		end
	elseif style == "Long" or style == "Ponytail" or style == "Twin" or style == "Bun" then
		hp("Fringe", Vector3.new(hs.X * 1.02, u * 0.28, u * 0.18), CFrame.new(0, hs.Y * 0.3, -hs.Z * 0.44) * CFrame.Angles(math.rad(-14), 0, 0))
		for _, side in ipairs({ -1, 1 }) do
			hp("SideLock", Vector3.new(u * 0.2, hs.Y * (style == "Long" and 1.05 or 0.6), u * 0.34), CFrame.new(side * hs.X * 0.5, -hs.Y * (style == "Long" and 0.25 or 0.05), -u * 0.1))
		end
		if style == "Long" then
			hp("BackHair", Vector3.new(hs.X * 1.02, hs.Y * 1.6, u * 0.36), CFrame.new(0, -hs.Y * 0.22, hs.Z * 0.48))
		elseif style == "Ponytail" then
			hp("Tie", Vector3.one * u * 0.3, CFrame.new(0, hs.Y * 0.28, hs.Z * 0.5), Enum.PartType.Ball)
			hp("Tail", Vector3.new(u * 0.38, hs.Y * 1.3, u * 0.38), CFrame.new(0, -hs.Y * 0.2, hs.Z * 0.66) * CFrame.Angles(math.rad(15), 0, 0))
		elseif style == "Twin" then
			for _, side in ipairs({ -1, 1 }) do
				hp("TwinTail", Vector3.new(u * 0.34, hs.Y * 1.2, u * 0.34), CFrame.new(side * hs.X * 0.62, -hs.Y * 0.2, hs.Z * 0.2) * CFrame.Angles(0, 0, math.rad(side * 12)))
			end
		else
			hp("Bun", Vector3.one * u * 0.56, CFrame.new(0, hs.Y * 0.56, hs.Z * 0.3), Enum.PartType.Ball)
		end
	end
end

local function headGear(head: BasePart, look)
	local hs = head.Size
	local u = math.min(hs.X, hs.Y, hs.Z)
	local g = look.Gear or {}
	local trim = look.Trim or WHITE
	if has(g, "Headband") then
		piece(head, "Headband", Vector3.new(hs.X * 1.08, u * 0.16, hs.Z * 1.08), CFrame.new(0, hs.Y * 0.2, 0), Color3.fromRGB(34, 44, 90))
		piece(head, "Plate", Vector3.new(u * 0.46, u * 0.22, u * 0.06), CFrame.new(0, hs.Y * 0.2, -hs.Z * 0.55), Color3.fromRGB(205, 210, 220), nil, Enum.Material.Metal)
		for _, side in ipairs({ -1, 1 }) do
			piece(head, "BandTail", Vector3.new(u * 0.12, u * 0.5, u * 0.05), CFrame.new(side * u * 0.12, hs.Y * 0.05, hs.Z * 0.56) * CFrame.Angles(math.rad(25), 0, math.rad(side * 20)), Color3.fromRGB(34, 44, 90))
		end
	end
	if has(g, "Bandana") then
		piece(head, "Bandana", Vector3.new(hs.X * 1.1, u * 0.3, hs.Z * 1.1), CFrame.new(0, hs.Y * 0.3, 0), trim)
		piece(head, "Knot", Vector3.one * u * 0.24, CFrame.new(u * 0.2, hs.Y * 0.2, hs.Z * 0.55), trim, Enum.PartType.Ball)
	end
	if has(g, "Horns") then
		for _, side in ipairs({ -1, 1 }) do
			piece(head, "Horn", Vector3.new(u * 0.2, u * 0.75, u * 0.2), CFrame.new(side * hs.X * 0.33, hs.Y * 0.62, -hs.Z * 0.05) * CFrame.Angles(math.rad(-10), 0, math.rad(-side * 22)), Color3.fromRGB(240, 232, 218))
		end
	end
	if has(g, "Mask") then
		piece(head, "Mask", Vector3.new(hs.X * 0.98, hs.Y * 0.72, u * 0.12), CFrame.new(0, -hs.Y * 0.06, -hs.Z * 0.48), trim)
		for _, side in ipairs({ -1, 1 }) do
			piece(head, "EyeSlit", Vector3.new(u * 0.22, u * 0.05, u * 0.04), CFrame.new(side * hs.X * 0.2, hs.Y * 0.02, -hs.Z * 0.55) * CFrame.Angles(0, 0, math.rad(side * 12)), look.Eye or Color3.fromRGB(255, 60, 60), nil, Enum.Material.Neon)
		end
	end
	if has(g, "HollowMask") then
		piece(head, "HollowMask", Vector3.new(hs.X * 1.0, hs.Y * 0.8, u * 0.14), CFrame.new(0, -hs.Y * 0.04, -hs.Z * 0.48), WHITE)
		for _, side in ipairs({ -1, 1 }) do
			piece(head, "EyeHole", Vector3.new(u * 0.22, u * 0.18, u * 0.05), CFrame.new(side * hs.X * 0.2, hs.Y * 0.02, -hs.Z * 0.56), DARK, Enum.PartType.Ball)
			piece(head, "Stripe", Vector3.new(u * 0.05, hs.Y * 0.55, u * 0.03), CFrame.new(side * hs.X * 0.36, -hs.Y * 0.05, -hs.Z * 0.555), Color3.fromRGB(190, 30, 40))
		end
		piece(head, "Teeth", Vector3.new(u * 0.46, u * 0.08, u * 0.04), CFrame.new(0, -hs.Y * 0.3, -hs.Z * 0.56), DARK)
	end
	if has(g, "Blindfold") then
		piece(head, "Blindfold", Vector3.new(hs.X * 1.08, u * 0.24, hs.Z * 1.08), CFrame.new(0, -hs.Y * 0.02, 0), DARK)
	end
	if has(g, "Hood") then
		piece(head, "Hood", Vector3.new(hs.X * 1.22, hs.Y * 1.05, hs.Z * 1.2), CFrame.new(0, hs.Y * 0.14, u * 0.14), look.Top or DARK, Enum.PartType.Ball)
	end
	if has(g, "Crown") then
		for i = 1, 6 do
			local a = (i / 6) * math.pi * 2
			piece(head, "Crown", Vector3.new(u * 0.14, u * 0.4, u * 0.14), CFrame.new(math.cos(a) * u * 0.42, hs.Y * 0.72, math.sin(a) * u * 0.42), Color3.fromRGB(255, 205, 60), nil, Enum.Material.Neon)
		end
	end
	if has(g, "Halo") then
		piece(head, "Halo", Vector3.new(u * 0.08, u * 1.1, u * 1.1), CFrame.new(0, hs.Y * 0.95, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 240, 150), Enum.PartType.Cylinder, Enum.Material.Neon).Transparency = 0.2
	end
	if has(g, "Cap") then
		piece(head, "Cap", Vector3.new(u * 0.5, hs.X * 1.08, hs.X * 1.08), CFrame.new(0, hs.Y * 0.46, 0) * CFrame.Angles(0, 0, math.rad(90)), trim, Enum.PartType.Cylinder)
		piece(head, "Visor", Vector3.new(hs.X * 0.8, u * 0.06, u * 0.5), CFrame.new(0, hs.Y * 0.3, -hs.Z * 0.6), DARK)
	end
	if has(g, "StrawHat") or has(g, "CowboyHat") then
		local col = has(g, "StrawHat") and Color3.fromRGB(230, 200, 110) or Color3.fromRGB(150, 90, 50)
		piece(head, "HatBrim", Vector3.new(u * 0.1, u * 2.6, u * 2.6), CFrame.new(0, hs.Y * 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)), col, Enum.PartType.Cylinder)
		piece(head, "HatCrown", Vector3.new(u * 0.6, u * 1.25, u * 1.25), CFrame.new(0, hs.Y * 0.72, 0) * CFrame.Angles(0, 0, math.rad(90)), col, Enum.PartType.Cylinder)
		piece(head, "HatBand", Vector3.new(u * 0.14, u * 1.28, u * 1.28), CFrame.new(0, hs.Y * 0.56, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 40, 40), Enum.PartType.Cylinder)
	end
	if has(g, "Antenna") then
		for _, side in ipairs({ -1, 1 }) do
			local a = piece(head, "Antenna", Vector3.new(u * 0.07, u * 0.7, u * 0.07), CFrame.new(side * u * 0.22, hs.Y * 0.72, -u * 0.05) * CFrame.Angles(0, 0, math.rad(-side * 15)), look.Skin or DARK)
			piece(a, "AntennaTip", Vector3.one * u * 0.14, CFrame.new(0, u * 0.36, 0), look.Skin or DARK, Enum.PartType.Ball)
		end
	end
end

local function outfit(model: Model, look)
	local up = bodyPart(model, "UpperTorso", "Torso")
	local low = bodyPart(model, "LowerTorso", "Torso")
	if not up then
		return
	end
	local ts = up.Size
	local u = ts.X / 2
	local top, bottom, trim = look.Top or DARK, look.Bottom or DARK, look.Trim or WHITE
	local kind = look.Outfit or "Vest"
	local g = look.Gear or {}
	local function belt(color)
		if low then
			piece(low, "Belt", Vector3.new(low.Size.X * 1.08, u * 0.22, low.Size.Z * 1.1), CFrame.new(0, low.Size.Y * 0.3, 0), color)
		end
	end
	local function skirt(color, len)
		if low then
			piece(low, "Skirt", Vector3.new(low.Size.X * 1.18, len, low.Size.Z * 1.25), CFrame.new(0, -len / 2 + low.Size.Y * 0.2, 0), color)
		end
	end
	if kind == "Vest" then
		piece(up, "Vest", Vector3.new(ts.X * 1.08, ts.Y * 0.95, ts.Z * 1.15), CFrame.new(0, -ts.Y * 0.02, 0), top)
		piece(up, "Collar", Vector3.new(ts.X * 0.9, u * 0.22, ts.Z * 1.2), CFrame.new(0, ts.Y * 0.46, 0), trim)
		belt(trim)
	elseif kind == "Robe" or kind == "Gi" then
		for _, side in ipairs({ -1, 1 }) do
			piece(up, "Lapel", Vector3.new(u * 0.26, ts.Y * 0.9, u * 0.05), CFrame.new(side * u * 0.2, ts.Y * 0.02, -ts.Z * 0.52) * CFrame.Angles(0, 0, math.rad(side * 24)), trim)
		end
		belt(kind == "Gi" and DARK or trim)
		if kind == "Robe" then
			skirt(bottom, u * 1.9)
		end
	elseif kind == "Coat" or kind == "Cloak" then
		piece(up, "CoatBack", Vector3.new(ts.X * 1.12, ts.Y * 2.3, u * 0.12), CFrame.new(0, -ts.Y * 0.62, ts.Z * 0.56), top)
		for _, side in ipairs({ -1, 1 }) do
			piece(up, "CoatFront", Vector3.new(u * 0.5, ts.Y * 2.1, u * 0.1), CFrame.new(side * u * 0.55, -ts.Y * 0.55, -ts.Z * 0.56), top)
		end
		piece(up, "HighCollar", Vector3.new(ts.X * 1.05, u * 0.5, ts.Z * 1.3), CFrame.new(0, ts.Y * 0.52, 0.05), kind == "Cloak" and top or trim)
		if kind == "Cloak" then
			for i = 1, 3 do
				piece(up, "CloudMark", Vector3.new(u * 0.08, u * 0.34, u * 0.5), CFrame.new(-ts.X * 0.58, -ts.Y * (i * 0.45), 0) * CFrame.Angles(0, 0, 0), trim, Enum.PartType.Ball)
			end
		end
	elseif kind == "Armor" then
		piece(up, "ChestPlate", Vector3.new(ts.X * 1.1, ts.Y * 0.7, ts.Z * 1.2), CFrame.new(0, ts.Y * 0.1, 0), trim, nil, Enum.Material.Metal).Reflectance = 0.1
		belt(DARK)
	elseif kind == "Uniform" then
		piece(up, "Jacket", Vector3.new(ts.X * 1.06, ts.Y * 0.7, ts.Z * 1.12), CFrame.new(0, ts.Y * 0.14, 0), top)
		piece(up, "Collar", Vector3.new(ts.X * 0.7, u * 0.2, ts.Z * 1.16), CFrame.new(0, ts.Y * 0.48, 0), trim)
		for _, side in ipairs({ -1, 1 }) do
			piece(up, "Strap", Vector3.new(u * 0.1, ts.Y * 1.02, ts.Z * 1.16), CFrame.new(side * u * 0.42, 0, 0), DARK)
		end
		belt(DARK)
	end
	-- back / neck gear
	if has(g, "Scarf") then
		piece(up, "Scarf", Vector3.new(ts.X * 0.95, u * 0.36, ts.Z * 1.3), CFrame.new(0, ts.Y * 0.52, 0), trim)
		piece(up, "ScarfTail", Vector3.new(u * 0.3, ts.Y * 1.3, u * 0.06), CFrame.new(u * 0.35, -ts.Y * 0.1, ts.Z * 0.6) * CFrame.Angles(math.rad(22), 0, math.rad(10)), trim)
	end
	if has(g, "Cape") or has(g, "Haori") then
		local col = has(g, "Haori") and WHITE or trim
		piece(up, "Cape", Vector3.new(ts.X * 1.2, ts.Y * 2.4, u * 0.08), CFrame.new(0, -ts.Y * 0.68, ts.Z * 0.62) * CFrame.Angles(math.rad(6), 0, 0), col)
		if has(g, "Haori") then
			for _, side in ipairs({ -1, 1 }) do
				piece(up, "HaoriFront", Vector3.new(u * 0.3, ts.Y * 2.2, u * 0.06), CFrame.new(side * u * 0.78, -ts.Y * 0.6, -ts.Z * 0.6), col)
			end
		end
	end
	if has(g, "Gourd") then
		local tan = Color3.fromRGB(205, 170, 120)
		local gr = piece(up, "Gourd", Vector3.one * u * 1.6, CFrame.new(0, -ts.Y * 0.1, ts.Z * 0.5 + u * 0.7), tan, Enum.PartType.Ball)
		piece(gr, "GourdTop", Vector3.one * u * 1.0, CFrame.new(-u * 0.3, u * 1.0, 0), tan, Enum.PartType.Ball)
		piece(up, "GourdStrap", Vector3.new(u * 0.14, ts.Y * 1.3, ts.Z * 1.2), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(40)), Color3.fromRGB(120, 60, 40))
	end
	if has(g, "Wings") then
		for _, side in ipairs({ -1, 1 }) do
			local w = piece(up, "Wing", Vector3.new(u * 0.1, ts.Y * 1.5, u * 1.4), CFrame.new(side * u * 0.9, ts.Y * 0.3, ts.Z * 0.5 + u * 0.4) * CFrame.Angles(math.rad(-20), side * math.rad(35), side * math.rad(-30)), trim)
			w.Transparency = 0.1
		end
	end
	if has(g, "Tails") and low then
		local col = look.Aura or trim
		for i = 1, 5 do
			local a = math.rad((i - 3) * 22)
			local t1 = piece(low, "Tail", Vector3.new(u * 0.45, u * 1.4, u * 0.45), CFrame.new(math.sin(a) * u * 0.6, 0, low.Size.Z * 0.5 + u * 0.4) * CFrame.Angles(math.rad(55), 0, a), col, Enum.PartType.Ball)
			t1.Material = Enum.Material.Neon
			t1.Transparency = 0.25
		end
	end
end

local function weapon(model: Model, look)
	local rh = bodyPart(model, "RightHand", "Right Arm")
	local lh = bodyPart(model, "LeftHand", "Left Arm")
	if not rh then
		return
	end
	local u = rh.Size.X
	local steel = Color3.fromRGB(215, 222, 235)
	local grip = CFrame.new(0, -rh.Size.Y * 0.4, 0)
	local kind = look.Weapon or "Fists"
	local accent = look.Trim or WHITE
	local glow = look.Aura or look.Eye or accent
	local function blade(hand: BasePart, len: number, width: number)
		piece(hand, "Handle", Vector3.new(u * 0.3, u * 1.2, u * 0.3), grip, DARK)
		piece(hand, "Guard", Vector3.new(u * 1.0, u * 0.14, u * 0.5), grip * CFrame.new(0, 0, -u * 0.7) * CFrame.Angles(math.rad(90), 0, 0), accent)
		local b = piece(hand, "Blade", Vector3.new(width, u * 0.12, len), grip * CFrame.new(0, 0, -u * 0.7 - len / 2), steel, nil, Enum.Material.Metal)
		b.Reflectance = 0.2
		piece(hand, "Edge", Vector3.new(width * 0.3, u * 0.13, len * 0.96), grip * CFrame.new(width * 0.4, 0, -u * 0.7 - len / 2), glow, nil, Enum.Material.Neon)
	end
	if kind == "Katana" then
		blade(rh, u * 4.2, u * 0.35)
	elseif kind == "Kunai" then
		blade(rh, u * 1.3, u * 0.4)
	elseif kind == "Blades" then
		blade(rh, u * 2.2, u * 0.34)
		if lh then
			blade(lh, u * 2.2, u * 0.34)
		end
	elseif kind == "Staff" or kind == "Scythe" then
		local pole = piece(rh, "Pole", Vector3.new(u * 0.25, u * 6, u * 0.25), grip * CFrame.new(0, u * 1.2, 0), Color3.fromRGB(90, 60, 40))
		if kind == "Staff" then
			piece(pole, "Orb", Vector3.one * u * 0.9, CFrame.new(0, u * 3.1, 0), glow, Enum.PartType.Ball, Enum.Material.Neon)
		else
			piece(pole, "ScytheBlade", Vector3.new(u * 0.12, u * 0.5, u * 3.2), CFrame.new(0, u * 2.9, -u * 1.4), steel, nil, Enum.Material.Metal)
		end
	elseif kind == "Club" then
		local club = piece(rh, "Club", Vector3.new(u * 0.9, u * 3.2, u * 0.9), grip * CFrame.new(0, 0, -u * 1.7) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(110, 80, 60))
		for i = 1, 6 do
			local a = (i / 6) * math.pi * 2
			piece(club, "Spike", Vector3.one * u * 0.3, CFrame.new(math.cos(a) * u * 0.45, u * 1.1, math.sin(a) * u * 0.45), steel)
		end
	elseif kind == "Gun" then
		piece(rh, "Gun", Vector3.new(u * 0.4, u * 0.55, u * 1.3), grip * CFrame.new(0, 0, -u * 0.5), DARK, nil, Enum.Material.Metal)
	elseif kind == "Bow" then
		for k = -2, 2 do
			piece(lh or rh, "Bow", Vector3.new(u * 0.16, u * 0.9, u * 0.16), CFrame.new(0, -u * 0.4 + k * u * 0.75, -u * 0.3 - math.abs(k) * -u * 0.12) * CFrame.Angles(math.rad(-k * 14), 0, 0), accent)
		end
	elseif kind == "Fan" then
		piece(rh, "Fan", Vector3.new(u * 0.1, u * 2.6, u * 2.6), grip * CFrame.new(0, u * 0.6, -u * 0.6) * CFrame.Angles(0, math.rad(90), 0), accent, Enum.PartType.Cylinder)
	else -- Fists: wrapped hands
		for _, hnd in ipairs({ rh, lh }) do
			if hnd then
				piece(hnd, "Wrap", Vector3.new(hnd.Size.X * 1.12, hnd.Size.Y * 0.6, hnd.Size.Z * 1.12), CFrame.new(0, hnd.Size.Y * 0.1, 0), accent)
			end
		end
	end
end

-- Chibi anime figure for an archetype (R15 from a HumanoidDescription).
local function buildChibi(look, desc: HumanoidDescription?): Model
	local skin = look.Skin or Color3.fromRGB(245, 208, 178)
	local sleeves = look.Outfit ~= "Vest" and look.Outfit ~= "Bare"
	desc = desc or Instance.new("HumanoidDescription")
	local d = desc :: HumanoidDescription
	d.HeadColor = skin
	d.TorsoColor = look.Outfit == "Bare" and skin or (look.Top or skin)
	d.LeftArmColor = sleeves and (look.Top or skin) or skin
	d.RightArmColor = d.LeftArmColor
	d.LeftLegColor = look.Outfit == "Bare" and skin or (look.Bottom or skin)
	d.RightLegColor = d.LeftLegColor
	d.HeightScale = 0.85
	d.WidthScale = 1
	d.DepthScale = 1
	d.HeadScale = 1
	d.BodyTypeScale = 0
	d.ProportionScale = 0
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(d, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil :: any
	end
	for _, x in ipairs(model:GetDescendants()) do
		if x:IsA("Script") or x:IsA("LocalScript") then
			x:Destroy()
		elseif x:IsA("BasePart") and x.Name ~= "HumanoidRootPart" then
			x.Material = Enum.Material.SmoothPlastic
			x.Reflectance = 0
			if x.Name == "LeftHand" or x.Name == "RightHand" then
				x.Color = skin
			end
		end
	end
	chibify(model)
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		buildFace(head, look)
		hair(head, look)
		headGear(head, look)
	end
	outfit(model, look)
	weapon(model, look)
	return model
end

-- Optional: dress the rig from the catalog (Config.EnemyModelStyle = "Catalog").
local catalogCache = {}
local function catalogIds(keyword: string?, assetType: Enum.AvatarAssetType): { number }
	if not keyword or keyword == "" then
		return {}
	end
	local key = keyword .. "|" .. assetType.Name
	if catalogCache[key] then
		return catalogCache[key]
	end
	local ids = {}
	pcall(function()
		local params = CatalogSearchParams.new()
		params.SearchKeyword = keyword
		params.AssetTypes = { assetType }
		params.IncludeOffSale = true
		params.Limit = 30
		for _, item in ipairs(AvatarEditorService:SearchCatalogAsync(params):GetCurrentPage()) do
			local id = type(item) == "table" and tonumber(item.Id)
			if id then
				table.insert(ids, id)
			end
		end
	end)
	catalogCache[key] = ids
	return ids
end

local function catalogDescription(lookId: string): HumanoidDescription?
	local userId = Config.EnemyAvatarUserIds[lookId]
	if userId then
		local ok, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
		end)
		if ok and desc then
			return desc
		end
	end
	local kw = Config.EnemyAvatarKeywords[lookId]
	if not kw then
		return nil
	end
	local desc = Instance.new("HumanoidDescription")
	local hairIds = catalogIds(kw.Hair, Enum.AvatarAssetType.HairAccessory)
	if #hairIds > 0 then
		desc.HairAccessory = tostring(hairIds[1])
	end
	local hatIds = catalogIds(kw.Hat, Enum.AvatarAssetType.Hat)
	if #hatIds > 0 then
		desc.HatAccessory = tostring(hatIds[1])
	end
	local shirts = catalogIds(kw.Shirt, Enum.AvatarAssetType.Shirt)
	if #shirts > 0 then
		desc.Shirt = shirts[1]
	end
	local pants = catalogIds(kw.Pants, Enum.AvatarAssetType.Pants)
	if #pants > 0 then
		desc.Pants = pants[1]
	end
	return desc
end

local FALLBACK_LOOK = { Skin = Color3.fromRGB(245, 208, 178), Hair = "Spiky", HairColor = DARK, Eye = Color3.fromRGB(255, 60, 60), Top = Color3.fromRGB(60, 60, 80), Bottom = DARK, Outfit = "Vest", Gear = { "Headband" }, Weapon = "Kunai" }

-- Hand-built R6 rig (last-resort fallback if R15 creation fails).
local function buildR6(look): Model
	local m = Instance.new("Model")
	local function p(name, size, color)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = m
		return part
	end
	local root = p("HumanoidRootPart", Vector3.new(2, 2, 1), look.Top)
	root.Transparency = 1
	local torso = p("Torso", Vector3.new(2, 2, 1), look.Top)
	local head = p("Head", Vector3.new(2, 1, 1) * 1.5, look.Skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = head
	local la = p("Left Arm", Vector3.new(1, 2, 1), look.Skin)
	local ra = p("Right Arm", Vector3.new(1, 2, 1), look.Skin)
	local ll = p("Left Leg", Vector3.new(1, 2, 1), look.Bottom)
	local rl = p("Right Leg", Vector3.new(1, 2, 1), look.Bottom)
	local function motor(name, p0, p1, c0, c1)
		local mo = Instance.new("Motor6D")
		mo.Name = name
		mo.Part0 = p0
		mo.Part1 = p1
		mo.C0 = c0
		mo.C1 = c1
		mo.Parent = p0
	end
	local rj = CFrame.Angles(math.rad(-90), 0, math.rad(180))
	motor("RootJoint", root, torso, rj, rj)
	motor("Neck", torso, head, CFrame.new(0, 1, 0) * rj, CFrame.new(0, -0.75, 0) * rj)
	motor("Right Shoulder", torso, ra, CFrame.new(1, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(-0.5, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0))
	motor("Left Shoulder", torso, la, CFrame.new(-1, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(0.5, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0))
	motor("Right Hip", torso, rl, CFrame.new(1, -1, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(0.5, 1, 0) * CFrame.Angles(0, math.rad(90), 0))
	motor("Left Hip", torso, ll, CFrame.new(-1, -1, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(-0.5, 1, 0) * CFrame.Angles(0, math.rad(-90), 0))
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R6
	hum.Parent = m
	m.PrimaryPart = root
	root.CFrame = CFrame.new(0, 3, 0)
	torso.CFrame = root.CFrame
	head.CFrame = root.CFrame * CFrame.new(0, 1.75, 0)
	ra.CFrame = root.CFrame * CFrame.new(1.5, 0, 0)
	la.CFrame = root.CFrame * CFrame.new(-1.5, 0, 0)
	rl.CFrame = root.CFrame * CFrame.new(0.5, -2, 0)
	ll.CFrame = root.CFrame * CFrame.new(-0.5, -2, 0)
	buildFace(head, look)
	hair(head, look)
	headGear(head, look)
	return m
end

local function buildTemplate(lookId: string): Model
	local look = Config.EnemyArchetypes[lookId] or FALLBACK_LOOK
	local model = nil
	if Config.EnemyModelStyle == "Catalog" then
		local desc = catalogDescription(lookId)
		if desc then
			local ok, m = pcall(function()
				return Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
			end)
			if ok and m then
				model = m
				chibify(model)
			end
		end
	end
	model = model or buildChibi(look)
	if not model then
		warn("[Enemies] R15 rig build failed for " .. tostring(lookId) .. ", using R6 fallback")
		model = buildR6(look)
	end
	model:SetAttribute("CoreColor", look.Aura or look.Eye or Color3.fromRGB(255, 80, 80))
	model:SetAttribute("Archetype", lookId)
	return model
end

---------------------------------------------------------------------
-- ANIMATION
---------------------------------------------------------------------
local function animation(id: string): Animation
	local a = animCache[id]
	if not a then
		a = Instance.new("Animation")
		a.AnimationId = id
		animCache[id] = a
	end
	return a
end

local function loadTracks(hum: Humanoid)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local set = hum.RigType == Enum.HumanoidRigType.R15 and Config.EnemyAnims.R15 or Config.EnemyAnims.R6
	local tracks = {}
	for key, id in pairs(set) do
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation(id))
		end)
		if ok and track then
			tracks[key] = track
			if key == "Idle" or key == "Walk" or key == "Run" then
				track.Looped = true
				track.Priority = Enum.AnimationPriority.Core
			else
				track.Priority = Enum.AnimationPriority.Action
			end
		end
	end
	return tracks
end

-- Waits for a "Hit" keyframe / marker on the track, or the fallback time.
local function waitForHit(track: AnimationTrack?, fallback: number)
	local done = Instance.new("BindableEvent")
	local fired = false
	local function fire()
		if not fired then
			fired = true
			done:Fire()
		end
	end
	local conns = {}
	if track then
		table.insert(conns, track.KeyframeReached:Connect(function(name)
			if name == "Hit" then
				fire()
			end
		end))
		table.insert(conns, track:GetMarkerReachedSignal("Hit"):Connect(fire))
	end
	task.delay(fallback, fire)
	if not fired then
		done.Event:Wait()
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	done:Destroy()
end

---------------------------------------------------------------------
-- POSES (animated on each client by Client/EnemyFX)
---------------------------------------------------------------------
-- Anticipate / Strike / Recover / Windup / Stagger / Idle
local function setPose(e, pose: string, duration: number?)
	e.PoseId = (e.PoseId or 0) + 1
	e.Model:SetAttribute("Pose", pose)
	e.Model:SetAttribute("PoseDur", duration or 0)
	e.Model:SetAttribute("PoseId", e.PoseId)
end

-- Elite variant: clothes pulled toward a dark tone, every glowing accent,
-- plate and rune switched to gold.
local GLOW_PARTS = { Iris = true, Edge = true, Orb = true, EyeSlit = true, Halo = true, Crown = true, Tail = true }
local ARMOR_PARTS = { ChestPlate = true, Plate = true, Guard = true, Belt = true }
local function applyElitePalette(model: Model)
	local E = Config.EliteLook
	for _, d in ipairs(model:GetDescendants()) do
		local name = d.Name
		if d:IsA("PointLight") then
			if name == "CoreLight" then
				d.Color = E.Trim
			end
		elseif d:IsA("BasePart") and name ~= "HumanoidRootPart" then
			if GLOW_PARTS[name] then
				d.Color = E.Trim
			elseif ARMOR_PARTS[name] then
				d.Color = E.Trim:Lerp(Color3.new(0, 0, 0), 0.35)
				d.Reflectance = 0.25
			elseif name ~= "Head" and name:find("Hand") == nil and name ~= "EyeWhite" and name ~= "Shine" and name ~= "Pupil" then
				d.Color = d.Color:Lerp(E.Palette, 0.55)
			end
		end
	end
	model:SetAttribute("CoreColor", E.Trim)
	-- gold crest above the brow
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		local crest = piece(head, "Crest", Vector3.new(0.12, head.Size.Y * 0.35, head.Size.Z * 0.1), CFrame.new(0, head.Size.Y * 0.42, -head.Size.Z * 0.46) * CFrame.Angles(0, 0, math.rad(45)), E.Trim, nil, Enum.Material.Neon)
		crest.CastShadow = false
	end
end

---------------------------------------------------------------------
-- SPAWNING
---------------------------------------------------------------------
local function randomPoint(minV: Vector3, maxV: Vector3): Vector3
	return Vector3.new(math.random() * (maxV.X - minV.X) + minV.X, minV.Y, math.random() * (maxV.Z - minV.Z) + minV.Z)
end

local function tierKey(e): string
	return e.Boss and "Boss" or (e.Elite and "Elite" or "Normal")
end

local building = {}
local function templateFor(lookId: string): Model
	while building[lookId] do
		task.wait(0.1)
	end
	local template = templates[lookId]
	if not template then
		building[lookId] = true
		template = buildTemplate(lookId)
		templates[lookId] = template
		building[lookId] = nil
	end
	return template
end
EnemyService.Prebuild = function(lookId: string)
	task.spawn(templateFor, lookId)
end

function EnemyService.Create(opts)
	local template = templateFor(opts.Look or "RogueGenin")
	local model = template:Clone()
	model.Name = opts.Label
	if opts.Elite then
		applyElitePalette(model)
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local head = model:FindFirstChild("Head") :: BasePart
	if opts.Scale and opts.Scale ~= 1 then
		pcall(function()
			model:ScaleTo(opts.Scale)
		end)
	end
	hum.WalkSpeed = opts.Speed or 12
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	for _, st in ipairs({ Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.Seated }) do
		hum:SetStateEnabled(st, false)
	end
	local rootY = hum.RigType == Enum.HumanoidRigType.R15 and (hum.HipHeight + root.Size.Y / 2) or 3 * (opts.Scale or 1)
	model:PivotTo(CFrame.new(opts.Position.X, opts.Position.Y + rootY + 0.3, opts.Position.Z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))

	local color = opts.Color or Color3.new(1, 1, 1)
	if opts.Boss then
		local aura = Instance.new("Attachment")
		aura.Parent = root
		local em = VFX.MakeEmitter("Aura", color, aura, 18)
		em.Size = VFX.NS(0, 1.6 * (opts.Scale or 1), 0.5, 2.4 * (opts.Scale or 1), 1, 0)
		em.Transparency = VFX.NS(0, 0.55, 0.6, 0.75, 1, 1)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = 30
		l.Brightness = 2
		l.Shadows = true
		l.Parent = root
		-- the camera gently frames bosses you are fighting
		root:SetAttribute("FrameRadius", 70)
		CollectionService:AddTag(root, "CameraFocus")
	end
	if opts.Elite then
		-- thin gold outline only (no fill) so the silhouette stays readable
		local h = Instance.new("Highlight")
		h.FillTransparency = 1
		h.OutlineColor = Color3.fromRGB(255, 215, 110)
		h.OutlineTransparency = 0.45
		h.Parent = model
	end
	model:SetAttribute("Boss", opts.Boss == true)
	model:SetAttribute("Elite", opts.Elite == true)
	model:SetAttribute("HP", 1)
	CollectionService:AddTag(model, "Enemy")

	model.Parent = map.Enemies
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local enemy = {
		Model = model,
		Root = root,
		Head = head,
		Humanoid = hum,
		HP = opts.HP,
		MaxHP = opts.HP,
		Name = opts.Label,
		Color = color,
		Boss = opts.Boss,
		Elite = opts.Elite,
		FloorData = opts.Floor,
		OnKilled = opts.OnKilled,
		Owner = opts.Owner,
		Min = opts.Min,
		Max = opts.Max,
		Home = opts.Position,
		Damagers = {},
		Dead = false,
		OnDeath = opts.OnDeath,
		Scale = opts.Scale or 1,
		Radius = 1.6 * (opts.Scale or 1),
		HitPercent = opts.HitPercent or Config.EnemyHitPercent,
		State = "Idle",
		LastBasic = 0,
		NextSpecial = os.clock() + 2 + math.random() * 3,
		NextWander = 0,
		StunnedUntil = 0,
		LastDamaged = -100,
		NextPath = 0,
		RecoverUntil = 0,
		PoseId = 0,
		BaseSpeed = opts.Speed or 12,
		SlowUntil = 0,
	}
	enemy.Tracks = loadTracks(hum)
	if enemy.Tracks.Idle then
		enemy.Tracks.Idle:Play()
	end
	hum.Running:Connect(function(speed)
		local run, idle = enemy.Tracks.Run, enemy.Tracks.Idle
		if speed > 1 then
			if run and not run.IsPlaying then
				run:Play(0.15)
				if idle then
					idle:Stop(0.15)
				end
			end
		else
			if idle and not idle.IsPlaying then
				idle:Play(0.2)
				if run then
					run:Stop(0.2)
				end
			end
		end
	end)
	table.insert(EnemyService.Active, enemy)
	return enemy
end

---------------------------------------------------------------------
-- QUERIES
---------------------------------------------------------------------
function EnemyService.CanDamage(player: Player, e): boolean
	return not e.Dead and (not e.Owner or e.Owner == player)
end

function EnemyService.InSphere(pos: Vector3, radius: number)
	local out = {}
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead and (e.Root.Position - pos).Magnitude - e.Radius <= radius then
			table.insert(out, e)
		end
	end
	return out
end

function EnemyService.InCone(pos: Vector3, dir: Vector3, range: number, arcDot: number)
	local out = {}
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead then
			local offset = e.Root.Position - pos
			local flatV = Vector3.new(offset.X, 0, offset.Z)
			local dist = flatV.Magnitude
			if dist - e.Radius <= range and math.abs(offset.Y) < 10 * e.Scale then
				if dist < 3 * e.Scale or flatV.Unit:Dot(dir) > arcDot then
					table.insert(out, e)
				end
			end
		end
	end
	return out
end

function EnemyService.InSegment(a: Vector3, b: Vector3, radius: number)
	local out = {}
	local ab = b - a
	local len2 = ab:Dot(ab)
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead then
			local p = e.Root.Position
			local t = len2 > 0 and math.clamp((p - a):Dot(ab) / len2, 0, 1) or 0
			local closest = a + ab * t
			if (p - closest).Magnitude <= radius + e.Radius + 1 then
				table.insert(out, e)
			end
		end
	end
	return out
end

---------------------------------------------------------------------
-- STATUS EFFECTS (all stun-like effects are capped by Balance.MaxStun)
---------------------------------------------------------------------
function EnemyService.Stun(e, duration: number)
	if e.Dead then
		return
	end
	duration = math.min(duration, B.MaxStun) * (e.Boss and 0.3 or 1)
	e.StunnedUntil = math.max(e.StunnedUntil, os.clock() + duration)
	e.Humanoid:MoveTo(e.Root.Position)
	if duration >= 0.25 then
		setPose(e, "Stagger", duration)
	end
end

-- Frost: half speed for a moment; chilled enemies take +25% damage.
function EnemyService.Slow(e, duration: number)
	if e.Dead then
		return
	end
	local fresh = os.clock() >= e.SlowUntil
	e.SlowUntil = math.max(e.SlowUntil, os.clock() + duration)
	e.Humanoid.WalkSpeed = e.BaseSpeed * 0.5
	e.Model:SetAttribute("Chilled", true)
	if fresh then
		task.spawn(function()
			while not e.Dead and os.clock() < e.SlowUntil do
				task.wait(0.2)
			end
			if not e.Dead and e.Humanoid.Parent then
				e.Humanoid.WalkSpeed = e.BaseSpeed
				e.Model:SetAttribute("Chilled", nil)
			end
		end)
	end
end

function EnemyService.Knockback(e, dir: Vector3, force: number)
	if e.Dead then
		return
	end
	local f = force * (e.Boss and 0.2 or 1)
	e.Root.AssemblyLinearVelocity = dir * f + Vector3.new(0, f * 0.3, 0)
	EnemyService.Stun(e, 0.3)
end

function EnemyService.Pull(e, point: Vector3, strength: number)
	if e.Dead or e.Boss then
		return
	end
	local off = Vector3.new(point.X - e.Root.Position.X, 0, point.Z - e.Root.Position.Z)
	if off.Magnitude > 3 then
		e.Root.AssemblyLinearVelocity = off.Unit * strength
		EnemyService.Stun(e, 0.25)
	end
end

function EnemyService.Ragdoll(e, duration: number, force: boolean?)
	if (e.Dead and not force) or e.Ragdolled then
		return
	end
	if e.Boss and not force then
		EnemyService.Stun(e, duration)
		return
	end
	duration = math.min(duration, B.MaxStun)
	e.Ragdolled = true
	e.StunnedUntil = math.max(e.StunnedUntil, os.clock() + duration)
	local restore = {}
	for _, motor in ipairs(e.Model:GetDescendants()) do
		if motor:IsA("Motor6D") and motor.Name ~= "Root" and motor.Name ~= "RootJoint" and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local bs = Instance.new("BallSocketConstraint")
			bs.Attachment0 = a0
			bs.Attachment1 = a1
			bs.LimitsEnabled = true
			bs.UpperAngle = 60
			bs.TwistLimitsEnabled = true
			bs.Parent = motor.Part0
			motor.Enabled = false
			table.insert(restore, { motor, a0, a1, bs, motor.Part1.CanCollide })
			motor.Part1.CanCollide = true
		end
	end
	e.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	task.delay(duration, function()
		for _, r in ipairs(restore) do
			local motor, a0, a1, bs, collide = r[1], r[2], r[3], r[4], r[5]
			if motor.Parent then
				motor.Enabled = true
				if motor.Part1 then
					motor.Part1.CanCollide = collide
				end
			end
			a0:Destroy()
			a1:Destroy()
			bs:Destroy()
		end
		e.Ragdolled = false
		if not e.Dead and e.Humanoid.Parent then
			e.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

---------------------------------------------------------------------
-- PLAYER DAMAGE (race passives: dodge, plot armor, zenkai; stun cap)
---------------------------------------------------------------------
function EnemyService.HitPlayer(player: Player, fraction: number, attackerPos: Vector3?, stun: number?, attacker)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not hum or hum.Health <= 0 or not data or not s then
		return
	end
	if s.God then
		return
	end
	local now = Stats.Now()
	if s.InvulnUntil > now then
		Net.FX(player, "Dodge", {})
		return
	end
	-- armour: dodge chance, then damage reduction, then thorns
	if math.random() < Stats.ArmorBonus(player, "Dodge") then
		Net.FX(player, "Dodge", {})
		return
	end
	local race = Stats.Race(data)
	local dmg = hum.MaxHealth * fraction * (1 - Stats.Defense(player))
	local thorns = Stats.ArmorBonus(player, "Thorns")
	if thorns > 0 and attacker and not attacker.Dead then
		EnemyService.Damage(attacker, player, Stats.Damage(player) * thorns, false)
	end
	local newHealth = hum.Health - dmg
	if newHealth <= 0 and race.PlotArmor and math.random() < race.PlotArmor then
		newHealth = 1
		s.InvulnUntil = now + Config.PlotArmorIFrames
		Net.FX(player, "PlotArmor", {})
	end
	hum.Health = math.max(0, newHealth)
	if stun and stun > 0 then
		s.StunnedUntil = os.clock() + math.min(stun, B.PlayerStunCap)
	end
	Net.FX(player, "Hurt", { Amount = dmg, From = attackerPos, Stun = stun and math.min(stun, B.PlayerStunCap) or nil })
	if race.Zenkai and hum.Health > 0 and hum.Health / hum.MaxHealth < Config.ZenkaiThreshold and now >= s.ZenkaiReady then
		s.ZenkaiEnd = now + Config.ZenkaiDuration
		s.ZenkaiReady = now + Config.ZenkaiCooldown
		hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.3)
		Net.FXAll("Transform", { Player = player, Kind = "Zenkai", Color = Color3.fromRGB(255, 225, 60) })
		if EnemyService.OnZenkai then
			EnemyService.OnZenkai(player)
		end
		DataService.MarkDirty(player)
	end
end

---------------------------------------------------------------------
-- DAMAGE / DEATH / REWARDS
---------------------------------------------------------------------
-- Armour is the rare gear drop (weapons come from the Forge).
local function gearDrop(player: Player, chance: number)
	if math.random() >= chance * Stats.EventMult("Drops") then
		return
	end
	local armorId, rarityId = Weapons.RollArmor(Stats.Luck(player))
	if Weapons.AddArmor(player, armorId, rarityId) then
		Net.FX(player, "ArmorDrop", { Armor = armorId, Rarity = rarityId })
	end
end

local function reward(player: Player, enemy)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return
	end
	local stage = enemy.FloorData
	if not stage then
		return
	end
	local mult = enemy.Elite and Config.EliteDropMult or 1
	local coins = math.floor(stage.Coins * mult * Stats.CoinMult(player))
	data.Coins += coins
	data.Kills += 1
	if EnemyService.OnReward then
		EnemyService.OnReward(player, enemy)
	end
	local luck = Stats.Luck(player) * (enemy.Elite and 2 or 1)
	local count
	if enemy.Boss then
		count = Config.BossOreDrops
	elseif enemy.Elite then
		count = 3
	else
		count = (math.random() < 0.25) and 2 or 1
	end
	count = math.floor(count * Stats.EventMult("Drops"))
	local pos = enemy.Root.Position
	for i = 1, count do
		local minOrder = (enemy.Boss and i == 1) and 4 or nil
		local oreId = Loot.RollOre(stage.Drops, luck, minOrder)
		local off = Vector3.new(math.random() * 8 - 4, 0, math.random() * 8 - 4) * (enemy.Boss and 2 or 1)
		Loot.Drop(player, oreId, Vector3.new(pos.X + off.X, enemy.Home.Y + 1.2, pos.Z + off.Z))
	end
	if enemy.Boss and math.random() < Config.BossRerollChance then
		data.Rerolls += 1
		Net.Notify(player, "The boss dropped a Race Reroll!", Color3.fromRGB(200, 150, 255), "RarePickup")
	end
	gearDrop(player, enemy.Boss and Config.ArmorDropChance.Boss or (enemy.Elite and Config.ArmorDropChance.Elite or Config.ArmorDropChance.Normal))
	if enemy.Boss and math.random() < 0.35 then
		data.Keys.RareScroll = (data.Keys.RareScroll or 0) + 1
		Net.Notify(player, "The boss dropped a Rare+ Catalyst!", Color3.fromRGB(70, 160, 255), "RarePickup")
	end
	if Stats.Race(data).Id == "Ninja" then
		s.InvulnUntil = math.max(s.InvulnUntil, Stats.Now() + Config.NinjaDodgeTime)
	end
	Net.FX(player, "Reward", { Coins = coins, Pos = pos })
	DataService.MarkDirty(player)
end
EnemyService.GearDrop = gearDrop

function EnemyService.Kill(enemy, killer: Player?)
	if enemy.Dead then
		return
	end
	enemy.Dead = true
	enemy.Humanoid.WalkSpeed = 0
	enemy.Model:SetAttribute("HP", 0)
	Net.FXAll("Kill", { Model = enemy.Model, Color = enemy.Color, Big = enemy.Boss, Elite = enemy.Elite, Pos = enemy.Root.Position, By = killer })
	if killer and EnemyService.OnKill then
		task.spawn(EnemyService.OnKill, killer, enemy)
	end
	if enemy.OnDeath then
		task.spawn(enemy.OnDeath, killer)
	else
		for player in pairs(enemy.Damagers) do
			if player.Parent then
				reward(player, enemy)
			end
		end
	end
	if enemy.OnKilled then
		task.spawn(enemy.OnKilled, killer)
	end
	EnemyService.Ragdoll(enemy, 1, true)
	task.delay(0.9, function()
		local idx = table.find(EnemyService.Active, enemy)
		if idx then
			table.remove(EnemyService.Active, idx)
		end
		enemy.Model:Destroy()
	end)
end

function EnemyService.Damage(enemy, player: Player, amount: number, crit: boolean?)
	if enemy.Dead or (enemy.Owner and enemy.Owner ~= player) then
		return
	end
	-- punish window: enemies recovering from an attack take extra damage
	local exposed = os.clock() < enemy.RecoverUntil
	if exposed then
		amount *= AI.RecoverDamageMult
	end
	if os.clock() < (enemy.SlowUntil or 0) then
		amount *= 1.25
	end
	amount = math.max(1, math.floor(amount))
	enemy.HP -= amount
	enemy.Damagers[player] = true
	enemy.LastDamaged = os.clock()
	enemy.Model:SetAttribute("HP", math.clamp(enemy.HP / enemy.MaxHP, 0, 1))
	Net.FXAll("Hit", { Pos = enemy.Root.Position + Vector3.new(0, enemy.Scale, 0), Amount = amount, Crit = crit, Model = enemy.Model, Color = enemy.Color, By = player, Exposed = exposed, Boss = enemy.Boss })
	if enemy.HP <= 0 then
		EnemyService.Kill(enemy, player)
	end
end

function EnemyService.DoT(e, player: Player, perTick: number, count: number, interval: number, color: Color3?)
	task.spawn(function()
		for _ = 1, count do
			task.wait(interval)
			if e.Dead then
				return
			end
			EnemyService.Damage(e, player, perTick, false)
			if color then
				Net.FXAll("Impact", { Pos = e.Root.Position, Color = color, Radius = 3, Kind = "Burn" })
			end
		end
	end)
end

---------------------------------------------------------------------
-- AI
---------------------------------------------------------------------
local function playerRoots()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if r and h and h.Health > 0 then
			table.insert(list, { Player = p, Root = r })
		end
	end
	return list
end

local function inBounds(e, pos: Vector3, pad: number): boolean
	return pos.X >= e.Min.X - pad and pos.X <= e.Max.X + pad and pos.Z >= e.Min.Z - pad and pos.Z <= e.Max.Z + pad and math.abs(pos.Y - e.Home.Y) < 40
end

local function clampToBounds(e, pos: Vector3): Vector3
	return Vector3.new(math.clamp(pos.X, e.Min.X, e.Max.X), pos.Y, math.clamp(pos.Z, e.Min.Z, e.Max.Z))
end

local function face(e, pos: Vector3)
	local from = e.Root.Position
	local look = Vector3.new(pos.X, from.Y, pos.Z)
	if (look - from).Magnitude > 0.1 then
		e.Root.CFrame = CFrame.lookAt(from, look)
	end
end

local function moveToward(e, goal: Vector3)
	goal = clampToBounds(e, goal)
	local t = os.clock()
	local dist = (goal - e.Root.Position).Magnitude
	if dist < 16 then
		e.Waypoints = nil
		e.Humanoid:MoveTo(goal)
		return
	end
	if t >= e.NextPath and not e.Computing then
		e.NextPath = t + AI.PathRecompute
		e.Computing = true
		task.spawn(function()
			e.Path = e.Path or PathfindingService:CreatePath({ AgentRadius = 2 * e.Scale, AgentHeight = 5 * e.Scale, AgentCanJump = false })
			local ok = pcall(function()
				e.Path:ComputeAsync(e.Root.Position, goal)
			end)
			if ok and e.Path.Status == Enum.PathStatus.Success then
				e.Waypoints = e.Path:GetWaypoints()
				e.WpIndex = 2
			else
				e.Waypoints = nil
			end
			e.Computing = false
		end)
	end
	local wps = e.Waypoints
	if wps and e.WpIndex and e.WpIndex <= #wps then
		local wp = wps[e.WpIndex].Position
		local flatD = Vector3.new(wp.X - e.Root.Position.X, 0, wp.Z - e.Root.Position.Z).Magnitude
		if flatD < 3 then
			e.WpIndex += 1
		end
		e.Humanoid:MoveTo(wp)
	else
		e.Humanoid:MoveTo(goal)
	end
end

-- Basic attack: anticipation (slow wind-up, lean back, eyes flare) ->
-- strike (animation snaps forward, damage on the "Hit" marker) ->
-- recovery (slumped, core dim, takes extra damage).
local function basicAttack(e, target)
	local tier = tierKey(e)
	local antic = AI.Anticipation[tier]
	local recover = AI.Recovery[tier]
	e.State = "Attack"
	e.LastBasic = os.clock()
	e.Humanoid:MoveTo(e.Root.Position)
	face(e, target.Root.Position)
	local track = e.Tracks.BasicAttack
	if track then
		track:Play(0.1)
		track:AdjustSpeed(0.25) -- slow "coil" during anticipation
	end
	setPose(e, "Anticipate", antic)
	task.spawn(function()
		task.wait(antic)
		if e.Dead or e.Ragdolled or os.clock() < e.StunnedUntil then
			if track then
				track:Stop(0.15)
			end
			e.State = "Chase"
			return
		end
		face(e, target.Root.Position)
		if track then
			track:AdjustSpeed(1.5) -- snap into the strike
		end
		setPose(e, "Strike", 0.15)
		Net.FXAll("EnemySwipe", { Pos = e.Root.Position, Target = target.Root.Position, Color = e.Color, Model = e.Model })
		waitForHit(track, Config.EnemyAnims.BasicHitTime / 1.5)
		if not e.Dead and not e.Ragdolled and os.clock() >= e.StunnedUntil and target.Root.Parent then
			local reach = Config.EnemyAttackRange + e.Radius
			if (target.Root.Position - e.Root.Position).Magnitude <= reach * 1.2 then
				EnemyService.HitPlayer(target.Player, e.HitPercent, e.Root.Position, nil, e)
			end
		end
		if e.Dead then
			return
		end
		-- recovery: a readable, punishable opening
		e.RecoverUntil = os.clock() + recover
		setPose(e, "Recover", recover)
		task.wait(recover)
		if e.State == "Attack" then
			e.State = "Chase"
			setPose(e, "Idle", 0.3)
		end
	end)
end

-- Special attack state machine: wind-up (telegraph) -> release (hit sync).
local function specialAttack(e, target)
	local tier = tierKey(e)
	e.State = "Windup"
	e.NextSpecial = os.clock() + AI.SpecialCooldown[tier] + AI.SpecialRecovery[tier]
	e.Humanoid:MoveTo(e.Root.Position)
	face(e, target.Root.Position)
	local windup = AI.Windup[tier]
	local kind = e.Boss and "Slam" or "Lunge"
	local start = e.Root.Position
	local dir = Vector3.new(target.Root.Position.X - start.X, 0, target.Root.Position.Z - start.Z)
	dir = dir.Magnitude > 0.1 and dir.Unit or e.Root.CFrame.LookVector
	local ground = Vector3.new(start.X, e.Home.Y + 0.2, start.Z)
	local slamAt = Vector3.new(target.Root.Position.X, e.Home.Y + 0.2, target.Root.Position.Z)
	local lungeLen = 16 * math.max(1, e.Scale * 0.7)
	local radius = e.Boss and Config.BossSlamRadius or 5
	local wind = e.Tracks.SpecialWindup
	if wind then
		wind:Play(0.1)
		wind:AdjustSpeed(math.clamp(wind.Length / windup, 0.5, 2))
	end
	setPose(e, "Windup", windup)
	Net.FXAll("EnemyWindup", {
		Model = e.Model,
		Kind = kind,
		Pos = kind == "Slam" and slamAt or ground,
		Dir = dir,
		Length = lungeLen,
		Radius = radius,
		Time = windup,
		Color = e.Color,
	})
	task.spawn(function()
		task.wait(windup)
		if wind then
			wind:Stop(0.1)
		end
		if e.Dead or e.Ragdolled or os.clock() < e.StunnedUntil then
			e.State = "Chase"
			return
		end
		local release = e.Tracks.SpecialRelease
		if release then
			release:Play(0.05)
		end
		setPose(e, "Strike", 0.2)
		if kind == "Lunge" then
			e.Root.AssemblyLinearVelocity = dir * 70 + Vector3.new(0, 5, 0)
		end
		waitForHit(release, Config.EnemyAnims.SpecialHitTime)
		if e.Dead then
			return
		end
		local pct = AI.SpecialPercent[tier]
		if kind == "Slam" then
			Net.FXAll("Slam", { Pos = slamAt, Radius = radius, Color = e.Color })
			for _, pr in ipairs(playerRoots()) do
				local d = Vector3.new(pr.Root.Position.X - slamAt.X, 0, pr.Root.Position.Z - slamAt.Z).Magnitude
				if d <= radius and (not e.Owner or e.Owner == pr.Player) then
					EnemyService.HitPlayer(pr.Player, pct, slamAt, 0.6, e)
				end
			end
		else
			local finish = start + dir * lungeLen
			Net.FXAll("EnemyLunge", { From = start, To = finish, Color = e.Color })
			for _, pr in ipairs(playerRoots()) do
				local p = pr.Root.Position
				local ab = finish - start
				local tt = math.clamp((p - start):Dot(ab) / ab:Dot(ab), 0, 1)
				if (p - (start + ab * tt)).Magnitude <= 4.5 and (not e.Owner or e.Owner == pr.Player) then
					EnemyService.HitPlayer(pr.Player, pct, start, 0.3, e)
				end
			end
		end
		-- long recovery after a special: the big punish window
		local recover = AI.SpecialRecovery[tier]
		e.State = "Recover"
		e.RecoverUntil = os.clock() + recover
		setPose(e, "Recover", recover)
		task.wait(recover)
		if e.State == "Recover" then
			e.State = "Chase"
			setPose(e, "Idle", 0.3)
		end
	end)
end

local function stepAI()
	local roots = playerRoots()
	local t = os.clock()
	for _, e in ipairs(EnemyService.Active) do
		if not e.Dead and e.Root.Parent and not e.Ragdolled and t >= e.StunnedUntil and e.State ~= "Windup" and e.State ~= "Attack" and e.State ~= "Recover" then
			local epos = e.Root.Position
			local target, targetDist = nil, math.huge
			local nearest = math.huge
			for _, pr in ipairs(roots) do
				local d = (pr.Root.Position - epos).Magnitude
				nearest = math.min(nearest, d)
				if (not e.Owner or e.Owner == pr.Player) and d < Config.EnemyAggroRange * (e.Boss and 1.6 or 1) and d < targetDist and inBounds(e, pr.Root.Position, 6) then
					target, targetDist = pr, d
				end
			end
			if nearest < 220 then
				if target then
					e.State = "Chase"
					local tier = tierKey(e)
					local reach = Config.EnemyAttackRange + e.Radius
					if t >= e.NextSpecial and targetDist <= AI.SpecialRange[tier] then
						specialAttack(e, target)
					elseif targetDist <= reach and t - e.LastBasic >= Config.EnemyAttackCooldown then
						basicAttack(e, target)
					elseif targetDist > reach * 0.8 then
						moveToward(e, target.Root.Position)
					else
						e.Humanoid:MoveTo(epos)
						face(e, target.Root.Position)
					end
				else
					e.State = "Idle"
					if t >= e.NextWander then
						e.NextWander = t + 2 + math.random() * 3
						e.Humanoid:MoveTo(e.Boss and e.Home or randomPoint(e.Min, e.Max))
					end
				end
			end
		end
	end
end

-- Clears every living enemy (admin). Owned enemies credit their owner.
function EnemyService.KillAll(byPlayer: Player?)
	for _, e in ipairs(table.clone(EnemyService.Active)) do
		if not e.Dead then
			EnemyService.Kill(e, e.Owner or byPlayer)
		end
	end
end

-- Removes an enemy without rewards (run ended, room reset...).
function EnemyService.Despawn(e)
	if e.Dead then
		return
	end
	e.Dead = true
	local idx = table.find(EnemyService.Active, e)
	if idx then
		table.remove(EnemyService.Active, idx)
	end
	if e.Model then
		e.Model:Destroy()
	end
end

function EnemyService.Init(m)
	map = m
	-- pre-build the first zone's rigs so the first rooms spawn instantly
	task.spawn(function()
		local z = Config.Zones[1]
		for _, id in ipairs(z.Enemies) do
			templateFor(id)
		end
		templateFor(z.Bosses[1])
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			local ok, err = pcall(stepAI)
			if not ok then
				warn("[Enemy AI]", err)
			end
		end
	end)
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Forge</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Forge (ModuleScript) -> ServerScriptService/Server/Forge
-- Weapon crafting (replaces the old weapon chests). Put 1-3 ores from your
-- bag into the Forge (plus an optional catalyst) to forge a weapon:
--   * ore effects are stamped onto the weapon (Config.Effects)
--   * the effects decide the weapon type (ForgeRules.ClassOdds)
--   * rarer ores / catalysts raise the rarity
--   * exact recipes (Config.Recipes) forge unique iconic weapons
-- Forging also grants Forge levels (the old "+1 Forge" progression).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local ForgeRules = require(Shared:WaitForChild("ForgeRules"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Weapons = require(script.Parent:WaitForChild("Weapons"))

local Forge = {}
local rng = Random.new()
local RED = Color3.fromRGB(255, 110, 90)

local function pickClass(analysis): string
	local total = 0
	for _, w in pairs(analysis.ClassWeights) do
		total += w
	end
	local roll = rng:NextNumber() * total
	for cls, w in pairs(analysis.ClassWeights) do
		roll -= w
		if roll <= 0 then
			return cls
		end
	end
	return "Katana"
end

-- payload = { Ores = { oreId, oreId, oreId }, Catalyst = key? }
function Forge.Craft(player: Player, payload)
	local data = DataService.Get(player)
	if not data or type(payload) ~= "table" or type(payload.Ores) ~= "table" then
		return
	end
	-- validate ores (and that the bag really holds them)
	local ores = {}
	local need = {}
	for i = 1, math.min(#payload.Ores, Config.Forge.Slots) do
		local id = payload.Ores[i]
		if type(id) ~= "string" or not Config.OreById[id] then
			return
		end
		table.insert(ores, id)
		need[id] = (need[id] or 0) + 1
	end
	if #ores == 0 then
		Net.Notify(player, "Put at least one ore in the Forge.", RED, "Error")
		return
	end
	for id, n in pairs(need) do
		if (data.Backpack[id] or 0) < n then
			Net.Notify(player, "You don't have enough " .. Config.OreById[id].Name .. ".", RED, "Error")
			return
		end
	end
	local catalyst = payload.Catalyst
	if catalyst ~= nil then
		if type(catalyst) ~= "string" or not Config.Catalysts[catalyst] then
			return
		end
		if (data.Keys[catalyst] or 0) <= 0 then
			Net.Notify(player, "You don't have a " .. Config.Catalysts[catalyst].Name .. ".", RED, "Error")
			return
		end
	end

	local analysis = ForgeRules.Analyze(ores)
	local cost = ForgeRules.Cost(analysis, Stats.PrestigeMult(data, "Coins"))
	if data.Coins < cost then
		Net.Notify(player, "Forging this needs " .. cost .. " Coins.", RED, "Error")
		return
	end

	-- spend
	data.Coins -= cost
	for id, n in pairs(need) do
		data.Backpack[id] -= n
		if data.Backpack[id] <= 0 then
			data.Backpack[id] = nil
		end
	end
	if catalyst then
		data.Keys[catalyst] -= 1
	end

	-- rarity
	local minIndex = analysis.MinRarityIndex
	if catalyst then
		minIndex = math.max(minIndex, Config.WeaponRarityById[Config.Catalysts[catalyst].MinRarity].Index)
	end
	local luck = Stats.Luck(player) * analysis.Luck
	local rarityId = Weapons.RollRarity(Config.WeaponRarities[minIndex].Id, luck)
	local rarityIndex = Config.WeaponRarityById[rarityId].Index

	-- weapon
	local def
	local recipe = analysis.Recipe
	if recipe then
		def = Config.WeaponById[recipe.Weapon]
		local base = Config.WeaponRarityById[def.Rarity].Index
		if rarityIndex < base then
			rarityIndex = base
			rarityId = def.Rarity
		end
	else
		def = ForgeRules.PickWeapon(pickClass(analysis), rarityIndex, rng)
	end

	local uid = Weapons.Add(player, def.Id, rarityId, analysis.Effects)
	local firstTime = false
	if recipe and not data.Recipes[recipe.Key] then
		data.Recipes[recipe.Key] = true
		firstTime = true
	end

	-- the "+1 Forge" progression lives on: forging raises your Forge level
	local before = data.Blade
	local gained = math.max(1, math.floor(analysis.Blade * Stats.ForgeMult(player)))
	data.Blade += gained
	local _, tierBefore = Config.GetBladeTier(before)
	local tier, tierAfter = Config.GetBladeTier(data.Blade)
	-- QoL: new weapons go straight into your hands (Settings -> Auto-Equip)
	local autoEquip = data.Settings.AutoEquip ~= false and uid ~= nil
	if autoEquip then
		data.Equipped = uid
	end
	Weapons.Refresh(player)
	DataService.MarkDirty(player)

	Net.FX(player, "ForgeResult", {
		Equipped = autoEquip,
		Uid = uid,
		Weapon = def.Id,
		Rarity = rarityId,
		Effects = analysis.Effects,
		Recipe = recipe and recipe.Index or nil,
		FirstRecipe = firstTime,
		Gained = gained,
		From = before,
		To = data.Blade,
		TierUp = tierAfter > tierBefore and tierAfter or nil,
		TierName = tier.Name,
	})
	Net.FXAll("ForgeBurst", { Player = player, Color = Config.WeaponRarityById[rarityId].Color })
	if recipe and firstTime then
		Net.FXAll("Notify", { Text = player.DisplayName .. " forged the legendary " .. def.Name .. "!", Color = Config.WeaponRarityById[rarityId].Color, Sound = "RarePickup" })
	end
end

return Forge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Leaderboards</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Leaderboards (ModuleScript) -> ServerScriptService/Server/Leaderboards
-- Four global boards at spawn (Config.Leaderboards), backed by
-- OrderedDataStores. Exponential stats (Power) are stored as log10 * 1000
-- so even astronomically large values fit in an integer key.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local Leaderboards = {}

local RANK_COLORS = { Color3.fromRGB(255, 215, 90), Color3.fromRGB(220, 228, 240), Color3.fromRGB(255, 160, 90) }
local names = {}

local function valueOf(key: string, data): number
	if key == "Power" then
		return data.Power
	elseif key == "Stage" then
		return data.BestFloor or 0
	elseif key == "Prestige" then
		-- ascensions dominate, then rebirths
		return data.Ascensions * 100000 + data.Rebirths
	elseif key == "Kills" then
		return data.Kills
	end
	return 0
end

local function encode(lb, v: number): number
	if lb.Log then
		return math.floor(math.log10(math.max(1, v)) * 1000)
	end
	return math.floor(v)
end

local function display(lb, stored: number): string
	if lb.Log then
		return Format.Abbrev(10 ^ (stored / 1000))
	elseif lb.Key == "Stage" then
		return "Floor " .. stored
	elseif lb.Key == "Prestige" then
		local asc = math.floor(stored / 100000)
		local reb = stored % 100000
		return (asc > 0 and (asc .. " Asc  ") or "") .. reb .. " Reb"
	end
	return Format.Abbrev(stored)
end

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, result = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local n = ok and result or ("User " .. userId)
	names[userId] = n
	return n
end

local function row(parent: Instance, rank: number, name: string, value: string)
	local f = Instance.new("Frame")
	f.Name = "Row" .. rank
	f.LayoutOrder = rank
	f.Size = UDim2.fromScale(1, 0.092)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = rank % 2 == 0 and 0.96 or 0.92
	f.BorderSizePixel = 0
	f.Parent = parent
	local color = RANK_COLORS[rank] or Color3.new(1, 1, 1)
	for i, spec in ipairs({ { tostring(rank), 0, 0.12, Enum.TextXAlignment.Center }, { name, 0.13, 0.52, Enum.TextXAlignment.Left }, { value, 0.66, 0.33, Enum.TextXAlignment.Right } }) do
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(spec[2], 0.08)
		t.Size = UDim2.fromScale(spec[3], 0.84)
		t.Font = i == 1 and Config.Fonts.Display or Config.Fonts.Body
		t.TextScaled = true
		t.TextXAlignment = spec[4]
		t.Text = spec[1]
		t.TextColor3 = i == 3 and color:Lerp(Color3.new(1, 1, 1), 0.3) or color
		t.Parent = f
	end
end

local function render(rows: Instance, lb, entries)
	for _, c in ipairs(rows:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	if #entries == 0 then
		row(rows, 1, "No one yet - be first!", "")
		return
	end
	for rank, e in ipairs(entries) do
		row(rows, rank, e.Name, display(lb, e.Value))
	end
end

function Leaderboards.Init(map)
	local boards = map.Leaderboards or {}
	task.spawn(function()
		local stores = {}
		for _, lb in ipairs(Config.Leaderboards) do
			local ok, store = pcall(function()
				return DataStoreService:GetOrderedDataStore(lb.Store)
			end)
			stores[lb.Key] = ok and store or nil
		end
		while true do
			for _, lb in ipairs(Config.Leaderboards) do
				local store = stores[lb.Key]
				local rows = boards[lb.Key]
				if store and rows then
					for _, player in ipairs(Players:GetPlayers()) do
						local data = DataService.Get(player)
						if data then
							pcall(function()
								store:SetAsync(tostring(player.UserId), encode(lb, valueOf(lb.Key, data)))
							end)
						end
					end
					local ok, pages = pcall(function()
						return store:GetSortedAsync(false, 10)
					end)
					local entries = {}
					if ok and pages then
						for _, entry in ipairs(pages:GetCurrentPage()) do
							local userId = tonumber(entry.key)
							if userId then
								table.insert(entries, { Name = nameOf(userId), Value = entry.value })
							end
						end
					else
						-- DataStores unavailable (Studio without API access): show this server
						for _, player in ipairs(Players:GetPlayers()) do
							local data = DataService.Get(player)
							if data then
								table.insert(entries, { Name = player.DisplayName, Value = encode(lb, valueOf(lb.Key, data)) })
							end
						end
						table.sort(entries, function(a, b)
							return a.Value > b.Value
						end)
					end
					render(rows, lb, entries)
				elseif rows then
					render(rows, lb, {})
				end
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Loot</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Loot (ModuleScript) -> ServerScriptService/Server/Loot
-- Ore rolls, drops, pickup (interact with the F prompt), ore bag and selling.
-- Ore is turned into weapons at the Forge (see Forge.luau).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))

local Loot = {}

-- Roll one ore from a weight table. Luck multiplies rarer ores' weights.
function Loot.RollOre(drops: { [string]: number }, luck: number, minOrder: number?): string
	local total = 0
	local entries = {}
	for oreId, weight in pairs(drops) do
		local ore = Config.OreById[oreId]
		if ore and (not minOrder or ore.Order >= minOrder) then
			local w = weight * luck ^ ((ore.Order - 1) * 0.5)
			total += w
			table.insert(entries, { oreId, w })
		end
	end
	if #entries == 0 then
		-- nothing matched the minimum rarity: give the rarest ore in the table
		local best, bestOrder = "RiftPebble", 0
		for oreId in pairs(drops) do
			local ore = Config.OreById[oreId]
			if ore and ore.Order > bestOrder then
				best, bestOrder = oreId, ore.Order
			end
		end
		return best
	end
	local r = math.random() * total
	for _, e in ipairs(entries) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return entries[#entries][1]
end

---------------------------------------------------------------------
-- INDEX (first-time discovery rewards)
---------------------------------------------------------------------
-- Picking up a new ore only *finds* it; the player unlocks it in the Index
-- (click the card) to reveal it and claim the coin reward.
local function discover(player: Player, data, oreId: string)
	if data.Index[oreId] or data.IndexFound[oreId] then
		return
	end
	data.IndexFound[oreId] = true
	local ore = Config.OreById[oreId]
	Net.FX(player, "Discover", { Ore = oreId, Reward = Config.IndexReward[ore.Rarity] or 0 })
end

function Loot.UnlockIndex(player: Player, oreId)
	local data = DataService.Get(player)
	local ore = type(oreId) == "string" and Config.OreById[oreId]
	if not data or not ore or data.Index[oreId] or not data.IndexFound[oreId] then
		return
	end
	data.Index[oreId] = true
	local reward = Config.IndexReward[ore.Rarity] or 0
	data.Coins += reward
	Net.FX(player, "IndexUnlocked", { Ore = oreId, Reward = reward })
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
-- ADD ORE (bag / auto-sell)
---------------------------------------------------------------------
function Loot.AddOre(player: Player, oreId: string, count: number): boolean
	local data = DataService.Get(player)
	if not data or not Config.OreById[oreId] then
		return false
	end
	count = count or 1
	discover(player, data, oreId)
	local max = Stats.BackpackMax(player)
	local have = Stats.BackpackCount(data)
	if have >= max then
		-- Auto-Sell gamepass: a full bag sells new ore on the spot
		if Stats.HasPass(player, "AutoSell") then
			local ore = Config.OreById[oreId]
			local coins = math.floor(ore.Sell * count * Stats.CoinMult(player))
			data.Coins += coins
			DataService.MarkDirty(player)
			return true
		end
		return false
	end
	data.Backpack[oreId] = (data.Backpack[oreId] or 0) + math.min(count, max - have)
	DataService.MarkDirty(player)
	return true
end

---------------------------------------------------------------------
-- DROPS (rendered on the owner's client, validated here)
---------------------------------------------------------------------
function Loot.Drop(player: Player, oreId: string, pos: Vector3)
	local s = DataService.Session(player)
	if not s then
		return
	end
	if Stats.HasPass(player, "AutoCollect") then
		local ok = Loot.AddOre(player, oreId, 1)
		Net.FX(player, "Drop", { Ore = oreId, Pos = pos, Auto = ok })
		if ok then
			return
		end
		Loot.NotifyFull(player)
	end
	s.NextDropId += 1
	local id = s.NextDropId
	s.Drops[id] = { Ore = oreId, Pos = pos, Expire = os.clock() + Config.DropLifetime }
	Net.FX(player, "Drop", { Id = id, Ore = oreId, Pos = pos })
end

function Loot.NotifyFull(player: Player)
	local s = DataService.Session(player)
	if s and os.clock() - s.LastFullNotify > 3 then
		s.LastFullNotify = os.clock()
		Net.Notify(player, "Ore bag full! Forge weapons or sell ore at spawn (or upgrade your bag).", Color3.fromRGB(255, 120, 90), "Error")
	end
end

function Loot.Collect(player: Player, id: number)
	local s = DataService.Session(player)
	if not s or type(id) ~= "number" then
		return
	end
	local drop = s.Drops[id]
	if not drop then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - drop.Pos).Magnitude > Config.PickupRadius + 8 then
		Net.FX(player, "CollectFail", { Id = id })
		return
	end
	if Loot.AddOre(player, drop.Ore, 1) then
		s.Drops[id] = nil
		Net.FX(player, "Collected", { Id = id, Ore = drop.Ore })
	else
		Loot.NotifyFull(player)
		Net.FX(player, "CollectFail", { Id = id, Full = true })
	end
end

function Loot.CleanupDrops(player: Player)
	local s = DataService.Session(player)
	if not s then
		return
	end
	local t = os.clock()
	for id, d in pairs(s.Drops) do
		if d.Expire < t then
			s.Drops[id] = nil
		end
	end
end

---------------------------------------------------------------------
-- SELL
---------------------------------------------------------------------
function Loot.Sell(player: Player, oreId: string?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local coins = 0
	for id, count in pairs(data.Backpack) do
		if oreId == nil or oreId == id then
			local ore = Config.OreById[id]
			if ore then
				coins += ore.Sell * count
			end
			data.Backpack[id] = nil
		end
	end
	if coins <= 0 then
		return 0
	end
	coins = math.floor(coins * Stats.CoinMult(player))
	data.Coins += coins
	DataService.MarkDirty(player)
	Net.FX(player, "Sell", { Coins = coins, Text = "+" .. Format.Abbrev(coins) .. " Coins" })
	return coins
end

return Loot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapBuilder (ModuleScript) -> ServerScriptService/Server/MapBuilder
-- Builds the whole world in code, simulator style (and a little darker):
--   Spawn Plaza   Soul Forge, Sell + Upgrade stalls, Race altar, Rebirth /
--                 Ascension statue, Ore Index and four leaderboards.
--   West island   Training Grounds (multiplier pads gated by rebirths /
--                 ascensions).
--   East island   Boss Rush arena.
--   North         THE PATH: one long road of stages like +1 Loot To Forge.
--                 Kill enough enemies to open the next gate; a boss guards
--                 every 5th stage; the theme changes every zone.
-- There is NO VIP room and NO PvP arena.

local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local VFX = require(Shared:WaitForChild("VFX"))
local Format = require(Shared:WaitForChild("Format"))

local MapBuilder = {}

local WHITE = Color3.new(1, 1, 1)
local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> Y (flat disc)

local root: Folder

local function P(parent: Instance, props): Part
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "ClassName" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p :: any
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function disc(parent, pos: Vector3, diameter: number, thickness: number, color: Color3, material: Enum.Material?, name: string?)
	return P(parent, {
		Name = name or "Disc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, diameter, diameter),
		CFrame = CFrame.new(pos) * FLAT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

-- Minimal world label. Starts at 0% opacity (the "Fade" CanvasGroup) and is
-- faded in by Client/WorldText only when a player walks close. No boxes:
-- the text sits on a soft glow streak with a light drop shadow.
-- radius (optional) widens the proximity zone for very large landmarks.
local function textLine(parent: Instance, name: string, text: string, color: Color3, font: Enum.Font, pos: UDim2, size: UDim2, z: number)
	local shadow = Instance.new("TextLabel")
	shadow.Name = name .. "Shadow"
	shadow.BackgroundTransparency = 1
	shadow.Position = pos + UDim2.fromOffset(0, 2)
	shadow.Size = size
	shadow.Font = font
	shadow.TextScaled = true
	shadow.Text = text
	shadow.TextColor3 = Color3.fromRGB(8, 6, 16)
	shadow.TextTransparency = 0.45
	shadow.ZIndex = z
	shadow.Parent = parent
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Position = pos
	t.Size = size
	t.Font = font
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.ZIndex = z + 1
	t.Parent = parent
	-- keep the shadow in sync if the text is changed later (gate labels)
	t:GetPropertyChangedSignal("Text"):Connect(function()
		shadow.Text = t.Text
	end)
	local glow = Instance.new("UIStroke")
	glow.Thickness = 1.2
	glow.Color = color
	glow.Transparency = 0.6
	glow.Parent = t
	return t
end

local function billboard(adornee: Instance, title: string, sub: string?, color: Color3, height: number, scale, radius: number?)
	scale = (scale or 1) * Config.WorldText.FontScale
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(320 * scale, (sub and 100 or 62) * scale)
	bb.StudsOffset = Vector3.new(0, height, 0)
	bb.MaxDistance = 150
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.ClipsDescendants = false
	if radius then
		bb:SetAttribute("Radius", radius)
	end
	CollectionService:AddTag(bb, "WorldLabel")
	bb.Parent = adornee

	local fade = Instance.new("CanvasGroup")
	fade.Name = "Fade"
	fade.BackgroundTransparency = 1
	fade.Size = UDim2.fromScale(1, 1)
	fade.GroupTransparency = 1 -- 0% opacity until the player is near
	fade.Parent = bb

	-- soft glow streak behind the title (no hard edges, no box)
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, sub and 0.34 or 0.5)
	glow.Size = UDim2.fromScale(1, sub and 0.5 or 0.8)
	glow.BackgroundColor3 = color
	glow.BorderSizePixel = 0
	glow.Parent = fade
	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(0.5, 0)
	gc.Parent = glow
	local gg = Instance.new("UIGradient")
	gg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.84),
		NumberSequenceKeypoint.new(1, 1),
	})
	gg.Parent = glow

	local titleH = sub and 0.6 or 1
	textLine(fade, "Title", title, color:Lerp(WHITE, 0.25), Config.Fonts.Display, UDim2.fromScale(0, 0), UDim2.fromScale(1, titleH), 2)
	if sub then
		local rule = Instance.new("Frame")
		rule.Name = "Rule"
		rule.AnchorPoint = Vector2.new(0.5, 0)
		rule.Position = UDim2.fromScale(0.5, 0.63)
		rule.Size = UDim2.new(0.4, 0, 0, 1)
		rule.BackgroundColor3 = color
		rule.BorderSizePixel = 0
		rule.Parent = fade
		local rg = Instance.new("UIGradient")
		rg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		rg.Parent = rule
		textLine(fade, "Sub", sub, Color3.fromRGB(235, 232, 245), Config.Fonts.Body, UDim2.fromScale(0.05, 0.68), UDim2.fromScale(0.9, 0.3), 2)
	end
	return bb
end

-- Custom-styled prompt (drawn by Client/PromptUI). "key" is the server
-- action run when the client reports the prompt was triggered.
local function prompt(parent: Instance, action: string, object: string, name: string, key: string): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = Config.Prompt.MaxActivationDistance
	pp.RequiresLineOfSight = Config.Prompt.RequiresLineOfSight
	pp.Style = Enum.ProximityPromptStyle.Custom
	-- F / D-pad up, because E / X are the weapon-skill binds
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp.GamepadKeyCode = Enum.KeyCode.DPadUp
	pp:SetAttribute("Action", key)
	pp.Parent = parent
	return pp
end

-- Point of interest: drawn on the world map (Client/WorldMap) and gently
-- framed by the camera when you walk near it (Client/CameraDirector).
-- kind = "Service" | "Power" | "Travel" | "Danger". opts.Frame = framing
-- radius in studs (0 = no camera framing), opts.Travel = teleport id.
local function poi(part: BasePart, name: string, kind: string, desc: string, region: string, opts)
	opts = opts or {}
	part:SetAttribute("POIName", name)
	part:SetAttribute("POIKind", kind)
	part:SetAttribute("POIDesc", desc)
	part:SetAttribute("Region", region)
	part:SetAttribute("FrameRadius", opts.Frame or 22)
	if opts.Travel then
		part:SetAttribute("Travel", opts.Travel)
	end
	CollectionService:AddTag(part, "POI")
end

local function emitter(parent: Instance, preset: string, color: Color3, rate: number, offset: Vector3?)
	local a = Instance.new("Attachment")
	a.Position = offset or Vector3.zero
	a.Parent = parent
	local e = VFX.MakeEmitter(preset, color, a, rate)
	return e, a
end

local function light(parent: Instance, color: Color3, range: number, brightness: number, shadows: boolean?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

local function loopSound(parent: Instance, id: string, volume: number, pitch: number)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = volume
	s.PlaybackSpeed = pitch
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 80
	s.Parent = parent
	s.Playing = true
	return s
end

local function spin(inst: Instance, speed: number, bob: number?)
	inst:SetAttribute("SpinSpeed", speed)
	if bob then
		inst:SetAttribute("Bob", bob)
	end
	CollectionService:AddTag(inst, "Spin")
end

---------------------------------------------------------------------
-- LIGHTING (bright anime look: bloom, saturation, sun rays)
---------------------------------------------------------------------
local function buildLighting()
	local G = Config.Graphics
	-- Technology can't be set from scripts (Roblox security); the place file
	-- ships with Future. This pcall just makes the intent explicit.
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future
	end)
	-- late dusk: long shadows, a little darker overall (Config.Graphics)
	Lighting.ClockTime = G.ClockTime
	Lighting.Brightness = G.Brightness
	Lighting.Ambient = G.Ambient
	Lighting.OutdoorAmbient = G.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.18
	Lighting.ExposureCompensation = G.Exposure
	Lighting.GeographicLatitude = 35

	-- soft volumetric clouds for depth on the horizon
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(200, 185, 215)
	clouds.Parent = workspace.Terrain

	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = G.Atmosphere.Density
	atm.Offset = G.Atmosphere.Offset
	atm.Color = G.Atmosphere.Color
	atm.Decay = G.Atmosphere.Decay
	atm.Glare = G.Atmosphere.Glare
	atm.Haze = G.Atmosphere.Haze
	atm.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Threshold = G.Bloom.Threshold
	bloom.Size = G.Bloom.Size
	bloom.Intensity = G.Bloom.Intensity
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GameColor"
	cc.Contrast = G.ColorCorrection.Contrast
	cc.Saturation = G.ColorCorrection.Saturation
	cc.Brightness = G.ColorCorrection.Brightness
	cc.TintColor = Color3.fromRGB(255, 250, 255)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = G.SunRays.Intensity
	rays.Spread = G.SunRays.Spread
	rays.Parent = Lighting
end

-- Optional PBR MaterialVariants from Config.Graphics.MaterialVariants.
local function applyMaterialVariants(folderRoot: Instance)
	local variants = {}
	for matName, maps in pairs(Config.Graphics.MaterialVariants) do
		local base = (Enum.Material :: any)[matName]
		if base and maps.ColorMap and maps.ColorMap ~= "rbxassetid://0" then
			local name = "Anime_" .. matName
			local mv = MaterialService:FindFirstChild(name) or Instance.new("MaterialVariant")
			mv.Name = name
			mv.BaseMaterial = base
			mv.ColorMap = maps.ColorMap
			mv.NormalMap = maps.NormalMap or ""
			mv.RoughnessMap = maps.RoughnessMap or ""
			mv.MetalnessMap = maps.MetalnessMap or ""
			mv.Parent = MaterialService
			variants[base] = name
		end
	end
	if next(variants) == nil then
		return
	end
	for _, d in ipairs(folderRoot:GetDescendants()) do
		if d:IsA("BasePart") and variants[d.Material] then
			d.MaterialVariant = variants[d.Material]
		end
	end
end

-- Big invisible volumes that emit ambient particles.
local function ambientVolume(parent: Instance, cf: CFrame, size: Vector3, preset: string, color: Color3, rate: number)
	local vol = P(parent, { Name = "AmbientFX", Size = size, CFrame = cf, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	local e = VFX.MakeEmitter(preset, color, vol, rate)
	e.Shape = Enum.ParticleEmitterShape.Box
	return e
end

---------------------------------------------------------------------
-- DECOR PIECES
---------------------------------------------------------------------
local function cherryTree(parent, pos: Vector3, scale: number, rng: Random)
	local m = Instance.new("Model")
	m.Name = "CherryTree"
	local trunkH = 10 * scale
	P(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(trunkH, 1.8 * scale, 1.8 * scale), CFrame = CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * FLAT, Color = Color3.fromRGB(95, 60, 55), Material = Enum.Material.Wood })
	local pinks = { Color3.fromRGB(255, 170, 205), Color3.fromRGB(255, 195, 220), Color3.fromRGB(250, 145, 190) }
	local top = pos + Vector3.new(0, trunkH, 0)
	local canopy
	for i = 1, 4 do
		local off = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-0.5, 2.5), rng:NextNumber(-3, 3)) * scale
		local s = rng:NextNumber(7, 10) * scale
		canopy = P(m, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * s, CFrame = CFrame.new(top + off), Color = pinks[(i % 3) + 1], Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = true })
	end
	if canopy then
		emitter(canopy, "Petals", Color3.fromRGB(255, 170, 210), 1.2)
	end
	m.Parent = parent
	return m
end

local function lantern(parent, pos: Vector3, color: Color3?)
	color = color or Color3.fromRGB(255, 190, 110)
	P(parent, { Name = "LanternPost", Size = Vector3.new(0.6, 8, 0.6), CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)), Color = Color3.fromRGB(60, 40, 40), Material = Enum.Material.Wood })
	P(parent, { Name = "LanternArm", Size = Vector3.new(0.4, 0.4, 2.2), CFrame = CFrame.new(pos + Vector3.new(0, 7.8, 0.9)), Color = Color3.fromRGB(60, 40, 40), Material = Enum.Material.Wood })
	local lamp = P(parent, { Name = "Lantern", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8), CFrame = CFrame.new(pos + Vector3.new(0, 6.8, 1.8)), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	local l = light(lamp, color :: Color3, 18, 1.4, true)
	CollectionService:AddTag(l, "Flicker")
	return lamp
end

local function torii(parent, cf: CFrame, width: number, height: number)
	local red = Color3.fromRGB(215, 45, 45)
	local black = Color3.fromRGB(30, 25, 30)
	for _, side in ipairs({ -1, 1 }) do
		P(parent, { Name = "ToriiPillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 1.8, 1.8), CFrame = cf * CFrame.new(side * width / 2, height / 2, 0) * FLAT, Color = red, Material = Enum.Material.SmoothPlastic })
	end
	P(parent, { Name = "ToriiTop", Size = Vector3.new(width + 6, 1.4, 2.2), CFrame = cf * CFrame.new(0, height + 0.7, 0), Color = black })
	P(parent, { Name = "ToriiBeam", Size = Vector3.new(width + 4, 1.2, 1.6), CFrame = cf * CFrame.new(0, height - 2.2, 0), Color = red })
	P(parent, { Name = "ToriiBeam2", Size = Vector3.new(width + 2, 1, 1.4), CFrame = cf * CFrame.new(0, height - 0.4, 0), Color = red })
end

local function stall(parent, cf: CFrame, color: Color3, title: string, sub: string)
	local m = Instance.new("Model")
	m.Name = title .. "Stall"
	local wood = Color3.fromRGB(140, 95, 60)
	P(m, { Name = "Floor", Size = Vector3.new(16, 0.6, 12), CFrame = cf * CFrame.new(0, 0.3, 0), Color = Color3.fromRGB(110, 80, 55), Material = Enum.Material.WoodPlanks })
	local counter = P(m, { Name = "Counter", Size = Vector3.new(12, 3.4, 2.6), CFrame = cf * CFrame.new(0, 2.3, 3), Color = wood, Material = Enum.Material.WoodPlanks })
	P(m, { Name = "CounterTop", Size = Vector3.new(12.6, 0.4, 3.2), CFrame = cf * CFrame.new(0, 4.1, 3), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood })
	for _, x in ipairs({ -7, 7 }) do
		for _, z in ipairs({ -5, 4.5 }) do
			P(m, { Name = "Post", Size = Vector3.new(0.8, 10, 0.8), CFrame = cf * CFrame.new(x, 5, z), Color = wood, Material = Enum.Material.Wood })
		end
	end
	-- striped awning
	for i = 0, 7 do
		local c = (i % 2 == 0) and color or WHITE
		P(m, { Name = "Awning", Size = Vector3.new(1.95, 0.4, 12), CFrame = cf * CFrame.new(-7 + i * 2 + 1, 10.4, 0) * CFrame.Angles(math.rad(-12), 0, 0), Color = c })
	end
	-- crates of glowing ore
	for i, ore in ipairs({ Config.Ores[1], Config.Ores[3], Config.Ores[4] }) do
		local crate = P(m, { Name = "Crate", Size = Vector3.new(2.6, 2, 2.6), CFrame = cf * CFrame.new(-6 + i * 3, 1.6, -3.5), Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.WoodPlanks })
		for j = 1, 3 do
			P(m, { Name = "Ore", Size = Vector3.one * 0.8, CFrame = crate.CFrame * CFrame.new((j - 2) * 0.7, 1.2, (j % 2) * 0.4) * CFrame.Angles(0.4 * j, 0.7 * j, 0.2), Color = ore.Color, Material = Enum.Material.Neon, CanCollide = false })
		end
	end
	billboard(counter, title, sub, color, 10.5, 0.9)
	m.Parent = parent
	return m, counter
end

---------------------------------------------------------------------
-- SPAWN PLAZA
---------------------------------------------------------------------
local STONE = Color3.fromRGB(62, 58, 72)
local STONE_DARK = Color3.fromRGB(42, 39, 52)
local TRIM = Color3.fromRGB(255, 120, 190)
local W = Config.World

local function bridge(parent, from: Vector3, to: Vector3, width: number, color: Color3)
	local mid = (from + to) / 2
	local len = (to - from).Magnitude
	local cf = CFrame.lookAt(mid, to)
	P(parent, { Name = "Bridge", Size = Vector3.new(width, 1.2, len), CFrame = cf * CFrame.new(0, -0.1, 0), Color = STONE_DARK, Material = Enum.Material.Slate })
	for _, side in ipairs({ -1, 1 }) do
		P(parent, { Name = "Rail", Size = Vector3.new(0.6, 1.6, len), CFrame = cf * CFrame.new(side * (width / 2 - 0.3), 1, 0), Color = STONE, Material = Enum.Material.Slate })
		P(parent, { Name = "RailGlow", Size = Vector3.new(0.2, 0.2, len), CFrame = cf * CFrame.new(side * (width / 2 - 0.3), 1.9, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	end
end

local function board(parent, cf: CFrame, title: string, color: Color3)
	local b = P(parent, { Name = title .. "Board", Size = Vector3.new(16, 20, 1), CFrame = cf * CFrame.new(0, 11, 0), Color = STONE_DARK, Material = Enum.Material.Slate })
	P(parent, { Name = "BoardFrame", Size = Vector3.new(16.8, 20.8, 0.8), CFrame = b.CFrame * CFrame.new(0, 0, 0.2), Color = color, Material = Enum.Material.Neon, CanCollide = false }).Transparency = 0.6
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Board"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = b
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(12, 10, 20)
	bg.Parent = sg
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(color:Lerp(Color3.new(0, 0, 0), 0.75), Color3.fromRGB(10, 8, 16))
	grad.Rotation = 90
	grad.Parent = bg
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.05, 0.02)
	t.Size = UDim2.fromScale(0.9, 0.11)
	t.Font = Config.Fonts.Display
	t.TextScaled = true
	t.Text = title
	t.TextColor3 = color
	t.Parent = bg
	local rows = Instance.new("Frame")
	rows.Name = "Rows"
	rows.BackgroundTransparency = 1
	rows.Position = UDim2.fromScale(0.05, 0.15)
	rows.Size = UDim2.fromScale(0.9, 0.83)
	rows.Parent = bg
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.008, 0)
	layout.Parent = rows
	return b, rows
end

local function buildPlaza(map)
	local hub = folder("Plaza", root)
	local rng = Random.new(7)

	-- dark meadow below everything (walkable, so nobody falls forever)
	P(hub, { Name = "Ground", Size = Vector3.new(1400, 4, 1400), CFrame = CFrame.new(0, -3, -300), Color = Color3.fromRGB(34, 44, 36), Material = Enum.Material.Grass })

	local R = W.PlazaRadius
	disc(hub, Vector3.new(0, 0.5, 0), R * 2, 2, STONE, Enum.Material.Slate, "Plaza")
	disc(hub, Vector3.new(0, 1.55, 0), R * 2 - 10, 0.2, Color3.fromRGB(78, 74, 90), Enum.Material.Slate, "PlazaInner")
	disc(hub, Vector3.new(0, 1.6, 0), R * 2 - 9, 0.12, TRIM, Enum.Material.Neon, "PlazaGlow").Transparency = 0.55
	disc(hub, Vector3.new(0, 1.7, 0), 26, 0.12, Color3.fromRGB(95, 88, 115), Enum.Material.Marble, "Emblem")
	disc(hub, Vector3.new(0, 1.75, 0), 22, 0.1, TRIM, Enum.Material.Neon, "EmblemGlow").Transparency = 0.7

	-- spawn
	local spawn = P(hub, { ClassName = "SpawnLocation", Name = "Spawn", Size = Vector3.new(10, 0.4, 10), CFrame = CFrame.new(0, 1.8, 34), Color = TRIM, Material = Enum.Material.Neon, Transparency = 0.45, CanCollide = true })
	spawn.Duration = 0
	spawn.Neutral = true
	emitter(spawn, "Rise", TRIM, 5)
	map.HubCFrame = CFrame.new(0, 5, 30)
	poi(spawn, "Spawn", "Travel", "Where every adventure starts.", "Hub", { Frame = 0, Travel = "Hub" })

	---------------- SOUL FORGE (north centre) ----------------
	local forge = Instance.new("Model")
	forge.Name = "SoulForge"
	local fpos = Vector3.new(0, 1.6, -34)
	disc(forge, fpos + Vector3.new(0, 0.6, 0), 30, 1.2, STONE_DARK, Enum.Material.Slate, "ForgeBase")
	disc(forge, fpos + Vector3.new(0, 1.25, 0), 26, 0.2, Color3.fromRGB(255, 110, 30), Enum.Material.Neon, "ForgeRing").Transparency = 0.55
	P(forge, { Name = "Belly", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 10, 14), CFrame = CFrame.new(fpos + Vector3.new(0, 6, 0)), Color = Color3.fromRGB(34, 30, 38), Material = Enum.Material.Metal })
	disc(forge, fpos + Vector3.new(0, 10.3, 0), 14.4, 0.9, Color3.fromRGB(58, 52, 62), Enum.Material.Metal, "Rim")
	local lava = disc(forge, fpos + Vector3.new(0, 10.4, 0), 12, 0.6, Color3.fromRGB(255, 120, 30), Enum.Material.Neon, "Lava")
	light(lava, Color3.fromRGB(255, 130, 50), 38, 3.2, true)
	emitter(lava, "Embers", Color3.fromRGB(255, 150, 60), 14, Vector3.new(0, 0.5, 0))
	emitter(lava, "Fire", Color3.fromRGB(255, 120, 30), 10, Vector3.new(0, 0.5, 0))
	loopSound(lava, "rbxasset://sounds/action_swim.mp3", 0.45, 0.35)
	-- anvils where weapons take shape
	for _, side in ipairs({ -1, 1 }) do
		local ax = fpos + Vector3.new(side * 11, 0, 4)
		P(forge, { Name = "AnvilBase", Size = Vector3.new(2, 2.6, 2), CFrame = CFrame.new(ax + Vector3.new(0, 2.5, 0)), Color = Color3.fromRGB(48, 48, 58), Material = Enum.Material.Metal })
		P(forge, { Name = "AnvilTop", Size = Vector3.new(4.6, 1.2, 2.2), CFrame = CFrame.new(ax + Vector3.new(0, 4.4, 0)), Color = Color3.fromRGB(70, 70, 86), Material = Enum.Material.Metal })
		local glowBar = P(forge, { Name = "Ingot", Size = Vector3.new(2.4, 0.3, 0.6), CFrame = CFrame.new(ax + Vector3.new(0, 5.15, 0)), Color = Color3.fromRGB(255, 150, 60), Material = Enum.Material.Neon, CanCollide = false })
		emitter(glowBar, "Sparks", Color3.fromRGB(255, 170, 70), 2)
	end
	P(forge, { Name = "Chimney", Size = Vector3.new(7, 30, 7), CFrame = CFrame.new(fpos + Vector3.new(0, 15, -13)), Color = Color3.fromRGB(70, 44, 42), Material = Enum.Material.Brick })
	local chimTop = P(forge, { Name = "ChimneyTop", Size = Vector3.new(8.5, 1.5, 8.5), CFrame = CFrame.new(fpos + Vector3.new(0, 30.5, -13)), Color = STONE_DARK, Material = Enum.Material.Slate })
	emitter(chimTop, "Smoke", Color3.fromRGB(90, 85, 95), 4, Vector3.new(0, 1, 0))
	billboard(lava, "SOUL FORGE", "Combine ores into weapons", Color3.fromRGB(255, 160, 60), 9)
	map.ForgePrompt = prompt(lava, "Forge Weapons", "Soul Forge", "ForgePrompt", "Forge")
	map.ForgePrompt.MaxActivationDistance = 14
	forge.Parent = hub
	map.Forge = lava
	poi(lava, "Soul Forge", "Service", "Combine 1-3 ores into a weapon. Ore effects carry over; secret combos forge iconic weapons.", "Hub", { Frame = 28, Travel = "Hub" })

	---------------- SELL + UPGRADES ----------------
	local _, sellCounter = stall(hub, CFrame.new(-44, 1.6, -4) * CFrame.Angles(0, math.rad(70), 0), Color3.fromRGB(255, 200, 60), "SELL", "Ore -> Coins")
	map.Sell = sellCounter
	map.SellPrompt = prompt(sellCounter, "Sell Ore", "Merchant", "SellPrompt", "Sell")
	poi(sellCounter, "Merchant", "Service", "Sell ore for Coins.", "Hub", { Frame = 20, Travel = "Hub" })
	local _, upCounter = stall(hub, CFrame.new(44, 1.6, -4) * CFrame.Angles(0, math.rad(-70), 0), Color3.fromRGB(80, 170, 255), "UPGRADES", "Bag / Luck / Training")
	map.UpgradePrompt = prompt(upCounter, "Open Upgrades", "Trainer", "UpgradePrompt", "Upgrades")
	poi(upCounter, "Upgrades", "Service", "Infinite Bag, Luck and Training upgrades.", "Hub", { Frame = 20, Travel = "Hub" })

	---------------- RACE ALTAR (north-west) ----------------
	local altar = Instance.new("Model")
	altar.Name = "RaceAltar"
	local apos = Vector3.new(-40, 1.6, -38)
	disc(altar, apos + Vector3.new(0, 0.6, 0), 18, 1.2, STONE_DARK, Enum.Material.Slate, "AltarBase")
	disc(altar, apos + Vector3.new(0, 1.25, 0), 14, 0.2, Color3.fromRGB(140, 110, 255), Enum.Material.Neon, "AltarGlow").Transparency = 0.4
	local orb = P(altar, { Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 3.6, CFrame = CFrame.new(apos + Vector3.new(0, 7, 0)), Color = Color3.fromRGB(190, 160, 255), Material = Enum.Material.Neon, CanCollide = false })
	spin(orb, 0, 0.8)
	light(orb, Color3.fromRGB(160, 120, 255), 24, 2.4, true)
	emitter(orb, "Vortex", Color3.fromRGB(170, 120, 255), 3)
	P(altar, { Name = "Pedestal", Size = Vector3.new(3, 4, 3), CFrame = CFrame.new(apos + Vector3.new(0, 3, 0)), Color = STONE, Material = Enum.Material.Marble })
	billboard(orb, "RACE ALTAR", "Roll your bloodline", Color3.fromRGB(190, 150, 255), 5)
	map.RacePrompt = prompt(orb, "Roll Race", "Race Altar", "RacePrompt", "Race")
	map.RacePrompt.MaxActivationDistance = 12
	altar.Parent = hub
	poi(orb, "Race Altar", "Power", "Roll your anime bloodline.", "Hub", { Frame = 22, Travel = "Hub" })

	---------------- REBIRTH / ASCENSION STATUE (north-east) ----------------
	local statue = Instance.new("Model")
	statue.Name = "AscensionStatue"
	local spos = Vector3.new(40, 1.6, -38)
	P(statue, { Name = "Rock", Size = Vector3.new(11, 4, 11), CFrame = CFrame.new(spos + Vector3.new(0, 2, 0)) * CFrame.Angles(0, math.rad(20), 0), Color = STONE_DARK, Material = Enum.Material.Rock })
	local blade = P(statue, { Name = "Blade", Size = Vector3.new(1.3, 18, 3.6), CFrame = CFrame.new(spos + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(6)), Color = Color3.fromRGB(200, 210, 230), Material = Enum.Material.Metal })
	P(statue, { Name = "Edge", Size = Vector3.new(0.55, 18, 0.45), CFrame = blade.CFrame * CFrame.new(0, 0, 1.9), Color = Color3.fromRGB(255, 215, 90), Material = Enum.Material.Neon, CanCollide = false })
	P(statue, { Name = "Guard", Size = Vector3.new(1.9, 1.5, 9), CFrame = blade.CFrame * CFrame.new(0, 9.6, 0), Color = Color3.fromRGB(230, 180, 60), Material = Enum.Material.Metal })
	local pommel = P(statue, { Name = "Pommel", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, CFrame = blade.CFrame * CFrame.new(0, 13, 0), Color = Color3.fromRGB(255, 215, 90), Material = Enum.Material.Neon })
	light(pommel, Color3.fromRGB(255, 200, 90), 28, 2, true)
	emitter(blade, "Rise", Color3.fromRGB(255, 220, 110), 4)
	billboard(pommel, "REBIRTH", "Rebirth & Ascend for huge multipliers", Color3.fromRGB(255, 215, 90), 4)
	local holder = P(statue, { Name = "PromptHolder", Size = Vector3.one, Transparency = 1, CanCollide = false, CFrame = CFrame.new(spos + Vector3.new(0, 4, 0)) })
	map.RebirthPrompt = prompt(holder, "Rebirth / Ascend", "Sword of Ascension", "RebirthPrompt", "Rebirth")
	statue.Parent = hub
	poi(holder, "Sword of Ascension", "Power", "Rebirth for x1.65 Power each, Ascend for x8.", "Hub", { Frame = 24, Travel = "Hub" })

	---------------- LEADERBOARDS (south arc) ----------------
	map.Leaderboards = {}
	for i, lb in ipairs(Config.Leaderboards) do
		local x = -45 + (i - 1) * 30
		local _, rows = board(hub, CFrame.lookAt(Vector3.new(x, 1.6, 60), Vector3.new(x * 0.6, 1.6, 0)), lb.Title, lb.Color)
		map.Leaderboards[lb.Key] = rows
	end

	---------------- light decor (kept sparse) ----------------
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2 + 0.4
		local pos = Vector3.new(math.cos(a) * (R + 22), -1, math.sin(a) * (R + 22))
		if math.abs(pos.X) > 30 and math.abs(pos.Z) > 20 then
			cherryTree(hub, pos, rng:NextNumber(1, 1.3), rng)
		end
	end
	for _, pos in ipairs({ Vector3.new(-9, 1.6, -64), Vector3.new(9, 1.6, -64), Vector3.new(-64, 1.6, 9), Vector3.new(-64, 1.6, -9), Vector3.new(64, 1.6, 9), Vector3.new(64, 1.6, -9) }) do
		lantern(hub, pos)
	end
end

---------------------------------------------------------------------
-- TRAINING GROUNDS (west island)
---------------------------------------------------------------------
local function buildTrain(map)
	local train = folder("TrainingGrounds", root)
	local c = W.TrainCenter
	bridge(train, Vector3.new(-W.PlazaRadius + 2, 1.2, 0), Vector3.new(c.X + 60, 1.2, 0), 16, Color3.fromRGB(120, 255, 170))
	disc(train, c + Vector3.new(0, 0.5, 0), 124, 2, STONE, Enum.Material.Slate, "Island")
	disc(train, c + Vector3.new(0, 1.6, 0), 118, 0.12, Color3.fromRGB(120, 255, 170), Enum.Material.Neon, "IslandGlow").Transparency = 0.6
	local sign = P(train, { Name = "Sign", Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, CFrame = CFrame.new(c + Vector3.new(50, 1.6, 0)) })
	billboard(sign, "TRAINING GROUNDS", "Pads unlock with Rebirths & Ascensions", Color3.fromRGB(120, 255, 170), 10, 1.2, 18)
	map.TrainCFrame = CFrame.new(c + Vector3.new(44, 5, 0)) * CFrame.Angles(0, math.rad(90), 0)
	poi(sign, "Training Grounds", "Power", "Stand on a pad or swing to gain Power. Bigger pads unlock with Rebirths and Ascensions.", "Train", { Frame = 0, Travel = "Train" })

	map.TrainPads = {}
	local count = #Config.TrainPads
	for i, pad in ipairs(Config.TrainPads) do
		-- pads sweep in an arc from the bridge side around the island
		local a = math.rad(-150 + (i - 1) * (300 / (count - 1)))
		local pos = c + Vector3.new(-math.cos(a) * 36, 1.7, math.sin(a) * 36)
		local base = disc(train, pos, Config.TrainPadRadius * 2 + 1.6, 0.3, STONE_DARK, Enum.Material.Metal, "PadBase")
		local glow = disc(train, pos + Vector3.new(0, 0.15, 0), Config.TrainPadRadius * 2, 0.25, pad.Color, Enum.Material.Neon, "Pad")
		glow.Transparency = 0.4
		glow:SetAttribute("PadIndex", i)
		glow:SetAttribute("Mult", pad.Mult)
		glow:SetAttribute("RebirthReq", pad.Rebirths)
		glow:SetAttribute("AscensionReq", pad.Ascensions)
		CollectionService:AddTag(glow, "TrainPad")
		emitter(glow, "Rise", pad.Color, 2 + i)
		light(glow, pad.Color, 16, 1.1)
		local req = "Free"
		if pad.Ascensions > 0 then
			req = pad.Ascensions .. " Ascension" .. (pad.Ascensions > 1 and "s" or "")
		elseif pad.Rebirths > 0 then
			req = pad.Rebirths .. " Rebirth" .. (pad.Rebirths > 1 and "s" or "")
		end
		billboard(base, "x" .. Format.Abbrev(pad.Mult), req, pad.Color, 6, 0.7)
		table.insert(map.TrainPads, { Part = glow, Config = pad, Index = i, Position = pos })
	end
end

---------------------------------------------------------------------
-- BOSS RUSH ARENA (east island)
---------------------------------------------------------------------
local function buildBossRush(map)
	local br = folder("BossRush", root)
	local c = W.BossRushCenter
	local purple = Color3.fromRGB(200, 110, 255)
	bridge(br, Vector3.new(W.PlazaRadius - 2, 1.2, 0), Vector3.new(c.X - 50, 1.2, 0), 16, purple)
	disc(br, c + Vector3.new(0, 0.5, 0), 104, 2, STONE_DARK, Enum.Material.Slate, "Island")
	disc(br, c + Vector3.new(0, 1.6, 0), 60, 0.12, purple, Enum.Material.Neon, "Glyph").Transparency = 0.7
	for i = 1, 12 do
		local a = (i / 12) * math.pi * 2
		local pos = c + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46)
		if math.cos(a) > -0.85 then
			P(br, { Name = "Pillar", Size = Vector3.new(3, 18, 3), CFrame = CFrame.new(pos + Vector3.new(0, 10, 0)), Color = STONE, Material = Enum.Material.Slate })
			local flame = P(br, { Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, CFrame = CFrame.new(pos + Vector3.new(0, 19.6, 0)), Color = purple, Material = Enum.Material.Neon, CanCollide = false })
			emitter(flame, "Fire", purple, 8)
			if i % 3 == 0 then
				CollectionService:AddTag(light(flame, purple, 22, 1.4, true), "Flicker")
			end
		end
	end
	local gate = P(br, { Name = "RushGate", Size = Vector3.new(1, 16, 12), CFrame = CFrame.new(c + Vector3.new(0, 9.6, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = purple, Material = Enum.Material.ForceField, Transparency = 0.1, CanCollide = false })
	emitter(gate, "Vortex", purple, 2)
	light(gate, purple, 30, 2, true)
	billboard(gate, "BOSS RUSH", "Endless bosses. How far can you go?", Color3.fromRGB(220, 160, 255), 11, 1.1, 16)
	local pp = prompt(gate, "Enter Boss Rush", "Boss Rush", "TowerPrompt", "Tower")
	pp.HoldDuration = 0.4
	map.TowerPrompt = pp
	map.TowerCFrame = CFrame.new(c + Vector3.new(-30, 5, 0)) * CFrame.Angles(0, math.rad(-90), 0)
	poi(gate, "Boss Rush", "Danger", "Fight bosses back to back. Opens after the floor " .. Config.BossRush.StageReq .. " boss.", "BossRush", { Frame = 30, Travel = "Tower" })
end

---------------------------------------------------------------------
-- THE DUNGEON GATE (north) - runs themselves are built per player by
-- Server/DungeonService far below the lobby
---------------------------------------------------------------------
local function buildDungeonGate(map)
	local g = folder("DungeonGate", root)
	local c = W.DungeonGate
	local violet = Color3.fromRGB(170, 110, 255)
	bridge(g, Vector3.new(0, 1.2, -W.PlazaRadius + 2), Vector3.new(0, 1.2, c.Z + 24), 22, TRIM)
	torii(g, CFrame.new(0, 1.2, -W.PlazaRadius - 6), 24, 18)
	disc(g, c + Vector3.new(0, 0.5, 0), 56, 2, STONE_DARK, Enum.Material.Slate, "GatePlatform")
	disc(g, c + Vector3.new(0, 1.6, 0), 50, 0.12, violet, Enum.Material.Neon, "GateGlow").Transparency = 0.65
	for _, side in ipairs({ -1, 1 }) do
		local tower = P(g, { Name = "Tower", Size = Vector3.new(7, 40, 7), CFrame = CFrame.new(c + Vector3.new(side * 15, 20, -6)), Color = STONE, Material = Enum.Material.Cobblestone })
		P(g, { Name = "TowerGlow", Size = Vector3.new(0.5, 34, 7.2), CFrame = tower.CFrame * CFrame.new(-side * 3.6, 0, 0), Color = violet, Material = Enum.Material.Neon, CanCollide = false })
		local brazier = P(g, { Name = "Brazier", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.6, CFrame = CFrame.new(c + Vector3.new(side * 15, 41.6, -6)), Color = violet, Material = Enum.Material.Neon, CanCollide = false })
		emitter(brazier, "Fire", violet, 10)
		CollectionService:AddTag(light(brazier, violet, 30, 1.6, true), "Flicker")
	end
	local lintel = P(g, { Name = "Lintel", Size = Vector3.new(40, 7, 9), CFrame = CFrame.new(c + Vector3.new(0, 36, -6)), Color = STONE_DARK, Material = Enum.Material.Slate })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 20
	sg.LightInfluence = 0
	sg.Parent = lintel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Config.Fonts.Display
	t.TextScaled = true
	t.Text = "THE DUNGEON"
	t.TextColor3 = Color3.fromRGB(230, 200, 255)
	t.Parent = sg
	-- the portal itself
	local portal = P(g, { Name = "DungeonPortal", Size = Vector3.new(22, 30, 1), CFrame = CFrame.new(c + Vector3.new(0, 16.6, -6)), Color = Color3.fromRGB(60, 20, 110), Material = Enum.Material.Neon, CanCollide = false })
	portal.Transparency = 0.15
	emitter(portal, "Vortex", violet, 6)
	emitter(portal, "Rise", violet, 6)
	light(portal, violet, 40, 2.4, true)
	for k = 1, 4 do
		P(g, { Name = "Step", Size = Vector3.new(26, 0.8, 3), CFrame = CFrame.new(c + Vector3.new(0, 1.4 + k * 0.6, -1 - k * 1.4)), Color = STONE, Material = Enum.Material.Slate })
	end
	billboard(portal, "THE DUNGEON", "Floor after floor. Die and you start over!", Color3.fromRGB(220, 180, 255), 17, 1.2, 22)
	local holder = P(g, { Name = "PromptHolder", Size = Vector3.one, Transparency = 1, CanCollide = false, CFrame = CFrame.new(c + Vector3.new(0, 4, 2)) })
	local pp = prompt(holder, "Enter Dungeon", "The Dungeon", "DungeonPrompt", "Dungeon")
	pp.MaxActivationDistance = 14
	map.DungeonPrompt = pp
	map.DungeonCFrame = CFrame.new(c + Vector3.new(0, 5, 18))
	poi(holder, "The Dungeon", "Danger", "Endless floors, a boss every 5. Dying or going home starts you over, but checkpoints let you skip ahead.", "Dungeon", { Frame = 30, Travel = "Dungeon" })
end

---------------------------------------------------------------------
-- AMBIENT PARTICLES (fog, dust, embers, petals) - one volume per area
---------------------------------------------------------------------
local function buildAmbient(map)
	local amb = folder("Ambient", root)
	ambientVolume(amb, CFrame.new(0, 3, 0), Vector3.new(150, 2, 150), "Fog", Color3.fromRGB(190, 180, 215), 5)
	ambientVolume(amb, CFrame.new(0, 10, 0), Vector3.new(150, 16, 150), "Dust", Color3.fromRGB(255, 235, 210), 10)
	ambientVolume(amb, CFrame.new(0, 6, -34), Vector3.new(34, 6, 34), "FloatEmbers", Color3.fromRGB(255, 150, 60), 5)
	local petals = ambientVolume(amb, CFrame.new(0, 45, 0), Vector3.new(200, 4, 200), "Petals", Color3.fromRGB(255, 160, 205), 10)
	petals.Lifetime = NumberRange.new(8, 12)
	petals.Acceleration = Vector3.new(1.5, -3, 0.8)
	ambientVolume(amb, CFrame.new(W.TrainCenter + Vector3.new(0, 3, 0)), Vector3.new(110, 2, 110), "Fog", Color3.fromRGB(180, 220, 190), 3)
	ambientVolume(amb, CFrame.new(W.BossRushCenter + Vector3.new(0, 6, 0)), Vector3.new(90, 8, 90), "FloatEmbers", Color3.fromRGB(200, 120, 255), 5)
	ambientVolume(amb, CFrame.new(W.DungeonGate + Vector3.new(0, 6, -4)), Vector3.new(40, 10, 20), "Void", Color3.fromRGB(170, 110, 255), 6)
	local _ = map
end

---------------------------------------------------------------------
function MapBuilder.Build()
	local old = workspace:FindFirstChild("GeneratedMap")
	if old then
		old:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "GeneratedMap"
	root.Parent = workspace

	buildLighting()
	local map = { Root = root }
	buildPlaza(map)
	buildTrain(map)
	buildBossRush(map)
	buildDungeonGate(map)
	buildAmbient(map)
	applyMaterialVariants(root)

	local arenas = folder("TowerArenas", workspace)
	map.TowerArenas = arenas
	local enemies = folder("Enemies", workspace)
	map.Enemies = enemies
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Monetization (ModuleScript) -> ServerScriptService/Server/Monetization
-- Gamepasses, developer products (ProcessReceipt) and code rewards.
-- Put your real IDs in Config.GamePasses / Config.Products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Net = require(script.Parent:WaitForChild("Net"))

local Monetization = {}
Monetization.OnPassesChanged = nil :: ((Player) -> ())?

local passKeyById = {}
for key, pass in pairs(Config.GamePasses) do
	if pass.Id and pass.Id ~= 0 then
		passKeyById[pass.Id] = key
	end
end
-- 2x power tiers: product id -> tier number n (price 3^n, multiplier 2^n)
local powerTierById = {}
for n, tier in ipairs(Config.PowerTiers) do
	if tier.Id and tier.Id ~= 0 then
		powerTierById[tier.Id] = n
	end
end

local productKeyById = {}
for key, prod in pairs(Config.Products) do
	if prod.Id and prod.Id ~= 0 then
		productKeyById[prod.Id] = key
	end
end

function Monetization.LoadPasses(player: Player)
	local s = DataService.Session(player)
	if not s then
		return
	end
	for key, pass in pairs(Config.GamePasses) do
		if Config.StudioOwnsAllPasses and RunService:IsStudio() then
			s.Passes[key] = true
		elseif pass.Id and pass.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				s.Passes[key] = true
			end
		end
	end
end

-- Coins / Rerolls / Overdrive grant used by products and codes.
function Monetization.Grant(player: Player, grants): string
	local data = DataService.Get(player)
	if not data then
		return ""
	end
	local parts = {}
	if grants.Coins then
		local amount = grants.Coins
		if grants.ScaleWithRebirth then
			amount *= 1 + data.Rebirths
		end
		data.Coins += amount
		table.insert(parts, Format.Abbrev(amount) .. " Coins")
	end
	if grants.Rerolls then
		data.Rerolls += grants.Rerolls
		table.insert(parts, grants.Rerolls .. " Rerolls")
	end
	if grants.Overdrive then
		data.Overdrive += grants.Overdrive
		table.insert(parts, grants.Overdrive .. " Overdrive")
	end
	DataService.MarkDirty(player)
	return table.concat(parts, " + ")
end

function Monetization.PromptPass(player: Player, key: string)
	local pass = Config.GamePasses[key]
	if not pass then
		return
	end
	if not pass.Id or pass.Id == 0 then
		Net.Notify(player, pass.Name .. " isn't set up yet (add its ID in Config).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

function Monetization.PromptProduct(player: Player, key: string)
	local prod = Config.Products[key]
	local data = DataService.Get(player)
	if not prod or not data then
		return
	end
	if prod.OneTime and data.StarterPack then
		Net.Notify(player, "You already bought the Starter Pack!", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	if not prod.Id or prod.Id == 0 then
		Net.Notify(player, prod.Name .. " isn't set up yet (add its ID in Config).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptProductPurchase(player, prod.Id)
end

-- Prompts the NEXT power tier only (n = PowerTier + 1).
function Monetization.PromptPowerTier(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local n = data.PowerTier + 1
	local tier = Config.PowerTiers[n]
	if not tier then
		Net.Notify(player, "You own every Power tier!", Color3.fromRGB(255, 215, 80), "Error")
		return
	end
	if not tier.Id or tier.Id == 0 then
		Net.Notify(player, "Power tier " .. n .. " isn't set up yet (add its product ID in Config.PowerTiers).", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	MarketplaceService:PromptProductPurchase(player, tier.Id)
end

local function grantPowerTier(player: Player, data, n: number): string
	local expected = data.PowerTier + 1
	if n >= expected then
		-- normal case (n == expected). If a higher tier was bought (paid more),
		-- jump straight to it so no Robux is ever wasted.
		data.PowerTier = n
		Net.FX(player, "PowerTier", { Tier = n, Mult = Config.PowerTierMult(n) })
		return "Power x" .. Format.Abbrev(Config.PowerTierMult(n))
	end
	-- stale purchase of a tier the player already owns: compensate with coins
	local coins = 1000 * Config.PowerTierPrice(n) * (1 + data.Rebirths)
	data.Coins += coins
	Net.Notify(player, "You already had Power tier " .. n .. " - converted to " .. Format.Abbrev(coins) .. " Coins.", Color3.fromRGB(255, 215, 80), "Purchase")
	return Format.Abbrev(coins) .. " Coins"
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local key = passKeyById[passId]
	local s = DataService.Session(player)
	if key and s then
		s.Passes[key] = true
		Net.FX(player, "Purchase", { Name = Config.GamePasses[key].Name })
		DataService.MarkDirty(player)
		if Monetization.OnPassesChanged then
			Monetization.OnPassesChanged(player)
		end
	end
end)

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.Get(player)
	if not player or not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- dedupe (receipts can be delivered more than once)
	for _, id in ipairs(data.Receipts) do
		if id == receipt.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	-- 2x power tier purchase
	local tierN = powerTierById[receipt.ProductId]
	if tierN then
		local text = grantPowerTier(player, data, tierN)
		table.insert(data.Receipts, receipt.PurchaseId)
		while #data.Receipts > 50 do
			table.remove(data.Receipts, 1)
		end
		DataService.MarkDirty(player)
		DataService.Save(player)
		Net.FX(player, "Purchase", { Name = "Power Tier " .. tierN, Text = text })
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = productKeyById[receipt.ProductId]
	local prod = key and Config.Products[key]
	if not prod then
		warn("[Monetization] unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local text = Monetization.Grant(player, prod)
	if prod.OneTime then
		data.StarterPack = true
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	DataService.Save(player)
	Net.FX(player, "Purchase", { Name = prod.Name, Text = text })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Net (ModuleScript) -> ServerScriptService/Server/Net
-- Creates the RemoteEvents in ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if folder then
	folder:Destroy()
end
folder = Instance.new("Folder")
folder.Name = "Remotes"

local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = folder
	return r
end

Net.Ability = remote("Ability") -- client -> server: (action, payload) combat input
Net.Interact = remote("Interact") -- client -> server: custom ProximityPrompt triggered
Net.Request = remote("Request") -- client -> server: (action, arg)
Net.Sync = remote("Sync") -- server -> client: data snapshot
Net.FXEvent = remote("FX") -- server -> client: (kind, payload)
Net.Admin = remote("Admin") -- client -> server: admin panel commands (server re-checks admin)
folder.Parent = ReplicatedStorage

function Net.FX(player: Player, kind: string, payload)
	Net.FXEvent:FireClient(player, kind, payload or {})
end

function Net.FXAll(kind: string, payload)
	Net.FXEvent:FireAllClients(kind, payload or {})
end

function Net.Notify(player: Player, text: string, color: Color3?, sound: string?)
	Net.FXEvent:FireClient(player, "Notify", { Text = text, Color = color, Sound = sound })
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Playtime</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Playtime (ModuleScript) -> ServerScriptService/Server/Playtime
-- Session time tracker (server, 1s loop), play-time reward ladder, total
-- playtime and the daily login streak (all saved in the DataStore profile).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))

local Playtime = {}
Playtime.OnCosmeticsChanged = nil :: ((Player) -> ())?

local function grant(player: Player, reward)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if reward.Coins then
		data.Coins += reward.Coins
	end
	if reward.Potions then
		data.Potions += reward.Potions
	end
	if reward.Keys then
		for key, n in pairs(reward.Keys) do
			data.Keys[key] = (data.Keys[key] or 0) + n
		end
	end
	if reward.DamageBoost then
		local now = Stats.Now()
		data.BoostEnds = math.max(data.BoostEnds, now) + reward.DamageBoost
	end
	if reward.Aura == "Playtime" and not data.Cosmetics.PlaytimeAura then
		data.Cosmetics.PlaytimeAura = true
		if Playtime.OnCosmeticsChanged then
			Playtime.OnCosmeticsChanged(player)
		end
	end
	DataService.MarkDirty(player)
end
Playtime.Grant = grant

-- Called once after the profile loads.
function Playtime.OnJoin(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return
	end
	s.SessionTime = 0
	s.PlaytimeClaimed = {}
	for i = 1, #Config.PlaytimeRewards do
		s.PlaytimeClaimed[i] = false
	end
	player:SetAttribute("SessionTime", 0)

	-- daily streak (UTC days)
	local today = math.floor(os.time() / 86400)
	if data.LastLoginDay ~= today then
		if data.LastLoginDay == today - 1 then
			data.Streak += 1
		else
			data.Streak = 1
		end
		data.LastLoginDay = today
		local days = math.min(data.Streak, Config.Daily.MaxScaleDays)
		local coins = Config.Daily.BaseCoins * days * (1 + data.Rebirths)
		data.Coins += coins
		local text = Format.Abbrev(coins) .. " Coins"
		if data.Streak % 7 == 0 then
			data.Keys[Config.Daily.WeeklyKey] = (data.Keys[Config.Daily.WeeklyKey] or 0) + 1
			text ..= " + " .. Config.KeyNames[Config.Daily.WeeklyKey]
		end
		DataService.MarkDirty(player)
		task.delay(6, function()
			if player.Parent then
				local bonus = math.min(data.Streak * Config.Daily.CoinBonusPerDay, Config.Daily.MaxCoinBonus)
				Net.FX(player, "Daily", { Streak = data.Streak, Text = text, Bonus = bonus })
			end
		end)
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			local s = DataService.Session(player)
			if data and s and s.PlaytimeClaimed then
				s.SessionTime += 1
				data.TotalPlaytime += 1
				player:SetAttribute("SessionTime", s.SessionTime)
				for i, reward in ipairs(Config.PlaytimeRewards) do
					if not s.PlaytimeClaimed[i] and s.SessionTime >= reward.Minutes * 60 then
						s.PlaytimeClaimed[i] = true
						grant(player, reward)
						Net.FX(player, "PlaytimeReward", { Index = i, Name = reward.Name, Minutes = reward.Minutes })
					end
				end
			end
		end
	end
end)

return Playtime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Projectiles (ModuleScript) -> ServerScriptService/Server/Projectiles
-- Server-authoritative projectiles: stepped every Heartbeat, raycast against
-- map geometry, swept-sphere hit tests against enemies. Clients only draw
-- them (FX "Proj" / "ProjEnd").

local RunService = game:GetService("RunService")

local Net = require(script.Parent:WaitForChild("Net"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))

local Projectiles = {}

local active = {}
local nextId = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.RespectCanCollide = true

function Projectiles.SetWorld(blockers: { Instance })
	rayParams.FilterDescendantsInstances = blockers
end

--[[ opts:
	Owner: Player, Origin: Vector3, Dir: Vector3, Speed, Range, Radius,
	Pierce: boolean | number (extra enemies), Kind: string, Color: Color3,
	Size: number?, Explode: number? (radius), OnHit: (enemy, pos) -> ()
	OnExplode: (pos, radius) -> ()
]]
function Projectiles.Fire(opts)
	nextId += 1
	local p = {
		Id = nextId,
		Owner = opts.Owner,
		Pos = opts.Origin,
		Dir = opts.Dir.Unit,
		Speed = opts.Speed,
		Range = opts.Range,
		Radius = opts.Radius or 2,
		Pierce = opts.Pierce,
		Traveled = 0,
		Hit = {},
		Hits = 0,
		OnHit = opts.OnHit,
		OnExplode = opts.OnExplode,
		Explode = opts.Explode,
	}
	active[p.Id] = p
	Net.FXAll("Proj", { Id = p.Id, Kind = opts.Kind or "Ray", Pos = p.Pos, Dir = p.Dir, Speed = p.Speed, Range = p.Range, Color = opts.Color, Size = opts.Size })
	return p.Id
end

local function finish(p, pos: Vector3, hit: boolean)
	active[p.Id] = nil
	if p.Explode and p.OnExplode then
		p.OnExplode(pos, p.Explode)
	end
	Net.FXAll("ProjEnd", { Id = p.Id, Pos = pos, Hit = hit, Explode = p.Explode })
end

local function maxHits(p): number
	if p.Pierce == true then
		return math.huge
	elseif type(p.Pierce) == "number" then
		return 1 + p.Pierce
	end
	return 1
end

RunService.Heartbeat:Connect(function(dt)
	for _, p in pairs(active) do
		local step = math.min(p.Speed * dt, p.Range - p.Traveled)
		local from = p.Pos
		local to = from + p.Dir * step
		local wall = workspace:Raycast(from, p.Dir * step, rayParams)
		if wall then
			to = wall.Position
		end
		local done = false
		for _, e in ipairs(EnemyService.InSegment(from, to, p.Radius)) do
			if not p.Hit[e] then
				p.Hit[e] = true
				p.Hits += 1
				if p.OnHit then
					local ok, err = pcall(p.OnHit, e, e.Root.Position)
					if not ok then
						warn("[Projectile]", err)
					end
				end
				if p.Hits >= maxHits(p) then
					finish(p, e.Root.Position, true)
					done = true
					break
				end
			end
		end
		if not done then
			p.Pos = to
			p.Traveled += step
			if wall then
				finish(p, to, true)
			elseif p.Traveled >= p.Range - 0.01 then
				finish(p, to, false)
			end
		end
	end
end)

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Stats (ModuleScript) -> ServerScriptService/Server/Stats
-- All formulas: damage, power gain, luck, coins, backpack, race rolls.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameShared"):WaitForChild("Config"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local Stats = {}

local function now()
	return workspace:GetServerTimeNow()
end
Stats.Now = now

function Stats.HasPass(player: Player, key: string): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.Passes[key] == true
end

function Stats.Race(data)
	return Config.RaceById[data.Race] or Config.RaceById.Pirate
end

function Stats.Tier(data)
	return Config.RaceTierById[data.RaceTier] or Config.RaceTiers[1]
end

local function allStats(data): number
	local race = Stats.Race(data)
	return race.AllStats or 1
end

function Stats.OverdriveActive(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.OverdriveEnd > now()
end

function Stats.ZenkaiActive(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.ZenkaiEnd > now()
end

---------------------------------------------------------------------
-- GLOBAL EVENTS (admin abuse: 2x luck, 3x coins...)
---------------------------------------------------------------------
Stats.ActiveEvents = {} :: { [string]: { EndsAt: number, Mult: number } }

function Stats.EventMult(key: string): number
	local e = Stats.ActiveEvents[key]
	if e and e.EndsAt > now() then
		return e.Mult
	end
	return 1
end

---------------------------------------------------------------------
-- WEAPON + ARMOR
---------------------------------------------------------------------
-- Returns weaponDef, rarityDef, record (or starter defaults).
function Stats.Weapon(player: Player)
	local data = DataService.Get(player)
	local rec = data and data.Weapons[data.Equipped]
	local def = rec and Config.WeaponById[rec.W] or Config.WeaponById[Config.StarterWeapon]
	local rarity = rec and Config.WeaponRarityById[rec.R] or Config.WeaponRarities[1]
	return def, rarity, rec
end

-- Real value of an ore effect on the equipped weapon (0 if none).
function Stats.Effect(player: Player, effectId: string): number
	local _, _, rec = Stats.Weapon(player)
	local pts = rec and rec.E and rec.E[effectId]
	return pts and Config.EffectValue(effectId, pts) or 0
end

function Stats.HasPassive(player: Player, passiveId: string): boolean
	local def, rarity = Stats.Weapon(player)
	return rarity.Passive == true and def.Passive ~= nil and def.Passive.Id == passiveId
end

function Stats.Armor(player: Player)
	local data = DataService.Get(player)
	local rec = data and data.Armors[data.EquippedArmor]
	if not rec then
		return nil, nil, nil
	end
	return Config.ArmorById[rec.A], Config.WeaponRarityById[rec.R] or Config.WeaponRarities[1], rec
end

function Stats.ArmorBonus(player: Player, bonus: string): number
	local def, rarity = Stats.Armor(player)
	if def and rarity and def.Bonus == bonus then
		return Config.ArmorBonusValue(bonus, rarity.Index)
	end
	return 0
end

-- Damage reduction from armour (capped).
function Stats.Defense(player: Player): number
	local def, rarity = Stats.Armor(player)
	if not def or not rarity then
		return 0
	end
	local d = Config.ArmorDefense[rarity.Index] or 0
	d += Stats.ArmorBonus(player, "Guard")
	return math.min(d, Config.Balance.DefenseCap)
end

function Stats.AttackSpeed(player: Player): number
	local _, rarity = Stats.Weapon(player)
	local bonus = (rarity.AttackSpeed or 0) + Stats.Effect(player, "Haste")
	if Stats.HasPassive(player, "Released") then
		bonus += 0.15
	end
	if Stats.OverdriveActive(player) then
		bonus += 0.1
	end
	return math.min(bonus, Config.Balance.AttackSpeedCap)
end

function Stats.BoostActive(player: Player): boolean
	local data = DataService.Get(player)
	return data ~= nil and data.BoostEnds > now()
end

function Stats.PowerTierMult(player: Player): number
	local data = DataService.Get(player)
	return Config.PowerTierMult(data and data.PowerTier or 0)
end

---------------------------------------------------------------------
-- DAMAGE
---------------------------------------------------------------------
-- Gameplay multipliers (race, skin, runes, buffs) are multiplied together
-- and HARD CAPPED at Config.Balance.DamageMultCap. The exponential growth
-- comes from Power (rebirths / ascensions / pads), which is not capped.
function Stats.GameplayMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local mult = (race.Damage or 1) * Stats.Tier(data).Damage
	mult *= 1 + data.Runes * Config.BossRush.RuneDamageBonus
	if Stats.OverdriveActive(player) then
		mult *= Config.Overdrive.Damage
	end
	if Stats.BoostActive(player) then
		mult *= 2
	end
	if race.Zenkai then
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			local missing = 1 - math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			mult *= 1 + missing
		end
		if Stats.ZenkaiActive(player) then
			mult *= 2
		end
	end
	return math.min(mult, Config.Balance.DamageMultCap)
end

-- Base hit damage for the equipped weapon (skill coefficients multiply this).
function Stats.Damage(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local def, rarity = Stats.Weapon(player)
	local class = Config.WeaponClasses[def.Class]
	local base = (Config.BaseDamage + data.Blade) * (1 + data.Power / Config.PowerDamageDivisor)
	base *= (class and class.Base or 1) * (1 + rarity.Damage) * (1 + Stats.Effect(player, "Heavy"))
	return base * Stats.GameplayMult(player) * Stats.PowerTierMult(player)
end

function Stats.CritChance(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local race = Stats.Race(data)
	local c = (Config.BaseCritChance + (race.Crit or 0)) * allStats(data) + Stats.Effect(player, "Crit")
	if Stats.HasPassive(player, "Moonlit") then
		c += 0.1
	end
	return math.min(0.6, c)
end

function Stats.CritMult(): number
	return math.min(Config.CritMultiplier, Config.Balance.CritMultCap)
end

function Stats.StaminaCost(player: Player, base: number): number
	local cost = base * Config.Balance.StaminaCostMult
	if Stats.HasPassive(player, "ChakraFlow") then
		cost *= 0.8
	end
	cost *= 1 - Stats.Effect(player, "Ki")
	cost *= 1 - Stats.ArmorBonus(player, "Stamina")
	return cost
end

function Stats.Cooldown(player: Player, skillId: string, base: number): number
	local cd = base * Config.Balance.CooldownMult
	if skillId == "GetsugaTensho" and Stats.HasPassive(player, "Released") then
		cd *= 0.8
	end
	if Stats.HasPassive(player, "Wisdom") then
		cd *= 0.85
	end
	cd *= 1 - Stats.Effect(player, "Chrono")
	-- skill mastery: -0.3% per level, -15% more at Master
	local M = Config.Mastery
	local level = Stats.MasteryLevel(player)
	cd *= 1 - math.min(level * M.CooldownPerLevel, 0.3)
	if level >= M.Milestones[3].Level then
		cd *= 0.85
	end
	return cd
end

---------------------------------------------------------------------
-- POWER / LUCK / COINS / BACKPACK / FORGE / SPEED  (exponential)
---------------------------------------------------------------------
function Stats.PrestigeMult(data, kind: string): number
	if kind == "Power" then
		return Config.Rebirth.PowerMult ^ data.Rebirths * Config.Ascension.PowerMult ^ data.Ascensions
	end
	return Config.Rebirth.CoinMult ^ data.Rebirths * Config.Ascension.CoinMult ^ data.Ascensions
end

function Stats.PowerMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local mult = Stats.PrestigeMult(data, "Power") * (1 + data.Upgrades.Training * Config.Upgrades.Training.Per)
	mult *= (race.Power or 1) * allStats(data)
	if Stats.HasPass(player, "DoubleTraining") then
		mult *= 2
	end
	if Stats.OverdriveActive(player) then
		mult *= Config.Overdrive.Power
	end
	mult *= 1 + Stats.ArmorBonus(player, "Power")
	return mult * Stats.EventMult("Power")
end

function Stats.Luck(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local luck = (1 + data.Upgrades.Luck * Config.Upgrades.Luck.Per) * (race.Luck or 1) * allStats(data)
	if Stats.HasPass(player, "DoubleLuck") then
		luck *= 2
	end
	luck *= (1 + Stats.Effect(player, "Greed")) * (1 + Stats.ArmorBonus(player, "Luck"))
	return luck * Stats.EventMult("Luck")
end

function Stats.CoinMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	local mult = Stats.PrestigeMult(data, "Coins") * (race.Coins or 1) * allStats(data)
	if Stats.HasPass(player, "DoubleCoins") then
		mult *= 2
	end
	mult *= 1 + math.min(data.Streak * Config.Daily.CoinBonusPerDay, Config.Daily.MaxCoinBonus)
	mult *= 1 + Stats.Effect(player, "Fortune")
	-- Pirate crew aura: +10% if another Pirate is nearby
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local od = DataService.Get(other)
				local oc = other.Character
				local orr = oc and oc:FindFirstChild("HumanoidRootPart")
				if od and od.Race == "Pirate" and orr and (orr.Position - root.Position).Magnitude < 30 then
					mult *= 1.1
					break
				end
			end
		end
	end
	return mult * Stats.EventMult("Coins")
end

function Stats.BackpackMax(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return Config.BaseBackpack
	end
	local cap = Config.BaseBackpack + data.Upgrades.Backpack * Config.Upgrades.Backpack.Per
	if Stats.HasPass(player, "ExtraBackpack") then
		cap = math.floor(cap * 1.5)
	end
	return cap
end

function Stats.BackpackCount(data): number
	local n = 0
	for _, c in pairs(data.Backpack) do
		n += c
	end
	return n
end

function Stats.ForgeMult(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local race = Stats.Race(data)
	return (race.Forge or 1) * allStats(data)
end

function Stats.WalkSpeed(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 16
	end
	local race = Stats.Race(data)
	local speed = 16 * (race.Speed or 1) * math.min(allStats(data), 1.1)
	if Stats.OverdriveActive(player) then
		speed *= Config.Overdrive.Speed
	end
	if Stats.HasPassive(player, "Tailwind") then
		speed *= 1.15
	end
	speed *= 1 + Stats.ArmorBonus(player, "Speed")
	return speed
end

function Stats.OverdriveDuration(player: Player): number
	local data = DataService.Get(player)
	local d = Config.Overdrive.Duration
	if data then
		d *= Stats.Race(data).OverdriveDuration or 1
	end
	if Stats.HasPass(player, "DoubleOverdrive") then
		d *= 2
	end
	return d
end

function Stats.RebirthReq(data): number
	return Config.RebirthReq(data.Rebirths, data.Ascensions)
end

function Stats.UpgradeCost(key: string, level: number): number?
	if not Config.Upgrades[key] then
		return nil
	end
	return Config.UpgradeCost(key, level)
end

-- (ascensions, rebirths) compared in order, so pads stay unlocked after an
-- ascension resets your rebirth count.
function Stats.PadUnlocked(data, pad): boolean
	local a = data.Ascensions or 0
	if a ~= (pad.Ascensions or 0) then
		return a > (pad.Ascensions or 0)
	end
	return data.Rebirths >= (pad.Rebirths or 0)
end

---------------------------------------------------------------------
-- SKILL MASTERY (per weapon class)
---------------------------------------------------------------------
function Stats.MasteryLevel(player: Player, class: string?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	class = class or Stats.Weapon(player).Class
	return (Config.MasteryLevel((data.Mastery or {})[class] or 0))
end

-- Multiplier on skill damage from mastery (+3%/level, x1.5 at Grandmaster).
function Stats.MasteryDamage(level: number): number
	local M = Config.Mastery
	return (1 + level * M.DamagePerLevel) * (level >= M.Milestones[4].Level and 1.5 or 1)
end

---------------------------------------------------------------------
-- RACE ROLL (weighted; luck only nudges the Main Character tail)
---------------------------------------------------------------------
local function weightedPick(list, weightFn)
	local total = 0
	for _, item in ipairs(list) do
		total += weightFn(item)
	end
	local r = math.random() * total
	for _, item in ipairs(list) do
		r -= weightFn(item)
		if r <= 0 then
			return item
		end
	end
	return list[#list]
end
Stats.WeightedPick = weightedPick

function Stats.RollRace(player: Player)
	local data = DataService.Get(player)
	local mcBoost = 1
	if Stats.HasPass(player, "DoubleLuck") then
		mcBoost *= 1.5
	end
	if Stats.HasPass(player, "MCPity") then
		mcBoost *= 1.5
	end
	if data then
		mcBoost *= 1 + math.min(data.Upgrades.Luck * 0.01, 0.5)
	end
	local race = weightedPick(Config.Races, function(r)
		return if r.Id == "MainCharacter" then r.Weight * mcBoost else r.Weight
	end)
	local tier = weightedPick(Config.RaceTiers, function(t)
		return t.Weight
	end)
	return race.Id, tier.Id
end

---------------------------------------------------------------------
-- SNAPSHOT sent to the client
---------------------------------------------------------------------
function Stats.EventList()
	local list = {}
	for key, e in pairs(Stats.ActiveEvents) do
		if e.EndsAt > now() then
			list[key] = { EndsAt = e.EndsAt, Mult = e.Mult }
		end
	end
	return list
end

function Stats.Snapshot(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	if not data or not s then
		return nil
	end
	local costs = {}
	for key in pairs(Config.Upgrades) do
		costs[key] = Stats.UpgradeCost(key, data.Upgrades[key]) or -1
	end
	local tower = s.Tower
	return {
		Power = data.Power,
		Coins = data.Coins,
		Blade = data.Blade,
		Rebirths = data.Rebirths,
		Runes = data.Runes,
		Backpack = data.Backpack,
		BackpackCount = Stats.BackpackCount(data),
		BackpackMax = Stats.BackpackMax(player),
		Upgrades = data.Upgrades,
		UpgradeCosts = costs,
		Race = data.Race,
		RaceTier = data.RaceTier,
		Rerolls = data.Rerolls,
		Overdrive = data.Overdrive,
		OverdriveEnd = s.OverdriveEnd,
		ZenkaiEnd = s.ZenkaiEnd,
		Index = data.Index,
		Kills = data.Kills,
		TowerBest = data.TowerBest,
		Codes = data.Codes,
		StarterPack = data.StarterPack,
		Passes = s.Passes,
		Settings = data.Settings,
		RebirthReq = Stats.RebirthReq(data),
		Tower = tower and { Floor = tower.Floor, EndsAt = tower.EndsAt, Active = tower.Active } or nil,
		Weapons = data.Weapons,
		Equipped = data.Equipped,
		Keys = data.Keys,
		Potions = data.Potions,
		BoostEnds = data.BoostEnds,
		PowerTier = data.PowerTier,
		Streak = data.Streak,
		TotalPlaytime = data.TotalPlaytime,
		Cosmetics = data.Cosmetics,
		Explored = data.Explored,
		PlaytimeClaimed = s.PlaytimeClaimed,
		BestFloor = data.BestFloor or 0,
		Run = s.Run,
		Checkpoints = Config.Checkpoints(data.BestFloor or 0, Stats.HasPass(player, "FastTravel")),
		Mastery = data.Mastery,
		IndexFound = data.IndexFound,
		Ascensions = data.Ascensions,
		AscendReq = Config.AscendReq(data.Ascensions),
		Armors = data.Armors,
		EquippedArmor = data.EquippedArmor,
		Recipes = data.Recipes,
		Events = Stats.EventList(),
		IsAdmin = player:GetAttribute("IsAdmin") == true,
		Derived = {
			Defense = Stats.Defense(player),
			PowerMult = Stats.PowerTierMult(player),
			GameplayMult = Stats.GameplayMult(player),
			AttackSpeed = Stats.AttackSpeed(player),
			Damage = Stats.Damage(player),
			PowerPerSwing = Config.ClickPower * Stats.PowerMult(player),
			Luck = Stats.Luck(player),
			CoinMult = Stats.CoinMult(player),
			Crit = Stats.CritChance(player),
			ForgeMult = Stats.ForgeMult(player),
		},
	}
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">TowerService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- TowerService (ModuleScript) -> ServerScriptService/Server/TowerService
-- BOSS RUSH: a private arena per player. Bosses come back to back (two at
-- once every 5th wave); beat each wave before its timer runs out. Every wave
-- pays Coins, Runes (+2% dmg each) and ore, with armour + catalyst chances.
-- Your best wave is saved (TowerBest).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Net = require(script.Parent:WaitForChild("Net"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local Util = require(script.Parent:WaitForChild("Util"))

local TowerService = {}

local map = nil
local usedSlots = {}
local ARENA_R = 34

local function allocSlot(): number
	local i = 1
	while usedSlots[i] do
		i += 1
	end
	usedSlots[i] = true
	return i
end

local function buildArena(slot: number)
	local center = Vector3.new(3000 + slot * 300, 300, 0)
	local m = Instance.new("Model")
	m.Name = "Arena_" .. slot
	local function P(props)
		local p = Instance.new("Part")
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		for k, v in pairs(props) do
			(p :: any)[k] = v
		end
		p.Parent = m
		return p
	end
	local flat = CFrame.Angles(0, 0, math.rad(90))
	P({ Name = "Floor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, ARENA_R * 2 + 6, ARENA_R * 2 + 6), CFrame = CFrame.new(center - Vector3.new(0, 1, 0)) * flat, Color = Color3.fromRGB(45, 35, 70), Material = Enum.Material.Slate })
	P({ Name = "Glyph", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, ARENA_R * 1.4, ARENA_R * 1.4), CFrame = CFrame.new(center + Vector3.new(0, 0.05, 0)) * flat, Color = Color3.fromRGB(190, 110, 255), Material = Enum.Material.Neon, Transparency = 0.75, CanCollide = false })
	P({ Name = "Edge", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, ARENA_R * 2 + 6.4, ARENA_R * 2 + 6.4), CFrame = CFrame.new(center - Vector3.new(0, 0.3, 0)) * flat, Color = Color3.fromRGB(210, 130, 255), Material = Enum.Material.Neon })
	for i = 1, 10 do
		local a = (i / 10) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * (ARENA_R + 1), 0, math.sin(a) * (ARENA_R + 1))
		P({ Name = "Pillar", Size = Vector3.new(3, 22, 3), CFrame = CFrame.new(pos + Vector3.new(0, 11, 0)), Color = Color3.fromRGB(70, 55, 100), Material = Enum.Material.Marble })
		local c = P({ Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(pos + Vector3.new(0, 23, 0)), Color = Color3.fromRGB(200, 120, 255), Material = Enum.Material.Neon, CanCollide = false })
		VFX.MakeEmitter("Fire", Color3.fromRGB(190, 110, 255), c, 12)
	end
	-- invisible wall so nobody falls off
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * (ARENA_R + 3), 10, math.sin(a) * (ARENA_R + 3))
		P({ Name = "Barrier", Size = Vector3.new(15, 24, 1), CFrame = CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)), Transparency = 1 })
	end
	m.Parent = map.TowerArenas
	return m, center
end

local BR = Config.BossRush
-- every dungeon boss (floors 5, 10, 15 ... 200) takes a turn
local BOSS_FLOORS = {}
for f = Config.Dungeon.BossEvery, Config.Dungeon.FloorsPerZone * #Config.Zones, Config.Dungeon.BossEvery do
	table.insert(BOSS_FLOORS, f)
end

local function oreTable(wave: number)
	return Config.Floor(BR.StageReq + wave * 2).Drops
end

local function waveColor(wave: number): Color3
	return Color3.fromHSV((wave * 0.13) % 1, 0.7, 1)
end

local function cleanup(player: Player, run)
	for _, boss in ipairs(run.Bosses or {}) do
		if not boss.Dead then
			boss.Dead = true
			local idx = table.find(EnemyService.Active, boss)
			if idx then
				table.remove(EnemyService.Active, idx)
			end
			boss.Model:Destroy()
		end
	end
	if run.Arena then
		run.Arena:Destroy()
	end
	usedSlots[run.Slot] = nil
	local s = DataService.Session(player)
	if s and s.Tower == run then
		s.Tower = nil
		DataService.MarkDirty(player)
	end
end

local function finish(player: Player, run, state: string)
	if not run.Active then
		return
	end
	run.Active = false
	Net.FX(player, "Tower", { State = state, Floor = run.Wave, Best = (DataService.Get(player) or {}).TowerBest })
	task.delay(state == "Leave" and 0.2 or 2.2, function()
		if player.Parent and player.Character and map then
			Util.Teleport(player, map.TowerCFrame, "Boss Rush")
		end
		cleanup(player, run)
	end)
end

local startWave

local function onWaveCleared(player: Player, run)
	local data = DataService.Get(player)
	if not data or not run.Active then
		return
	end
	local wave = run.Wave
	local coins = math.floor(BR.CoinBase * BR.CoinGrowth ^ (wave - 1) * Stats.CoinMult(player))
	data.Coins += coins
	data.Runes += BR.RunesPerBoss * #run.Bosses
	data.TowerBest = math.max(data.TowerBest, wave)
	local drops = oreTable(wave)
	local luck = Stats.Luck(player)
	for _ = 1, 2 + math.floor(wave / 4) do
		local a = math.random() * math.pi * 2
		Loot.Drop(player, Loot.RollOre(drops, luck), run.Center + Vector3.new(math.cos(a) * 6, 1.2, math.sin(a) * 6))
	end
	EnemyService.GearDrop(player, Config.ArmorDropChance.BossRush)
	local extra = ""
	if wave % BR.CatalystEvery == 0 then
		data.Keys.RareScroll = (data.Keys.RareScroll or 0) + 1
		extra = "  +1 Rare+ Catalyst"
	end
	DataService.MarkDirty(player)
	Net.FX(player, "Tower", { State = "Win", Floor = wave, Coins = coins, Text = "+" .. Format.Abbrev(coins) .. " Coins  +" .. (BR.RunesPerBoss * #run.Bosses) .. " Rune" .. extra })
	run.Paused = true
	task.delay(BR.Break, function()
		if run.Active and player.Parent then
			run.Wave += 1
			startWave(player, run)
		end
	end)
end

startWave = function(player: Player, run)
	local wave = run.Wave
	local count = (wave % BR.DoubleEvery == 0) and 2 or 1
	local hp = BR.BaseHP * BR.HPGrowth ^ (wave - 1) / math.sqrt(count)
	local color = waveColor(wave)
	run.Paused = true
	run.Bosses = {}
	run.Alive = count
	Net.FX(player, "Tower", { State = "Floor", Floor = wave, Color = color, Double = count > 1 })
	task.delay(1.2, function()
		if not run.Active or not player.Parent then
			return
		end
		for k = 1, count do
			local stage = Config.Floor(BOSS_FLOORS[((wave + k - 2) % #BOSS_FLOORS) + 1])
			local boss = EnemyService.Create({
				Label = "WAVE " .. wave .. ": " .. stage.Enemy,
				Look = stage.Look,
				Color = color,
				Scale = 2.2,
				HP = hp,
				Boss = true,
				Owner = player,
				Position = run.Center + Vector3.new((k - (count + 1) / 2) * 16, 0, -14),
				Min = run.Center - Vector3.new(ARENA_R - 4, 0, ARENA_R - 4),
				Max = run.Center + Vector3.new(ARENA_R - 4, 0, ARENA_R - 4),
				Speed = 12 + math.min(wave, 25) * 0.3,
				HitPercent = 0.06 + math.min(wave, 30) * 0.002,
				OnDeath = function()
					run.Alive -= 1
					if run.Alive <= 0 then
						onWaveCleared(player, run)
					end
				end,
			})
			table.insert(run.Bosses, boss)
		end
		run.EndsAt = Stats.Now() + BR.TimePerBoss * count
		run.Paused = false
		DataService.MarkDirty(player)
		Net.FX(player, "Tower", { State = "Start", Floor = wave, EndsAt = run.EndsAt, Color = color })
	end)
end

function TowerService.Start(player: Player)
	local data = DataService.Get(player)
	local s = DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not s or not hum or hum.Health <= 0 then
		return
	end
	if s.Tower then
		return
	end
	if (data.BestFloor or 0) <= BR.StageReq then
		Net.Notify(player, "Boss Rush opens after you clear stage " .. BR.StageReq .. " on the Path.", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	local slot = allocSlot()
	local arena, center = buildArena(slot)
	local run = {
		Slot = slot,
		Arena = arena,
		Center = center,
		Wave = 1,
		Bosses = {},
		Alive = 0,
		Active = true,
		Paused = true,
		EndsAt = 0,
	}
	s.Tower = run
	Util.Teleport(player, CFrame.new(center + Vector3.new(0, 4, 20)), "Boss Rush")
	startWave(player, run)

	task.spawn(function()
		while run.Active do
			task.wait(0.25)
			if not player.Parent then
				run.Active = false
				cleanup(player, run)
				return
			end
			local c = player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if not h or h.Health <= 0 then
				finish(player, run, "Lose")
			elseif not run.Paused and Stats.Now() > run.EndsAt then
				finish(player, run, "Lose")
			end
		end
	end)
end

function TowerService.Leave(player: Player)
	local s = DataService.Session(player)
	if s and s.Tower then
		finish(player, s.Tower, "Leave")
	end
end

function TowerService.InTower(player: Player): boolean
	local s = DataService.Session(player)
	return s ~= nil and s.Tower ~= nil
end

function TowerService.PlayerRemoving(player: Player)
	local s = DataService.Session(player)
	if s and s.Tower then
		s.Tower.Active = false
		cleanup(player, s.Tower)
	end
end

function TowerService.Init(m)
	map = m
end

return TowerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Util (ModuleScript) -> ServerScriptService/Server/Util

local Net = require(script.Parent:WaitForChild("Net"))

local Util = {}

-- Streaming-safe teleport with a client flash + sound.
function Util.Teleport(player: Player, cf: CFrame, label: string?)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not root then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 3)
	end)
	if not char.Parent or not root.Parent then
		return
	end
	char:PivotTo(cf)
	root.AssemblyLinearVelocity = Vector3.zero
	Net.FX(player, "Teleported", { Where = label })
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Weapons (ModuleScript) -> ServerScriptService/Server/Weapons
-- Weapon + armour inventories, weighted rarity rolls (Random.new), equip,
-- and building the gear models on the character. Weapons carry the ore
-- effects they were forged with (rec.E = { [effectId] = points }).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local Net = require(script.Parent:WaitForChild("Net"))

local Weapons = {}
local rng = Random.new()

local function count(t): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

-- Weighted rarity roll. minRarity filters out lower tiers (chests / keys);
-- luck (>= 1) shifts weight toward rarer tiers.
function Weapons.RollRarity(minRarity: string?, luck: number?): string
	local minIndex = minRarity and Config.WeaponRarityById[minRarity].Index or 1
	luck = math.max(1, luck or 1)
	local total = 0
	local weights = {}
	for _, r in ipairs(Config.WeaponRarities) do
		if r.Index >= minIndex then
			local w = r.Chance * luck ^ ((r.Index - 1) * 0.35)
			weights[r.Id] = w
			total += w
		end
	end
	local roll = rng:NextNumber() * total
	for _, r in ipairs(Config.WeaponRarities) do
		local w = weights[r.Id]
		if w then
			roll -= w
			if roll <= 0 then
				return r.Id
			end
		end
	end
	return Config.WeaponRarities[#Config.WeaponRarities].Id
end

function Weapons.Roll(minRarity: string?, luck: number?): (string, string)
	local rarity = Weapons.RollRarity(minRarity, luck)
	local pool = Config.WeaponsByRarity[rarity]
	if not pool or #pool == 0 then
		return Config.StarterWeapon, "Common"
	end
	local w = pool[rng:NextInteger(1, #pool)]
	return w.Id, rarity
end

-- Adds a weapon. If the inventory is full it is scrapped for coins.
function Weapons.Add(player: Player, weaponId: string, rarityId: string, effects: { [string]: number }?): string?
	local data = DataService.Get(player)
	if not data or not Config.WeaponById[weaponId] then
		return nil
	end
	if count(data.Weapons) >= Config.MaxWeapons then
		local scrap = Config.WeaponRarityById[rarityId].Scrap
		data.Coins += scrap
		Net.Notify(player, "Weapon inventory full - auto-scrapped for " .. scrap .. " Coins.", Color3.fromRGB(255, 170, 90), "Error")
		DataService.MarkDirty(player)
		return nil
	end
	local uid = "w" .. data.NextWeaponId
	data.NextWeaponId += 1
	data.Weapons[uid] = { W = weaponId, R = rarityId, E = effects or {} }
	DataService.MarkDirty(player)
	return uid
end

function Weapons.EnsureStarter(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if next(data.Weapons) == nil then
		data.Equipped = Weapons.Add(player, Config.StarterWeapon, "Common") or ""
	end
	if not data.Weapons[data.Equipped] then
		data.Equipped = next(data.Weapons) or ""
	end
end

-- Rebuilds the weapon on the character and publishes attributes the client
-- uses to bind abilities.
function Weapons.Refresh(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not char or not hum or hum.Health <= 0 then
		return
	end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Model") and c.Name:sub(1, 15) == "EquippedWeapon_" then
			c:Destroy()
		end
	end
	local rec = data.Weapons[data.Equipped]
	local def = rec and Config.WeaponById[rec.W] or Config.WeaponById[Config.StarterWeapon]
	local rarityId = rec and rec.R or "Common"
	local built = WeaponModels.Build(def.Id, rarityId, data.Blade)
	WeaponModels.ApplyEffects(built, rec and rec.E)
	WeaponModels.AttachToCharacter(char, built)
	local class = Config.WeaponClasses[def.Class]
	player:SetAttribute("WeaponId", def.Id)
	player:SetAttribute("WeaponClass", def.Class)
	player:SetAttribute("WeaponRarity", rarityId)
	player:SetAttribute("WeaponSkill", def.Skill)
	player:SetAttribute("WeaponUltimate", class and class.Ultimate or "")
end

function Weapons.Equip(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" or not data.Weapons[uid] then
		return
	end
	data.Equipped = uid
	Weapons.Refresh(player)
	DataService.MarkDirty(player)
	local rec = data.Weapons[uid]
	Net.FX(player, "Equipped", { Weapon = rec.W, Rarity = rec.R })
end

function Weapons.Scrap(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" then
		return
	end
	local rec = data.Weapons[uid]
	if not rec then
		return
	end
	if uid == data.Equipped then
		Net.Notify(player, "Unequip that weapon before scrapping it.", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	local scrap = Config.WeaponRarityById[rec.R].Scrap
	data.Weapons[uid] = nil
	data.Coins += scrap
	Net.Notify(player, "Scrapped " .. Config.WeaponById[rec.W].Name .. " for " .. scrap .. " Coins.", Color3.fromRGB(255, 215, 70), "Sell")
	DataService.MarkDirty(player)
end

-- QoL: scrap every unequipped weapon at or below a rarity (1 = Common,
-- 2 = Uncommon...). Recipe weapons are always kept.
function Weapons.ScrapBulk(player: Player, maxIndex: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	maxIndex = math.clamp(math.floor(maxIndex), 1, 4)
	local total, count = 0, 0
	for uid, rec in pairs(data.Weapons) do
		local r = Config.WeaponRarityById[rec.R]
		local def = Config.WeaponById[rec.W]
		if uid ~= data.Equipped and r and r.Index <= maxIndex and not (def and def.Recipe) then
			data.Weapons[uid] = nil
			total += r.Scrap
			count += 1
		end
	end
	if count == 0 then
		Net.Notify(player, "Nothing to scrap.", Color3.fromRGB(255, 170, 90), "Error")
		return
	end
	data.Coins += total
	Net.Notify(player, "Scrapped " .. count .. " weapons for " .. total .. " Coins.", Color3.fromRGB(255, 215, 70), "Sell")
	DataService.MarkDirty(player)
end

---------------------------------------------------------------------
-- ARMOR
---------------------------------------------------------------------
function Weapons.RollArmor(luck: number?): (string, string)
	local rarity = Weapons.RollRarity(nil, luck)
	local a = Config.Armors[rng:NextInteger(1, #Config.Armors)]
	return a.Id, rarity
end

function Weapons.AddArmor(player: Player, armorId: string, rarityId: string): string?
	local data = DataService.Get(player)
	if not data or not Config.ArmorById[armorId] or not Config.WeaponRarityById[rarityId] then
		return nil
	end
	if count(data.Armors) >= Config.MaxArmors then
		local scrap = Config.WeaponRarityById[rarityId].Scrap
		data.Coins += scrap
		Net.Notify(player, "Armor storage full - auto-scrapped for " .. scrap .. " Coins.", Color3.fromRGB(255, 170, 90), "Error")
		DataService.MarkDirty(player)
		return nil
	end
	local uid = "a" .. data.NextArmorId
	data.NextArmorId += 1
	data.Armors[uid] = { A = armorId, R = rarityId }
	DataService.MarkDirty(player)
	return uid
end

function Weapons.RefreshArmor(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	if not data or not char then
		return
	end
	local rec = data.Armors[data.EquippedArmor]
	if rec then
		WeaponModels.AttachArmor(char, rec.A, rec.R)
	else
		WeaponModels.RemoveArmor(char)
	end
end

function Weapons.EquipArmor(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" then
		return
	end
	if uid == "" or uid == data.EquippedArmor then
		data.EquippedArmor = "" -- toggle off
	elseif data.Armors[uid] then
		data.EquippedArmor = uid
	else
		return
	end
	Weapons.RefreshArmor(player)
	DataService.MarkDirty(player)
	local rec = data.Armors[data.EquippedArmor]
	if rec then
		Net.FX(player, "ArmorEquipped", { Armor = rec.A, Rarity = rec.R })
	end
end

function Weapons.ScrapArmor(player: Player, uid: string)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" then
		return
	end
	local rec = data.Armors[uid]
	if not rec then
		return
	end
	if uid == data.EquippedArmor then
		Net.Notify(player, "Unequip that armor before scrapping it.", Color3.fromRGB(255, 120, 90), "Error")
		return
	end
	local scrap = Config.WeaponRarityById[rec.R].Scrap
	data.Armors[uid] = nil
	data.Coins += scrap
	Net.Notify(player, "Scrapped " .. Config.ArmorById[rec.A].Name .. " for " .. scrap .. " Coins.", Color3.fromRGB(255, 215, 70), "Sell")
	DataService.MarkDirty(player)
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="33">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="35">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Client (LocalScript) -> StarterPlayer/StarterPlayerScripts/Client
-- Put the UI, Hud, WeaponUI, ForgeUI, AdminUI, Abilities, PromptUI, Drops,
-- WorldText, WorldMap, EnemyFX, CameraDirector and Movement ModuleScripts
-- INSIDE this LocalScript. Handles server FX events, world VFX/SFX, dungeon
-- runs, training pads and zones.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GameShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local VFX = require(Shared:WaitForChild("VFX"))
local SFX = require(Shared:WaitForChild("SFX"))

local UI = require(script:WaitForChild("UI"))
local Drops = require(script:WaitForChild("Drops"))
local Abilities = require(script:WaitForChild("Abilities"))
local Hud = require(script:WaitForChild("Hud"))
local WeaponUI = require(script:WaitForChild("WeaponUI"))
local ForgeUI = require(script:WaitForChild("ForgeUI"))
local AdminUI = require(script:WaitForChild("AdminUI"))
local PromptUI = require(script:WaitForChild("PromptUI"))
local WorldText = require(script:WaitForChild("WorldText"))
local WorldMap = require(script:WaitForChild("WorldMap"))
local EnemyFX = require(script:WaitForChild("EnemyFX"))
local CameraDirector = require(script:WaitForChild("CameraDirector"))
local Movement = require(script:WaitForChild("Movement"))
local ProcAnim = require(script:WaitForChild("ProcAnim"))

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local AbilityRemote = Remotes:WaitForChild("Ability") :: RemoteEvent
local InteractRemote = Remotes:WaitForChild("Interact") :: RemoteEvent
local RequestRemote = Remotes:WaitForChild("Request") :: RemoteEvent
local SyncRemote = Remotes:WaitForChild("Sync") :: RemoteEvent
local FXRemote = Remotes:WaitForChild("FX") :: RemoteEvent

local function request(action: string, arg: any?)
	RequestRemote:FireServer(action, arg)
end

VFX.Init()
SFX.Init()
UI.Init(request)
WeaponUI.Init(UI, request)
ForgeUI.Init(UI, request)
AdminUI.Init(UI)
Abilities.Init(AbilityRemote, request)
Hud.Init(UI, Abilities)
PromptUI.Init(InteractRemote)
Drops.Init(request)
WorldText.Init()
WorldMap.Init(UI, request)
UI.ToggleMap = WorldMap.Toggle
EnemyFX.Init(UI)
CameraDirector.Init()
CameraDirector.Blocked = function()
	return WorldMap.IsOpen or UI.IsPanelOpen()
end
Movement.Init()
ProcAnim.Init()

Abilities.OnFeedback = function(kind)
	if kind == "NoStamina" then
		Hud.FlashStamina()
	elseif kind == "Action" then
		Hud.Combat()
	end
end

local data = nil
local currentZone = 0
local setZoneLookRef: (number) -> () = function() end

local function myRoot(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function charOf(p: Player?): Model?
	return p and p.Character
end

local function weaponColor(who: Player?): Color3
	local p: Player = who or player
	local def = Config.WeaponById[p:GetAttribute("WeaponId") or Config.StarterWeapon]
	local r = Config.WeaponRarityById[p:GetAttribute("WeaponRarity") or "Common"]
	return (def and def.Glow) or (r and r.Color) or Color3.fromRGB(230, 240, 255)
end

local function bladeColor(): Color3
	return weaponColor(player)
end

player.CharacterAdded:Connect(function()
	Drops.ClearAll()
end)

---------------------------------------------------------------------
-- SYNC
---------------------------------------------------------------------
SyncRemote.OnClientEvent:Connect(function(snapshot)
	local old = data
	data = snapshot
	UI.Update(snapshot)
	WorldMap.Update(snapshot)
	-- dungeon zone look / music follows the run you are in
	local zoneNow = snapshot.Run and snapshot.Run.Zone or 0
	if zoneNow ~= currentZone then
		currentZone = zoneNow
		setZoneLookRef(zoneNow)
	end
	local _ = old
end)

---------------------------------------------------------------------
-- FX EVENTS FROM THE SERVER
---------------------------------------------------------------------
local FX = {}

local SWING_SOUND = {
	Katana = "Swing", Greatsword = "HeavySwing", Scythe = "ScytheSwing", Glove = "Punch", Pistols = "GunShot", FingerGun = "SpiritShot",
	Spear = "Swing", Daggers = "Swing", Hammer = "HeavySwing", Bow = "Swing", Staff = "SpiritShot", Chain = "ScytheSwing",
	Claws = "Swing", Fan = "Swing", Kunai = "Swing", Cannon = "GunShot",
}

-- Basic attacks of OTHER players (yours are drawn instantly by Abilities).
FX.Attack = function(p)
	local char = charOf(p.Player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if p.Player ~= player then
		ProcAnim.Attack(char, p.Class, p.Combo)
		ProcAnim.TrailBurst(char, 0.3)
		local class = Config.WeaponClasses[p.Class]
		if class and class.Kind == "Melee" then
			VFX.Slash(root.CFrame * CFrame.new(0, 0.6, 0), p.Color, class.Range / 9, p.Combo % 2 == 0)
		elseif p.Dir then
			VFX.Muzzle(root.Position + Vector3.new(0, 1.2, 0) + p.Dir * 2, p.Dir, p.Color)
		end
		SFX.Play(SWING_SOUND[p.Class] or "Swing", { At = root.Position, Volume = 0.6 })
	end
	if p.Heavy then
		local ground = root.Position - Vector3.new(0, 2.8, 0)
		VFX.Ring(ground, Color3.fromRGB(80, 220, 255), 18, 0.45)
		VFX.ShardRing(ground + Vector3.new(0, 1, 0), Color3.fromRGB(120, 230, 255), 18, 16, 0.45)
		VFX.Emit(root.Position, "Sparks", 30, Color3.fromRGB(80, 220, 255))
		VFX.Emit(root.Position, "Glow", 1, Color3.fromRGB(80, 220, 255))
		SFX.Play("AoE", { At = root.Position })
		if p.Player == player then
			VFX.Shake(0.25)
		end
	end
end

-- impact sound family per weapon class
local HIT_SOUND = {
	Katana = "HitBlade", Scythe = "HitBlade", Greatsword = "HitBlunt", Glove = "HitBlunt", Pistols = "HitEnergy", FingerGun = "HitEnergy",
	Spear = "HitBlade", Daggers = "HitBlade", Hammer = "HitBlunt", Bow = "HitBlade", Staff = "HitEnergy", Chain = "HitBlade",
	Claws = "HitBlade", Fan = "HitEnergy", Kunai = "HitBlade", Cannon = "HitEnergy",
}
local lastExposedPop = 0

FX.Hit = function(p)
	local color = p.Color or Color3.new(1, 1, 1)
	VFX.HitSpark(p.Pos, color, p.Crit)
	if p.Model then
		VFX.EnemyHitFlash(p.Model)
	end
	EnemyFX.OnHit(p.Model, p.By == player)
	if p.By == player then
		Hud.Combat()
		VFX.DamageNumber(p.Pos + Vector3.new(0, 1.5, 0), p.Amount, p.Crit)
		local cls = player:GetAttribute("WeaponClass")
		SFX.Play(p.Crit and "Crit" or (HIT_SOUND[cls] or "Hit"), { At = p.Pos })
		if p.Crit then
			VFX.Shake(0.12)
			VFX.Rumble(0.12)
		else
			VFX.Shake(0.04)
		end
		-- punish window feedback (enemy was recovering from its attack)
		if p.Exposed and os.clock() - lastExposedPop > 0.8 then
			lastExposedPop = os.clock()
			VFX.TextPop(p.Pos + Vector3.new(0, 3, 0), "EXPOSED", Color3.fromRGB(255, 225, 120), 0.8)
			SFX.Play("Exposed", { At = p.Pos })
		end
	end
end

FX.Kill = function(p)
	if p.Model then
		VFX.EnemyDeath(p.Model, p.Color or Color3.new(1, 1, 1), p.Big)
	elseif p.Pos then
		VFX.Explosion(p.Pos, p.Color or Color3.new(1, 1, 1), p.Big and 2.5 or 1)
	end
	if p.Big then
		SFX.Play("BossKill")
		local root = myRoot()
		if root and (root.Position - p.Pos).Magnitude < 150 then
			VFX.Rumble(0.6)
			VFX.ImpactFrame(p.Color, 1.4)
			VFX.TitleCard("BOSS DEFEATED!", nil, Color3.fromRGB(255, 215, 80), 1.6)
		end
	elseif p.Elite then
		SFX.Play("EliteKill", { At = p.Pos })
		if p.By == player then
			VFX.ImpactFrame(Color3.fromRGB(255, 210, 80), 0.7)
		end
	else
		SFX.Play("Kill", { At = p.Pos })
		if p.By == player then
			VFX.Shake(0.12)
		end
	end
end

FX.Reward = function(p)
	UI.FlyToHud("Coins", p.Pos, Config.Rarity.Legendary.Color, 3)
	VFX.TextPop(p.Pos + Vector3.new(0, 3, 0), "+" .. Format.Abbrev(p.Coins) .. " Coins", Color3.fromRGB(255, 215, 70), 0.8)
	task.delay(0.5, SFX.Play, "Coins", { Volume = 0.5 })
end

FX.Drop = function(p)
	Drops.Spawn(p)
end

FX.Collected = function(p)
	Drops.Collected(p.Id)
end

FX.CollectFail = function(p)
	Drops.Fail(p.Id, p.Full)
end

local lastPowerPop = 0
FX.Power = function(p)
	local root = myRoot()
	if not root then
		return
	end
	UI.Bump("Power")
	if os.clock() - lastPowerPop > 0.12 then
		lastPowerPop = os.clock()
		VFX.TextPop(root.Position + Vector3.new(math.random() * 2 - 1, 2, 0), "+" .. Format.Abbrev(p.Amount) .. " Power", Color3.fromRGB(120, 255, 170), p.Pad and 0.9 or 0.7)
	end
	if p.Pad then
		VFX.Emit(root.Position - Vector3.new(0, 2.5, 0), "Rise", p.Auto and 4 or 8, Config.TrainPads[p.Pad].Color)
	end
	if not p.Auto then
		SFX.Play("PowerGain", { Volume = 0.8 })
	end
end

-- Forge crafting result: reveal the weapon (with its ore effects), then
-- celebrate any Forge-level tier up.
FX.ForgeResult = function(p)
	ForgeUI.Clear()
	UI.Bump("Blade")
	SFX.Play("Forge")
	local title = p.Recipe and (p.FirstRecipe and "NEW RECIPE DISCOVERED!" or "UNIQUE RECIPE!") or "FORGED!"
	WeaponUI.Reveal(p.Weapon, p.Rarity, title, p.Effects, p.Equipped)
	if p.TierUp then
		task.delay(3.2, function()
			local char = player.Character
			SFX.Play("ForgeTierUp")
			VFX.ImpactFrame(bladeColor(), 1.1)
			VFX.TitleCard("FORGE TIER UP!", p.TierName .. "  (Forge +" .. Format.Abbrev(p.To) .. ")", Color3.fromRGB(255, 160, 60), 2)
			if char then
				VFX.LevelBurst(char, Color3.fromRGB(255, 160, 60))
			end
		end)
	end
end

FX.ForgeBurst = function(p)
	local map = workspace:FindFirstChild("GeneratedMap")
	local lava = map and map:FindFirstChild("Lava", true)
	if not lava then
		return
	end
	local pos = lava.Position
	local color = Color3.fromRGB(255, 140, 40)
	VFX.Pillar(pos, color, 40, 5, 0.9)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Sparks", 40, color)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Embers", 30, color)
	VFX.Emit(pos + Vector3.new(0, 1, 0), "Smoke", 10, Color3.fromRGB(90, 80, 90))
	VFX.Ring(pos, color, 16, 0.5)
	VFX.Light(pos, color, 40, 6, 0.8)
	if p.Player == player then
		VFX.Shake(0.35)
		VFX.FOVPunch(-6)
	else
		SFX.Play("Forge", { At = pos, Volume = 0.5 })
	end
end

FX.Sell = function(p)
	SFX.Play("Sell")
	UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 8)
	UI.Notify(p.Text, Color3.fromRGB(255, 215, 70))
end

FX.Rebirth = function(p)
	local char = charOf(p.Player)
	if not char then
		return
	end
	local gold = Color3.fromRGB(255, 215, 80)
	if p.Player == player then
		SFX.Play("Rebirth")
		VFX.Transform(char, gold, true)
		task.delay(0.6, function()
			VFX.TitleCard("REBIRTH " .. p.Rebirths .. "!", "Power gain, Coins and Damage boosted forever", gold, 2.4)
		end)
	else
		VFX.Transform(char, gold, false)
	end
end

FX.Ascend = function(p)
	local char = charOf(p.Player)
	if not char then
		return
	end
	local pink = Color3.fromRGB(255, 100, 185)
	if p.Player == player then
		SFX.Play("Rebirth")
		VFX.ImpactFrame(pink, 1.5)
		VFX.Transform(char, pink, true)
		task.delay(0.6, function()
			VFX.TitleCard("ASCENSION " .. p.Ascensions .. "!", "x" .. Config.Ascension.PowerMult .. " Power  x" .. Config.Ascension.CoinMult .. " Coins - forever", pink, 2.6)
		end)
	else
		VFX.Transform(char, pink, false)
		UI.Notify(p.Player.DisplayName .. " reached Ascension " .. p.Ascensions .. "!", pink)
	end
end

FX.RaceRoll = function(p)
	UI.RaceRoll(p.Race, p.Tier, p.Initial)
end

FX.Transform = function(p)
	local char = charOf(p.Player)
	if not char then
		return
	end
	local isLocal = p.Player == player
	local titles = { Overdrive = "OVERDRIVE!", Zenkai = "ZENKAI BOOST!", Awaken = "AWAKENED!" }
	VFX.Transform(char, p.Color, isLocal, titles[p.Kind])
	local root = char:FindFirstChild("HumanoidRootPart")
	local sound = p.Kind == "Zenkai" and "Zenkai" or (p.Kind == "Awaken" and "RaceRevealLegend" or "Overdrive")
	if isLocal then
		if p.Kind ~= "Awaken" then
			SFX.Play(sound)
		end
	elseif root then
		SFX.Play(sound, { At = root.Position, Volume = 0.7 })
	end
end

FX.Notify = function(p)
	UI.Notify(p.Text, p.Color)
	if p.Sound then
		SFX.Play(p.Sound)
	end
end

FX.Discover = function(p)
	local ore = Config.OreById[p.Ore]
	if not ore then
		return
	end
	SFX.Play("Discover")
	UI.Notify("New ore found! Unlock it in the Index for +" .. Format.Abbrev(p.Reward) .. " Coins", ore.Color)
end

FX.BossSpawn = function(p)
	if not p.Global then
		return
	end
	SFX.Play("BossSpawn")
	VFX.Shake(0.5)
	VFX.TitleCard("BOSS APPEARED!", p.Name, Color3.fromRGB(255, 70, 90), 2)
end

FX.Telegraph = function(p)
	VFX.Telegraph(p.Pos, p.Radius, p.Time)
	SFX.Play("Telegraph", { At = p.Pos })
end

FX.Slam = function(p)
	VFX.Explosion(p.Pos + Vector3.new(0, 1, 0), p.Color or Color3.fromRGB(255, 90, 60), 1.4)
	SFX.Play("BossSlam", { At = p.Pos })
	local root = myRoot()
	if root and (root.Position - p.Pos).Magnitude < 60 then
		VFX.Shake(0.25)
		VFX.Rumble(0.55)
	end
end

FX.EnemySwipe = function(p)
	ProcAnim.EnemyStrike(p.Model)
	local cf = CFrame.lookAt(p.Pos, Vector3.new(p.Target.X, p.Pos.Y, p.Target.Z))
	VFX.Slash(cf, Color3.fromRGB(255, 70, 70), 0.6, math.random() < 0.5)
	SFX.Play("Swing", { At = p.Pos, Pitch = 0.7, Volume = 0.5 })
end

FX.Hurt = function(p)
	SFX.Play("Hurt")
	Hud.Hurt()
	VFX.ScreenFlash(Color3.fromRGB(255, 30, 40), 0.7, 0.3)
	VFX.Shake(0.18)
	if p.Stun then
		VFX.Rumble(0.25)
	end
end

FX.Dodge = function()
	local root = myRoot()
	Hud.Combat()
	if root then
		VFX.TextPop(root.Position + Vector3.new(0, 3, 0), "DODGE!", Color3.fromRGB(140, 160, 255), 1)
		SFX.Play("UIHover", { Pitch = 0.8, Volume = 2 })
	end
end

FX.PlotArmor = function()
	SFX.Play("PlotArmor")
	VFX.ImpactFrame(Color3.fromRGB(255, 215, 80), 1)
	VFX.TitleCard("PLOT ARMOR!", "Main Characters don't go down that easy", Color3.fromRGB(255, 215, 80), 1.8)
end

-- Boss Rush waves
FX.Tower = function(p)
	if p.State == "Floor" then
		UI.Tower("Floor", p.Floor, 0)
		UI.Banner("WAVE " .. p.Floor, p.Double and "DOUBLE BOSS!" or "Get ready...", p.Color)
		SFX.Play("TowerStart")
		SFX.PlayMusic(Config.Music.BossRush)
	elseif p.State == "Start" then
		UI.Tower("Start", p.Floor, p.EndsAt)
		local secs = math.max(0, math.floor((p.EndsAt or 0) - workspace:GetServerTimeNow() + 0.5))
		VFX.TitleCard("FIGHT!", "Defeat the boss in " .. secs .. "s", p.Color, 1)
	elseif p.State == "Win" then
		UI.Tower("Win", p.Floor, 0)
		SFX.Play("TowerWin")
		VFX.TitleCard("WAVE " .. p.Floor .. " CLEARED!", p.Text, Color3.fromRGB(120, 255, 170), 2)
		UI.FlyToHud("Coins", nil, Color3.fromRGB(255, 210, 60), 8)
	elseif p.State == "Lose" then
		SFX.Play("TowerLose")
		VFX.TitleCard("DEFEATED", "You reached wave " .. p.Floor .. "  (best " .. (p.Best or p.Floor) .. ")", Color3.fromRGB(255, 90, 90), 2)
		task.delay(2, UI.Tower, nil)
		SFX.PlayMusic(Config.Music.Hub)
	else
		UI.Tower(nil)
		SFX.PlayMusic(Config.Music.Hub)
	end
end

-- Dungeon runs
FX.RunStarted = function(p)
	SFX.Play("TowerStart")
	UI.Close()
	local fd = Config.Floor(p.Floor)
	VFX.TitleCard("FLOOR " .. p.Floor, fd.ZoneData.Name, fd.ZoneData.Accent, 1.6)
end

FX.FloorStart = function(p)
	local fd = Config.Floor(p.Floor)
	SFX.Play(p.Boss and "BossSpawn" or "Stage", { Volume = 0.8 })
	if p.Boss then
		VFX.Shake(0.3)
		VFX.TitleCard("BOSS FLOOR " .. p.Floor, p.Name, Color3.fromRGB(255, 80, 100), 1.6)
	else
		UI.Banner("FLOOR " .. p.Floor, fd.ZoneData.Name, fd.ZoneData.Accent)
	end
end

FX.EnemySpawn = function(p)
	VFX.Ring(p.Pos - Vector3.new(0, 0.8, 0), p.Color or Color3.fromRGB(255, 80, 100), p.Boss and 14 or 5, 0.4)
	VFX.Emit(p.Pos, "Void", p.Boss and 30 or 10, p.Color)
	SFX.Play("Telegraph", { At = p.Pos, Volume = 0.4, Pitch = 1.3 })
end

FX.GateOpen = function(p)
	VFX.Emit(p.Pos, "Sparks", 24, p.Color)
	VFX.Flash(p.Pos, p.Color, 8, 0.3)
	SFX.Play("Stage", { At = p.Pos })
end

FX.FloorCleared = function(p)
	local fd = Config.Floor(p.Floor)
	local color = fd.ZoneData.Accent
	SFX.Play(p.Boss and "Milestone" or "Discover", { Volume = 0.7 })
	if p.Boss then
		VFX.ImpactFrame(color, 0.8)
		VFX.TitleCard("BOSS DOWN!", "Take the stairs to floor " .. p.Next, color, 1.8)
	else
		VFX.TitleCard("FLOOR " .. p.Floor .. " CLEARED", "Door to floor " .. p.Next .. " is open", color, 1.2)
	end
end

FX.Descend = function(p)
	SFX.Play("Teleport")
	VFX.ScreenFlash(Color3.fromRGB(20, 10, 40), 0, 0.6)
